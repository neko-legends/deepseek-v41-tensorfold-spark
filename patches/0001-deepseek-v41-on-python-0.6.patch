index 0000000..b027d63
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/gate.py
@@ -0,0 +1,309 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Milestone M1's gates on the real checkpoint, two ranks (run on both Sparks at once, like the server):
+
+    python -m tensorfold.families.deepseek_v41.cuda.gate --model DIR --rank R --master ADDR [--port P]
+        --capture oracle-kit.json --out report.json [--decode 256] [--prompts 8]
+
+1. teacher-forced top-1: our argmax after every prompt position against the kit's ``prompt_logprobs`` rank-1 token
+   (the oracle captured in the baseline window), over the whole 2,048 tokens and over each prompt's first copy (the
+   prompts repeat their text, so later copies are easy); also the kit's top-1 in our top-5 and the logprob error;
+2. greedy replies (``--decode`` tokens after each prompt's first copy), recorded for the comparison with the kit's
+   (the oracle has no kit replies: that comparison needs a kit capture of greedy replies);
+3. row invariance on the real weights: one prompt's logits in prefill windows of ``chunk`` rows == windows of 8 ==
+   one row at a time, bit for bit, on both ranks;
+4. serial decode tok/s (the floor: the kit's SPEC_METHOD=none);
+5. boot seconds (the engine's construction, prepared folder or checkpoint).
+
+Rank 0 writes the report; exit status 0 when gates 1 (whole prompts), 3 and 4 pass.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+TOP1 = 0.99
+DECODE_FLOOR = 23.0              # tok/s: the kit's serial decode (SPEC_METHOD=none), ENGINE-PLAN section 11 M1
+
+
+def period(ids: list[int]) -> int:
+    """The first copy's length after BOS (the capture repeats BOS + text to length), or the whole prompt."""
+
+    n = len(ids)
+    for k in range(1, n - 1):
+        if all(ids[1 + i] == ids[1 + i + k] for i in range(n - 1 - k)):
+            return k
+    return n - 1
+
+
+def mem_available_gib() -> float:
+    for line in open("/proc/meminfo"):
+        if line.startswith("MemAvailable:"):
+            return int(line.split()[1]) / 2 ** 20
+    return -1.0
+
+
+def first_divergence(a: list[int], b: list[int]) -> int:
+    for i, (x, y) in enumerate(zip(a, b)):
+        if x != y:
+            return i
+    return min(len(a), len(b))
+
+
+class Scorer:
+    """Per prompt row: our global top-1 / top-5, and our logprob of the kit's top-1 (both ranks call every step)."""
+
+    def __init__(self, eng) -> None:
+        self.eng = eng
+
+    def _gather(self, x):
+        import torch
+
+        from tensorfold.cuda.comm import fast_gather
+
+        x = x.contiguous()
+        w = self.eng.world
+        out = torch.empty((w * x.numel(),), dtype=x.dtype, device=x.device)
+        fast_gather(self.eng.comm, x.view(-1), out)
+        return out.view(w, *x.shape)
+
+    def rows(self, logits, kit_top1) -> tuple[list[int], list[list[int]], list[float]]:
+        import torch
+
+        from . import pick as P
+
+        fw = self.eng.fw
+        lg = logits.float()
+        vals, ids = P.top(lg, 5)
+        ids = ids + fw.vocab_lo
+        lse = torch.logsumexp(lg, -1)
+        local = kit_top1 - fw.vocab_lo
+        ok = (local >= 0) & (local < lg.shape[1])
+        at = torch.where(ok, lg.gather(1, local.clamp(0, lg.shape[1] - 1)[:, None])[:, 0],
+                         torch.full_like(lse, float("-inf")))
+        packed = torch.cat([vals, ids.to(torch.float32), lse[:, None], at[:, None]], 1)
+        g = self._gather(packed).cpu().double()             # [W, R, 12]: every rank's slice, rank order
+        W = g.shape[0]
+        v = torch.cat([g[w, :, :5] for w in range(W)], 1)
+        t = torch.cat([g[w, :, 5:10] for w in range(W)], 1).long()
+        top5, top1 = [], []
+        for r in range(v.shape[0]):
+            o = sorted(range(5 * W), key=lambda j: (-float(v[r, j]), int(t[r, j])))
+            top5.append([int(t[r, j]) for j in o[:5]])
+            top1.append(top5[-1][0])
+        gl = torch.logsumexp(g[:, :, 10], 0)
+        lp = g[:, :, 11].max(0).values - gl
+        return top1, top5, lp.tolist()
+
+
+def run(a, comm=None, device: str = "cuda") -> int:
+    import torch
+
+    from .engine import Dsv41Engine
+
+    t0 = time.time()
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context, comm=comm,
+                      device=device, serving=False)
+    cuda = eng.device.type == "cuda"
+    sync = torch.cuda.synchronize if cuda else (lambda: None)
+    boot = time.time() - t0
+    launch = float(os.environ.get("TF_DSV41_LAUNCH_T0", "0") or 0)
+    mem = {"after_boot_alloc_gib": round(torch.cuda.memory_allocated() / 2 ** 30, 2) if cuda else None,
+           "after_boot_reserved_gib": round(torch.cuda.memory_reserved() / 2 ** 30, 2) if cuda else None,
+           "mem_available_after_boot_gib": round(mem_available_gib(), 2)}
+    if cuda:
+        torch.cuda.reset_peak_memory_stats()
+    mins = [mem_available_gib()]
+    rec = json.loads(Path(a.capture).read_text()) if a.rank == 0 else None
+    if getattr(a, "profile", 0):        # debugging: where a serial decode step's time goes (rank 0 prints)
+        ids = eng._share(rec["prompts"][0]["ids"][:256] if a.rank == 0 else None)
+        eng.fw.reset()
+        lg = eng.fw.prompt(ids)
+        tok = int(eng.choose(lg, [len(ids)], None)[0])
+        for _ in range(8):
+            lg = eng.fw.step([tok])
+        sync()
+        from torch.profiler import ProfilerActivity, profile
+        with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+            t1 = time.time()
+            for _ in range(a.profile):
+                lg = eng.fw.step([tok])
+                tok = int(eng.choose(lg, [0], None)[0])
+            sync()
+            dt = (time.time() - t1) / a.profile
+        from .forward import Seg
+        t2 = time.time()
+        for _ in range(20):
+            eng.fw._engram_inputs([Seg(0, eng.fw.slots[0].pos, (tok,))])
+        sync()
+        te = (time.time() - t2) / 20
+        if a.rank == 0:
+            print(f"profile: {1e3 * dt:.1f} ms a step; Engram inputs (host hash + reads + gather) {1e3 * te:.2f} ms",
+                  flush=True)
+            print(prof.key_averages().table(sort_by="self_cpu_time_total", row_limit=40), flush=True)
+            print(prof.key_averages().table(sort_by="self_cuda_time_total", row_limit=30), flush=True)
+        return 0
+    if getattr(a, "trace", ""):         # debugging: the streams after every block for the first N tokens of prompts
+        n_tok, plist = a.trace.split(":")
+        n_tok = int(n_tok)
+        for p in [int(x) for x in plist.split(",")]:
+            ids = eng._share(rec["prompts"][p]["ids"][:n_tok] if a.rank == 0 else None)
+            eng.fw.reset()
+            eng.fw.trace = {}
+            out = []
+            for s0 in range(0, len(ids), eng.fw.chunk):
+                lg = eng.fw.step(ids[s0:s0 + eng.fw.chunk])
+                from .forward import greedy
+                out.append(greedy(eng.fw, lg).cpu())
+            if a.rank == 0:
+                torch.save({L: t.float().cpu() for L, t in eng.fw.trace.items()} | {"top1": torch.cat(out)},
+                           str(Path(a.out).parent / f"ours-p{p}-n{n_tok}.pt"))
+            eng.fw.trace = None
+        return 0
+    n = eng._share([min(a.prompts, len(rec["prompts"]))] if a.rank == 0 else None)[0]
+    sc = Scorer(eng)
+    report: dict = {"boot_s": round(boot, 1), "launch_to_ready_s": round(time.time() - launch, 1) if launch else None,
+                    "knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith(("TF_DSV41_", "GLM53_TF_"))},
+                    "prompts": []}
+    agree = total = first_agree = first_total = top5 = 0
+    errs: list[float] = []
+    for p in range(n):
+        ids = eng._share(rec["prompts"][p]["ids"] if a.rank == 0 else None)
+        kit = eng._share([(e["top"][0][0] if e and e.get("top") else -1)
+                          for e in rec["prompts"][p]["positions"]] if a.rank == 0 else None)
+        ours, ours5, lps = [], [], []
+
+        def every(start, logits, kit=kit, ids=ids):
+            nxt = torch.tensor([kit[start + i + 1] if start + i + 1 < len(ids) else -1
+                                for i in range(logits.shape[0])], device=logits.device)
+            t1, t5, lp = sc.rows(logits, nxt)
+            ours.extend(t1)
+            ours5.extend(t5)
+            lps.extend(lp)
+            mins.append(mem_available_gib())
+
+        eng.fw.reset()
+        tp = time.time()
+        eng.fw.prompt(ids, every=every)
+        sync()
+        prefill_s = time.time() - tp
+        per = period(ids)
+        pa = pt = fa = ft = 0
+        miss = []
+        for i in range(len(ids) - 1):
+            k = kit[i + 1]
+            if k < 0:
+                continue
+            hit = ours[i] == k
+            pa, pt = pa + hit, pt + 1
+            if not hit and a.rank == 0:
+                top = rec["prompts"][p]["positions"][i + 1]["top"]
+                miss.append([i + 1, k, ours[i], round(top[0][1] - top[1][1], 4) if len(top) > 1 else None,
+                             round(lps[i], 4)])
+            top5 += k in ours5[i]
+            errs.append(abs(lps[i] - rec["prompts"][p]["positions"][i + 1]["top"][0][1]) if a.rank == 0 else 0.0)
+            if i + 1 <= per:
+                fa, ft = fa + hit, ft + 1
+        agree, total, first_agree, first_total = agree + pa, total + pt, first_agree + fa, first_total + ft
+        reply: list[int] = []
+        stats = {"decode_tok_s": None}
+        if a.decode > 0:
+            stats = eng._run(ids[:1 + per], a.decode, None, False, lambda new: reply.extend(new) and False)
+        mins.append(mem_available_gib())
+        report["prompts"].append({"tokens": len(ids), "first_copy": per, "top1": pa / max(pt, 1),
+                                  "top1_first_copy": fa / max(ft, 1), "prefill_s": round(prefill_s, 2),
+                                  "prefill_tok_s": round(len(ids) / max(prefill_s, 1e-9), 1),
+                                  "greedy_reply": reply, "decode_tok_s": stats["decode_tok_s"],
+                                  "misses": miss})
+        if a.rank == 0:
+            print(f"prompt {p}: top-1 {pa / max(pt, 1):.4f} (first copy of {per}: {fa / max(ft, 1):.4f}), "
+                  f"prefill {prefill_s:.1f}s, decode {stats['decode_tok_s']} tok/s", flush=True)
+    # row invariance on the real weights: one prompt in windows of chunk / 8 / 1 rows
+    ids = eng._share(rec["prompts"][0]["ids"][:2 * eng.fw.chunk + 3] if a.rank == 0 else None)
+    if getattr(a, "invariance", True):
+        outs = []
+        for size in (eng.fw.chunk, 8, 1):
+            eng.fw.reset()
+            got = []
+            for s in range(0, len(ids), size):
+                got.append(eng.fw.step(ids[s:s + size]).clone())
+            outs.append(torch.cat(got))
+        same = [int(torch.equal(outs[0], outs[1])), int(torch.equal(outs[0], outs[2]))]
+        if not all(same):
+            for j, o in ((1, outs[1]), (2, outs[2])):
+                d = (o - outs[0]).abs().amax(-1)
+                bad = (d > 0).nonzero().flatten().tolist()
+                print(f"[rank {a.rank}] invariance: windows {(8, 1)[j - 1]}: {len(bad)} rows differ, first "
+                      f"{bad[:8]}, max |d| {float(d.max()):.3g}", flush=True)
+        both = eng._gather_ints(same)
+    else:
+        both = [[0, 0] for _ in range(eng.world)]
+    invariant = all(all(b) for b in both)
+    tok_s = [p["decode_tok_s"] for p in report["prompts"] if p["decode_tok_s"]]
+    report.update({
+        "top1_agreement": agree / max(total, 1), "top1_first_copy": first_agree / max(first_total, 1),
+        "kit_top1_in_our_top5": top5 / max(total, 1), "positions": total,
+        "median_abs_logprob_err": sorted(errs)[len(errs) // 2] if errs else None,
+        "row_invariance": {"windows_of_8": all(b[0] for b in both), "one_row": all(b[1] for b in both),
+                           "rows": len(ids)},
+        "decode_tok_s_median": sorted(tok_s)[len(tok_s) // 2] if tok_s else None,
+        "memory": {**mem, "peak_alloc_gib": round(torch.cuda.max_memory_allocated() / 2 ** 30, 2) if cuda else None,
+                   "peak_reserved_gib": round(torch.cuda.max_memory_reserved() / 2 ** 30, 2) if cuda else None,
+                   "workspace_peak_gib": round((torch.cuda.max_memory_allocated() - torch.cuda.memory_allocated())
+                                               / 2 ** 30, 2) if cuda else None,
+                   "mem_available_min_gib": round(min(mins), 2)},
+        "gates": {}})
+    mems = eng._gather_ints([int(report["memory"]["mem_available_min_gib"] * 100),
+                             int((report["memory"]["peak_reserved_gib"] or 0) * 100)])
+    report["memory"]["per_rank_mem_available_min_gib"] = [m[0] / 100 for m in mems]
+    report["memory"]["per_rank_peak_reserved_gib"] = [m[1] / 100 for m in mems]
+    if getattr(a, "kit_replies", "") and a.rank == 0:
+        kit_r = json.loads(Path(a.kit_replies).read_text())["replies"]
+        div = [first_divergence(p["greedy_reply"], k) for p, k in zip(report["prompts"], kit_r)]
+        full = [d >= min(len(p["greedy_reply"]), len(k)) for d, p, k in zip(div, report["prompts"], kit_r)]
+        report["greedy_vs_kit"] = {"first_divergence": div, "identical": full, "identical_n": sum(full)}
+    g = report["gates"]
+    g["top1"] = report["top1_agreement"] >= TOP1
+    g["row_invariance"] = invariant
+    g["decode_floor"] = (report["decode_tok_s_median"] or 0) >= DECODE_FLOOR
+    g["boot_le_90s"] = boot <= 90
+    g["boot_le_60s"] = boot <= 60
+    if "greedy_vs_kit" in report:
+        g["greedy_6_of_8"] = report["greedy_vs_kit"]["identical_n"] >= 6
+    report["pass"] = bool(g["top1"] and g["row_invariance"] and g["decode_floor"])
+    if a.rank == 0:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(report, indent=1))
+        print(json.dumps({k: v for k, v in report.items() if k != "prompts"}, indent=1), flush=True)
+    a.report = report
+    return 0 if report["pass"] else 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--capture", default="", help="the kit's oracle (rank 0)")
+    ap.add_argument("--out", default="m1-report.json")
+    ap.add_argument("--decode", type=int, default=256)
+    ap.add_argument("--prompts", type=int, default=8)
+    ap.add_argument("--context", type=int, default=4096)
+    ap.add_argument("--no-invariance", dest="invariance", action="store_false", help="skip gate 3 (A/B runs)")
+    ap.add_argument("--kit-replies", default="", help="the kit's greedy replies (oracle greedy capture), rank 0")
+    ap.add_argument("--profile", type=int, default=0, help="debugging: profile N serial decode steps")
+    ap.add_argument("--trace", default="", help="N:p,q debugging: save the streams after every block (rank 0)")
+    a = ap.parse_args(argv)
+    if a.rank == 0 and not a.capture:
+        ap.error("rank 0 needs --capture")
+    return run(a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/gmbench.py b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
new file mode 100644
index 0000000..d0340a4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/gmbench.py
@@ -0,0 +1,255 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G6's routed-expert prefill bench on one GPU: a real layer's routed experts (this rank's half, from the
+checkpoint) at prefill block widths, the three fast-prefill kernels side by side:
+
+- grouped: upstream's grouped kernels (the decode path's), 1,024-row blocks, the shared slot masked (``prefill_moe``);
+- tc: ``x3tc`` (Triton); gm: ``x3gm`` (CUDA, every configuration at the widest width);
+- per kernel: ms a call, TFLOP/s, trellis GB/s, the DRAM floor (``x3gm.floor_bytes`` at 235 GB/s) and its ratio;
+- gm's correctness on the real weights: vs grouped (rel max, the gate < 3e-3), a row subset == the same rows in the
+  block (row independence), repeats and every configuration bit for bit.
+
+    python -m tensorfold.families.deepseek_v41.cuda.gmbench --model DIR [--layers 3,20] [--rank 0]
+        [--rows 512,1024,2048,4096] [--iters 10] [--out gmbench.json]
+
+Rows come from the real router on random activations.
+
+G16 4K tile sweep (``--sweep``): every x3gm configuration (``x3gm.GU_TILES`` x ``DN_TILES`` that fit the layer's
+widths) at each row block (one block: ``rows`` = R), in the scratch arena the 4K path uses (``moe.arena_scratch``),
+bitwise against G6's pair at the same block, ms a call (median of ``--reps`` timings of ``--iters`` calls); the best
+pair a row block, and with ``--tune-out FILE`` the tuning table TF_DSV41_GM_TUNE reads (the 2,048-row entry stays
+G6's: the production numbers; the 4,096-row entry = the best pair over the layers, by total ms).
+
+    python -m tensorfold.families.deepseek_v41.cuda.gmbench --model DIR --sweep [--layers 3,20,30]
+        [--rows 2048,4096] [--tune-out gm_tune.json] [--out sweep.json]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+GBPS = 235.0
+REL_GATE = 3e-3
+
+
+def _time(fn, iters: int) -> float:
+    import torch
+
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench_layer(model: str, layer: int, rank: int, rows, iters: int) -> dict:
+    import torch
+
+    from . import blocks as B
+    from . import experts as X
+    from . import router, x3gm, x3tc
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    s = X.scratch(block, 1024)                     # the forward's shared scratch (1,024-row blocks, 7 slots)
+    _, topk = cfg.experts_of(layer)
+    E, lim = block.ex.count - block.geom.shared, cfg.swiglu_limit
+    shx = bool(torch.equal(m.w1.suh, m.w3.suh))
+    tbytes = sum(t.trellis.numel() * 2 for t in (m.w1, m.w3, m.w2))
+    gen = torch.Generator(device="cuda").manual_seed(200 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": x3gm.k2_of(m.w1.trellis), "k2_d": x3gm.k2_of(m.w2.trellis),
+                 "shx": shx, "trellis_gb": round(tbytes / 1e9, 3), "supported": x3gm.supported(m.w1, m.w3, m.w2),
+                 "rows": {}}
+    print(f"layer {layer} rank {rank}: K2 gu {out['k2_gu']} dn {out['k2_d']}, gate/up share suh: {shx}, "
+          f"routed trellis {out['trellis_gb']} GB", flush=True)
+    for R in rows:
+        x = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+        pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+        pr, wr = pick[:, :topk].contiguous(), wts[:, :topk].float().contiguous()
+        pg, wg = pick.clone(), wts.clone()
+        pg[:, topk:] = block.ex.count
+        wg[:, topk:] = 0.0
+        cnt = torch.bincount(pr.reshape(-1).long(), minlength=E)
+
+        def grouped(x=x, pg=pg, wg=wg, R=R):
+            o = torch.empty((R, cfg.hidden_size), dtype=torch.float32, device="cuda")
+            for a in range(0, R, 1024):
+                b = min(R, a + 1024)
+                X.routed(x[a:b], pg[a:b], wg[a:b], block, s, o[a:b], b - a, limit=lim)
+            return o
+
+        def tc(x=x, pr=pr, wr=wr):
+            return x3tc.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s)
+
+        def gm(c=None, x=x, pr=pr, wr=wr):
+            return x3gm.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s, shx=shx, cfg=c)
+
+        floor = x3gm.floor_bytes(R, tbytes, topk, cfg.hidden_size, m.w1.trellis.shape[2] * 16, 1 if shx else 2)
+        row = {"members_mean": round(float(cnt.float().mean()), 1), "members_max": int(cnt.max()),
+               "floor_ms": round(floor / GBPS / 1e6, 3)}
+        ref = grouped()
+        got = gm()
+        row["gm_rel_vs_grouped"] = float((got - ref).abs().max() / ref.abs().max())
+        sub = torch.arange(0, R, 7, device="cuda")
+        row["gm_rows_independent"] = bool(torch.equal(
+            x3gm.run(x[sub], pr[sub], wr[sub], m.w1, m.w3, m.w2, lim, scratch=s, shx=shx), got[sub]))
+        row["gm_repeat"] = bool(torch.equal(gm(), got))
+        for name, fn in (("grouped", grouped), ("tc", tc), ("gm", gm)):
+            ms = _time(fn, iters if name != "tc" else max(2, iters // 4))
+            row[name] = {"ms": round(ms, 3), "tflops": round(x3gm.flops(R, topk) / ms / 1e9, 1),
+                         "trellis_gbps": round(tbytes / ms / 1e6, 1), "x_floor": round(ms / row["floor_ms"], 2)}
+        if R == max(rows):
+            row["gm_cfgs"] = {}
+            for gu in (0, 1):
+                for dn in (0, 1):
+                    for ticket in (True, False):
+                        c = dict(x3gm.config(), gu=gu, dn=dn, ticket=ticket)
+                        same = bool(torch.equal(gm(c), got))
+                        row["gm_cfgs"][f"{gu},{dn},{int(ticket)}"] = {"ms": round(_time(lambda c=c: gm(c), iters), 3),
+                                                                     "bitwise": same}
+        row["pass"] = (row["gm_rel_vs_grouped"] < REL_GATE and row["gm_rows_independent"] and row["gm_repeat"]
+                       and all(v["bitwise"] for v in row.get("gm_cfgs", {}).values()))
+        out["rows"][R] = row
+        print(f"[gmbench] L{layer} R={R}: members mean {row['members_mean']} max {row['members_max']}; floor "
+              f"{row['floor_ms']} ms; grouped {row['grouped']['ms']} ms, tc {row['tc']['ms']} ms, "
+              f"gm {row['gm']['ms']} ms "
+              f"({row['gm']['tflops']} TFLOP/s, {row['gm']['x_floor']}x floor); gm vs grouped rel "
+              f"{row['gm_rel_vs_grouped']:.2e}, rows {'==' if row['gm_rows_independent'] else 'DIFFER'}"
+              + (f"; cfgs {row['gm_cfgs']}" if "gm_cfgs" in row else ""), flush=True)
+    out["pass"] = all(r["pass"] for r in out["rows"].values())
+    return out
+
+
+def sweep_layer(model: str, layer: int, rank: int, rows, iters: int, reps: int = 3) -> dict:
+    """G16 4K: every configuration of the layer's widths at each row block, in the 4K arena (see the docstring)."""
+
+    import statistics
+
+    import torch
+
+    from . import blocks as B
+    from . import moe as MO
+    from . import router, x3gm
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    m = W.Loader(cfg, W.Shards(model), rank, 2, "cuda").moe(layer, f"layers.{layer}")
+    block = B.gpu_experts(cfg, m, layer, 2, "cuda")
+    _, topk = cfg.experts_of(layer)
+    lim = cfg.swiglu_limit
+    shx = bool(torch.equal(m.w1.suh, m.w3.suh))
+    k2gu, k2d = x3gm.k2_of(m.w1.trellis), x3gm.k2_of(m.w2.trellis)
+    D, I = cfg.hidden_size, m.w1.trellis.shape[2] * 16
+    need = max(sum(x3gm.need_bytes(R, topk, D, I, 1 if shx else 2)) for R in rows)
+    s = MO.arena_scratch(block, 1024, "cuda", need)        # the 4K path's scratch: 1,024-row grouped + the arena
+    tbytes = sum(t.trellis.numel() * 2 for t in (m.w1, m.w3, m.w2))
+    gen = torch.Generator(device="cuda").manual_seed(300 + layer)
+    out: dict = {"layer": layer, "rank": rank, "k2_gu": k2gu, "k2_d": k2d, "shx": shx, "rows": {}}
+    for R in rows:
+        x = (torch.randn((R, D), generator=gen, device="cuda") * 0.5).to(torch.bfloat16)
+        pick, wts = router.route(x, m.gate, m.bias, topk=topk, shared=True, scale=cfg.routed_scaling_factor)
+        pr, wr = pick[:, :topk].contiguous(), wts[:, :topk].float().contiguous()
+        cnt = torch.bincount(pr.reshape(-1).long(), minlength=block.ex.count - block.geom.shared)
+        g6 = (0 if shx else 1, 0)
+
+        def gm(gu, dn, x=x, pr=pr, wr=wr, R=R):
+            c = dict(x3gm.config(), gu=gu, dn=dn, rows=R)
+            return x3gm.run(x, pr, wr, m.w1, m.w3, m.w2, lim, scratch=s, shx=shx, cfg=c)
+
+        want = gm(*g6).clone()
+        cells = {}
+        for gu in x3gm.GU_TILES:
+            if not x3gm.fits("gu", gu, k2gu, 1 if shx else 2):
+                continue
+            for dn in x3gm.DN_TILES:
+                if not x3gm.fits("dn", dn, k2d):
+                    continue
+                same = bool(torch.equal(gm(gu, dn), want))
+                ms = statistics.median(_time(lambda gu=gu, dn=dn: gm(gu, dn), iters) for _ in range(reps))
+                cells[f"{gu},{dn}"] = {"ms": round(ms, 3), "bitwise": same,
+                                       "passes_gu": int(x3gm.plan(pr, cnt.numel(), x3gm.bm_of("gu", gu))[4][0]),
+                                       "trellis_gbps": round(tbytes / ms / 1e6, 1)}
+        best = min(cells, key=lambda k: cells[k]["ms"])
+        floor = x3gm.floor_bytes(R, tbytes, topk, D, I, 1 if shx else 2) / GBPS / 1e6
+        out["rows"][R] = {"members_mean": round(float(cnt.float().mean()), 1), "members_max": int(cnt.max()),
+                          "floor_ms": round(floor, 3), "g6": f"{g6[0]},{g6[1]}", "best": best, "cells": cells,
+                          "pass": all(c["bitwise"] for c in cells.values())}
+        print(f"[gmbench sweep] L{layer} R={R}: members mean {out['rows'][R]['members_mean']}; floor {floor:.2f} ms; "
+              f"G6 {g6} {cells[f'{g6[0]},{g6[1]}']['ms']} ms; best {best} {cells[best]['ms']} ms; bitwise "
+              f"{'all' if out['rows'][R]['pass'] else 'NOT ALL'}", flush=True)
+    out["pass"] = all(r["pass"] for r in out["rows"].values())
+    return out
+
+
+def tune_table(layers: list[dict], rows: int = 4096) -> dict:
+    """The tuning table over the swept layers: the 4,096-row pair with the least total ms (by shx: "shx:A/B" when the
+    layers differ), the 2,048-row entry G6's."""
+
+    tot: dict = {}
+    for lay in layers:
+        cells = lay["rows"].get(rows, lay["rows"].get(str(rows), {})).get("cells", {})
+        for k, v in cells.items():
+            if v["bitwise"]:
+                tot.setdefault((lay["shx"], k), []).append(v["ms"])
+    best = {}
+    for shx in (True, False):
+        cand = {k: sum(v) for (s, k), v in tot.items() if s == shx}
+        if cand:
+            best[shx] = min(cand, key=cand.get)
+    if not best:
+        raise ValueError(f"no bitwise configuration at {rows} rows")
+    dns = {int(v.split(",")[1]) for v in best.values()}
+    gu_of = {s: int(v.split(",")[0]) for s, v in best.items()}
+    a, b = gu_of.get(True, gu_of.get(False)), gu_of.get(False, gu_of.get(True))
+    dn = min(dns)
+    return {"tune": [[0, None, 0], [48, f"shx:{a}/{b}", dn]], "from": {f"shx={int(k)}": v for k, v in best.items()}}
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--layers", default="3,20")
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--rows", default="512,1024,2048,4096")
+    ap.add_argument("--iters", type=int, default=10)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--sweep", action="store_true", help="G16 4K: every x3gm tile configuration (see above)")
+    ap.add_argument("--tune-out", default="", help="--sweep: write the tuning table (TF_DSV41_GM_TUNE) here")
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    rows = [int(v) for v in a.rows.split(",") if v]
+    if a.sweep:
+        rep = {"layers": [sweep_layer(a.model, int(L), a.rank, rows, a.iters, a.reps)
+                          for L in a.layers.split(",") if L]}
+        rep["pass"] = all(r["pass"] for r in rep["layers"])
+        if a.tune_out and max(rows) >= 4096:
+            t = tune_table(rep["layers"], 4096)
+            rep["tune"] = t
+            Path(a.tune_out).parent.mkdir(parents=True, exist_ok=True)
+            Path(a.tune_out).write_text(json.dumps(t, indent=1))
+            print(f"[gmbench sweep] tuning table -> {a.tune_out}: {t}", flush=True)
+    else:
+        rep = {"layers": [bench_layer(a.model, int(L), a.rank, rows, a.iters) for L in a.layers.split(",") if L]}
+        rep["pass"] = all(r["pass"] for r in rep["layers"])
+    if a.out:
+        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    print(json.dumps({"pass": rep["pass"]}), flush=True)
+    return 0 if rep["pass"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
