+def test_bulk_rows_numpy_owned_and_exact(monkeypatch):
+    """G12 bug 1: a prompt segment's Engram rows (made on a prefetch thread, freed on the round thread) live in a
+    NumPy-owned buffer, not c10's allocator (mimalloc in NVIDIA's builds keeps cross-thread frees), with ``dequant``'s
+    bits exactly (every FP8 byte incl. NaN / subnormals, scales 2^-20 .. 2^7)."""
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+
+    g = torch.Generator().manual_seed(7)
+    n = 3000
+    raw = torch.randint(0, 256, (n, 264), dtype=torch.uint8, generator=g)
+    raw[:256, 0] = torch.arange(256, dtype=torch.uint8)
+    scale = torch.randint(127 - 20, 127 + 8, (n, 8), dtype=torch.uint8, generator=g)
+    want = EH.dequant(raw[:, :256], scale)
+    made = []
+    real = np.empty
+
+    def spy(*a, **k):
+        arr = real(*a, **k)
+        made.append(arr)
+        return arr
+
+    monkeypatch.setattr(EH.np, "empty", spy)
+    monkeypatch.setattr(EH, "BUFFERS", EH.HostBuffers(2))
+    got = EH.dequant_host(raw[:, :256], scale)
+    assert got.dtype == torch.float32 and got.shape == (n, 256)
+    assert torch.equal(got.view(torch.int32), want.view(torch.int32))
+    assert len(made) == 1 and got.data_ptr() == made[0].ctypes.data
+
+    class Src:
+        dim = 256
+
+        def raw(self, index):
+            return np.concatenate([raw[:, :256].numpy(), scale.numpy()], 1)[index.numpy()]
+
+    idx = torch.arange(n - 1, -1, -1)
+    rows = PF.bulk_rows(Src(), idx)
+    assert torch.equal(rows.view(torch.int32), want[idx].view(torch.int32))
+    assert rows.data_ptr() == made[-1].ctypes.data
+
