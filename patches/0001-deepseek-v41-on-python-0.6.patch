+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1 image input, engine pieces on the CPU (TF_DSV41_IMAGES=native):
+
+- the processor (``vision_prep``) == DeepSeek's ``inference/image_processor.py`` (vendored in tests/fixtures): resize
+  plans over many sizes and aspect ratios, the patches bit for bit, the span layout and length;
+- the tower (``vision.Tower``) == DeepSeek's ``inference/vision.py`` ViT + aligner on random small weights, and the
+  span rows placed as ``merge_image_embeddings`` places them; its attention under CUDA's fused-kernel rules (flash /
+  memory-efficient only, 4-D q / k / v: ``fused_only``), which the CPU's own SDPA does not enforce;
+- digests / virtual ids: the same pixels -> the same ids, any other image or setting -> others;
+- ``vision.Store`` (hold / release / gather), ``window`` / ``fill`` (rank 0 only), ``moe`` (image rows with
+  ``bias_vl``, the rest with the bias, == the per-row ``torch.where`` of the reference's ``Gate``);
+- Engram: every id past the vocabulary is DEAD in the hasher and the round tables (== an explicit image mask).
+
+The forward with image positions against engine/reference (exact, TP=2, cut spans, CED replay) lives in the development
+tree (unpublished) (tests/family/test_vision_reference.py), next to the reference.
+"""
+
+from __future__ import annotations
+
+import base64
+import importlib.util
+import io
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+PIL = pytest.importorskip("PIL")
+pytestmark = pytest.mark.torch
+
+from PIL import Image
+
+from tensorfold.families.deepseek_v41.cuda import vision as V
+from tensorfold.families.deepseek_v41.cuda import vision_prep as VP
+
+FIX = Path(__file__).parent / "fixtures"
+VISION_CONFIG = {"model_type": "deepseek_v41_vision", "num_hidden_layers": 32, "hidden_size": 1024,
