+def test_rule_for_phase_and_geometry():
+    cfg = PR.parse({"TF_DSV41_EXPERT_TOPP": "0.9", "TF_DSV41_DRAFT_EXPERT_TOPP": "0.8"})
+    tgt, drf = _Moe(384, 6), _Moe(128, 3)
+    assert PR.rule_for(tgt, cfg) == cfg["target"]
+    with PR.phase(True):
