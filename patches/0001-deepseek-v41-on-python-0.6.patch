@@ -0,0 +1,314 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K: the x3gm retune for 4,096-row blocks (~64 members an expert) without a GPU.
+
+- the tile table: x3gm.py GU_TILES / DN_TILES == x3gm.cu's GM_GU* / GM_DN* lines; shared memory a configuration
+  (x3gm.smem_bytes == the emulator's Cfg.SMEM + static) and which ones fit sm_121's 99 KiB a width;
+- the emulator (``dsv41_x3gm_emu``): every new configuration (128-member passes, deeper rings) gives the G6
+  configuration's bits for the same block, with a 140-member expert (3 passes of 64, 2 of 128), a 1-member expert,
+  any item order and CTA count, every output stored once, a row's bits independent of its block-mates;
+- the host side: ``plan`` at 128 members, the tuning table (2,048-row blocks keep G6's ids; 4,096 take the 4K entry;
+  TF_DSV41_GM_CFG and TF_DSV41_GM_TUNE), the scratch arena (a 4,096-row block in a 1,024-row grouped scratch's
+  bytes, X / Y and Xd disjoint);
+- sm_121 compile (nvcc, -DDSV41_X3GM_NO_TORCH with stub torch headers): every gm_kernel instance (6 gate/up x 2
+  inputs x 3 widths, 5 down x 3 widths), 0 spills, no stack, registers under each instance's launch-bounds cap.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import dsv41_x3gm_emu as EMU
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import x3gm
+
+CU = Path(x3gm.__file__).with_name("x3gm.cu")
+NEW_GU = [c for c in x3gm.GU_TILES if c >= 2]
+NEW_DN = [c for c in x3gm.DN_TILES if c >= 2]
+
+
+# -- the tile table -------------------------------------------------------------------------------------------------
+def test_tile_table_matches_the_kernel_source():
+    src = CU.read_text()
+    for kind, tiles in (("GU", x3gm.GU_TILES), ("DN", x3gm.DN_TILES)):
+        got = {int(i): tuple(int(v) for v in vals.split(","))
+               for i, vals in re.findall(rf"#define GM_{kind}(\d+) ([\d, ]+)\n", src)}
+        assert got == tiles, kind
+        assert f"#define GM_N{kind} {len(tiles)}" in src
+        for i in tiles:
+            assert f"case {i}: launch<" in src
+    cpp = CU.with_name("x3gm.cpp").read_text()
+    assert f"cfg < {len(x3gm.GU_TILES)}" in cpp and f"cfg < {len(x3gm.DN_TILES)}" in cpp
+    assert x3gm.GU_TILES[0] == (2, 8, 4, 3, 4) and x3gm.GU_TILES[1] == (2, 8, 2, 4, 4)       # G6's, unchanged
+    assert x3gm.DN_TILES[0] == (2, 8, 4, 4, 8) and x3gm.DN_TILES[1] == (1, 8, 4, 4, 8)
+
+
+def _minb_new(tile, mats, xm, k2):
+    mtl, ng = tile[0], tile[1]
+    c = EMU.Cfg(mats, xm, k2, *tile)
+    return 2 if 2 * (c.SMEM + 1536) <= 102400 and c.THREADS <= 256 and mtl * ng <= 16 else 1
+
+
+def _minb_g6(tile, mats, xm, k2):
+    c = EMU.Cfg(mats, xm, k2, *tile)
+    return 2 if 2 * (c.SMEM + 1536) <= 102400 else 1
+
+
+@pytest.mark.parametrize("k2", x3gm.K2S)
+def test_shared_memory_and_register_caps(k2):
+    for kind, tiles, mats in (("gu", x3gm.GU_TILES, 2), ("dn", x3gm.DN_TILES, 1)):
+        for cfg, tile in tiles.items():
+            for xm in ((1, 2) if kind == "gu" else (1,)):
+                c = EMU.Cfg(mats, xm, k2, *tile)
+                assert x3gm.smem_bytes(tile, mats, xm, k2) == c.SMEM + 4 * c.BM + 4
+                assert x3gm.bm_of(kind, cfg) == c.BM
+                if cfg < 2:                  # G6's tiles: the same launch bounds as before 4K (identical PTX)
+                    assert _minb_new(tile, mats, xm, k2) == _minb_g6(tile, mats, xm, k2)
+                    assert x3gm.fits(kind, cfg, k2, xm)
+    assert not x3gm.fits("gu", 3, 8, 2) and x3gm.fits("gu", 3, 8, 1)      # 4 k tiles x 128 members x two inputs
+
+
+# -- the emulator: every configuration the same bits ----------------------------------------------------------------
+def _trellis(rng, E, K, N, bits):
+    return rng.integers(-32768, 32768, size=(E, K // 16, N // 16, 16 * bits), dtype=np.int16)
+
+
+def _layer(seed, E, D, I, bits, shx):
+    rng = np.random.default_rng(seed)
+    tg, tu, td = _trellis(rng, E, D, I, bits), _trellis(rng, E, D, I, bits), _trellis(rng, E, I, D, bits)
+    sign = lambda *s: np.where(rng.random(s) < 0.5, -1.0, 1.0).astype(np.float16)         # noqa: E731
+    suh_g = sign(E, D)
+    suh_u = suh_g.copy() if shx else sign(E, D)
+    svh_g = (rng.standard_normal((E, I)) * 0.08).astype(np.float16)
+    svh_u = (rng.standard_normal((E, I)) * 0.08).astype(np.float16)
+    suh_d = sign(E, I)
+    svh_d = (rng.standard_normal((E, D)) * 0.05).astype(np.float16)
+    return (tg.view(np.uint32), tu.view(np.uint32), td.view(np.uint32)), (suh_g, suh_u, svh_g, svh_u, suh_d, svh_d)
+
+
+def _picks(seed, R, S, E):
+    """Expert 0 in every row (R members: 3 passes of 64 / 2 of 128 at R = 140), expert E - 1 in one row."""
+
+    rng = np.random.default_rng(seed)
+    pick = np.zeros((R, S), dtype=np.int64)
+    for r in range(R):
+        pick[r] = np.concatenate([[0], rng.permutation(np.arange(1, E - 1))[:S - 1]])
+    pick[R // 2, S - 1] = E - 1
+    wts = (rng.random((R, S)) * 0.6 + 0.2).astype(np.float16).astype(np.float32)
+    return pick, wts
+
+
+def _bf16(a):
+    return torch.from_numpy(a.astype(np.float32)).to(torch.bfloat16).float().numpy()
+
+
+@pytest.fixture(scope="module")
+def block():
+    E, D, I, R, S = 5, 128, 256, 140, 2
+    tw, sc = _layer(21, E, D, I, 3, False)
+    tws, scs = _layer(21, E, D, I, 3, True)
+    pick, wts = _picks(8, R, S, E)
+    x = _bf16(np.random.default_rng(9).standard_normal((R, D)))
+    g6 = EMU.routed(x, pick, wts, *tw, *sc, 10.0, shx=False, gu_cfg=1, dn_cfg=0)
+    g6s = EMU.routed(x, pick, wts, *tws, *scs, 10.0, shx=True, gu_cfg=0, dn_cfg=0)
+    return {"x": x, "pick": pick, "wts": wts, "tw": tw, "sc": sc, "tws": tws, "scs": scs, "g6": g6, "g6s": g6s}
+
+
+def _same(a, b):
+    return np.array_equal(a.view(np.uint32), b.view(np.uint32))
+
+
+@pytest.mark.parametrize("gu", NEW_GU)
+def test_new_gateup_configs_same_bits(block, gu):
+    b = block
+    for shx, tw, sc, want in ((False, b["tw"], b["sc"], b["g6"]), (True, b["tws"], b["scs"], b["g6s"])):
+        if not x3gm.fits("gu", gu, 6, 1 if shx else 2):
+            continue
+        out, st_gu, st_dn = EMU.routed(b["x"], b["pick"], b["wts"], *tw, *sc, 10.0, shx=shx, gu_cfg=gu, dn_cfg=0)
+        assert _same(out, want[0]), (gu, shx)
+        assert (st_gu == 1).all() and (st_dn == 1).all()
+
+
+@pytest.mark.parametrize("dn", NEW_DN)
+def test_new_down_configs_same_bits(block, dn):
+    b = block
+    out, st_gu, st_dn = EMU.routed(b["x"], b["pick"], b["wts"], *b["tw"], *b["sc"], 10.0, shx=False, gu_cfg=1,
+                                   dn_cfg=dn)
+    assert _same(out, b["g6"][0]), dn
+    assert (st_dn == 1).all()
+
+
+def test_4k_pair_any_order_row_independent(block):
+    """The provisional 4K pair (gu 2, dn 2): any item order / CTA count; a row's bits alone == in its block."""
+
+    b = block
+    got, _, _ = EMU.routed(b["x"], b["pick"], b["wts"], *b["tw"], *b["sc"], 10.0, shx=False, gu_cfg=2, dn_cfg=2,
+                           order_seed=5, ctas=3)
+    assert _same(got, b["g6"][0])
+    rows = np.r_[0:3, 69:72]                                  # expert 0 drops to one pass, expert E - 1 kept
+    sub, _, _ = EMU.routed(b["x"][rows], b["pick"][rows], b["wts"][rows], *b["tw"], *b["sc"], 10.0, shx=False,
+                           gu_cfg=2, dn_cfg=2)
+    assert _same(sub, b["g6"][0][rows])
+
+
+# -- host side ------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("R,S,E", [(4096, 6, 384), (300, 6, 384), (1, 6, 384)])
+def test_plan_at_128_members(R, S, E):
+    g = torch.Generator().manual_seed(R)
+    pick = torch.stack([torch.randperm(E, generator=g)[:S] for _ in range(R)])
+    if R > 128:
+        pick[:, 0] = 7                                        # 2+ passes of 128
+    order, pe, poff, pcnt, npass = x3gm.plan(pick, E, 128)
+    n = int(npass[0])
+    flat = pick.reshape(-1)
+    seen = torch.zeros(R * S, dtype=torch.int64)
+    for t in range(n):
+        c = int(pcnt[t])
+        assert 1 <= c <= 128
+        mem = order[int(poff[t]):int(poff[t]) + c].long()
+        assert (flat[mem] == int(pe[t])).all()
+        seen[mem] += 1
+    assert (seen == 1).all()
+    assert n == int(((torch.bincount(flat, minlength=E) + 127) // 128).sum())
+    assert n <= int(x3gm.plan(pick, E, 64)[4][0])
+    if R == 4096:                                             # uniform picks, ~64 members an expert: 2/3 the passes
+        uni = torch.stack([torch.randperm(E, generator=g)[:S] for _ in range(R)])
+        n64, n128 = (int(x3gm.plan(uni, E, bm)[4][0]) for bm in (64, 128))
+        assert n128 < 0.75 * n64, (n64, n128)
+
+
+def test_tuning_table(tmp_path):
+    cfg = x3gm.config({})
+    assert x3gm.tuned(cfg, 2048, 6, 384, True) == (0, 0)                 # production's 2,048-row blocks: G6
+    assert x3gm.tuned(cfg, 2048, 6, 384, False) == (1, 0)
+    assert x3gm.tuned(cfg, 1024, 6, 384, False) == (1, 0)
+    assert x3gm.tuned(cfg, 4096, 6, 384, True) == (3, 2)                 # 4K: 128-member passes
+    assert x3gm.tuned(cfg, 4096, 6, 384, False) == (2, 2)
+    assert x3gm.tuned(cfg, 4096, 6, 384, False, k2gu=8) == (2, 2)
+    pin = x3gm.config({"TF_DSV41_GM_CFG": "5,3"})
+    assert x3gm.tuned(pin, 4096, 6, 384, True) == (5, 3) and x3gm.tuned(pin, 2048, 6, 384, True) == (5, 3)
+    half = x3gm.config({"TF_DSV41_GM_CFG": "a,1"})
+    assert x3gm.tuned(half, 4096, 6, 384, False) == (2, 1)
+    p = tmp_path / "tune.json"
+    p.write_text(json.dumps({"tune": [[0, None, 0], [40, 4, 4]]}))
+    t = x3gm.config({"TF_DSV41_GM_TUNE": str(p)})
+    assert x3gm.tuned(t, 4096, 6, 384, False) == (4, 4) and x3gm.tuned(t, 2048, 6, 384, False) == (1, 0)
+    for bad in ({"tune": [[0, 9, 0]]}, {"tune": [[0, None, 7]]}, {"tune": [[10, None, 0]]}):
+        p.write_text(json.dumps(bad))
+        with pytest.raises(ValueError):
+            x3gm.config({"TF_DSV41_GM_TUNE": str(p)})
+
+
+class _Arena:
+    """moe.arena_scratch's view at 1,024 rows x 7 slots (the float buffers in one allocation)."""
+
+    def __init__(self, nbytes):
+        self.arena = torch.zeros((nbytes,), dtype=torch.uint8)
+        self.z = self.arena[:264241152].view(torch.float32)
+        self.xg = self.arena[264241152 + 146800640:][:73400320].view(torch.float16)
+
+
+@pytest.mark.parametrize("mats_x", [1, 2])
+def test_buffers_4096_rows_in_the_arena(mats_x):
+    from tensorfold.families.deepseek_v41.cuda import moe
+
+    nbytes = moe.arena_bytes(1024, 7, 5120, 1152)
+    assert nbytes == 574357504                                # z + y + xg + xu + xd of upstream's 1,024-row scratch
+    s = _Arena(nbytes)
+    b = x3gm.Buffers(s, 4096, 4096, 6, 5120, 1152, mats_x, "cpu")
+    assert b.aliased and b.rows == 4096                       # one block a 4,096-row segment, nothing allocated
+    lo, hi = s.arena.data_ptr(), s.arena.data_ptr() + nbytes
+    end = lambda t: t.data_ptr() + t.numel() * t.element_size()                         # noqa: E731
+    for t in (b.x, b.y, b.xd):
+        assert lo <= t.data_ptr() and end(t) <= hi
+    assert end(b.x) <= b.xd.data_ptr() and end(b.y) <= b.xd.data_ptr()                 # Xd lives through down
+    small = x3gm.Buffers(_Arena(nbytes // 2), 4096, 4096, 6, 5120, 1152, mats_x, "cpu")
+    assert small.rows == 2048                                 # what fits (G6's fallback: two blocks)
+
+
+# -- sm_121 compile -------------------------------------------------------------------------------------------------
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+def _instances():
+    out = []
+    for k2 in x3gm.K2S:
+        for xm in (1, 2):
+            out += [(2, xm, k2, *t) for t in x3gm.GU_TILES.values()]
+        out += [(1, 1, k2, *t) for t in x3gm.DN_TILES.values()]
+    return out
+
+
+@pytest.mark.skipif(_nvcc() is None, reason="no nvcc with compute_121 (TF_NVCC)")
+def test_sm121_compile_no_spills(tmp_path):
+    from tensorfold.cuda import exl3
+
+    stub = tmp_path / "stub"
+    (stub / "ATen" / "cuda").mkdir(parents=True)
+    (stub / "c10" / "cuda").mkdir(parents=True)
+    (stub / "ATen" / "ATen.h").write_text("#pragma once\n#define TORCH_CHECK(cond, ...) ((void)(cond))\n")
+    (stub / "ATen" / "cuda" / "CUDAContext.h").write_text("#pragma once\n")
+    (stub / "c10" / "cuda" / "CUDAGuard.h").write_text("#pragma once\n")
+    inst = _instances()
+    src = tmp_path / "inst.cu"
+    src.write_text(f'#include "{CU.name}"\n' + "".join(
+        f"template __global__ void dsv41_x3gm::gm_kernel<{', '.join(map(str, i))}>(const dsv41_x3gm::Args);\n"
+        for i in inst))
+    out = subprocess.run([_nvcc(), "-std=c++17", "-O3", "-DDSV41_X3GM_NO_TORCH", f"-I{stub}", f"-I{CU.parent}",
+                          f"-I{Path(exl3.__file__).parent}", "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v",
+                          "-c", str(src), "-o", str(tmp_path / "inst.o")],
+                         capture_output=True, text=True, timeout=1800, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    seen = {}
+    for blk in out.stderr.split("Compiling entry function '")[1:]:
+        name = blk.split("'")[0]
+        if "gm_kernel" not in name:
+            continue
+        args = tuple(int(v) for v in re.findall(r"Li(\d+)E", re.search(r"gm_kernelI(.*)EEvN", name).group(1) + "E"))
+        st = re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes spill loads", blk).groups()
+        regs = int(re.search(r"Used (\d+) registers", blk).group(1))
+        seen[args] = (st, regs)
+    assert set(seen) == set(inst)
+    rows = []
+    for (mats, xm, k2, *tile), (st, regs) in sorted(seen.items()):
+        c = EMU.Cfg(mats, xm, k2, *tile)
+        cap = min(255, 65536 // (c.THREADS * _minb_new(tuple(tile), mats, xm, k2)))
+        assert st == ("0", "0", "0"), (mats, xm, k2, tile, st)
+        assert regs <= cap, (mats, xm, k2, tile, regs, cap)
+        rows.append(regs)
+    print(f"[G16 4K] x3gm sm_121: {len(seen)} gm_kernel instances, registers {min(rows)}-{max(rows)}, 0 spills")
+
+
+def test_sweep_tuning_table_round_trip(tmp_path):
+    from tensorfold.families.deepseek_v41.cuda import gmbench
+
+    lay = lambda shx, cells: {"shx": shx, "rows": {4096: {"cells": cells}}}                # noqa: E731
+    cells = {"1,0": {"ms": 30.0, "bitwise": True}, "2,2": {"ms": 21.0, "bitwise": True},
+             "4,4": {"ms": 19.0, "bitwise": False}}                                     # not bitwise: never picked
+    t = gmbench.tune_table([lay(False, cells), lay(False, {**cells, "2,2": {"ms": 25.0, "bitwise": True}})])
+    assert t["tune"] == [[0, None, 0], [48, "shx:2/2", 2]]
+    p = tmp_path / "tune.json"
+    p.write_text(json.dumps(t))
+    c = x3gm.config({"TF_DSV41_GM_TUNE": str(p)})
+    assert x3gm.tuned(c, 4096, 6, 384, False) == (2, 2) and x3gm.tuned(c, 2048, 6, 384, False) == (1, 0)
+    with pytest.raises(ValueError):
+        gmbench.tune_table([lay(False, {"4,4": {"ms": 1.0, "bitwise": False}})])
