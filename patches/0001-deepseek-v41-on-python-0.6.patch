+LONG_PROMPTS = [[int(t) for t in np.random.default_rng(10 + i).integers(3, 250, size=2056 + 9 * i)]
+                for i in range(4)]
+SHORT = [[int(t) for t in np.random.default_rng(s).integers(3, 250, size=n)] for s, n in ((1, 45), (2, 70))]
