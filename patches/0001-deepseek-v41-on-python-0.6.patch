+# -- compatibility ---------------------------------------------------------------------------------------------------
+# knobs that cannot change a stored bit (paths, scheduling, the store's own sizes, reporting); every other
+# GLM53_TF_* knob is in the hash, so a new knob is conservative by default (it only costs a cold start)
+KNOB_SKIP_PREFIX = ("GLM53_TF_SESSION_", "GLM53_TF_BATCH", "GLM53_TF_CALIB", "GLM53_TF_PREPARED", "GLM53_TF_STALL",
+                    "GLM53_TF_TOKCACHE", "GLM53_TF_KV_POOL",      # patches/0290: where rows live, never their bits
+                    "GLM53_TF_PREFIX_SHARE")                      # patches/0310: where snapshots are taken
+KNOB_SKIP = {"GLM53_TF_T0", "GLM53_TF_LAUNCH_T0", "GLM53_TF_IMAGE_ID", "GLM53_TF_CLOCK_CAP", "GLM53_TF_BOOT_WARMUP",
+             "GLM53_TF_HEALTH", "GLM53_TF_EFFORT_FIELD", "GLM53_TF_DEFAULT_EFFORT", "GLM53_TF_PROFILE",
+             "GLM53_TF_DEPTH", "GLM53_TF_LOOKUP", "GLM53_TF_LOOKUP_MIN", "GLM53_TF_AUTO_FDRAFTS",
+             "GLM53_TF_PREFILL_ROWS", "GLM53_TF_PREFILL_ROWS_MAX",
+             # patches/0360: the DEFAULT b12x bits; the bits a prefill ran are in every entry's snapshot tag (key), so
+             # changing the default must not hide the store (GLM53_TF_B12X_KDA_* decide bits: they stay in the hash)
+             "GLM53_TF_B12X"}
+
+
+def knobs(env: dict | None = None) -> dict:
+    env = os.environ if env is None else env
+    return {k: v for k, v in sorted(env.items()) if k.startswith("GLM53_TF_") and k not in KNOB_SKIP
+            and not k.startswith(KNOB_SKIP_PREFIX)}
+
+
+# patches/0300: the request log only reports
+KNOB_SKIP_PREFIX = KNOB_SKIP_PREFIX + ("GLM53_TF_REQUEST_LOG",)
+
+# patches/0400: the KDA recurrence v2 computes fast_kda's bits (speed settings only)
+KNOB_SKIP_PREFIX = KNOB_SKIP_PREFIX + ("GLM53_TF_KDA_V2",)
+
+# patches/0410: the sparse attention v2 computes the one-pass kernel's bits (speed settings only)
+KNOB_SKIP_PREFIX = KNOB_SKIP_PREFIX + ("GLM53_TF_SPARSE_V2",)
+
+# patches/0440: the streaming decode kernels compute the bits of exl3.cu's grouped kernels and qmm._qmm (speed settings
+# only; GLM53_TF_DEC_QMM=force, measurements only, is the exception it documents)
+KNOB_SKIP_PREFIX = KNOB_SKIP_PREFIX + ("GLM53_TF_DEC_EXPERTS", "GLM53_TF_DEC_QMM", "GLM53_TF_DEC_PDL", "GLM53_TF_DEC_CTAS")
+
+# patches/0580: the expert load path computes exl3.cu's bits (speed settings only; 0570's GLM53_TF_DEC_QMM_* are above)
+KNOB_SKIP_PREFIX = KNOB_SKIP_PREFIX + ("GLM53_TF_DEC_EXPERT_LOADS",)
+
