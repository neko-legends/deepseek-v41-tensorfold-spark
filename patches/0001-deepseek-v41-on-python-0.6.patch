index 0000000..6fdd6c9
--- /dev/null
+++ b/tests/dsv41_dense3_emu.py
@@ -0,0 +1,216 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A numpy emulator (no GPU) of ``dense3.cu`` (TF_DSV41_DENSE_V3): the "lanes" layout and what the kernels do with it.
+
+- ``to_lanes`` / ``to_strips``: the layout as array operations (the reference), and ``to_lanes_word`` /
+  ``to_strips_word``: ``to_lanes_kernel`` / ``to_strips_kernel``'s statements for one destination word, transcribed.
+- ``lane_words``: the words a lane's ``load_group`` puts in its registers, with the kernel's pointer arithmetic
+  (``base = T + nb stride_nb + kt0 stride_k + 4 lane``, ``+ gi G stride_k``, chunk c at ``+ 128 c``).
+- ``pair_states``: ``pair_frags``'s integer work for every lane of a tile pair: ``take_bits`` (the 64-bit shifts),
+  the two tails packed in one 32-bit shuffle from lane - 1, the 8 windows of each tile. Equal to
+  ``exl3.format.states`` means the decoded values (``decode2`` of the states) are upstream's.
+- ``warp_loads``: every 16-byte load a warp issues over its walk (address, chunk) for a program of a segment, for
+  the coalescing / read-once checks; ``walk``: the k loop's register flow (cur / nxt groups, a / an fragments).
+- ``unpack``: ``lanes_unpack_kernel``'s W_q (fast prefill), from ``pair_states`` and the mul1 codebook.
+
+Bits: everything after the k loop is x3seg's (``dsv41_x3seg_emu.program`` emulates it), and a k step's mma inputs
+are the same fp16 values in the same order, so dense3 == x3seg follows from ``pair_states == format.states`` and
+``walk``'s order.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+U64 = np.uint64
+
+
+def group_steps(k2: int) -> int:
+    return 1 if k2 == 16 else 2
+
+
+def gwords(k2: int) -> int:
+    return group_steps(k2) * k2
+
+
+# -- bits <-> words (bit b of a word stream = bit 31 - b % 32 of word b // 32, decode.cuh's reading) ----------------
+def bits_of(w: np.ndarray) -> np.ndarray:
+    return np.unpackbits(np.ascontiguousarray(w.astype(np.uint32).astype(">u4")).view(np.uint8), axis=-1)
+
+
+def words_of(b: np.ndarray) -> np.ndarray:
+    return np.ascontiguousarray(np.packbits(b, axis=-1)).view(">u4").astype(np.uint32)
+
+
+def strips_of(trellis: np.ndarray) -> np.ndarray:
+    """int16 trellis [K/16, N/16, 16 bits] -> upstream's strips words uint32 [N/128, K/16, 8, 8 bits]."""
+
+    kt, nt, w16 = trellis.shape
+    words = np.ascontiguousarray(trellis).view(np.uint32).reshape(kt, nt, w16 // 2)
+    return np.ascontiguousarray(words.reshape(kt, nt // 8, 8, w16 // 2).transpose(1, 0, 2, 3))
+
+
+def to_lanes(strips: np.ndarray, k2: int) -> np.ndarray:
+    """strips words [NB, KT, 8, 4 K2] -> lanes words, the same shape (a bit permutation inside each strip)."""
+
+    nb, kt = strips.shape[:2]
+    G, n, GW = group_steps(k2), 4 * k2, gwords(k2)
+    own = bits_of(strips).reshape(nb, kt // G, G, 8, 32, n).transpose(0, 1, 4, 2, 3, 5)
+    lw = words_of(own.reshape(nb, kt // G, 32, GW * 32))                     # [NB, KT/G, lane, G K2 words]
+    return np.ascontiguousarray(lw.reshape(nb, kt // G, 32, GW // 4, 4).transpose(0, 1, 3, 2, 4)).reshape(strips.shape)
+
+
+def to_strips(lanes: np.ndarray, k2: int) -> np.ndarray:
+    nb, kt = lanes.shape[:2]
+    G, n, GW = group_steps(k2), 4 * k2, gwords(k2)
+    lw = lanes.reshape(nb, kt // G, GW // 4, 32, 4).transpose(0, 1, 3, 2, 4).reshape(nb, kt // G, 32, GW)
+    own = bits_of(lw).reshape(nb, kt // G, 32, G, 8, n).transpose(0, 1, 3, 4, 2, 5)
+    return words_of(own.reshape(nb, kt, 8, 32 * n)).reshape(lanes.shape)
+
+
+# -- the relayout kernels' statements, one destination word (dense3.cu to_lanes_kernel / to_strips_kernel) ---------
+def _bit(flat: np.ndarray, at: int, sb: int) -> int:
+    return (int(flat[at + (sb >> 5)]) >> (31 - (sb & 31))) & 1
+
+
+def to_lanes_word(src: np.ndarray, i: int, k2: int, KT: int) -> int:
+    G, n, TW = group_steps(k2), 4 * k2, 4 * k2
+    strip_words, gw = KT * 32 * k2, G * 32 * k2
+    strip, r = divmod(i, strip_words)
+    gi, qd = divmod(r, gw)
+    c, L, w = qd // 128, (qd % 128) // 4, 4 * (qd // 128) + qd % 4
+    out = 0
+    for b in range(32):
+        lb = 32 * w + b
+        tt, ob = divmod(lb, n)
+        kt = gi * G + tt // 8
+        out |= _bit(src, strip * strip_words + kt * 32 * k2 + (tt % 8) * TW, n * L + ob) << (31 - b)
+    assert c * 128 + 4 * L + qd % 4 == qd
+    return out
+
+
+def to_strips_word(src: np.ndarray, i: int, k2: int, KT: int) -> int:
+    G, n, TW = group_steps(k2), 4 * k2, 4 * k2
+    strip_words = KT * 32 * k2
+    strip, r = divmod(i, strip_words)
+    kt, tw = divmod(r, 32 * k2)
+    j, wd = divmod(tw, TW)
+    gi = kt // G
+    tt = (kt % G) * 8 + j
+    s0 = strip * strip_words + gi * G * 32 * k2
+    out = 0
+    for b in range(32):
+        sb = 32 * wd + b
+        L = sb // n
+        lb = tt * n + sb % n
+        w = lb >> 5
+        out |= ((int(src[s0 + ((w >> 2) * 32 + L) * 4 + (w & 3)]) >> (31 - (lb & 31))) & 1) << (31 - b)
+    return out
+
+
+# -- what a lane holds and computes ------------------------------------------------------------------------------
+def lane_words(flat: np.ndarray, k2: int, K: int, nb: int, kt0: int, gi: int) -> np.ndarray:
+    """[32, G K2] uint32: R of every lane after ``load_group(base + gi * gstride, R)`` (kt0 = the warp's first step)."""
+
+    stride_k, stride_nb = 32 * k2, (K // 16) * 32 * k2
+    G, GW = group_steps(k2), gwords(k2)
+    lane = np.arange(32)
+    base = nb * stride_nb + kt0 * stride_k + 4 * lane + gi * G * stride_k
+    idx = base[:, None] + (np.arange(GW // 4)[None, :, None] * 128 + np.arange(4)[None, None, :]).reshape(1, GW)
+    return flat[idx]
+
+
+def take_bits(R: np.ndarray, p: int, n: int) -> np.ndarray:
+    """``take_bits``: bits [p, p + n) of each lane's words as uint64 (the kernel's shifts, mod 2^64)."""
+
+    GW = R.shape[-1]
+    wi, bo = p >> 5, p & 31
+    x = (R[..., wi].astype(U64) << U64(32)) | (R[..., wi + 1].astype(U64) if wi + 1 < GW else U64(0))
+    return x if n == 64 else (x << U64(bo)) >> U64(64 - n)
+
+
+def pair_states(R: np.ndarray, k2: int, g: int, j: int) -> np.ndarray:
+    """``pair_frags``' states [2, 32 lanes, 8] for tiles j, j + 1 of step g (R: [32, G K2], every lane's words)."""
+
+    n = 4 * k2
+    o0, o1 = take_bits(R, (g * 8 + j) * n, n), take_bits(R, (g * 8 + j + 1) * n, n)
+    tails = (o0 & U64(0xFFFF)) | ((o1 & U64(0xFFFF)) << U64(16))
+    pre = np.roll(tails, 1)                                   # __shfl_sync(tails, (lane + 31) & 31)
+    out = np.empty((2, 32, 8), dtype=np.uint32)
+    for h in range(2):
+        o = o1 if h else o0
+        p = (pre >> U64(16)) if h else (pre & U64(0xFFFF))
+        for v in range(8):
+            sh = (7 - v) * k2 // 2
+            w = o >> U64(sh)
+            if n - sh < 16:
+                w = w | (p << U64(n - sh))
+            out[h, :, v] = (w & U64(0xFFFF)).astype(np.uint32)
+    return out
+
+
+def states(lanes: np.ndarray, k2: int) -> np.ndarray:
+    """Every value's state [KT, NT, 256] (format.states' order: value 8 lane + v of tile (kt, nt)) from lanes words,
+    the kernel's way: a lane's group words, then ``pair_states`` for each tile pair."""
+
+    nb, KT = lanes.shape[:2]
+    K, G = 16 * KT, group_steps(k2)
+    flat = lanes.reshape(-1)
+    out = np.empty((KT, nb * 8, 256), dtype=np.uint32)
+    for s in range(nb):
+        for kt in range(KT):
+            R = lane_words(flat, k2, K, s, (kt // G) * G, 0)
+            for j in range(0, 8, 2):
+                st = pair_states(R, k2, kt % G, j)
+                out[kt, s * 8 + j] = st[0].reshape(256)
+                out[kt, s * 8 + j + 1] = st[1].reshape(256)
+    return out
+
+
+def unpack(lanes: np.ndarray, k2: int) -> np.ndarray:
+    """``lanes_unpack_kernel``: W_q [K, N] fp16 from lanes words (mul1)."""
+
+    from tensorfold.cuda.exl3 import format as fmt
+
+    st = states(lanes, k2)
+    KT, NT = st.shape[:2]
+    rows, cols = fmt.tile_positions()
+    w = np.empty((KT, 16, NT, 16), dtype=np.float16)
+    w[:, rows, :, cols] = fmt.codebook("mul1")[st.astype(np.int64)].transpose(2, 0, 1)
+    return w.reshape(KT * 16, NT * 16)
+
+
+# -- a program's loads and its k loop ------------------------------------------------------------------------------
+def warp_loads(K: int, N: int, k2: int, sk: int, wk: int, nb: int, split: int, warp: int) -> list:
+    """[(first word of the warp-wide 16-byte load, chunk c)] in issue order, for warp ``warp`` of program
+    (nb, split) of a segment: the kernel's ``base`` / ``gstride`` arithmetic."""
+
+    stride_k, stride_nb = 32 * k2, (K // 16) * 32 * k2
+    G, GW = group_steps(k2), gwords(k2)
+    per_warp = (K // 16) // sk // wk
+    assert per_warp % G == 0
+    kt0 = split * (per_warp * wk) + warp * per_warp
+    base0 = nb * stride_nb + kt0 * stride_k                 # lane 0's base, without the 4 * lane
+    return [(base0 + gi * G * stride_k + 128 * c, c) for gi in range(per_warp // G) for c in range(GW // 4)]
+
+
+def walk(steps: int, G: int) -> list:
+    """The k loop's register flow: [(step i, the group in cur, its step st, the k step in a)] at each step's mmas."""
+
+    assert steps % G == 0
+    groups = steps // G
+    cur = 0 if groups else None
+    a = 0 if steps else None
+    an = nxt = None
+    used = []
+    for gi in range(groups):
+        if gi + 1 < groups:
+            nxt = gi + 1
+        for st in range(G):
+            i = gi * G + st
+            if i + 1 < steps:
+                an = i + 1
+            used.append((i, cur, st, a))
+            a = an
+        cur = nxt
+    return used
