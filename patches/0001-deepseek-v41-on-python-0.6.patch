new file mode 100644
index 0000000..2179358
--- /dev/null
+++ b/tests/test_roce_g14_msg.py
@@ -0,0 +1,154 @@
+"""G14: the RoCE host mailbox's protocol (``glm5_next/spark/roce_msg.h``, TF_DSV41_PLAN_LINK=rdma) on the CPU. A
+plain C++ harness gives two ranks their own region, a sender thread on rank 0, a receiver on rank 1 and a "proxy"
+thread that does what the two proxies do over RDMA (a chunk, then its flag; the receiver's ack back), at its own
+pace. No CUDA, torch or verbs.
+
+- 400 messages of 0 bytes .. 300 KiB (up to 5 chunks; > MSG_SLOTS chunks in flight forces the credit wait), random
+  bytes: rank 1 receives every one, byte for byte, in order;
+- a slow proxy (deliveries delayed) and a slow receiver: still exact; the sender blocks on credits, never overwrites
+  a slot a receiver has not consumed (the harness checks every delivered chunk's sequence against its slot);
+- the credit timeout: no receiver -> send returns false after the timeout;
+- liveness: the receiver naps with a socket to the sender polled; closing the socket ends recv with "closed the
+  connection" (rank 1 must not hang when rank 0 is gone);
+- the region layout: every part 64-byte aligned, inside the region, no overlaps.
+
+    pytest -q tests/test_roce_g14_msg.py
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+HDR = Path(__file__).resolve().parents[1] / "src/tensorfold/families/glm5_next/spark/roce_msg.h"
+
+HARNESS = r'''
+#include "roce_msg.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <thread>
+#include <unistd.h>
+#include <sys/socket.h>
+using namespace tfroce;
+
+static uint32_t ld(const uint8_t *p) { return __atomic_load_n(reinterpret_cast<const uint32_t *>(p), __ATOMIC_ACQUIRE); }
+static void st(uint8_t *p, uint32_t v) { __atomic_store_n(reinterpret_cast<uint32_t *>(p), v, __ATOMIC_RELEASE); }
+
+int main(int argc, char **argv) {
+    const std::string mode = argv[1];
+    const int world = 2;
+    const uint64_t ctrl_off = 4096, base = ctrl_off + 128;
+    const MsgLayout L = msg_layout(base, world);
+    // layout checks
+    if (L.send_off % 64 || L.recv_off % 64 || L.flag_off % 64 || L.ack_off % 64 || L.send_off < base ||
+        L.recv_off < L.send_off + MSG_SLOTS * MSG_SLOT_BYTES || L.flag_off < L.recv_off + world * MSG_SLOTS * MSG_SLOT_BYTES ||
+        L.ack_off < L.flag_off + world * MSG_SLOTS * MSG_STRIDE || L.end < L.ack_off + world * MSG_STRIDE) {
+        printf("LAYOUT BAD\n"); return 2;
+    }
+    std::vector<uint8_t> A(L.end, 0), B(L.end, 0);          // rank 0's and rank 1's regions
+    MsgHost s0(A.data(), ctrl_off, base, world, 0), r1(B.data(), ctrl_off, base, world, 1);
+    std::atomic<int> stop{0}, bad{0};
+    const int slow_proxy = mode == "slow" ? 1 : 0;
+    // the proxies: rank 0's posts chunks (data, then flag) into B; rank 1's posts its ack into A
+    std::thread proxy([&] {
+        uint32_t posted = 0, acked = 0;
+        std::mt19937 rng(7);
+        while (!stop.load()) {
+            const uint32_t ms = ld(A.data() + ctrl_off + 4 * CTRL_MSG_SEQ);
+            while (posted != ms) {
+                const uint32_t m = posted + 1;
+                const uint64_t slot = m % MSG_SLOTS;
+                // the slot on the receiver must be consumed: it last held m - MSG_SLOTS (credits)
+                if (m > uint32_t(MSG_SLOTS) && ld(B.data() + ctrl_off + 4 * CTRL_MSG_ACK) < m - MSG_SLOTS) bad++;
+                MsgHeader h; memcpy(&h, A.data() + L.send_off + slot * MSG_SLOT_BYTES, sizeof(h));
+                const uint64_t bytes = MSG_HDR + ((uint64_t(h.bytes) + 15) & ~uint64_t(15));
+                if (slow_proxy && rng() % 4 == 0) usleep(200);
+                memcpy(B.data() + L.recv_off + (0 * MSG_SLOTS + slot) * MSG_SLOT_BYTES, A.data() + L.send_off + slot * MSG_SLOT_BYTES, bytes);
+                std::atomic_thread_fence(std::memory_order_seq_cst);
+                st(B.data() + L.flag_off + (0 * MSG_SLOTS + slot) * MSG_STRIDE, m);
+                posted = m;
+            }
+            const uint32_t a = ld(B.data() + ctrl_off + 4 * CTRL_MSG_ACK);
+            if (a != acked) { st(A.data() + L.ack_off + 1 * MSG_STRIDE, a); acked = a; }
+        }
+    });
+    int rc = 0;
+    if (mode == "exact" || mode == "slow") {
+        const int N = 400;
+        std::vector<std::vector<uint8_t>> msgs(N);
+        std::mt19937 rng(11);
+        for (int i = 0; i < N; i++) {
+            const uint64_t n = (i % 7 == 0) ? 0 : (i % 5 == 0 ? (rng() % (300 * 1024)) : rng() % 4000);
+            msgs[i].resize(n);
+            for (auto &b : msgs[i]) b = uint8_t(rng());
+        }
+        std::thread sender([&] {
+            for (int i = 0; i < N; i++)
+                if (!s0.send(msgs[i].data(), msgs[i].size(), 30.0)) { printf("SEND TIMEOUT %d\n", i); bad++; return; }
+        });
+        int ok = 0;
+        for (int i = 0; i < N; i++) {
+            if (mode == "slow" && i % 9 == 0) usleep(300);
+            auto got = r1.recv(0, 1000, 20000, -1, 30.0);
+            ok += got == msgs[i];
+        }
+        sender.join();
+        printf("RECEIVED %d OF %d, VIOLATIONS %d, CHUNKS %u\n", ok, N, bad.load(), s0.sent());
+        rc = (ok == N && bad.load() == 0) ? 0 : 1;
+    } else if (mode == "credit") {
+        std::vector<uint8_t> big((MSG_SLOTS + 3) * (MSG_SLOT_BYTES - MSG_HDR), 1);
+        const bool sent = s0.send(big.data(), big.size(), 0.3);
+        printf("CREDIT TIMEOUT %s\n", sent ? "NO" : "YES");
+        rc = sent ? 1 : 0;
+    } else if (mode == "hangup") {
+        int sv[2];
+        socketpair(AF_UNIX, SOCK_STREAM, 0, sv);
+        std::thread closer([&] { usleep(50000); close(sv[0]); });
+        try {
+            r1.recv(0, 1000, 20000, sv[1], 10.0);
+            printf("NO THROW\n"); rc = 1;
+        } catch (const std::exception &e) {
+            printf("THROW %s\n", e.what());
+            rc = std::string(e.what()).find("closed the connection") != std::string::npos ? 0 : 1;
+        }
+        closer.join();
+    }
+    stop.store(1);
+    proxy.join();
+    return rc;
+}
+'''
+
+
+@pytest.fixture(scope="module")
+def exe(tmp_path_factory):
+    cxx = shutil.which("g++") or shutil.which("clang++")
+    if cxx is None:
+        pytest.skip("no C++ compiler")
+    d = tmp_path_factory.mktemp("msg")
+    (d / "h.cpp").write_text(HARNESS)
+    r = subprocess.run([cxx, "-std=c++17", "-O2", "-pthread", f"-I{HDR.parent}", str(d / "h.cpp"), "-o", str(d / "h")],
+                       capture_output=True, text=True, timeout=300)
+    assert r.returncode == 0, r.stderr[-3000:]
+    return str(d / "h")
+
+
+@pytest.mark.parametrize("mode", ["exact", "slow"])
+def test_messages_arrive_exact_with_credits(exe, mode):
+    r = subprocess.run([exe, mode], capture_output=True, text=True, timeout=120)
+    assert r.returncode == 0 and "RECEIVED 400 OF 400, VIOLATIONS 0" in r.stdout, r.stdout + r.stderr
+
+
+def test_credit_timeout(exe):
+    r = subprocess.run([exe, "credit"], capture_output=True, text=True, timeout=60)
+    assert r.returncode == 0 and "CREDIT TIMEOUT YES" in r.stdout, r.stdout + r.stderr
+
+
+def test_hangup_ends_recv(exe):
+    r = subprocess.run([exe, "hangup"], capture_output=True, text=True, timeout=60)
+    assert r.returncode == 0 and "closed the connection" in r.stdout, r.stdout + r.stderr
diff --git a/tests/test_roce_g14_split.py b/tests/test_roce_g14_split.py
new file mode 100644
index 0000000..0835188
--- /dev/null
+++ b/tests/test_roce_g14_split.py
@@ -0,0 +1,182 @@
+"""G14 on the CPU: ``roce_split`` recovers the transport / skew / staging split from two ranks' trace rows; G14's knobs
+parse; a ``rocedump`` host-ring line round-trips. No GPU, no RDMA.
+
+The rows come from a timing model of the protocol (the one ``roce_split``'s docstring states): per op each rank
+arrives after its segment's work, stages, rings; the peer's flag becomes visible ``T`` after the peer's doorbell; a
+wait that finds the flag already there costs one poll ``e``; then copy-out. Each rank stamps its own clock with an
+arbitrary offset (the analysis never compares the two clocks).
+"""
+
+from __future__ import annotations
+
+import json
+import random
+
+import pytest
+
+from tensorfold.families.glm5_next.spark import roce_split as S
+
+
+def _simulate(n=2000, T=4.0, stage=2.0, copy=1.5, e=0.6, work=300.0, jitter=0.0, bias1=0.0, seed=1, phase=0.0):
+    """-> (rows rank 0, rows rank 1) in ns, per-rank clocks offset by large arbitrary constants."""
+
+    rng = random.Random(seed)
+    off = (123_456_789_000, 987_654_321_000)
+    t = [0.0, phase]                   # each rank's arrival time (true time, us)
+    rows = ([], [])
+    for q in range(1, n + 1):
+        bell = [t[r] + stage for r in (0, 1)]
+        seen = [bell[1 - r] + T for r in (0, 1)]                     # the peer's flag visible here
+        flag = [max(bell[r] + e, seen[r]) for r in (0, 1)]
+        end = [flag[r] + copy for r in (0, 1)]
+        for r in (0, 1):
+            rows[r].append({"seq": q, "start": int(off[r] + t[r] * 1e3), "bell": int(off[r] + bell[r] * 1e3),
+                            "flag": int(off[r] + flag[r] * 1e3), "end": int(off[r] + end[r] * 1e3)})
+        for r in (0, 1):
+            w = work + (rng.uniform(-jitter, jitter) if jitter else 0.0) + (bias1 if r == 1 else 0.0)
+            t[r] = end[r] + w
+    return rows
+
+
+@pytest.mark.parametrize("phase", [0.0, 2.5, 6.0])
+def test_equal_work_is_all_wire(phase):
+    """Equal compute: whatever the ranks' phase (0: both wait T; d < T: they wait T + d and T - d; d >= T: they
+    alternate, one waiting ~2 T and the other one poll), the mean wait is T: wire, no skew."""
+
+    r0, r1 = _simulate(jitter=0.0, phase=phase)
+    s = S.split(S.pair(r0, r1))
+    po = s["per_op_us"]
+    assert s["n"] == 2000
+    assert abs(po["wire"] - 4.0) < 0.35, (phase, po, s)
+    assert po["skew"] < 0.5, po
+    assert abs(po["staging"] - 3.5) < 0.01
+    assert s["verdict"].startswith("WIRE"), s["verdict"]
+    # the late rank's own kernel time (what a p10 of kernel durations sees) never exceeds the critical path
+    assert po["late_rank_kernel_p50"] <= 2.0 + 4.0 + 1.5 + 0.05, po
+
+
+def test_small_jitter_keeps_t_exact():
+    r0, r1 = _simulate(jitter=3.0, seed=4)
+    s = S.split(S.pair(r0, r1))
+    assert s["t_exact"] and abs(s["per_op_us"]["wire"] - 4.0) < 0.3, s
+
+
+def test_large_jitter_is_skew():
+    r0, r1 = _simulate(jitter=40.0, seed=2)
+    s = S.split(S.pair(r0, r1))
+    po = s["per_op_us"]
+    assert po["skew"] > po["wire"], po
+    assert s["verdict"].startswith("SKEW"), s["verdict"]
+    assert "load balance" in s["verdict"]
+    assert 4.0 - 0.6 <= po["wire"] <= 8.0, po          # T exact or an upper bound, never below the truth by much
+
+
+def test_a_systematically_late_rank_is_named():
+    r0, r1 = _simulate(jitter=4.0, bias1=25.0, seed=3)       # rank 1's segments run 25 us longer
+    p = S.pair(r0, r1)
+    s = S.split(p)                                            # rank 0 always waits: T is not separable from s here
+    assert s["rank1_later_frac"] > 0.9 and s["one_sided"] and s["t_source"] == "upper bound", s
+    assert s["verdict"].startswith("ONE-SIDED SKEW: rank 1"), s["verdict"]
+    s = S.split(p, t_us=4.0)                                  # with the micro-benchmark's T
+    assert s["t_source"] == "given" and s["per_op_us"]["skew"] > 8, s
+    assert s["verdict"].startswith("SKEW") and "rank 1 rang later" in s["verdict"], s["verdict"]
+    assert s["rank_mean_wait_us"][0] > 25 > s["rank_mean_wait_us"][1], s
+
+
+def test_staging_bound():
+    r0, r1 = _simulate(T=1.5, stage=6.0, copy=4.0)
+    s = S.split(S.pair(r0, r1))
+    assert s["verdict"].startswith("STAGING"), s
+
+
+def test_window_ms_scales_with_ops():
+    r0, r1 = _simulate()
+    s = S.split(S.pair(r0, r1), ops=81)
+    assert abs(s["window_ms"]["wire"] - s["per_op_us"]["wire"] * 81 / 1e3) < 1e-3
+
+
+def test_torn_and_missing_rows_are_dropped():
+    r0, r1 = _simulate(n=50)
+    r0[3]["flag"] = 0
+    r1[7]["end"] = r1[7]["start"] - 5
+    del r1[10]
+    p = S.pair(r0, r1)
+    assert len(p) == 47 and {3 + 1, 7 + 1, 10 + 1}.isdisjoint(x["seq"] for x in p)
+
+
+def test_load_rows_formats(tmp_path):
+    r0, _ = _simulate(n=20)
+    a = tmp_path / "list.json"
+    a.write_text(json.dumps(r0, indent=1))
+    assert S.load_rows(str(a)) == r0
+    b = tmp_path / "obj.jsonl"                                # GLM's rocedump lines
+    b.write_text(json.dumps({"rows": r0[:10]}) + "\n" + json.dumps({"rows": r0[5:]}) + "\n")
+    assert S.load_rows(str(b)) == r0
+    import base64
+    import struct
+
+    vals = [v for r in r0 for v in (r["start"], r["bell"], r["flag"], r["end"])]
+    line = {"first": 1, "n": 20, "stamps": base64.b64encode(struct.pack(f"<{len(vals)}q", *vals)).decode()}
+    c = tmp_path / "g14.jsonl"                                # G14's dump thread lines
+    c.write_text(json.dumps(line) + "\n")
+    assert S.load_rows(str(c)) == r0
+
+
+def test_cli(tmp_path, capsys):
+    r0, r1 = _simulate(n=200)
+    (tmp_path / "a.json").write_text(json.dumps(r0))
+    (tmp_path / "b.json").write_text(json.dumps(r1))
+    assert S.main([str(tmp_path / "a.json"), str(tmp_path / "b.json"), "--json", str(tmp_path / "o.json")]) == 0
+    assert json.load(open(tmp_path / "o.json"))["n"] == 200
+
+
+# -- the knobs and the dump line (need torch for roce's import; CPU is enough) ---------------------------------------
+def test_settings_knobs(monkeypatch):
+    pytest.importorskip("torch")
+    from tensorfold.families.glm5_next.spark import roce
+
+    for k in ("GLM53_TF_ROCE_FAST", "GLM53_TF_ROCE_POLLERS", "GLM53_TF_ROCE_STAGGER_NS", "GLM53_TF_ROCE_TRACE",
+              "GLM53_TF_ROCE_TRACE_DUMP", "GLM53_TF_ROCE_TRACE_DUMP_S"):
+        monkeypatch.delenv(k, raising=False)
+    s = roce.settings()
+    assert (s.fast, s.pollers, s.stagger_ns, s.trace_host) == (False, 1, 150, False)
+    monkeypatch.setenv("GLM53_TF_ROCE_FAST", "1")
+    monkeypatch.setenv("GLM53_TF_ROCE_POLLERS", "4")
+    monkeypatch.setenv("GLM53_TF_ROCE_STAGGER_NS", "200")
+    s = roce.settings()
+    assert (s.fast, s.pollers, s.stagger_ns) == (True, 4, 200)
+    assert s.agreed() == roce.Settings(max_bytes=s.max_bytes, timeout_s=s.timeout_s).agreed()   # local knobs only
+    monkeypatch.setenv("GLM53_TF_ROCE_POLLERS", "9")
+    with pytest.raises(ValueError, match="POLLERS"):
+        roce.settings()
+    monkeypatch.setenv("GLM53_TF_ROCE_POLLERS", "1")
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE", "1024")
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE_DUMP_S", "0.5")
+    assert roce.settings().trace_host is False                # no dump prefix: no host ring
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE_DUMP", "/tmp/x")
+    assert roce.settings().trace_host is True
+    monkeypatch.setenv("GLM53_TF_ROCE_TRACE", "0")
+    assert roce.settings().trace_host is False
+
+
+def test_dump_line_round_trip():
+    np = pytest.importorskip("numpy")
+    pytest.importorskip("torch")
+    from types import SimpleNamespace
+
+    from tensorfold.families.glm5_next.spark import roce, rocedump
+
+    ring = 64
+    host = np.zeros(4 * ring, dtype=np.int64)
+    ctrl = np.zeros(roce.CTRL_WORDS, dtype=np.uint32)
+    rt = SimpleNamespace(trace_host=host, s=SimpleNamespace(trace=ring), ctrl=ctrl, rank=1)
+    r0, _ = _simulate(n=100)
+    for r in r0:
+        host.reshape(ring, 4)[r["seq"] & (ring - 1)] = [r["start"], r["bell"], r["flag"], r["end"]]
+    ctrl[roce.CTRL_COMPLETED] = 100
+    line = rocedump.snapshot(rt, 0)
+    assert line["first"] == 100 - 1 - ring // 2 + 1 and line["first"] + line["n"] - 1 == 99   # half a ring, < done
+    rows = rocedump.rows_of(json.loads(json.dumps(line)))
+    assert rows == [r for r in r0 if line["first"] <= r["seq"] <= 99]
+    assert rocedump.snapshot(rt, 99) is None
+    assert S._rows_of_stamps(line) == rows
diff --git a/tests/test_tensorfold_vllm_metrics.py b/tests/test_tensorfold_vllm_metrics.py
new file mode 100644
index 0000000..5834fb0
--- /dev/null
+++ b/tests/test_tensorfold_vllm_metrics.py
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: MIT
+"""The vLLM-named series on ``/metrics`` and ``GET /v1/model_info`` (``glm5_next/spark/health.py``): dashboards and
+routers written for vLLM (DGX-dash's ``LlmProbe``, and the routers sized from it) read a TensorFold engine's real
+request slots, queue and token counters instead of assuming one sequence."""
+
+from __future__ import annotations
+
+import re
+import types
+
+from tensorfold.families.glm5_next.spark import health as H
+
+
+def app_with(slots: list, n: int = 4, limit: int = 300000):
+    batch = types.SimpleNamespace(seqs=slots, n=n)
+    engine = types.SimpleNamespace(batch=batch, limit=limit)
+    return types.SimpleNamespace(engine=engine, served="DeepSeek-V4.1-Flash-TF")
+
+
+def metric(text: str, name: str, extra: str = "") -> float:
+    m = re.search(r"^" + re.escape(name) + r"\{[^}]*" + re.escape(extra) + r"[^}]*\}\s+(\S+)$", text, re.M)
+    assert m, (name, extra)
+    return float(m.group(1))
+
+
+def test_vllm_series_and_model_info():
+    clock = [0.0]
+    h = H.Health(mode="basic", clock=lambda: clock[0])
+    done = h.begin(100)
+    h.progress(done, 7)
+    h.end(done, stats={"cached": 40}, completion_tokens=7)
+    bad = h.begin(5)
+    h.end(bad, error=ValueError("bad request"))
+    a, b, c = h.begin(1000), h.begin(2000), h.begin(30)              # three running, one waits for a slot
+    h.progress(a, 3)
+    decoding, prefilling = types.SimpleNamespace(stepper=object()), types.SimpleNamespace(stepper=None)
+    app = app_with([decoding, prefilling, None, None])
+    text = h.metrics(app.served, app)
+    assert metric(text, "vllm:num_requests_running") == 2
+    assert metric(text, "vllm:num_requests_waiting") == 1
+    assert metric(text, "vllm:prompt_tokens_total") == 105             # ended requests' prompts
+    assert metric(text, "vllm:generation_tokens_total") == 10          # 7 + the running reply's 3
