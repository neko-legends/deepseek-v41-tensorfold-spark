@@ -0,0 +1,252 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""dense3 (``dense3.py`` / ``dense3.cu``, TF_DSV41_DENSE_V3) without a GPU, through ``dsv41_dense3_emu``:
+
+- the layout: ``to_strips(to_lanes(w)) == w`` for every width; the CUDA relayout kernels' statements (transcribed)
+  give the reference's words in both directions; column blocks of a lanes matrix are the lanes of the column blocks
+  (fast prefill slices strips);
+- the decode: the kernel's per-lane work (``take_bits``, the tails shuffle, the windows) gives
+  ``exl3.format.states`` for every value of random, constant and real trellises (the real pack's layer 1 when
+  ``TF_DSV41_PACK_CACHE`` is set), so the decoded fp16 values are upstream's; ``lanes_unpack_kernel`` == upstream's
+  W_q;
+- the loads: every warp-wide 16-byte load of every program of every real shape (upstream and long plans) is 512
+  contiguous, 16-byte-aligned bytes, and a launch reads each word of its matrices exactly once;
+- the k loop: each step's mmas use its own group's words and its own input fragment, in ascending k (x3seg's order);
+- the bits: x3seg's program emulator over lanes-decoded W == over upstream's W, and a row alone == in a window;
+- the wiring: env / MINB parsing, eligibility of every real plan, x3dn exclusion, a fused group never mixes layouts
+  and picks dense3, ``fused_proj.why_not`` delegates, ``mark`` leaves an ineligible attention on x3seg.
+
+Run: python -m pytest -q tests/test_dsv41_dense3_emu.py
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_dense3_emu as E
+import dsv41_x3seg_emu as X
+
+from tensorfold.cuda.exl3 import format as fmt
+from tensorfold.cuda.exl3.linear import plan
+from tensorfold.families.deepseek_v41.cuda import dense3 as D3
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+K2S = (4, 6, 8, 10, 12, 16)
+SHAPES = ((5120, 1280), (5120, 512), (1280, 16384), (1280, 4096), (4096, 1024), (4096, 5120))
+
+
+def _trellis(rng, k: int, n: int, k2: int) -> np.ndarray:
+    return rng.integers(-32768, 32768, (k // 16, n // 16, 8 * k2), dtype=np.int64).astype(np.int16)
+
+
+@pytest.mark.parametrize("k2", K2S)
+def test_layout_round_trip_and_the_relayout_kernels(k2):
+    rng = np.random.default_rng(k2)
+    k, n = 512, 384
+    S = E.strips_of(_trellis(rng, k, n, k2))
+    L = E.to_lanes(S, k2)
+    assert L.shape == S.shape and not np.array_equal(L, S)
+    assert np.array_equal(E.to_strips(L, k2), S)
+    assert np.array_equal(np.sort(E.bits_of(L).reshape(-1)), np.sort(E.bits_of(S).reshape(-1)))  # a permutation
+    fs, fl = S.reshape(-1), L.reshape(-1)
+    for i in [0, 1, 127, 128, fl.size - 1, *rng.integers(0, fl.size, 300)]:
+        assert E.to_lanes_word(fs, int(i), k2, k // 16) == fl[i]
+        assert E.to_strips_word(fl, int(i), k2, k // 16) == fs[i]
+
+
+@pytest.mark.parametrize("k2", K2S)
+def test_states_equal_upstream_random_and_constant(k2):
+    rng = np.random.default_rng(100 + k2)
+    for tr in (_trellis(rng, 256, 256, k2), np.full((16, 16, 8 * k2), -1, np.int16),
+               np.zeros((16, 16, 8 * k2), np.int16), np.full((16, 16, 8 * k2), 0x5A5A, np.int16)):
+        L = E.to_lanes(E.strips_of(tr), k2)
+        assert np.array_equal(E.states(L, k2), fmt.states(tr, k2 / 2))
+
+
+@pytest.mark.parametrize("k2", K2S)
+def test_unpack_equals_upstream(k2):
+    tr = _trellis(np.random.default_rng(200 + k2), 256, 512, k2)
+    got = E.unpack(E.to_lanes(E.strips_of(tr), k2), k2)
+    assert np.array_equal(got.view(np.uint16), fmt.unpack(tr, k2 / 2, "mul1").view(np.uint16))
+
+
+def _segs():
+    """(K, N, K2, SK, WK) of every real shape at upstream's and the long plan, 5 and 6 bits."""
+
+    out = []
+    for k, n in SHAPES:
+        for k2 in (10, 12):
+            out.append((k, n, k2, *plan(k, n)))
+    for g, (sk, wk) in FP.PLANS["long"].items():
+        for k, n in {"x": SHAPES[:2], "q": SHAPES[2:4], "o": SHAPES[4:5], "wob": SHAPES[5:]}[g]:
+            out.append((k, n, 10, sk, wk))
+    return out
+
+
+@pytest.mark.parametrize("seg", _segs(), ids=lambda s: "x".join(map(str, s)))
+def test_loads_coalesced_and_read_once(seg):
+    k, n, k2, sk, wk = seg
+    words = k * n * k2 // 64
+    seen = np.zeros(words, dtype=np.int32)
+    for nb in range(n // 128):
+        for split in range(sk):
+            for warp in range(wk):
+                for start, c in E.warp_loads(k, n, k2, sk, wk, nb, split, warp):
+                    assert start % 4 == 0 and start + 128 <= words      # 16-byte aligned, 512 contiguous bytes
+                    seen[start:start + 128] += 1
+    assert (seen == 1).all()
+
+
+@pytest.mark.parametrize("G", [1, 2])
+def test_the_k_loop_uses_its_own_group_and_input(G):
+    for steps in range(G, 41, G):
+        assert E.walk(steps, G) == [(i, i // G, i % G, i) for i in range(steps)]
+
+
+def test_every_real_plan_is_eligible_and_odd_walks_are_not():
+    assert D3.K2S == (4, 6, 8, 10, 12)                    # the widths built (8 bits: no attention matrix)
+    for k, n, k2, sk, wk in _segs():
+        lin = SimpleNamespace(words=0, layout="strips", bias=None, codebook="mul1", k2=k2, k=k, n=n, split=(sk, wk))
+        assert D3.why_not(lin) is None, (k, n, k2, sk, wk)
+        lin.layout = "lanes"
+        assert FP.why_not(lin) is None                    # fused_proj delegates for lanes matrices
+    odd = SimpleNamespace(words=0, layout="lanes", bias=None, codebook="mul1", k2=10, k=1280, n=4096, split=(5, 4))
+    assert D3.why_not(odd) is None                        # 80 k tiles / 20 warps = 4 steps a warp
+    odd.k, odd.split = 1152, (1, 8)                       # 72 / 8 = 9 steps a warp: not whole 2-step groups
+    assert "groups" in D3.why_not(odd) and "groups" in FP.why_not(odd)
+    odd.k2 = 16
+    assert D3.why_not(odd) == "codebook / width"
+
+
+def test_bits_equal_x3seg_through_its_program_emulator():
+    """A segment launch with lanes-decoded W == with upstream's W, bit for bit; a row alone == in the window."""
+
+    rng = np.random.default_rng(7)
+    segs, suh, W, svh = [], [], [], []
+    for i, (k, n, k2) in enumerate(((512, 256, 10), (512, 384, 10))):
+        sk, wk = plan(k, n)
+        segs.append(FP.Seg(k, n, k2, sk, wk, i, 0))
+        tr = _trellis(rng, k, n, k2)
+        w_up = fmt.unpack(tr, k2 / 2, "mul1")
+        w_d3 = E.unpack(E.to_lanes(E.strips_of(tr), k2), k2)
+        assert np.array_equal(w_up.view(np.uint16), w_d3.view(np.uint16))
+        W.append(w_d3.astype(np.float64))
+        suh.append(np.where(rng.random(k) < 0.5, -1.0, 1.0).astype(np.float16))
+        svh.append((rng.random(n) * 0.02 + 0.01).astype(np.float32))
+    x = rng.standard_normal((5, 512)).astype(np.float32)
+    lay = FP.layout(segs, 5)
+    whole, mem = X.segmented([x, x], suh, W, svh, segs, lay, [256, 384], seed=1)
+    assert all((w == 1).all() for w in mem.writes) and not mem.counters.any()
+    one, _ = X.segmented([x[2:3], x[2:3]], suh, W, svh, segs, FP.layout(segs, 1), [256, 384], seed=2)
+    assert all(np.array_equal(a.view(np.uint32), b[2:3].view(np.uint32)) for a, b in zip(one, whole))
+
+
+# -- the wiring (CPU objects) --------------------------------------------------------------------------------------
+def _cpu_lin(k: int, n: int, k2: int, seed: int):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = torch.Generator().manual_seed(seed)
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 8 * k2), generator=g, dtype=torch.int32).to(torch.int16)
+    suh = torch.ones(k, dtype=torch.float16)
+    svh = torch.full((n,), 0.01, dtype=torch.float16)
+    return Exl3Linear.from_tensors(tr, suh, svh, "mul1", device="cpu"), tr.numpy()
+
+
+def _as_lanes(lin, k2: int) -> None:
+    """``to_lanes`` with the numpy reference instead of the CUDA kernel (CPU objects)."""
+
+    w = E.to_lanes(lin.words.numpy().view(np.uint32), k2)
+    lin.words.copy_(torch.from_numpy(w.view(np.int32)))
+    lin.layout = "lanes"
+    lin.__class__ = D3.Lanes
+
+
+def test_env_knobs():
+    assert not D3.enabled({}) and D3.enabled({D3.ENV: "1"})
+    with pytest.raises(ValueError):
+        D3.enabled({D3.ENV: "on"})
+    assert (D3.minb(4, {}), D3.minb(8, {})) == (3, 1)
+    assert (D3.minb(4, {D3.ENV + "_MINB": "4,2"}), D3.minb(8, {D3.ENV + "_MINB": "4,2"})) == (4, 2)
+    for bad in ("2,1", "3,3", "3"):
+        with pytest.raises(ValueError):
+            D3.minb(4, {D3.ENV + "_MINB": bad})
+
+
+def test_fused_groups_never_mix_layouts_and_pick_dense3():
+    a, _ = _cpu_lin(512, 256, 10, 1)
+    b, _ = _cpu_lin(512, 128, 10, 2)
+    assert FP.Fused([a, b]).lanes is False
+    _as_lanes(a, 10)
+    with pytest.raises(ValueError, match="strips and lanes"):
+        FP.Fused([a, b])
+    _as_lanes(b, 10)
+    f = FP.Fused([a, b])
+    assert f.lanes is True and isinstance(a, D3.Lanes) and a.strides == (320, 32 * 320)
+    c, _ = _cpu_lin(512, 128, 10, 3)
+    g = FP.Fused([c])
+    _as_lanes(c, 10)                                      # the layout changed after the group was built
+    with pytest.raises(RuntimeError, match="changed layout"):
+        g._block([torch.zeros((1, 512))], [torch.zeros((1, 128))])
+
+
+def test_prefill_column_blocks_of_a_lanes_matrix():
+    from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+
+    lin, tr = _cpu_lin(256, 1024, 10, 4)
+    strips = E.strips_of(tr)
+    _as_lanes(lin, 10)
+    parts = PM.column_blocks(lin, 256 * 2 * 384)          # 3 strips a block
+    assert [c0 for c0, _ in parts] == [0, 384, 768] and all(D3.is_lanes(s) for _, s in parts)
+    for c0, sub in parts:
+        b0 = c0 // 128
+        want = E.to_lanes(strips[b0:b0 + sub.n // 128], 10)
+        assert np.array_equal(sub.words.numpy().view(np.uint32), want)
+
+
+def test_mark_rules():
+    from tensorfold.families.deepseek_v41.cuda import linear as LN
+
+    lin, _ = _cpu_lin(1152, 256, 10, 5)
+    lin.split = (1, 8)                                    # 72 k tiles / 8 warps = 9 steps a warp: not whole groups
+    attn = SimpleNamespace(wq_a=LN.Exl3(lin), wkv=None, comp_wkv=None, comp_wgate=None, wq_b=None, ix_wq_b=None,
+                           wo_b=None, wo_a=[])
+    assert D3.mark(attn, {}) == 0                         # off
+    assert D3.mark(attn, {D3.ENV: "1"}) == 0 and lin.layout == "strips"       # ineligible: stays on x3seg
+    with pytest.raises(ValueError, match="cannot both"):
+        D3.mark(attn, {D3.ENV: "1", "TF_DSV41_DENSE": "attn"})
+
+
+# -- the real pack's layer 1 ----------------------------------------------------------------------------------------
+def _pack() -> Path | None:
+    p = os.environ.get("TF_DSV41_PACK_CACHE", "").strip()
+    return Path(p) if p and (Path(p) / "headers.json").is_file() else None
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached layer-1 tensors")
+@pytest.mark.parametrize("name", ["wq_a", "wkv", "wo_a.slice.0"])
+def test_real_layer1_states_equal_upstream(name):
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: (e["dtype"], tuple(e["shape"])) for v in m["headers"].values() for n, e in v["header"].items()
+            if n != "__metadata__"}
+    key = f"layers.1.attn.{name}.trellis"
+    h = hashlib.sha1(f"{wm[key]}:{key}".encode()).hexdigest()[:16]
+    tr = np.frombuffer((root / "tensors" / f"{h}.bin").read_bytes(), dtype=np.int16).reshape(info[key][1])
+    bits = fmt.bits_of(tr.shape)
+    k2 = int(2 * bits)
+    S = E.strips_of(tr)
+    L = E.to_lanes(S, k2)
+    assert np.array_equal(E.to_strips(L, k2), S)
+    assert np.array_equal(E.states(L, k2), fmt.states(tr, bits))
+    print(f"[G13] dense3 real layer-1 {name} ({16 * tr.shape[0]} x {16 * tr.shape[1]}, {bits} bits): lanes states "
+          f"== upstream's for all {tr.shape[0] * tr.shape[1] * 256} values")
