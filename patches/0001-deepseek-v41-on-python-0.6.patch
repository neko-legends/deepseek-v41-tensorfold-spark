+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The CSA2 calls the forward makes, over the Triton kernels (``Triton``) or their torch twin (``twin.Twin``).
+
+A window is ``Win``: ``n`` rows at consecutive positions ``p0 .. p0 + n - 1`` of one slot (M1: a prefill chunk or a
+decode step). Each call is one kernel launch sequence of ``rows`` / ``compress`` / ``index`` / ``attn``; the
+adapter only shapes arguments (device positions, counts, scratch), it adds no arithmetic. Kernel shapes: rows of
+512 (448 NoPE + 64 RoPE), index keys 32 heads x 128, SWA window 128, query heads a multiple of 16.
+
+Selection counts: a row's selection is ascending with the positions it may attend first (top-k keys order invisible
+positions after visible ones), so ``counts[r]`` = its entries below its visible bound (``visible_counts``).
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+import torch
+
+F32, BF16 = torch.float32, torch.bfloat16
+
+
+@dataclass
+class Win:
+    """A window's positions on the host and the device."""
+
+    p0: int
+    n: int
+    t: torch.Tensor                   # int32 [1] on the device: p0 (the kernels' POS)
+    positions: torch.Tensor           # int64 [n] on the device
+
+    @classmethod
+    def make(cls, p0: int, n: int, device) -> "Win":
+        """Positions made on the device (no host-to-device copy, so no stream sync on CUDA)."""
+
+        positions = torch.arange(p0, p0 + n, dtype=torch.long, device=device)
+        return cls(p0, n, positions[:1].to(torch.int32), positions)
+
+    def sub(self, a: int, b: int) -> "Win":
+        """Rows [a, b) of this window as a window of their own (device ops only)."""
+
+        positions = self.positions[a:b]
+        return Win(self.p0 + a, b - a, positions[:1].to(torch.int32), positions)
+
+    @property
+    def last(self) -> int:
+        return self.p0 + self.n - 1
+
+    rows = False                      # a ``RowWin`` (row mode) or not
+
+
+@dataclass
+class RowWin:
+    """Rows of several slots in one launch (row mode: the slot-agnostic CUDA graphs, ``rowtab.py``): each row's
+    position and slot on the device, every tensor a view of the persistent row table. ``wslot`` is the slot a row
+    writes (-1: a padding row, which writes nothing), ``rslot`` the slot it reads (a padding row mirrors a real
+    row); ``prev`` (ratio-2 pooling) each row's previous row in [the slots' carries | the rows]; ``cap`` the last
+    position any row scores (the graph's context bucket: the indexer's key range, a host value)."""
+
+    n: int
+    positions: torch.Tensor           # int64 [n] (the kernels' POS in row mode)
+    rslot: torch.Tensor               # int64 [n]
+    wslot: torch.Tensor               # int64 [n]
+    prev: torch.Tensor | None
+    cap: int
+    p0 = 0
+    rows = True
+
+    @property
+    def t(self) -> torch.Tensor:
+        return self.positions
+
+    @property
+    def last(self) -> int:
+        return self.cap
+
+    def sub(self, a: int, b: int) -> "RowWin":
+        return RowWin(b - a, self.positions[a:b], self.rslot[a:b], self.wslot[a:b],
+                      None if self.prev is None else self.prev[a:b], self.cap)
+
+
+def _rk(win, write: bool = False) -> dict:
+    """The row-mode argument of a kernel call: the slot each row writes or reads ({} for a one-slot ``Win``)."""
+
+    if not getattr(win, "rows", False):
+        return {}
+    return {"slots": win.wslot if write else win.rslot}
+
+
+def visible_counts(sel: torch.Tensor, win: Win, ratio: int) -> torch.Tensor:
+    """int32 [R]: how many leading entries of each row's ascending selection it may attend (a ``dtopk`` selection
+    carries the counts its launch computed: ``_counted``)."""
+
+    c = getattr(sel, "_dsv41_counts", None)
+    if c is not None and c[0] == ratio and c[1].shape[0] == win.n:
+        return c[1]
+    nvis = (win.positions + 1) // ratio
+    return ((sel >= 0) & (sel.to(torch.long) < nvis[:, None])).sum(1).to(torch.int32)
+
+
+def _w32(w: torch.Tensor) -> torch.Tensor:
+    """The indexer's head weights for the scoring kernels: fp32, or bf16 rows as they are (``branches``: every kernel
+    widens W as it loads it, so bf16 w gives the bits of ``w.to(fp32)`` without that launch)."""
+
+    if w.dtype == BF16 and w.stride(-1) == 1:
+        return w
+    return w.to(F32).contiguous()
+
+
+def AC_call(be, fn: str, *args, **kw):
+    """``attn_cuda.<fn>`` when TF_DSV41_ATTN_CUDA is on (None: it does not take the call, dtopk runs)."""
+
+    if not be.acuda:
+        return None
+    from . import attn_cuda as AC
+
+    return getattr(AC, fn)(*args, **kw)
+
+
+def _counted(sel: torch.Tensor, counts: torch.Tensor, ratio: int) -> torch.Tensor:
+    """``sel`` carrying its rows' visible counts at ``ratio`` (``dtopk``: ``visible_counts``' values, same launch)."""
+
+    sel._dsv41_counts = (ratio, counts)
+    return sel
+
+
+# M1 measurement knob (gate harness only, contiguous keys): TF_DSV41_INDEX_KEY_SIM=fp8 rounds the stored bf16 index
+# keys through the kit's FP8 key format (e4m3, one power-of-two scale a key) so the selection sees FP8 keys' values
+SIM_FP8_KEYS = os.environ.get("TF_DSV41_INDEX_KEY_SIM", "").strip().lower() == "fp8"
+
+
+def fp8_roundtrip_(k: torch.Tensor) -> None:
+    """In place: each row through the kit's per-token FP8 key (``fmt.key_quant``: e4m3, a power-of-two scale, amax
+    floored at 1e-4) and back (idempotent; bit for bit what TF_DSV41_INDEX_KV=fp8 stores and reads)."""
+
+    if k.numel() == 0:
+        return
+    from . import fmt
+
+    k.copy_(fmt.key_dequant(fmt.key_quant(k.reshape(-1, k.shape[-1]))).reshape(k.shape).to(k.dtype))
+
+
+def index_budget() -> int:
+    """Bytes of materialised indexer scores + sort keys a launch (``TF_DSV41_INDEX_BUDGET_MIB``, 256): prefill
+    segments score in row blocks under it (a 2,048-row segment at 150K keys would need 3.7 GB at once)."""
+
+    mib = int(os.environ.get("TF_DSV41_INDEX_BUDGET_MIB", "") or 256)
+    if mib < 1:
+        raise ValueError(f"TF_DSV41_INDEX_BUDGET_MIB={mib}: expected >= 1")
+    return mib << 20
+
+
+STREAM_MIN = 16384     # G4 default: long rows select through stream_topk (TF_DSV41_INDEX_STREAM_MIN=0: never)
+
+
+def stream_min() -> int:
+    """``TF_DSV41_INDEX_STREAM_MIN``: Full-mode selections of windows over 16 rows with at least this many visible
+    keys run ``stream_topk`` (no materialised scores); default 16,384 since G4 (0 = never)."""
+
+    v = int(os.environ.get("TF_DSV41_INDEX_STREAM_MIN", "") or STREAM_MIN)
+    if v < 0:
+        raise ValueError(f"TF_DSV41_INDEX_STREAM_MIN={v}: expected >= 0")
+    return v
+
+
+def index_kv() -> str:
+    """TF_DSV41_INDEX_KV: bf16 (default) or fp8 index keys, in the pool and the contiguous stores alike."""
+
+    v = os.environ.get("TF_DSV41_INDEX_KV", "bf16").strip().lower() or "bf16"
+    if v not in ("bf16", "fp8"):
+        raise ValueError(f"TF_DSV41_INDEX_KV={v!r}: expected bf16 or fp8")
+    return v
+
+
+def _pf_bmq(heads: int | None = None) -> int:
+    """attn_pf's heads a program for ``heads`` (clamped to 16 at TP=4): a head count it does not divide (synthetic
+    checkpoints) keeps the chunk kernels."""
+
+    from . import attn_pf
+
+    return attn_pf.config(heads)[0]
+
+
+def fused_prefill() -> bool:
+    """A fast prefill run (``prefill_mm.active``) with ``TF_DSV41_PREFILL_ATTN=fused``: ``attn_pf`` for every row of
+    the run whatever its size (the rule that keeps a row's bits independent of its segment, within the fast tag)."""
+
+    from .. import prefill_mm as PM
+
+    return PM.active() and PM.attn_variant() == 1
+
+
+class Triton:
+    """The ported sm_121 kernels (``rows``, ``compress``, ``index``, ``attn``) over ``stores.Records`` (the FP8
+    records, contiguous or the pool's pages) and ``stores.Keys`` (bf16 index keys [n, 128])."""
+
+    name = "triton"
+
+    def __init__(self, rows_max: int, heads: int, device) -> None:
+        from . import attn
+
+        self.scratch = attn.Scratch(rows_max, device, heads)
+        self.rows_max = rows_max
+        self.index_budget = index_budget()
+        self.stream_min = stream_min()
+        from . import dtopk
+
+        self.dtopk = dtopk.enabled()
+        from . import attn_cuda as AC                   # REWRITE-PLAN 5 (TF_DSV41_ATTN_CUDA, default 0): attn_cuda.py
+
+        self.acuda = AC.enabled()
+        self.ticket = AC.Ticket(rows_max, heads, device) if self.acuda else None
+
+    def _dt(self, win) -> bool:
+        """``dtopk`` for this window's materialised selections (decode windows: TF_DSV41_INDEX_DTOPK)."""
+
+        from . import dtopk
+
+        return self.dtopk and win.n <= dtopk.MAX_ROWS
+
+    def _row_blocks(self, win: Win, per_row: int):
+        """Row blocks of a window for the materialised indexer: each block's scores + sort keys (``per_row`` bytes a
+        row) within ``TF_DSV41_INDEX_BUDGET_MIB``. Rows are independent, so the bits do not depend on the blocks."""
+
+        step = max(16, self.index_budget // max(1, per_row)) if win.n > 16 else win.n
+        return [(a, min(win.n, a + step)) for a in range(0, win.n, step)]
+
+    def rows(self, n: int, dim: int, device):
+        from . import rows as RW
+        from .stores import Records
+
+        if dim != RW.D:
+            raise ValueError(f"the CSA2 kernels store {RW.D}-wide rows, not {dim}")
+        return Records.new(n, device)
+
+    def keys(self, n: int, dim: int, device):
+        from .stores import Keys
+
+        if dim != 128:
+            raise ValueError(f"the indexer kernels read 128-wide keys, not {dim}")
+        if index_kv() == "fp8":
+            return Keys(torch.zeros((n, dim + 4), dtype=torch.uint8, device=device))
+        return Keys(torch.zeros((n, dim), dtype=BF16, device=device))
+
+    def read_rows(self, store, rows: torch.Tensor) -> torch.Tensor:
+        return store.read(rows)
+
+    def kv_store(self, lat, table, store, win: Win, ratio: int, ring: int = 0) -> None:
+        from . import compress
+
+        v, s = store.kernel()
+        compress.kv_store(lat.contiguous(), table.cs, v, s, win.t, win.n, ratio, ring, **store.paging(),
+                          **_rk(win, write=True))
+
+    def pool_norm(self, buf, weight, win: Win, ratio: int, eps: float) -> torch.Tensor:
+        from . import compress
+
+        out = torch.zeros((win.n, buf.shape[1] // ratio), dtype=BF16, device=buf.device)
+        if eps != compress.EPS:
+            raise ValueError(f"the compressor kernel's eps is {compress.EPS}, the config's {eps}")
+        if win.rows:            # buf = [the slots' carries | the rows] (ratio 2), ``win.prev`` the pairs
+            compress.pool_norm(buf, weight, win.t, win.n, ratio, out, slots=win.wslot, prev=win.prev)
+        else:
+            compress.pool_norm(buf, weight, win.t, win.n, ratio, out)
+        return out
+
+    def pool_norm_split(self, carry, rows, weight, win: Win, ratio: int, eps: float) -> torch.Tensor:
+        """``pool_norm`` of [carry | rows] without the concatenation (``branches``): ``rows`` fp32 / bf16 [n, D r]
+        (the window's projection rows), ``carry`` the slot's (or row mode's stacked) fp32 carries, None at ratio 1."""
+
+        from . import compress
+
+        out = torch.zeros((win.n, rows.shape[1] // ratio), dtype=BF16, device=rows.device)
+        if eps != compress.EPS:
+            raise ValueError(f"the compressor kernel's eps is {compress.EPS}, the config's {eps}")
+        rk = {"slots": win.wslot, "prev": win.prev} if win.rows else {}
+        compress.pool_norm(rows, weight, win.t, win.n, ratio, out, carry=carry if ratio == 2 else None, **rk)
+        return out
+
+    def index_k(self, k_pre, weight, table, keys, win: Win, ratio: int, eps: float) -> None:
+        from . import compress
+
+        compress.index_k(k_pre.contiguous(), weight, table.cs, keys.kernel(), win.t, win.n, ratio, **keys.paging(),
+                         **_rk(win, write=True))
+        if SIM_FP8_KEYS and getattr(keys, "table", None) is None:
+            fp8_roundtrip_(keys.kernel()[:(win.last + 1) // ratio])
+
+    def select(self, qi, w, keys, win: Win, ratio: int, topk: int, want_scores: bool = False):
+        from . import index
+
+        nvis_max = (win.last + 1) // ratio
+        qi, w = qi.contiguous(), _w32(w)
+        if not want_scores and self.stream_min > 0 and win.n > 16 and nvis_max >= self.stream_min and \
+                not topk & (topk - 1) and not win.rows:     # row mode: a slot's rows are a verify window (<= 16)
+            return self._stream_select(qi, w, keys, win, ratio, topk), None
+        if not want_scores and win.n * max(nvis_max, 1) * 12 > self.index_budget:
+            return self._blocked(qi, w, keys, win, ratio, topk, None), None
+        s = index.scores(qi, w, keys.kernel(), win.t, win.n, max(nvis_max, 1), ratio, **keys.paging(), **_rk(win))
+        if self._dt(win):
+            from . import dtopk
+
+            got = AC_call(self, "select", s, win.t, ratio, topk)
+            sel, cnt = got if got is not None else dtopk.select(s, win.t, ratio, topk, rows=win.rows)
+            return _counted(sel, cnt, ratio), (s if want_scores else None)
+        return index.top_positions(index.sort_keys(s), topk), (s if want_scores else None)
+
+    def select_cand(self, qi, w, keys, win: Win, ratio: int, topk: int, block: int, topk_blocks: int):
+        """(selection, candidate blocks) of the candidate source (layer 20), in row blocks under the index budget."""
+
+        qi, w = qi.contiguous(), _w32(w)
+        if win.n * max((win.last + 1) // ratio, 1) * 12 <= self.index_budget:
+            if self.acuda and self._dt(win):            # select + candidate blocks: one CUDA launch
+                from . import index
+
+                s = index.scores(qi, w, keys.kernel(), win.t, win.n, max((win.last + 1) // ratio, 1), ratio,
+                                 **keys.paging(), **_rk(win))
+                got = AC_call(self, "select_blocks", s, win.t, ratio, topk, topk_blocks, block=block)
+                if got is not None:
+                    return _counted(got[0], got[1], ratio), got[2]
+            sel, s = self.select(qi, w, keys, win, ratio, topk, want_scores=True)
+            return sel, self.candidates(s, win, ratio, block, topk_blocks)
+        cand = torch.empty((win.n, topk_blocks), dtype=torch.int32, device=qi.device)
+        return self._blocked(qi, w, keys, win, ratio, topk, (cand, block, topk_blocks)), cand
+
+    def _blocked(self, qi, w, keys, win: Win, ratio: int, topk: int, cand):
+        from . import index
+
+        nvis_max = max((win.last + 1) // ratio, 1)
+        out = torch.empty((win.n, topk), dtype=torch.int32, device=qi.device)
+        for a, b in self._row_blocks(win, nvis_max * 12):
+            sw = win.sub(a, b)
+            nv = max((sw.last + 1) // ratio, 1)
+            s = index.scores(qi[a:b], w[a:b], keys.kernel(), sw.t, sw.n, nv, ratio, **keys.paging(), **_rk(sw))
+            out[a:b] = index.top_positions(index.sort_keys(s), topk)
+            if cand is not None:
+                c, block, topk_blocks = cand
+                c[a:b] = index.candidate_blocks(s, sw.t, sw.n, ratio, block=block, topk_blocks=topk_blocks,
+                                                rows=sw.rows)
+        return out
+
+    def _stream_select(self, qi, w, keys, win: Win, ratio: int, topk: int):
+        """``stream_topk.select`` (no materialised scores; ``TF_DSV41_INDEX_STREAM_MIN``): the same positions as
+        ``index.select`` for every visible key, -1 where index.select lists invisible ones (the counts agree)."""
+
+        from . import stream_topk as ST
+
+        nvis_max = max((win.last + 1) // ratio, 1)
+        out = torch.empty((win.n, topk), dtype=torch.int32, device=qi.device)
+        step = ST.plan(win.n, nvis_max, topk)
+        for a in range(0, win.n, step):
+            b = min(win.n, a + step)
+            sw = win.sub(a, b)
+            out[a:b] = ST.select(qi[a:b], w[a:b], keys.kernel(), sw.t, sw.n, max((sw.last + 1) // ratio, 1), ratio,
+                                 topk=topk, **keys.paging())
+        return out
+
+    def candidates(self, s, win: Win, ratio: int, block: int, topk_blocks: int) -> torch.Tensor:
+        from . import index
+
+        if self._dt(win):
+            from . import dtopk
+
+            got = AC_call(self, "blocks", s, win.t, ratio, topk_blocks, block=block)
+            return got if got is not None else dtopk.blocks(s, win.t, ratio, topk_blocks, block=block, rows=win.rows)
+        return index.candidate_blocks(s, win.t, win.n, ratio, block=block, topk_blocks=topk_blocks, rows=win.rows)
+
+    def reindex(self, qi, w, keys, win: Win, cand, ratio: int, topk: int, block: int) -> torch.Tensor:
+        from . import index
+
+        qi, w = qi.contiguous(), _w32(w)
+        per = cand.shape[1] * block * 16                      # scores, sort keys and candidate positions a row
+        if win.n * per <= self.index_budget and self._dt(win):
+            from . import dtopk
+
+            cand = cand.to(torch.int32).contiguous()
+            s = index.scores(qi, w, keys.kernel(), win.t, win.n, cand.shape[1] * block, ratio, keys=cand,
+                             cand_block=block, **keys.paging(), **_rk(win))
+            got = AC_call(self, "gather_cand", s, cand, win.t, ratio, topk, block=block)
+            sel, cnt = got if got is not None else dtopk.gather_cand(s, cand, win.t, ratio, topk, block=block,
+                                                                     rows=win.rows)
+            return _counted(sel, cnt, ratio)
+        if win.n * per <= self.index_budget:
+            return index.reindex(qi, w, keys.kernel(), win.t, win.n, cand, ratio, topk=topk, block=block,
+                                 **keys.paging(), **_rk(win))
+        out = torch.empty((win.n, topk), dtype=torch.int32, device=qi.device)
+        for a, b in self._row_blocks(win, per):
+            sw = win.sub(a, b)
+            out[a:b] = index.reindex(qi[a:b], w[a:b], keys.kernel(), sw.t, sw.n, cand[a:b].contiguous(), ratio,
+                                     topk=topk, block=block, **keys.paging(), **_rk(sw))
+        return out
+
+    def attention_grouped(self, q, comp, sel, counts, swa, lo, win: Win, sink, table, ring: int,
+                          groups: int) -> torch.Tensor | None:
+        """G16 ``TF_DSV41_PF_COPIES``: ``attention``'s fused prefill path with the output group-major, bf16
+        [groups, R, H / groups x 512] (``wo_a``'s groups read contiguous slices); None where that path does not run
+        (the caller takes ``attention``). The same values as ``attention``'s."""
+
+        if win.rows or not fused_prefill() or q.shape[1] % _pf_bmq(q.shape[1]) or groups < 1 or q.shape[1] % groups:
+            return None
+        from . import attn_pf
+
+        q = q.contiguous()
+        R, H, _ = q.shape
+        out = torch.empty((groups, R, H // groups * q.shape[2]), dtype=BF16, device=q.device)
+        pg = comp.paging() if comp is not None else {}
+        rows = comp.kernel() if comp is not None else None
+        return attn_pf.attention(q, rows, sel, counts, swa.kernel(), lo, win.t, sink.to(F32).contiguous(), table.cs,
+                                 out, ring=ring, groups=groups, **pg)
+
+    def attention(self, q, comp, sel, counts, swa, lo, win: Win, sink, table, ring: int, hi=None) -> torch.Tensor:
+        """Windows longer than the scratch (prefill segments) run in row blocks of the scratch's rows: each row's
+        output is its own program's, so the blocks do not change a bit."""
+
+        from . import attn
+
+        q = q.contiguous()
+        out = torch.empty_like(q, dtype=BF16)
+        pg = comp.paging() if comp is not None else {}
+        rows = comp.kernel() if comp is not None else None
+        sink = sink.to(F32).contiguous()
+        # G7: fast prefill runs, every row of the run in one pass
+        if hi is None and not win.rows and fused_prefill() and q.shape[1] % _pf_bmq(q.shape[1]) == 0:
+            from . import attn_pf
+
+            return attn_pf.attention(q, rows, sel, counts, swa.kernel(), lo, win.t, sink, table.cs, out, ring=ring,
+                                     **pg)
+        step = self.scratch.rows
+        if win.n <= step:
+            if self.acuda:
+                from . import attn_cuda as AC
+
+                if AC.attention(q, rows, sel, counts, swa.kernel(), lo, win.t, sink, table.cs, out, self.scratch,
+                                self.ticket, ring=ring, hi=hi, **pg, **_rk(win)) is not None:
+                    return out
+            return attn.attention(q, rows, sel, counts, swa.kernel(), lo, win.t, sink, table.cs, out, self.scratch,
+                                  ring=ring, hi=hi, **pg, **_rk(win))
+        for a in range(0, win.n, step):
+            b = min(win.n, a + step)
+            sw = win.sub(a, b)
+            attn.attention(q[a:b], rows, None if sel is None else sel[a:b], None if counts is None else counts[a:b],
+                           swa.kernel(), lo[a:b], sw.t, sink, table.cs, out[a:b], self.scratch, ring=ring,
+                           hi=None if hi is None else hi[a:b], **pg, **_rk(sw))
+        return out
