@@ -0,0 +1,510 @@
+"""Lean fast prefill for GLM-5.3-Flash on CUDA (patches/0082, GLM53_TF_LEAN_PREFILL=1): fast-prefill chunks of up to
+GLM53_TF_PREFILL_ROWS_MAX rows (e.g. 8192) without window buffers sized for them.
+
+Why big chunks
+--------------
+Past ~1k rows every routed expert is touched by every chunk, and the fused expert kernels (patches/0080) read each
+expert's weights once per chunk: ~1.8 GB a MoE layer a rank, ~8.4 ms at the measured read rate, whatever the rows
+(the kernels' own time grows more slowly than the rows: 14.5 ms a layer at 1024 rows, 19.7 at 2048). That is the
+one cost of a prefill chunk that does not grow with its rows, so the way to cut it per token is more rows a chunk
+(vLLM prefills in big chunks too). But a ``forward.Buffers`` set costs ~3 MB a row at 1024 rows (and
+more per row past that: the latent partials grow with the rows), there are two (the model's and the MTP head's), and
+the ``State`` adds its KDA replay scratch and projection rows (~2.4 MB a row): 8.5 GiB a rank at 1024 rows, 17.5 at
+2048, ~82 at 8192 (``docs/PREFILL-ANALYSIS.md``).
+
+What is lean about it
+---------------------
+Most of that per-row memory is scratch that only has to hold the rows one kernel works on: the EXL3 split-K
+partials (``exl3_mm.Scratch.z``, 1.2 MB a row, not even used by the fused kernels), qmm's split-K partials (``sk``,
+0.5 MB a row), the latent attention partials (0.55 MB a row), the head's logits (0.15 MB a row: a fast chunk needs
+one row), the KDA replay scratch (1.6 MB a row: a prefill chunk keeps all its rows) and projection rows. A lean chunk
+of R rows (``compute``) therefore runs every block but one in ROW SUB-BLOCKS of ``block`` rows (the main
+``Buffers``' rows, GLM53_TF_LEAN_BLOCK, default 1024) on the main buffers, and keeps at full chunk size only what
+must span the chunk (``LeanBuffers``, ~397 KiB a row on the real model: 3.1 GiB at 8192 rows):
+
+- the residual streams ``x`` [R, 4 x D] bf16, and the FFN half's normed rows and hyper-connection mixes;
+- the routed experts, run ONCE over the whole chunk (the point: each expert's weights are read once per chunk):
+  router, top-k and grouping over all R rows, ``exl3_fast.cu``'s rotated inputs Xg/Xu and Xd (fp16), and the
+  experts' outputs ``ey`` [R, 9, D] fp32, which the per-sub-block combine reads;
+- the final-normed rows (the MTP head absorbs them after the chunk) and the DFlash2 taps.
+
+Per sub-block [a, a + r) of a chunk at position pos: the attention half of a layer (hc_pre, KDA or DSA, the o_proj
+all-gather, hc_post) runs on the main buffers with the sub-block at position pos + a, exactly like a window of r rows
+at pos + a whose predecessors are uncommitted rows of the same forward: DSA writes its keys (and index keys) at
+pos + a.. before it attends, so later sub-blocks see them; KDA continues from the state and conv window the previous
+sub-block left (``tail``: the last 3 projection rows, ``rec``: the state, kept in the layer's output state buffer).
+The FFN half's hc_pre also runs per sub-block, then the routed experts on all R rows, then per sub-block the shared
+expert, the combine, the all-gather and hc_post. The head runs on the chunk's last row only (as in 0080), and
+``commit`` installs the carried conv windows instead of shifting them from projection rows.
+
+Bits
+----
+The same as patches/0080's fast chunk of R rows (``forward.compute(fast=True)``), bit for bit, because every kernel a
+sub-block runs is row-independent and its sub-block boundaries fall on multiples of 64:
+
+- ``qmm`` / ``fast_qmm`` (qmm's bits, split-K fixed by the matrix, not the rows), ``glue`` (per row), the latent /
+  expanded attention and the sparse selection (a row's result depends on its position and the cache below it,
+  patches/0003, 0060, 0065), the bf16 all-gather (a copy): per row;
+- the fused expert kernels: run on the same full chunk with the same grouping as 0080 (and are row-independent);
+- ``fast_kda``: a prompt cut at multiples of 64 gets the same bits whatever the call sizes (patches/0081), given the
+  state and conv window entering each call, which the carry provides; the row-invariant ``kda.chain`` fallback is
+  row-invariant.
+
+So GLM53_TF_LEAN_PREFILL changes memory, not replies (``tests/cuda/test_lean_patches.py`` checks the states equal).
+The fast path's rule (``fastpf``: chunks and snapshots on the grid C) is unchanged; a larger C is a different
+(deterministic) fast prefill, as before. Both ranks must agree on the lean settings: sub-blocks decide how many
+all-gathers a chunk makes.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+
+import torch
+
+from . import fastpf, glue, profile, qmm
+from .forward import Buffers, State, _join, check_room, dsa_block, gather, mlp_block, out_proj
+from .weights import LayerW, Weights
+
+
+def enabled() -> bool:
+    """GLM53_TF_LEAN_PREFILL (default 0): fast-prefill chunks past the main buffers' rows through ``LeanBuffers``."""
+
+    return os.environ.get("GLM53_TF_LEAN_PREFILL", "0").strip().lower() in ("1", "true", "yes", "on")
+
+
+def block() -> int:
+    """GLM53_TF_LEAN_BLOCK (default 1024): the sub-block rows (a multiple of 64), which are also the main buffers'
+    rows (and so the largest exact prefill chunk) when lean prefill is on."""
+
+    v = int(os.environ.get("GLM53_TF_LEAN_BLOCK", "1024") or 1024)
+    if v < 64 or v % fastpf.GRID:
+        raise ValueError(f"GLM53_TF_LEAN_BLOCK={v}: expected a multiple of {fastpf.GRID}")
+    return v
+
+
+def settings() -> list[int]:
+    """This rank's lean settings (both ranks must agree: they decide a chunk's collectives)."""
+
+    return [int(enabled()), block()]
+
+
+class LeanBuffers:
+    """Full-chunk rows of a lean fast chunk of up to ``rows`` rows (sub-blocks of ``block`` rows run on the main
+    ``Buffers``). ``taps``: the DFlash2 tap layers' count (their rows are kept for the whole chunk)."""
+
+    def __init__(self, w: Weights, rows: int, block: int, taps: int = 0) -> None:
+        c = w.cfg
+        dev = w.device
+        bf, f32, i32 = torch.bfloat16, torch.float32, torch.int32
+        D, S = c.hidden, c.streams
+        if block % fastpf.GRID:
+            raise ValueError(f"lean prefill: sub-blocks of {block} rows, expected a multiple of {fastpf.GRID}")
+        self.rows, self.block, self.world = rows, block, w.world
+        self.ids = torch.zeros((rows,), dtype=i32, device=dev)
+        self.ids_host = torch.zeros((rows,), dtype=i32, pin_memory=torch.cuda.is_available())
+        self.staged = torch.cuda.Event() if torch.cuda.is_available() else None
+        self.pos_dev = torch.zeros((1,), dtype=i32, device=dev)        # a sub-block's position (DSA kernels)
+        self.x = torch.empty((rows, S * D), dtype=bf, device=dev)
+        # the FFN half's hc_pre outputs (the routed experts read every row's normed input at once)
+        self.normed = torch.empty((rows, D), dtype=bf, device=dev)
+        self.xs = torch.empty((rows, D // 64), dtype=f32, device=dev)
+        self.post = torch.empty((rows, S), dtype=f32, device=dev)
+        self.comb = torch.empty((rows, S * S), dtype=f32, device=dev)
+        # routing of the whole chunk
+        slots = c.top_k + 1
+        self.slots = slots
+        self.mlog = torch.empty((rows, c.experts), dtype=f32, device=dev)
+        self.pick = torch.empty((rows, slots), dtype=i32, device=dev)
+        self.wts = torch.empty((rows, slots), dtype=f32, device=dev)
+        self.maxu = c.experts + 1
+        self.gids = torch.zeros((self.maxu,), dtype=i32, device=dev)
+        self.gcount = torch.zeros((1,), dtype=i32, device=dev)
+        self.gmem = torch.full((self.maxu * rows,), -1, dtype=i32, device=dev)
+        self.experts, self.top_k = c.experts, c.top_k
+        ml = c.moe_width // w.world
+        self.ey = torch.empty((rows, slots, D), dtype=f32, device=dev)     # every slot's output (combine input)
+        self.exl3 = None
+        self.eact = self.eaxs = None
+        if c.quant == "exl3":
+            # exl3_fast.cu's inputs: rotated rows per (row, slot) pair, fp16; no split-K partials (``Scratch.z``)
+            self.exl3 = _Exl3Rows(rows, slots, D, ml, dev, lazy_xu=lazy_xu())
+        else:
+            self.eact = torch.empty((rows, slots, ml), dtype=bf, device=dev)
+            self.eaxs = torch.empty((rows, slots, ml // 64), dtype=f32, device=dev)
+        # what the chunk hands on: final-normed rows (MTP absorb), DFlash2 taps in ``Engine.tap_rows``' layout
+        self.fnormed = torch.empty((rows, D), dtype=bf, device=dev)
+        self.tapcat = torch.empty((rows, taps * D), dtype=bf, device=dev) if taps else None
+        # KDA carries between sub-blocks: the last 3 projection rows' conv channels, and a state copy
+        kda = [l for l in w.layers if l.kind == "kda"]
+        LL = c.lin_heads // w.world
+        C = 3 * LL * 128
+        self.tail = torch.zeros((len(kda), c.conv - 1, C), dtype=bf, device=dev)
+        self.rec_tmp = torch.zeros((LL, 128, 128), dtype=f32, device=dev) if kda else None
+        self.D = D
+
+    def nbytes(self) -> int:
+        """Device bytes this set holds."""
+
+        return sum(t.numel() * t.element_size() for t in self._tensors() if t.device.type != "cpu")
+
+    def _tensors(self):
+        for v in vars(self).values():
+            if isinstance(v, torch.Tensor):
+                yield v
+            elif isinstance(v, _Exl3Rows):
+                yield from (t for t in (v.xg, v._xu, v.xd) if t is not None)
+
+    def group(self, R: int) -> qmm.Group:
+        """The chunk's expert grouping (``Buffers.group``'s layout: members [maxu, R], row stride R), as views of one
+        allocation sized for ``rows`` (no buffer per chunk length)."""
+
+        maxu = min(R * self.top_k, self.experts) + 1
+        return qmm.Group(self.gids[:maxu], self.gcount, self.gmem[:maxu * R].view(maxu, R))
+
+    def sub_blocks(self, R: int) -> list[tuple[int, int]]:
+        """(first row, rows) of each sub-block of an R-row chunk: multiples of ``block``, the last one partial."""
+
+        return [(a, min(self.block, R - a)) for a in range(0, R, self.block)]
+
+
+def lazy_xu() -> bool:
+    """patches/0335: GLM53_TF_LEAN_LAZY_XU=1 allocates the lean set's Xu (the up matrix's rotated rows, 72 KiB a row)
+    at its first use instead of at load. With gate and up sharing their sign vector (the GLM-5.3-Flash EXL3
+    checkpoints) the fat family (fat / once / auto / tc) reads Xg for both and Xu is never touched: 0.56 GiB a rank less
+    at 8,192-row chunks (0.14 at 2,048). A request that runs plain fast2 (tf_knobs.fat_experts = 0) allocates it then.
+    Memory only: the bits do not change."""
+
+    return os.environ.get("GLM53_TF_LEAN_LAZY_XU", "0").strip().lower() not in ("", "0", "false", "no", "off")
+
+
+class _Exl3Rows:
+    """``exl3_mm.Scratch`` without ``z`` (the fused kernels keep no split-K partials): Xg, Xu, Xd per pair.
+    patches/0335: ``lazy_xu``: Xu is made at its first use."""
+
+    def __init__(self, rows: int, slots: int, dims: int, width: int, device, lazy_xu: bool = False) -> None:
+        P = rows * slots
+        self.xg = torch.zeros((P, dims), dtype=torch.float16, device=device)
+        self._xu = None if lazy_xu else torch.zeros((P, dims), dtype=torch.float16, device=device)
+        self._xu_shape, self._device = (P, dims), device
+        self.xd = torch.zeros((P, width), dtype=torch.float16, device=device)
+        self.z = None
+        self.rows, self.slots = rows, slots
+
+    @property
+    def xu(self) -> torch.Tensor:
+        if self._xu is None:
+            self._xu = torch.zeros(self._xu_shape, dtype=torch.float16, device=self._device)
+        return self._xu
+
+
+def stage(w: Weights, st: State, lb: LeanBuffers, tokens) -> int:
+    """``forward.stage`` into the lean set's ids."""
+
+    R = len(tokens)
+    if R > lb.rows:
+        raise ValueError(f"lean chunk of {R} rows, the lean buffers hold {lb.rows}")
+    check_room(w, st, R)
+    if lb.staged is not None:
+        lb.staged.synchronize()
+    lb.ids_host[:R].numpy()[:] = list(tokens)
+    lb.ids[:R].copy_(lb.ids_host[:R], non_blocking=True)
+    if lb.staged is not None:
+        lb.staged.record()
+    return R
+
+
+# -- blocks on a sub-block ------------------------------------------------------------------------------------------
+def _carry(lb: LeanBuffers, li: int, conv: torch.Tensor, p: torch.Tensor, r: int) -> None:
+    """The conv window after a sub-block: the last 3 rows of [window before it; its projection rows' conv channels]
+    (what ``forward.commit``'s shift keeps)."""
+
+    t = lb.tail[li]
+    taps, C = t.shape
+    if r >= taps:
+        t.copy_(p[r - taps:r, :C])
+    else:
+        t.copy_(torch.cat([conv[r:], p[:r, :C]], 0))
+
+
+def _kda_block(layer: LayerW, w: Weights, st: State, b: Buffers, lb: LeanBuffers, a: int, r: int,
+               pos: int, normed: torch.Tensor | None = None, xs: torch.Tensor | None = None) -> torch.Tensor:
+    """``forward.kda_block`` for sub-block [a, a + r) at absolute position ``pos``: from the committed state for the
+    first sub-block, else from the state and conv window the previous one left. ``normed`` / ``xs``: the sub-block's
+    normed input rows and their group sums (default: the window buffers' first r rows; patches/0084 passes the lean
+    set's rows)."""
+
+    c = w.cfg
+    k = layer.kda
+    li = st.kda_index[layer.index]
+    p = st.proj[li, :r]
+    normed = b.normed[:r] if normed is None else normed
+    xs = b.xs[:r] if xs is None else xs
+    qmm.matmul(normed, fastpf.kda_proj(k), xs, out=p, part=b.sk)       # patches/0170
+    fa = p[:, k.fa_off:k.fa_off + 128]
+    ga = p[:, k.ga_off:k.ga_off + 128]
+    qmm.matmul(fa, k.fb, qmm.group_sums(fa, b.xs_fa[:r]), out=b.ka[:r], part=b.sk)
+    qmm.matmul(ga, k.gb, qmm.group_sums(ga, b.xs_ga[:r]), out=b.kg[:r], part=b.sk)
+    if profile.ON:
+        profile.lap("kda.proj")
+    cur = st.cur[li]
+    s_out = st.rec[1 - cur, li]
+    if a == 0:
+        conv, s_in = st.conv[li], st.rec[cur, li]
+    else:
+        lb.rec_tmp.copy_(s_out)
+        conv, s_in = lb.tail[li], lb.rec_tmp
+    out = fastpf.kda_chain(p, k.b_off, b.ka[:r], b.kg[:r], conv, k.conv, s_in, k.a_log, k.dt_bias, k.norm, c.eps,
+                           c.lower, r, st.scratch[li], s_out, pos=pos)
+    _carry(lb, li, conv, p, r)
+    if profile.ON:
+        profile.lap("kda.chain")
+    return out_proj(w, b, out, k.o, qmm.group_sums(out, b.kxs[:r]), r, "kda.o_proj")
+
+
+def _attn_half(layer: LayerW, w: Weights, st: State, b: Buffers, lb: LeanBuffers, a: int, r: int, pos: int) -> None:
+    c = w.cfg
+    x = lb.x[a:a + r]
+    h = layer.attn_hc
+    glue.hc_pre(x, h.fn, h.base, h.scale, layer.in_norm, b.normed[:r], b.xs[:r], b.post[:r], b.comb[:r],
+                b.hcpart[:r], c.eps, c.hc_eps, c.hc_iters)
+    if profile.ON:
+        profile.lap("hc")
+    b.site = (layer.index, "a")
+    if layer.kind == "kda":
+        g = _kda_block(layer, w, st, b, lb, a, r, pos)
+    else:
+        from .attention import CHUNK
+
+        di = st.dsa_index[layer.index]
+        lb.pos_dev.fill_(pos)
+        g = dsa_block(layer, w, st.kc[di], st.vc[di], lb.pos_dev, b, r, -(-(pos + r) // CHUNK),
+                      st.index[di] if st.index is not None else None, pos, None)
+    glue.hc_post(x, x, g, b.post[:r], b.comb[:r])
+    if profile.ON:
+        profile.lap("hc")
+
+
+def _ffn_dense(layer: LayerW, w: Weights, b: Buffers, lb: LeanBuffers, a: int, r: int) -> None:
+    c = w.cfg
+    x = lb.x[a:a + r]
+    h = layer.ffn_hc
+    glue.hc_pre(x, h.fn, h.base, h.scale, layer.post_norm, b.normed[:r], b.xs[:r], b.post[:r], b.comb[:r],
+                b.hcpart[:r], c.eps, c.hc_eps, c.hc_iters)
+    if profile.ON:
+        profile.lap("hc")
+    b.site = (layer.index, "f")
+    g = mlp_block(layer, w, b, r)
+    glue.hc_post(x, x, g, b.post[:r], b.comb[:r])
+    if profile.ON:
+        profile.lap("hc")
+
+
+def _ffn_moe(layer: LayerW, w: Weights, b: Buffers, lb: LeanBuffers, R: int) -> None:
+    """The MoE half: hc_pre per sub-block into the chunk's rows, routing and the routed experts once over all R rows
+    (each expert's weights read once per chunk), then per sub-block the shared expert, combine, gather, hc_post."""
+
+    c = w.cfg
+    h = layer.ffn_hc
+    blocks = lb.sub_blocks(R)
+    for a, r in blocks:
+        glue.hc_pre(lb.x[a:a + r], h.fn, h.base, h.scale, layer.post_norm, lb.normed[a:a + r], lb.xs[a:a + r],
+                    lb.post[a:a + r], lb.comb[a:a + r], b.hcpart[:r], c.eps, c.hc_eps, c.hc_iters)
+    if profile.ON:
+        profile.lap("hc")
+    _routed(layer, w, lb, R)
+    for a, r in blocks:
+        _shared_combine(layer, w, b, lb, a, r, b.part[:r])
+        b.site = (layer.index, "f")
+        g = gather(w, b, r)
+        x = lb.x[a:a + r]
+        glue.hc_post(x, x, g, lb.post[a:a + r], lb.comb[a:a + r])
+        if profile.ON:
+            profile.lap("hc")
+
+
+def _routed(layer: LayerW, w: Weights, lb: LeanBuffers, R: int) -> None:
+    """Routing (router, top-k, grouping) and the routed experts, once over the chunk's R rows (their normed rows in
+    ``lb.normed``) into ``lb.ey``."""
+
+    c = w.cfg
+    m = layer.moe
+    grp = lb.group(R)
+    glue.router(lb.normed[:R], m.router, lb.mlog[:R])
+    glue.select(lb.mlog[:R], m.bias, lb.pick[:R], lb.wts[:R], grp.ids, grp.count, grp.members, c.top_k, c.experts,
+                c.routed_scale, c.norm_topk)
+    if profile.ON:
+        profile.lap("moe.router")
+    if m.shared is not None:
+        from . import exl3_mm
+
+        exl3_mm.routed(lb.normed[:R], lb.pick, grp, m.experts, lb.exl3, lb.ey.view(-1, c.hidden), R, c.limit,
+                       fast=True)
+    else:
+        qmm.moe_gateup(lb.normed[:R], lb.xs[:R], m.experts, grp, lb.eact, lb.eaxs, c.limit)
+        qmm.moe_down(lb.eact, lb.eaxs, m.experts, grp, lb.ey)
+    if profile.ON:
+        profile.lap("moe.routed")
+
+
+def _shared_combine(layer: LayerW, w: Weights, b: Buffers, lb: LeanBuffers, a: int, r: int,
+                    out: torch.Tensor) -> None:
+    """Sub-block [a, a + r) of the MoE half after the routed experts: the shared expert (EXL3: BF16 matmuls into its
+    slot of ``lb.ey``), then the rank's combined share into ``out`` [r, D] (fp32; bf16 in patches/0084's pipeline)."""
+
+    c = w.cfg
+    m = layer.moe
+    if m.shared is not None:
+        s = m.shared
+        qmm.matmul(lb.normed[a:a + r], s.gu, lb.xs[a:a + r], out=b.sgu[:r], part=b.sk)
+        glue.swiglu(b.sgu[:r], b.sact[:r], b.sxs[:r], c.limit)
+        qmm.matmul(b.sact[:r], s.down, b.sxs[:r], out=b.sy[:r], f32=True, part=b.sk)
+        inplace = glue.SHARED_INPLACE and b.sy[:r].is_contiguous()          # patches/0190: no copy into ey
+        if not inplace:
+            lb.ey[a:a + r, c.top_k].copy_(b.sy[:r])
+        if profile.ON:
+            profile.lap("moe.shared")
+        if inplace:
+            glue.combine(lb.ey[a:a + r], lb.wts[a:a + r], out, shared=b.sy[:r])
+            if profile.ON:
+                profile.lap("moe.combine")
+            return
+    glue.combine(lb.ey[a:a + r], lb.wts[a:a + r], out)
+    if profile.ON:
+        profile.lap("moe.combine")
+
+
+# -- the chunk ------------------------------------------------------------------------------------------------------
+@contextlib.contextmanager
+def chunk_rows(w: Weights, R: int):
+    """Within a lean chunk of R rows, a fast matmul picks its kernel as for the whole chunk, not for its sub-block.
+
+    ``fast_qmm`` sends calls of fewer than ``MIN_ROWS`` (64) rows to ``qmm.matmul`` (and FP8 to the bf16 fast kernel),
+    whose bits differ from the fast kernels'; every other choice it makes by row count (tiles) leaves a row's bits
+    alone. A chunk of R >= MIN_ROWS rows runs all its matmuls on the fast kernels, so a sub-block of fewer rows (the
+    chunk's partial last one) must too: for its duration ``MIN_ROWS`` is 1. The head is the exception: the whole-chunk
+    path runs it on the last row alone, which goes to ``qmm.matmul``, so calls on ``w.head`` keep the threshold.
+    Installed through ``fast_qmm.matmul_fast``, which ``fastpf.chunk`` reads on entry (so it also covers chunk
+    entries inside this scope)."""
+
+    fq = fastpf.fast_qmm
+    lo = getattr(fq, "MIN_ROWS", None)
+    inner = getattr(fq, "matmul_fast", None)
+    if lo is None or inner is None or R < lo:
+        yield
+        return
+    head = w.head
+
+    def matmul_fast(x, q, xs=None, *, out=None, f32=False, part=None):
+        if x.shape[0] >= lo or q is head:
+            return inner(x, q, xs, out=out, f32=f32, part=part)
+        fq.MIN_ROWS = 1
+        try:
+            return inner(x, q, xs, out=out, f32=f32, part=part)
+        finally:
+            fq.MIN_ROWS = lo
+
+    fq.matmul_fast = matmul_fast
+    try:
+        yield
+    finally:
+        fq.matmul_fast = inner
+        fq.MIN_ROWS = lo
+
+
+def compute(w: Weights, st: State, b: Buffers, lb: LeanBuffers, R: int, *, head: bool = True) -> torch.Tensor:
+    """``_compute`` with the whole chunk's kernel choice in every sub-block (``chunk_rows``)."""
+
+    with chunk_rows(w, R):
+        return _compute(w, st, b, lb, R, head=head)
+
+
+def _compute(w: Weights, st: State, b: Buffers, lb: LeanBuffers, R: int, *, head: bool = True) -> torch.Tensor:
+    """A fast prefill chunk of R staged rows (``stage``) at st.pos: the bits of ``forward.compute(..., fast=True,
+    head=head)`` on R-row buffers. Returns the last row's logits [1, V/world] (stale unless ``head``); the chunk's
+    final-normed rows are in ``lb.fnormed[:R]`` and its DFlash2 taps in ``lb.tapcat[:R]``. The committed state is
+    unchanged until ``commit``.
+
+    With GLM53_TF_PREFILL_OVERLAP (patches/0084, ``pfoverlap``) the same kernels run on the same inputs in another
+    order: each sub-block's all-gather on a comm stream while the next sub-block computes, the partials exchanged as
+    written, and each hc_post followed by the next hc_pre of its rows. Same bits."""
+
+    from . import pfoverlap
+
+    if pfoverlap.on():
+        return pfoverlap.compute(w, st, b, lb, R, head=head)
+    if R > lb.rows:
+        raise ValueError(f"lean chunk of {R} rows, the lean buffers hold {lb.rows}")
+    if lb.block > b.rows:
+        raise ValueError(f"lean sub-blocks of {lb.block} rows, the main buffers hold {b.rows}")
+    c = w.cfg
+    pos0 = st.pos
+    blocks = lb.sub_blocks(R)
+    with fastpf.chunk(b, w.head):           # patches/0085: the head keeps qmm below 64 rows
+        glue.embed(lb.ids[:R], w.embed, c.hidden, c.streams, lb.x[:R])
+        if profile.ON:
+            profile.lap("embed")
+        for layer in w.layers:
+            for a, r in blocks:
+                _attn_half(layer, w, st, b, lb, a, r, pos0 + a)
+            if layer.mlp is not None:
+                for a, r in blocks:
+                    _ffn_dense(layer, w, b, lb, a, r)
+            else:
+                _ffn_moe(layer, w, b, lb, R)
+            for slot in b.tap_at.get(layer.index, ()):
+                for a, r in blocks:
+                    glue.stream_mean(lb.x[a:a + r], b.taps[slot][:r])
+                    lb.tapcat[a:a + r, slot * lb.D:(slot + 1) * lb.D].copy_(b.taps[slot][:r])
+        for a, r in blocks:
+            glue.stream_mean(lb.x[a:a + r], b.hidden[:r])
+            glue.rmsnorm(b.hidden[:r], w.norm, c.eps, lb.fnormed[a:a + r], b.fxs[:r])
+        if profile.ON:
+            profile.lap("hc")
+        r = blocks[-1][1]
+        if head:                         # patches/0080: prefill samples the last row only
+            qmm.matmul(lb.fnormed[R - 1:R], w.head, b.fxs[r - 1:r], out=b.logits[:1], part=b.sk)
+        if profile.ON:
+            profile.lap("head")
+        _join(w)
+    return b.logits[:1]
+
+
+@torch.no_grad()
+def commit(w: Weights, st: State, lb: LeanBuffers, R: int) -> None:
+    """``forward.commit(w, st, b, R, R)`` after a lean chunk: every KDA layer's state is in its other buffer and its
+    conv window in ``lb.tail`` (the carry), the committed length advances by R."""
+
+    n = len(st.cur)
+    if n:
+        st.cur = [1 - st.cur[0]] * n
+        st.conv[:n].copy_(lb.tail)
+    st.set_pos(st.pos + R, committed=True)
+    if st.index_ring:
+        st.save_index_tail()             # patches/0065
+
+
+def budget(w: Weights, rows: int, block: int, taps: int = 0) -> dict[str, int]:
+    """Bytes a rank of the lean set at ``rows`` rows (for the memory table / tests), by part."""
+
+    c = w.cfg
+    D, S, slots = c.hidden, c.streams, c.top_k + 1
+    ml = c.moe_width // w.world
+    LL = c.lin_heads // w.world
+    nk = sum(1 for l in c.kinds if l == "kda")
+    out = {
+        "x (streams)": rows * S * D * 2,
+        "ffn normed/xs/post/comb": rows * (D * 2 + D // 64 * 4 + S * 4 + S * S * 4),
+        "routing (mlog, pick, wts, members)": rows * (c.experts * 4 + slots * 8 + (c.experts + 1) * 4),
+        "expert outputs ey (fp32)": rows * slots * D * 4,
+        "fnormed": rows * D * 2,
+        "taps": rows * taps * D * 2,
+        "kda carry": nk * (c.conv - 1) * 3 * LL * 128 * 2 + LL * 128 * 128 * 4,
+        "ids, expert ids, positions": rows * 4 + (c.experts + 1) * 4 + 8,
+    }
+    if c.quant == "exl3":
+        out["expert inputs Xg/Xu/Xd (fp16)"] = rows * slots * (2 * D + ml) * 2
+    else:
+        out["expert activations"] = rows * slots * (ml * 2 + ml // 64 * 4)
+    return out
diff --git a/src/tensorfold/families/glm5_next/spark/lookup.py b/src/tensorfold/families/glm5_next/spark/lookup.py
new file mode 100644
index 0000000..8004af2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/lookup.py
@@ -0,0 +1,356 @@
+"""Prompt-lookup drafts for GLM-5.3-Flash (patches/0020): continue the longest earlier occurrence of the text's
+suffix, with no model forward.
+
+Agent traffic (file edits, tool calls, JSON, code quoting the context) repeats long spans of what is already in
+the prompt or the reply. ``SuffixIndex`` keeps every ``n``-gram of the request's history (prompt, then every
+committed token) and, each round, finds the earlier occurrence whose backward match with the history's end is
+longest (ties to the most recent); the tokens that followed it are the drafts (``copy``: a match that overlaps the
+end continues periodically, as an LZ77 copy does). The Nemotron lanes' ``SuffixLookupProposer`` and Qwen's
+``CopyIndex`` draw from the context the same way.
+
+``Lookup`` decides each round whether to spend a verify window on those tokens and how many: the drafts are
+verified by the same window, keyed sampler and commit as every other draft, so a draft is kept exactly when it
+equals the token serial decoding produces there (greedy or sampled), and the reply is byte-identical to serial
+decoding whatever is proposed. The decision only changes the speed:
+
+- forced (policy ``lN[:M]``): every round with a match of at least M tokens verifies up to N of its tokens; the
+  other rounds draft with the MTP head as ``auto`` does.
+- gated (``auto`` with GLM53_TF_LOOKUP=1, the default): a round with a match of at least GLM53_TF_LOOKUP_MIN
+  tokens verifies the k tokens (0 to 7) with the most expected committed tokens per millisecond,
+  (1 + p + ... + p^k) / (verify window of k + 1 rows + the catch-up of the rows the drafters missed), and only
+  when that beats the tokens a millisecond this request's MTP / DFlash2 rounds have committed (their recent
+  rounds, priced as ``decode.DrafterChoice`` prices them). ``p``, the chance a lookup draft is kept given the
+  one before it was, is a running estimate per match-length band, starting from a cautious prior: a short match
+  in prose is often a coincidence, a match of dozens of tokens is usually a copy. A band of matches of 16 tokens
+  or more that the gate skipped 8 times is tried once, so its estimate can recover.
+
+Everything here is a function of the committed tokens, the load-time costs (the slower rank's, the same on
+both) and the policy code rank 0 sends in the request header, so both ranks make the same decision every round
+without exchanging anything. Pure Python (no torch): the unit tests run anywhere.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Sequence
+
+LOOKUP_KIND = 20                  # policy code kind of ``lN[:M]``: [20, N, M, 0]
+DEFAULT_MIN = 3                   # ``lN``'s match threshold when M is not given
+from . import deep as _deep                     # patches/0380
+from .vision_prep import VBASE                   # patches/0500: virtual ids of image rows
+
+MAX_DRAFTS = _deep.DRAFTS         # a verify window holds the pending token and up to 7 drafts (0380: up to 15)
+CANDIDATES = 64                   # earlier occurrences of the suffix's n-gram examined a round (most recent first)
+EXTEND = 64                       # a backward match is not measured past this many tokens
+# (shortest match of the band, prior p): the chance a lookup draft is kept after a kept one, before this request
+# has evidence. Cautious for short matches, which prose makes by chance.
+BANDS = ((0, 0.45), (8, 0.7), (16, 0.8), (32, 0.9))
+PRIOR_WEIGHT = 2.0                # trials the prior counts for
+DECAY = 0.85                      # a band's evidence fades by this a round that updates it
+ALT_WINDOW = 8                    # the other drafters' rate: their last 8 rounds
+PROBE_EVERY = 8                   # a band of matches of 16+ tokens the gate skipped this many times is tried once
+PROBE_MATCH = 16
+
+
+def env_settings() -> tuple[int, int]:
+    """(on, min match) for ``auto`` from GLM53_TF_LOOKUP (default 1) and GLM53_TF_LOOKUP_MIN (default 4). Read on
+    rank 0 only: the values travel in the request header."""
+
+    on = os.environ.get("GLM53_TF_LOOKUP", "1").strip().lower() not in ("0", "false", "off", "no", "")
+    least = int(os.environ.get("GLM53_TF_LOOKUP_MIN", "4"))
+    if not 1 <= least <= 64:
+        raise ValueError(f"GLM53_TF_LOOKUP_MIN={least}: expected 1 to 64")
+    return int(on), least
+
+
+def parse_policy(spec: str) -> list[int] | None:
+    """``lN`` or ``lN:M`` -> [LOOKUP_KIND, N, M, 0]; None when ``spec`` is not a lookup spec. N from 1 to 7 (the
+    most drafts a round), M from 1 to 64 (the shortest match that drafts)."""
+
+    spec = str(spec).strip()
+    if not spec.startswith("l"):
+        return None
+    parts = spec[1:].split(":")
+    bad = ValueError(f"draft policy {spec!r}: expected lN or lN:M (N from 1 to {MAX_DRAFTS}, M from 1 to 64)")
+    if len(parts) not in (1, 2):
+        raise bad
+    try:
+        most = int(parts[0])
+        least = int(parts[1]) if len(parts) == 2 else DEFAULT_MIN
+    except ValueError:
+        raise bad from None
+    if not 1 <= most <= MAX_DRAFTS or not 1 <= least <= 64:
+        raise bad
+    return [LOOKUP_KIND, most, least, 0]
+
+
+def with_lookup(code: list[int], has_mtp: bool, dflash_code: list[int]) -> list[int]:
+    """Rank 0: the policy code a request runs, lookup settings included. ``auto`` codes (kind 4, 5) gain
+    [on, min match] from the environment; ``lN`` needs the MTP head for the rounds without a match, so on a
+    checkpoint without it the request runs ``dflash_code`` (DFlash2 drafts, no lookup)."""
+
+    if code[0] == LOOKUP_KIND and not has_mtp:
+        return list(dflash_code)
+    if code[0] in (4, 5) and len(code) == 4:
+        return list(code) + list(env_settings())
+    return list(code)
+
+
+def lookup_for(code: Sequence[int], prompt: Sequence[int], costs: dict, *, eos: Sequence[int] = (),
+               stop_eos: bool = True) -> "Lookup | None":
+    """The request's ``Lookup`` for its policy code, or None when it drafts none."""
+
+    if code[0] == LOOKUP_KIND:
+        return Lookup(prompt, costs, most=code[1], min_match=code[2], gated=False, eos=eos, stop_eos=stop_eos)
+    if code[0] in (4, 5) and len(code) >= 6 and code[4]:
+        return Lookup(prompt, costs, most=MAX_DRAFTS, min_match=code[5], gated=True, eos=eos, stop_eos=stop_eos)
+    return None
+
+
+# -- the matcher ----------------------------------------------------------------------------------------------------
+class SuffixIndex:
+    """Where every ``n``-gram of a growing token history ends, for the longest earlier match of its suffix.
+
+    ``extend`` appends tokens (O(1) each); ``match`` returns (length, end): ``history[end - length:end]`` equals
+    the last ``length`` tokens, ``end < len(history)``, the longest such match among the ``candidates`` most
+    recent occurrences of the last ``n`` tokens (ties to the most recent), measured up to ``extend_to`` tokens;
+    (0, -1) when the last n-gram never occurred before."""
+
+    def __init__(self, n: int = 3, *, candidates: int = CANDIDATES, extend_to: int = EXTEND) -> None:
+        if n < 1:
+            raise ValueError("n must be positive")
+        self.n = n
+        self.candidates = candidates
+        self.extend_to = max(extend_to, n)
+        self.tokens: list[int] = []
+        self.ends: dict[tuple[int, ...], list[int]] = {}
+        self.indexed = 0            # n-grams ending at or before this many tokens are in ``ends``
+        self.owner: object = None   # the ``Lookup`` extending it (``reuse_index`` hands it to the next request)
+
+    def __len__(self) -> int:
+        return len(self.tokens)
+
+    def extend(self, tokens: Sequence[int]) -> None:
+        self.tokens.extend(int(t) for t in tokens)
+
+    def _index(self) -> None:
+        # the n-gram ending at the history's end is the query itself: it joins once a token follows it, so a match
+        # always has a continuation
+        n, t = self.n, self.tokens
+        first, last = max(self.indexed, n), len(t)          # new n-grams end at first .. last - 1
+        if first < last:
+            ends = self.ends
+            grams = zip(*(t[first - n + i:last - n + i] for i in range(n)))
+            for end, key in zip(range(first, last), grams):
+                got = ends.get(key)
+                if got is None:
+                    ends[key] = [end]
+                else:
+                    got.append(end)
+        self.indexed = max(self.indexed, last)
+
+    def match(self) -> tuple[int, int]:
+        t = self.tokens
+        L = len(t)
+        if L <= self.n:
+            return 0, -1
+        self._index()
+        ends = self.ends.get(tuple(t[L - self.n:]))
+        if not ends:
+            return 0, -1
+        best_len, best_end = 0, -1
+        for end in reversed(ends[-self.candidates:]):
+            length = self.n                     # the n-gram matches by construction
+            limit = min(self.extend_to, end)
+            while length < limit and t[end - 1 - length] == t[L - 1 - length]:
+                length += 1
+            if length > best_len:
+                best_len, best_end = length, end
+                if length >= self.extend_to:
+                    break
+        return best_len, best_end
+
+    def copy(self, end: int, count: int) -> list[int]:
+        """The ``count`` tokens that follow position ``end`` if the history repeats from there: past the history's
+        end the copy reads its own output (an overlapping match continues with its period)."""
+
+        t = self.tokens
+        L = len(t)
+        out: list[int] = []
+        for i in range(count):
+            j = end + i
+            out.append(t[j] if j < L else out[j - L])
+        return out
+
+    def propose(self, count: int, min_match: int = 1) -> tuple[list[int], int]:
+        """(up to ``count`` drafts, match length) from the longest match of at least ``min_match`` tokens."""
+
+        length, end = self.match()
+        if end < 0 or length < min_match or count <= 0:
+            return [], length
+        out = self.copy(end, count)
+        for i, d in enumerate(out):        # patches/0500: an image row's virtual id is never a token to draft
+            if d >= VBASE:
+                return out[:i], length
+        return out, length
+
+
+_last: list[SuffixIndex] = []         # the previous request's index (prompt and reply), for the next turn
+
+
+def reuse_index(n: int, prompt: Sequence[int]) -> SuffixIndex:
+    """An index of ``prompt``: the previous request's, extended, when ``prompt`` begins with its whole history
+    (the next turn of a conversation: indexing a 100k-token prompt from scratch takes ~0.1 s), else a new one.
+    Matches are a function of the tokens alone, so reuse never changes a proposal."""
+
+    prompt = [int(t) for t in prompt]
+    idx = _last[0] if _last else None
+    if idx is None or idx.n != n or len(idx.tokens) > len(prompt) or prompt[:len(idx.tokens)] != idx.tokens:
+        idx = SuffixIndex(n)
+    idx.extend(prompt[len(idx.tokens):])
+    _last[:] = [idx]
+    return idx
+
+
+# -- per-round decision -------------------------------------------------------------------------------------------
+def round_ms(costs: dict, arm: str, rows: int, steps: int, backlog: int) -> float:
+    """Model ms of a round, as ``decode.DrafterChoice.cost`` prices it (``arm`` "m" MTP, "f" DFlash2, "l" lookup:
+    the window only)."""
+
+    verify = costs["verify"][min(rows, len(costs["verify"])) - 1]
+    if arm == "l":
+        return verify
+    if arm == "m":
+        return (verify + costs.get("mtp", 0.0) + costs.get("mtp_step", 0.0) * max(steps - 1, 0)
+                + costs.get("mtp_row", 0.0) * max(backlog - 1, 0))
+    return verify + costs.get("block", 0.0) + costs.get("taps_row", 0.0) * backlog
+
+
+def best_depth(p: float, costs: dict, most: int, row_ms: float = 0.0) -> tuple[int, float]:
+    """(k, rate): the number of drafts (1 to ``most``) whose expected committed tokens, 1 + p + ... + p^k, per
+    ms of a (k + 1)-row window (plus ``row_ms`` a committed row for the drafters' catch-up) is highest."""
+
+    best, best_rate = 0, 0.0
+    expected = run = 1.0
+    verify = costs["verify"]
+    for k in range(1, min(most, len(verify) - 1) + 1):
+        run *= p
+        expected += run
+        rate = expected / (verify[k] + row_ms * expected)
+        if rate > best_rate:
+            best, best_rate = k, rate
+    return best, best_rate
+
+
+class Lookup:
+    """A request's lookup drafter: ``plan`` before each round (the drafts, or [] to let the other drafters draft),
+    ``record`` after it."""
+
+    def __init__(self, prompt: Sequence[int], costs: dict, *, most: int = MAX_DRAFTS, min_match: int = 4,
+                 gated: bool = True, eos: Sequence[int] = (), stop_eos: bool = True) -> None:
+        self.costs = costs
+        self.most = max(1, min(int(most), MAX_DRAFTS, len(costs["verify"]) - 1))
+        self.min_match = max(1, int(min_match))
+        self.gated = gated
+        self.eos = frozenset(int(t) for t in eos) if stop_eos else frozenset()
+        self.prompt = [int(t) for t in prompt]
+        self.index = reuse_index(min(self.min_match, 8), self.prompt)
+        self.index.owner = self
+        self.prompt_len = len(prompt)
+        self.synced = 0                           # tokens of the decode loop's ``out`` in the index
+        self.acc = [0.0] * len(BANDS)             # decayed kept drafts, trials per band
+        self.tri = [0.0] * len(BANDS)
+        self.alt: list[tuple[int, float]] = []    # (tokens committed, model ms) of recent non-lookup rounds
+        # a committed row is later taken by the drafter that drafts next (an MTP row or DFlash2's taps)
+        self.row_ms = max(costs.get("mtp_row", 0.0), costs.get("taps_row", 0.0))
+        self.skipped = [0] * len(BANDS)          # gated-out rounds per band since its last lookup round
+        self.band = 0
+        self.rounds = self.drafted = self.accepted = 0
+
+    def _band(self, length: int) -> int:
+        b = 0
+        for i, (least, _) in enumerate(BANDS):
+            if length >= least:
+                b = i
+        return b
+
+    def p(self, band: int) -> float:
+        prior = BANDS[band][1]
+        return (self.acc[band] + prior * PRIOR_WEIGHT) / (self.tri[band] + PRIOR_WEIGHT)
+
+    def alt_rate(self) -> float:
+        """Tokens a model ms of this request's recent MTP / DFlash2 rounds; before any, an MTP round keeping one
+        draft."""
+
+        if self.alt:
+            return sum(k for k, _ in self.alt) / sum(ms for _, ms in self.alt)
+        c = self.costs
+        return 2.0 / (c["verify"][min(2, len(c["verify"])) - 1] + c.get("mtp", 0.0))
+
+    def sync(self, out: Sequence[int]) -> None:
+        """The history is the prompt then ``out`` (the decode loop's tokens: every committed one and the pending
+        token, which is already the exact sample for its position)."""
+
+        if self.index.owner is not self:          # a later request took the shared index: a private one
+            self.index = SuffixIndex(self.index.n)
+            self.index.extend(self.prompt + [int(t) for t in out[:self.synced]])
+            self.index.owner = self
+        if self.synced < len(out):
+            self.index.extend(out[self.synced:])
+            self.synced = len(out)
+
+    def plan(self, out: Sequence[int], room: int) -> list[int]:
+        """The drafts for the positions after ``out[-1]`` (at most ``room``), or [] for a round of the other
+        drafters."""
+
+        self.sync(out)
+        most = min(self.most, room)
+        if most <= 0:
+            return []
+        drafts, length = self.index.propose(most, self.min_match)
+        if self.eos:                       # a draft past the end of the reply is never kept
+            for i, d in enumerate(drafts):
+                if d in self.eos:
+                    drafts = drafts[:i]
+                    break
+        if not drafts:
+            return []
+        self.band = self._band(length)
+        opt = getattr(self, "opt", None)          # patches/0071: surplus at the request's running rate
+        if self.gated and opt is not None:
+            b = self.band
+            k, surplus = opt.lookup_depth(self.p(b), len(drafts), self.row_ms)
+            if k == 0 or surplus <= 0.0:
+                self.skipped[b] += 1
+                if k == 0 or BANDS[b][0] < PROBE_MATCH or self.skipped[b] < PROBE_EVERY:
+                    return []
+            self.skipped[b] = 0
+            drafts = drafts[:k]
+        elif self.gated:
+            b = self.band
+            k, rate = best_depth(self.p(b), self.costs, len(drafts), self.row_ms)
+            if k == 0 or rate <= self.alt_rate():
+                # a long match's acceptance is learned only by trying it: once in a while, it is
+                self.skipped[b] += 1
+                if k == 0 or BANDS[b][0] < PROBE_MATCH or self.skipped[b] < PROBE_EVERY:
+                    return []
+            self.skipped[b] = 0
+            drafts = drafts[:k]
+        return drafts
+
+    def record(self, arm: str, rows: int, steps: int, backlog: int, keep: int) -> None:
+        """After a round: ``arm`` "l" updates the band's acceptance; another arm's committed tokens and model ms
+        join the rate lookup rounds must beat."""
+
+        if arm == "l":
+            drafts = rows - 1
+            kept = keep - 1
+            b = self.band
+            self.acc[b] = self.acc[b] * DECAY + kept
+            self.tri[b] = self.tri[b] * DECAY + kept + (1 if kept < drafts else 0)
+            self.rounds += 1
+            self.drafted += drafts
+            self.accepted += kept
+            return
+        self.alt.append((keep, round_ms(self.costs, arm, rows, steps, backlog)))
+        del self.alt[:-ALT_WINDOW]
diff --git a/src/tensorfold/families/glm5_next/spark/memsafe.py b/src/tensorfold/families/glm5_next/spark/memsafe.py
new file mode 100644
index 0000000..df4d5e2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/memsafe.py
@@ -0,0 +1,469 @@
+"""Memory safety for GLM-5.3-Flash on GB10 (patches/0550): the prefill selection's context-sized scratch, the caching
+allocator's growth, and admission / store decisions that count reclaimable page cache.
+
+Why (W15, docs/MEMORY-SAFETY.md)
+--------------------------------
+1. The needle dip. During a lone ~300k prefill MemAvailable fell by 3-4.5 GiB (to 6.4 GiB after the stress + MMLU)
+   and came back at once when the prefill ended. The cause is patches/0065's blocked selection
+   (``sparse.select_pools_blocked``): every DSA call (11 layers, one a 512-row sub-block of a fast chunk) allocates
+   its int32 key block ``[n, npc]`` with npc = the block's complete pools, about 512 B x position: 67 MB at 131k,
+   161 MB at 314k, 256 MiB (``GLM53_TF_SELECT_MB``) from 524k on. The size grows a little every sub-block, so every
+   ~4,096 tokens the next one no longer fits the freed block of the previous one (torch's caching allocator keeps
+   segments whole and returns nothing to the system on its own): it takes a new segment of the new size and keeps
+   the old one cached. The reserved memory grows by the sum of all sizes, quadratically in the context (bound:
+   ``keys_growth``: ~5.8 GiB from 0 to 314k, ~16 GiB to 1M), and is handed back only by ``torch.cuda.empty_cache()``,
+   which ``torch.cuda.graph`` calls before every capture: the first MTP draft after the prompt meets a new pool
+   bucket (patches/0050's long graphs), captures, and MemFree jumps up. W15's trace fits it: the slope steepens with
+   the position (0.6 -> 1.9-2.5 GiB/min), the drop is ~75% of the no-reuse bound, and the release is the capture.
+2. Page cache. On GB10 ``cudaMemGetInfo`` free is the kernel's MemFree: reclaimable page cache counts as used, so
+   while a 36 GB file was copied (MemFree 2.1 GiB, 16.8 GiB of cache) admission (free - store headroom >=
+   ``GLM53_TF_BATCH_ADMIT_GB``) let C4 requests in one at a time.
+
+What this module holds (no torch at import; host-tested)
+--------------------------------------------------------
+- ``/proc/meminfo`` and the admission measure: ``usable`` = CUDA free + the allocator's cached bytes + the page cache
+  credit, the credit = MemAvailable - MemFree - Dirty - Writeback - max(Mapped, ``GLM53_TF_ADMIT_CACHE_KEEP_GB``)
+  (dirty pages need writeback before they can go, mapped pages are other programs' and our libraries' working set).
+  ``GLM53_TF_ADMIT_MEM=available`` (default) or ``free`` (the old measure). A request is also held while the
+  immediately free memory (CUDA free + allocator cache) is under ``GLM53_TF_ADMIT_FREE_FLOOR_GB`` (1).
+- ``AdmitLog``: one line when admission starts waiting for memory (and every 30 s while it does), one when it ends.
+- ``Trimmer`` (``GLM53_TF_ALLOC_TRIM_GB``, default 2; 0 off): before a prefill piece, when the allocator holds more
+  than that many GiB it does not use, ``torch.cuda.empty_cache()``, at most once every ``GLM53_TF_ALLOC_TRIM_S`` (10)
+  seconds; if a trim frees little (graph pools), the trigger moves up (hysteresis), so it cannot run every piece.
+- The selection's size model: ``select_blocks`` (what one DSA call allocates, as ``sparse`` computes it),
+  ``keys_growth`` (the caching allocator's reserved growth over a prefill without the scratch, an upper bound: no
+  reuse by other allocations), ``scratch_bytes`` / ``scratch_grow_to`` (what ``sparse``'s scratch holds after a
+  prefill to a position: its largest block rounded up to 16 MiB, at most GLM53_TF_SELECT_MB), ``scratch_growth``
+  (admission's reservation for a prompt).
+- ``drop_file_cache``: fdatasync + POSIX_FADV_DONTNEED for our own buffered writes (the session tier's fallback).
+
+Same bits: the scratch (``sparse``) gives each call the same shapes, strides, alignment and values; a trim or a
+different admission changes addresses and scheduling only (``torch.cuda.graph`` already empties the cache at every
+capture; batched == alone). See docs/MEMORY-SAFETY.md for the proofs and the GPU plan.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+from dataclasses import dataclass, field
+
+KiB = 1 << 10
+MiB = 1 << 20
+GiB = 1 << 30
+
+POOL = 4                 # sparse.POOL
+TOPK_POOLS = 512         # sparse.TOPK_POOLS
+BRB = 16                 # sparse.BRB
+MIN_BUCKET = 1024        # sparse.MIN_BUCKET
+SEGMENT_ROUND = 2 * MiB  # torch's caching allocator: large segments rounded up to 2 MiB (kRoundLarge)
+LARGE_MIN = 10 * MiB     # below this a large request takes a 20 MiB segment (kMinLargeAlloc / kLargeBuffer)
+LARGE_BUFFER = 20 * MiB
+SMALL_MAX = 1 * MiB      # kSmallSize: requests up to this share 2 MiB small segments
+
+
+def _env_float(name: str, default: float, least: float = 0.0) -> float:
+    raw = os.environ.get(name, "").strip()
+    try:
+        v = float(raw) if raw else float(default)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+    if v < least:
+        raise ValueError(f"{name}={v:g}: expected >= {least:g}")
+    return v
+
+
+# -- settings ---------------------------------------------------------------------------------------------------------
+ADMIT_POLICIES = ("available", "free")
+
+
+def admit_policy() -> str:
+    """GLM53_TF_ADMIT_MEM: ``available`` (default: reclaimable page cache counts, with the margins below) or ``free``
+    (CUDA free + allocator cache only: the rule before 0550)."""
+
+    v = os.environ.get("GLM53_TF_ADMIT_MEM", "").strip().lower() or "available"
+    if v not in ADMIT_POLICIES:
+        raise ValueError(f"GLM53_TF_ADMIT_MEM={v!r}: expected available or free")
+    return v
+
+
+def cache_keep_bytes() -> int:
+    """GLM53_TF_ADMIT_CACHE_KEEP_GB (default 2): page cache never counted as available (at least Mapped is kept)."""
+
+    return int(_env_float("GLM53_TF_ADMIT_CACHE_KEEP_GB", 2.0) * GiB)
+
+
+def free_floor_bytes() -> int:
+    """GLM53_TF_ADMIT_FREE_FLOOR_GB (default 1): least immediately free memory (CUDA free + allocator cache) for an
+    admission beside running requests, whatever the page cache (the first chunk's buffers are allocated at once)."""
+
+    return int(_env_float("GLM53_TF_ADMIT_FREE_FLOOR_GB", 1.0) * GiB)
+
+
+def trim_bytes() -> int:
+    """GLM53_TF_ALLOC_TRIM_GB (default 2; 0 off): the allocator's unused cache that triggers ``empty_cache`` after a
+    prefill piece."""
+
+    return int(_env_float("GLM53_TF_ALLOC_TRIM_GB", 2.0) * GiB)
+
+
+def drop_own_cache() -> bool:
+    """GLM53_TF_DROP_OWN_CACHE (default 1): our own buffered file writes leave no page cache behind."""
+
+    return os.environ.get("GLM53_TF_DROP_OWN_CACHE", "1").strip().lower() not in ("0", "off", "no", "false")
+
+
+# -- /proc/meminfo ------------------------------------------------------------------------------------------------------
+MEMINFO_KEYS = ("MemTotal", "MemFree", "MemAvailable", "Cached", "Dirty", "Writeback", "Mapped", "Shmem",
+                "AnonPages")
+
+
+def parse_meminfo(text: str) -> dict[str, int]:
+    """``/proc/meminfo`` text -> bytes for the keys this module reads (kB lines; others ignored)."""
+
+    out: dict[str, int] = {}
+    for line in text.splitlines():
+        k, sep, v = line.partition(":")
+        if not sep or k not in MEMINFO_KEYS:
+            continue
+        parts = v.split()
+        if not parts:
+            continue
+        n = int(parts[0])
+        out[k] = n * KiB if len(parts) > 1 and parts[1] == "kB" else n
+    return out
+
+
+def read_meminfo(path: str = "/proc/meminfo") -> dict[str, int]:
+    try:
+        with open(path) as f:
+            return parse_meminfo(f.read())
+    except OSError:
+        return {}
+
+
+def page_cache_credit(mi: dict[str, int], keep: int | None = None) -> int:
+    """Page cache the kernel can hand to a device allocation now: MemAvailable - MemFree (clean file pages and
+    reclaimable slab the kernel counts as available) less what cannot go at once (Dirty, Writeback) and less the
+    working set we never count (max(Mapped, ``keep``)). 0 without meminfo."""
+
+    if "MemAvailable" not in mi or "MemFree" not in mi:
+        return 0
+    keep = cache_keep_bytes() if keep is None else int(keep)
+    extra = mi["MemAvailable"] - mi["MemFree"]
+    extra -= mi.get("Dirty", 0) + mi.get("Writeback", 0)
+    extra -= max(mi.get("Mapped", 0), keep)
+    return max(0, int(extra))
+
+
+@dataclass
+class MemView:
+    """One reading: CUDA free (``cudaMemGetInfo``), the allocator's cached-but-unused bytes, the page cache credit."""
+
+    cuda_free: int
+    cached: int
+    credit: int
+    policy: str = "available"
+    meminfo: dict = field(default_factory=dict)
+
+    @property
+    def now(self) -> int:
+        """Allocatable without reclaiming anything."""
+
+        return int(self.cuda_free) + int(self.cached)
+
+    @property
+    def usable(self) -> int:
+        return self.now + (int(self.credit) if self.policy == "available" else 0)
+
+    def describe(self) -> str:
+        s = f"free {self.cuda_free / GiB:.2f} + allocator cache {self.cached / GiB:.2f}"
+        if self.policy == "available":
+            s += f" + page cache credit {self.credit / GiB:.2f}"
+            mi = self.meminfo
+            if mi:
+                s += (f" (MemAvailable {mi.get('MemAvailable', 0) / GiB:.2f}, MemFree {mi.get('MemFree', 0) / GiB:.2f}, "
+                      f"Dirty+Writeback {(mi.get('Dirty', 0) + mi.get('Writeback', 0)) / GiB:.2f}, Mapped "
+                      f"{mi.get('Mapped', 0) / GiB:.2f})")
+        return s + f" = {self.usable / GiB:.2f} GiB"
+
+
+def view(cuda_free: int, cached: int, policy: str | None = None, mi: dict | None = None,
+         keep: int | None = None) -> MemView:
+    policy = admit_policy() if policy is None else policy
+    if policy == "available":
+        mi = read_meminfo() if mi is None else mi
+        credit = page_cache_credit(mi, keep)
+    else:
+        mi, credit = mi or {}, 0
+    return MemView(int(cuda_free), max(0, int(cached)), credit, policy, mi)
+
+
+def admit_ok(v: MemView, headroom: int, need: int, floor: int | None = None) -> bool:
+    """Admission beside running requests: what may be used, less the session store's unused budget, covers ``need``
+    (``GLM53_TF_BATCH_ADMIT_GB`` + the prompt's predicted scratch growth), and something is free right now."""
+
+    floor = free_floor_bytes() if floor is None else int(floor)
+    if v.policy == "free":
+        floor = 0                                # the old rule exactly
+    return v.usable - max(0, int(headroom)) >= int(need) and v.now >= floor
+
+
+class AdmitLog:
+    """Rank 0: a line when admission starts waiting for memory (then every ``every`` s while it waits), one when a
+    request is admitted again; counts the waits."""
+
+    def __init__(self, every: float = 30.0, out=None) -> None:
+        self.every = every
+        self.out = out
+        self.since: float | None = None
+        self.last = 0.0
+        self.waits = 0
+        self.episodes = 0
+
+    def _print(self, msg: str) -> None:
+        print(msg, file=self.out or sys.stdout, flush=True)
+
+    def waiting(self, v: MemView, headroom: int, need: int, queued: int, now: float | None = None) -> None:
+        now = time.monotonic() if now is None else now
+        self.waits += 1
+        if self.since is None or now - self.last >= self.every:
+            if self.since is None:
+                self.since = now
+                self.episodes += 1
+            self.last = now
+            self._print(f"[tensorfold] admission waits for memory ({queued} queued): usable {v.describe()}, less the "
+                        f"session store's unused {max(0, headroom) / GiB:.2f} GiB, is under {need / GiB:.2f} GiB "
+                        f"(GLM53_TF_BATCH_ADMIT_GB + scratch), or free now {v.now / GiB:.2f} GiB is under the floor"
+                        + (f"; waiting {now - self.since:.0f} s" if now > self.since else ""))
+
+    def admitted(self, now: float | None = None) -> None:
+        if self.since is None:
+            return
+        now = time.monotonic() if now is None else now
+        self._print(f"[tensorfold] admission resumed after {now - self.since:.1f} s waiting for memory")
+        self.since = None
+
+
+# -- the allocator's unused cache ------------------------------------------------------------------------------------
+class Trimmer:
+    """``empty_cache`` when the allocator holds more than ``limit`` bytes it does not use, at most once every
+    ``interval`` seconds (``GLM53_TF_ALLOC_TRIM_S``, default 10: re-allocating a piece's buffers after a trim costs
+    milliseconds, so a trim cannot cost more than a fraction of a percent). A trim that frees under ``min_gain``
+    (memory of live graph pools cannot be freed) raises the trigger to what stayed + ``limit``; a later trim that frees
+    enough brings it back down. Local to a rank (no collective)."""
+
+    def __init__(self, limit: int | None = None, min_gain: int = 256 * MiB, interval: float | None = None) -> None:
+        self.limit = trim_bytes() if limit is None else int(limit)
+        self.min_gain = int(min_gain)
+        self.interval = _env_float("GLM53_TF_ALLOC_TRIM_S", 10.0) if interval is None else float(interval)
+        self.trigger = self.limit
+        self.trims = 0
+        self.freed = 0
+        self.last = float("-inf")
+
+    def maybe(self, reserved: int, allocated: int, empty_cache, after=None, now: float | None = None) -> int:
+        """-> bytes freed (0 when nothing was done). ``after()`` -> (reserved, allocated) after the trim."""
+
+        if self.limit <= 0:
+            return 0
+        unused = int(reserved) - int(allocated)
+        if unused <= self.trigger:
+            return 0
+        now = time.monotonic() if now is None else now
+        if now - self.last < self.interval:
+            return 0
+        self.last = now
+        empty_cache()
+        r2, a2 = after() if after is not None else (allocated, allocated)
+        gain = max(0, int(reserved) - int(r2))
+        left = max(0, int(r2) - int(a2))
+        self.trims += 1
+        self.freed += gain
+        self.trigger = self.limit if gain >= self.min_gain else max(self.limit, left + self.limit)
+        return gain
+
+
+def trim_torch(trimmer: "Trimmer | None") -> int:
+    """``Trimmer.maybe`` on the current CUDA device (0 without CUDA or while a graph is being captured)."""
+
+    if trimmer is None or trimmer.limit <= 0:
+        return 0
+    import torch
+
+    if not torch.cuda.is_available() or torch.cuda.is_current_stream_capturing():
+        return 0
+    return trimmer.maybe(torch.cuda.memory_reserved(), torch.cuda.memory_allocated(), torch.cuda.empty_cache,
+                         lambda: (torch.cuda.memory_reserved(), torch.cuda.memory_allocated()))
+
+
+# -- the selection's sizes (patches/0065 blocked selection, patches/0050 pool buckets) ------------------------------
+def pool_bucket(end: int, cap_pools: int) -> int:
+    """``sparse.pool_bucket``."""
+
+    need = end // POOL
+    if need > cap_pools:
+        raise ValueError(f"pool_bucket: {need} pools past the cache's {cap_pools}")
+    b = MIN_BUCKET
+    while b < need:
+        b *= 2
+    return min(b, cap_pools)
+
+
+def block_rows(R: int, np_max: int, select_mb: int = 256) -> int:
+    """``sparse.block_rows``."""
+
+    rows = (select_mb << 20) // (4 * max(np_max, 1))
+    return max(BRB, min(R, rows) // BRB * BRB)
+
+
+def select_blocks(pos: int, R: int, cap_pools: int, select_mb: int = 256, bound: bool = True) -> list[int]:
+    """Bytes of each int32 key block one blocked selection of rows pos .. pos + R - 1 allocates, in order
+    (``sparse.select_pools_blocked`` with ``np_max`` as ``latent._attend`` passes it: the pool bucket with
+    patches/0050's bound, else the cache's pools)."""
+
+    np_max = pool_bucket(pos + R, cap_pools) if bound else cap_pools
+    step = block_rows(R, np_max, select_mb)
+    out = []
+    for r0 in range(0, R, step):
+        n = min(step, R - r0)
+        need_np = (pos + r0 + n) // POOL
+        npc = min(np_max, max(TOPK_POOLS, -(-need_np // 64) * 64))
+        out.append(n * npc * 4)
+    return out
+
+
+def _round512(n: int) -> int:
+    return max(512, -(-int(n) // 512) * 512)
+
+
+def segment_size(n: int) -> int:
+    """The segment torch's caching allocator makes for a request of ``n`` bytes it cannot place in its cache."""
+
+    n = _round512(n)
+    if n <= SMALL_MAX:
+        return 2 * MiB
+    if n < LARGE_MIN:
+        return LARGE_BUFFER
+    return -(-n // SEGMENT_ROUND) * SEGMENT_ROUND
+
+
+def keys_growth(p0: int, p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256,
+                dense_limit: int = 2051, cached: tuple[int, ...] = ()) -> tuple[int, int]:
+    """The caching allocator's reserved growth from the key blocks of a prefill of positions p0 .. p1 - 1 in calls of
+    ``R`` rows (a fast chunk's sub-blocks; every DSA layer allocates the same sizes, so one layer stands for all), and
+    the largest block. Upper bound: a request reuses a cached free segment of at least its size (the smallest one;
+    freed blocks merge back into their segment) and otherwise takes a new segment, which stays cached; other
+    allocations never take these segments. ``cached``: free segment sizes already in the cache when it starts.
+    Rows before ``dense_limit`` select nothing. -> (bytes of new segments, largest block)."""
+
+    free = sorted(int(c) for c in cached)
+    grown = peak = 0
+    for s in _blocks(p0, p1, R, cap_pools, select_mb, dense_limit):
+        peak = max(peak, s)
+        if not free or free[-1] < _round512(s):       # no cached segment holds it: a new one, kept afterwards
+            seg = segment_size(s)
+            grown += seg
+            free.append(seg)
+            free.sort()
+    return grown, peak
+
+
+def _blocks(p0: int, p1: int, R: int, cap_pools: int, select_mb: int, dense_limit: int = 2051):
+    """Every key block (bytes) of a prefill of positions p0 .. p1 - 1 in calls of ``R`` rows, in order."""
+
+    p = p0
+    while p < p1:
+        r = min(R, p1 - p)
+        if p + r - 1 >= dense_limit:
+            yield from select_blocks(p, r, cap_pools, select_mb)
+        p += r
+
+
+def select_peak_scan(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, p0: int = 0) -> int:
+    """``select_peak`` by visiting every call (tests)."""
+
+    return max(_blocks(p0, p1, R, cap_pools, select_mb), default=0)
+
+
+def select_peak(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, p0: int = 0,
+                dense_limit: int = 2051) -> int:
+    """The largest key block a prefill of positions p0 .. p1 - 1 in calls of ``R`` rows allocates (<= ``select_mb``
+    MiB). Within one pool bucket a call's row blocks keep their rows and their pools only grow with the position, so
+    the largest block is in the last call of a bucket: only those (at most ~10) and the prefill's last call are sized
+    (admission runs this every round a long prompt waits)."""
+
+    if p1 <= p0:
+        return 0
+    starts = {p0 + (p1 - p0 - 1) // R * R}                      # the last call (maybe partial) ...
+    if p1 - p0 >= R:
+        starts.add(p0 + ((p1 - p0) // R - 1) * R)               # ... and the last full one
+    b = MIN_BUCKET
+    while True:
+        e = p0 + (4 * b + 3 - p0) // R * R                       # the last full call ending at or before 4b + 3
+        if p0 < e <= p1:
+            starts.add(e - R)
+        if b >= cap_pools or 4 * b > p1:
+            break
+        b *= 2
+    peak = 0
+    for p in starts:
+        r = min(R, p1 - p)
+        if p + r - 1 >= dense_limit:
+            peak = max(peak, *select_blocks(p, r, cap_pools, select_mb))
+    return peak
+
+
+SCRATCH_MIN = 16 * MiB      # the scratch's least size (a 16-row verify window's block at a 1M cache fits)
+SCRATCH_STEP = 16 * MiB     # it grows to the need rounded up to this (at most 16 growths to 256 MiB)
+
+
+def scratch_grow_to(need: int, have: int, most: int) -> int:
+    """``sparse``'s grow policy: the scratch's new size (bytes) for blocks of up to ``need`` bytes when it holds
+    ``have``: ``need`` rounded up to ``SCRATCH_STEP``, at least ``SCRATCH_MIN``, at most ``most`` rounded up (never
+    below ``need``); unchanged when it already holds ``need``. The old buffer is released when it grows (and the
+    allocator's cache emptied), so growing in steps leaves nothing behind."""
+
+    if need <= have:
+        return have
+    new = max(-(-need // SCRATCH_STEP) * SCRATCH_STEP, SCRATCH_MIN)
+    top = max(-(-most // SEGMENT_ROUND) * SEGMENT_ROUND, -(-need // SEGMENT_ROUND) * SEGMENT_ROUND)
+    return max(have, min(new, top))
+
+
+def scratch_bytes(p1: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256, have: int = 0,
+                  mode: str = "grow", p0: int = 0) -> int:
+    """What the scratch holds after a prefill of positions p0 .. p1 - 1 that reserved for itself first (``have``
+    before it): ``grow`` holds its largest block rounded up (``scratch_grow_to``), ``max`` ``select_mb`` from the
+    first use, ``off`` nothing."""
+
+    if mode == "off":
+        return 0
+    need = select_peak(p1, R, cap_pools, select_mb, p0)
+    if need <= have:
+        return have
+    most = select_mb << 20
+    return scratch_grow_to(max(need, most) if mode == "max" else need, have, most)
+
+
+def scratch_growth(p1: int, have: int, R: int = 512, cap_pools: int = 262_148, select_mb: int = 256,
+                   mode: str = "grow") -> int:
+    """Admission's reservation for the scratch: how much it still grows for a prompt of ``p1`` tokens."""
+
+    return max(0, scratch_bytes(p1, R, cap_pools, select_mb, have, mode) - have)
+
+
+# -- our own files ------------------------------------------------------------------------------------------------------
+def drop_file_cache(fd: int, off: int = 0, length: int = 0, sync: bool = True) -> bool:
+    """Our buffered writes out of the page cache (written back first: DONTNEED leaves dirty pages). -> done."""
+
+    if not drop_own_cache() or not hasattr(os, "posix_fadvise"):
+        return False
+    try:
+        if sync:
+            os.fdatasync(fd)
+        os.posix_fadvise(fd, off, length, os.POSIX_FADV_DONTNEED)
+        return True
+    except OSError:
+        return False
