+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G17 ``TF_DSV41_FULL_CONE`` (``cone.py``): full-mode prefill with the decoder over its dependency cone only, on the
+CPU twin (a synthetic checkpoint: decoder = layers 4-7, DSpark taps 5-7, SWA window 16, so CONE = 16 + 15 x 3 = 61).
+
+The claim is bit identity with ``TF_DSV41_PREFILL=full``: the first verify rows' logits, the slot's whole state
+(every ring, compressed rows, index keys, carries, the DSpark context rows) at the prompt's end and in its prompt
+snapshot, served replies (fresh, resumed, turn 2, batched), drafted == serial, two ranks, fast prefill kernels; and
+that the decoder really skipped the rows before r0 (garbage there changes nothing; a cone one grid step short does).
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import cone as CO  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import replay as RP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.sessions import Store, Tag, snapshot_point  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+WIN = 16
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=WIN, rms_norm_eps=1e-20)
+LONG = [int(t) for t in np.random.default_rng(17).integers(3, 256, size=200)]
+FULL = Tag(ced="full").code()
+
+
+@pytest.fixture(autouse=True)
+def _cone_env(monkeypatch):
+    monkeypatch.delenv(CO.ENV, raising=False)
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41cone"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def build(ck, pchunk: int = 64, slots: int = 1, rank: int = 0, world: int = 1, comm=None) -> SlotsForward:
+    root, cfg, table, _ = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return SlotsForward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=1024,
+                        chunk=8, pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots)
+
+
+def prompt(fw, ids, cuts=None, slot: int = 0, cone: bool = False, garbage: bool = False,
+           shift: int = 0) -> torch.Tensor:
+    """Full mode: prefill ids[:-1] in pieces ending at ``cuts`` (with ``cone``: the decoder from ``cone.start`` on,
+    + ``shift`` rows), then the last token and two more as verify rows: their logits."""
+
+    n = len(ids)
+    if cone:
+        r0 = CO.start(fw.cfg, n, 0)
+        assert r0 is not None
+        fw.cones[slot] = r0 + shift
+    if garbage:                                 # decoder rings: noise (the cone writes every row it reads)
+        d = RP.decoder_start(fw.cfg)
+        g = torch.Generator().manual_seed(5)
+        for L, ring in fw.slots[slot].swa.items():
+            if L >= d:
+                ring.values.copy_(torch.randint(0, 120, ring.values.shape, generator=g, dtype=torch.uint8))
+    a = 0
+    for b in list(cuts or []) + [n - 1]:
+        fw.prefill([Piece(slot, a, tuple(ids[a:b]))], mode="full")
+        a = b
+    fw.finish_prompt(slot, n - 1, tuple(ids[max(0, n - RP.REPLAY):n - 1]), mode="full")
+    return torch.cat([fw.step([ids[-1]], slot=slot), fw.step([11], slot=slot), fw.step([12], slot=slot)])
+
+
+def state(fw, slot: int = 0) -> dict:
+    """The slot's whole state: every ring's last window rows, compressed rows, index keys, carries."""
+
+    s = fw.slots[slot]
+    out = {}
+    pos = torch.arange(max(0, s.pos - fw.cfg.sliding_window), s.pos)
+    for L, ring in s.swa.items():
+        out[f"ring.{L}"] = ring.values[pos % ring.values.shape[0]].clone()
+    for L, st in s.comp.items():
+        n = (s.pos + 1) // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    for L, c in s.carry.items():
+        out[f"carry.{L}"] = c.clone()
+    return out
+
+
+def same_state(a: dict, b: dict) -> None:
+    assert set(a) == set(b)
+    for k in a:
+        assert torch.equal(a[k], b[k]), k
+
+
+# -- the bound -----------------------------------------------------------------------------------------------------
+def test_span_and_start(ck):
+    cfg = ck[1]
+    assert RP.decoder_start(cfg) == 4 and tuple(cfg.aux_layer_ids) == (5, 6, 7)
+    assert CO.span(cfg) == WIN + (WIN - 1) * 3 == 61
+    assert CO.start(cfg, 200) == (snapshot_point(200) - 61) // 16 * 16 == 128
+    assert CO.start(cfg, 60) is None                    # short: the plain full prefill
+    assert CO.start(cfg, 200, cached=144) is None       # a resume past r0: the restored rings carry it
+    assert CO.start(cfg, 200, cached=96) == 128
+
+
+def test_span_of_the_real_model():
+    """V4.1-Flash: 40 layers, decoder from layer 20 (the first ratio-1 layer), window 128, taps 37-39: 2,541."""
+
+    class C:
+        num_hidden_layers, sliding_window, aux_layer_ids = 40, 128, (37, 38, 39)
+
+        @staticmethod
+        def compress_ratio(i):
+            return 2 if i < 20 else 1
+
+        @staticmethod
+        def is_kv_source(i):
+            return i in (2, 8, 14, 20)
+
+    assert CO.span(C) == 2541
+    assert CO.start(C, 32768) == (32752 - 2541) // 16 * 16 == 30208
+
+
+def test_knob_parse(monkeypatch):
+    assert not CO.enabled()
+    monkeypatch.setenv(CO.ENV, "1")
+    assert CO.enabled()
+    monkeypatch.setenv(CO.ENV, "2")
+    with pytest.raises(ValueError):
+        CO.enabled()
+
+
+def test_kinds():
+    assert CO.kind(0, 64, None, WIN) == "full"
+    assert CO.kind(0, 64, 128, WIN) == "enc" and CO.kind(64, 64, 128, WIN) == "enc"
+    assert CO.kind(96, 64, 128, WIN) == "split"         # crosses r0
+    assert CO.kind(128, 64, 128, WIN) == "split"        # starts at r0: windows reach below it
+    assert CO.kind(128 + WIN - 2, 8, 128, WIN) == "split"
+    assert CO.kind(128 + WIN - 1, 8, 128, WIN) == "full"
+
+
+# -- bit identity with full mode -----------------------------------------------------------------------------------
+@pytest.mark.parametrize("cuts,pchunk", [([], 256), ([], 64), ([128], 32), ([16, 136, 150], 64), ([96, 192], 48)])
+def test_cone_equals_full(ck, cuts, pchunk):
+    a, b = build(ck, pchunk=pchunk), build(ck, pchunk=pchunk)
+    want = prompt(a, LONG, cuts=cuts)
+    got = prompt(b, LONG, cuts=cuts, cone=True)
+    assert torch.equal(got, want)
+    same_state(state(b), state(a))
+
+
+def test_cone_skips_the_rows_before_r0(ck):
+    """Decoder rings full of noise before the prompt: the same logits (every ring row read was written by the
+    cone); the decoder's own rows before r0 are never computed, and a cone one grid step short differs."""
+
+    want = prompt(build(ck), LONG)
+    assert torch.equal(prompt(build(ck), LONG, cone=True, garbage=True), want)
+    assert not torch.equal(prompt(build(ck), LONG, cone=True, shift=16), want)
+
+
+def test_cone_snapshot_is_full_modes(ck):
+    """The prompt snapshot at S = 192 (taken mid-prompt by the batcher): the same arrays as full mode's."""
+
+    snaps = []
+    for cone in (False, True):
+        fw = build(ck)
+        if cone:
+            fw.cones[0] = CO.start(fw.cfg, len(LONG), 0)
+        fw.prefill([Piece(0, 0, tuple(LONG[:192]))], mode="full")
+        snaps.append(fw.snapshot(0))
+    a, b = snaps
+    assert a.meta == b.meta and a.pos == b.pos == 192
+    assert set(a.arrays) == set(b.arrays)
+    for k in a.arrays:
+        assert np.array_equal(a.arrays[k], b.arrays[k]), k
+
+
+def test_cone_with_fast_prefill_kernels(ck, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    want = prompt(build(ck, pchunk=256), LONG)
+    assert torch.equal(prompt(build(ck, pchunk=32), LONG, cuts=[150], cone=True), want)
+
+
+def test_cone_two_ranks_agree(ck):
+    def pair_run(cone):
+        pair = FK.ThreadPair()
+        comms = pair.comms()
+        fws = [build(ck, rank=r, world=2, comm=comms[r]) for r in range(2)]
+        return pair.run([lambda f=f: prompt(f, LONG, cone=cone) for f in fws])
+
+    got, want = pair_run(True), pair_run(False)
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+
+
+# -- serving -------------------------------------------------------------------------------------------------------
+def batcher(ck, fw, store=None) -> Batcher:
+    pool = Pool(ck[3], 4096)
+    st = Store(pool, ram_bytes=1 << 30) if store is True else store
+    return Batcher(fw, pool, n_slots=len(fw.slots), capacity=1024, store=st, mode="full", tag=FULL,
+                   prefill_rows=64, depth=0, session_min=16, start=False)
+
+
+def run(b: Batcher, jobs) -> list[list[int]]:
+    for j in jobs:
+        b.submit(j)
+    for _ in range(10000):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while (item := j.out.get_nowait()) is not None:
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out
+
+
+def test_serving_cone_equals_full(ck, monkeypatch):
+    """Fresh, an identical resend (resumes at the prompt snapshot), turn 2 (resumes there, prefills the reply and
+    the new tokens), batched beside a second prompt: every reply == full mode's, and the stored entries hold the
+    same arrays."""
+
+    def go():
+        b = batcher(ck, build(ck, slots=2), store=True)
+        r1 = run(b, [Job(list(LONG), 6, None)])[0]
+        again = run(b, [Job(list(LONG), 6, None)])[0]
+        turn2 = LONG + r1 + [5, 6, 7]
+        t2 = run(b, [Job(list(turn2), 6, None)])[0]
+        both = run(b, [Job(list(LONG[5:]), 6, None), Job(list(turn2[3:]), 6, None)])
+        ents = {k: (e.kind, e.tokens if hasattr(e, "tokens") else None) for k, e in b.store.entries.items()}
+        return [r1, again, t2, *both], ents, b
+
+    want, ents_full, _ = go()
+    monkeypatch.setenv(CO.ENV, "1")
+    got, ents_cone, b = go()
+    assert got == want
+    assert ents_cone.keys() == ents_full.keys()
+    assert b.ex.fwd.cones == {}                         # dropped once each prompt's prefill is done
+    cs = b.ex.fwd.cone_stats                            # the cone ran: rows before r0 skipped the decoder
+    assert cs["enc"] > 0 and cs["split"] > 0 and cs["decoder_rows"] < cs["enc"] + cs["split"] + cs["full"]
+
+
+def test_serving_cone_batched_equals_alone(ck, monkeypatch):
+    monkeypatch.setenv(CO.ENV, "1")
+    ps = [LONG, LONG[7:190], LONG[:90]]
+    allp = run(batcher(ck, build(ck, slots=3)), [Job(list(p), 4, None) for p in ps])
+    monkeypatch.delenv(CO.ENV)
+    for p, got in zip(ps, allp):
+        assert got == run(batcher(ck, build(ck)), [Job(list(p), 4, None)])[0]
+
+
+def test_cone_drafted_equals_serial_and_drafter_state(tmp_path, monkeypatch):
+    """DSpark over a coned prompt: drafted == serial (T = 0 and T > 0), the drafter proposed something, the replies
+    == full mode's, and the drafter's context rows (its snapshot arrays) == full mode's."""
+
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.engine.exact_sampling import Sampling
+
+    ck2 = DF.ckpt(tmp_path / "dsp", sliding_window=WIN)
+    prompts = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 250, size=180 + 9 * i)] for i in range(2)]
+    samplings = [None, Sampling(seed=4, temperature=0.8, top_k=20, top_p=0.95)]
+
+    def go(depth):
+        fw = DF.forward(ck2, slots=2)
+        pool = Pool(ck2[3], 4096)
+        b = Batcher(fw, pool, n_slots=2, capacity=1024, store=None, mode="full", tag=FULL, prefill_rows=64,
+                    depth=depth, session_min=16, start=False)
+        jobs = [Job(list(p), 24, s) for p, s in zip(prompts, samplings)]
+        return run(b, jobs), jobs
+
+    def drafter_state(cone: bool) -> dict:
+        fw = DF.forward(ck2, slots=1)
+        p = prompts[0]
+        if cone:
+            fw.cones[0] = CO.start(fw.cfg, len(p), 0)
+        fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+        return {k: v for k, v in fw.snapshot(0).arrays.items()}
+
+    full_serial, _ = go(0)
+    full_drafted, _ = go(None)
+    monkeypatch.setenv(CO.ENV, "1")
+    serial, _ = go(0)
+    drafted, jobs = go(None)
+    assert serial == full_serial and drafted == full_drafted and drafted == serial
+    assert sum(j.stats["drafting"]["dspark_rounds"] for j in jobs) > 0
+    a, b = drafter_state(False), drafter_state(True)
+    assert any(k.startswith("dspark") for k in a) and set(a) == set(b)
+    for k in a:
+        assert np.array_equal(a[k], b[k]), k
