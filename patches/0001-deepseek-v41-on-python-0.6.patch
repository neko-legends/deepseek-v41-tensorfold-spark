+        assert PR.rule_for(drf, cfg) == cfg["draft"]
+        assert PR.rule_for(tgt, {**cfg, "prefill": True}) == cfg["target"]
+    assert not PR.in_prefill()
+    assert PR.rule_for(tgt, PR.parse({})) is None
+    assert PR.rule_for(drf, PR.parse({"TF_DSV41_DRAFT_EXPERT_TOPP": "0.8", "TF_DSV41_DRAFT_EXPERT_MIN_K": "3"})) is None
