+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The decode-speed paths of the V4.1 serving layer on the CPU (G4's changes; the GPU side is
+``tests/cuda/test_dsv41_m2_gpu.py``):
+
+- a round over several decoding slots is one DSpark pass and one verify forward over every slot's window (one
+  expert pass, one set of exchanges), never a window a slot;
+- the buffers a CUDA graph captures keep their addresses: every slot's ratio-2 carries through prefill, verify,
+  commit, snapshot / restore and reset; the graphs' fingerprint sees a moved buffer and drops the graphs; the memory
+  floor stops captures (both ranks), keeping the held graphs; the warm-up sets;
+- the Engram prefetch: row-level reads (parallel extents, cache, in flight) give the shard's rows bit for bit; the
+  pending row issued at commit is not read again; the hasher is called once a window; the lazy per-layer inputs
+  equal the eager ones;
+- the phase timers.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF
+import dsv41_fakes as FK
+
+from tensorfold.engine.exact_sampling import Sampling
+from tensorfold.families.deepseek_v41.cuda import graphs as G
+from tensorfold.families.deepseek_v41.cuda import phases
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF
+from tensorfold.families.deepseek_v41.cuda.batch import Job
+from tensorfold.families.deepseek_v41.cuda.forward import Forward, Seg
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+PROMPTS = [[int(t) for t in np.random.default_rng(60 + i).integers(3, 250, size=40 + 7 * i)] for i in range(4)]
+SAMPLINGS = [None, Sampling(seed=3, temperature=0.8, top_k=20, top_p=0.95), None,
+             Sampling(seed=9, temperature=0.7, top_k=0, top_p=0.9)]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41perf"))
+
+
+# -- one window a round ------------------------------------------------------------------------------------------
+def test_one_verify_window_and_one_draft_pass_per_round(ck):
+    fw = DF.forward(ck, slots=4)
+    calls = []
+    for name in ("window", "draft"):
+        real = getattr(fw, name)
+
+        def rec(*a, real=real, name=name, **k):
+            calls.append((name, a))
+            return real(*a, **k)
+
+        setattr(fw, name, rec)
+    b = DF.batcher(ck, fw, n=4)
+    for p, s in zip(PROMPTS, SAMPLINGS):
+        b.submit(Job(list(p), 10, s))
+    rounds = []
+    while True:
+        calls.clear()
+        if not b.step():
+            break
+        rounds.append([(n, len(a[0])) for n, a in calls])
+    decoding = [r for r in rounds if any(n == "window" for n, _ in r)]
+    assert decoding and all(sum(1 for n, _ in r if n == "window") == 1 for r in decoding)
+    assert all(sum(1 for n, _ in r if n == "draft") <= 1 for r in rounds)
+    assert max(w for r in decoding for n, w in r if n == "window") == 4      # every slot's window in one forward
+    assert max(w for r in rounds for n, w in r if n == "draft") == 4         # every slot's drafts in one pass
+
+
+# -- addresses a graph captures ------------------------------------------------------------------------------------
+def _carry_ptrs(fw):
+    return [(i, L, c.data_ptr()) for i, s in enumerate(fw.slots) for L, c in sorted(s.carry.items())]
+
+
+def test_carries_keep_their_addresses(ck):
+    fw = DF.forward(ck, slots=2, dspark=False)
+    b = DF.batcher(ck, fw, n=2)
+    ptrs = _carry_ptrs(fw)
+    assert ptrs
+    for s in range(2):
+        b.ex.slots[s].ensure(64)
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(PROMPTS[s][:33]))], mode="full")
+    assert _carry_ptrs(fw) == ptrs
+    from tensorfold.families.deepseek_v41.cuda.protocol import Rows
+
+    fw.window([Rows(0, 33, (5, 6, 7)), Rows(1, 33, (9,))], count=4)
+    fw.commit(0, 1)
+    fw.commit(1, 0)
+    assert _carry_ptrs(fw) == ptrs
+    snap = fw.snapshot(0)
+    want = {L: c.clone() for L, c in fw.slots[0].carry.items()}
+    fw.reset(0)
+    fw.restore(0, snap)
+    assert _carry_ptrs(fw) == ptrs
+    assert all(torch.equal(fw.slots[0].carry[L], t) for L, t in want.items())
