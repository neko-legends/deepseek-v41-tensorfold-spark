+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The vision tower on ONE GPU (``vision.Tower``, TF_DSV41_IMAGES=native): what the CPU tests cannot run.
+
+G15a: on 7954c1d every image failed on CUDA with "No available kernel" (``_sdpa`` gave the flash / memory-efficient
+kernels 3-D q / k / v; the CPU's SDPA took it). Here:
+
+- ``_sdpa`` on CUDA at a 1920x1080 screenshot's size (16 heads x 8,418 patches x 64, bf16): runs, its shape, finite,
+  close to the math path on a slice;
+- the tower at the real widths (1,024 / 16 heads / 2,816 / aligner 9,216 -> 5,120; 2 random layers) on real image
+  tensors from ``vision_prep`` (the server's processor: a drawn 1920x1080 screenshot and a 450x308 image): the span's
+  shape and dtype, finite, the delimiter rows in place, the same rows twice, and the activation peak far below an
+  N^2 score buffer (2.3 GB for 8,418 patches in bf16);
+- with the checkpoint (TF_DSV41_TEST_MODEL, default /model; skipped without its vision weights): ``Encoder.load``,
+  the same checks on the real 32 layers, and the rows against DeepSeek's reference ``inference/vision.py`` with the
+  same weights in bf16 (G15a: cosine ~0.999 a row; bits differ by kernel rounding). TF_DSV41_TEST_IMAGES: a folder of
+  more images (e.g. the release's carrots / corn).
+
+    pytest -q tests/cuda/test_dsv41_vision_gpu.py   (inside the image; ~1 min, ~2 GB of GPU memory)
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+PIL = pytest.importorskip("PIL")
+
+from tensorfold.families.deepseek_v41.cuda import vision as V
+from tensorfold.families.deepseek_v41.cuda import vision_prep as VP
+
+FIX = Path(__file__).resolve().parents[1] / "fixtures"
+VISION_CONFIG = {"model_type": "deepseek_v41_vision", "num_hidden_layers": 32, "hidden_size": 1024,
+                 "num_attention_heads": 16, "intermediate_size": 2816, "patch_size": 14, "rope_theta": 10000,
+                 "downsample_ratio": 3, "max_image_tokens": 1024, "min_pixels": 295936, "max_wh_ratio": None}
+DEV = torch.device("cuda", 0)
+
+
+def _ref():
+    spec = importlib.util.spec_from_file_location("dsv41_vision_ref", FIX / "dsv41_vision_ref.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _png(im) -> bytes:
+    buf = io.BytesIO()
+    im.save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def screenshot() -> bytes:
+    """A browser-preview screenshot, 1920x1080 (G15a's dashboard: banner, card, button, sidebar)."""
+
+    from PIL import Image, ImageDraw
+
+    im = Image.new("RGB", (1920, 1080), (246, 247, 249))
+    g = ImageDraw.Draw(im)
+    g.rectangle([0, 0, 1920, 72], fill=(30, 41, 59))
+    g.text((32, 18), "Acme Dashboard", fill=(255, 255, 255))
+    g.rectangle([0, 72, 280, 1080], fill=(226, 232, 240))
+    for i, s in enumerate(["Overview", "Orders", "Customers", "Settings"]):
+        g.text((32, 110 + 56 * i), s, fill=(30, 41, 59))
+    g.rectangle([320, 110, 1880, 180], fill=(254, 226, 226), outline=(220, 38, 38), width=3)
+    g.text((350, 128), "Error 503: Service Unavailable - the orders API did not respond", fill=(185, 28, 28))
+    g.rectangle([320, 220, 900, 460], fill=(255, 255, 255), outline=(203, 213, 225), width=2)
+    g.text((350, 320), "$12,480", fill=(15, 23, 42))
+    g.rectangle([1500, 220, 1840, 300], fill=(37, 99, 235))
+    g.text((1560, 242), "Export CSV", fill=(255, 255, 255))
+    return _png(im)
+
+
+def photo() -> bytes:
+    """450x308 (the release's corn.jpeg size): smooth gradients and a few shapes."""
+
+    from PIL import Image, ImageDraw
+
+    g = torch.Generator().manual_seed(7)
+    base = (torch.linspace(0, 1, 450)[None, :, None] * torch.tensor([200.0, 160.0, 40.0])
+            + torch.linspace(0, 1, 308)[:, None, None] * torch.tensor([30.0, 60.0, 120.0])
+            + torch.rand(308, 450, 3, generator=g) * 20).clamp(0, 255).to(torch.uint8)
+    im = Image.fromarray(base.numpy(), "RGB")
+    d = ImageDraw.Draw(im)
+    d.ellipse([60, 80, 200, 260], fill=(240, 200, 40))
+    d.rectangle([260, 40, 420, 120], fill=(40, 140, 60))
+    return _png(im)
+
+
+def images(s: VP.Settings) -> dict[str, VP.Prepared]:
+    out = {"screenshot": screenshot(), "photo": photo()}
+    extra = os.environ.get("TF_DSV41_TEST_IMAGES", "")
+    if extra and Path(extra).is_dir():
+        for p in sorted(Path(extra).iterdir()):
+            if p.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp"):
+                out[p.name] = p.read_bytes()
+    return {k: VP.preprocess(VP.decode(raw, s), s) for k, raw in out.items()}
+
+
+def settings(tmp_path: Path) -> VP.Settings:
+    (tmp_path / "config.json").write_text(json.dumps({"image_token_id": 129264, "vision_config": VISION_CONFIG}))
+    return VP.Settings.read(tmp_path, {})
+
+
+def check_span(rows: torch.Tensor, img: VP.Prepared, tower: V.Tower) -> None:
+    D = tower.t["image_start"].shape[0]
+    assert rows.shape == (img.tokens, D) == (VP.span_len(img.n_llm_h, img.n_llm_w), D)
+    assert rows.dtype == torch.bfloat16 and rows.device.type == "cuda"
+    assert rows.isfinite().all(), "non-finite span rows"
+    types = torch.tensor(img.types, device=rows.device)
+    assert torch.equal(rows[0], tower.t["image_start"].to(torch.bfloat16))
+    assert torch.equal(rows[-1], tower.t["image_end"].to(torch.bfloat16))
+    nl = rows[types == VP.IMAGE_NEW_LINE]
+    assert nl.shape[0] == img.n_llm_h and (nl == tower.t["image_newline"].to(torch.bfloat16)).all()
+    feats = rows[types == VP.IMAGE].float()
+    assert feats.shape[0] == img.n_llm_h * img.n_llm_w and feats.abs().amax(1).min() > 0     # no empty row
+
+
+# -- attention -------------------------------------------------------------------------------------------------------
+def test_sdpa_on_cuda_is_fused_and_4d():
+    g = torch.Generator(device=DEV).manual_seed(0)
+    q, k, v = (torch.randn(8418, 16, 64, generator=g, device=DEV, dtype=torch.bfloat16).transpose(0, 1)
+               for _ in range(3))                                   # [heads, n, hd] views, as ``Tower.vit`` passes
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    base = torch.cuda.memory_allocated()
+    o = V._sdpa(q, k, v)                                            # 7954c1d: RuntimeError "No available kernel"
+    torch.cuda.synchronize()
+    assert o.shape == q.shape == (16, 8418, 64) and o.dtype == torch.bfloat16 and o.isfinite().all()
+    assert torch.cuda.max_memory_allocated() - base < 256 << 20     # no [16, n, n] scores (2.3 GB)
+    n = 1024
+    want = torch.nn.functional.scaled_dot_product_attention(q[:, :n].float(), k[:, :n].float(), v[:, :n].float())
+    got = V._sdpa(q[:, :n], k[:, :n], v[:, :n]).float()
+    assert (got - want).abs().max() < 2e-2
+
+
+# -- the tower, real widths, random weights --------------------------------------------------------------------------
+@pytest.fixture(scope="module")
+def tower2():
+    R = _ref()
+    args = SimpleNamespace(vision_dim=1024, vision_n_heads=16, vision_inter_dim=2816, vision_n_layers=2,
+                           vision_patch_size=14, vision_rope_theta=10000.0, vision_downsample_ratio=3, dim=5120)
+    torch.manual_seed(0)
+    vit, al = R.ViT(args), R.Aligner(args)
+    t = {}
+    with torch.no_grad():
+        for pre, m in (("vision.", vit), ("aligner.", al)):
+            for name, p in m.state_dict().items():
+                w = torch.ones_like(p) if name.endswith("norm.weight") or "norm1" in name or "norm2" in name \
+                    else torch.randn_like(p) * 0.02
+                t[pre + name] = w.to(DEV, torch.bfloat16)
+    for name in ("image_start", "image_end", "image_newline"):
+        t[name] = torch.randn(5120, device=DEV).to(torch.bfloat16)
+    return V.Tower(t, layers=2, heads=16, ratio=3)
+
+
+def test_tower_spans_on_real_images(tower2, tmp_path):
+    s = settings(tmp_path)
+    imgs = images(s)
+    assert imgs["screenshot"].n_vit_h * imgs["screenshot"].n_vit_w > 8000          # the large case (8.4k patches)
+    for name, img in imgs.items():
+        torch.cuda.synchronize()
+        torch.cuda.reset_peak_memory_stats()
+        base = torch.cuda.memory_allocated()
+        rows = tower2.span(img)
+        torch.cuda.synchronize()
+        peak = torch.cuda.max_memory_allocated() - base
+        check_span(rows, img, tower2)
+        assert torch.equal(rows, tower2.span(img)), name                              # the same rows twice
+        assert peak < 1 << 30, f"{name}: {peak / 2**30:.2f} GiB of activations (an N^2 path?)"
+        print(f"[vision-gpu] {name}: vit {img.n_vit_h}x{img.n_vit_w} span {rows.shape[0]} peak "
+              f"{peak / 2**20:.0f} MiB")
+    enc = V.Encoder(tower2, cache_mb=64)
+    a, b = imgs["screenshot"], imgs["photo"]
+    a.vids = [VP.VBASE + i for i in range(a.tokens)]
+    b.vids = [VP.VBASE + a.tokens + i for i in range(b.tokens)]
+    table = enc.table([a, b])
+    assert table.rows.shape == (a.tokens + b.tokens, 5120) and table.keys == a.vids + b.vids
+    assert enc.last["images"] == 2 and enc.last["rows"] == a.tokens + b.tokens
+
+
+# -- the checkpoint's tower ------------------------------------------------------------------------------------------
+def _model() -> Path | None:
+    p = Path(os.environ.get("TF_DSV41_TEST_MODEL", "/model"))
+    if not (p / "config.json").is_file():
+        return None
+    idx = p / "model.safetensors.index.json"
+    if idx.is_file() and not any(n.startswith("vision.") for n in json.loads(idx.read_text())["weight_map"]):
+        return None
+    return p
+
+
+@pytest.mark.skipif(_model() is None, reason="TF_DSV41_TEST_MODEL: a checkpoint folder with the vision tower")
+def test_checkpoint_tower_matches_reference():
+    root = _model()
+    enc = V.Encoder.load(root, DEV)
+    tower = enc.tower
+    s = VP.Settings.read(root)
+    R = _ref()
+    vc = s.vision_config
+    args = SimpleNamespace(vision_dim=int(vc.get("hidden_size", 1024)),
+                           vision_n_heads=int(vc.get("num_attention_heads", 16)),
+                           vision_inter_dim=int(vc.get("intermediate_size", 2816)),
+                           vision_n_layers=int(vc.get("num_hidden_layers", 32)), vision_patch_size=s.patch,
+                           vision_rope_theta=float(vc.get("rope_theta", 10000.0)), vision_downsample_ratio=s.downsample,
+                           dim=tower.t["aligner.w2.weight"].shape[0])
+    with torch.device("meta"):
+        vit, al = R.ViT(args), R.Aligner(args)
+    vit = vit.to_empty(device=DEV).to(torch.bfloat16)
+    al = al.to_empty(device=DEV).to(torch.bfloat16)
+    vit.load_state_dict({k[len("vision."):]: v for k, v in tower.t.items() if k.startswith("vision.")}, strict=True)
+    al.load_state_dict({k[len("aligner."):]: v for k, v in tower.t.items() if k.startswith("aligner.")}, strict=True)
+    for name, img in images(s).items():
+        rows = tower.span(img)
+        check_span(rows, img, tower)
+        assert torch.equal(rows, tower.span(img)), name
+        with torch.inference_mode(), torch.device(DEV):            # the reference builds its RoPE on the default device
+            want = al(vit(img.patches.to(DEV, torch.bfloat16), img.n_vit_h, img.n_vit_w), img.n_vit_h, img.n_vit_w)
+        mine = rows[torch.tensor(img.types, device=DEV) == VP.IMAGE].float()
+        cos = torch.nn.functional.cosine_similarity(mine, want.float(), dim=1)
+        print(f"[vision-gpu] checkpoint {name}: span {rows.shape[0]} cos vs reference bf16 mean "
+              f"{float(cos.mean()):.5f} min {float(cos.min()):.4f}")
+        assert float(cos.mean()) > 0.995 and float(cos.min()) > 0.8, name
diff --git a/tests/cuda/test_dsv41_x3gm_gpu.py b/tests/cuda/test_dsv41_x3gm_gpu.py
new file mode 100644
index 0000000..3872251
--- /dev/null
+++ b/tests/cuda/test_dsv41_x3gm_gpu.py
@@ -0,0 +1,161 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``x3gm`` (TF_DSV41_FAST_EXPERTS=gm) on the GPU (window G6; collected only where PyTorch sees an NVIDIA GPU):
+
+- the decode (trellis words staged in shared memory, decoded into the mma A fragment) == ``format.unpack`` bit for
+  bit at 2 / 3 / 4 bits; the input rotation == upstream ``rot_in`` bit for bit;
+- the routed experts vs float64 (``format.dequantize``) and vs upstream's grouped kernels (the decode path) within
+  tolerance, with a popular expert (several 64-member passes), one or two rotated inputs, 2- and 3-bit widths;
+- row independence (a subset of rows, 64-row blocks == one 2,048-row block), determinism (repeats, ticket on / off)
+  and every configuration (gu 0 / 1, dn 0 / 1) bit for bit; the shared upstream scratch aliasing gives the same bits.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_x3gm_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.cuda.exl3 import format as fmt
+from tensorfold.families.deepseek_v41.cuda import x3gm
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack
+
+DEV = "cuda"
+E, D, I, S = 16, 512, 384, 6
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4])
+def test_decode_is_upstreams_unpack(bits):
+    g = np.random.default_rng(bits)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(320, 72, 16 * bits), dtype=np.int64).astype(np.int16))
+    want = torch.from_numpy(fmt.unpack(t.numpy(), bits, "mul1")).view(torch.int16)
+    assert torch.equal(x3gm.dequant(t.to(DEV)).cpu().view(torch.int16), want)
+
+
+def _stack(k, n, bits, seed, suh=None):
+    g = np.random.default_rng(seed)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(E, k // 16, n // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16)).contiguous()
+    if suh is None:
+        suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, (E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, (E, n))).astype(np.float16))
+    return X3Stack(t.to(DEV), suh.to(DEV), svh.to(DEV), "mul1")
+
+
+def _layer(bits_gu=3, bits_d=3, shx=False):
+    gate = _stack(D, I, bits_gu, 1)
+    up = _stack(D, I, bits_gu, 2, suh=gate.suh.cpu() if shx else None)
+    return gate, up, _stack(I, D, bits_d, 3)
+
+
+def _inputs(R, seed, skew=True):
+    gen = torch.Generator().manual_seed(seed)
+    x = (torch.randn(R, D, generator=gen) * 0.5).to(torch.bfloat16)
+    pick = torch.stack([torch.randperm(E, generator=gen)[:S] for _ in range(R)]).to(torch.int32)
+    if skew:                                                # expert 2 in every row: R / 64 passes
+        # distinct experts a row, as the router's top-k (G6: the old form could pick 2 twice in a row; upstream's
+        # grouping keeps at most R members an expert, so the duplicates' last rows were dropped from the reference)
+        rest = torch.tensor([e for e in range(E) if e != 2], dtype=torch.int32)
+        pick = torch.stack([torch.cat([torch.tensor([2], dtype=torch.int32),
+                                       rest[torch.randperm(E - 1, generator=gen)[:S - 1]]]) for _ in range(R)])
+    w = (torch.rand(R, S, generator=gen) + 0.2).to(torch.float16).to(torch.float32)
+    return x.to(DEV), pick.to(DEV), w.to(DEV)
+
+
+def _reference(x, pick, w, layer, bits):
+    Wf = [[torch.from_numpy(fmt.dequantize(m.trellis[e].cpu().numpy(), m.suh[e].cpu().numpy(), m.svh[e].cpu().numpy(),
+                                           b, "mul1")) for e in range(E)] for m, b in zip(layer, bits)]
+    xf, pk, wc = x.double().cpu(), pick.cpu(), w.double().cpu()
+    ref = torch.zeros(x.shape[0], D, dtype=torch.float64)
+    for r in range(x.shape[0]):
+        for k in range(S):
+            e = int(pk[r, k])
+            gg = (xf[r] @ Wf[0][e]).clamp(max=10.0)
+            uu = (xf[r] @ Wf[1][e]).clamp(-10.0, 10.0)
+            ref[r] += float(wc[r, k]) * ((torch.nn.functional.silu(gg) * uu) @ Wf[2][e])
+    return ref
+
+
+def _grouped(x, pick, w, layer):
+    """The decode path: upstream's grouped kernels (experts.routed) over the same routed slots."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    gate, up, down = layer
+    trip = lambda m: [(m.trellis[e], m.suh[e], m.svh[e]) for e in range(E)]
+    ex = x3.prepare(trip(gate), trip(up), trip(down), "mul1", device=DEV)
+    s = x3.Scratch(ex, 1024, S, device=DEV)
+    out = torch.empty((x.shape[0], D), dtype=torch.float32, device=DEV)
+    for a in range(0, x.shape[0], 1024):
+        b = min(x.shape[0], a + 1024)
+        x3.routed(x[a:b], pick[a:b].contiguous(), w[a:b].contiguous(), ex, s, out[a:b], b - a, limit=10.0,
+                  act_mode=x3.ACT_F32)
+    return out
+
+
+@pytest.mark.parametrize("bits_gu,bits_d,shx", [(3, 3, False), (3, 3, True), (2, 3, False)])
+def test_routed_vs_float64_and_grouped(bits_gu, bits_d, shx):
+    layer = _layer(bits_gu, bits_d, shx)
+    x, pick, w = _inputs(300, 3)
+    got = x3gm.run(x, pick, w, *layer, 10.0)
+    assert torch.isfinite(got).all()
+    ref = _reference(x, pick, w, layer, (bits_gu, bits_gu, bits_d))
+    rel = float((got.double().cpu() - ref).abs().max() / ref.abs().max())
+    grp = _grouped(x, pick, w, layer)
+    relg = float((got - grp).abs().max() / grp.abs().max())
+    print(f"[G6] gm {bits_gu}/{bits_d}-bit shx={int(shx)}: rel vs float64 {rel:.3g}, vs grouped {relg:.3g}")
+    assert rel < 3e-3 and relg < 3e-3
+
+
+def test_rotation_is_upstreams():
+    from tensorfold.cuda.exl3 import experts as x3
+
+    gate, up, _ = _layer()
+    x, pick, _ = _inputs(64, 5)
+    P = pick.numel()
+    want0, want1 = (torch.empty((P, D), dtype=torch.float16, device=DEV) for _ in range(2))
+    x3._ext().rot_in(x, x.stride(0), pick, gate.suh, up.suh, want0, want1, 64, D, S, E)
+    got0, got1 = (torch.empty((P, D), dtype=torch.float16, device=DEV) for _ in range(2))
+    x3gm._ext().rot(x, x.stride(0), pick, gate.suh, up.suh, got0, got1, D, S, P, 2)
+    assert torch.equal(got0, want0) and torch.equal(got1, want1)
+    one = torch.empty_like(got0)
+    x3gm._ext().rot(x, x.stride(0), pick, gate.suh, up.suh, one, one, D, S, P, 1)
+    assert torch.equal(one, want0)
+
+
+def _cfg(**kw):
+    c = x3gm.config({})
+    c.update(kw)
+    return c
+
+
+@pytest.mark.parametrize("shx", [False, True])
+def test_rows_independent_deterministic_every_config(shx):
+    layer = _layer(3, 3, shx)
+    x, pick, w = _inputs(2048, 7)
+    got = x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg())
+    assert torch.equal(got, x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg()))                    # repeat
+    assert torch.equal(got, x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(ticket=False)))        # static stride
+    assert torch.equal(got, x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(rows=64)))             # 64-row blocks
+    for gu, dn in ((0, 0), (1, 1), (0, 1), (1, 0)):
+        assert torch.equal(got, x3gm.run(x, pick, w, *layer, 10.0, cfg=_cfg(gu=gu, dn=dn))), (gu, dn)
+    sub = [0, 7, 150, 299, 2047]
+    assert torch.equal(got[sub], x3gm.run(x[sub], pick[sub], w[sub], *layer, 10.0))
+
+
+def test_scratch_aliasing_same_bits():
+    from tensorfold.cuda.exl3 import experts as x3
+
+    layer = _layer()
+    x, pick, w = _inputs(2048, 9)
+    trip = lambda m: [(m.trellis[e], m.suh[e], m.svh[e]) for e in range(E)]
+    ex = x3.prepare(trip(layer[0]), trip(layer[1]), trip(layer[2]), "mul1", device=DEV)
+    s = x3.Scratch(ex, 1024, S + 1, device=DEV)            # the forward's shared scratch: 1,024 rows x 7 slots
+    assert x3gm.Buffers(s, 2048, 2048, S, D, I, 2, DEV).aliased  # (in blocks of what fits; 2,048 at the real shape)
+    want = x3gm.run(x, pick, w, *layer, 10.0)
+    assert torch.equal(x3gm.run(x, pick, w, *layer, 10.0, scratch=s), want)
