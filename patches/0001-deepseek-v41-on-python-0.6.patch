+    stmts = [s.strip() for s in rot.strip("{}").split(";") if s.strip()]
+    assert stmts[0].startswith("pdl_wait()") and stmts[1].split("\n")[-1].strip() == "pdl_trigger()", stmts[:2]
+    lin = _fn(src, "seg_linear_kernel(const LinTable tab, int y_dtype, int M)")
+    w = lin.index("pdl_wait()")
+    t = lin.index("pdl_trigger()")
+    pre = lin[:w]
+    assert w < t
+    assert "load_step<K2>(tile, lane, cur)" in pre                    # the first weight step before the wait
+    for bad in ("x0 + kt", "x1 + kt", "store4(", "atomicAdd", "counters[", "Z +", "*reinterpret_cast<float"):
+        assert bad not in pre, bad
+    assert "if (pass == 0) pdl_wait();" in lin and "if (m0 + 16 >= M) pdl_trigger();" in lin
+    host = src[src.index("void dsv41_x3seg_rot_in_cuda"):]
+    assert "<<<" not in host and host.count("launch_ex(") >= 2
+    assert "cudaLaunchAttributeProgrammaticStreamSerialization" in src
