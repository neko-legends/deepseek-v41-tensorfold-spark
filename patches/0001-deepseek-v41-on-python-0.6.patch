index 0000000..caaf7ca
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/csa2/stores.py
@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Where the CSA2 rows live: a slot's SWA rings, the kv sources' compressed rows and their index keys.
+
+- ``Records``: FP8 KV records (``rows``: 576 value bytes + 8 scale bytes a row) as two row-strided tensors: two
+  contiguous ones (``new``: rings, the one-slot path), or the column ranges of the KV pool's 584-byte rows
+  (``packed``: ``pool.Pool``), with the slot's page table (``table`` int32, ``shift`` = log2 rows a page);
+- ``Keys``: index keys [rows, 128] (bf16 for the kernels; the pool's ``index_k`` family), paged the same way;
+- ``Floats``: the torch twin's rows for widths the record does not cover (tiny test configs) or ``numerics.exact``.
+
+Kernels take ``kernel()`` / ``paging()``; the twin reads and writes logical rows (``read`` / ``write``), mapped
+through the page table on the host side. ``raw`` / ``put_raw`` move a store's bytes as they are (snapshots).
+"""
+
+from __future__ import annotations
+
+import torch
+
+from . import fmt as RW
+from . import ref
+
+
+class _Paged:
+    table: torch.Tensor | None = None
+    shift: int = 0
+
+    def paging(self) -> dict:
+        return {"page_table": self.table, "page_shift": self.shift} if self.table is not None else {}
+
+    def phys(self, rows: torch.Tensor) -> torch.Tensor:
+        rows = rows.to(torch.long)
+        if self.table is None:
+            return rows
+        pg = self.table.to(rows.device).index_select(0, rows >> self.shift).to(torch.long)
+        return (pg << self.shift) + (rows & ((1 << self.shift) - 1))
+
+
+class Records(_Paged):
+    def __init__(self, values: torch.Tensor, scales: torch.Tensor, table=None, shift: int = 0) -> None:
+        if values.shape[-1] != RW.VB or scales.shape[-1] != RW.SB or values.dtype != torch.uint8:
+            raise ValueError("records: values [*, 576] and scales [*, 8] uint8")
+        self.values, self.scales, self.table, self.shift = values, scales, table, int(shift)
+
+    @classmethod
+    def new(cls, n: int, device) -> "Records":
+        return cls(torch.zeros((n, RW.VB), dtype=torch.uint8, device=device),
+                   torch.zeros((n, RW.SB), dtype=torch.uint8, device=device))
+
+    @classmethod
+    def packed(cls, phys: torch.Tensor, table=None, shift: int = 0) -> "Records":
+        """The pool's [rows, 584] uint8 tensor: values = its first 576 columns, scales the last 8."""
+
+        if phys.shape[-1] != RW.ROW_BYTES:
+            raise ValueError(f"a packed record row is {RW.ROW_BYTES} bytes, not {phys.shape[-1]}")
+        return cls(phys[:, :RW.VB], phys[:, RW.VB:], table, shift)
+
+    def kernel(self) -> tuple[torch.Tensor, torch.Tensor]:
+        return self.values, self.scales
+
+    def copy_rows(self, dst: torch.Tensor, src: "Records", rows: torch.Tensor) -> None:
+        """Rows ``rows`` of ``src`` into rows ``dst`` of this store, as stored bytes (device index tensors, no host
+        sync; the prefill staging ring, ``forward``)."""
+
+        d, r = self.phys(dst), src.phys(rows)
+        self.values.index_copy_(0, d, src.values.index_select(0, r))
+        self.scales.index_copy_(0, d, src.scales.index_select(0, r))
+
+    def write(self, rows: torch.Tensor, x: torch.Tensor) -> None:
+        v, s = ref.quantize_rows(x.float().cpu())
+        p = self.phys(rows).to(self.values.device)
+        self.values[p] = v.to(self.values.device)
+        self.scales[p] = s.to(self.scales.device)
+
+    def read(self, rows: torch.Tensor) -> torch.Tensor:
+        p = self.phys(rows).to(self.values.device)
+        return ref.dequantize_rows(self.values[p].cpu(), self.scales[p].cpu()).float()
+
+    def raw(self, rows: torch.Tensor) -> dict:
+        p = self.phys(rows).to(self.values.device)
+        return {"values": self.values[p].cpu().numpy(), "scales": self.scales[p].cpu().numpy()}
+
+    def put_raw(self, rows: torch.Tensor, raw: dict) -> None:
+        p = self.phys(rows).to(self.values.device)
+        self.values[p] = torch.from_numpy(raw["values"]).to(self.values.device)
+        self.scales[p] = torch.from_numpy(raw["scales"]).to(self.scales.device)
+
+
+class Floats(_Paged):
+    """The twin's rows: the dequantized values themselves (any width, any dtype)."""
+
+    def __init__(self, data: torch.Tensor) -> None:
+        self.data = data
+
+    def copy_rows(self, dst: torch.Tensor, src: "Floats", rows: torch.Tensor) -> None:
+        """Rows ``rows`` of ``src`` into rows ``dst`` of this store, as stored."""
+
+        self.data.index_copy_(0, self.phys(dst), src.data.index_select(0, src.phys(rows)))
+
+    def write(self, rows: torch.Tensor, x: torch.Tensor) -> None:
+        self.data[self.phys(rows).to(self.data.device)] = x.to(self.data.dtype)
+
+    def read(self, rows: torch.Tensor) -> torch.Tensor:
+        return self.data.index_select(0, self.phys(rows).to(self.data.device))
+
+    def raw(self, rows: torch.Tensor) -> dict:
+        return {"data": self.read(rows).cpu().numpy()}
+
+    def put_raw(self, rows: torch.Tensor, raw: dict) -> None:
+        self.write(rows, torch.from_numpy(raw["data"]))
+
+
+class Keys(Floats):
+    """Index keys [rows, width] (bf16 for the kernels; or uint8 [rows, 132]: the kit's per-token FP8 key,
+    ``fmt.key_quant``), paged like the records they belong to."""
+
+    def __init__(self, data: torch.Tensor, table=None, shift: int = 0) -> None:
+        super().__init__(data)
+        self.table, self.shift = table, int(shift)
+        self.fp8 = data.dtype == torch.uint8
+
+    def kernel(self) -> torch.Tensor:
+        return self.data
+
+    def write(self, rows: torch.Tensor, x: torch.Tensor) -> None:
+        if self.fp8:
+            x = RW.key_quant(x.to(torch.bfloat16).cpu()).to(self.data.device)
+        super().write(rows, x)
+
+    def read(self, rows: torch.Tensor) -> torch.Tensor:
+        raw = super().read(rows)
+        return RW.key_dequant(raw.cpu()).to(raw.device) if self.fp8 else raw
+
+    def raw(self, rows: torch.Tensor) -> dict:
+        return {"data": Floats.read(self, rows).cpu().numpy()}
+
+    def put_raw(self, rows: torch.Tensor, raw: dict) -> None:
+        Floats.write(self, rows, torch.from_numpy(raw["data"]))
