+++ b/tests/test_dsv41_chunk4k_interp.py
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 4K exactness through the Triton CSA2 / mHC kernels in Triton's CPU interpreter (512-wide FP8 rows, 32 x 128
+index heads, a 128-token window), scaled: segments of 2P rows ("4K") against P rows ("2K"), P = 20, with every
+threshold that picks a path by WINDOW size set so the 2P windows cross it and the P windows (some of them) do not --
+the switches 4,096-row windows move at the real sizes:
+
+- the streaming top-k (``stream_min``: a window with more than 16 rows whose last row sees >= stream_min keys; at the
+  real sizes TF_DSV41_INDEX_STREAM_MIN), the materialised selection in row blocks under the index budget (at the
+  real sizes ~5,461 visible keys at 4,096 rows, 10,922 at 2,048), attention in blocks of the scratch's rows;
+- the mHC row tile (TF_DSV41_MHC_ROWS / _BM / _WARPS: windows of at least MHC_ROWS rows take the prefill tile);
+- the fast prefill kernels with the fused prefill attention (TF_DSV41_PREFILL_KERNELS=fast, _PREFILL_ATTN=fused).
+
+Logits (the last prompt token and a decode step) and the kv sources' compressed rows / index keys bit for bit."""
+
+from __future__ import annotations
+
+import json
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton  # noqa: E402
+
+if type(compress._kv_store).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20, index_topk=64)
+P = 20
+IDS = torch.randint(0, 256, (2 * P + 6,), generator=torch.Generator().manual_seed(44)).tolist()
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41c4ki"), **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def run(ckpt, pchunk: int, *, stream: int = 0, budget: int | None = None, attn_rows: int = 8):
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    cs = Triton(attn_rows, cfg.num_attention_heads, "cpu")
+    if budget is not None:
+        cs.index_budget = budget
+    cs.stream_min = stream
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = FW.Forward(cfg, tree, csa2=cs, limit=96, chunk=4, pchunk=pchunk, engram_rows=rows,
+                    hasher=EH.NgramHasher(cfg, tmap))
+    last = fw.prompt(IDS[:-1])
+    step = fw.step([IDS[-1]])
+    s = fw.slots[0]
+    keys = {}
+    for L, st in s.comp.items():
+        n = s.pos // next(b.ratio for b in fw.blocks if b.index == L)
+        keys[f"comp.{L}"] = st.read(torch.arange(n))
+        keys[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    return torch.cat([last, step]), keys
+
+
+def _same(a, b):
+    assert torch.equal(a[0], b[0])
+    assert set(a[1]) == set(b[1])
+    for k in a[1]:
+        assert torch.equal(a[1][k], b[1][k]), k
+
+
+def test_window_switches_do_not_change_a_bit(ckpt, monkeypatch):
+    """2P windows: streaming top-k for every row (n > 16, the last row sees >= 30 keys), the materialised selection
+    in row blocks (budget 1), the mHC prefill tile (MHC_ROWS 30); P windows: rows 0..19 materialised in one block
+    and the default mHC tile, rows 20..39 streaming. Same bits."""
+
+    monkeypatch.setenv("TF_DSV41_MHC_ROWS", "30")
+    monkeypatch.setenv("TF_DSV41_MHC_BM", "32")
+    monkeypatch.setenv("TF_DSV41_MHC_WARPS", "8")
+    two = run(ckpt, P, stream=30)
+    assert not torch.isnan(two[0]).any()
+    four = run(ckpt, 2 * P, stream=30, budget=1)
+    _same(four, two)
+    plain = run(ckpt, 2 * P)                                   # no switch at all (materialised, default tiles)
+    monkeypatch.delenv("TF_DSV41_MHC_ROWS")
+    _same(plain, two)
+
+
+def test_fast_kernels_fused_attention_4k_equals_2k(ckpt, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    monkeypatch.setenv("TF_DSV41_MHC_ROWS", "30")
+    two = run(ckpt, P, stream=30)
+    four = run(ckpt, 2 * P, stream=30, budget=1)
+    _same(four, two)
