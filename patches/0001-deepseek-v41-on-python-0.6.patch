+++ b/src/tensorfold/families/glm5_next/spark/latent.py
@@ -0,0 +1,1029 @@
+"""Latent (absorbed) MLA attention for GLM-5.3-Flash's DSA layers (patches/0060, ``GLM53_TF_LATENT_KV=1``).
+
+GLM-5.3 has no rotary part in its MLA heads (qk_rope_head_dim 0), so a head's key and value are linear in the
+512-wide latent c = kv_a_layernorm(kv_a(x)) of its token: k_h = W_k,h c and v_h = W_v,h c (kv_b's key and value
+rows). Attention therefore runs in latent space with the head's weights absorbed on the query and output side:
+
+    score_t = q_h . (W_k,h c_t)                 = (W_k,h^T q_h) . c_t
+    o_h     = sum_t p_t W_v,h c_t / sum_t p_t   = W_v,h (sum_t p_t c_t / sum_t p_t)
+
+and the cache keeps c alone: 1 KB a token a layer (bf16), shared by every head, instead of 32 local heads x
+(256 + 256) x 2 B = 32 KB. Keys and values are the same rows, so one tile of latent rows serves the scores and
+the weighted sum of 16 (row, head) queries at once (MQA-style: the tile is read once for 16 heads).
+
+Arithmetic, every step fixed by the shapes and never by the row count or the window:
+
+- ``absorb``: q'_h = bf16(W_k,h^T q_h). The kv_b key rows stay as stored (4-bit groups of 64, or BF16 on an EXL3
+  checkpoint); a program dequantizes a 64 x 64 tile exactly in fp32 (s * q + b) and multiplies fp32 x fp32 in
+  IEEE precision (FMA, no tensor cores), over the head's 256 inputs in order. It reads the same weight bytes as
+  today's key projection.
+- attention over the latent cache: bf16 q' against bf16 c on tensor cores (fp32 sums), online softmax in fp32,
+  the weighted sum of bf16 probabilities times c; 512-key chunks fixed by absolute key position, merged in
+  chunk order (the expanded kernel's rule, ``attention.py``). The normalized latent u = sum p c / sum p stays fp32.
+- ``expand``: o_h = bf16(W_v,h u_h), the value rows dequantized the same way, fp32 FMA over the latent in order.
+- o_proj reads o exactly as before.
+
+Each (row, head) is one row of a 16-row tensor-core tile whatever its tile-mates, so a window row gets the bits of
+the serial step at its position (verify == serial, drafted == serial); rows past the dense limit attend to their
+own top-k tokens (``sparse.select_tokens``, unchanged) through the same tile arithmetic. No atomics anywhere.
+
+Relative to the expanded engine the arithmetic differs (k and v are never rounded to bf16 per head; q' is), so
+replies differ from the expanded engine's in the last bits; within this configuration every guarantee holds.
+
+patches/0220, GLM53_TF_KV_DTYPE=fp8 (load-time; default bf16): every latent cache (the 11 DSA layers' and the MTP
+head's) stores a token's row as 512 e4m3 values and one power-of-two fp32 scale, in one uint8 tensor
+[capacity, ``ROW8`` = 528] (bytes 0-511 the values, 512-515 the scale, 516-527 padding that keeps rows 16-byte
+aligned): 528 B a token a layer instead of 1,024. ``latent_write`` quantizes each row on its own (s = the smallest
+power of two with amax / s <= 448; values rounded to nearest even, never saturating); the attention kernels
+dequantize the rows they read, e4m3 x 2^k, which is exact in bf16, and then run the bf16 arithmetic above
+unchanged. So an FP8 cache gives exactly the bits of a bf16 cache holding the dequantized rows (tested), and every
+guarantee (row independence, verify == serial, chunk size, resumed == fresh) holds within the FP8 configuration for
+the same reasons. New arithmetic against bf16 KV (the stored latent is rounded to 4 mantissa bits): replies differ;
+snapshots carry the dtype (``decode.Snapshot.kv``) and the session store's keys include it. Pool keys and the
+indexer's keys and gates stay bf16 (they decide the token selection).
+
+patches/0290, GLM53_TF_KV_POOL_TOKENS (``kvpool``): a latent cache may be a ``kvpool.Paged`` view of a pool shared by
+the batch slots. Every kernel below that reads or writes latent rows maps a logical row to its physical row through
+the slot's page table first (``_prow``; PT / PSH, PSH = log2 rows a page, 0 = a contiguous cache: the branch is pruned
+at compile time), under the same masks: the same values at other addresses, the same bits.
+
+patches/0390, GLM53_TF_MLA_EXPAND=v2 (load-time; default v1): ``absorb`` / ``expand`` through ``_absorb2`` /
+``_expand2``, the same fp32 FMA chain per output element retiled (up to 128 rows a program share one dequantization of
+the kv_b tile instead of 16; k in 16-wide dot steps; a head's programs adjacent). Same bits as v1 for every row and any
+row count, so every snapshot, session and exactness guarantee is shared with v1 (``EXPAND_V2`` below).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import deep as _deep                                     # patches/0380
+from . import fp8pf, glue, kvpool, profile, qmm, sparse
+from . import l2pf                                                  # patches/0460
+from .qmm import B16, Q4, Q8
+
+CHUNK = 512              # keys a program visits (the expanded kernel's chunk: the same chunk counts serve both)
+# rows whose sparse partials are preallocated (decode/verify/MTP windows; captured steps); patches/0380: the widest
+# verify window (GLM53_TF_MAX_DRAFT_ROWS)
+SPARSE_ROWS = max(8, _deep.ROWS)
+KT = 32                  # latent rows a tile step reads (32 x 512 bf16 = 32 KB)
+BM = 16                  # (row, head) queries a tensor-core tile holds
+ATTN_WARPS = 8           # a tile's [16, 512] fp32 accumulator and [32, 512] latent rows need the registers of 8 warps
+# patches/0083: fast FP8 prefill chunks (``fp8pf``; never decode, verify, MTP or exact prefill): 32 (row, head) queries
+# a tile (one gather of a row's selected latent rows serves 32 heads; measured 11.2 -> 8.5 ms a layer for 1024 sparse
+# rows on GB10, 0060's table) and the tensor-core absorb / expand (``absorb_tc`` / ``expand_tc``, 64-row tiles).
+# ``FAST_STAGES``: software-pipelining depth of the attention's key loop (1 = none; never changes a bit).
+FAST_BM = 32
+FAST_STAGES = 1
+# patches/0190 (``tf_knobs.attn_bm32``, GLM53_TF_ATTN_BM32): bf16 fast chunks use the same 32-query tiles (one gather of
+# a row's selected latent rows for all 32 local heads). A (row, head) query's scores and weighted sums are the same mma
+# chains whatever the tile's other queries; 0060 / 0083 measured the 32-query tile bit-identical to the 16-query one
+# on the real shapes, and ``tests/cuda/test_glue_patches.py`` checks it bit for bit (dense and sparse). Decode, verify,
+# the MTP head and exact prefill keep BM = 16.
+BF16_BM32 = False
+# patches/0190 (GLM53_TF_LATENT_TC=1, load-time): bf16 fast chunks run ``absorb_tc`` / ``expand_tc`` (the tensor-core
+# absorb / expand FP8 chunks use) instead of the fp32 FMA-pipe ``absorb`` / ``expand``. NEW arithmetic (q and u rounded
+# to bf16 at the dot, kv_b's dequantized tile rounded to bf16): fast replies change, like GLM53_TF_KDA_PROJ_BF16;
+# deterministic and row-independent (64-row tiles, fixed K order), so drafted == serial and resumed == fresh hold;
+# snapshots carry their own tag (``pfgrid.TC``) so they never resume a prefill of the other arithmetic.
+BF16_TC = False
+TC_ROWS = 64
+# patches/0390 (GLM53_TF_MLA_EXPAND=v2, load-time; default v1 = the kernels above): ``absorb`` / ``expand`` through
+# ``_absorb2`` / ``_expand2``, the same arithmetic retiled. Every output element keeps the ONE fp32 FMA chain the v1
+# kernels give it (``tl.dot(..., input_precision="ieee")`` lowers to ``acc = fma(a_k, b_k, acc)`` for k = 0 .. K - 1
+# per element, from the carried accumulator, whatever the tile shape or layout: Triton's FMADotUtility.cpp; the
+# ``acc + tl.dot(x, w)`` of v1 is folded into ``tl.dot(x, w, acc)`` by Combine.cpp's CombineDotAddPattern), over the
+# same k order (64-wide groups ascending, ascending within), from +0.0, with the same exactly dequantized weights
+# (q * s + b: q < 16 and a bf16 s, so q * s is exact and fused or not gives one value) and the same bf16 rounding.
+# Only the tiling changes: up to 128 rows a program (v1: 16) share one dequantization of the kv_b tile, k in 16-wide
+# dot steps (v1: 64, which spilled), programs of one head adjacent in the grid (its u / q rows stay in L2). So the
+# bits are v1's for every row whatever the launch's row count: prefill, decode, verify and MTP steps all use it.
+# docs/MLA-EXPAND.md in the deployment repo.
+EXPAND_ENV = "GLM53_TF_MLA_EXPAND"
+
+
+def expand_mode() -> str:
+    """GLM53_TF_MLA_EXPAND: ``v1`` (default; also empty / 0 / off) or ``v2`` (the retiled kernels, same bits)."""
+
+    v = os.environ.get(EXPAND_ENV, "v1").strip().lower()
+    if v in ("", "0", "off", "v1"):
+        return "v1"
+    if v in ("1", "v2"):
+        return "v2"
+    raise ValueError(f"{EXPAND_ENV} must be v1 or v2, not {v!r}")
+
+
+EXPAND_V2 = expand_mode() == "v2"
+if EXPAND_V2:
+    print("[tensorfold] latent absorb / expand: v2 kernels (patches/0390, GLM53_TF_MLA_EXPAND=v2; same bits as v1)",
+          flush=True)
+# patches/0240 (``tf_knobs.b12x`` bit 4, ``b12xpf``): fast chunks' sparse rows through ``b12x_attn.sparse_latent_one``
+# (one online softmax over a row's whole token list; new arithmetic, own snapshot tag). False everywhere else
+SPARSE_ONE = False
+# patches/0220: the FP8 latent row (GLM53_TF_KV_DTYPE=fp8): 512 e4m3 bytes, the fp32 scale at byte 512, padded to 528
+ROW8 = 528
+SCALE_AT = 512
+E4M3_MAX = 448.0
+
+
+def fast8(b) -> bool:
+    """patches/0083: ``b`` is running a fast chunk of an FP8 prefill (``fp8pf``)."""
+
+    return fp8pf.ON and bool(getattr(b, "fast", False))
+
+
+def tc(b) -> bool:
+    """The tensor-core absorb / expand: FP8 fast chunks (patches/0083), and bf16 fast chunks with ``BF16_TC``
+    (patches/0190)."""
+
+    return fast8(b) or (BF16_TC and bool(getattr(b, "fast", False)))
+
+
+def enabled() -> bool:
+    """GLM53_TF_LATENT_KV: 1 caches the MLA latent (this module), 0 (default) the expanded per-head keys/values."""
+
+    v = os.environ.get("GLM53_TF_LATENT_KV", "0").strip()
+    if v not in ("", "0", "1"):
+        raise ValueError(f"GLM53_TF_LATENT_KV must be 0 or 1, not {v!r}")
+    return v == "1"
+
+
+def on(w) -> bool:
+    return bool(w.meta.get("latent_kv"))
+
+
+def kv_dtype() -> str:
+    """GLM53_TF_KV_DTYPE (patches/0220, load-time): ``bf16`` (default) or ``fp8`` latent cache rows (e4m3 + a per-row
+    power-of-two scale). ``fp8`` needs GLM53_TF_LATENT_KV=1 (the expanded per-head cache stays bf16)."""
+
+    v = os.environ.get("GLM53_TF_KV_DTYPE", "bf16").strip().lower() or "bf16"
+    if v not in ("bf16", "fp8"):
+        raise ValueError(f"GLM53_TF_KV_DTYPE must be bf16 or fp8, not {v!r}")
+    if v == "fp8" and not enabled():
+        raise ValueError("GLM53_TF_KV_DTYPE=fp8 stores the MLA latent in FP8: it needs GLM53_TF_LATENT_KV=1")
+    return v
+
+
+def fp8_on(w) -> bool:
+    """patches/0220: this engine's latent caches hold FP8 rows (``w.meta['kv_fp8']``, set at load)."""
+
+    return bool(w.meta.get("kv_fp8"))
+
+
+def is_fp8(lc: torch.Tensor) -> bool:
+    """An FP8 latent cache (uint8 rows of ``ROW8`` bytes) rather than a bf16 one."""
+
+    return lc.dtype == torch.uint8
+
+
+def caches(w, capacity: int, n: int) -> list[torch.Tensor]:
+    """``n`` latent caches [capacity, kv_lora] bf16 (one row a token), or with patches/0220's FP8 rows
+    [capacity, ``ROW8``] uint8 (512 e4m3 values and an fp32 scale a row; zero rows read as zeros)."""
+
+    c = w.cfg
+    if c.kv_lora % 64 or c.kv_lora & (c.kv_lora - 1):
+        raise ValueError(f"latent KV needs a power-of-two kv_lora_rank of at least 64, not {c.kv_lora}")
+    if fp8_on(w):
+        if c.kv_lora != SCALE_AT:
+            raise ValueError(f"GLM53_TF_KV_DTYPE=fp8 is laid out for a 512-wide latent, not {c.kv_lora}")
+        return [torch.zeros((capacity, ROW8), dtype=torch.uint8, device=w.device) for _ in range(n)]
+    return [torch.zeros((capacity, c.kv_lora), dtype=torch.bfloat16, device=w.device) for _ in range(n)]
+
+
+def _views(lc: torch.Tensor, L: int):
+    """Kernel arguments of a latent cache: (rows, scales, FP8, row stride in elements, scale stride in fp32s).
+    patches/0290: a paged cache gives its physical tensor (the page table: ``_paging``)."""
+
+    if kvpool.is_paged(lc):
+        lc = lc.phys
+    if is_fp8(lc):
+        if lc.shape[1] != ROW8 or L != SCALE_AT or not lc.is_contiguous():
+            raise ValueError("FP8 latent cache: expected contiguous [capacity, 528] uint8 rows of a 512-wide latent")
+        return lc, lc.view(torch.float32), True, ROW8, ROW8 // 4
+    if lc.shape[1] != L:
+        raise ValueError("latent cache rows must be as wide as the latent")
+    return lc, lc, False, L, 0
+
+
+def _paging(lc) -> dict:
+    """patches/0290: the page-table arguments of a kernel on cache ``lc``: PT (the slot's device table, None for a
+    contiguous cache) and PSH (log2 rows a page; 0 prunes the paged branch)."""
+
+    _, pt, shift = kvpool.kernel_args(lc)
+    return dict(PT=pt, PSH=shift)
+
+
+def dequantize_rows(lc: torch.Tensor) -> torch.Tensor:
+    """patches/0220 (tests, host checks): an FP8 latent cache's rows as bf16 [n, 512] (exact: e4m3 x 2^k); a bf16
+    cache is returned as is."""
+
+    if not is_fp8(lc):
+        return lc
+    vals = lc[:, :SCALE_AT].contiguous().view(torch.float8_e4m3fn).to(torch.float32)
+    scale = lc[:, SCALE_AT:SCALE_AT + 4].contiguous().view(torch.float32)
+    return (vals * scale).to(torch.bfloat16)
+
+
+def quantize_rows_reference(x: torch.Tensor) -> torch.Tensor:
+    """patches/0220: torch reference of ``latent_write``'s FP8 rows: x [n, 512] bf16 -> [n, ROW8] uint8."""
+
+    n, L = x.shape
+    xf = x.float()
+    amax = xf.abs().amax(1)
+    bits = amax.view(torch.int32)
+    E = (bits >> 23) & 0xFF
+    e = E - 135 + ((bits & 0x7FFFFF) > 0x600000).to(torch.int32)
+    e = torch.where(amax > 0, e, torch.zeros_like(e)).clamp(-126, 126)
+    scale = ((e + 127) << 23).view(torch.float32)
+    inv = ((127 - e) << 23).view(torch.float32)
+    q = (xf * inv[:, None]).to(torch.float8_e4m3fn)
+    out = torch.zeros((n, ROW8), dtype=torch.uint8, device=x.device)
+    out[:, :L] = q.view(torch.uint8)
+    out[:, SCALE_AT:SCALE_AT + 4] = scale.view(torch.uint8).view(n, 4)
+    return out
+
+
+def kv_bytes_per_token(st) -> int:
+    """Bytes a cached token costs on this rank: every attention cache (the model's layers and the MTP head's) and the
+    indexer caches (pool keys are one row per 4 tokens), counted once however they alias."""
+
+    seen, total = set(), 0
+
+    def add(t: torch.Tensor, per: float = 1.0) -> None:       # patches/0220: an FP8 row counts its 528 bytes
+        nonlocal total
+        if t.data_ptr() in seen:
+            return
+        seen.add(t.data_ptr())
+        if kvpool.is_paged(t):                                # patches/0290: a row of the pool tensor
+            total += int(t.row_bytes() * per)
+            return
+        total += int(t[0].numel() * t.element_size() * per)
+
+    for t in list(st.kc) + list(st.vc):
+        add(t)
+    if hasattr(st, "mtp_kc"):
+        add(st.mtp_kc)
+        add(st.mtp_vc)
+    if st.index is not None:
+        for ik, ig, pk in st.index:
+            if ik.shape[0] >= st.capacity:      # patches/0065: a ring (``State.index_ring``) costs no bytes a token
+                add(ik)
+                add(ig)
+            add(pk, 0.25)
+    return total
+
+
+class Scratch:
+    """Per-``Buffers`` scratch of the latent path: absorbed queries, chunk partials, the normalized latent rows and
+    the expanded head outputs, for windows of up to ``rows`` rows.
+
+    Dense (chunked) attention only ever runs over contexts within DSA's dense limit (rows past it attend to their
+    top-k tokens instead), so the partials are sized by min(capacity, dense limit) + rows keys, not by the capacity:
+    a 1M-token cache does not need 1M / 512 chunk partials."""
+
+    def __init__(self, w, rows: int, capacity: int, device) -> None:
+        c = w.cfg
+        H = c.heads // w.world
+        L = c.kv_lora
+        self.rows, self.heads, self.lat = rows, H, L
+        self.nch = triton.cdiv(min(capacity, c.dense_limit) + rows, CHUNK)
+        self.po = torch.empty((self.nch * rows * H * L,), dtype=torch.float32, device=device)
+        self.pm = torch.empty((self.nch * rows * H,), dtype=torch.float32, device=device)
+        self.pl = torch.empty((self.nch * rows * H,), dtype=torch.float32, device=device)
+        self.qa = torch.empty((rows, H, L), dtype=torch.bfloat16, device=device)       # absorbed queries
+        self.u = torch.empty((rows, H, L), dtype=torch.float32, device=device)         # attention in latent space
+        self.o = torch.empty((rows, H * c.v_dim), dtype=torch.bfloat16, device=device)  # heads' outputs (o_proj in)
+        self.out = self.o.view(rows, H, c.v_dim)
+        # sparse partials of windows of up to SPARSE_ROWS rows (a captured long-context step allocates nothing,
+        # patches/0050); longer (prefill) windows allocate theirs per call. The row stride only places partials.
+        width = sparse.TOPK_POOLS * sparse.POOL + sparse.POOL - 1
+        self.sparse_rows = min(rows, SPARSE_ROWS)
+        self.snch = triton.cdiv(width, CHUNK)
+        n = self.snch * self.sparse_rows * H
+        self.spo = torch.empty((n * L,), dtype=torch.float32, device=device)
+        self.spm = torch.empty((n,), dtype=torch.float32, device=device)
+        self.spl = torch.empty((n,), dtype=torch.float32, device=device)
+
+    def sparse_part(self, R: int):
+        """Preallocated sparse partials for R rows, or None past ``sparse_rows``."""
+
+        if R > self.sparse_rows:
+            return None
+        n = self.snch * R * self.heads
+        return self.spo[:n * self.lat], self.spm[:n], self.spl[:n]
+
+
+# -- weights: exact fp32 tiles of kv_b as stored ------------------------------------------------------------------
+@triton.jit
+def _wtile(W, S, B, n0, g, N: tl.constexpr, K: tl.constexpr, IS_Q4: tl.constexpr):
+    """Rows n0 .. n0 + 63, columns g 64 .. g 64 + 63 of an [N, K] weight as fp32: a 4-bit tile (``qmm.Q4`` layout,
+    words [N/64, K/64, 64, 8], scales and biases [K/64, N]) dequantized exactly (s * q + b), or a BF16 tile."""
+
+    nl = tl.arange(0, 64)
+    if IS_Q4 == 2:                                    # patches/0470: 8-bit (``qmm.Q8``: int8 [N, K], scales [K/G, N])
+        j = tl.arange(0, 64)
+        q = tl.load(W + (n0 + nl)[:, None].to(tl.int64) * K + (g * 64 + j)[None, :]).to(tl.float32)
+        s = tl.load(S + ((g * 64) // B) * N + n0 + nl).to(tl.float32)
+        return q * s[:, None]
+    elif IS_Q4:
+        KG: tl.constexpr = K // 64
+        tile = W + (n0 // 64) * (KG * 512) + g * 512
+        rw = tl.arange(0, 8)
+        words = tl.load(tile + nl[:, None] * 8 + rw[None, :])
+        shifts = tl.arange(0, 8) * 4
+        q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+        q = tl.reshape(q, (64, 64)).to(tl.float32)
+        s = tl.load(S + g * N + n0 + nl).to(tl.float32)
+        b = tl.load(B + g * N + n0 + nl).to(tl.float32)
+        return q * s[:, None] + b[:, None]
+    else:
+        j = tl.arange(0, 64)
+        return tl.load(W + (n0 + nl)[:, None].to(tl.int64) * K + (g * 64 + j)[None, :]).to(tl.float32)
+
+
+def _parts(q: Q4 | Q8 | B16):
+    """(W, S, B, IS_Q4) for the tile loaders: IS_Q4 True 4-bit, False BF16, 2 8-bit (patches/0470: B is then the
+    group size, a plain int; 64-column tiles never straddle a group, G being 64 or 128)."""
+
+    if isinstance(q, Q4):
+        return q.weight, q.scales, q.biases, True
+    if isinstance(q, Q8):
+        return q.weight, q.scales, int(q.gs), 2
+    if isinstance(q, B16):
+        return q.weight, q.weight, q.weight, False
+    raise TypeError(f"latent KV: kv_b must be a Q4, Q8 or B16 matrix, not {type(q).__name__}")
+
+
+@triton.jit
+def _absorb(Q, W, S, B, QA, M, H: tl.constexpr, DQ: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+            IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """Program (row tile, head, latent group g): QA[r, h, g 64 ..] = bf16(sum_i q[r, h, i] W[h DQ + i, g 64 ..]),
+    i in 64-wide steps in order (fp32 IEEE dots)."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    h = tl.program_id(1)
+    g = tl.program_id(2)
+    ok = rm < M
+    k = tl.arange(0, 64)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for it in range(DQ // 64):
+        x = tl.load(Q + (rm[:, None] * H + h) * DQ + it * 64 + k[None, :], mask=ok[:, None], other=0.0)
+        wt = _wtile(W, S, B, h * DQ + it * 64, g, N, L, IS_Q4)                       # [64 inputs i, 64 latent j]
+        acc = acc + tl.dot(x.to(tl.float32), wt, input_precision="ieee")
+    tl.store(QA + (rm[:, None] * H + h) * L + g * 64 + k[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+def absorb(q: torch.Tensor, kv_k: Q4 | B16, out: torch.Tensor) -> torch.Tensor:
+    """q [R, H, DQ] bf16 -> out [R, H, L] bf16: every head's query in latent space."""
+
+    R, H, DQ = q.shape
+    L = out.shape[2]
+    W, S, B, is_q4 = _parts(kv_k)
+    if kv_k.n != H * DQ or kv_k.k != L or DQ % 64 or L % 64 or not q.is_contiguous() or not out.is_contiguous():
+        raise ValueError("latent absorb: shapes do not match kv_b's key rows")
+    if EXPAND_V2:                                                                   # patches/0390: same bits
+        bm, bk, warps = v2_tiles(R, "absorb")
+        _absorb2[(H * (L // 64), triton.cdiv(R, bm))](q, W, S, B, out, R, H=H, DQ=DQ, L=L, N=kv_k.n, IS_Q4=is_q4,
+                                                      BMR=bm, BK=bk, num_warps=warps, num_stages=1)
+        return out
+    _absorb[(triton.cdiv(R, BM), H, L // 64)](q, W, S, B, out, R, H=H, DQ=DQ, L=L, N=kv_k.n, IS_Q4=is_q4, BMR=BM,
+                                               num_warps=4)
+    return out
+
+
+@triton.jit
+def _expand(U, W, S, B, OUT, M, H: tl.constexpr, DV: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+            IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """Program (row tile, 64 output rows n of head h = n // DV): OUT[r, n] = bf16(sum_j u[r, h, j] W[n, j]), j in
+    64-wide groups in order (fp32 IEEE dots)."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    n0 = tl.program_id(1) * 64
+    h = n0 // DV
+    ok = rm < M
+    j = tl.arange(0, 64)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for g in range(L // 64):
+        x = tl.load(U + (rm[:, None] * H + h) * L + g * 64 + j[None, :], mask=ok[:, None], other=0.0)
+        wt = _wtile(W, S, B, n0, g, N, L, IS_Q4)                                     # [64 outputs n, 64 latent j]
+        acc = acc + tl.dot(x, tl.trans(wt), input_precision="ieee")
+    tl.store(OUT + rm[:, None] * N + n0 + j[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+def expand(u: torch.Tensor, kv_v: Q4 | B16, out: torch.Tensor) -> torch.Tensor:
+    """u [R, H, L] fp32 -> out [R, H DV] bf16: every head's output (the o_proj input)."""
+
+    R, H, L = u.shape
+    W, S, B, is_q4 = _parts(kv_v)
+    DV = kv_v.n // H
+    if kv_v.k != L or DV * H != kv_v.n or DV % 64 or out.shape != (R, kv_v.n) or not out.is_contiguous():
+        raise ValueError("latent expand: shapes do not match kv_b's value rows")
+    if EXPAND_V2:                                                                   # patches/0390: same bits
+        bm, bk, warps = v2_tiles(R, "expand")
+        _expand2[(kv_v.n // V2_BN, triton.cdiv(R, bm))](u, W, S, B, out, R, H=H, DV=DV, L=L, N=kv_v.n, IS_Q4=is_q4,
+                                                        BMR=bm, BN=V2_BN, BK=bk, num_warps=warps, num_stages=1)
+        return out
+    _expand[(triton.cdiv(R, BM), kv_v.n // 64)](u, W, S, B, out, R, H=H, DV=DV, L=L, N=kv_v.n, IS_Q4=is_q4, BMR=BM,
+                                               num_warps=4)
+    return out
+
+
+# -- patches/0390: absorb / expand retiled, v1's bits (GLM53_TF_MLA_EXPAND=v2) -----------------------------------------
+# (rows up to, rows a program, k a dot step, warps) by launch rows, per kernel. Any entry gives the same bits (every
+# output element is one FMA chain over k in order, independent of its tile-mates and of how k is cut into dot
+# steps), so this table only picks speed. Offline picks (ptxas for sm_121, Triton 3.7.1 = the image's: no spills,
+# <= 128 registers where 2 programs of 8 warps fit an SM; Triton 3.7 needs k >= 16 a dot); tests/cuda/bench_mla_expand.py
+# sweeps it on the GPU. 16-row programs for decode / verify / MTP windows (as many programs as v1), 64-128 rows for
+# prefill (4-8 x fewer dequantizations of kv_b than v1's 16).
+V2_TILES = {
+    "expand": ((16, 16, 16, 4), (32, 32, 16, 4), (1 << 62, 64, 16, 4)),              # W10 GPU sweep: 4 warps
+    "absorb": ((16, 16, 32, 4), (32, 32, 32, 4), (64, 64, 32, 4), (1 << 62, 64, 32, 4)),  # (bench_mla_expand --sweep)
+}
+V2_BN = 64               # expand's output rows a program (divides the head's DV)
+
+
+def v2_tiles(R: int, kind: str) -> tuple[int, int, int]:
+    """(rows a program, k a dot step, warps) of ``kind`` (expand / absorb) for a launch of R rows."""
+
+    for top, bm, bk, warps in V2_TILES[kind]:
+        if R <= top:
+            return bm, bk, warps
+    raise AssertionError(R)
+
+
+@triton.jit
+def _wcols(W, S, B, n0, g, c0, N: tl.constexpr, K: tl.constexpr, IS_Q4: tl.constexpr, BN: tl.constexpr,
+           BK: tl.constexpr):
+    """Rows n0 .. n0 + BN - 1, columns g 64 + c0 .. + BK - 1 (inside group g) of an [N, K] weight as fp32, each
+    element ``_wtile``'s value (s * q + b, or the BF16 value)."""
+
+    n = n0 + tl.arange(0, BN)
+    if IS_Q4 == 2:                                    # patches/0470
+        j = tl.arange(0, BK)
+        q = tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c0 + j)[None, :]).to(tl.float32)
+        s = tl.load(S + ((g * 64 + c0) // B) * N + n).to(tl.float32)
+        return q * s[:, None]
+    elif IS_Q4:
+        KG: tl.constexpr = K // 64
+        rw = tl.arange(0, BK // 8)
+        words = tl.load(W + ((n // 64) * (KG * 512) + g * 512 + (n % 64) * 8 + c0 // 8)[:, None] + rw[None, :])
+        shifts = tl.arange(0, 8) * 4
+        q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+        q = tl.reshape(q, (BN, BK)).to(tl.float32)
+        s = tl.load(S + g * N + n).to(tl.float32)
+        b = tl.load(B + g * N + n).to(tl.float32)
+        return q * s[:, None] + b[:, None]
+    else:
+        j = tl.arange(0, BK)
+        return tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c0 + j)[None, :]).to(tl.float32)
+
+
+@triton.jit
+def _wrows(W, S, B, n0, g, N: tl.constexpr, K: tl.constexpr, IS_Q4: tl.constexpr, BK: tl.constexpr):
+    """Rows n0 .. n0 + BK - 1 (inside one 64-row block), columns g 64 .. g 64 + 63 of an [N, K] weight as fp32, each
+    element ``_wtile``'s value."""
+
+    n = n0 + tl.arange(0, BK)
+    c = tl.arange(0, 64)
+    if IS_Q4 == 2:                                    # patches/0470
+        q = tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c)[None, :]).to(tl.float32)
+        s = tl.load(S + ((g * 64) // B) * N + n).to(tl.float32)
+        return q * s[:, None]
+    elif IS_Q4:
+        KG: tl.constexpr = K // 64
+        rw = tl.arange(0, 8)
+        words = tl.load(W + ((n // 64) * (KG * 512) + g * 512 + (n % 64) * 8)[:, None] + rw[None, :])
+        shifts = tl.arange(0, 8) * 4
+        q = (words[:, :, None] >> shifts[None, None, :]) & 0xF
+        q = tl.reshape(q, (BK, 64)).to(tl.float32)
+        s = tl.load(S + g * N + n).to(tl.float32)
+        b = tl.load(B + g * N + n).to(tl.float32)
+        return q * s[:, None] + b[:, None]
+    else:
+        return tl.load(W + n[:, None].to(tl.int64) * K + (g * 64 + c)[None, :]).to(tl.float32)
+
+
+@triton.jit
+def _absorb2(Q, W, S, B, QA, M, H: tl.constexpr, DQ: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+             IS_Q4: tl.constexpr, BMR: tl.constexpr, BK: tl.constexpr):
+    """``_absorb`` retiled. Program (head h and latent group g = program_id(0), row tile): QA[r, h, g 64 ..] =
+    bf16(sum_i q[r, h, i] W[h DQ + i, g 64 ..]), one fp32 FMA chain an element over i = 0 .. DQ - 1 in order (BK a
+    dot step); the 8 groups of a head are adjacent programs (they read the same q rows)."""
+
+    GL: tl.constexpr = L // 64
+    h = tl.program_id(0) // GL
+    g = tl.program_id(0) % GL
+    rm = tl.program_id(1) * BMR + tl.arange(0, BMR)
+    ok = rm < M
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for it in range(DQ // 64):
+        for kk in tl.static_range(64 // BK):
+            x = tl.load(Q + (rm[:, None] * H + h) * DQ + it * 64 + kk * BK + k[None, :], mask=ok[:, None], other=0.0)
+            wt = _wrows(W, S, B, h * DQ + it * 64 + kk * BK, g, N, L, IS_Q4, BK)      # [BK inputs i, 64 latent j]
+            acc = tl.dot(x.to(tl.float32), wt, acc, input_precision="ieee")
+    j = tl.arange(0, 64)
+    tl.store(QA + (rm[:, None] * H + h) * L + g * 64 + j[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+@triton.jit
+def _expand2(U, W, S, B, OUT, M, H: tl.constexpr, DV: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+             IS_Q4: tl.constexpr, BMR: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):
+    """``_expand`` retiled. Program (BN output rows n of head h = n // DV, row tile): OUT[r, n] = bf16(sum_j u[r, h, j]
+    W[n, j]), one fp32 FMA chain an element over j = 0 .. L - 1 in order (BK a dot step); the DV / BN programs of a
+    head are adjacent (they read the same u rows)."""
+
+    n0 = tl.program_id(0) * BN
+    h = n0 // DV
+    rm = tl.program_id(1) * BMR + tl.arange(0, BMR)
+    ok = rm < M
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BMR, BN), dtype=tl.float32)
+    for g in range(L // 64):
+        for kk in tl.static_range(64 // BK):
+            x = tl.load(U + (rm[:, None] * H + h) * L + g * 64 + kk * BK + k[None, :], mask=ok[:, None], other=0.0)
+            wt = _wcols(W, S, B, n0, g, kk * BK, N, L, IS_Q4, BN, BK)                 # [BN outputs n, BK latent j]
+            acc = tl.dot(x, tl.trans(wt), acc, input_precision="ieee")
+    o = tl.arange(0, BN)
+    tl.store(OUT + rm[:, None] * N + n0 + o[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+# -- patches/0083: tensor-core absorb / expand for FP8 fast prefill chunks ---------------------------------------------
+@triton.jit
+def _absorb_tc(Q, W, S, B, QA, M, H: tl.constexpr, DQ: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+               IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """``_absorb`` on bf16 tensor cores: the kv_b key tile dequantized exactly in fp32 then rounded to bf16, BMR rows a
+    program; fp32 sums over the head's inputs in 64-wide steps, in order."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    h = tl.program_id(1)
+    g = tl.program_id(2)
+    ok = rm < M
+    k = tl.arange(0, 64)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for it in range(DQ // 64):
+        x = tl.load(Q + (rm[:, None] * H + h) * DQ + it * 64 + k[None, :], mask=ok[:, None], other=0.0)
+        wt = _wtile(W, S, B, h * DQ + it * 64, g, N, L, IS_Q4).to(tl.bfloat16)      # [64 inputs i, 64 latent j]
+        acc = tl.dot(x.to(tl.bfloat16), wt, acc)
+    tl.store(QA + (rm[:, None] * H + h) * L + g * 64 + k[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+def absorb_tc(q: torch.Tensor, kv_k: Q4 | B16, out: torch.Tensor) -> torch.Tensor:
+    """``absorb`` for FP8 fast prefill chunks (patches/0083): bf16 tensor cores, 64-row tiles. Row-independent and
+    deterministic; not ``absorb``'s bits."""
+
+    R, H, DQ = q.shape
+    L = out.shape[2]
+    W, S, B, is_q4 = _parts(kv_k)
+    if kv_k.n != H * DQ or kv_k.k != L or DQ % 64 or L % 64 or not q.is_contiguous() or not out.is_contiguous():
+        raise ValueError("latent absorb: shapes do not match kv_b's key rows")
+    _absorb_tc[(triton.cdiv(R, TC_ROWS), H, L // 64)](q, W, S, B, out, R, H=H, DQ=DQ, L=L, N=kv_k.n, IS_Q4=is_q4,
+                                                      BMR=TC_ROWS, num_warps=4, num_stages=2)
+    return out
+
+
+@triton.jit
+def _expand_tc(U, W, S, B, OUT, M, H: tl.constexpr, DV: tl.constexpr, L: tl.constexpr, N: tl.constexpr,
+               IS_Q4: tl.constexpr, BMR: tl.constexpr):
+    """``_expand`` on bf16 tensor cores: u rounded to bf16, the kv_b value tile dequantized in fp32 then rounded to
+    bf16, BMR rows a program; fp32 sums over the latent in 64-wide groups, in order."""
+
+    rm = tl.program_id(0) * BMR + tl.arange(0, BMR)
+    n0 = tl.program_id(1) * 64
+    h = n0 // DV
+    ok = rm < M
+    j = tl.arange(0, 64)
+    acc = tl.zeros((BMR, 64), dtype=tl.float32)
+    for g in range(L // 64):
+        x = tl.load(U + (rm[:, None] * H + h) * L + g * 64 + j[None, :], mask=ok[:, None], other=0.0)
+        wt = _wtile(W, S, B, n0, g, N, L, IS_Q4).to(tl.bfloat16)                      # [64 outputs n, 64 latent j]
+        acc = tl.dot(x.to(tl.bfloat16), tl.trans(wt), acc)
+    tl.store(OUT + rm[:, None] * N + n0 + j[None, :], acc.to(tl.bfloat16), mask=ok[:, None])
+
+
+def expand_tc(u: torch.Tensor, kv_v: Q4 | B16, out: torch.Tensor) -> torch.Tensor:
+    """``expand`` for FP8 fast prefill chunks (patches/0083): bf16 tensor cores, 64-row tiles. Row-independent and
+    deterministic; not ``expand``'s bits."""
+
+    R, H, L = u.shape
+    W, S, B, is_q4 = _parts(kv_v)
+    DV = kv_v.n // H
+    if kv_v.k != L or DV * H != kv_v.n or DV % 64 or out.shape != (R, kv_v.n) or not out.is_contiguous():
+        raise ValueError("latent expand: shapes do not match kv_b's value rows")
+    _expand_tc[(triton.cdiv(R, TC_ROWS), kv_v.n // 64)](u, W, S, B, out, R, H=H, DV=DV, L=L, N=kv_v.n, IS_Q4=is_q4,
+                                                       BMR=TC_ROWS, num_warps=4, num_stages=2)
+    return out
+
+
+# -- the latent cache ---------------------------------------------------------------------------------------------
+@triton.jit
+def _prow(rows, PT, PSH: tl.constexpr, ok):
+    """patches/0290: logical rows (int64) -> physical rows through a slot's page table (PSH = log2 rows a page);
+    PSH = 0: a contiguous cache, rows unchanged (the branch is not compiled). Masked like the access it serves."""
+
+    if PSH > 0:
+        if ok is None:                                    # a scalar row (writers): always mapped
+            pg = tl.load(PT + (rows >> PSH)).to(tl.int64)
+        else:
+            pg = tl.load(PT + (rows >> PSH), mask=ok, other=0).to(tl.int64)
+        rows = (pg << PSH) + (rows & ((1 << PSH) - 1))
+    return rows
+
+
+@triton.jit
+def _lwrite(LAT, LC, POS, L: tl.constexpr, PT=None, PSH: tl.constexpr = 0):
+    r = tl.program_id(0)
+    P = tl.load(POS).to(tl.int64)
+    d = tl.arange(0, L)
+    row = _prow(P + r, PT, PSH, None)
+    tl.store(LC + row * L + d, tl.load(LAT + r * L + d))
+
+
+@triton.jit
+def _lwrite8(LAT, LC, LCS, POS, L: tl.constexpr, RB: tl.constexpr, SB: tl.constexpr, SA: tl.constexpr, PT=None,
+             PSH: tl.constexpr = 0):
+    """patches/0220: row r quantized on its own: s = 2^e, the smallest power of two with amax / s <= 448 (448 =
+    1.75 x 2^8, so e = E - 135, + 1 when amax's mantissa exceeds 1.75), values x / s (exact) rounded to nearest-even
+    e4m3 (never saturating: |x / s| <= 448); an all-zero row stores zeros and s = 1. torch's float8_e4m3fn
+    conversion gives the same bytes (``quantize_rows_reference``)."""
+
+    r = tl.program_id(0)
+    P = tl.load(POS).to(tl.int64)
+    d = tl.arange(0, L)
+    x = tl.load(LAT + r * L + d).to(tl.float32)
+    amax = tl.max(tl.abs(x), 0)
+    bits = amax.to(tl.int32, bitcast=True)
+    e = ((bits >> 23) & 0xFF) - 135 + ((bits & 0x7FFFFF) > 0x600000).to(tl.int32)
+    e = tl.where(amax > 0.0, e, 0)
+    e = tl.minimum(tl.maximum(e, -126), 126)
+    scale = ((e + 127) << 23).to(tl.float32, bitcast=True)
+    inv = ((127 - e) << 23).to(tl.float32, bitcast=True)
+    # rounded to the e4m3 grid here, to nearest even, in fp32 (normal range: 3 mantissa bits; below 2^-6 the fixed
+    # 2^-9 step, by adding and subtracting 1.5 x 2^14); the conversion then only relabels exact values, whatever
+    # rounding (or double rounding through fp16) the compiler's cvt would do
+    y = x * inv
+    yb = y.to(tl.int32, bitcast=True)
+    near = ((yb + 0x7FFFF + ((yb >> 20) & 1)) & -1048576).to(tl.float32, bitcast=True)
+    a = tl.abs(y)
+    small = (a + 24576.0) - 24576.0
+    small = (small.to(tl.int32, bitcast=True) | (yb & -2147483648)).to(tl.float32, bitcast=True)   # y's sign (-0 too)
+    y = tl.where(a < 0.015625, small, near)
+    q = y.to(tl.float8e4nv).to(tl.uint8, bitcast=True)
+    pr = _prow(P + r, PT, PSH, None)                     # patches/0290: the row's physical slot
+    tl.store(LC + pr * RB + d, q)
+    tl.store(LCS + pr * SB + SA, scale)
+
+
+def latent_write(lat: torch.Tensor, lc: torch.Tensor, pos: torch.Tensor) -> None:
+    """Rows [R, L] into cache slots pos .. pos + R - 1 (pos read on the device). patches/0220: an FP8 cache stores
+    each row quantized on its own (``_lwrite8``)."""
+
+    R, L = lat.shape
+    if not lat.is_contiguous():
+        raise ValueError("latent_write: rows must be contiguous and as wide as the cache")
+    lcv, lcs, f8, rb, sb = _views(lc, L)
+    pg = _paging(lc)                                        # patches/0290
+    if f8:
+        _lwrite8[(R,)](lat, lcv, lcs, pos, L=L, RB=rb, SB=sb, SA=SCALE_AT // 4, num_warps=4, **pg)
+        return
+    _lwrite[(R,)](lat, lcv, pos, L=L, num_warps=4, **pg)
+
+
+# -- attention in latent space ------------------------------------------------------------------------------------
+@triton.jit
+def _lrows(LC, LCS, rows, ok, d, FP8: tl.constexpr, RB: tl.constexpr, SB: tl.constexpr, SA: tl.constexpr, PT,
+           PSH: tl.constexpr):
+    """Latent rows ``rows`` (int64, masked by ``ok``) as bf16 [n, L]. patches/0220: FP8 rows dequantized, e4m3 x 2^k
+    (exact in bf16: the bf16 kernels' inputs are the dequantized rows, bit for bit). patches/0290: logical rows of a
+    paged cache mapped first (PSH 0: unchanged)."""
+
+    rows = _prow(rows, PT, PSH, ok)
+    if FP8:
+        v = tl.load(LC + rows[:, None] * RB + d[None, :], mask=ok[:, None], other=0)
+        s = tl.load(LCS + rows * SB + SA, mask=ok, other=0.0)
+        return (v.to(tl.float8e4nv, bitcast=True).to(tl.float32) * s[:, None]).to(tl.bfloat16)
+    else:
+        return tl.load(LC + rows[:, None] * RB + d[None, :], mask=ok[:, None], other=0).to(tl.bfloat16)
+
+
+@triton.jit
+def _ltile(q, kv, m, l, o, valid, SCALE: tl.constexpr):
+    """One tile of latent rows (keys = values) for BM queries: the expanded kernel's online softmax step."""
+
+    scores = tl.dot(q, tl.trans(kv)).to(tl.float32) * SCALE
+    scores = tl.where(valid, scores, float("-inf"))
+    tile_m = tl.max(scores, 1)
+    active = tile_m != float("-inf")
+    next_m = tl.where(active, tl.maximum(m, tile_m), m)
+    alpha = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+    p = tl.where(valid & active[:, None], tl.exp(scores - next_m[:, None]), 0.0)
+    o = o * alpha[:, None] + tl.dot(p.to(tl.bfloat16), kv)
+    l = l * alpha + tl.sum(p, 1)
+    return next_m, l, o
+
+
+@triton.jit
+def _lchunks(QA, LC, LCS, POS, PO, PM, PL, R, H: tl.constexpr, L: tl.constexpr, CH: tl.constexpr, KTS: tl.constexpr,
+             SCALE: tl.constexpr, BMQ: tl.constexpr, FP8: tl.constexpr = False, RB: tl.constexpr = 0,
+             SB: tl.constexpr = 0, SA: tl.constexpr = 0, PT=None, PSH: tl.constexpr = 0):
+    """Program (query tile, chunk c): queries i = (row r, head h) flattened as r H + h, 16 to a tile; keys
+    c CH .. c CH + CH - 1 of the latent cache, row r seeing keys up to pos + r."""
+
+    ib = tl.program_id(0)
+    c = tl.program_id(1)
+    P = tl.load(POS)
+    i = ib * BMQ + tl.arange(0, BMQ)
+    iok = i < R * H
+    r = i // H
+    d = tl.arange(0, L)
+    m = tl.full((BMQ,), float("-inf"), tl.float32)
+    l = tl.zeros((BMQ,), tl.float32)
+    o = tl.zeros((BMQ, L), tl.float32)
+    start = c * CH
+    if start < P + R:
+        q = tl.load(QA + i[:, None] * L + d[None, :], mask=iok[:, None], other=0).to(tl.bfloat16)
+        limit = P + r
+        for t in range(CH // KTS):
+            ki = start + t * KTS + tl.arange(0, KTS)
+            inside = ki < P + R
+            kv = _lrows(LC, LCS, ki.to(tl.int64), inside, d, FP8, RB, SB, SA, PT, PSH)
+            valid = (ki[None, :] <= limit[:, None]) & iok[:, None]
+            m, l, o = _ltile(q, kv, m, l, o, valid, SCALE)
+    base = c * (R * H) + i
+    tl.store(PO + base[:, None].to(tl.int64) * L + d[None, :], o, mask=iok[:, None])
+    tl.store(PM + base, m, mask=iok)
+    tl.store(PL + base, l, mask=iok)
+
+
+@triton.jit
+def _lmerge(PO, PM, PL, OUT, RH, L: tl.constexpr, NCH: tl.constexpr):
+    """Program i (row, head): chunk partials merged in chunk order -> OUT[i] = o / l (fp32)."""
+
+    i = tl.program_id(0)
+    d = tl.arange(0, L)
+    m = float("-inf")
+    l = 0.0
+    o = tl.zeros((L,), tl.float32)
+    for c in range(NCH):
+        base = c * RH + i
+        cm = tl.load(PM + base)
+        cl = tl.load(PL + base)
+        co = tl.load(PO + base.to(tl.int64) * L + d)
+        active = cl > 0.0
+        next_m = tl.where(active, tl.maximum(m, cm), m)
+        a = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+        b = tl.where(active, tl.exp(cm - next_m), 0.0)
+        o = o * a + co * b
+        l = l * a + cl * b
+        m = next_m
+    tl.store(OUT + i.to(tl.int64) * L + d, o / l)
+
+
+def attention_latent(qa: torch.Tensor, lc: torch.Tensor, pos: torch.Tensor, scratch: Scratch, *, scale: float,
+                     nch: int | None = None, out: torch.Tensor | None = None, bm: int = BM,
+                     stages: int = 1) -> torch.Tensor:
+    """qa [R, H, L] bf16 (rows at positions pos .. pos + R - 1), lc [capacity, L] holding latents through
+    pos + R - 1 -> [R, H, L] fp32 (``out``, default scratch.u[:R]). ``nch``: chunks to visit (default: every chunk
+    the scratch holds, which covers every dense context; captured graphs use that)."""
+
+    R, H, L = qa.shape
+    if nch is None:
+        nch = scratch.nch
+    elif nch > scratch.nch:
+        raise ValueError(f"latent attention: {nch} chunks of keys, the scratch holds {scratch.nch} (dense attention "
+                         "runs only within DSA's dense limit)")
+    if R > scratch.rows or H != scratch.heads or L != scratch.lat or not qa.is_contiguous():
+        raise ValueError("unsupported latent attention shape")
+    RH = R * H
+    po = scratch.po[:nch * RH * L]
+    pm = scratch.pm[:nch * RH]
+    pl = scratch.pl[:nch * RH]
+    lcv, lcs, f8, rb, sb = _views(lc, L)                    # patches/0220: FP8 rows or bf16 rows
+    _lchunks[(triton.cdiv(RH, bm), nch)](qa, lcv, lcs, pos, po, pm, pl, R, H=H, L=L, CH=CHUNK, KTS=KT, SCALE=scale,
+                                         BMQ=bm, FP8=f8, RB=rb, SB=sb, SA=SCALE_AT // 4,
+                                         num_warps=ATTN_WARPS, num_stages=stages, **_paging(lc))    # patches/0290
+    if out is None:
+        out = scratch.u[:R]
+    elif out.shape != (R, H, L) or out.dtype != torch.float32 or not out.is_contiguous():
+        raise ValueError("attention_latent: out must be contiguous fp32 [R, H, L]")
+    _lmerge[(RH,)](po, pm, pl, out, RH, L=L, NCH=nch, num_warps=4)
+    return out
+
+
+@triton.jit
+def _lsparse_chunks(QA, LC, LCS, TOK, CNT, PO, PM, PL, RS, W: tl.constexpr, H: tl.constexpr, L: tl.constexpr,
+                    CH: tl.constexpr, KTS: tl.constexpr, SCALE: tl.constexpr, BMQ: tl.constexpr,
+                    FP8: tl.constexpr = False, RB: tl.constexpr = 0, SB: tl.constexpr = 0, SA: tl.constexpr = 0,
+                    PT=None, PSH: tl.constexpr = 0):
+    """Program (row r, head tile, chunk c): the row's selected tokens [c CH, (c + 1) CH) in list order for 16 of its
+    heads at once (the tile's latent rows are read once for all of them)."""
+
+    r = tl.program_id(0)
+    hb = tl.program_id(1)
+    c = tl.program_id(2)
+    n = tl.load(CNT + r)
+    h = hb * BMQ + tl.arange(0, BMQ)
+    hok = h < H
+    d = tl.arange(0, L)
+    m = tl.full((BMQ,), float("-inf"), tl.float32)
+    l = tl.zeros((BMQ,), tl.float32)
+    o = tl.zeros((BMQ, L), tl.float32)
+    if c * CH < n:
+        q = tl.load(QA + (r * H + h[:, None]) * L + d[None, :], mask=hok[:, None], other=0).to(tl.bfloat16)
+        for t in range(CH // KTS):
+            idx = c * CH + t * KTS + tl.arange(0, KTS)
+            ok = idx < n
+            tok = tl.load(TOK + r * W + idx, mask=ok, other=0).to(tl.int64)
+            kv = _lrows(LC, LCS, tok, ok, d, FP8, RB, SB, SA, PT, PSH)
+            valid = ok[None, :] & hok[:, None]
+            m, l, o = _ltile(q, kv, m, l, o, valid, SCALE)
+    base = (c * RS + r) * H + h
+    tl.store(PO + base[:, None].to(tl.int64) * L + d[None, :], o, mask=hok[:, None])
+    tl.store(PM + base, m, mask=hok)
+    tl.store(PL + base, l, mask=hok)
+
+
+@triton.jit
+def _lsparse_merge(PO, PM, PL, OUT, CNT, RS, H: tl.constexpr, L: tl.constexpr, NCH: tl.constexpr, CH: tl.constexpr):
+    r = tl.program_id(0)
+    h = tl.program_id(1)
+    n = tl.load(CNT + r)
+    if n == 0:
+        return
+    d = tl.arange(0, L)
+    m = float("-inf")
+    l = 0.0
+    o = tl.zeros((L,), tl.float32)
+    for c in range(NCH):
+        if c * CH < n:
+            base = (c * RS + r) * H + h
+            cm = tl.load(PM + base)
+            cl = tl.load(PL + base)
+            co = tl.load(PO + base.to(tl.int64) * L + d)
+            active = cl > 0.0
+            next_m = tl.where(active, tl.maximum(m, cm), m)
+            a = tl.where(active, tl.where(m == float("-inf"), 0.0, tl.exp(m - next_m)), 1.0)
+            b = tl.where(active, tl.exp(cm - next_m), 0.0)
+            o = o * a + co * b
+            l = l * a + cl * b
+            m = next_m
+    tl.store(OUT + (r * H + h).to(tl.int64) * L + d, o / l)
+
+
+def sparse_latent(qa: torch.Tensor, lc: torch.Tensor, tokens: torch.Tensor, counts: torch.Tensor, out: torch.Tensor,
+                  scale: float, part=None, *, bm: int = BM, stages: int = 1) -> None:
+    """Rows with counts > 0: latent attention over their selected tokens (``sparse.select_tokens``), written into
+    ``out`` [R, H, L] fp32 (other rows untouched). ``part``: preallocated partials (``Scratch.sparse_part``)."""
+
+    R, H, L = qa.shape
+    W = tokens.shape[1]
+    nch = triton.cdiv(W, CHUNK)
+    if part is not None and part[1].numel() == nch * R * H:
+        po, pm, pl = part
+    else:
+        po = torch.empty((nch * R * H * L,), dtype=torch.float32, device=qa.device)
+        pm = torch.empty((nch * R * H,), dtype=torch.float32, device=qa.device)
+        pl = torch.empty((nch * R * H,), dtype=torch.float32, device=qa.device)
+    lcv, lcs, f8, rb, sb = _views(lc, L)                    # patches/0220: FP8 rows or bf16 rows
+    _lsparse_chunks[(R, triton.cdiv(H, bm), nch)](qa, lcv, lcs, tokens, counts, po, pm, pl, R, W=W, H=H, L=L, CH=CHUNK,
+                                                  KTS=KT, SCALE=scale, BMQ=bm, FP8=f8, RB=rb, SB=sb, SA=SCALE_AT // 4,
+                                                  num_warps=ATTN_WARPS, num_stages=stages,
+                                                  **_paging(lc))                             # patches/0290
+    _lsparse_merge[(R, H)](po, pm, pl, out, counts, R, H=H, L=L, NCH=nch, CH=CHUNK, num_warps=4)
+
+
+# -- the DSA block --------------------------------------------------------------------------------------------------
+def _project(layer, w, b, T: int) -> None:
+    """Row-local projections of T rows: [q_a | kv_a], both norms, q_b, and the queries absorbed into latent space."""
+
+    c = w.cfg
+    a = layer.dsa
+    s = b.attn
+    qmm.matmul(b.normed[:T], a.proj, b.xs[:T], out=b.dp[:T], part=b.sk)
+    glue.rmsnorm(b.dp[:T, :c.q_lora], a.q_norm, c.eps, b.qr[:T], b.xs_qr[:T])
+    glue.rmsnorm(b.dp[:T, c.q_lora:], a.kv_norm, c.eps, b.lat[:T], b.xs_lat[:T])
+    qmm.matmul(b.qr[:T], a.q_b, b.xs_qr[:T], out=b.q[:T].view(T, a.heads * c.qk_dim), part=b.sk)
+    (absorb_tc if tc(b) else absorb)(b.q[:T], a.kv_k, s.qa[:T])               # patches/0083, 0190
+
+
+def _attend(layer, w, lc, pos_dev, b, o: int, R: int, nch, index, host_pos, npb=None) -> None:
+    """One sequence's rows o .. o + R - 1: latent cache write, indexer caches, dense and/or sparse attention into
+    b.attn.u. The expanded ``dsa_block``'s control flow (with patches/0050's ``npb``: every row sparse, selection
+    on the device into ``b.lc``, capturable), on the latent."""
+
+    c = w.cfg
+    a = layer.dsa
+    s = b.attn
+    latent_write(b.lat[o:o + R], lc, pos_dev)
+    if profile.ON:
+        profile.lap("dsa.proj")
+    scale = c.qk_dim ** -0.5
+    sparse_rows = index is not None and host_pos is not None and host_pos + R - 1 >= c.dense_limit
+    if npb is not None and index is None:
+        raise ValueError("dsa_block: a long-context step needs the indexer caches")
+    every_sparse = npb is not None or (sparse_rows and host_pos >= c.dense_limit)
+    sparse_rows = sparse_rows or npb is not None
+    ix = a.index
+    if index is not None:
+        ik, ig, pk = index
+        sparse.index_update(b.ikr[o:o + R, :c.index_dim], b.igr[o:o + R], ix.ln_w, ix.ln_b, ix.ape, ik, ig, pk, pos_dev)
+        if profile.ON:
+            profile.lap("dsa.indexer")
+    u = s.u[o:o + R]
+    tile = dict(bm=FAST_BM, stages=FAST_STAGES) if fast8(b) else {}           # patches/0083
+    if not tile and BF16_BM32 and bool(getattr(b, "fast", False)):               # patches/0190: bf16 fast chunks
+        tile = dict(bm=FAST_BM, stages=FAST_STAGES)
+    if not every_sparse:                                           # every row sparse: the dense pass is skipped
+        attention_latent(s.qa[o:o + R], lc, pos_dev, s, scale=scale, nch=nch, out=u, **tile)
+        if profile.ON:
+            profile.lap("dsa.attn")
+    if sparse_rows:
+        qmm.matmul(b.qr[o:o + R], ix.qb, b.xs_qr[o:o + R], out=b.qi[o:o + R], part=b.sk)
+        if npb is not None:
+            tokens, counts = sparse.select_tokens_dev(b.qi[o:o + R], b.ikr[o:o + R, c.index_dim:], pk, pos_dev, R,
+                                                      npb, b.lc)
+        else:
+            np_max = pk.shape[0] - 2
+            if w.meta.get("longctx_bound"):            # patches/0050: score only the pools that exist
+                np_max = sparse.pool_bucket(host_pos + R, np_max)
+            tokens, counts = sparse.select_tokens(b.qi[o:o + R], b.ikr[o:o + R, c.index_dim:], pk, host_pos, R,
+                                                  np_max, pos_dev)
+        if profile.ON:
+            profile.lap("dsa.indexer")
+        if SPARSE_ONE and bool(getattr(b, "fast", False)):          # patches/0240: one pass a row, no partials
+            from . import b12x_attn
+
+            b12x_attn.sparse_latent_one(s.qa[o:o + R], lc, tokens, counts, u, scale)
+        else:
+            sparse_latent(s.qa[o:o + R], lc, tokens, counts, u, scale, s.sparse_part(R), **tile)
+        if profile.ON:
+            profile.lap("dsa.sparse_attn")
+
+
+def _index_proj(layer, w, b, T: int) -> None:
+    c = w.cfg
+    ix = layer.dsa.index
+    qmm.matmul(b.normed[:T], ix.kw, b.xs[:T], out=b.ikr[:T], part=b.sk)
+    glue.router(b.normed[:T], ix.gate, b.igr[:T])
+
+
+def _output(layer, w, b, T: int) -> torch.Tensor:
+    from .forward import out_proj
+
+    a = layer.dsa
+    s = b.attn
+    o = (expand_tc if tc(b) else expand)(s.u[:T], a.kv_v, s.o[:T])             # patches/0083, 0190
+    return out_proj(w, b, o, a.o, qmm.group_sums(o, b.xs_ao[:T]), T, "dsa.o_proj")
+
+
+def dsa_block_latent(layer, w, lc: torch.Tensor, pos_dev: torch.Tensor, b, R: int, nch: int | None, index=None,
+                     host_pos: int | None = None, npb: int | None = None) -> torch.Tensor:
+    """``forward.dsa_block`` on the latent cache ``lc`` [capacity, kv_lora] (same arguments, same contract)."""
+
+    _project(layer, w, b, R)
+    if index is not None:
+        _index_proj(layer, w, b, R)
+    l2pf.mark(w, layer, "o", R)         # patches/0460: kv_v + o_proj into L2 during the attention core
+    _attend(layer, w, lc, pos_dev, b, 0, R, nch, index, host_pos, npb)
+    return _output(layer, w, b, R)
+
+
+def dsa_multi(layer, w, sts, b, Rs, offs, T: int, nchs, host_pos) -> torch.Tensor:
+    """``batch._dsa`` on latent caches: projections, absorption and expansion once over all T rows, cache and
+    attention per sequence."""
+
+    _project(layer, w, b, T)
+    indexed = sts[0].index is not None
+    if indexed:
+        _index_proj(layer, w, b, T)
+    l2pf.mark(w, layer, "o", T)         # patches/0460
+    for i, (st, R, o) in enumerate(zip(sts, Rs, offs)):
+        di = st.dsa_index[layer.index]
+        _attend(layer, w, st.kc[di], st.pos_dev, b, o, R, nchs[i] if nchs is not None else None,
+                st.index[di] if indexed else None, host_pos[i] if host_pos is not None else None)
+    return _output(layer, w, b, T)
+
+
+# -- reference (tests): the same attention through expanded per-head keys and values ---------------------------
+def expanded_reference(q: torch.Tensor, lat: torch.Tensor, kv_k: Q4 | B16, kv_v: Q4 | B16, scale: float,
+                       limits: list[int]) -> torch.Tensor:
+    """fp32 reference on the host side of a test: q [R, H, DQ], cache latents lat [T, L]; row r sees rows
+    0 .. limits[r]. Keys/values expanded per head from kv_b (dequantized, fp32) -> head outputs [R, H DV] fp32."""
+
+    wk = qmm.dequantize_any(kv_k)                                                   # patches/0470: Q8 too
+    wv = qmm.dequantize_any(kv_v)
+    R, H, DQ = q.shape
+    DV = wv.shape[0] // H
+    k = (lat.float() @ wk.t()).view(-1, H, DQ)
+    v = (lat.float() @ wv.t()).view(-1, H, DV)
+    out = torch.empty((R, H, DV), dtype=torch.float32, device=q.device)
+    for r in range(R):
+        n = limits[r] + 1
+        s = torch.einsum("hd,thd->ht", q[r].float(), k[:n]) * scale
+        p = torch.softmax(s, dim=-1)
+        out[r] = torch.einsum("ht,thd->hd", p, v[:n])
+    return out.view(R, H * DV)
