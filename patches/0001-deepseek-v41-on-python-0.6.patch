index 0000000..7c907a0
--- /dev/null
+++ b/tests/test_dsv41_xovl.py
@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_XOVL`` on the CPU (no GPU): a prefill segment's exchanges by row halves.
+
+- TP=2 (two ranks on threads): XOVL on == off bit for bit (the verify row's logits after the prompt and every stored
+  state of both ranks), with fp32 and bf16 prefill exchanges, with and without ``TF_DSV41_PF_COPIES``, one segment
+  and several; every prefill exchange really went in two halves (both ranks issue the same gathers in order), the
+  Engram posts and the final post took the halves, and verify rows never split;
+- the gate: off by default, the row floor, prefill runs only; the halves (the first a multiple of 16 rows); the row
+  views of the coefficients / scratch write the caller's rows.
+
+Run: python -m pytest -q tests/test_dsv41_xovl.py
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import json  # noqa: E402
+
+import dsv41_fakes as FK  # noqa: E402
+from test_dsv41_pf16 import IDS, make, state  # noqa: E402  (the builders)
+
+from tensorfold.families.deepseek_v41.cuda import xovl as XO  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41xovl"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def pair(ckpt, monkeypatch, *, xovl: bool, bf16: bool, copies: bool, pchunk: int = 36):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_PF_XOVL", "1" if xovl else "0")
+    monkeypatch.setenv("TF_DSV41_PF_XOVL_ROWS", "32")
+    monkeypatch.setenv("TF_DSV41_PF_COPIES", "1" if copies else "0")
+    p = FK.ThreadPair()
+    comms = p.comms()
+    fws = [make(ckpt, r, 2, comms[r], pchunk) for r in range(2)]
+    seen: list[list] = [[], []]
+    for r, fw in enumerate(fws):
+        fw.gather_bf16 = bf16
+        real = fw.gather_partials
+
+        def spy(partial, wide=False, real=real, r=r):
+            if not wide:
+                seen[r].append(int(partial.shape[0]))
+            return real(partial, wide)
+
+        fw.gather_partials = spy
+
+    def go(fw):
+        fw.prefill([Piece(0, 0, tuple(IDS[:-1]))])
+        return fw.step([IDS[-1]]), state(fw)
+
+    return p.run([lambda f=f: go(f) for f in fws]), seen
+
+
+@pytest.mark.parametrize("bf16,copies", [(False, False), (True, False), (True, True)])
+def test_xovl_tp2_same_bits(ckpt, monkeypatch, bf16, copies):
+    got, seen = pair(ckpt, monkeypatch, xovl=True, bf16=bf16, copies=copies)
+    want, seen0 = pair(ckpt, monkeypatch, xovl=False, bf16=bf16, copies=copies)
+    assert seen[0] == seen[1]                               # both ranks: the same gathers in the same order
+    assert 36 not in seen[0] and seen[0].count(16) == seen[0].count(20) > 0     # every prefill exchange in halves
+    assert 36 in seen0[0] and 16 not in seen0[0]
+    assert all(n <= 4 for n in seen[0] if n not in (16, 20))                     # verify rows never split
+    for (lg, st), (lw, sw) in zip(got, want):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
+
+
+def test_xovl_chunked_same_bits(ckpt, monkeypatch):
+    """8-row segments sit under the row floor (no split) and give the same bits as one split 36-row segment."""
+
+    got, seen = pair(ckpt, monkeypatch, xovl=True, bf16=True, copies=True, pchunk=8)
+    one, _ = pair(ckpt, monkeypatch, xovl=True, bf16=True, copies=True, pchunk=36)
+    assert 16 not in seen[0]
+    for (lg, st), (lw, sw) in zip(got, one):
+        assert torch.equal(lg, lw)
+        for k in sw:
+            assert torch.equal(st[k], sw[k]), k
+
+
+def test_gate_and_halves(monkeypatch):
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+
+    fw = SimpleNamespace(world=2, chunk=128)
+    monkeypatch.delenv("TF_DSV41_PF_XOVL", raising=False)
+    with PM.fast(True):
+        assert not XO.active(fw, 2048)
+        monkeypatch.setenv("TF_DSV41_PF_XOVL", "1")
+        assert XO.active(fw, 2048) and not XO.active(fw, 511)
+        assert not XO.active(SimpleNamespace(world=1, chunk=128), 2048)
+    assert not XO.active(fw, 2048)                          # not a fast prefill run
+    assert XO.spans(2048) == [(0, 1024), (1024, 2048)]
+    assert XO.spans(2047) == [(0, 1008), (1008, 2047)]
+    monkeypatch.setenv("TF_DSV41_PF_XOVL_ROWS", "8")
+    with pytest.raises(ValueError):
+        XO.min_rows()
+
+
+def test_views_write_the_callers_rows():
+    from tensorfold.families.deepseek_v41.cuda import mhc
+
+    c = mhc.Coefs(10, "cpu")
+    v = XO.coefs_view(c, 4, 7)
+    v.pre[:] = 1.0
+    v.comb[:] = 2.0
+    assert c.pre[4:7].eq(1).all() and c.pre[:4].eq(0).all() and c.comb[4:7].eq(2).all()
+    s = mhc.Scratch(10, "cpu", 640)
+    w = XO.scratch_view(s, 2, 9)
+    assert w.rows == 7 and w.part.data_ptr() == s.part[2].data_ptr() and w.c.data_ptr() == s.c[2].data_ptr()
+    assert s.rows == 10
