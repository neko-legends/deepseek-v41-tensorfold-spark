--- /dev/null
+++ b/tests/test_dsv41_moe_fused_g14.py
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G14's moe_fused variants on the CPU (tests/dsv41_moe_fused_emu.py), each the production path's bits:
+
+- TAIL=fast's cross-lane argmax (two redux.sync over an order-preserving key) == b1's shuffle butterfly, lane by lane,
+  on random rows and on the edges: ties (equal scores, +0 / -0), -inf biases, NaN scores, rows with fewer than K
+  candidates, E 128 / 384 / 512; and both == the reference order (score desc, id asc) where every score is finite;
+- the fast tail's static task assignment: no deadlock for any dispatch order at capacity >= help + 1, every rot_in
+  task exactly once, counters back to 0 (the same bound as b1's claims);
+- SHARED=inline: the fused kernel's grouping (ids < E + 1) and rot_in (slots < K + 1, ids < E + 1) are upstream's
+  group_kernel / rot_in_kernel over the whole table (the production path), pruned slots (id E + 1) in neither;
+- the knobs, eligibility and describe.
+"""
+
+from __future__ import annotations
+
+from dsv41_interp import interpret
+
+interpret()                                 # prune.py imports triton: the interpreter suites need it set first
+
+import dsv41_moe_fused_emu as EM
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import moe_fused as MF
+from tensorfold.families.deepseek_v41.cuda import prune as PR
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+F32 = np.float32
+
+
+def _ch(E, rng, kind):
+    """(scores, bias) fp32 [E] of one row, shaped by ``kind``."""
+
+    s = np.sqrt(RG.softplus32((rng.standard_normal(E) * 2.0).astype(F32))).astype(F32)
+    b = (rng.standard_normal(E) * 0.01).astype(F32)
+    if kind == "ties":                          # equal choice values on several experts, across lanes and in a lane
+        v = s[rng.integers(0, E)]
+        for e in rng.integers(0, E, 9):
+            s[e], b[e] = v, F32(0)
+        s[:3], b[:3] = v, F32(0)
+        s[32], s[64], b[32], b[64] = v, v, F32(0), F32(0)
+    elif kind == "zeros":                       # choice +0 and -0 at the top: the butterfly's == treats them equal
+        s[:] = F32(0)
+        b[:] = F32(-1.0)
+        idx = rng.permutation(E)[:10]
+        b[idx[:5]] = F32(0.0)                   # +0 + +0 = +0
+        s[idx[5:]] = F32(-0.0)                  # -0 + -0 = -0
+        b[idx[5:]] = F32(-0.0)
+        ch = (s + b).astype(F32)
+        assert np.signbit(ch[idx[5:]]).all() and not np.signbit(ch[idx[:5]]).any()
+    elif kind == "neginf":                      # experts that can never be chosen
+        b[rng.permutation(E)[:E // 3]] = F32(-np.inf)
+    elif kind == "nan":                         # NaN scores never win a strict >
+        s[rng.permutation(E)[:7]] = F32(np.nan)
+    elif kind == "few":                         # fewer candidates than K: the rest -inf (garbage ids, alike)
+        b[:] = F32(-np.inf)
+        b[rng.permutation(E)[:3]] = F32(0.0)
+    elif kind == "none":
+        b[:] = F32(-np.inf)
+    return s, b
+
+
+KINDS = ["random", "ties", "zeros", "neginf", "nan", "few", "none"]
+
+
+@pytest.mark.parametrize("E", [128, 384, 512])
+@pytest.mark.parametrize("kind", KINDS)
+def test_redux_argmax_equals_the_butterfly(E, kind):
+    rng = np.random.default_rng(E * 13 + KINDS.index(kind))
+    for _ in range(12):
+        s, b = _ch(E, rng, kind)
+        for K in (3, 6, 8):
+            ia, sa, ta = EM.select_lanes(s, b, K, fast=False)
+            ib, sb, tb = EM.select_lanes(s, b, K, fast=True)
+            assert ia == ib, (kind, K)
+            assert np.array_equal(np.array(sa, F32).view(np.int32), np.array(sb, F32).view(np.int32))
+            assert np.array(ta, F32).view(np.int32) == np.array(tb, F32).view(np.int32)
+            if kind in ("random", "ties", "zeros", "neginf"):
+                ch = (s + b).astype(F32)
+                ok = [e for e in range(E) if ch[e] > -np.inf]
+                want = sorted(ok, key=lambda e: (-float(ch[e]), e))[:K]
+                assert ia[:len(want)] == want
+
+
+def test_okey_orders_like_fp32():
+    vals = np.array([-np.inf, -3.5, -1e-30, -0.0, 0.0, 1e-38, 1e-30, 2.0, 3.4e38, np.inf], F32)
+    keys = [EM.okey(v) for v in vals]
+    assert keys[3] == keys[4]                                   # -0 == +0
+    assert all(a < b for a, b in zip(keys[:3], keys[1:4])) and all(a < b for a, b in zip(keys[4:], keys[5:]))
+    assert keys[0] > 0                                          # a no-candidate lane's 0 is below every candidate
+    rng = np.random.default_rng(0)
+    x = (rng.standard_normal(4000) * 10.0 ** rng.integers(-30, 30, 4000)).astype(F32)
+    k = np.array([EM.okey(v) for v in x])
+    o = np.argsort(x, kind="stable")
+    assert (np.diff(k[o]) >= 0).all()
+
+
+@pytest.mark.parametrize("E,nw", [(384, 2), (384, 1), (128, 2), (384, 8), (384, 4)])
+@pytest.mark.parametrize("R", [1, 2, 5, 16])
+def test_static_assignment_never_deadlocks_and_covers_every_task(E, nw, R):
+    nprod = -(-E // nw)
+    rng = np.random.default_rng(E * 17 + R * 3 + nw)
+    for sms in (48, 8):
+        for hp in {MF.help_count(R, E, nw, sms), 0, 1, min(sms - 1, nprod - 1)}:
+            for capacity in (hp + 1, sms, 4 * sms):
+                for ordered in (True, False):
+                    res = EM.protocol(nprod, hp, R, capacity, nw, rng, ordered, static=True)
+                    assert not res["deadlock"], (capacity, ordered, hp)
+                    assert (res["done"] == 1).all() and res["cnt"] == [0, 0, 0, 0]
+                    assert sum(1 for v in res["roles"].values() if v == 2) == 1
+                    assert sum(1 for v in res["roles"].values() if v == 1) == hp
+
+
+def _picks(R, E, seed, rule):
+    rng = np.random.default_rng(seed)
+    lg = (rng.standard_normal((R, E)) * 2.0).astype(F32)
+    for r in range(0, R, 2):
+        lg[r] -= 8.0
+        lg[r, rng.permutation(E)[:6]] = np.array([9.0, 2.0, -1.0, -2.5, -4.0, -5.5], F32)
+    bias = (rng.standard_normal(E) * 0.01).astype(F32)
+    return EM.select(lg, bias, 6, 1.5, True, rule, E + 1)
+
+
+@pytest.mark.parametrize("rule", [None, PR.Rule(topp=0.85, min_k=3, renorm="kept")], ids=["off", "p85k"])
+def test_inline_grouping_and_rot_in_are_the_whole_tables(rule):
+    E, R = 384, 12
+    pick, _, _ = _picks(R, E, 4, rule)
+    # the kernel's group_rows with GE = E + 1 is router_gemv's model_group(., GE); upstream's group_kernel over the
+    # table (count E + 1) groups ids < E + 1: the same function (test_dsv41_router_gemv_emu pins model_group to it)
+    ids, n, mem = RG.model_group(pick, E + 1, R)
+    assert ids[n - 1] == E and list(mem[n - 1]) == [r * 32 + 6 for r in range(R)]       # the shared entry, last
+    assert E + 1 not in set(ids[:n].tolist())                                           # pruned slots: nowhere
+    rng = np.random.default_rng(1)
+    x = torch.from_numpy(rng.standard_normal((R, 5120)).astype(F32)).to(torch.bfloat16).float().numpy()
+    sg = torch.from_numpy(((rng.random((E + 1, 5120)) + 0.5) * 0.02).astype(F32)).half().float().numpy()
+    su = torch.from_numpy(((rng.random((E + 1, 5120)) + 0.5) * 0.02).astype(F32)).half().float().numpy()
+    served = EM.rot_in(x, sg, su, pick, E + 1)                                          # rk = slots, ge = E + 1
+    upstream = {r * 7 + k for r in range(R) for k in range(7) if 0 <= pick[r, k] < E + 1}  # rot_in_kernel's rule
+    assert set(served) == upstream and all(r * 7 + 6 in served for r in range(R))
+    if rule is not None:
+        assert (pick[:, :6] == E + 1).any()
+
+
+def test_knobs_shared_tail_and_describe(monkeypatch):
+    c = MF.parse({"TF_DSV41_MOE_FUSED": "1", "TF_DSV41_MOE_FUSED_SHARED": "inline", "TF_DSV41_MOE_FUSED_TAIL": "fast"})
+    assert c == {"on": True, "help": None, "sdn": "late", "shared": "inline", "tail": "fast", "min_rows": 1}
+    assert MF.parse({"TF_DSV41_MOE_FUSED_SHARED": "after"})["shared"] == "after"
+    for bad in ({"TF_DSV41_MOE_FUSED_SHARED": "early"}, {"TF_DSV41_MOE_FUSED_TAIL": "redux"}):
+        with pytest.raises(ValueError):
+            MF.parse(bad)
+    monkeypatch.setattr(MF, "CFG", c)
+    d = MF.describe()
+    assert "shared inline" in d and "tail fast" in d and "shared down" not in d
+    monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1"}))
+    assert "shared side, shared down late" in MF.describe() and "tail serial" in MF.describe()
+
+
+def test_inline_eligibility_takes_the_grouping_bound(monkeypatch):
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    monkeypatch.setattr(router, "MODE", "gemv")
+    monkeypatch.setattr(router, "_CHECK", False)
+    monkeypatch.setattr(RG, "supports", lambda x, gate, topk: True)
+
+    class X:
+        is_cuda = True
+        shape = (4, 5120)
+
+    def stand(E):
+        geom = SimpleNamespace(shared=1)
+        return SimpleNamespace(gate=torch.zeros((E, 8)), topk=6, block=SimpleNamespace(geom=geom,
+                               ex=SimpleNamespace(count=E + 1)), scratch=SimpleNamespace(slots=7, rows=16))
+
+    for shared, E, want in (("side", 512, True), ("inline", 511, True), ("inline", 512, False)):
+        monkeypatch.setattr(MF, "CFG", MF.parse({"TF_DSV41_MOE_FUSED": "1", "TF_DSV41_MOE_FUSED_SHARED": shared}))
+        assert MF.eligible(stand(E), X(), None) is want, (shared, E)
+
+
+def test_row_gate(monkeypatch):
+    """TF_DSV41_MOE_FUSED=rowsN: windows of < N rows take the old sequence (both are the production path's bits)."""
+
+    from types import SimpleNamespace
+
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    c = MF.parse({"TF_DSV41_MOE_FUSED": "rows2"})
+    assert c["min_rows"] == 2 and c["on"]
+    for bad in ("rows0", "rows17", "rowsx"):
+        with pytest.raises(ValueError):
+            MF.parse({"TF_DSV41_MOE_FUSED": bad})
+    monkeypatch.setattr(router, "MODE", "gemv")
+    monkeypatch.setattr(router, "_CHECK", False)
+    monkeypatch.setattr(RG, "supports", lambda x, gate, topk: True)
