+def small_tower(ref_vit, seed: int = 0):
+    torch.manual_seed(seed)
+    args = SimpleNamespace(vision_dim=64, vision_n_heads=4, vision_inter_dim=96, vision_n_layers=2,
+                           vision_patch_size=14, vision_rope_theta=10000.0, vision_downsample_ratio=3, dim=128)
+    vit, al = ref_vit.ViT(args).float(), ref_vit.Aligner(args).float()
+    with torch.no_grad():
+        for m in (vit, al):
+            for p in m.parameters():
+                p.copy_(torch.randn_like(p) * 0.1 + (1.0 if p.ndim == 1 and p.numel() == 64 else 0.0))
+    t = {f"vision.{k}": v.detach().clone() for k, v in vit.state_dict().items()}
+    t.update({f"aligner.{k}": v.detach().clone() for k, v in al.state_dict().items()})
+    for k in ("image_start", "image_end", "image_newline"):
+        t[k] = torch.randn(128)
+    return V.Tower(t, layers=2, heads=4, ratio=3), vit, al
