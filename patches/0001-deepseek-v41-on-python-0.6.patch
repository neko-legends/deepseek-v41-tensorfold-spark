+# -- the kernel ----------------------------------------------------------------------------------------------------
+RULES = [PR.Rule(topp=0.9, min_k=3), PR.Rule(min_w=0.08, min_k=4, renorm="kept"),
+         PR.Rule(min_w=0.05, topp=0.95, min_k=3), PR.Rule(topp=0.7, min_k=1, renorm="kept")]
