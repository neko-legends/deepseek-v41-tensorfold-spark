--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/glue.py
@@ -0,0 +1,869 @@
+"""GLM-5.3-Flash's small kernels on CUDA (Triton): each program reads only its own row, so a row's bits never
+depend on the other rows of a window.
+
+Arithmetic follows the Hugging Face definition: fp32 math and one bf16 rounding wherever the model stores a
+bf16 tensor. RMSNorm is Llama's: bf16(w * bf16(x * rsqrt(mean(x^2) + eps))). Kernels feeding a 4-bit matmul
+also write the fp32 sums of each 64-input group of the bf16 values they store.
+
+Manifold-constrained hyper-connections (4 residual streams of D, kept in bf16):
+    hc_pre   mix = rsqrt(mean(X^2) + eps) * (X . fn) (24 dots over the 4D flattened streams, split into 16
+             fixed K blocks summed in order); pre = sigmoid(.) + eps, post = 2 sigmoid(.), comb = Sinkhorn(
+             softmax(.) + eps, 20 iterations); collapsed = bf16(sum_s pre_s X_s); then the layer's RMSNorm
+    hc_post  X_s = bf16(post_s * branch + sum_j comb[j, s] X_j), branch = bf16(the ranks' fp32 partials summed
+             in rank order)
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+import triton
+import triton.language as tl
+
+from . import vision  # patches/0500: image rows in the embedding (``vision.ACTIVE``)
+
+# fixed K split of the mixing dots (a function of the shape only; changing it changes bits for every row alike)
+HC_BLOCKS = 16
+
+# patches/0080: hc_pre's partial dots for fast-prefill chunks (``fast_qmm.hc_partial``: same PART layout), installed by
+# ``fastpf.chunk`` only while a fast chunk of the main model runs; None everywhere else
+FAST_HC = None
+
+# patches/0240 (``tf_knobs.b12x`` bit 1, ``b12xpf``): in fast chunks, the mixing dots through ``b12x_mhc`` (column blocks
+# of all four streams, square sums on tensor cores; new arithmetic, own snapshot tag) and, in patches/0084's slabs,
+# hc_post fused with them. False everywhere else (decode, verify, exact prefill never see it)
+MHC = False
+
+
+def _mhc_fits(d: int) -> bool:
+    from . import b12x_mhc
+
+    return b12x_mhc.fits(d, HC_BLOCKS)
+
+
+# -- embedding ----------------------------------------------------------------------------------------------
+@triton.jit
+def _embed(IDS, W, S, B, OUT, D: tl.constexpr, COPIES: tl.constexpr):
+    """Row r, group g: 64 values of token IDS[r]'s 4-bit row (MLX layout) as bf16, into COPIES streams."""
+
+    row = tl.program_id(0)
+    g = tl.program_id(1)
+    tok = tl.load(IDS + row).to(tl.int64)
+    words = tl.load(W + tok * (D // 8) + g * 8 + tl.arange(0, 8))
+    q = tl.reshape((words[:, None] >> (tl.arange(0, 8) * 4)[None, :]) & 0xF, (64,)).to(tl.float32)
+    s = tl.load(S + tok * (D // 64) + g).to(tl.float32)
+    b = tl.load(B + tok * (D // 64) + g).to(tl.float32)
+    v = (q * s + b).to(tl.bfloat16)
+    d = g * 64 + tl.arange(0, 64)
+    for c in tl.static_range(COPIES):
+        tl.store(OUT + row * (COPIES * D) + c * D + d, v)
+
+
+@triton.jit
+def _embed_b16(IDS, W, OUT, D: tl.constexpr, COPIES: tl.constexpr):
+    """Row r, group g: 64 values of token IDS[r]'s BF16 row, into COPIES streams."""
+
+    row = tl.program_id(0)
+    g = tl.program_id(1)
+    tok = tl.load(IDS + row).to(tl.int64)
+    d = g * 64 + tl.arange(0, 64)
+    v = tl.load(W + tok * D + d)
+    for c in tl.static_range(COPIES):
+        tl.store(OUT + row * (COPIES * D) + c * D + d, v)
+
+
+def embed(ids: torch.Tensor, table, dims: int, copies: int, out: torch.Tensor) -> torch.Tensor:
+    """Token rows of the embedding: a 4-bit (words, scales, biases) table or a BF16 [V, D] tensor.
+
+    patches/0500: inside a prefill whose prompt has image rows (``vision.ACTIVE``), their virtual ids (>= 2^24) read
+    row 0 here and get the vision tower's rows after; otherwise nothing changes."""
+
+    vt = None
+    if vision.ACTIVE is not None:
+        vt, ids_in = vision.embed_ids(ids)
+        ids, orig = ids_in, ids
+    rows = ids.shape[0]
+    if isinstance(table, torch.Tensor):
+        _embed_b16[(rows, dims // 64)](ids, table, out, D=dims, COPIES=copies, num_warps=1)
+    else:
+        w, s, b = table
+        _embed[(rows, dims // 64)](ids, w, s, b, out, D=dims, COPIES=copies, num_warps=1)
+    if vt is not None:
+        vt.fixup(orig, out, copies, dims)
+    return out
+
+
+# -- RMSNorm (Llama convention) -------------------------------------------------------------------------------
+@triton.jit
+def _rmsnorm(X, x_stride, W, OUT, o_stride, XS, eps, D: tl.constexpr, BLOCK: tl.constexpr, SUMS: tl.constexpr):
+    r = tl.program_id(0)
+    d = tl.arange(0, BLOCK)
+    ok = d < D
+    x = tl.load(X + r * x_stride + d, mask=ok, other=0.0).to(tl.float32)
+    rinv = 1.0 / tl.sqrt(tl.sum(x * x, axis=0) / D + eps)
+    w = tl.load(W + d, mask=ok, other=0.0).to(tl.float32)
+    y = (w * (x * rinv).to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16)
+    tl.store(OUT + r * o_stride + d, y, mask=ok)
+    if SUMS:
+        g = tl.sum(tl.reshape(tl.where(ok, y.to(tl.float32), 0.0), (BLOCK // 64, 64)), axis=1)
+        gi = tl.arange(0, BLOCK // 64)
+        tl.store(XS + r * (D // 64) + gi, g, mask=gi < D // 64)
+
+
+def rmsnorm(x: torch.Tensor, w: torch.Tensor, eps: float, out: torch.Tensor, xs: torch.Tensor | None = None):
+    rows, d = x.shape
+    block = triton.next_power_of_2(d)
+    if out.stride(-1) != 1:
+        raise ValueError("rmsnorm: rows of out must be contiguous")
+    _rmsnorm[(rows,)](x, x.stride(0), w, out, out.stride(0), xs if xs is not None else out, eps, D=d, BLOCK=block,
+                      SUMS=xs is not None, num_warps=4 if block <= 2048 else 8)
+    return out
+
+
+# -- hyper-connections ----------------------------------------------------------------------------------------
+@triton.jit
+def _hc_partial(X, FN, PART, WIDE: tl.constexpr, NB: tl.constexpr, SUB: tl.constexpr):
+    """Program (r, b): over K block b of row r's flattened streams, the 24 partial dots with fn (rows padded to
+    32) and the partial sum of squares, accumulated SUB elements at a time in order. PART[r, b, 0:24] dots,
+    PART[r, b, 24] squares."""
+
+    r = tl.program_id(0)
+    b = tl.program_id(1)
+    KB: tl.constexpr = WIDE // NB
+    m = tl.arange(0, 32)
+    k = tl.arange(0, SUB)
+    acc = tl.zeros((32,), dtype=tl.float32)
+    ss = tl.zeros((SUB,), dtype=tl.float32)
+    for t in range(KB // SUB):
+        base = b * KB + t * SUB
+        x = tl.load(X + r * WIDE + base + k).to(tl.float32)
+        w = tl.load(FN + m[:, None] * WIDE + base + k[None, :], mask=m[:, None] < 24, other=0.0).to(tl.float32)
+        acc += tl.sum(w * x[None, :], axis=1)
+        ss += x * x
+    tl.store(PART + (r * NB + b) * 32 + m, acc, mask=m < 24)
+    tl.store(PART + (r * NB + b) * 32 + 24, tl.sum(ss, axis=0))
+
+
+@triton.jit
+def _hc_finish(X, PART, BASE, SCALE, NW, OUT, XS, POST, COMB, eps_norm, hc_eps,
+               D: tl.constexpr, S: tl.constexpr, NB: tl.constexpr, ITERS: tl.constexpr, BLOCK: tl.constexpr):
+    """Row r: mixes from the partials (blocks in order), pre/post/comb, the collapsed row, and the layer's
+    RMSNorm of it (bf16 + 64-group sums). POST[r, s] and COMB[r, i, j] are kept for hc_post."""
+
+    r = tl.program_id(0)
+    m = tl.arange(0, 32)
+    mix = tl.zeros((32,), dtype=tl.float32)
+    ss = 0.0
+    for b in range(NB):
+        mix += tl.load(PART + (r * NB + b) * 32 + m)
+        ss += tl.load(PART + (r * NB + b) * 32 + 24)
+    rinv = 1.0 / tl.sqrt(ss / (S * D) + eps_norm)
+    mix = mix * rinv
+    s_pre = tl.load(SCALE + 0)
+    s_post = tl.load(SCALE + 1)
+    s_comb = tl.load(SCALE + 2)
+    sv = tl.arange(0, 4)
+    base = tl.load(BASE + m, mask=m < 24, other=0.0)
+    # gather the four groups out of the 32-vector: pre = mix[0:4], post = mix[4:8], comb = mix[8:24]
+    pre_logit = tl.sum(tl.where(m[None, :] == sv[:, None], (mix * s_pre + base)[None, :], 0.0), axis=1)
+    post_logit = tl.sum(tl.where(m[None, :] == (sv[:, None] + 4), (mix * s_post + base)[None, :], 0.0), axis=1)
+    pre = 1.0 / (1.0 + tl.exp(-pre_logit)) + hc_eps
+    post = 2.0 * (1.0 / (1.0 + tl.exp(-post_logit)))
+    ii = tl.arange(0, 4)[:, None]
+    jj = tl.arange(0, 4)[None, :]
+    flat = 8 + ii * 4 + jj                                         # [4, 4] indices into mix
+    cl = tl.sum(tl.where(m[None, None, :] == flat[:, :, None], (mix * s_comb + base)[None, None, :], 0.0), axis=2)
+    cmax = tl.max(cl, axis=1)
+    ce = tl.exp(cl - cmax[:, None])
+    comb = ce / tl.sum(ce, axis=1)[:, None] + hc_eps
+    comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    for _ in range(ITERS - 1):
+        comb = comb / (tl.sum(comb, axis=1)[:, None] + hc_eps)
+        comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    tl.store(POST + r * S + sv, post)
+    tl.store(COMB + r * 16 + ii * 4 + jj, comb)
+    d = tl.arange(0, BLOCK)
+    p0 = tl.sum(tl.where(sv == 0, pre, 0.0), axis=0)
+    p1 = tl.sum(tl.where(sv == 1, pre, 0.0), axis=0)
+    p2 = tl.sum(tl.where(sv == 2, pre, 0.0), axis=0)
+    p3 = tl.sum(tl.where(sv == 3, pre, 0.0), axis=0)
+    x0 = tl.load(X + r * (S * D) + d).to(tl.float32)
+    x1 = tl.load(X + r * (S * D) + D + d).to(tl.float32)
+    x2 = tl.load(X + r * (S * D) + 2 * D + d).to(tl.float32)
+    x3 = tl.load(X + r * (S * D) + 3 * D + d).to(tl.float32)
+    c = (((p0 * x0 + p1 * x1) + p2 * x2) + p3 * x3).to(tl.bfloat16).to(tl.float32)
+    rinv2 = 1.0 / tl.sqrt(tl.sum(c * c, axis=0) / D + eps_norm)
+    w = tl.load(NW + d).to(tl.float32)
+    y = (w * (c * rinv2).to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16)
+    tl.store(OUT + r * D + d, y)
+    g = tl.sum(tl.reshape(y.to(tl.float32), (BLOCK // 64, 64)), axis=1)
+    tl.store(XS + r * (D // 64) + tl.arange(0, BLOCK // 64), g)
+
+
+def hc_pre(x: torch.Tensor, fn: torch.Tensor, base: torch.Tensor, scale: torch.Tensor, norm_w: torch.Tensor,
+           out: torch.Tensor, xs: torch.Tensor, post: torch.Tensor, comb: torch.Tensor, part: torch.Tensor,
+           eps: float, hc_eps: float, iters: int) -> None:
+    """x [R, S*D] bf16 streams -> out [R, D] (normed collapsed row) + xs, and post [R, S], comb [R, S, S]."""
+
+    rows, wide = x.shape
+    d = norm_w.shape[0]
+    s = wide // d
+    if FAST_HC is not None and MHC and wide == 4 * d and _mhc_fits(d):     # patches/0240: the b12x-style K split
+        from . import b12x_mhc
+
+        b12x_mhc.partial(x, fn, part, HC_BLOCKS)
+    elif FAST_HC is not None:          # patches/0080: a fast-prefill chunk (row tiles share fn; not these bits)
+        FAST_HC(x, fn, part, HC_BLOCKS)
+    else:
+        _hc_partial[(rows, HC_BLOCKS)](x, fn, part, WIDE=wide, NB=HC_BLOCKS, SUB=128, num_warps=4)
+    # patches/0190: in fast chunks only (decode / graphs keep _hc_finish), the same bits with the loads in flight
+    fin = _hc_finish_u if ((HC_FUSED & 2 or MHC) and FAST_HC is not None) else _hc_finish      # patches/0240
+    fin[(rows,)](x, part, base, scale, norm_w, out, xs, post, comb, eps, hc_eps, D=d, S=s, NB=HC_BLOCKS,
+                 ITERS=iters, BLOCK=d, num_warps=8)
+
+
+@triton.jit
+def _hc_post(X, XOUT, G, POST, COMB, RS, D: tl.constexpr, S: tl.constexpr, WORLD: tl.constexpr,
+             BLOCK: tl.constexpr):
+    """Program (r, c): X_s[d] = bf16(post_s * branch + (((comb0s X0 + comb1s X1) + comb2s X2) + comb3s X3)),
+    branch = bf16(partials summed rank 0 first); G is [WORLD, R, D] fp32 (RS apart; R * D when contiguous), or
+    bf16 (patches/0084: a fast chunk's bf16 partials read as gathered; widening to fp32 is exact, so the sum and
+    everything after it are those of the fp32 copy of the same partials)."""
+
+    r = tl.program_id(0)
+    cb = tl.program_id(1)
+    d = cb * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.load(G + r * D + d).to(tl.float32)
+    for k in tl.static_range(1, WORLD):
+        acc = acc + tl.load(G + k * RS + r * D + d).to(tl.float32)
+    branch = acc.to(tl.bfloat16).to(tl.float32)
+    x0 = tl.load(X + r * (S * D) + d).to(tl.float32)
+    x1 = tl.load(X + r * (S * D) + D + d).to(tl.float32)
+    x2 = tl.load(X + r * (S * D) + 2 * D + d).to(tl.float32)
+    x3 = tl.load(X + r * (S * D) + 3 * D + d).to(tl.float32)
+    for s in tl.static_range(S):
+        c0 = tl.load(COMB + r * 16 + 0 * 4 + s)
+        c1 = tl.load(COMB + r * 16 + 1 * 4 + s)
+        c2 = tl.load(COMB + r * 16 + 2 * 4 + s)
+        c3 = tl.load(COMB + r * 16 + 3 * 4 + s)
+        ps = tl.load(POST + r * S + s)
+        mixed = ((c0 * x0 + c1 * x1) + c2 * x2) + c3 * x3
+        v = ps * branch + mixed
+        tl.store(XOUT + r * (S * D) + s * D + d, v.to(tl.bfloat16))
+
+
+def hc_post(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, post: torch.Tensor,
+            comb: torch.Tensor) -> None:
+    """gathered: [world, R, D] fp32 (or bf16, patches/0084) partials, rows contiguous (the rank stride may be
+    larger than R * D: a row slice of a gathered block, patches/0084). x and xout may be the same tensor."""
+
+    world, rows, d = gathered.shape
+    if gathered.stride(2) != 1 or gathered.stride(1) != d:
+        raise ValueError("hc_post: the gathered partials' rows must be contiguous")
+    s = x.shape[1] // d
+    block = min(1024, d)
+    _hc_post[(rows, d // block)](x, xout, gathered, post, comb, gathered.stride(0), D=d, S=s, WORLD=world,
+                                 BLOCK=block, num_warps=4)
+
+
+# -- patches/0190: hc_post and the next hc_pre's mixing dots in one pass (``tf_knobs.hc_fused``) ----------------------
+# In a fast chunk (0084's slabs) a site ran hc_post (read X and the gathered partials, write X'), then hc_pre's
+# ``fast_qmm.hc_partial`` (read X' again, 24 dots with fn + the sum of squares per K block), then ``_hc_finish``. The
+# fused kernel computes X' tile by tile in registers, stores it, and feeds the SAME bf16 tile straight into the
+# partial's dot and square sum. Bits: each X' element is ``_hc_post``'s expression, operand for operand (the same
+# fp32 ops in the same order); each partial is ``_hc_partial_mm``'s chain for its row (the same [BM, BK] tiles
+# of the same bf16 values against the same fn tiles, one tl.dot per BK step in ascending t from a zero accumulator,
+# the same per-row square sum per step, the same shapes and warps). ``_hc_finish`` then runs unchanged (or its
+# unrolled twin ``_hc_finish_u``: the 16 partial loads issued at once, added in the same block order). The GPU test
+# checks every output bit for bit against the separate kernels; the knob stays off where it would not.
+HC_FUSED = 0           # bit 0: hc_post + partial fused; bit 1: _hc_finish_u (per request: tf_knobs.hc_fused)
+HC_FUSED_BM = 64       # rows a program of the fused kernel (the partial's own BM is 64)
+HC_FUSED_STAGES = 1    # software-pipelining depth of the fused kernel's column loop (shared memory; no bit changes)
+_HC_FUSED_BROKEN = ""  # set when the fused kernel cannot run here (e.g. out of shared memory): the separate kernels run
+
+
+@triton.jit
+def _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c0, c1, c2, c3, ps, acc, ss,
+                 WIDE: tl.constexpr, SD: tl.constexpr):
+    """One stream's tile: X'_s = bf16(post_s * branch + (((c0s X0 + c1s X1) + c2s X2) + c3s X3)), stored, then the
+    partial's dot and square-sum step on the stored values."""
+
+    mixed = ((c0[:, None] * x0 + c1[:, None] * x1) + c2[:, None] * x2) + c3[:, None] * x3
+    v = ps[:, None] * branch + mixed
+    vb = v.to(tl.bfloat16)
+    tl.store(XOUT + off_x + SD + d[None, :], vb, mask=ok[:, None])
+    w = tl.load(FN + m[:, None] * WIDE + SD + d[None, :], mask=m[:, None] < 24, other=0.0)
+    acc = tl.dot(vb, tl.trans(w), acc)
+    xf = vb.to(tl.float32)
+    ss += tl.sum(xf * xf, axis=1)
+    return acc, ss
+
+
+@triton.jit
+def _hc_post_part(X, XOUT, G, POST, COMB, FN, PART, RS, R, D: tl.constexpr, S: tl.constexpr, WORLD: tl.constexpr,
+                  NB: tl.constexpr, BM: tl.constexpr, BK: tl.constexpr):
+    """Program (row tile, q): columns [q KB, (q + 1) KB) of every stream (KB = S D / NB), i.e. K blocks
+    s (NB / S) + q of the flattened streams: ``_hc_post`` there, then ``fast_qmm._hc_partial_mm``'s partials of
+    those blocks from the new values (S = 4)."""
+
+    pid = tl.program_id(0)
+    q = tl.program_id(1)
+    WIDE: tl.constexpr = S * D
+    KB: tl.constexpr = WIDE // NB
+    rows = pid * BM + tl.arange(0, BM)
+    ok = rows < R
+    rr = tl.where(ok, rows, 0).to(tl.int64)
+    m = tl.arange(0, 32)
+    k = tl.arange(0, BK)
+    cb = COMB + rr * 16
+    c00 = tl.load(cb + 0, mask=ok, other=0.0)
+    c10 = tl.load(cb + 4, mask=ok, other=0.0)
+    c20 = tl.load(cb + 8, mask=ok, other=0.0)
+    c30 = tl.load(cb + 12, mask=ok, other=0.0)
+    c01 = tl.load(cb + 1, mask=ok, other=0.0)
+    c11 = tl.load(cb + 5, mask=ok, other=0.0)
+    c21 = tl.load(cb + 9, mask=ok, other=0.0)
+    c31 = tl.load(cb + 13, mask=ok, other=0.0)
+    c02 = tl.load(cb + 2, mask=ok, other=0.0)
+    c12 = tl.load(cb + 6, mask=ok, other=0.0)
+    c22 = tl.load(cb + 10, mask=ok, other=0.0)
+    c32 = tl.load(cb + 14, mask=ok, other=0.0)
+    c03 = tl.load(cb + 3, mask=ok, other=0.0)
+    c13 = tl.load(cb + 7, mask=ok, other=0.0)
+    c23 = tl.load(cb + 11, mask=ok, other=0.0)
+    c33 = tl.load(cb + 15, mask=ok, other=0.0)
+    p0 = tl.load(POST + rr * S + 0, mask=ok, other=0.0)
+    p1 = tl.load(POST + rr * S + 1, mask=ok, other=0.0)
+    p2 = tl.load(POST + rr * S + 2, mask=ok, other=0.0)
+    p3 = tl.load(POST + rr * S + 3, mask=ok, other=0.0)
+    a0 = tl.zeros((BM, 32), dtype=tl.float32)
+    a1 = tl.zeros((BM, 32), dtype=tl.float32)
+    a2 = tl.zeros((BM, 32), dtype=tl.float32)
+    a3 = tl.zeros((BM, 32), dtype=tl.float32)
+    s0 = tl.zeros((BM,), dtype=tl.float32)
+    s1 = tl.zeros((BM,), dtype=tl.float32)
+    s2 = tl.zeros((BM,), dtype=tl.float32)
+    s3 = tl.zeros((BM,), dtype=tl.float32)
+    off_x = rr[:, None] * WIDE
+    for t in range(KB // BK):
+        d = q * KB + t * BK + k
+        g = tl.load(G + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        for kk in tl.static_range(1, WORLD):
+            g = g + tl.load(G + kk * RS + rr[:, None] * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        branch = g.to(tl.bfloat16).to(tl.float32)
+        x0 = tl.load(X + off_x + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x1 = tl.load(X + off_x + D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x2 = tl.load(X + off_x + 2 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        x3 = tl.load(X + off_x + 3 * D + d[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
+        a0, s0 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c00, c10, c20, c30, p0, a0, s0,
+                              WIDE, 0)
+        a1, s1 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c01, c11, c21, c31, p1, a1, s1,
+                              WIDE, D)
+        a2, s2 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c02, c12, c22, c32, p2, a2, s2,
+                              WIDE, 2 * D)
+        a3, s3 = _hc_mix_tile(XOUT, FN, off_x, d, rr, ok, m, x0, x1, x2, x3, branch, c03, c13, c23, c33, p3, a3, s3,
+                              WIDE, 3 * D)
+    QB: tl.constexpr = NB // S                          # K blocks a stream
+    pm = ok[:, None] & (m[None, :] < 24)
+    tl.store(PART + (rr[:, None] * NB + q) * 32 + m[None, :], a0, mask=pm)
+    tl.store(PART + (rr * NB + q) * 32 + 24, s0, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + QB + q) * 32 + m[None, :], a1, mask=pm)
+    tl.store(PART + (rr * NB + QB + q) * 32 + 24, s1, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + 2 * QB + q) * 32 + m[None, :], a2, mask=pm)
+    tl.store(PART + (rr * NB + 2 * QB + q) * 32 + 24, s2, mask=ok)
+    tl.store(PART + (rr[:, None] * NB + 3 * QB + q) * 32 + m[None, :], a3, mask=pm)
+    tl.store(PART + (rr * NB + 3 * QB + q) * 32 + 24, s3, mask=ok)
+
+
+@triton.jit
+def _hc_finish_u(X, PART, BASE, SCALE, NW, OUT, XS, POST, COMB, eps_norm, hc_eps,
+                 D: tl.constexpr, S: tl.constexpr, NB: tl.constexpr, ITERS: tl.constexpr, BLOCK: tl.constexpr):
+    """``_hc_finish`` with the partial blocks' loads unrolled (all in flight at once, added in the same block order
+    into the same accumulators); every other line is ``_hc_finish``'s."""
+
+    r = tl.program_id(0)
+    m = tl.arange(0, 32)
+    mix = tl.zeros((32,), dtype=tl.float32)
+    ss = 0.0
+    for b in tl.static_range(NB):
+        mix += tl.load(PART + (r * NB + b) * 32 + m)
+        ss += tl.load(PART + (r * NB + b) * 32 + 24)
+    rinv = 1.0 / tl.sqrt(ss / (S * D) + eps_norm)
+    mix = mix * rinv
+    s_pre = tl.load(SCALE + 0)
+    s_post = tl.load(SCALE + 1)
+    s_comb = tl.load(SCALE + 2)
+    sv = tl.arange(0, 4)
+    base = tl.load(BASE + m, mask=m < 24, other=0.0)
+    pre_logit = tl.sum(tl.where(m[None, :] == sv[:, None], (mix * s_pre + base)[None, :], 0.0), axis=1)
+    post_logit = tl.sum(tl.where(m[None, :] == (sv[:, None] + 4), (mix * s_post + base)[None, :], 0.0), axis=1)
+    pre = 1.0 / (1.0 + tl.exp(-pre_logit)) + hc_eps
+    post = 2.0 * (1.0 / (1.0 + tl.exp(-post_logit)))
+    ii = tl.arange(0, 4)[:, None]
+    jj = tl.arange(0, 4)[None, :]
+    flat = 8 + ii * 4 + jj
+    cl = tl.sum(tl.where(m[None, None, :] == flat[:, :, None], (mix * s_comb + base)[None, None, :], 0.0), axis=2)
+    cmax = tl.max(cl, axis=1)
+    ce = tl.exp(cl - cmax[:, None])
+    comb = ce / tl.sum(ce, axis=1)[:, None] + hc_eps
+    comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    for _ in range(ITERS - 1):
+        comb = comb / (tl.sum(comb, axis=1)[:, None] + hc_eps)
+        comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_eps)
+    tl.store(POST + r * S + sv, post)
+    tl.store(COMB + r * 16 + ii * 4 + jj, comb)
+    d = tl.arange(0, BLOCK)
+    p0 = tl.sum(tl.where(sv == 0, pre, 0.0), axis=0)
+    p1 = tl.sum(tl.where(sv == 1, pre, 0.0), axis=0)
+    p2 = tl.sum(tl.where(sv == 2, pre, 0.0), axis=0)
+    p3 = tl.sum(tl.where(sv == 3, pre, 0.0), axis=0)
+    x0 = tl.load(X + r * (S * D) + d).to(tl.float32)
+    x1 = tl.load(X + r * (S * D) + D + d).to(tl.float32)
+    x2 = tl.load(X + r * (S * D) + 2 * D + d).to(tl.float32)
+    x3 = tl.load(X + r * (S * D) + 3 * D + d).to(tl.float32)
+    c = (((p0 * x0 + p1 * x1) + p2 * x2) + p3 * x3).to(tl.bfloat16).to(tl.float32)
+    rinv2 = 1.0 / tl.sqrt(tl.sum(c * c, axis=0) / D + eps_norm)
+    w = tl.load(NW + d).to(tl.float32)
+    y = (w * (c * rinv2).to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16)
+    tl.store(OUT + r * D + d, y)
+    g = tl.sum(tl.reshape(y.to(tl.float32), (BLOCK // 64, 64)), axis=1)
+    tl.store(XS + r * (D // 64) + tl.arange(0, BLOCK // 64), g)
+
+
+def hc_fused_ok(x: torch.Tensor, gathered: torch.Tensor, fn: torch.Tensor) -> bool:
+    """The fused post + partial kernel applies: a fast chunk (hc_pre's partial is ``fast_qmm.hc_partial``), 4
+    contiguous streams, fn contiguous, K blocks that split every stream evenly into 64-wide steps."""
+
+    if MHC and FAST_HC is not None:     # patches/0240: b12x_mhc.post_partial
+        from . import b12x_mhc
+
+        world, rows, d = gathered.shape
+        return (x.is_cuda and x.shape[1] == 4 * d and x.stride(1) == 1 and x.stride(0) == 4 * d and fn.is_contiguous()
+                and gathered.stride(2) == 1 and gathered.stride(1) == d and b12x_mhc.fits(d, HC_BLOCKS))
+    if not (HC_FUSED & 1) or _HC_FUSED_BROKEN or FAST_HC is None or getattr(FAST_HC, "__name__", "") != "hc_partial":
+        return False
+    world, rows, d = gathered.shape
+    wide = x.shape[1]
+    if wide != 4 * d or HC_BLOCKS % 4 or wide % (HC_BLOCKS * 64) or not fn.is_contiguous():
+        return False
+    if x.stride(1) != 1 or x.stride(0) != wide or gathered.stride(2) != 1 or gathered.stride(1) != d:
+        return False
+    return torch.cuda.is_available() and x.is_cuda
+
+
+def hc_post_part(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, post: torch.Tensor,
+                 comb: torch.Tensor, fn: torch.Tensor, part: torch.Tensor) -> None:
+    """``hc_post(x, xout, gathered, post, comb)`` followed by ``fast_qmm.hc_partial(xout, fn, part, HC_BLOCKS)``, in
+    one pass (same bits; check ``hc_fused_ok`` first). x and xout may be the same tensor."""
+
+    world, rows, d = gathered.shape
+    bm = HC_FUSED_BM
+    # num_stages=1: no software pipelining (with 3 stages Triton staged the 4 stream tiles, both partial tiles and 4 fn
+    # tiles a step in shared memory, 128 KB > GB10's 99 KB a block). Pipelining never changes a bit.
+    _hc_post_part[(triton.cdiv(rows, bm), 4)](x, xout, gathered, post, comb, fn, part, gathered.stride(0), rows,
+                                              D=d, S=4, WORLD=world, NB=HC_BLOCKS, BM=bm, BK=64, num_warps=4,
+                                              num_stages=HC_FUSED_STAGES)
+
+
+def try_hc_post_part(x, xout, gathered, post, comb, fn, part) -> bool:
+    """``hc_post_part``, or False (nothing written) when the kernel cannot be launched on this GPU (Triton raises
+    OutOfResources at launch, before the kernel runs): the fused path is then off for the process and the caller runs
+    the separate kernels, which give the same bits."""
+
+    global _HC_FUSED_BROKEN
+    if MHC and FAST_HC is not None:     # patches/0240
+        from . import b12x_mhc
+
+        return b12x_mhc.post_partial(x, xout, gathered, post, comb, fn, part, HC_BLOCKS)
+    try:
+        hc_post_part(x, xout, gathered, post, comb, fn, part)
+        return True
+    except Exception as exc:                            # noqa: BLE001 - triton.runtime.errors.OutOfResources et al.
+        if type(exc).__name__ not in ("OutOfResources", "CompilationError"):
+            raise
+        _HC_FUSED_BROKEN = f"{type(exc).__name__}: {exc}"
+        print(f"[tensorfold] hc_fused: the fused hc kernel cannot run here ({_HC_FUSED_BROKEN}); separate kernels",
+              flush=True)
+        return False
+
+
+def hc_finish(x: torch.Tensor, fn: torch.Tensor, base: torch.Tensor, scale: torch.Tensor, norm_w: torch.Tensor,
+              out: torch.Tensor, xs: torch.Tensor, post: torch.Tensor, comb: torch.Tensor, part: torch.Tensor,
+              eps: float, hc_eps: float, iters: int) -> None:
+    """``hc_pre`` after its partials are in ``part`` (``hc_post_part`` wrote them)."""
+
+    rows, wide = x.shape
+    d = norm_w.shape[0]
+    fin = _hc_finish_u if ((HC_FUSED & 2 or MHC) and FAST_HC is not None) else _hc_finish      # patches/0240: unrolled
+    fin[(rows,)](x, part, base, scale, norm_w, out, xs, post, comb, eps, hc_eps, D=d, S=wide // d, NB=HC_BLOCKS,
+                 ITERS=iters, BLOCK=d, num_warps=8)
+
+
+def hc_post_pre(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor, post: torch.Tensor,
+                comb: torch.Tensor, fn: torch.Tensor, base: torch.Tensor, scale: torch.Tensor, norm_w: torch.Tensor,
+                out: torch.Tensor, xs: torch.Tensor, npost: torch.Tensor, ncomb: torch.Tensor, part: torch.Tensor,
+                eps: float, hc_eps: float, iters: int) -> None:
+    """hc_post of rows (post / comb: this site's mixes) then the next hc_pre of the same rows (its mixes into npost /
+    ncomb, its normed rows into out / xs): fused where ``hc_fused_ok``, else the two calls."""
+
+    if hc_fused_ok(xout, gathered, fn) and try_hc_post_part(x, xout, gathered, post, comb, fn, part):
+        hc_finish(xout, fn, base, scale, norm_w, out, xs, npost, ncomb, part, eps, hc_eps, iters)
+        return
+    hc_post(x, xout, gathered, post, comb)
+    hc_pre(xout, fn, base, scale, norm_w, out, xs, npost, ncomb, part, eps, hc_eps, iters)
+
+
+@triton.jit
+def _residual_add(X, XOUT, G, RS, D: tl.constexpr, WORLD: tl.constexpr, BLOCK: tl.constexpr):
+    """Plain residual (the MTP block): X = bf16(X + bf16(partials summed rank 0 first))."""
+
+    r = tl.program_id(0)
+    cb = tl.program_id(1)
+    d = cb * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.load(G + r * D + d)
+    for k in tl.static_range(1, WORLD):
+        acc = acc + tl.load(G + k * RS + r * D + d)
+    branch = acc.to(tl.bfloat16).to(tl.float32)
+    x = tl.load(X + r * D + d).to(tl.float32)
+    tl.store(XOUT + r * D + d, (x + branch).to(tl.bfloat16))
+
+
+def residual_add(x: torch.Tensor, xout: torch.Tensor, gathered: torch.Tensor) -> None:
+    world, rows, d = gathered.shape
+    block = min(1024, d)
+    _residual_add[(rows, d // block)](x, xout, gathered, rows * d, D=d, WORLD=world, BLOCK=block, num_warps=4)
+
+
+@triton.jit
+def _stream_mean(X, OUT, D: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):
+    """bf16((X0 + X1 + X2 + X3) / 4): the final collapse (an unweighted mean of the streams)."""
+
+    r = tl.program_id(0)
+    cb = tl.program_id(1)
+    d = cb * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.load(X + r * (S * D) + d).to(tl.float32)
+    for s in tl.static_range(1, S):
+        acc = acc + tl.load(X + r * (S * D) + s * D + d).to(tl.float32)
+    tl.store(OUT + r * D + d, (acc / S).to(tl.bfloat16))
+
+
+def stream_mean(x: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    rows, d = out.shape
+    block = min(1024, d)
+    _stream_mean[(rows, d // block)](x, out, D=d, S=x.shape[1] // d, BLOCK=block, num_warps=4)
+    return out
+
+
+# -- MLP and MoE ----------------------------------------------------------------------------------------------
+@triton.jit
+def _swiglu(GU, OUT, XS, LIMIT, W: tl.constexpr, BLOCK: tl.constexpr):
+    """Dense MLP: [gate | up] (bf16) -> bf16(bf16(silu(min(g, L))) * clip(u, -L, L)) and its 64-group sums."""
+
+    r = tl.program_id(0)
+    cb = tl.program_id(1)
+    d = cb * BLOCK + tl.arange(0, BLOCK)
+    g = tl.minimum(tl.load(GU + r * (2 * W) + d).to(tl.float32), LIMIT)
+    u = tl.load(GU + r * (2 * W) + W + d).to(tl.float32)
+    u = tl.minimum(tl.maximum(u, -LIMIT), LIMIT)
+    a = ((g / (1.0 + tl.exp(-g))).to(tl.bfloat16).to(tl.float32) * u).to(tl.bfloat16)
+    tl.store(OUT + r * W + d, a)
+    s = tl.sum(tl.reshape(a.to(tl.float32), (BLOCK // 64, 64)), axis=1)
+    tl.store(XS + r * (W // 64) + cb * (BLOCK // 64) + tl.arange(0, BLOCK // 64), s)
+
+
+def swiglu(gu: torch.Tensor, out: torch.Tensor, xs: torch.Tensor, limit: float) -> None:
+    rows, w = out.shape
+    block = math.gcd(512, w)             # 512 for every width of the model; narrower widths (tests) get all columns
+    if block < 64:
+        raise ValueError(f"swiglu: width {w} is not a multiple of 64")
+    _swiglu[(rows, w // block)](gu, out, xs, float(limit), W=w, BLOCK=block, num_warps=4)
+
+
+@triton.jit
+def _router(X, W, OUT, M, x_stride, D: tl.constexpr, NE: tl.constexpr, BM: tl.constexpr,
+            BLOCK_E: tl.constexpr, BK: tl.constexpr):
+    """OUT[m, e] = fp32 x[m] . w[e] (bf16 inputs, tensor cores, K in BK steps in order)."""
+
+    rm = tl.program_id(0) * BM + tl.arange(0, BM)
+    re = tl.program_id(1) * BLOCK_E + tl.arange(0, BLOCK_E)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    e_ok = re < NE
+    acc = tl.zeros((BM, BLOCK_E), dtype=tl.float32)
+    for k0 in range(0, D, BK):
+        x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        w = tl.load(W + re[:, None] * D + (k0 + rk)[None, :], mask=e_ok[:, None], other=0.0)
+        acc = tl.dot(x, tl.trans(w), acc)
+    tl.store(OUT + rm[:, None] * NE + re[None, :], acc, mask=m_ok[:, None] & e_ok[None, :])
+
+
+@triton.jit
+def _router_part(X, W, PART, M, x_stride, D: tl.constexpr, NE: tl.constexpr, BM: tl.constexpr,
+                 BLOCK_E: tl.constexpr, BK: tl.constexpr, KS: tl.constexpr):
+    """``_router`` over one of KS equal K slices (in order inside the slice): PART[s, m, e] fp32."""
+
+    rm = tl.program_id(0) * BM + tl.arange(0, BM)
+    re = tl.program_id(1) * BLOCK_E + tl.arange(0, BLOCK_E)
+    s = tl.program_id(2)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    e_ok = re < NE
+    acc = tl.zeros((BM, BLOCK_E), dtype=tl.float32)
+    lo = s * (D // KS)
+    for k0 in range(lo, lo + D // KS, BK):
+        x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        w = tl.load(W + re[:, None] * D + (k0 + rk)[None, :], mask=e_ok[:, None], other=0.0)
+        acc = tl.dot(x, tl.trans(w), acc)
+    tl.store(PART + (s * M + rm[:, None]) * NE + re[None, :], acc, mask=m_ok[:, None] & e_ok[None, :])
+
+
+@triton.jit
+def _router_sum(PART, OUT, total, KS: tl.constexpr, BLOCK: tl.constexpr):
+    """OUT = the KS slice partials added in slice order."""
+
+    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    ok = i < total
+    acc = tl.load(PART + i, mask=ok, other=0.0)
+    for s in tl.static_range(1, KS):
+        acc = acc + tl.load(PART + s * total + i, mask=ok, other=0.0)
+    tl.store(OUT + i, acc, mask=ok)
+
+
+# The router's K slices: 8 slices give 72 programs for 288 experts and a fixed-order sum (the single-pass kernel,
+# 5 programs, took about 30 us a layer and serves shapes the slices do not divide). Every row gets the same bits
+# alone or in a window; the two kernels differ from each other in the last bits, so the choice is part of the model.
+ROUTER_KS = 8
+
+
+@triton.jit
+def _router_fused(X, W, OUT, M, x_stride, D: tl.constexpr, NE: tl.constexpr, BM: tl.constexpr,
+                  BLOCK_E: tl.constexpr, BK: tl.constexpr, KS: tl.constexpr):
+    """patches/0190: ``_router_part`` for every slice in one program, then ``_router_sum``'s adds in slice order in
+    registers: each slice's accumulator is the same chain of dots from zero over the same K range, and the total is
+    ((p0 + p1) + p2) + ... as ``_router_sum`` adds the stored fp32 partials. No [KS, M, NE] partial buffer."""
+
+    rm = tl.program_id(0) * BM + tl.arange(0, BM)
+    re = tl.program_id(1) * BLOCK_E + tl.arange(0, BLOCK_E)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    e_ok = re < NE
+    total = tl.zeros((BM, BLOCK_E), dtype=tl.float32)
+    for s in tl.static_range(KS):
+        acc = tl.zeros((BM, BLOCK_E), dtype=tl.float32)
+        for k0 in range(s * (D // KS), s * (D // KS) + D // KS, BK):
+            x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+            w = tl.load(W + re[:, None] * D + (k0 + rk)[None, :], mask=e_ok[:, None], other=0.0)
+            acc = tl.dot(x, tl.trans(w), acc)
+        if s == 0:
+            total = acc
+        else:
+            total = total + acc
+    tl.store(OUT + rm[:, None] * NE + re[None, :], total, mask=m_ok[:, None] & e_ok[None, :])
+
+
+# patches/0190 (``tf_knobs.moe_glue`` bit 1): the K-slice router in one kernel for windows of 64+ rows (the same bits;
+# decode windows and graph captures keep the two kernels)
+ROUTER_FUSED = False
+# patches/0190 (``tf_knobs.moe_glue`` bit 2): lean chunks' combine reads the shared expert's output where its matmul
+# wrote it instead of copying it into its slot of ``ey`` first (``combine(..., shared=)``; the same sums in the same
+# order)
+SHARED_INPLACE = False
+
+
+def router(x: torch.Tensor, w: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+    m, d = x.shape
+    ne = w.shape[0]
+    bm = 16 if m <= 16 else 32 if m <= 32 else 64 if m <= 64 else 128
+    ks = ROUTER_KS
+    if (ROUTER_FUSED and m >= GROUP_MIN and ks > 1 and not d % (ks * 64) and out.is_contiguous()
+            and not (x.is_cuda and torch.cuda.is_current_stream_capturing())):
+        _router_fused[(triton.cdiv(m, bm), triton.cdiv(ne, 32))](x, w, out, m, x.stride(0), D=d, NE=ne, BM=bm,
+                                                                  BLOCK_E=32, BK=64, KS=ks, num_warps=4,
+                                                                  num_stages=3)
+        return out
+    if ks <= 1 or d % (ks * 64) or not out.is_contiguous():
+        _router[(triton.cdiv(m, bm), triton.cdiv(ne, 64))](x, w, out, m, x.stride(0), D=d, NE=ne, BM=bm,
+                                                            BLOCK_E=64, BK=64, num_warps=4, num_stages=3)
+        return out
+    part = torch.empty((ks, m, ne), dtype=torch.float32, device=x.device)
+    _router_part[(triton.cdiv(m, bm), triton.cdiv(ne, 32), ks)](x, w, part, m, x.stride(0), D=d, NE=ne, BM=bm,
+                                                                 BLOCK_E=32, BK=64, KS=ks, num_warps=4,
+                                                                 num_stages=3)
+    total = m * ne
+    _router_sum[(triton.cdiv(total, 1024),)](part, out, total, KS=ks, BLOCK=1024, num_warps=4)
+    return out
+
+
+@triton.jit
+def _topk(L, BIAS, PICK, WTS, scale, NE: tl.constexpr, TOPK: tl.constexpr, SLOTS: tl.constexpr,
+          BLOCK: tl.constexpr, SLOTP: tl.constexpr, NORM: tl.constexpr):
+    """Row r: scores = sigmoid(logits); the TOPK largest scores + bias (largest first, the lower id among equals);
+    weights = score / (sum + 1e-20) * scale in pick order; then the shared expert (id NE) with weight 1."""
+
+    r = tl.program_id(0)
+    ar = tl.arange(0, BLOCK)
+    ak = tl.arange(0, SLOTP)
+    ok = ar < NE
+    lg = tl.load(L + r * NE + ar, mask=ok, other=0.0)
+    score = 1.0 / (1.0 + tl.exp(-lg))
+    choice = tl.where(ok, score + tl.load(BIAS + ar, mask=ok, other=0.0), float("-inf"))
+    picks = tl.zeros((SLOTP,), dtype=tl.int32)
+    wts = tl.zeros((SLOTP,), dtype=tl.float32)
+    total = 0.0
+    for k in tl.static_range(TOPK):
+        mx = tl.max(choice, axis=0)
+        idx = tl.min(tl.where(choice == mx, ar, BLOCK), axis=0)
+        sk = tl.sum(tl.where(ar == idx, score, 0.0), axis=0)
+        picks = tl.where(ak == k, idx, picks)
+        wts = tl.where(ak == k, sk, wts)
+        total += sk
+        choice = tl.where(ar == idx, float("-inf"), choice)
+    if NORM:
+        wts = wts / (total + 1e-20)
+    wts = wts * scale
+    picks = tl.where(ak == TOPK, NE, picks)
+    wts = tl.where(ak == TOPK, 1.0, wts)
+    tl.store(PICK + r * SLOTS + ak, picks, mask=ak < SLOTS)
+    tl.store(WTS + r * SLOTS + ak, wts, mask=ak < SLOTS)
+
+
+@triton.jit
+def _group(PICK, UIDS, UCOUNT, UMEM, R, SLOTS: tl.constexpr, MAXU: tl.constexpr, MAXM: tl.constexpr,
+           BLOCK: tl.constexpr):
+    """One program: the distinct experts of all rows in increasing id order: UIDS[u], UMEM[u][j] = row * 32 +
+    slot of the j-th row (in row order) that picked it (-1 after the last), UCOUNT[0] = their number."""
+
+    ar = tl.arange(0, BLOCK)
+    counts = tl.zeros((BLOCK,), dtype=tl.int32)
+    for r in range(R):
+        for k in tl.static_range(SLOTS):
+            e = tl.load(PICK + r * SLOTS + k)
+            counts += tl.where(ar == e, 1, 0)
+    used = counts > 0
+    place = tl.cumsum(used.to(tl.int32), axis=0) - 1
+    n_used = tl.sum(used.to(tl.int32), axis=0)
+    tl.store(UIDS + place, ar, mask=used)
+    tl.store(UCOUNT, n_used)
+    filled = tl.zeros((BLOCK,), dtype=tl.int32)
+    for r in range(R):
+        for k in tl.static_range(SLOTS):
+            e = tl.load(PICK + r * SLOTS + k)
+            hit = ar == e
+            tl.store(UMEM + place * MAXM + filled, r * 32 + k, mask=hit)
+            filled += tl.where(hit, 1, 0)
+    for j in range(MAXM):
+        tl.store(UMEM + place * MAXM + j, -1, mask=used & (filled <= j))
+    tail = n_used + ar
+    for j in range(MAXM):
+        tl.store(UMEM + tail * MAXM + j, -1, mask=tail < MAXU)
+
+
+# patches/0190 (``tf_knobs.moe_glue`` bit 0, GLM53_TF_MOE_GLUE): windows of at least GROUP_MIN rows are grouped by
+# ``group_sorted`` (a stable sort by expert id and a scatter, all rows in parallel) instead of ``_group``'s one
+# program walking every (row, slot) twice and every member column twice (O(R) serial: ~5-8 ms a MoE layer at 8,192
+# rows, most of ``moe.router``). Integer outputs, element for element those of ``_group`` (tested), so no bit of any
+# row changes. Decode / verify windows (and anything captured in a graph) keep ``_group``.
+GROUP_SORT = False
+GROUP_MIN = 64
+
+
+def group_sorted(pick: torch.Tensor, rows: int, ids: torch.Tensor, count: torch.Tensor, members: torch.Tensor,
+                 experts: int) -> None:
+    """``_group``'s outputs for rows [0, rows) of ``pick`` [.., SLOTS] int32, from device-side torch ops (no host
+    sync): ids[u] = the u-th distinct expert in increasing order (entries past the count left as they are, as
+    ``_group`` leaves them), count[0] = their number, members[u, j] = row * 32 + slot of the j-th (row, slot) that
+    picked expert u, in row then slot order (a stable sort of the row-major picks by expert), -1 after the last and
+    in every row from the count on."""
+
+    slots = pick.shape[1]
+    maxu, maxm = members.shape
+    dev = pick.device
+    block = triton.next_power_of_2(experts + 1)
+    flat = pick[:rows].reshape(-1).to(torch.int64)
+    sv, si = torch.sort(flat, stable=True)               # by expert id, then (row, slot) order: _group's order
+    ar = torch.arange(block, device=dev, dtype=torch.int64)
+    starts = torch.searchsorted(sv, ar)
+    ends = torch.searchsorted(sv, ar, right=True)
+    used = ends > starts
+    place = torch.cumsum(used.to(torch.int64), 0) - 1
+    n_used = used.to(torch.int64).sum()
+    # ids: the used experts, compacted (a dummy slot ``block`` takes the unused ones)
+    comp = torch.zeros((block + 1,), dtype=torch.int64, device=dev)
+    comp.scatter_(0, torch.where(used, place, block), ar)
+    keep = torch.arange(maxu, device=dev) < n_used
+    ids.copy_(torch.where(keep, comp[:maxu].to(ids.dtype), ids))
+    count.copy_(n_used.to(count.dtype).view(1))
+    # members: -1 everywhere, then each (row, slot) at (place of its expert, its rank among the expert's members)
+    members.fill_(-1)
+    t = torch.arange(sv.shape[0], device=dev, dtype=torch.int64)
+    dest = place[sv] * maxm + (t - starts[sv])
+    code = (si // slots) * 32 + si % slots
+    members.view(-1).scatter_(0, dest, code.to(members.dtype))
+
+
+def _group_fast_ok(rows: int, members: torch.Tensor) -> bool:
+    if not GROUP_SORT or rows < GROUP_MIN or not members.is_contiguous() or rows > members.shape[1]:
+        return False
+    if members.is_cuda and torch.cuda.is_current_stream_capturing():
+        return False
+    return True
+
+
+def select(logits: torch.Tensor, bias: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor, ids: torch.Tensor,
+           count: torch.Tensor, members: torch.Tensor, top_k: int, experts: int, scale: float, norm: bool) -> None:
+    rows = logits.shape[0]
+    block = triton.next_power_of_2(experts + 1)
+    _topk[(rows,)](logits, bias, pick, wts, float(scale), NE=experts, TOPK=top_k, SLOTS=top_k + 1, BLOCK=block,
+                   SLOTP=triton.next_power_of_2(top_k + 1), NORM=norm, num_warps=4)
+    if _group_fast_ok(rows, members):                    # patches/0190: the same integers, in parallel
+        group_sorted(pick, rows, ids, count, members, experts)
+        return
+    _group[(1,)](pick, ids, count, members, rows, SLOTS=top_k + 1, MAXU=ids.shape[0], MAXM=members.shape[1],
+                 BLOCK=block, num_warps=8)
+
+
+@triton.jit
+def _combine(Y, WTS, OUT, D: tl.constexpr, SLOTS: tl.constexpr, BLOCK: tl.constexpr):
+    """A rank's MoE share, fp32: sum over slots in order of w_k y_k (the shared expert last, weight 1). A bf16 OUT
+    (patches/0084: a fast chunk's partial written as it is gathered) gets the fp32 sum rounded once to nearest even,
+    the bits ``copy_`` of the fp32 result gives."""
+
+    r = tl.program_id(0)
+    c = tl.program_id(1)
+    d = c * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.zeros((BLOCK,), dtype=tl.float32)
+    for k in tl.static_range(SLOTS):
+        acc = acc + tl.load(Y + (r * SLOTS + k) * D + d) * tl.load(WTS + r * SLOTS + k)
+    tl.store(OUT + r * D + d, acc.to(OUT.dtype.element_ty))
+
+
+@triton.jit
+def _combine_s(Y, SY, WTS, OUT, D: tl.constexpr, SLOTS: tl.constexpr, BLOCK: tl.constexpr):
+    """``_combine`` with the last slot (the shared expert) read from SY [R, D] instead of Y's last slot: the same
+    values in the same order (patches/0190)."""
+
+    r = tl.program_id(0)
+    c = tl.program_id(1)
+    d = c * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.zeros((BLOCK,), dtype=tl.float32)
+    for k in tl.static_range(SLOTS - 1):
+        acc = acc + tl.load(Y + (r * SLOTS + k) * D + d) * tl.load(WTS + r * SLOTS + k)
+    acc = acc + tl.load(SY + r * D + d) * tl.load(WTS + r * SLOTS + SLOTS - 1)
+    tl.store(OUT + r * D + d, acc.to(OUT.dtype.element_ty))
+
+
+def combine(y: torch.Tensor, wts: torch.Tensor, out: torch.Tensor, shared: torch.Tensor | None = None) -> None:
+    """out [R, D]: fp32, or bf16 (patches/0084), contiguous. ``shared`` (patches/0190): the last slot's rows [R, D]
+    fp32 (contiguous), read there instead of from ``y``."""
+
+    rows, d = out.shape
+    if out.stride(0) != d or out.stride(1) != 1:
+        raise ValueError("combine: out must be a contiguous [R, D]")
+    block = min(1024, d)
+    if shared is not None:
+        if shared.shape != (rows, d) or not shared.is_contiguous() or shared.dtype != torch.float32:
+            raise ValueError("combine: shared must be a contiguous fp32 [R, D]")
+        _combine_s[(rows, d // block)](y, shared, wts, out, D=d, SLOTS=wts.shape[1], BLOCK=block, num_warps=4)
+        return
+    _combine[(rows, d // block)](y, wts, out, D=d, SLOTS=wts.shape[1], BLOCK=block, num_warps=4)
