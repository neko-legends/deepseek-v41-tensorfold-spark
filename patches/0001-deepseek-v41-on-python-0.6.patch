+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Full-mode prefill with the decoder over its dependency cone only (``TF_DSV41_FULL_CONE=1``, default 0; G17).
+
+``TF_DSV41_PREFILL=full`` runs all 40 layers over every prompt row. Under CED (ARCH-LEVERAGE section 2.1) the
+decoder's global KV and index keys are layer 20's projection of H_19 (the encoder's output), stored by the encoder
+pass for every row; a decoder layer's only other per-position state is its SWA ring (window w = 128). So a decoder
+row's output depends on other rows only through SWA windows, and each decoder layer widens that dependence by w - 1
+rows. Everything a prompt leaves behind in full mode -- the decoder rings at the snapshot point S and at the prompt's
+end, the DSpark context rows (the taps entering layers 37-39), the first verify row's logits -- depends on decoder
+rows at positions >= S - CONE only, with
+
+    CONE = w + (w - 1) * jmax,   jmax = max(decoder layers - 1, max(tap layer - D)),   = 128 + 127 * 19 = 2,541.
+
+What this module does (both ranks, from the plan alone): the executor sets each admitted slot's decoder start
+``r0 = grid_floor(snapshot_point(n) - CONE)`` (``start``; None when r0 <= the cached prefix: the plain full prefill);
+then every prefill segment of that slot is
+
+- **enc** (ends at or before r0): the encoder pass only (``Forward.run(upto=D)``: layers 0 .. D - 1 and layer D's
+  attention site + compressor, i.e. the decoder's global KV and index keys for every row, as CED replay);
+- **split** (crosses r0, or starts within w - 1 rows after it): the encoder pass, then layers D .. 39 over the rows
+  >= r0 from the rows entering layer D (``replay.finish``'s pass), every row's SWA window starting at r0
+  (``Context.lo``): rows whose windows would reach below r0 are the cone's edge and are never read by anything kept;
+- **full** (starts >= r0 + w - 1): the plain 40-layer run (its windows only reach rows >= r0, computed above).
+
+Exactness (``tests/test_dsv41_full_cone.py``): every kernel is row-independent (``prefill_mm`` rule 1), the encoder
+pass + decoder pass equals the 40-layer run row for row (``test_dsv41_replay``'s short-prompt equality), and by the
+cone bound every value that survives the prompt is a function of rows the cone computes with untruncated windows. So
+the state at S and at the prompt's end -- encoder rings, compressed rows, index keys, carries, decoder rings, DSpark
+rings -- and the first verify row's logits are full mode's bit for bit: the session tag stays full mode's, prompt
+and turn snapshots are full mode's, resumed == fresh, batched == alone and drafted == serial hold as in full mode.
+Prompts shorter than about CONE + 16 tokens (and resumes with less than that left) run the plain full prefill.
+
+Cost: the decoder half runs over ~CONE rows instead of n (at 32K, 2.5K of 32.8K rows): a full-mode prompt costs
+about a CED replay prompt plus a ~2.5K-row decoder pass. No new memory beyond a split segment's rows entering the
+decoder (a clone of [m, 4 D] + [m, D] bf16, the size of the segment's own streams), freed after its pass.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+ENV = "TF_DSV41_FULL_CONE"
+
+
+def enabled(env=None) -> bool:
+    env = os.environ if env is None else env
+    v = (str(env.get(ENV, "0")).strip().lower() or "0")
+    if v not in ("0", "1", "on", "off", "true", "false"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v in ("1", "on", "true")
+
+
+def span(cfg) -> int:
+    """CONE: the rows before the snapshot point whose decoder outputs can reach the kept state."""
+
+    from .replay import decoder_start
+
+    d, L, w = decoder_start(cfg), int(cfg.num_hidden_layers), int(cfg.sliding_window)
+    if d >= L:
+        return 0
+    jmax = max([L - d - 1] + [int(a) - d for a in cfg.aux_layer_ids if int(a) >= d])
+    return w + (w - 1) * jmax
+
+
+def start(cfg, n: int, cached: int = 0, grid: int | None = None) -> int | None:
+    """The decoder's first row for a prompt of ``n`` tokens resumed at ``cached``, or None (decoder over every row)."""
+
+    from .protocol import GRID
+    from .sessions import snapshot_point
+
+    g = GRID if grid is None else int(grid)
+    c = span(cfg)
+    if c <= 0:
+        return None
+    r0 = (snapshot_point(int(n)) - c) // g * g
+    return r0 if r0 > int(cached) else None
+
+
+def kind(start_row: int, n: int, r0: int | None, window: int) -> str:
+    """``enc`` | ``split`` | ``full`` for a segment [start_row, start_row + n) of a slot whose decoder starts at r0."""
+
+    if r0 is None:
+        return "full"
+    if start_row + n <= r0:
+        return "enc"
+    if start_row >= r0 + window - 1:
+        return "full"
+    return "split"
+
+
+def prefill(fw, runs) -> None:
+    """``SlotsForward.prefill`` in full mode with cones: each run's segments by kind (see the module notes)."""
+
+    from .forward import Seg
+    from .replay import decoder_start
+
+    d = decoder_start(fw.cfg)
+    w = int(fw.cfg.sliding_window)
+    cones = fw.cones
+    stats = fw.__dict__.setdefault("cone_stats", {"enc": 0, "split": 0, "full": 0, "decoder_rows": 0})
+    for run in runs:
+        segs = [Seg(*sg) for sg in run]
+        kinds = [kind(sg.start, len(sg.ids), cones.get(sg.slot), w) for sg in segs]
+        for sg, k in zip(segs, kinds):          # rows a kind (``describe`` / tests): enc rows skip the decoder
+            stats[k] += len(sg.ids)
+            stats["decoder_rows"] += 0 if k == "enc" else len(sg.ids) - max(0, cones.get(sg.slot, 0) - sg.start)
+        plain = [sg for sg, k in zip(segs, kinds) if k == "full"]
+        other = [(sg, k) for sg, k in zip(segs, kinds) if k != "full"]
+        if plain:
+            fw.run(plain, logits=False, prefill=True)
+            for sg in plain:
+                fw.keep(sg.slot, len(sg.ids) - 1)
+        if not other:
+            continue
+        st = fw.run([sg for sg, _ in other], logits=False, prefill=True, upto=d)
+        coefs = st.coefs[st.cur]
+        jobs, a = [], 0
+        for sg, k in other:
+            n = len(sg.ids)
+            if k == "split":
+                r0 = int(cones[sg.slot])
+                i = max(sg.start, r0) - sg.start
+                cl = (lambda t, i=i, n=n, a=a: t[a + i:a + n].clone())        # noqa: E731
+                jobs.append((sg.slot, sg.start + i, r0, cl(st.x), cl(st.out), cl(coefs.pre), cl(coefs.post),
+                             cl(coefs.comb), list(sg.ids[i:]), sg.start + n))
+            fw.keep(sg.slot, n - 1)
+            a += n
+        del st, coefs
+        for job in jobs:
+            _decoder(fw, d, *job)
+
+
+def _decoder(fw, d: int, slot: int, b0: int, r0: int, x, out, pre, post, comb, ids, end: int) -> None:
+    """Layers D .. 39 over a slot's rows [b0, end) from the rows entering layer D, windows from r0; the DSpark taps
+    of those rows go to the drafter as a full run's keep would send them."""
+
+    from . import blocks as B
+    from . import prefill_mm as PM
+    from . import prune as PR
+    from .csa2.backend import Win
+    from .forward import Streams
+    from .replay import _image
+
+    m = end - b0
+    cfg, ops, dev = fw.cfg, fw.hc, fw.device
+    st = Streams(x, out, ops.Scratch(m, dev, cfg.hidden_size),
+                 [ops.Coefs(m, dev, pre=pre, post=post, comb=comb), ops.Coefs(m, dev)], image=_image(ids, dev))
+    wants = getattr(ops, "out_of_place", None)          # as ``Forward._run``: per-stream mHC programs, out of place
+    if wants is not None and wants(m):
+        st.alt = torch.empty_like(x)
+    ctx = B.Context(Win.make(b0, m, dev), fw.tables, fw.csa2, fw.ring, fw.slots[slot], 0, fw.staging(m))
+    ctx.lo = torch.full((m,), int(r0), dtype=torch.int32, device=dev)
+    ctx.comp_done = True                        # layer D's compressor ran in the encoder pass
+    first = next(i for i, blk in enumerate(fw.blocks) if blk.index == d)
+    with PM.fast(fw.fast_prefill), PR.phase(True):
+        fw._layers(st, [ctx], None, first=first, entered=True)
+        fw._finish(st, logits=False)
+    taps = dict(st.taps)
+    fw.slots[slot].taps = taps
+    if taps and end > getattr(fw, "_ingest_from", {}).get(slot, 0):
+        fw.replayed(slot, b0, taps)             # ``DecodeForward``: the drafter's context rows (its last window)
+
+
+__all__ = ["ENV", "enabled", "kind", "prefill", "span", "start"]
