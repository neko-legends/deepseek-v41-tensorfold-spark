+++ b/src/tensorfold/families/deepseek_v41/cuda/bias_vl_fetch.py
@@ -0,0 +1,144 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The image routing bias (``*.ffn.gate.bias_vl``) as a 66 KB sidecar: both EXL3 2.9 bpw packs (MiaAI, dealignai)
+dropped these 43 fp32 tensors (40 layers + 3 DSpark blocks); DeepSeek's release has them, spread over 43 of its 48
+~20 GB shards. This reads only their bytes (HTTP range requests: each shard's safetensors header, then each
+tensor's span) and writes one ``bias_vl.safetensors`` that ``TF_DSV41_BIAS_VL`` names (its folder).
+
+    python -m tensorfold.families.deepseek_v41.cuda.bias_vl_fetch OUT_DIR [--repo deepseek-ai/DeepSeek-V4.1-Flash]
+        [--revision main] [--src LOCAL_RELEASE_DIR]
+
+``--src``: a local copy of the release (or any folder of its shards holding the tensors) instead of the network.
+The file records the source repo / revision and each tensor's SHA-256 in its ``__metadata__``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import struct
+import sys
+import urllib.request
+from pathlib import Path
+
+REPO = "deepseek-ai/DeepSeek-V4.1-Flash"
+SUFFIX = ".ffn.gate.bias_vl"
+FILE = "bias_vl.safetensors"
+
+
+def _url(repo: str, revision: str, name: str) -> str:
+    return f"https://huggingface.co/{repo}/resolve/{revision}/{name}"
+
+
+def _range(url: str, lo: int, hi: int, timeout: float = 60.0) -> bytes:
+    """Bytes [lo, hi) of ``url``."""
+
+    req = urllib.request.Request(url, headers={"Range": f"bytes={lo}-{hi - 1}"})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        data = r.read()
+    if len(data) != hi - lo:
+        raise OSError(f"{url}: asked {hi - lo} bytes at {lo}, got {len(data)} (no range support?)")
+    return data
+
+
+class Remote:
+    def __init__(self, repo: str, revision: str) -> None:
+        self.repo, self.revision = repo, revision
+
+    def index(self) -> dict:
+        with urllib.request.urlopen(_url(self.repo, self.revision, "model.safetensors.index.json"), timeout=60) as r:
+            return json.loads(r.read())["weight_map"]
+
+    def read(self, file: str, lo: int, hi: int) -> bytes:
+        return _range(_url(self.repo, self.revision, file), lo, hi)
+
+
+class Local:
+    def __init__(self, root: str | Path) -> None:
+        self.root = Path(root)
+
+    def index(self) -> dict:
+        idx = self.root / "model.safetensors.index.json"
+        if idx.is_file():
+            return json.loads(idx.read_text())["weight_map"]
+        out = {}
+        for p in sorted(self.root.glob("*.safetensors")):
+            out.update({k: p.name for k in header(self, p.name)[0] if k != "__metadata__"})
+        return out
+
+    def read(self, file: str, lo: int, hi: int) -> bytes:
+        with open(self.root / file, "rb") as f:
+            f.seek(lo)
+            data = f.read(hi - lo)
+        if len(data) != hi - lo:
+            raise OSError(f"{self.root / file}: short read")
+        return data
+
+
+def header(src, file: str) -> tuple[dict, int]:
+    n = struct.unpack("<Q", src.read(file, 0, 8))[0]
+    if not 0 < n < 1 << 28:
+        raise ValueError(f"{file}: not a safetensors file (header of {n} bytes)")
+    return json.loads(src.read(file, 8, 8 + n)), 8 + n
+
+
+def collect(src) -> dict[str, tuple[str, list, bytes]]:
+    """{name: (dtype, shape, raw bytes)} of every ``*.ffn.gate.bias_vl``."""
+
+    wm = src.index()
+    names = sorted(k for k in wm if k.endswith(SUFFIX))
+    if not names:
+        raise ValueError("the source holds no *.ffn.gate.bias_vl tensor")
+    heads: dict[str, tuple[dict, int]] = {}
+    out = {}
+    for name in names:
+        file = wm[name]
+        if file not in heads:
+            heads[file] = header(src, file)
+        h, base = heads[file]
+        e = h[name]
+        lo, hi = e["data_offsets"]
+        out[name] = (e["dtype"], list(e["shape"]), src.read(file, base + lo, base + hi))
+    return out
+
+
+def write(path: Path, tensors: dict[str, tuple[str, list, bytes]], meta: dict[str, str]) -> None:
+    hdr: dict = {"__metadata__": dict(meta)}
+    at = 0
+    for name, (dtype, shape, raw) in tensors.items():
+        hdr[name] = {"dtype": dtype, "shape": shape, "data_offsets": [at, at + len(raw)]}
+        hdr["__metadata__"][f"sha256:{name}"] = hashlib.sha256(raw).hexdigest()
+        at += len(raw)
+    blob = json.dumps(hdr, separators=(",", ":")).encode()
+    blob += b" " * (-len(blob) % 8)
+    tmp = path.with_suffix(".tmp")
+    with open(tmp, "wb") as f:
+        f.write(struct.pack("<Q", len(blob)))
+        f.write(blob)
+        for _, _, raw in tensors.values():
+            f.write(raw)
+    tmp.replace(path)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    ap.add_argument("out_dir")
+    ap.add_argument("--repo", default=REPO)
+    ap.add_argument("--revision", default="main")
+    ap.add_argument("--src", default="", help="a local folder of the release's shards (no network)")
+    a = ap.parse_args(argv)
+    src = Local(a.src) if a.src else Remote(a.repo, a.revision)
+    tensors = collect(src)
+    out = Path(a.out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    meta = {"source": a.src or f"{a.repo}@{a.revision}", "count": str(len(tensors))}
+    write(out / FILE, tensors, meta)
+    total = sum(len(r) for _, _, r in tensors.values())
+    print(f"{out / FILE}: {len(tensors)} tensors, {total} bytes "
+          f"({', '.join(sorted({d for d, _, _ in tensors.values()}))})")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
