+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G10 offline checks (no GPU) of the PDL plumbing (``pdl.py``, TF_DSV41_PDL) and the L2 prefetch (``l2pf.py``,
+TF_DSV41_L2PF); the GPU half is ``tests/cuda/test_dsv41_pdl_gpu.py``.
+
+- the knobs: parts, refusals, ``triton_kw`` (both keys on or both off; never under the interpreter);
+- every PDL-aware Triton kernel starts with ``if PDL: gdc_wait(); gdc_launch_dependents()`` (wait first, nothing
+  before it) and every launch of it passes ``**P.triton_kw()`` (a kernel launched with the attribute always waits);
+- the kernels compiled for sm_121 by Triton's own ptxas: PDL on has the wait before any global store and the trigger
+  after the wait; PDL off has neither and is otherwise the same PTX (register names aside);
+- x3seg.cu: seg_rot_in waits before anything and triggers after; seg_linear reads only weight words before its wait,
+  stores nothing before it, and triggers after it; both launchers go through cudaLaunchKernelEx with the attribute;
+- x3ld takes TF_DSV41_PDL's ``experts`` part; ``linear.Exl3`` routes to ``fused_proj.single`` only with ``single``;
+- l2pf: settings, spans (16-byte aligned, whole tensors in order, the budget), the sites' tensors, the hooks' no-op.
+"""
+
+from __future__ import annotations
+
+import ast
+import inspect
+import re
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import l2pf as L2
+from tensorfold.families.deepseek_v41.cuda import pdl as P
+
+CUDA = Path(P.__file__).parent
+PDL_MODULES = ["rmsnorm.py", "rope_fused.py", "csa2/attn.py", "csa2/compress.py", "engram.py", "plain_fp64.py"]
+
+
+# -- knobs ------------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("raw,want", [(None, set()), ("", set()), ("0", set()), ("off", set()), ("1", set(P.PARTS)),
+                                      ("all", set(P.PARTS)), ("seg", {"seg"}), (" triton , seg ", {"seg", "triton"})])
+def test_parse(raw, want):
+    assert P.parse(raw) == want
+
+
+@pytest.mark.parametrize("raw", ["2", "seg,bogus", ",", "dense"])
+def test_parse_refuses(raw):
+    with pytest.raises(ValueError):
+        P.parse(raw)
+
+
+@pytest.mark.parametrize("pdl", ["1", "all", "seg", "single", "experts", "triton", " seg , triton "])
+def test_check_refuses_pdl_with_dense_v3(pdl):
+    """G14: PDL with TF_DSV41_DENSE_V3=1 is not bit-exact; the boot refuses any part of it, saying why and how out."""
+
+    with pytest.raises(ValueError) as e:
+        P.check({P.ENV: pdl, P.DENSE_V3: "1"})
+    msg = str(e.value)
+    assert "TF_DSV41_PDL" in msg and "TF_DSV41_DENSE_V3=1" in msg and "bit-exact" in msg and "TF_DSV41_PDL=0" in msg
+
+
+@pytest.mark.parametrize("env,want", [
+    ({}, set()),
+    ({"TF_DSV41_PDL": "0", "TF_DSV41_DENSE_V3": "1"}, set()),           # production: PDL=0 with DENSE_V3
+    ({"TF_DSV41_DENSE_V3": "1"}, set()),
+    ({"TF_DSV41_PDL": "off", "TF_DSV41_DENSE_V3": " 1 "}, set()),
+    ({"TF_DSV41_PDL": "1"}, set(P.PARTS)),                              # PDL without DENSE_V3: G10's lever, as before
+    ({"TF_DSV41_PDL": "1", "TF_DSV41_DENSE_V3": "0"}, set(P.PARTS)),
+    ({"TF_DSV41_PDL": "seg", "TF_DSV41_DENSE_V3": ""}, {"seg"}),
+])
+def test_check_passes(env, want):
+    assert P.check(env) == want
+
+
+def test_check_reads_the_environment_and_still_refuses_bad_values(monkeypatch):
+    monkeypatch.setenv(P.ENV, "1")
+    monkeypatch.setenv(P.DENSE_V3, "1")
+    with pytest.raises(ValueError, match="DENSE_V3"):
+        P.check()
+    monkeypatch.setenv(P.DENSE_V3, "0")
+    assert P.check() == set(P.PARTS)
+    monkeypatch.setenv(P.ENV, "bogus")
+    with pytest.raises(ValueError):
+        P.check()
+
+
+def test_the_boot_calls_check_before_building():
+    """The engine checks before NCCL / weights (fail fast), the forward before its L2 sites and PDL prebuild (the path
+    tests and benches take without the engine)."""
+
+    eng = (CUDA / "engine.py").read_text()
+    i = eng.index("PD.check()")
+    assert i < eng.index("NCCL(rank") and i < eng.index("cached_tree(\"weights\"")
+    fw = (CUDA / "forward.py").read_text()
+    assert fw.index("PD.check()") < fw.index("L2.install(") < fw.index("PD.prebuild(")
+
+
+@pytest.mark.torch
+def test_forward_refuses_pdl_with_dense_v3(monkeypatch, tmp_path):
+    """The synthetic checkpoint's forward (CPU): DENSE_V3=1 with PDL=1 refuses at construction; PDL=0 builds."""
+
+    import dsv41_dspark_fakes as DF
+
+    ck = DF.ckpt(tmp_path / "ck")
+    monkeypatch.setenv(P.DENSE_V3, "1")
+    monkeypatch.setenv(P.ENV, "1")
+    with pytest.raises(ValueError, match="not bit-exact"):
+        DF.forward(ck, slots=1, limit=512)
+    monkeypatch.setenv(P.ENV, "0")
+    assert DF.forward(ck, slots=1, limit=512) is not None
+
+
+def test_triton_kw(monkeypatch):
+    monkeypatch.delenv("TRITON_INTERPRET", raising=False)
+    monkeypatch.setattr(P, "capable", lambda device=0: True)
+    monkeypatch.setattr(torch.cuda, "current_device", lambda: 0)
+    monkeypatch.setenv(P.ENV, "seg")
+    assert P.triton_kw() == {"PDL": False}
+    monkeypatch.setenv(P.ENV, "triton")
+    assert P.triton_kw() == ({"PDL": True, "launch_pdl": True} if P.triton_ok() else {"PDL": False})
+    monkeypatch.setenv("TRITON_INTERPRET", "1")
+    assert P.triton_kw() == {"PDL": False}
+    monkeypatch.delenv(P.ENV)
+    monkeypatch.delenv("TRITON_INTERPRET")
+    assert P.triton_kw() == {"PDL": False} and not P.on("seg")
+
+
+# -- the Triton kernels' structure ---------------------------------------------------------------------------------
+def _jit_kernels(tree):
+    for node in tree.body:
+        if isinstance(node, ast.FunctionDef) and any("jit" in ast.unparse(d) for d in node.decorator_list):
+            yield node
+
+
+@pytest.mark.parametrize("mod", PDL_MODULES)
+def test_triton_kernels_wait_first_and_launch_with_kw(mod):
+    src = (CUDA / mod).read_text()
+    tree = ast.parse(src)
+    pdl_kernels = []
+    for fn in _jit_kernels(tree):
+        if "PDL" not in [a.arg for a in fn.args.args]:
+            continue
+        pdl_kernels.append(fn.name)
+        body = [s for s in fn.body if not (isinstance(s, ast.Expr) and isinstance(s.value, ast.Constant))]
+        first = body[0]
+        assert isinstance(first, ast.If) and ast.unparse(first.test) == "PDL", (mod, fn.name)
+        calls = [ast.unparse(s) for s in first.body]
+        assert calls == ["gdc_wait()", "gdc_launch_dependents()"], (mod, fn.name, calls)
+        assert not first.orelse
+    assert pdl_kernels, mod
+    for call in ast.walk(tree):
+        if isinstance(call, ast.Call) and isinstance(call.func, ast.Subscript) and \
+                isinstance(call.func.value, ast.Name) and call.func.value.id in pdl_kernels:
+            kws = [ast.unparse(k.value) for k in call.keywords if k.arg is None]
+            assert "P.triton_kw()" in kws, (mod, call.func.value.id, ast.unparse(call)[:120])
+            assert not any(k.arg in ("PDL", "launch_pdl") for k in call.keywords), (mod, call.func.value.id)
+
