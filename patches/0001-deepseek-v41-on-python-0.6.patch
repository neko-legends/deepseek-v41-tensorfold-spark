+@pytest.mark.parametrize("bmq", [16, 32])
+def test_fused_attention_row_invariance_and_paging(monkeypatch, bmq):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    R, P, ncomp = 6, 1000, 900
+    q, comp, swa_t, swa, sink, cs = _attn_case(R, P, ncomp, 5)
+    tok, cnt, _ = _lists(R, ncomp, 6)
+    lo = torch.zeros(R, dtype=torch.int32)
+    out = _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    for r in (0, 2, 5):
+        one = _fused(q[r:r + 1].contiguous(), comp, tok[r:r + 1].contiguous(), cnt[r:r + 1].contiguous(), swa_t,
+                     lo[r:r + 1].contiguous(), P + r, sink, cs)
+        assert torch.equal(_bits(one[0]), _bits(out[r]))
+    mid = _fused(q[1:4].contiguous(), comp, tok[1:4].contiguous(), cnt[1:4].contiguous(), swa_t,
+                 lo[1:4].contiguous(), P + 1, sink, cs)
+    assert torch.equal(_bits(mid), _bits(out[1:4]))
+    big = _fused(q, comp, tok, cnt, swa_t, lo, P, sink, cs, ring=512)            # a staging ring: the same rows
+    sv2 = torch.zeros((512, RW.VB), dtype=torch.uint8)
+    ss2 = torch.zeros((512, RW.SB), dtype=torch.uint8)
+    for p in range(max(0, P - 140), P + R):
+        sv2[p % 512], ss2[p % 512] = swa_t[0][p % 256], swa_t[1][p % 256]
+    big = _fused(q, comp, tok, cnt, (sv2, ss2), lo, P, sink, cs, ring=512)
+    assert torch.equal(_bits(big), _bits(out))
+    page = 64
+    n_log = triton.cdiv(ncomp, page)
+    pt = torch.randperm(n_log + 3, generator=torch.Generator().manual_seed(7))[:n_log].to(torch.int32).contiguous()
+    nphys = (n_log + 3) * page
+    pv = torch.full((nphys, RW.VB), 0x7F, dtype=torch.uint8)
+    ps = torch.full((nphys, RW.SB), 0xFF, dtype=torch.uint8)
+    for j in range(ncomp):
+        pv[int(pt[j // page]) * page + j % page] = comp[0][j]
+        ps[int(pt[j // page]) * page + j % page] = comp[1][j]
+    outp = _fused(q, (pv, ps), tok, cnt, swa_t, lo, P, sink, cs, pg=dict(page_table=pt, page_shift=6))
+    assert torch.equal(_bits(outp), _bits(out))
+
