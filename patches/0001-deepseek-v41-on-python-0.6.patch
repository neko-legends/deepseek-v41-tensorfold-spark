@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G4: the router kernel's sqrt-softplus where ``log(1 + e^z)`` underflows (Triton's CPU interpreter).
+
+A row whose normed FFN input is dominated by one massive channel (an attention-sink-like row: prompt 5's row 44
+after the mid-sequence EOS + BOS, max / rms ~43 against the real sinks' ~21) can have every router logit below
+-16.6. fp32 ``1 + e^z`` is then exactly 1, the kernel's s = sqrt(log(1)) = 0 for all experts, and the renormalized
+weights 0 / 0 = NaN: the MoE output, then all four mHC streams, then (through attention) every later row turn NaN.
+torch's softplus (log1p: engine/reference/moe.py, ``moe.route_twin``, vLLM's sqrt-softplus router) keeps s > 0 down
+to z ~ -103. The fix keeps the old arithmetic on [-10, 20] (the same bits for every ordinary row) and uses log1p's
+series below -10."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import moe as MO  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import router  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(router._route).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+C = 2455          # the sink channel of the G4 trace (any column would do)
+
+
+def _sink_rows(E: int, lo: float, hi: float, seed: int = 0, D: int = router.DIMS):
+    """Rows like a hyper-concentrated sink's normed input, reduced to its massive channel (64, 48, 32): the logits
+    are then exact in fp32 (one bf16 x fp16 product), so the weights compare with float64 without the FMA chain's
+    rounding over 5,120 terms (~1e-4 absolute at |z| ~ 50: inherent, the kit's too). The gate's column C spreads
+    the experts' logits over [lo, hi] at the first row's 64 (the others' scale with it)."""
+
+    g = torch.Generator().manual_seed(seed)
+    x = torch.zeros((3, D))
+    x[:, C] = torch.tensor([64.0, 48.0, 32.0])
+    x = x.to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * 1e-3)
+    w[:, C] = torch.linspace(lo, hi, E)[torch.randperm(E, generator=g)] / 64.0
+    w = w.to(torch.float16).contiguous()
+    b = (torch.randperm(E, generator=g) * 1e-3).to(torch.float16)     # distinct: no fp32 / fp64 tie-break noise
+    return x, w, b
+
+
+def _old_weights(x, w, b, topk):
+    """The pre-fix kernel's arithmetic in torch fp32: log(1 + e^z), exactly 0 below -16.6."""
+
+    z = x.float() @ w.float().t()
+    s = torch.where(z > 20, z, torch.log(1.0 + torch.exp(z.clamp(max=20.0)))).sqrt()
+    pick = (s + b.float()).topk(topk, -1).indices
+    sv = s.gather(1, pick)
+    return 1.5 * sv / sv.sum(-1, keepdim=True)
+
+
+@pytest.mark.parametrize("E,topk", [(384, 6), (128, 3)])
+@pytest.mark.parametrize("mode", router.MODES)
+def test_all_logits_below_underflow_route_finite(E, topk, mode):
+    x, w, b = _sink_rows(E, -60.0, -34.0)            # rows 1, 2 at 3/4, 1/2 of it: every logit below -16.6
+    assert bool(torch.isnan(_old_weights(x, w, b, topk)).all())          # the G4 NaN, row for row
+    pick, wts = router.route(x, w, b, topk=topk, mode=mode)
+    assert bool(torch.isfinite(wts).all())
+    rp, rw = router.reference(x, w, b, topk)
+    assert torch.equal(pick[:, :topk], rp)
+    torch.testing.assert_close(wts[:, :topk].double(), rw, rtol=1e-5, atol=0.0)
+    torch.testing.assert_close(wts[:, :topk].sum(1).double(), torch.full((3,), 1.5, dtype=torch.float64))
+
+
+@pytest.mark.parametrize("mode", router.MODES)
+def test_straddling_the_series_threshold(mode):
+    """Logits on [-13, -7]: the picks' weights follow torch's softplus on both sides of -10."""
+
+    x, w, b = _sink_rows(384, -13.0, -7.0, seed=3)
+    pick, wts = router.route(x, w, b, mode=mode)
+    rp, rw = router.reference(x, w, b)
+    assert torch.equal(pick[:, :6], rp)
+    torch.testing.assert_close(wts[:, :6].double(), rw, rtol=5e-3, atol=0.0)   # [-10, -7]: the old arithmetic
+
+
+def test_matches_the_cpu_twin():
+    """The GPU kernel and the CPU forward's router (``moe.route_twin``, torch softplus) agree on sink rows."""
+
+    x, w, b = _sink_rows(384, -60.0, -34.0, seed=5)
+    pick, wts = router.route(x, w, b, mode="fused")
+    tp, tw = MO.route_twin(x, w, b, 6, router.SCALE)
+    assert torch.equal(pick, tp)
+    torch.testing.assert_close(wts.double(), tw.double(), rtol=1e-5, atol=0.0)
+
+
+@pytest.mark.parametrize("mode", ["fused", "split"])
+def test_sink_row_alone_equals_in_a_window(mode):
+    x, w, b = _sink_rows(384, -60.0, -34.0, seed=7)
+    g = torch.Generator().manual_seed(11)
+    xs = torch.cat([(torch.randn((18, router.DIMS), generator=g)).to(torch.bfloat16), x], 0).contiguous()
+    pick, wts = router.route(xs, w, b, mode=mode)
+    for r in (18, 19, 20):
+        p1, w1 = router.route(xs[r:r + 1].contiguous(), w, b, mode=mode)
+        assert torch.equal(p1[0], pick[r]) and torch.equal(w1[0].view(torch.int32), wts[r].view(torch.int32))
