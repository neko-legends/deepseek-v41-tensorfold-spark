index 0000000..b56f343
--- /dev/null
+++ b/tests/test_dsv41_rotate.py
@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: MIT
+"""TF_DSV41_EXPERT_ROTATE (CPU): the uneven TP4 expert split rotated by expert id.
+
+- ``expert_bounds``: for every expert the four ranks' slices partition the width; across any 4 consecutive experts
+  each rank holds the wide (5-block) slice exactly twice; even splits (TP2) are untouched;
+- the loader: a rank's ragged stacks are exactly the rotated slices of the full matrices, the shared expert's wide
+  slices sit on ranks 2 and 3;
+- the forward: four rotated ranks == one rank in exact numerics, and the ranks agree bit for bit.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+TP4 = dict(num_attention_heads=4, o_groups=4, moe_intermediate_size=640, vocab_size=640)
+IDS = torch.randint(0, 640, (29,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+def test_rotate_knob(monkeypatch):
+    monkeypatch.delenv(W.ENV_ROTATE, raising=False)
+    assert W.rotate_on() is False
+    monkeypatch.setenv(W.ENV_ROTATE, "1")
+    assert W.rotate_on() is True
+    monkeypatch.setenv(W.ENV_ROTATE, "maybe")
+    with pytest.raises(ValueError):
+        W.rotate_on()
+
+
+def test_expert_bounds_partition_and_rotate():
+    for e in range(12):
+        b = [W.expert_bounds(2304, 4, r, e, True) for r in range(4)]
+        assert sorted(b)[0][0] == 0 and sorted(b)[-1][1] == 2304
+        assert sum(hi - lo for lo, hi in b) == 2304
+        s = sorted(b)
+        assert all(s[i][1] == s[i + 1][0] for i in range(3))
+        wide = {r for r in range(4) if b[r][1] - b[r][0] == 640}
+        assert wide == {e % 4, (e + 1) % 4}
+    for r in range(4):
+        assert sum(W.expert_bounds(2304, 4, r, e, True)[1] - W.expert_bounds(2304, 4, r, e, True)[0] == 640
+                   for e in range(4)) == 2
+    # even splits and rotation off: exactly block_bounds
+    assert [W.expert_bounds(2304, 2, r, 3, True) for r in range(2)] == [W.block_bounds(2304, 2, r) for r in range(2)]
+    assert [W.expert_bounds(2304, 4, r, 3, False) for r in range(4)] == [W.block_bounds(2304, 4, r) for r in range(4)]
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41rot"), **TP4)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def test_ragged_slices_are_the_rotated_blocks(ckpt):
+    root, cfg, _ = ckpt
+    full = W.Loader(cfg, W.Shards(root), 0, 1).load(2)
+    parts = [W.Loader(cfg, W.Shards(root), r, 4, rotate=True).load(2) for r in range(4)]
+    m0, mp = full.layers[1].moe, [p.layers[1].moe for p in parts]
+    assert all(isinstance(m.w1, W.X3Ragged) for m in mp)
+    for e in range(m0.w1.count):
+        order = sorted(range(4), key=lambda r: W.expert_bounds(640, 4, r, e, True)[0])
+        for name, dim in (("w1", 1), ("w3", 1), ("w2", 0)):
+            joined = torch.cat([getattr(mp[r], name).trellis[e] for r in order], dim)
+            assert torch.equal(joined, getattr(m0, name).trellis[e]), (e, name)
+        assert [mp[r].w1.trellis[e].shape[1] * 16 for r in range(4)] == \
+            [256 if (r - e) % 4 == 0 else 128 for r in range(4)]
+    sh = [p.layers[1].moe.shared[0][0].trellis.shape[1] * 16 for p in parts]
+    assert sh == [128, 128, 256, 128]                     # SHARED_ROT = 2: the 256-wide slice on rank 2
+
+
+def build(ckpt, rank=0, world=1, comm=None, chunk=8):
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world, rotate=world > 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def run(fw, ids, windows):
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(ids[a:a + n]))
+        a += n
+    return torch.cat(out)
+
+
+def tp4(ckpt, fn, **kw):
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = [build(ckpt, r, 4, comms[r], **kw) for r in range(4)]
+    return pair.run([lambda f=f: fn(f) for f in fws])
+
+
+def test_rotated_tp4_equals_one_rank_exact(ckpt):
+    with N.exact():
+        one = run(build(ckpt, chunk=16), IDS, [16, 13])
+        parts = tp4(ckpt, lambda f: run(f, IDS, [16, 13]), chunk=16)
+    every = torch.cat(parts, 1)
+    assert (every - one).abs().max().item() < 1e-10 * max(1.0, one.abs().max().item())
+
+
+def test_rotated_ranks_agree_bit_for_bit(ckpt):
+    def go(f):
+        f.trace = {}
+        run(f, IDS, [8, 8, 8, 5])
+        return {k: v.clone() for k, v in f.trace.items()}
+
+    traces = tp4(ckpt, go)
+    for t in traces[1:]:
+        for L in traces[0]:
+            assert torch.equal(traces[0][L], t[L]), L
diff --git a/tests/test_dsv41_router_fused_interp.py b/tests/test_dsv41_router_fused_interp.py
new file mode 100644
index 0000000..d306448
--- /dev/null
+++ b/tests/test_dsv41_router_fused_interp.py
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fused router (families/deepseek_v41/cuda/router.py, ``mode="fused"``: split-K partials + the row block's
+last-arriving program's fixed-order sum and selection) in Triton's CPU interpreter: its logits are exactly the
+documented arithmetic, at least as accurate vs float64 as G4's 5,120-long chains, a row's bits are the same alone and
+in any window of any R at any tile position, chunked == unchunked, and the counters are back to 0 after a call."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import fma32, gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import router  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(router._fused).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+SMALL_D = 1024    # the invariance sweeps: 2 k steps a slice (D % (SLICES x FBK) == 0)
+
+
+def _inputs(R: int, E: int, seed: int, D: int = router.DIMS):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, D), generator=g).to(torch.bfloat16)
+    w = (torch.randn((E, D), generator=g) * 0.02).to(torch.float16).contiguous()
+    b = (torch.randn(E, generator=g) * 0.1).to(torch.float16)
+    return x, w, b
+
+
+def _bits(p, w):
+    return p.clone(), w.view(torch.int32).clone()
+
+
+def test_logits_are_the_documented_sum():
+    """Each slice an fp32 FMA chain from 0 over its k ascending, then ((p0 + p1) + p2) + ... in fp32."""
+
+    import numpy as np
+
+    x, w, _ = _inputs(5, 128, 4, D=SMALL_D)
+    got = router.logits(x, w, "fused").numpy()
+    xa, wa = x.float().numpy(), w.float().numpy().T
+    ds = SMALL_D // router.SLICES
+    tot = None
+    for s in range(router.SLICES):
+        acc = np.zeros((5, 128), np.float32)
+        for k in range(s * ds, (s + 1) * ds):
+            acc = fma32(xa[:, k:k + 1], wa[k:k + 1, :], acc)
+        tot = acc if tot is None else (tot + acc).astype(np.float32)
+    assert np.array_equal(got.view(np.int32), tot.view(np.int32))
+
+
+@pytest.mark.parametrize("seed", [0, 1])
+def test_logits_at_least_as_accurate_as_split(seed):
+    x, w, _ = _inputs(16, 384, 10 + seed)
+    exact = x.double() @ w.double().T
+    new = (router.logits(x, w, "fused").double() - exact).abs()
+    old = (router.logits(x, w, "split").double() - exact).abs()
+    assert float(new.max()) <= float(old.max())
+    assert float(new.mean()) < float(old.mean())
+
+
+@pytest.mark.parametrize("E,topk,N,Rs", [(128, 3, 33, (1, 2, 3, 5, 16, 17, 33)), (384, 6, 18, (2, 17))])
+def test_row_invariance_sweep(E, topk, N, Rs):
+    """A row alone == the row in windows of R = 1, 2, 3, 5, 16, 17, 33 starting at row 0, 7 and N - R (tile positions
+    0 .. 15 of 1 .. 3 row blocks), bit for bit (E = 384: fewer rows, the interpreter's time)."""
+
+    x, w, b = _inputs(N, E, 20 + E, D=SMALL_D)
+    alone = [_bits(*router.route(x[r:r + 1].contiguous(), w, b, topk=topk, mode="fused")) for r in range(N)]
+    for R in Rs:
+        for off in sorted({0, N - R, min(7, N - R)}):
+            p, wt = router.route(x[off:off + R].contiguous(), w, b, topk=topk, mode="fused")
+            for i in range(R):
+                ap, aw = alone[off + i]
+                assert torch.equal(p[i], ap[0]) and torch.equal(wt[i].view(torch.int32), aw[0]), (R, off, i)
+
+
+def test_counters_self_clean_and_repeat():
+    x, w, b = _inputs(33, 384, 5, D=SMALL_D)
+    first = _bits(*router.route(x, w, b, mode="fused"))
+    cnt = router._counters(x.device)
+    assert int(cnt.abs().sum()) == 0 and cnt.numel() == router.CHUNK // 16
+    again = _bits(*router.route(x, w, b, mode="fused"))
+    assert torch.equal(first[0], again[0]) and torch.equal(first[1], again[1])
+    assert int(cnt.abs().sum()) == 0
+
+
+def test_chunked_equals_one_launch(monkeypatch):
+    x, w, b = _inputs(37, 128, 6, D=SMALL_D)
+    whole = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    monkeypatch.setattr(router, "CHUNK", 16)
+    parts = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    assert torch.equal(whole[0], parts[0]) and torch.equal(whole[1], parts[1])
+
+
+def test_fused_agrees_with_split_and_float64():
+    x, w, b = _inputs(16, 384, 9)
+    pf, wf = router.route(x, w, b, mode="fused")
+    ps, ws = router.route(x, w, b, mode="split")
+    rp, rw = router.reference(x, w, b)
+    assert torch.equal(pf, ps) and torch.equal(pf[:, :6], rp)
+    torch.testing.assert_close(wf, ws, rtol=1e-5, atol=1e-6)
+
+
+def test_d_must_split_evenly():
+    """route(): widths the slices do not divide take the split path (G6: the synthetic GPU checkpoints, D = 128);
+    the fused logits refuse them."""
+
+    x, w, b = _inputs(2, 128, 1, D=1000)
+    got = _bits(*router.route(x, w, b, topk=3, mode="fused"))
+    want = _bits(*router.route(x, w, b, topk=3, mode="split"))
+    assert torch.equal(got[0], want[0]) and torch.equal(got[1], want[1])
+    with pytest.raises(ValueError, match="fused needs D"):
+        router.logits(x, w, "fused")
