+def test_store_same_image_twice_in_one_request():
+    """G16 soak: an agent's history carries the same screenshot twice (same digest -> same virtual ids twice in one
+    table). 6e03615 counted a ref per occurrence: release raised StopIteration (HTTP 500) and left ``where`` on the
+    released table, so the next request with that image raised KeyError inside rank 0's forward (ranks desync)."""
+
+    st = V.Store()
+    shot = [VP.VBASE + 10, VP.VBASE + 11]
+    rows = torch.tensor([[10.0], [11.0]], dtype=torch.bfloat16)
+    twice = V.Table(shot + [VP.VBASE + 5] + shot, torch.cat([rows, torch.tensor([[5.0]], dtype=torch.bfloat16), rows]))
+    t1 = st.hold(twice)
+    assert st.gather(shot + [VP.VBASE + 5], "cpu")[:, 0].tolist() == [10.0, 11.0, 5.0]
+    st.release(t1)                                     # no StopIteration
+    assert len(st) == 0 and not st.refs and not st.tables
+    t2 = st.hold(V.Table(list(shot), rows.clone()))    # the next request with the same screenshot
+    assert st.gather(shot, "cpu")[:, 0].tolist() == [10.0, 11.0]
+    st.release(t2)
+    assert len(st) == 0
+
