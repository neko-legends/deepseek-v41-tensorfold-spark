+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Fast prefill kernels for DeepSeek-V4.1-Flash (``TF_DSV41_PREFILL_KERNELS=fast``): prompt rows through GEMMs that
+decode a weight once a segment instead of once every 16 rows, with the engine's exactness kept by a session tag
+(GLM patches/0080 / 0085, ``glm5_next/spark/fastpf.py``).
+
+Why. The decode kernels (upstream ``Exl3Linear``'s 1-128-row path, the grouped expert kernels) decode the EXL3
+trellis again for every 16 rows, which makes a prompt row cost the same at 2,048 rows as at 16. Here, in prefill
+runs only:
+
+- the dense EXL3 linears (attention, compressor, indexer, Engram ``wkv``) run upstream's ``exl3.prefill.matmul``:
+  W_q decoded once a call into a workspace, then a fixed-tile fp16 GEMM with the Hadamard epilogue; wide layers in
+  column blocks so the workspace stays under ``TF_DSV41_PREFILL_WS_MIB`` (64): each 128-column block is its own
+  program, so the blocks do not change a bit; ``TF_DSV41_PF_DENSE=fused`` (G16, ``pfdense``) decodes the trellis
+  inside the GEMM instead (no workspace, one launch a layer), the same bits;
+- the shared expert (``prefill_moe``) runs as three such GEMMs over all of the segment's rows, the routed experts
+  through upstream's grouped kernels (or ``TF_DSV41_FAST_EXPERTS=tc``: ``prefill_moe``'s Triton kernel).
+
+Exactness (the GLM 0085 argument, restated for this family):
+
+1. Every fast kernel is ROW-INDEPENDENT: tiles fixed by the weight's shape, K in a fixed order, no split-K chosen by
+   the row count, no atomics; a row's bits never depend on its segment-mates or the segment's length. So the state
+   after a fast prefill of tokens t[0:n] is a function of t[0:n] alone, whatever the segments (tests:
+   ``test_dsv41_prefill_fast``).
+2. Fast rows differ from decode rows (new arithmetic). Hence a session tag of their own (``tag_grid``: entries of
+   the exact tag never resume fast prompts and back), and no TURN snapshots under it (``rounds.Executor``): a turn's
+   end holds rows of the reply written by the row-invariant decode kernels, which a fresh fast prefill of the next
+   prompt would not reproduce. Prompt snapshots (at the replay point, before the decode rows) are kept; a next turn
+   resumes there and prefills the rest of the old prompt, the reply and the new tokens through the fast path.
+3. Decode, verify, DSpark, the head and the last prompt token (the first verify row, ``finish_prompt``) never run
+   fast kernels, so drafted == serial holds (the prefill is deterministic) and batched == alone (row-independent).
+
+On the CPU the twin's fast variant (``FastLinear`` over ``linear.Dense``) rounds each output through fp16 first:
+other bits, row-independent, so the tests see the tag mechanics. ``active()`` is thread-local (the TP tests run each
+rank on a thread).
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from contextlib import contextmanager
+from dataclasses import replace
+
+import torch
+
+from . import numerics as N
+
+ENV = "TF_DSV41_PREFILL_KERNELS"
+_TL = threading.local()
+_WS: dict = {}
+
+
+def mode() -> str:
+    """``TF_DSV41_PREFILL_KERNELS``: fast (default since G4) or exact (prompt rows == decode rows)."""
+
+    v = (os.environ.get(ENV, "fast").strip().lower() or "fast")
+    if v not in ("exact", "fast"):
+        raise ValueError(f"{ENV}={v!r}: expected exact or fast")
+    return v
+
+
+def experts_variant() -> int:
+    """``TF_DSV41_FAST_EXPERTS``: the routed experts of fast prefill runs: 0 = upstream's grouped kernels, 1 = ``tc``
+    (``prefill_moe``'s Triton kernel: other bits, hence another tag), 2 = ``gm`` (default since G6; ``x3gm``: CUDA,
+    the trellis decoded once a 64-member pass into the mma A fragment, one 2,048-row block a segment; its own tag).
+    G6 on the real weights: gm 18.1 vs grouped 60.0 ms a 2,048-row layer segment (1.16x its DRAM floor), prefill
+    1,314 / 1,390 / 1,397 / 1,365 tok/s at 8K / 32K / 64K / 128K (G5 grouped: 931 / 965 / 965 / 949). G4: tc
+    ~175-290 tok/s."""
+
+    v = (os.environ.get("TF_DSV41_FAST_EXPERTS", "gm").strip().lower() or "gm")
+    if v not in ("grouped", "tc", "gm"):
+        raise ValueError(f"TF_DSV41_FAST_EXPERTS={v!r}: expected grouped, tc or gm")
+    return {"grouped": 0, "tc": 1, "gm": 2}[v]
+
+
+def attn_variant() -> int:
+    """``TF_DSV41_PREFILL_ATTN`` (G7): the CSA2 attention of fast prefill runs: 0 = ``chunks`` (the decode path's
+    chunk + merge kernels, default), 1 = ``fused`` (``csa2.attn_pf``: one softmax pass a row, other bits)."""
+
+    v = (os.environ.get("TF_DSV41_PREFILL_ATTN", "chunks").strip().lower() or "chunks")
+    if v not in ("chunks", "fused"):
+        raise ValueError(f"TF_DSV41_PREFILL_ATTN={v!r}: expected chunks or fused")
+    return {"chunks": 0, "fused": 1}[v]
+
+
+def copies() -> bool:
+    """``TF_DSV41_PF_COPIES`` (G16, default 0): the fast prefill run's data movement trimmed, the same bits.
+
+    - a one-segment run takes the attention core's output tensor as is (no ``o[a:b] = ...`` copy: 67 MB at 2,048 rows);
+    - the fused prefill attention (``csa2.attn_pf``) stores its output group-major ([groups, R, 8 heads x 512]), so
+      every ``wo_a`` group reads a contiguous slice (no ``.contiguous()`` copy a group: 4 x 17 MB);
+    - each ``wo_a`` group's GEMM writes its columns of ``z`` in place (no ``torch.cat``);
+    - with bf16 prefill exchanges (``TF_DSV41_PREFILL_GATHER=bf16``, kit rounding): ``wo_b`` rounds its sums to bf16
+      in the GEMM's store (the same RNE as the ``.to(bf16)`` before the exchange) and the MoE's partial is one
+      ``bf16(routed + shared)`` kernel (the same fp32 add and RNE as ``out += shared`` then ``.to(bf16)``).
+
+    G5's nsys at 2,048 rows: ~1.9 ms a layer of copies and casts. Nothing changes a value: only where and in which
+    dtype a value already rounded so is stored."""
+
+    return (os.environ.get("TF_DSV41_PF_COPIES", "0").strip() or "0") not in ("0", "off", "no", "false")
+
+
+def gemm_tiles(k: int, n: int) -> tuple[int, int, int, int, int]:
+    """(BM, BK, warps, stages, group) of the prefill GEMM (upstream ``exl3.prefill._gemm``): upstream's ``tiles``
+    unless ``TF_DSV41_PREFILL_TILES`` = ``BM,BK,WARPS,STAGES,GROUP`` (G16, a sweep knob). Every choice keeps each
+    output's fp32 accumulator a chain of k16 ``mma.sync`` steps in ascending K (Triton's MMAv2 dot over BK walks K in
+    16-steps in order; BM / warps / stages / group only move which warp holds an output and when its loads issue), and
+    the tiles are a function of the shape alone, so rows stay independent of their segment. Same bits by
+    construction; the GPU test ``test_prefill_tiles_same_bits`` checks it, since it rests on Triton's lowering."""
+
+    from tensorfold.cuda.exl3 import prefill as P
+
+    raw = os.environ.get("TF_DSV41_PREFILL_TILES", "").strip()
+    if not raw:
+        return P.tiles(k, n)
+    try:
+        bm, bk, warps, stages, group = (int(v) for v in raw.split(","))
+    except ValueError as exc:
+        raise ValueError(f"TF_DSV41_PREFILL_TILES={raw!r}: expected BM,BK,WARPS,STAGES,GROUP") from exc
+    if bm not in (64, 128, 256) or bk not in (16, 32, 64) or warps not in (4, 8) or not 1 <= stages <= 5 \
+            or group < 1 or k % bk:
+        raise ValueError(f"TF_DSV41_PREFILL_TILES={raw!r}: BM 64 / 128 / 256, BK 16 / 32 / 64 dividing K={k}, "
+                         "4 / 8 warps, 1-5 stages, group >= 1")
+    return bm, bk, warps, stages, group
+
+
+def tag_grid() -> int:
+    """The session tag's prefill field (``sessions.Tag.grid``): 0 for exact; fast prompts on the 16-token snapshot
+    grid, one value a fast kernel set (16: grouped routed experts, 32: tc, 48: gm; + 1 with the fused prefill
+    attention, G7; + 2 with pipelined prompts, ``pipe``)."""
+
+    import os
+
+    pipe = int(os.environ.get("TF_DSV41_PREFILL_PIPE", "0").strip() or 0) > 0     # pipelined prompts: one rank's bits
+    return 0 if mode() == "exact" else 16 * (1 + experts_variant()) + attn_variant() + (2 if pipe else 0)
+
+
+@contextmanager
+def fast(on: bool = True):
+    """The forward's prefill runs: fast kernels for this thread's calls while ``on``."""
+
+    old = getattr(_TL, "on", False)
+    _TL.on = bool(on)
+    try:
+        yield
+    finally:
+        _TL.on = old
+
+
+def active() -> bool:
+    return getattr(_TL, "on", False)
+
+
+def workspace(device):
+    """One upstream ``prefill.Workspace`` a device (calls run in order on one stream; never shrinks)."""
+
+    key = str(device)
+    ws = _WS.get(key)
+    if ws is None:
+        from tensorfold.cuda.exl3.prefill import Workspace
+
+        ws = _WS[key] = Workspace()
+    return ws
+
+
+def workspace_bytes() -> int:
+    return sum(ws.nbytes() for ws in _WS.values())
+
+
+def ws_limit() -> int:
+    mib = int(os.environ.get("TF_DSV41_PREFILL_WS_MIB", "") or 64)
+    return max(1, mib) << 20
+
+
+def column_blocks(lin, limit: int) -> list:
+    """An upstream ``Exl3Linear`` ("strips" layout) as sub-layers of whole 128-column blocks, each one's decoded W_q
+    (K x N_c fp16) within ``limit`` bytes; the layer itself when it fits or is stored otherwise."""
+
+    k, n = lin.k, lin.n
+    # a strip is the leading dimension of both "strips" and dense3's "lanes" words (TF_DSV41_DENSE_V3)
+    if k * n * 2 <= limit or getattr(lin, "layout", "strips") not in ("strips", "lanes"):
+        return [(0, lin)]
+    per = max(1, limit // (k * 2 * 128))           # 128-column blocks a sub-layer
+    out = []
+    for b0 in range(0, n // 128, per):
+        b1 = min(n // 128, b0 + per)
+        c0, c1 = 128 * b0, 128 * b1
+        sub = replace(lin, words=lin.words[b0:b1], svh=lin.svh[c0:c1],
+                      bias=None if lin.bias is None else lin.bias[c0:c1], n=c1 - c0)
+        out.append((c0, sub))
+    return out
+
+
+def matmul(lin, x: torch.Tensor, dtype: torch.dtype, parts=None, out: torch.Tensor | None = None) -> torch.Tensor:
+    """y [M, N] = x @ W through upstream's ``prefill.matmul`` (column blocks: ``parts``), rounded to ``dtype``.
+    ``out`` (G16): an [M, N] view of that dtype with unit column stride to write into (any row stride)."""
+
+    from tensorfold.cuda.exl3.prefill import matmul as pmm
+
+    from . import dense3 as D3
+
+    x = x.contiguous()
+    if out is None:
+        out = torch.empty((x.shape[0], lin.n), dtype=dtype, device=x.device)
+    elif out.shape != (x.shape[0], lin.n) or out.dtype != dtype or out.stride(1) != 1:
+        raise ValueError(f"prefill matmul: out {tuple(out.shape)} {out.dtype} for [{x.shape[0]}, {lin.n}] {dtype}")
+    ws = workspace(x.device)
+    from . import pfdense as PD
+
+    if PD.enabled() and PD.why_not(lin) is None:
+        # G16 TF_DSV41_PF_DENSE=fused: the trellis decoded inside the GEMM, the whole layer in one launch (no W_q
+        # workspace, so no column blocks); the same bits as the loop below (pfdense.py's exactness notes)
+        return PD.matmul(lin, x, out, ws)
+    tiled = bool(os.environ.get("TF_DSV41_PREFILL_TILES", "").strip())
+    for c0, sub in parts or [(0, lin)]:
+        dst = out[:, c0:c0 + sub.n]
+        if tiled:
+            _tiled_matmul(sub, x, dst, ws)
+        else:
+            # dense3's lanes words: W_q decoded from that layout (the same values), upstream's GEMM
+            (D3.prefill_matmul if D3.is_lanes(sub) else pmm)(sub, x, dst, ws)
+    return out
+
+
+def _tiled_matmul(layer, x: torch.Tensor, out: torch.Tensor, ws) -> torch.Tensor:
+    """upstream ``prefill.matmul`` / ``dense3.prefill_matmul`` statement for statement with ``gemm_tiles``' tiles
+    (``TF_DSV41_PREFILL_TILES``): the same rotated input, the same decoded W_q, the same kernel."""
+
+    import triton
+
+    from tensorfold.cuda.exl3 import prefill as P
+    from tensorfold.cuda.exl3.linear import CODEBOOK_IDS
+
+    from . import dense3 as D3
+
+    m, k, n = x.shape[0], layer.k, layer.n
+    if x.shape[1] != k or out.shape != (m, n) or out.stride(1) != 1:
+        raise ValueError(f"prefill matmul: x {tuple(x.shape)} and out {tuple(out.shape)} do not match K={k}, N={n}")
+    xh = ws._grow("xh", m * k, x.device)[:m * k].view(m, k)
+    P._ext().rot_in(x.contiguous(), layer.suh, xh)
+    wq = ws._grow("w", k * n, x.device)[:k * n].view(k, n)
+    if D3.is_lanes(layer):
+        layer.unpack(wq)
+    else:
+        P._ext().unpack(layer.words, wq, *layer.strides, layer.k2, CODEBOOK_IDS[layer.codebook])
+    bm, bk, warps, stages, group = gemm_tiles(k, n)
+    bias = layer.bias if layer.bias is not None else layer.svh
+    P._gemm[(triton.cdiv(m, bm) * (n // P.BN),)](xh, wq, ws.hadamard(x.device), layer.svh, bias, out, m, out.stride(0),
+                                                 K=k, N=n, BM=bm, BK=bk, GROUP=group, HAS_BIAS=layer.bias is not None,
+                                                 SCALE=P.HAD_SCALE, num_warps=warps, num_stages=stages)
+    return out
+
+
+class FastLinear:
+    """A forward linear (``linear.Exl3`` on CUDA, ``linear.Dense`` on the CPU) that runs the fast arithmetic while
+    ``active()``; the decode path's call otherwise. ``k`` / ``n`` / ``lin`` pass through."""
+
+    def __init__(self, inner) -> None:
+        self.inner = inner
+        self._parts = None
+
+    def __getattr__(self, name):
+        return getattr(self.inner, name)
+
+    def __call__(self, x: torch.Tensor, dtype: torch.dtype = N.ACC, out: torch.Tensor | None = None) -> torch.Tensor:
+        """``out`` (G16 ``TF_DSV41_PF_COPIES``): write the result there ([M, N] view of ``dtype``, unit column
+        stride) and return it; the values are the same as without it."""
+
+        if not active():
+            return _into(self.inner(x, dtype), out)
+        lin = getattr(self.inner, "lin", None)
+        if lin is not None and x.is_cuda:
+            if self._parts is None:
+                self._parts = column_blocks(lin, ws_limit())
+            return matmul(lin, x, dtype, self._parts, out=out)
+        w = getattr(self.inner, "w", None)
+        if w is None:
+            return _into(self.inner(x, dtype), out)
+        y = self.inner(x, torch.float64)
+        return _into((y.to(torch.float16) if N.QUANT else y).to(N.ACC).to(dtype), out)  # the twin's fast variant
+
+
+def _into(y: torch.Tensor, out: torch.Tensor | None) -> torch.Tensor:
+    if out is None:
+        return y
+    out.copy_(y)
+    return out
+
+
+def wrap(lin):
+    """``FastLinear`` around an EXL3 linear of the forward (None stays None)."""
+
+    return None if lin is None or isinstance(lin, FastLinear) else FastLinear(lin)
+
+
+__all__ = [
+    "FastLinear",
+    "active",
+    "attn_variant",
+    "column_blocks",
+    "copies",
+    "experts_variant",
+    "fast",
+    "gemm_tiles",
+    "matmul",
+    "mode",
+    "tag_grid",
+    "workspace",
+    "workspace_bytes",
+    "wrap",
+]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/prefill_moe.py b/src/tensorfold/families/deepseek_v41/cuda/prefill_moe.py
new file mode 100644
index 0000000..f466b52
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/prefill_moe.py
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The MoE block of fast prefill runs (``prefill_mm``: ``TF_DSV41_PREFILL_KERNELS=fast``; never decode or verify).
+
+Per segment (R rows, this rank's half of every expert's width):
+
+- router: ``router.route`` in ``TF_DSV41_PREFILL_ROUTER`` mode (split: 2x fused's speed at 2,048 rows, G6), the kit's
+  fp16 weights;
+- shared expert: three ``exl3.prefill.matmul`` GEMMs over all R rows (W_q decoded once a call instead of once every
+  16 rows in the grouped launch), the kit's fp32 SwiGLU clamped at ``limit`` between them;
+- routed experts: ``TF_DSV41_FAST_EXPERTS=grouped`` upstream's grouped kernels with the shared slot masked
+  (its pick past the table: upstream skips it, its weight 0), or ``tc``: ``x3tc``'s Triton kernels (each expert's
+  trellis tile decoded once a k step for up to 64 member rows, full K a program, no split-K partials), or ``gm``:
+  ``x3gm``'s CUDA kernels (default since G6; the tile decoded from a cp.async ring straight into the mma A fragment, 64-member passes,
+  one 2,048-row block a segment; the grouped kernels for widths it does not cover);
+- the sum: the routed slots' weighted sum (in slot order), then + the shared output, fp32.
+
+Row-independent: the router, the grouped kernels and the GEMMs compute a row from that row alone (fixed tiles, fixed
+K order), and the sums are elementwise in a fixed order. New arithmetic against the decode path (the shared expert's
+sums, the slot order of the combine), hence the fast session tag (``prefill_mm.tag_grid``).
+"""
+
+from __future__ import annotations
+
+import torch
+
+from . import pick as P
+from . import prefill_mm as PM
+
+F32 = torch.float32
+
+
+def shared_linears(moe) -> tuple | None:
+    """(gate, up, down) of this rank's shared expert as upstream ``Exl3Linear``s on the stored trellis (no copy), or
+    None (no shared expert)."""
+
+    got = getattr(moe, "_fast_shared", False)
+    if got is not False:
+        return got
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    m = moe.block.keep[0] if moe.block.keep else None
+    shared = getattr(m, "shared", None)
+    out = None
+    if shared:
+        w1, w2, w3 = shared[0]
+        mk = (lambda t: Exl3Linear.from_tensors(t.trellis, t.suh, t.svh, t.codebook, device=t.trellis.device,
+                                                layout="stored"))
+        out = (mk(w1), mk(w3), mk(w2))
+    moe._fast_shared = out
+    return out
+
+
+def shared_expert(lins, x: torch.Tensor, limit: float) -> torch.Tensor:
+    """fp32 [R, D]: down(silu(min(gate x, limit)) * clamp(up x, +-limit)) through the prefill GEMMs."""
+
+    gate, up, down = lins
+    g = PM.matmul(gate, x, F32).clamp_(max=limit)
+    u = PM.matmul(up, x, F32).clamp_(min=-limit, max=limit)
+    act = torch.nn.functional.silu(g).mul_(u)
+    return PM.matmul(down, act, F32)
+
+
+def forward(moe, x: torch.Tensor, out_dtype: torch.dtype | None = None) -> torch.Tensor:
+    """``moe.GpuMoE.__call__`` for a fast prefill run: this rank's partial fp32 [R, D]. ``out_dtype`` (G16
+    ``TF_DSV41_PF_COPIES``, bf16): the partial as ONE ``torch.add(routed, shared, out=bf16)`` kernel: the fp32 add of
+    ``out += shared`` and the RNE of the ``.to(bf16)`` after it, without the fp32 partial's store and reload."""
+
+    from . import experts as X
+    from . import router
+    from .moe import row_blocks
+
+    R = x.shape[0]
+    x = x.contiguous()
+    moe.ensure(R)
+    pick, wts = router.route(x, moe.gate, moe.bias, topk=moe.topk, shared=True, scale=moe.scale,
+                             mode=router.PREFILL_MODE)
+    from . import prune as PR
+
+    rule = PR.rule_for(moe, prefill=True)       # TF_DSV41_EXPERT_PRUNE_PREFILL: dropped slots duplicate the row's
+    if rule is not None:                        # top kept expert at weight 0 (x3gm / x3tc read suh at every pick)
+        PR.apply(pick, wts, moe.topk, rule, moe.scale, moe.block.ex.count, dup=True)
+    wts = P.kit_weights(wts)
+    moe.last_pick = pick
+    lins = shared_linears(moe)
+    if lins is not None:                        # the shared slot leaves the grouped launch: past the table, weight 0
+        pick = pick.clone()
+        wts = wts.clone()
+        pick[:, moe.topk:] = moe.block.ex.count
+        wts[:, moe.topk:] = 0.0
+    variant = PM.experts_variant()
+    out = None
+    if variant == 1:
+        from . import x3tc
+
+        out = x3tc.routed(moe, x, pick[:, :moe.topk].contiguous(), wts[:, :moe.topk].contiguous(), moe.limit)
+    elif variant == 2:                          # x3gm; None: a width / shape it does not cover (the grouped kernels)
+        from . import x3gm
+
+        out = x3gm.routed(moe, x, pick[:, :moe.topk].contiguous(), wts[:, :moe.topk].contiguous(), moe.limit)
+    if out is None:
+        out = torch.empty((R, x.shape[1]), dtype=F32, device=x.device)
+        for a, b in row_blocks(R, moe.scratch.rows):
+            X.routed(x[a:b], pick[a:b], wts[a:b], moe.block, moe.scratch, out[a:b], b - a, limit=moe.limit)
+    if lins is not None:
+        shared = shared_expert(lins, x, moe.limit)
+        if out_dtype is not None and out_dtype != F32:
+            part = torch.empty((R, x.shape[1]), dtype=out_dtype, device=x.device)
+            return torch.add(out, shared, out=part)
+        out += shared
+    return out if out_dtype is None else out.to(out_dtype)
+
+
+__all__ = ["forward", "shared_expert", "shared_linears"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/projbench.py b/src/tensorfold/families/deepseek_v41/cuda/projbench.py
new file mode 100644
index 0000000..2f1f380
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/projbench.py
@@ -0,0 +1,281 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G7's dense-projection bench on one GPU (``fused_proj``, TF_DSV41_FUSED_PROJ): every attention EXL3
+projection of this rank's layers, from the checkpoint, at verify widths R:
+
+- bitwise, for every plan (TF_DSV41_PROJ_PLAN values): each layer's outputs (wq_a, wkv, compressor [kv | score],
+  wq_b, indexer wq_b, wo_a's groups, wo_b) fused == unfused, every R; row 0 of an R-row window == the row alone; a
+  CUDA graph of the fused layers replayed on new inputs == eager (the split-K counters are left at zero); the drift
+  of each plan's outputs from upstream's plan (max |diff| / max |value|);
+- speed: ms of a layer's dense projections and of all layers (the window's dense time), unfused vs fused, eager
+  and graph-replayed (decode runs graphs), + the launches a window (cost model: docs/DECODE-ROOFLINE.md section 5);
+- ``--nvtx``: the measurement inside cudaProfilerStart / Stop, an NVTX range a (mode, R, eager / graph), for
+  ``nsys profile --capture-range=cudaProfilerApi``.
+
+    python -m tensorfold.families.deepseek_v41.cuda.projbench --model DIR [--rank 0] [--layers all|0,2,20]
+           [--rows 1,2,4,8,16] [--iters 50] [--out projbench.json] [--nvtx] [--plans upstream,long]
+    (--plans: TF_DSV41_PROJ_PLAN values, upstream first; with explicit specs separate plans by ";")
+    ... projbench --gbps --model DIR [--layers 1,2,20] [--head]    G8 dense: GB/s a shape, x3dn vs upstream vs x3ld
+
+Inputs are random (bf16 x of RMS ~1, the q latent, the attention output): the kernels' time does not depend on
+values, and the bits are compared per element.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+ROWS = (1, 2, 4, 8, 16)
+SHOWN = (0, 2, 3, 20, 24)       # 6-bit wq_a / wkv, ratio-2 kv source, reuse, ratio-1 kv source, reindex
+
+
+def attn_of(cfg, ld, layer: int, device):
+    """A ``blocks.Attn`` of upstream ``Exl3Linear`` objects for one layer (the decode path's, no prefill wrapper)."""
+
+    from . import blocks as B
+    from . import linear as LN
+
+    a = ld.attn(layer, f"layers.{layer}")
+    mk = (lambda x: None if x is None else B.materialize(x, device))
+    return B.Attn(mk(a.wq_a), mk(a.wkv), mk(a.wq_b), [mk(w) for w in a.wo_a], mk(a.wo_b), a.q_norm, a.kv_norm,
+                  a.sink, mk(a.comp_wkv), mk(a.comp_wgate), a.comp_norm, mk(a.ix_wq_b),
+                  None if a.ix_wp is None else LN.Plain(a.ix_wp), mk(a.ix_wk), a.ix_knorm)
+
+
+def dense(A, G, x, qr, o, fused: bool):
+    """The layer's dense EXL3 outputs as ``blocks.attention`` computes them (comp: a kv source's first pass)."""
+
+    import torch
+
+    from . import numerics as N
+
+    act, acc = N.ACT, N.ACC
+    comp, ix = A.comp_wkv is not None, A.ix_wq_b is not None
+    if fused and G is not None and (G.x4 is not None or not comp):
+        qa, kva, proj = G.x(x, comp)
+    else:
+        qa, kva = A.wq_a(x, act), A.wkv(x, act)
+        proj = None
+        if comp:
+            proj = A.comp_wkv(x, act).to(acc)
+            if A.comp_wgate is not None:
+                proj = torch.cat([proj, A.comp_wgate(x, act).to(acc)], 1)
+    if fused and G is not None and ix and G.q is not None:
+        q, qi = G.qproj(qr)
+    else:
+        q, qi = A.wq_b(qr, act), (A.ix_wq_b(qr, act) if ix else None)
+    n, gl = o.shape[0], len(A.wo_a)
+    if fused and G is not None and G.o is not None:
+        z = G.oproj(o)
+    else:
+        og = o.reshape(n, gl, -1)
+        z = torch.cat([A.wo_a[g](og[:, g].contiguous(), act) for g in range(gl)], 1)
+    out = A.wo_b(z, acc)
+    return [t for t in (qa, kva, proj, q, qi, z, out) if t is not None]
+
+
+def launches(A, G, fused: bool) -> int:
+    """linear launches of a layer (rot_in launches: the same count)."""
+
+    comp, ix = A.comp_wkv is not None, A.ix_wq_b is not None
+    if not fused or G is None:
+        return 2 + comp + (A.comp_wgate is not None) + 1 + ix + len(A.wo_a) + 1
+    return 1 + 1 + (G.q is None and ix) + (1 if G.o is not None else len(A.wo_a)) + 1
+
+
+def _graph(fn):
+    import torch
+
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        for _ in range(2):
+            fn()
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        out = fn()
+    return g, out
+
+
+def _ms(fn, iters: int) -> float:
+    import torch
+
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(iters):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / iters
+
+
+def bench(model: str, rank: int, layers, rows, iters: int, nvtx: bool, plans=("upstream", "long")) -> dict:
+    import torch
+
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    ld = W.Loader(cfg, W.Shards(model), rank, 2, "cuda")
+    t0 = time.time()
+    attns = [(L, attn_of(cfg, ld, L, "cuda")) for L in layers]
+    rep: dict = {"rank": rank, "layers": list(layers), "load_s": round(time.time() - t0, 1), "plans": {},
+                 "bitwise": True, "row_invariant": True}
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    bf = torch.bfloat16
+    inputs = {}
+    for R in rows:
+        inputs[R] = (torch.randn((R, cfg.hidden_size), generator=gen, device="cuda").to(bf),
+                     torch.randn((R, cfg.q_lora_rank), generator=gen, device="cuda").to(bf),
+                     (torch.randn((R, (cfg.num_attention_heads // 2) * cfg.head_dim), generator=gen,
+                                  device="cuda") * 0.3).to(bf))
+    if nvtx:                                                    # nsys --capture-range=cudaProfilerApi: the rows
+        torch.cuda.synchronize()
+        torch.cuda.profiler.start()
+    base: dict = {}
+    for plan in plans:
+        built = set_plan(attns, plan)
+        pr = rep["plans"][plan] = {"rows": {}, "launches": {
+            "unfused": sum(launches(A, G, False) for _, A, G in built),
+            "fused": sum(launches(A, G, True) for _, A, G in built)},
+            "not_fused": [L for L, _, G in built if G is None]}
+        print(f"[projbench] plan {plan}: {len(built)} layers (loaded in {rep['load_s']} s); linear launches a "
+              f"window {pr['launches']['unfused']} -> {pr['launches']['fused']} (rot_in the same)", flush=True)
+        for R in rows:
+            pr["rows"][R] = measure(rep, built, plan, R, *(t.clone() for t in inputs[R]), iters, base)
+    if nvtx:
+        torch.cuda.synchronize()
+        torch.cuda.profiler.stop()
+    print(f"[projbench] bitwise (fused == unfused, graph == eager) {rep['bitwise']}; row invariant "
+          f"{rep['row_invariant']}", flush=True)
+    return rep
+
+
+def set_plan(attns, plan: str):
+    """Every layer's linears at ``plan`` (upstream: ``plan(K, N)``; else TF_DSV41_PROJ_PLAN's syntax), groups
+    rebuilt."""
+
+    from tensorfold.cuda.exl3.linear import plan as upstream_plan
+
+    from . import fused_proj as FP
+
+    out = []
+    for L, A in attns:
+        lins = [FP.lin_of(x) for x in (A.wq_a, A.wkv, A.comp_wkv, A.comp_wgate, A.wq_b, A.ix_wq_b, A.wo_b, *A.wo_a)
+                if x is not None]
+        for lin in lins:
+            lin.split = upstream_plan(lin.k, lin.n)
+        if plan != "upstream":
+            FP.apply_plan(A, FP.plan_spec({FP.PLAN_ENV: plan}))
+        out.append((L, A, FP.build(A)))
+    return out
+
+
+def measure(rep: dict, built, plan: str, R: int, x, qr, o, iters: int, base: dict) -> dict:
+    """One plan at R rows: bits (fused == unfused, a row alone == in the window, graph == eager), drift from
+    upstream's plan, ms of the window's dense projections (eager / graphed) and of a layer of each kind."""
+
+    import torch
+
+    bf = torch.bfloat16
+    row: dict = {"layers": {}}
+    drift = 0.0
+    for L, A, G in built:
+        ref = dense(A, G, x, qr, o, False)
+        got = dense(A, G, x, qr, o, True)
+        same = len(ref) == len(got) and all(torch.equal(a, b) for a, b in zip(ref, got))
+        one = dense(A, G, x[:1], qr[:1], o[:1], True)
+        inv = all(torch.equal(a[:1], b) for a, b in zip(got, one))
+        rep["bitwise"] &= same
+        rep["row_invariant"] &= inv
+        if not (same and inv):
+            print(f"[projbench] MISMATCH plan {plan} layer {L} R={R}: fused == unfused {same}, row {inv}", flush=True)
+        if plan == "upstream":
+            base[(L, R)] = [t.float() for t in got]
+        elif (L, R) in base:
+            for a, b in zip(got, base[(L, R)]):
+                drift = max(drift, ((a.float() - b).abs().max() / b.abs().max().clamp_min(1e-30)).item())
+    row["drift_vs_upstream"] = drift
+
+    def sweep(fz: bool):
+        return [dense(A, G, x, qr, o, fz) for _, A, G in built]
+
+    for mode in ("unfused", "fused"):
+        fz = mode == "fused"
+        torch.cuda.nvtx.range_push(f"projbench {plan} {mode} R={R} eager")
+        eager = _ms(lambda fz=fz: sweep(fz), iters)
+        torch.cuda.nvtx.range_pop()
+        g, outs = _graph(lambda fz=fz: sweep(fz))
+        if fz:                                                  # replays on new inputs == eager, counters at zero
+            for t, new in ((x, torch.randn_like(x, dtype=torch.float32).to(bf)), (o, (o * 1.5).to(bf))):
+                t.copy_(new)
+            g.replay()
+            torch.cuda.synchronize()
+            want = sweep(True)
+            ok = all(torch.equal(a, b) for wl, gl in zip(want, outs) for a, b in zip(wl, gl))
+            ok &= all(not (s.counters != 0).any().item() for _, _, G in built if G is not None
+                      for s in (G.x2, G.x4, G.q, G.o) if s is not None)
+            rep["bitwise"] &= ok
+            row["graph_replay_bitwise"] = ok
+        torch.cuda.nvtx.range_push(f"projbench {plan} {mode} R={R} graph")
+        graphed = _ms(g.replay, iters)
+        torch.cuda.nvtx.range_pop()
+        row[mode] = {"eager_ms": round(eager, 3), "graph_ms": round(graphed, 3)}
+        del g
+    kinds = [b for b in built if b[0] in SHOWN] or built[:4]
+    for L, A, G in kinds:                                       # a layer of each kind alone (graph), us
+        per = {}
+        for mode in ("unfused", "fused"):
+            g, _ = _graph(lambda A=A, G=G, fz=mode == "fused": dense(A, G, x, qr, o, fz))
+            per[mode] = round(_ms(g.replay, iters) * 1e3, 1)
+            del g
+        row["layers"][L] = per
+    u, f = row["unfused"], row["fused"]
+    print(f"[projbench] plan {plan} R={R}: dense ms ({len(built)} layers) graph {u['graph_ms']} -> {f['graph_ms']} "
+          f"({u['graph_ms'] - f['graph_ms']:+.3f} saved), eager {u['eager_ms']} -> {f['eager_ms']}; drift vs "
+          f"upstream {drift:.2e}; us a layer {row['layers']}", flush=True)
+    return row
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(prog="projbench", description=__doc__.split("\n\n")[0])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--layers", default="all")
+    ap.add_argument("--rows", default=",".join(map(str, ROWS)))
+    ap.add_argument("--iters", type=int, default=50)
+    ap.add_argument("--out", default="projbench.json")
+    ap.add_argument("--nvtx", action="store_true")
+    ap.add_argument("--plans", default="upstream,long", help="TF_DSV41_PROJ_PLAN values, upstream first (drift)")
+    ap.add_argument("--gbps", action="store_true", help="G8 dense: GB/s a shape, upstream vs x3dn vs x3ld")
+    ap.add_argument("--x3ld-layer", type=int, default=3, help="--gbps: the expert layer of x3ld's reference (-1: none)")
+    ap.add_argument("--head", action="store_true", help="--gbps: the head too")
+    a = ap.parse_args(argv)
+    from .config import Config
+
+    cfg = Config.from_file(Path(a.model) / "config.json")
+    layers = list(range(cfg.num_hidden_layers)) if a.layers == "all" else [int(v) for v in a.layers.split(",")]
+    if a.gbps:                                                  # G8 dense (densebench.py)
+        from . import densebench
+
+        rep = densebench.bench(a.model, a.rank, layers, [int(v) for v in a.rows.split(",")], a.iters,
+                               None if a.x3ld_layer < 0 else a.x3ld_layer, a.head)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+        return 0 if rep["row_invariant"] and rep["drift"] < 2e-2 else 3
+    rep = bench(a.model, a.rank, layers, [int(v) for v in a.rows.split(",")], a.iters, a.nvtx,
+                [v.strip() for v in a.plans.split(";" if ":" in a.plans else ",")])
+    Path(a.out).write_text(json.dumps(rep, indent=1))
+    return 0 if rep["bitwise"] and rep["row_invariant"] else 3
+
+
+if __name__ == "__main__":
+    sys.exit(main())
