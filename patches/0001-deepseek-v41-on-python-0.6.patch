index 0000000..1ae67eb
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/split.py
@@ -0,0 +1,246 @@
+"""How GLM-5.3-Flash's checkpoint splits between the two ranks, and an optional one-time split to disk.
+
+The engine reads each rank's share straight from the checkpoint ``tensorfold pull`` downloaded (``RankReader``).
+Per tensor a rule picks the split, and the rank's part is sliced as bytes (no value is converted):
+
+  row   first-axis halves: output rows of column-parallel projections (heads, expert and MLP width), per-head
+        vectors (A_log, dt_bias, the conv weights)
+  col   last-axis halves of a 2-D tensor: input columns of row-parallel projections (o_proj, down_proj); packed
+        words hold 8 inputs and groups hold 64, so every split lands on a group boundary
+  rep   both ranks whole (norms, hyper-connections, router, indexer, MLA down-projections, embeddings, head)
+  drop  the vision tower
+
+A machine short on disk can write its rank's share once and serve that folder instead (85 GB against the
+checkpoint's 182 GB); the engine reads either:
+
+    python -m tensorfold.families.glm5_next.spark.split MODEL_DIR --rank R OUT
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import shutil
+import struct
+import sys
+from pathlib import Path
+
+import numpy as np
+
+ROW = (
+    r"\.mlp\.experts\.\d+\.(gate|up)_proj\.",
+    r"\.mlp\.shared_experts\.(gate|up)_proj\.",
+    r"\.mlp\.(gate|up)_proj\.",
+    r"\.self_attn\.(q|k|v)_proj\.",
+    r"\.self_attn\.(q|k|v)_conv1d\.",
+    r"\.self_attn\.(f_b|g_b|b)_proj\.",
+    r"\.self_attn\.(A_log|dt_bias)$",
+    r"\.self_attn\.(q_b|kv_b)_proj\.",
+)
+COL = (
+    r"\.mlp\.experts\.\d+\.down_proj\.",
+    r"\.mlp\.shared_experts\.down_proj\.",
+    r"\.mlp\.down_proj\.",
+    r"\.self_attn\.o_proj\.",
+)
+REP = (
+    r"^lm_head\.", r"embed_tokens\.", r"^model\.language_model\.norm\.weight$",
+    r"_layernorm\.weight$", r"\.hc_(attn|ffn)_(fn|base|scale)$", r"\.mlp\.gate\.(weight|e_score_correction_bias)$",
+    r"\.self_attn\.indexer\.", r"\.self_attn\.(q_a_proj|kv_a_proj_with_mqa)\.", r"\.self_attn\.(f_a|g_a)_proj\.",
+    r"\.self_attn\.o_norm\.weight$", r"\.(eh_proj)\.", r"\.(enorm|hnorm)\.weight$", r"\.shared_head\.norm\.weight$",
+)
+DTYPE_BYTES = {"U32": 4, "I32": 4, "F32": 4, "BF16": 2, "F16": 2, "I16": 2, "U16": 2, "U8": 1, "I8": 1, "I64": 8,
+               "F64": 8}
+# the files a rank folder needs besides its weights (the tokenizer, chat template and configs)
+SMALL = ("config.json", "generation_config.json", "tokenizer.json", "tokenizer_config.json", "chat_template.jinja",
+         "processor_config.json", "model.safetensors.index.json")
+
+
+# EXL3 experts (``exl3.py``): trellis [K/16, N/16, 64], suh [K], svh [N], mcg. gate/up split by outputs (tile
+# columns, svh), down by inputs (tile rows, suh); the rest of each is replicated.
+EXL3_EXPERT = re.compile(r"\.mlp\.experts\.\d+\.(gate|up|down)_proj\.(trellis|suh|svh|mcg)$")
+EXL3_RULES = {("gate", "trellis"): "dim1", ("gate", "suh"): "rep", ("gate", "svh"): "row",
+              ("down", "trellis"): "row", ("down", "suh"): "row", ("down", "svh"): "rep"}
+
+
+def rule(name: str) -> str:
+    if name.startswith("model.visual."):
+        return "drop"
+    m = EXL3_EXPERT.search(name)
+    if m:
+        proj, part = m.groups()
+        return "rep" if part == "mcg" else EXL3_RULES[("gate" if proj == "up" else proj, part)]
+    hits = [kind for kind, pats in (("row", ROW), ("col", COL), ("rep", REP)) if any(re.search(p, name) for p in pats)]
+    if len(hits) != 1:
+        raise ValueError(f"{name}: split rule is ambiguous or missing ({hits})")
+    return hits[0]
+
+
+def read_header(path: str | Path) -> tuple[dict, int]:
+    with open(path, "rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        header = json.loads(f.read(n))
+    return header, 8 + n
+
+
+def split_bytes(raw: np.ndarray, shape: list[int], itemsize: int, kind: str, rank: int) -> tuple[np.ndarray, list[int]]:
+    """A tensor's bytes -> rank's part of them and its shape."""
+
+    if kind == "rep":
+        return raw, list(shape)
+    if kind == "row":
+        rows = shape[0]
+        if rows % 2:
+            raise ValueError(f"row split of odd leading dim {shape}")
+        per = raw.size // rows
+        half = rows // 2
+        return raw[rank * half * per:(rank + 1) * half * per], [half] + list(shape[1:])
+    if kind == "col":
+        if len(shape) != 2 or shape[1] % 2:
+            raise ValueError(f"column split needs an even 2-D shape, got {shape}")
+        view = raw.reshape(shape[0], shape[1] * itemsize)
+        half = shape[1] // 2
+        part = np.ascontiguousarray(view[:, rank * half * itemsize:(rank + 1) * half * itemsize])
+        return part.reshape(-1), [shape[0], half]
+    if kind == "dim1":                                   # the second axis of a 2-D or higher tensor
+        if len(shape) < 2 or shape[1] % 2:
+            raise ValueError(f"split of the second axis needs an even second dim, got {shape}")
+        inner = int(np.prod(shape[2:])) * itemsize
+        view = raw.reshape(shape[0], shape[1] * inner)
+        half = shape[1] // 2
+        part = np.ascontiguousarray(view[:, rank * half * inner:(rank + 1) * half * inner])
+        return part.reshape(-1), [shape[0], half] + list(shape[2:])
+    raise ValueError(kind)
+
+
+def rank_files(model_dir: str | Path, rank: int) -> list[Path]:
+    return sorted(Path(model_dir).glob(f"*.rank{rank}.safetensors"))
+
+
+class RankReader:
+    """One rank's tensors by checkpoint name (CPU tensors in the stored dtype): sliced from the full checkpoint,
+    or read from a folder ``split`` wrote for this rank."""
+
+    def __init__(self, model_dir: str | Path, rank: int) -> None:
+        self.dir, self.rank = Path(model_dir), rank
+        self.handles: dict[str, object] = {}
+        self.index: dict[str, object] = {}
+        mine, other = rank_files(self.dir, rank), rank_files(self.dir, 1 - rank)
+        if other and not mine:
+            raise ValueError(f"{self.dir} holds rank {1 - rank}'s share: give rank {rank} its own folder or the "
+                             "full checkpoint")
+        self.split = bool(mine)
+        if self.split:
+            from safetensors import safe_open
+
+            for path in mine:
+                h = safe_open(str(path), framework="pt", device="cpu")
+                self.handles[str(path)] = h
+                for k in h.keys():
+                    self.index[k] = h
+            return
+        index = self.dir / "model.safetensors.index.json"
+        if index.exists():
+            names = json.loads(index.read_text())["weight_map"]
+        else:
+            names = {k: p.name for p in sorted(self.dir.glob("*.safetensors")) for k in read_header(p)[0]
+                     if k != "__metadata__"}
+        self.files: dict[str, tuple[dict, int]] = {}
+        self.maps: dict[str, np.memmap] = {}
+        self.index = dict(names)
+
+    def get(self, name: str):
+        import torch
+
+        if self.split:
+            return self.index[name].get_tensor(name)
+        file = str(self.dir / self.index[name])
+        if file not in self.files:
+            self.files[file] = read_header(file)
+            self.maps[file] = np.memmap(file, dtype=np.uint8, mode="r")
+        header, base = self.files[file]
+        info = header[name]
+        kind = rule(name)
+        if kind == "drop":
+            raise KeyError(f"{name} is not used by the engine")
+        a, b = info["data_offsets"]
+        itemsize = DTYPE_BYTES[info["dtype"]]
+        data, shape = split_bytes(self.maps[file][base + a:base + b], info["shape"], itemsize, kind, self.rank)
+        dtype = {"U32": torch.uint32, "I32": torch.int32, "F32": torch.float32, "BF16": torch.bfloat16,
+                 "F16": torch.float16, "I16": torch.int16, "U16": torch.uint16, "U8": torch.uint8,
+                 "I8": torch.int8, "I64": torch.int64, "F64": torch.float64}[info["dtype"]]
+        return torch.from_numpy(np.array(data, copy=True)).view(dtype).reshape(shape)
+
+
+def write(path: str, tensors: list[tuple[str, str, list[int], np.ndarray]], metadata: dict | None) -> None:
+    header: dict = {}
+    offset = 0
+    for name, dtype, shape, data in tensors:
+        header[name] = {"dtype": dtype, "shape": shape, "data_offsets": [offset, offset + data.size]}
+        offset += data.size
+    if metadata:
+        header["__metadata__"] = metadata
+    blob = json.dumps(header, separators=(",", ":")).encode()
+    blob += b" " * (-len(blob) % 8)
+    tmp = path + ".part"
+    with open(tmp, "wb") as f:
+        f.write(struct.pack("<Q", len(blob)))
+        f.write(blob)
+        for _, _, _, data in tensors:
+            f.write(memoryview(data))
+    os.replace(tmp, path)
+
+
+def split_file(src: str | Path, out: str | Path, rank: int) -> dict:
+    """One checkpoint file -> OUT/<stem>.rank<R>.safetensors with the rank's part of every tensor it keeps."""
+
+    header, base = read_header(src)
+    metadata = header.pop("__metadata__", None)
+    mm = np.memmap(src, dtype=np.uint8, mode="r")
+    stem = os.path.basename(str(src)).replace(".safetensors", "")
+    summary = {"rep": 0, "row": 0, "col": 0, "dim1": 0, "drop": 0}
+    part = []
+    for name in sorted(header, key=lambda k: header[k]["data_offsets"][0]):
+        info = header[name]
+        kind = rule(name)
+        summary[kind] += 1
+        if kind == "drop":
+            continue
+        a, b = info["data_offsets"]
+        itemsize = DTYPE_BYTES[info["dtype"]]
+        data, shape = split_bytes(mm[base + a:base + b], info["shape"], itemsize, kind, rank)
+        if int(np.prod(shape)) * itemsize != data.size:
+            raise ValueError(f"{name}: {shape} does not match {data.size} bytes")
+        part.append((name, info["dtype"], shape, data))
+    os.makedirs(out, exist_ok=True)
+    if part:
+        write(os.path.join(str(out), f"{stem}.rank{rank}.safetensors"), part, metadata)
+    return summary
+
+
+def main(argv: list[str] | None = None) -> int:
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("model_dir", type=Path, help="the checkpoint (e.g. the snapshot `tensorfold pull` downloaded)")
+    p.add_argument("--rank", type=int, choices=(0, 1), required=True, help="the rank this machine serves")
+    p.add_argument("out", type=Path, help="the folder to write (then: tensorfold serve OUT --tp 2 --rank R ...)")
+    args = p.parse_args(argv)
+    files = sorted(args.model_dir.glob("model-*.safetensors"))
+    if not files:
+        raise SystemExit(f"{args.model_dir}: no model-*.safetensors files")
+    args.out.mkdir(parents=True, exist_ok=True)
+    for name in SMALL:
+        if (args.model_dir / name).exists():
+            shutil.copyfile(args.model_dir / name, args.out / name)
+    for src in files:
+        stem = src.name.replace(".safetensors", "")
+        if (args.out / f"{stem}.rank{args.rank}.safetensors").exists():
+            continue
+        print(src.name, split_file(src, args.out, args.rank), flush=True)
+    print(f"rank {args.rank}'s share of {len(files)} files in {args.out}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/tensorfold/families/glm5_next/spark/toolfix.py b/src/tensorfold/families/glm5_next/spark/toolfix.py
new file mode 100644
index 0000000..419bf1e
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/toolfix.py
@@ -0,0 +1,270 @@
+"""patches/0620: tool-calling fixes for multi-step chains (``GLM53_TF_TOOL_FIXES``, off by default; docs/TOOL-CALLING.md).
+
+Host only, rank 0's HTTP app; the engine, its tokens and every request without tools are untouched. Each fix is named
+in the comma list (``all`` = every one but ``grammar``):
+
+- ``history``: the request's messages as the chat template expects them. ``content: null`` (OpenAI's shape for an
+  assistant turn that only calls tools, and what this server answers) rendered as the literal text ``None`` before
+  the calls (and in a null tool result); it is now ``""``. An assistant turn's ``reasoning`` (the field this server
+  answers with GLM53_TF_REASONING_FIELDS=reasoning) is copied to ``reasoning_content`` (the only name the template
+  reads) when that is absent (``reasoning`` does this too). Tool-call ``arguments`` of ``""`` / null are ``{}`` (the template called ``.items()`` on
+  the string: HTTP 400).
+- ``reasoning``: the reasoning of each reply that called tools is kept, keyed by the call ids this server made
+  (``call_<24 hex>``, unique) and by a signature of the calls (names, arguments) with the last user message before
+  them (for clients that renumber the ids), and put back into a later request's assistant turn that carries those
+  calls without reasoning. GLM-5.3's template keeps the reasoning of every assistant turn after the last user
+  message (interleaved thinking inside one tool loop); clients that drop ``reasoning_content`` otherwise make every
+  earlier step of the chain render as ``<think></think>``, which the model never produced. Bounded:
+  GLM53_TF_KEEP_REASONING_ENTRIES (1024) replies and GLM53_TF_KEEP_REASONING_MB (32) of text, oldest dropped.
+- ``choice``: OpenAI ``tool_choice`` and ``parallel_tool_calls`` as upstream TensorFold 0.5.0 reads them
+  (``server/tools.py``): ``"none"`` offers no tools (the template lists none and nothing is parsed as a call), a
+  named function offers only that tool (an unknown name is a 400), ``parallel_tool_calls: false`` keeps the first
+  call. ``"required"`` / named calls are enforced by 0610's grammar (GLM53_TF_GRAMMAR=1), unchanged.
+- ``args``: argument values typed by the whole parameter schema (``server.typed_value``: type lists, anyOf / oneOf,
+  enums, quoted numbers, integral floats) instead of its ``type`` string only.
+- ``thinkcalls``: a reply that ends on ``<|observation|>`` (the model waits for a tool result) with no call in its
+  answer but complete ``<tool_call>`` blocks at the end of its reasoning (thinking never closed, or the calls written
+  inside it) returns those calls (``finish_reason: tool_calls``) instead of an empty answer.
+- ``grammar`` (with GLM53_TF_GRAMMAR=1): every tools request with ``tool_choice`` auto / absent is held to the tools'
+  schemas by 0610's structural tag, as ``"strict": true`` tools are (text stays free; a call's name and arguments
+  must fit). Costs 0610's mask fills on that request's rows.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import threading
+from collections import OrderedDict
+from typing import Any
+
+from .server import TOOL_FIXES_ENV, parse_tool_calls, tool_fixes
+
+_CALL_ID = re.compile(r"^call_[0-9a-f]{24}$")
+_CALL_BLOCK = re.compile(r"<tool_call>.*?</tool_call>", re.DOTALL)
+
+
+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        value = int(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected an integer") from None
+    if value < 0:
+        raise ValueError(f"{name}={raw!r}: expected >= 0")
+    return value
+
+
+class ReasoningMemory:
+    """The reasoning of recent replies that called tools (LRU, bounded in entries and characters), found by any of
+    its keys: the call ids this server made, and a signature of the calls with the last user message before them
+    (clients that renumber the ids, as spark-bench does). A key put again points at the newer reply."""
+
+    def __init__(self, entries: int = 1024, chars: int = 32 << 20) -> None:
+        self.entries, self.chars = int(entries), int(chars)
+        self.items: OrderedDict[int, tuple[str, tuple[str, ...]]] = OrderedDict()
+        self.by_key: dict[str, int] = {}
+        self.size = 0
+        self.next = 0
+        self.lock = threading.Lock()
+
+    def put(self, keys: list[str], reasoning: str) -> None:
+        keys = [k for k in keys if isinstance(k, str) and k]
+        if not keys or not reasoning or self.entries == 0 or len(reasoning) > self.chars:
+            return
+        with self.lock:
+            n, self.next = self.next, self.next + 1
+            self.items[n] = (reasoning, tuple(keys))
+            self.size += len(reasoning)
+            for k in keys:
+                self.by_key[k] = n
+            while self.items and (len(self.items) > self.entries or self.size > self.chars):
+                old, (text, old_keys) = self.items.popitem(last=False)
+                self.size -= len(text)
+                for k in old_keys:
+                    if self.by_key.get(k) == old:
+                        del self.by_key[k]
+
+    def get(self, keys: list[str]) -> str | None:
+        with self.lock:
+            for k in keys:
+                n = self.by_key.get(k) if isinstance(k, str) else None
+                if n is not None:
+                    self.items.move_to_end(n)
+                    return self.items[n][0]
+        return None
+
+    def __len__(self) -> int:
+        return len(self.items)
+
+
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "".join(p.get("text", "") if isinstance(p, dict) and isinstance(p.get("text"), str) else
+                       (p if isinstance(p, str) else "") for p in content)
+    return ""
+
+
+def _arguments(value: Any) -> Any:
+    if isinstance(value, str):
+        try:
+            return json.loads(value) if value.strip() else {}
+        except (json.JSONDecodeError, ValueError):
+            return value
+    return {} if value is None else value
+
+
+def signature(user: str, calls: list[Any]) -> str:
+    """The key of a reply's calls after the user message ``user``: names and arguments, canonical JSON."""
+
+    shape = []
+    for c in calls:
+        fn = c.get("function") if isinstance(c, dict) and isinstance(c.get("function"), dict) else (c or {})
+        shape.append([str(fn.get("name") or ""), _arguments(fn.get("arguments"))])
+    text = json.dumps([user, shape], ensure_ascii=False, sort_keys=True, separators=(",", ":"), default=str)
+    return "sig:" + hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()
+
+
+def last_user(messages: list[Any], before: int | None = None) -> str:
+    """The text of the last user message (before index ``before``)."""
+
+    for m in reversed(messages[:before] if before is not None else messages):
+        if isinstance(m, dict) and m.get("role") == "user":
+            return _text(m.get("content"))
+    return ""
+
+
+class ToolFixes:
+    """The fixes GLM53_TF_TOOL_FIXES names, for one app (``GlmApp``)."""
+
+    def __init__(self, observation_id: int | None, raw: str | None = None) -> None:
+        self.on = tool_fixes(raw)
+        self.observation = observation_id
+        self.memory = ReasoningMemory(_int_env("GLM53_TF_KEEP_REASONING_ENTRIES", 1024),
+                                      _int_env("GLM53_TF_KEEP_REASONING_MB", 32) << 20) \
+            if "reasoning" in self.on else None
+
+    def __bool__(self) -> bool:
+        return bool(self.on)
+
+    def describe(self) -> str:
+        return f"{TOOL_FIXES_ENV}={','.join(sorted(self.on))}"
+
+    # -- the request -------------------------------------------------------------------------------------------
+
+    def prepare(self, body: dict[str, Any]) -> str | None:
+        """Fix ``body`` in place before it is rendered (``check``, ``tokenize`` and ``run`` all call it: idempotent).
+        Returns an error message (HTTP 400) or None."""
+
+        if not self.on or not isinstance(body, dict):
+            return None
+        if "choice" in self.on:
+            problem = self._choice(body)
+            if problem:
+                return problem
+        messages = body.get("messages")
+        if not isinstance(messages, list):
+            return None
+        for i, m in enumerate(messages):
+            if not isinstance(m, dict):
+                continue
+            if "history" in self.on:
+                _history(m)
+            if (self.memory is not None or "history" in self.on) and m.get("role") == "assistant" \
+                    and not isinstance(m.get("reasoning_content"), str) and isinstance(m.get("reasoning"), str):
+                m["reasoning_content"] = m["reasoning"]         # the only name the template reads
+            if self.memory is not None and m.get("role") == "assistant" and isinstance(m.get("tool_calls"), list) \
+                    and m["tool_calls"] and not isinstance(m.get("reasoning_content"), str) \
+                    and "</think>" not in _text(m.get("content")):
+                ids = [c.get("id") for c in m["tool_calls"] if isinstance(c, dict)]
+                keys = [k for k in ids if isinstance(k, str) and _CALL_ID.match(k)]
+                kept = self.memory.get(keys + [signature(last_user(messages, i), m["tool_calls"])])
+                if kept is not None:
+                    m["reasoning_content"] = kept
+        return None
+
+    def _choice(self, body: dict[str, Any]) -> str | None:
+        choice = body.get("tool_choice")
+        tools = body.get("tools")
+        if not tools or not isinstance(tools, list):
+            return None
+        if isinstance(choice, str) and choice.strip().lower() == "none":
+            body["tools"] = []
+            return None
+        if isinstance(choice, dict) and str(choice.get("type") or "").lower() == "function":
+            fn = choice.get("function")
+            name = str(fn.get("name") or "").strip() if isinstance(fn, dict) else ""
+            if not name:
+                return 'tool_choice {"type": "function"} needs {"function": {"name": ...}}'
+            kept = [t for t in tools if _name(t) == name]
+            if not kept:
+                return f"tool_choice names the tool {name!r}, which the request does not offer"
+            body["tools"] = kept
+        return None
+
+    # -- the reply ---------------------------------------------------------------------------------------------
+
+    def reply(self, body: dict[str, Any], *, content: str, calls, reasoning: str, last: int | None,
+              thinking: bool, stopped: bool):
+        """(content, calls, reasoning) of a finished reply with tools, fixed."""
+
+        if not self.on:
+            return content, calls, reasoning
+        tools = body.get("tools") or []
+        if "thinkcalls" in self.on and not calls and thinking and not stopped and not content.strip() \
+                and last is not None and last == self.observation and "<tool_call>" in reasoning:
+            head, tail = trailing_calls(reasoning)
+            if tail:
+                _, found = parse_tool_calls(tail, tools)
+                if found:
+                    calls, reasoning = found, head
+        if "choice" in self.on and calls and body.get("parallel_tool_calls") is False:
+            calls = calls[:1]
+        if self.memory is not None and calls and thinking and reasoning:
+            messages = body.get("messages") if isinstance(body.get("messages"), list) else []
+            self.memory.put([c.get("id") for c in calls] + [signature(last_user(messages), calls)], reasoning)
+        return content, calls, reasoning
+
+
+def _name(tool: Any) -> str:
+    if not isinstance(tool, dict):
+        return ""
+    fn = tool.get("function") if isinstance(tool.get("function"), dict) else tool
+    return str(fn.get("name") or "").strip()
+
+
+def _history(m: dict[str, Any]) -> None:
+    """One message as the template expects it (``history``)."""
+
+    if "content" in m and m["content"] is None:
+        m["content"] = ""
+    if m.get("role") != "assistant":
+        return
+    for call in m.get("tool_calls") or []:
+        fn = call.get("function") if isinstance(call, dict) else None
+        if isinstance(fn, dict) and (fn.get("arguments") is None
+                                     or (isinstance(fn.get("arguments"), str) and not fn["arguments"].strip())):
+            fn["arguments"] = {}
+
+
+def trailing_calls(text: str) -> tuple[str, str]:
+    """(the text before, the run of complete ``<tool_call>`` blocks that ends ``text``): the blocks separated by
+    whitespace only, up to the end but for whitespace and a closing ``</think>``. ``("text", "")`` without one."""
+
+    end = text.rstrip()
+    if end.endswith("</think>"):
+        end = end[: -len("</think>")].rstrip()
+    start = len(end)
+    for m in reversed(list(_CALL_BLOCK.finditer(end))):
+        if end[m.end():start].strip():
+            break
+        start = m.start()
+    if start == len(end):
+        return text, ""
+    return text[:start].rstrip(), end[start:]
