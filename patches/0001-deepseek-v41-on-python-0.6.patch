+
+def prefill_runs(pieces, size: int) -> list[list[tuple[int, int, tuple]]]:
+    """The forward runs of a round's pieces: each piece cut into segments of at most ``size`` rows, the k-th
+    segment of every piece in run k (GLM 0560: one expert pass over every prefilling slot). ``prefetch.piece_runs``
+    reads the same runs."""
+
+    queues = []
+    for pc in pieces:
+        ids = tuple(int(t) for t in pc.ids)
+        queues.append([(pc.slot, pc.start + a, ids[a:a + size]) for a in range(0, len(ids), size)])
+    runs = []
+    while any(queues):
+        runs.append([q.pop(0) for q in queues if q])
+    return runs
+
+
+class SlotsForward(Forward):
+    """``forward.Forward`` with the serving layer's protocol (``protocol.Forward``, ``Bind``)."""
+
+    # -- pages ---------------------------------------------------------------------------------------------------
+    def bind(self, slots: Sequence) -> None:
+        if not slots:
+            return
+        pool = slots[0].pool
+        while len(self.slots) < len(slots):
+            self.slots.append(self.new_slot(contiguous=False))
+        cap = max(int(s.capacity) for s in slots)
+        if cap > self.limit:
+            self.limit = cap
+            self.tables = tables(self.cfg, cap + self.pchunk, self.device)
+        from . import rowmode
+
+        rowmode.stack(self, slots)              # G8: rings, carries and page tables stacked (row mode, ``rowgraphs``)
+        for st, ps in zip(self.slots, slots):
+            for blk in self.blocks:
+                if blk.mode != "full":
+                    continue
+                L = blk.index
+                comp, keys = pool.phys[f"comp.{L}"], pool.phys[f"index_k.{L}"]
+                if keys.dtype not in (torch.bfloat16, torch.uint8):
+                    raise ValueError("index keys: bf16 or the kit's per-token FP8 rows (TF_DSV41_INDEX_KV)")
+                per = pool.family(f"comp.{L}").page_rows(pool.page)
+                shift = per.bit_length() - 1
+                st.comp[L] = Records.packed(comp, ps.table, shift)
+                st.ikeys[L] = Keys(keys, ps.table, shift)
+        self.pool = pool
+
+    # -- prompts -------------------------------------------------------------------------------------------------
+    def prefill(self, pieces, *, mode: str = "full") -> None:
+        self.ced = mode
+        if mode == "replay":                    # CED: the encoder pass (``replay.encode``)
+            from . import replay
+
+            runs = prefill_runs(pieces, self.pchunk)
+            pipe = getattr(self, "pipe", None)
+            if pipe is not None:                # TF_DSV41_PREFILL_PIPE: long prompts' segments through the stages
+                for run in runs:
+                    rest = []
+                    for sg in run:
+                        if pipe.takes(sg[0], len(sg[2]), sg[2]):
+                            pipe.step(*sg)
+                        else:
+                            if pipe.slot == sg[0]:      # an image segment of a pipelined prompt: the line first
+                                pipe.drain()
+                            rest.append(sg)
+                    if rest:
+                        replay.encode(self, [rest])
+                return
+            if _profile_due(pieces):
+                _profiled(lambda: replay.encode(self, runs), self)
+            else:
+                replay.encode(self, runs)
+            return
+        if mode != "full":
+            raise ValueError(f"prefill mode {mode!r}: full or replay")
+        if any(self.cones.get(pc.slot) is not None for pc in pieces):     # G17 TF_DSV41_FULL_CONE (``cone.py``)
+            from . import cone
+
+            cone.prefill(self, prefill_runs(pieces, self.pchunk))
+            return
+        for run in prefill_runs(pieces, self.pchunk):
+            segs = [Seg(*sg) for sg in run]
+            self.run(segs, logits=False, prefill=True)
+            for sg in segs:
+                self.keep(sg.slot, len(sg.ids) - 1)
+
+    def finish_prompt(self, slot: int, end: int, tail, *, mode: str = "full") -> None:
+        self._settle(slot)
+        if self.slots[slot].pos != end:
+            raise RuntimeError(f"slot {slot}: the prompt's prefilled part ends at {end}, the slot is at "
+                               f"{self.slots[slot].pos}")
+        self.ced = mode
+        self.cones.pop(slot, None)              # G17: the cone only shapes the prompt's prefill
+        if mode == "replay":                    # CED: the decoder over the prompt's tail (``replay.finish``)
+            from . import replay
+
+            taps = replay.finish(self, slot, end, tail)
+            self.replayed(slot, end - len(tail), taps)
+
+    def reset(self, slot: int = 0) -> None:
+        pipe = getattr(self, "pipe", None)
+        if pipe is not None:
+            pipe.abandon(slot)              # a reset (or restored) slot: its segments in the line are dropped
+        super().reset(slot)
+        self.stash.pop(slot, None)
+        self.cones.pop(slot, None)
+
+    def set_cone(self, slot: int, n: int, cached: int = 0) -> int | None:
+        """G17 ``TF_DSV41_FULL_CONE``: a full-mode prompt of ``n`` tokens resumed at ``cached`` runs its decoder
+        layers from row ``cone.start`` on (the executor calls it at admission, both ranks); the row, or None."""
+
+        from . import cone
+
+        r0 = cone.start(self.cfg, n, cached) if cone.enabled() else None
+        if r0 is None:
+            self.cones.pop(slot, None)
+        else:
+            self.cones[slot] = r0
+        return r0
+
+    @property
+    def cones(self) -> dict:
+        """G17: {slot: the decoder's first prompt row} of full-mode prompts prefilled over their cone (``cone.py``)."""
+
+        c = self.__dict__.get("_cones")
+        if c is None:
+            c = self.__dict__["_cones"] = {}
+        return c
+
+    def _settle(self, slot: int) -> None:
+        """A pipelined prompt's state is whole before it is read (``pipe.Pipeline.drain``)."""
+
+        pipe = getattr(self, "pipe", None)
+        if pipe is not None and pipe.slot == slot:
+            pipe.drain()
+
+    def replayed(self, slot: int, start: int, taps: dict) -> None:
+        """After a CED replay: its rows' DSpark taps (``decode.DecodeForward`` feeds the drafter)."""
+
+    @property
+    def stash(self) -> dict:
+        """CED: {slot: ``replay.Stash``} (the rows entering the decoder of each slot's last prompt positions)."""
+
+        st = self.__dict__.get("_stash")
+        if st is None:
+            st = self.__dict__["_stash"] = {}
+        return st
+
+    # -- verify windows ------------------------------------------------------------------------------------------
+    def window(self, windows, *, count: int, masks=None) -> Candidates:
+        segs = [Seg(w.slot, w.start, tuple(w.tokens)) for w in windows]
+        self.cand_reserve(sum(len(w.tokens) for w in windows), count)
+        logits = self.run(segs)
+        return self.candidates(logits, [len(w.tokens) for w in windows], count, masks)
+
+    def commit(self, slot: int, accepted: int) -> None:
+        self.keep(slot, accepted)
+
+    def candidates(self, logits: torch.Tensor, sizes: Sequence[int], count: int, masks=None) -> Candidates:
+        """Each row's top ``count`` (value desc, id asc) over the whole vocabulary, from the ranks' halves."""
+
+        g, k = self.cand_gather(logits, sizes, count, masks)
+        return self.cand_wait(self.cand_fetch(g, k, count))
+
+    def cand_gather(self, logits: torch.Tensor, sizes: Sequence[int], count: int, masks=None):
+        """Each rank's top ``k`` a row (grammar masks applied first), gathered: (fp32 [W, R, 2k] values then int32 ids
+        as fp32 bits, rank order, on the device; k)."""
+
+        lg = logits.float()
+        R, vl = lg.shape
+        lo = self.vocab_lo
+        if masks is not None and any(m is not None for m in masks):
+            if lo % 32 or vl % 32:
+                raise ValueError("grammar masks need vocabulary halves on 32-token words")
+            allowed = torch.ones((R, vl), dtype=torch.bool, device=lg.device)
+            a = 0
+            for n, m in zip(sizes, masks):
+                if m is not None:
+                    words = torch.from_numpy(np.ascontiguousarray(m[:, lo // 32:(lo + vl) // 32])).to(lg.device)
+                    bits = (words.to(torch.int64)[..., None] >> torch.arange(32, device=lg.device)) & 1
+                    allowed[a:a + n] = bits.reshape(n, -1)[:, :vl].bool()
+                a += n
+            lg = lg.masked_fill(~allowed, float("-inf"))
+        vals, ids, k = P.rank_top(lg, count, lo, self.vocab_wide)   # ties: the lower id; one k on every rank
+        packed = torch.cat([vals, ids.view(torch.float32)], 1).contiguous()
+        if self.world > 1:
+            got = torch.empty((self.world * packed.numel(),), dtype=torch.float32, device=packed.device)
+            fast_gather(self.comm, packed.view(-1), got)
+            return got.view(self.world, R, 2 * k), k
+        return packed.view(1, R, 2 * k), k
+
+    def cand_warm(self, rows: int = 4) -> None:
+        """Run every candidate width class once at boot (every rank, the same calls), so their kernels are loaded
+        before serving: verify-window counts, a nucleus row's 512, wide top_k, the whole vocabulary (masked nucleus
+        rows), and the device sampler (``vsample.choose``, the speculative pass) over each.
+
+        Why (2026-10-05, four Sparks): with CUDA's lazy module loading, the first window that needed the large-k
+        top-k and large-row sort kernels (a sampled request with top_k in the tens of thousands) loaded them while
+        the window's forward was still running, and module loading waits for the device: the forward's Engram gate
+        and the RoCE exchanges wait for host threads, and every follower timed out at layer 14. A masked nucleus
+        request, whose full-vocabulary candidates come after its window, had loaded them first in every run that
+        passed."""
+
+        from . import nucleus as NU
+        from . import vsample as VS
+
+        vl = int(self.embed.shape[0])                       # this rank's vocabulary columns
+        dev = self.device
+        lg = torch.linspace(-4.0, 4.0, rows * vl, device=dev).view(rows, vl).to(torch.bfloat16).float()
+        z = torch.zeros((rows,), dtype=torch.int64, device=dev)
+        floats = torch.tensor([[1.0, 0.9, 0.02]] * rows, dtype=torch.float64, device=dev)
+        for count in (1, 9, 64, 520, 4104, 32776, self.vocab):
+            g, k = self.cand_gather(lg, [rows], count)
+            h = self.cand_fetch(g, k, count)
+            for mode in ((0, 0), (20, 1), (0, 1)):
+                ints = torch.tensor([list(mode)] * rows, dtype=torch.int64, device=dev)
+                VS.choose(h.vals, h.ids, z, z, ints, floats)
+            self.cand_wait(h)
+        NU.row_stats(lg, torch.ones((rows,), dtype=torch.float64))
+        if dev.type == "cuda":
+            torch.cuda.synchronize(dev)
+
+    def cand_reserve(self, rows: int, count: int) -> None:
+        """Grow the candidates' pinned buffer for ``rows`` rows of ``count`` before the window's forward is queued.
+
+        Pinned host memory comes from ``cudaHostAlloc``, which can wait for the device. Grown inside ``cand_fetch``
+        (after the forward is queued), the first window wider than any before (a sampled request with top_k in the
+        tens of thousands) waited on a forward whose Engram gate (``engram_gate``) was still waiting for this rank's
+        row reads: every follower timed out at layer 14 (2026-10-05, four Sparks; masked nucleus rows, whose full-
+        vocabulary candidates are fetched after the window, had grown it first in the runs that passed)."""
+
+        k = min(int(count), self.vocab_wide)
+        need = max(int(rows) * 2 * min(int(count), self.world * k), 4096)
+        buf = self.__dict__.get("_cand_pin")
+        if self.device.type == "cuda" and (buf is None or buf.numel() < need):
+            self.__dict__["_cand_pin"] = torch.empty((need,), dtype=torch.float32, pin_memory=True)
+
+    def cand_fetch(self, g: torch.Tensor, k: int, count: int):
+        """The merged, sorted candidates (``vsample.merge``: the order ``np.lexsort((ids, -values))`` gave on the
+        host) copied to pinned memory without blocking: a handle for ``cand_wait``; the device rows are ``.dev``."""
+
+        from . import vsample as VS
+
+        vals, ids = VS.merge(g, k, count)
+        R, c = ids.shape
+        packed = torch.cat([vals, ids.to(torch.int32).view(torch.float32)], 1)
+        if packed.is_cuda:
+            buf = self.__dict__.get("_cand_pin")
+            if buf is None or buf.numel() < packed.numel():
+                buf = self.__dict__["_cand_pin"] = torch.empty((max(packed.numel(), 4096),), dtype=torch.float32,
+                                                               pin_memory=True)
+            host = buf[:packed.numel()].view(R, 2 * c)
+            host.copy_(packed, non_blocking=True)
+            ev = torch.cuda.Event()
+            ev.record()
+        else:
+            host, ev = packed, None
+        return _CandFetch(host, ev, c, vals, ids)
+
+    @staticmethod
+    def cand_wait(h) -> Candidates:
+        if h.event is not None:
+            h.event.synchronize()
+        a = h.host.numpy()
+        c = h.c
+        values = np.array(a[:, :c], dtype=np.float32)
+        tokens = a[:, c:].view(np.int32).astype(np.int64)
+        return Candidates(tokens, values)
+
+    # -- snapshots -----------------------------------------------------------------------------------------------
+    def _ring_rows(self, pos: int) -> torch.Tensor:
+        lo = max(0, pos - self.cfg.sliding_window)
+        return torch.arange(lo, pos, dtype=torch.long) % self.ring
+
+    def snapshot(self, slot: int) -> Bounded:
+        self._settle(slot)
+        s = self.slots[slot]
+        rows = self._ring_rows(s.pos)
+        arrays: dict[str, np.ndarray] = {}
+        layers = sorted(s.swa)
+        ced = getattr(self, "ced", "full")
+        if ced == "replay":                     # the encoder rings + the stash: the decoder is replayed on resume
+            from . import replay
+
+            d = replay.decoder_start(self.cfg)
+            layers = [L for L in layers if L < d]
+            sh = self.stash.get(slot)
+            if sh is not None and sh.hi == s.pos:
+                arrays.update(sh.arrays())
+        if len(rows):
+            raws = [s.swa[L].raw(rows) for L in layers]
+            for name in raws[0]:
+                arrays[f"swa_{name}"] = np.stack([r[name] for r in raws])
+        if s.carry:
+            arrays["carry"] = np.stack([s.carry[L].float().cpu().numpy() for L in sorted(s.carry)])
+        tail = [int(t) for t in s.tail][-LOOKBACK:]
+        arrays["lookback"] = np.asarray([-1] * (LOOKBACK - len(tail)) + tail, dtype=np.int64)
+        arrays["rings"] = np.asarray(layers, dtype=np.int64)
+        return Bounded(s.pos, arrays, {"ced": ced, "window": self.cfg.sliding_window, "ring": self.ring})
+
+    def restore(self, slot: int, snap: Bounded) -> None:
+        if int(snap.meta.get("window", self.cfg.sliding_window)) != self.cfg.sliding_window:
+            raise ValueError("a snapshot of another SWA window")
+        self.reset(slot)
+        s = self.slots[slot]
+        a = snap.arrays
+        s.pos = int(snap.pos)
+        rows = self._ring_rows(s.pos)
+        if len(rows):
+            names = [k[len("swa_"):] for k in a if k.startswith("swa_")]
+            for j, L in enumerate(a["rings"].tolist()):
+                s.swa[int(L)].put_raw(rows, {n: np.ascontiguousarray(a[f"swa_{n}"][j]) for n in names})
+        if "carry" in a:
+            for j, L in enumerate(sorted(s.carry)):
+                s.carry[L].copy_(torch.from_numpy(a["carry"][j]))       # in place (graphs hold the address)
+        s.tail = [int(t) for t in a["lookback"].tolist() if t >= 0]
+        self.stash.pop(slot, None)
+        if snap.meta.get("ced", "full") == "replay":
+            from . import numerics as N
+            from . import replay
+
+            sh = replay.Stash.from_arrays(a, self.device, N.ACT)
+            if sh is not None:
+                self.stash[slot] = sh
