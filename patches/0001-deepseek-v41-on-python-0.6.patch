@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A program-level emulator in numpy (no GPU) of ``x3dn.cu`` v2 (``dense``, TF_DSV41_DENSE) over ``dense.layout``'s
+tables.
+
+Transcribed from the kernel: program p's segment (the last one with p0 <= p), (nb, split) = divmod(p - p0, SK), the
+split's k steps [s KT / SK, (s + 1) KT / SK) and warp w's quarter [lo + w L / 4, lo + (w + 1) L / 4); each warp's
+ring (slot i % PD holds the step its mma chain consumes: the prologue's PD steps, then step i + PD refilled into the
+slot just read); the 16-row passes; the warps' partials in warp order; SK == 1: the epilogue straight away; else Z at
+((pass x P + p) x RP + row) x 128 of the launch's Z, the strip counter at c_off + pass x NB + nb, and the split that
+sees SK - 1 sums the SK partials in split order, applies the epilogue and resets the counter. Programs run in a
+random order (any order is a valid serialization). Scratch is flat and shared, so a wrong offset is a collision, a
+stale read or a double write.
+
+Arithmetic as ``dsv41_x3seg_emu``: an mma adds its exact 16-term product to the fp32 accumulator with one rounding;
+sums and the epilogue in fp32 in the kernel's order; W_q fp16 [K, N] given (``format.unpack`` or random).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from dsv41_x3seg_emu import F32, epilogue, mma, rot_rows
+
+WARPS = 4
+
+
+def passes(m: int) -> int:
+    return (m + 15) // 16
+
+
+class Mem:
+    def __init__(self, lay, widths: list[int], m: int) -> None:
+        self.xh = np.full((lay.xh_total,), np.nan, dtype=np.float16)
+        self.z = np.full((max(1, lay.z_total),), np.nan, dtype=F32)
+        self.counters = np.zeros((max(1, lay.c_total),), dtype=np.int64)
+        self.ys = [np.full((m * w,), np.nan, dtype=F32) for w in widths]
+        self.writes = [np.zeros((m * w,), dtype=np.int64) for w in widths]
+        self.ld = list(widths)
+
+
+def warp_steps(K: int, SK: int, split: int, warp: int) -> tuple[int, int]:
+    kt = K >> 4
+    ka = split * kt // SK
+    L = (split + 1) * kt // SK - ka
+    return ka + warp * L // WARPS, ka + (warp + 1) * L // WARPS
+
+
+def program(mem: Mem, table, part, segs, Ws, svhs, P: int, zo: int, p: int, M: int, pd: int) -> None:
+    s = 0
+    for i in range(1, len(table)):
+        if p >= table[i][3]:
+            s = i
+    K, N, SK, p0, xo, co, col, k2 = table[s]
+    i = part[s]
+    nb, split = divmod(p - p0, SK)
+    NB, RP, c0 = N >> 7, min(M, 16), nb * 128
+    xh = mem.xh[xo:xo + M * K].astype(np.float64).reshape(M, K)
+    buf, ld = segs[i].out, mem.ld[segs[i].out]
+    for pas in range(passes(M)):
+        m0 = pas * 16
+        R = min(16, M - m0)
+        sums = []
+        for w in range(WARPS):
+            lo, hi = warp_steps(K, SK, split, w)
+            n = hi - lo
+            ring = [lo + d if d < n else None for d in range(pd)]      # the prologue
+            acc = np.zeros((R, 128), dtype=F32)
+            for st in range(n):
+                slot = st % pd
+                assert ring[slot] == lo + st, (ring, slot, lo + st)
+                ring[slot] = lo + st + pd if st + pd < n else None     # refill the slot just read
+                kt = lo + st
+                acc = mma(acc, xh[m0:m0 + R, kt * 16:kt * 16 + 16], Ws[i][kt * 16:kt * 16 + 16, c0:c0 + 128])
+            sums.append(acc)
+        t = sums[0].copy()
+        for w in range(1, WARPS):
+            t = (t + sums[w]).astype(F32)
+        rows = np.arange(m0, m0 + R)
+        at = (rows[:, None] * ld + col + c0 + np.arange(128)[None, :]).reshape(-1)
+        if SK == 1:
+            mem.ys[buf][at] = epilogue(t, svhs[i][c0:c0 + 128]).reshape(-1)
+            mem.writes[buf][at] += 1
+            continue
+        zb = zo + ((pas * P + p) * RP + np.arange(R)[:, None]) * 128 + np.arange(128)[None, :]
+        mem.z[zb.reshape(-1)] = t.reshape(-1)
+        cidx = co + pas * NB + nb
+        old = mem.counters[cidx]
+        mem.counters[cidx] += 1
+        if old == SK - 1:                                   # the strip's last split: the SK partials in split order
+            base = zo + ((pas * P + p - split) * RP + np.arange(R)[:, None]) * 128 + np.arange(128)[None, :]
+            acc = mem.z[base.reshape(-1)].reshape(R, 128).copy()
+            for j in range(1, SK):
+                acc = (acc + mem.z[(base + j * RP * 128).reshape(-1)].reshape(R, 128)).astype(F32)
+            assert not np.isnan(acc).any(), "a partial read before it was written"
+            mem.ys[buf][at] = epilogue(acc, svhs[i][c0:c0 + 128]).reshape(-1)
+            mem.writes[buf][at] += 1
+            mem.counters[cidx] = 0
+
+
+def dense(xs: list, suhs: list, Ws: list, svhs: list, segs: list, lay, widths: list[int], pd: int = 3,
+          seed: int = 0):
+    """``dense.Group._block`` over ``segs`` / ``lay`` (dense.layout, M <= dense.ROWS): the rot_in launch, then each
+    launch's programs in a shuffled order. Returns (output buffers [M, width], the Mem)."""
+
+    M = xs[0].shape[0]
+    mem = Mem(lay, widths, M)
+    for i, x in enumerate(xs):
+        K = x.shape[1]
+        mem.xh[lay.xh_off[i]:lay.xh_off[i] + M * K] = rot_rows(x, suhs[i]).reshape(-1)
+    rng = np.random.default_rng(seed)
+    for k2, part, meta, P, zo in lay.launches:
+        table = [meta[8 * j:8 * j + 8] for j in range(len(part))]
+        order = np.arange(P)
+        rng.shuffle(order)
+        for p in order:
+            program(mem, table, part, segs, Ws, svhs, P, zo, int(p), M, pd)
+    return [y.reshape(M, w) for y, w in zip(mem.ys, widths)], mem
+
+
+def reference(x: np.ndarray, suh, W: np.ndarray, svh) -> np.ndarray:
+    """float64 x_rot @ W_q, the output Hadamard, * svh (rot_in's fp16 rounding kept: it is the kernels' input)."""
+
+    xh = rot_rows(x, suh).astype(np.float64)
+    y = xh @ W.astype(np.float64)
+    M, N = y.shape
+    h = np.array([[1.0]])
+    while h.shape[0] < 128:
+        h = np.block([[h, h], [h, -h]])
+    out = (y.reshape(M, N // 128, 128) @ h).reshape(M, N) / np.sqrt(128.0)
+    return out * svh.astype(np.float64)[None, :]
