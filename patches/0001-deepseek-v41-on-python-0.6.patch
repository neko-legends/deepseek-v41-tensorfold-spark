+}
+
+// patches/0170: ``gateup``'s contract; ``shared_x``: both matrices multiply XG (XU is not read); stages 3 | 4
+void gateup_fat(const at::Tensor& XG, const at::Tensor& XU, const at::Tensor& TG, const at::Tensor& TU,
+                const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, const at::Tensor& svh_g,
+                const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t slots,
+                double limit, bool shared_x, int64_t stages, bool ticket) {
+    check(XG, at::kHalf, "XG");
+    if (!shared_x) check(XU, at::kHalf, "XU");
+    check(TG, at::kInt, "TG");
+    check(TU, at::kInt, "TU");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(XG.size(-1) == K && (shared_x || XU.size(-1) == K) && xd.size(-1) == N, "gateup_fat: X [P, K], Xd [P, N]");
+    TORCH_CHECK(TG.size(1) * 16 == K && TG.size(2) * 16 == N && TG.sizes() == TU.sizes(), "gateup_fat: trellis shapes");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup_fat: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XG.device());
+    exl3_fat_gateup_cuda(XG, XU, TG, TU, uids, ucount, members, svh_g, svh_u, suh_d, xd, K, N, slots, limit, shared_x,
+                         stages, ticket);
+}
+
+void down_fat(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+              const at::Tensor& members, const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t slots,
+              int64_t stages, bool ticket) {
+    check(XD, at::kHalf, "XD");
+    check(TD, at::kInt, "TD");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(XD.size(-1) == K && y.size(-1) == N, "down_fat: Xd [P, K], Y [P, N]");
+    TORCH_CHECK(TD.size(1) * 16 == K && TD.size(2) * 16 == N, "down_fat: trellis shape");
+    TORCH_CHECK(svh_d.size(-1) == N, "down_fat: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XD.device());
+    exl3_fat_down_cuda(XD, TD, uids, ucount, members, svh_d, y, K, N, slots, stages, ticket);
+}
+
+// patches/0260: ``gateup_fat``'s contract without the stage count; ``pair``: two passes of an expert share a decode;
+// ``probe`` (timing only; outputs are garbage): 1 = no trellis decode, 2 = no mma
+void gateup_once(const at::Tensor& XG, const at::Tensor& XU, const at::Tensor& TG, const at::Tensor& TU,
+                 const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, const at::Tensor& svh_g,
+                 const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t slots,
+                 double limit, bool shared_x, bool ticket, bool pair, int64_t probe) {
+    check(XG, at::kHalf, "XG");
+    if (!shared_x) check(XU, at::kHalf, "XU");
+    check(TG, at::kInt, "TG");
+    check(TU, at::kInt, "TU");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(XG.size(-1) == K && (shared_x || XU.size(-1) == K) && xd.size(-1) == N, "gateup_once: X [P, K], Xd [P, N]");
+    TORCH_CHECK(TG.size(1) * 16 == K && TG.size(2) * 16 == N && TG.sizes() == TU.sizes(), "gateup_once: trellis shapes");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup_once: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XG.device());
+    exl3_once_gateup_cuda(XG, XU, TG, TU, uids, ucount, members, svh_g, svh_u, suh_d, xd, K, N, slots, limit, shared_x,
+                          ticket, pair, probe);
+}
+
+void down_once(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+               const at::Tensor& members, const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t slots,
+               bool ticket, bool pair, int64_t probe) {
+    check(XD, at::kHalf, "XD");
+    check(TD, at::kInt, "TD");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(XD.size(-1) == K && y.size(-1) == N, "down_once: Xd [P, K], Y [P, N]");
+    TORCH_CHECK(TD.size(1) * 16 == K && TD.size(2) * 16 == N, "down_once: trellis shape");
