+        item = job.out.get_nowait()
+        if item is None:
+            break
+        out += item
+    assert len(out) == 4
+    assert f0.segments == f1.segments == -(-298_999 // SEG)
+    for f in (f0, f1):                          # the memo holds ~8 segments, not the prompt
+        assert f.hasher.held <= 16384 and len(f.hasher.memo) <= 8
+    for b in (b0, b1):                          # nothing of the prompt left in the executor
+        assert all(not h for h in b.ex.hist) and all(p is None for p in b.ex.prompts)
