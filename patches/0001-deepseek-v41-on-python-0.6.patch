@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G13 ``dense3``: GB/s a shape, x3seg (fused_proj, strips) against dense3 (TF_DSV41_DENSE_V3, the same matrices
+repacked in place), on one GPU, the real weights of ``--layers``, COLD L2.
+
+Each shape (``densebench.shapes``: x / x4, q / q+ix, o, wo_b, as ``blocks.attention`` calls them) is timed by
+``densebench.cold_us``: a CUDA graph of 10 x (a 256 MB write that evicts GB10's 24 MB L2, the call) minus a graph of
+the writes alone. The warm back-to-back replay is printed beside it (L2-hot below ~20 MB: x3dn's design was misled
+by it). x3seg runs first; then ``fused_proj.build`` with V3 on repacks every attention matrix in place and the same
+inputs run again under each ``--minb`` (TF_DSV41_DENSE_V3_MINB). Checks: dense3's outputs == x3seg's bit for bit,
+and row 0 of an R-row window == the row alone. The window estimate: each class's mean us change x its launches in a
+1-row window (G9: x 36, x4 4, q 32, q+ix 8, o 40, wo_b 40).
+
+    python -m tensorfold.families.deepseek_v41.cuda.dense3bench --model DIR [--rank 0] [--layers 1,2,3,20,24]
+           [--rows 1,2,4,8,16] [--iters 30] [--minb "3,1;4,2"] [--out dense3bench.json] [--x3ld-layer 3]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+WINDOW = {"x": 36, "x4": 4, "q": 32, "q+ix": 8, "o": 40, "wo_b": 40}     # launches a 1-row window (G9 section 2)
+
+
+def _outs(v):
+    v = list(v) if isinstance(v, (tuple, list)) else [v]
+    return [t for t in v if t is not None]
+
+
+def bench(model: str, rank: int, layers, rows, iters: int, minbs=("3,1",), x3ld_layer: int | None = None) -> dict:
+    import torch
+
+    from . import dense3 as D3
+    from . import densebench as DB
+    from . import fused_proj as FP
+    from . import projbench as PB
+    from . import weights as W
+    from .config import Config
+
+    torch.cuda.set_device(0)
+    cfg = Config.from_file(Path(model) / "config.json")
+    ld = W.Loader(cfg, W.Shards(model), rank, 2, "cuda")
+    t0 = time.time()
+    with DB._env(**{D3.ENV: "0"}):
+        attns = [(L, PB.attn_of(cfg, ld, L, "cuda")) for L in layers]
+        built = {L: FP.build(A) for L, A in attns}
+    rep: dict = {"rank": rank, "layers": list(layers), "load_s": round(time.time() - t0, 1), "shapes": {},
+                 "bitwise": True, "row_invariant": True, "minb": list(minbs)}
+    gen = torch.Generator(device="cuda").manual_seed(rank)
+    bf = torch.bfloat16
+    inputs = {}
+    for R in rows:
+        x = torch.randn((R, cfg.hidden_size), generator=gen, device="cuda").to(bf)
+        qr = torch.randn((R, cfg.q_lora_rank), generator=gen, device="cuda").to(bf)
+        o = (torch.randn((R, (cfg.num_attention_heads // 2) * cfg.head_dim), generator=gen, device="cuda") * 0.3).to(bf)
+        inputs[R] = (x, qr, o)
+    ref: dict = {}
+
+    def run(mode: str) -> None:
+        for R in rows:
+            x, qr, o = inputs[R]
+            for L, A in attns:
+                G = built[L]
+                for name, (fn, lins) in DB.shapes(A, G, x, qr, o).items():
+                    mb = sum(lin.words.numel() * 4 for lin in lins) / 1e6
+                    us, hot = DB.cold_us(fn, iters), DB.warm_us(fn, iters)
+                    rec = rep["shapes"].setdefault(f"L{L} {name}", {}).setdefault(str(R), {"mb": round(mb, 2)})
+                    rec[mode] = {"us": round(us, 1), "gbps": round(mb / us * 1e3, 1), "warm_us": round(hot, 1)}
+                    outs = _outs(fn())
+                    if mode == "x3seg":
+                        ref[(L, name, R)] = [t.clone() for t in outs]
+                        continue
+                    same = all(torch.equal(a, b) for a, b in zip(outs, ref[(L, name, R)]))
+                    rep["bitwise"] &= same and len(outs) == len(ref[(L, name, R)])
+                    if R > 1:
+                        one = _outs(DB.shapes(A, G, x[:1], qr[:1], o[:1])[name][0]())
+                        rep["row_invariant"] &= all(torch.equal(a[:1], b) for a, b in zip(outs, one))
+                    b = rec["x3seg"]
+                    print(f"[G13] dense3 L{L} {name} ({rec['mb']} MB) R={R} cold L2: x3seg {b['us']} us {b['gbps']} "
+                          f"GB/s -> {mode} {us:.1f} us {mb / us * 1e3:.1f} GB/s (warm {b['warm_us']} -> {hot:.1f} us)"
+                          f"{'' if same else '  BITS DIFFER'}", flush=True)
+
+    run("x3seg")
+    with DB._env(**{D3.ENV: "1"}):
+        built = {L: FP.build(A) for L, A in attns}                       # dense3.mark: repacked in place
+    rep["repacked"] = sum(D3.is_lanes(lin) for _, A in attns for lin in D3.attn_lins(A))
+    for mb_ in minbs:
+        with DB._env(**{D3.ENV + "_MINB": mb_}):
+            run(f"dense3 {mb_}")
+    rep["window"] = window(rep, rows, minbs)
+    for line in rep["window"]["lines"]:
+        print(f"[G13] dense3 {line}", flush=True)
+    if x3ld_layer is not None and x3ld_layer >= 0:                         # the bandwidth reference: x3ld, experts
+        from . import kbench
+
+        kb = kbench.bench(model, x3ld_layer, rank, iters, rows=tuple(rows))
+        rep["x3ld_gbps"] = {R: max(v["gbps"] for v in row["x3ld"].values()) for R, row in kb["rows"].items()}
+        print(f"[G13] dense3 x3ld reference (layer {x3ld_layer} experts) GB/s: {rep['x3ld_gbps']}", flush=True)
+    print(f"[G13] dense3: {rep['repacked']} matrices repacked; bitwise == x3seg {rep['bitwise']}; row invariant "
+          f"{rep['row_invariant']}", flush=True)
+    return rep
+
+
+def window(rep: dict, rows, minbs) -> dict:
+    """Per class (x, x4, q, q+ix, o, wo_b): mean cold us over the benched layers, x3seg vs each dense3 mode, and the
+    1-row window's change (mean change x WINDOW launches); GB/s by class."""
+
+    out: dict = {"lines": [], "classes": {}}
+    for R in rows:
+        for mb_ in minbs:
+            mode, d_ms = f"dense3 {mb_}", 0.0
+            parts = []
+            for cls, n in WINDOW.items():
+                recs = [v[str(R)] for k, v in rep["shapes"].items() if k.split(" ", 1)[1] == cls and str(R) in v
+                        and mode in v[str(R)]]
+                if not recs:
+                    continue
+                a = sum(r["x3seg"]["us"] for r in recs) / len(recs)
+                b = sum(r[mode]["us"] for r in recs) / len(recs)
+                mb = sum(r["mb"] for r in recs) / len(recs)
+                d_ms += n * (b - a) / 1e3
+                out["classes"][f"{cls} R={R} {mode}"] = {"x3seg_us": round(a, 1), "dense3_us": round(b, 1),
+                                                         "x3seg_gbps": round(mb / a * 1e3, 1),
+                                                         "dense3_gbps": round(mb / b * 1e3, 1)}
+                parts.append(f"{cls} {mb / a * 1e3:.0f}->{mb / b * 1e3:.0f}")
+            out[f"R={R} {mode}"] = round(d_ms, 3)
+            out["lines"].append(f"R={R} MINB {mb_}: GB/s a class (x3seg->dense3) {', '.join(parts)}; attention dense "
+                                f"{d_ms:+.2f} ms a window (cold, the window's launches)")
+    return out
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description="G13 dense3: cold-L2 GB/s a shape, x3seg vs dense3")
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, default=0)
+    ap.add_argument("--layers", default="1,2,3,20,24")
+    ap.add_argument("--rows", default="1,2,4,8,16")
+    ap.add_argument("--iters", type=int, default=30)
+    ap.add_argument("--minb", default="3,1", help='TF_DSV41_DENSE_V3_MINB values separated by ";"')
+    ap.add_argument("--x3ld-layer", type=int, default=-1)
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    rep = bench(a.model, a.rank, [int(v) for v in a.layers.split(",")], [int(v) for v in a.rows.split(",")],
+                a.iters, tuple(v.strip() for v in a.minb.split(";") if v.strip()), a.x3ld_layer)
+    if a.out:
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+    return 0 if rep["bitwise"] and rep["row_invariant"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
