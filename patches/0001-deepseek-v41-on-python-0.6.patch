index 0000000..626dcb5
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/dense.py
@@ -0,0 +1,305 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dense EXL3 linears at bandwidth (``TF_DSV41_DENSE``; ``x3dn.cu``). docs/DECODE-ROOFLINE.md section 7.
+
+Why. G7's nsys (rank 0, 1-stream code, ~4.7-row windows) has the attention's dense EXL3 matrices at 155-190 GB/s
+against GB10's ~240: x (wq_a + wkv, 5.7 MB) 36.5 us = 157 GB/s, o (wo_a's 4 groups, 10.5 MB) 59.6 us = 176, wq_b
+(13.1 MB) 73.9 us = 177, wo_b (13.1 MB) 68.5 us = 191, ~9.9 ms a window. Upstream's grid is one program a (strip,
+K split), 3 programs an SM (1 for the 8-warp wq_b), so a launch is 1.8-2.7 waves whose last one is partial and
+whose SMs hold unequal program counts (x: 112 programs on 48 SMs = 3 on 16 SMs, 2 on 32: 1.29x); every program ends
+in a fence / atomic / Z round trip; trellis words come in 4-byte loads (~2.4 lanes a word) and each k step waits on
+an unprefetched input fragment. (A per-SM byte model blamed the uneven programs an SM; v1 balanced them and was
+slower, so the in-flight depth and the per-program round trips are the levers kept below.)
+
+v1 (persistent CTAs over 16-step K atoms from a work counter) was 9-24% SLOWER than upstream in the engine (G9
+section 2): 16-20 partials a strip with a fence, two atomics and a last-arriver sum each. Its design numbers came
+from an L2-hot bench (upstream itself 288-443 GB/s there).
+
+What (v2). ``x3dn``: upstream's grid shape (a program a 128-column strip x K split) with the x3ld load path
+(16-byte cp.async into a ``PD``-deep shared-memory ring a warp, input fragments cp.async), PDL (a program's first
+weights before griddepcontrol.wait, behind a PDL ``rot_in``), and few splits a shape (``SPLITS``): none where N
+alone gives >= 48 programs (wq_b, head, Engram), 2-4 elsewhere, against upstream's 8. The premise: a CTA keeps
+PD x 4 x ~1.3 KB in flight (~10 GB/s an SM at cold latency), so ~24 busy CTAs carry DRAM and a few large programs
+lose nothing to uneven programs an SM, while every split costs a partial round trip and a last-arriver epilogue.
+
+Bits (another summation order than upstream: G8 / G9's gate decides): split s of a strip = k steps
+[s KT / SK, (s + 1) KT / SK), its 4 warp quarters summed in warp order, the SK partials in split order, upstream's
+epilogue. SK is the shape's (``split_of``), so a matrix's bits are the same in any group (x2 or x4, fused or not),
+at any row count: row invariance, batched == alone, drafted == serial.
+
+Knobs: ``TF_DSV41_DENSE`` 0 (default) | ``attn`` (the attention's matrices, every path that computes them: fused
+groups, wo_b, the compressor's own pass, the drafter's blocks) | ``all`` (every ``linear.Exl3``: + head, Engram, the
+drafter's main_proj, the indexer's wk); ``TF_DSV41_DENSE_PD`` ring depth 2-4 (3) and ``TF_DSV41_DENSE_PDL`` 1: speed
+only; ``TF_DSV41_DENSE_SPLIT`` e.g. ``4096x5120:1,5120x1280:8`` overrides ``SPLITS`` (other bits: a G9 sweep knob).
+
+Cost model (cold DRAM ~240 GB/s, t ~ 3-4 us + bytes / 240 GB/s; per ~4.7-row window, 40 layers): wo_b 65 -> ~58 us,
+o 57 -> ~47, wq_b 69 -> ~58, x 36 -> ~28, q + ix 90 -> ~72: attention dense ~9.3 -> ~7.6 ms. Unmeasured: v2 is a
+bet on the in-flight premise above, and SPLIT / PD are there to sweep it in the GPU window.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from . import numerics as N
+
+ENV = "TF_DSV41_DENSE"
+WARPS = 4
+ROWS = 32                       # rows a launch (2 passes; longer windows in row blocks, a row's bits unchanged)
+K2S = (6, 8, 10, 12, 16)        # widths x3dn.cu is built for
+MAXSEG = 8
+META = 8                        # ints a segment in the launch table (x3dn.cpp)
+# K splits of the real shapes (K, N) -> SK: x 56 programs (wq_a 40 + wkv 16), q 192 (wq_b 128 + indexer 64), o 64
+# (4 x 16), wo_b 80; 20-32 k steps a warp. Other shapes: ``split_of``'s rule.
+SPLITS = {(5120, 1280): 4, (5120, 512): 4, (1280, 16384): 1, (1280, 4096): 2, (4096, 1024): 2, (4096, 5120): 2}
+
+
+def _env(env):
+    return os.environ if env is None else env
+
+
+def scope(env=None) -> str:
+    """``TF_DSV41_DENSE``: "0" (off), "attn" or "all"."""
+
+    v = (_env(env).get(ENV, "0").strip().lower() or "0")
+    v = {"1": "attn", "on": "attn"}.get(v, v)
+    if v not in ("0", "attn", "all"):
+        raise ValueError(f"{ENV}={v!r}: expected 0, attn or all")
+    return v
+
+
+def pd(env=None) -> int:
+    v = int(_env(env).get(ENV + "_PD", "3").strip() or "3")
+    if v not in (2, 3, 4):
+        raise ValueError(f"{ENV}_PD={v}: expected 2, 3 or 4")
+    return v
+
+
+def pdl(env=None) -> bool:
+    return (_env(env).get(ENV + "_PDL", "1").strip() or "1") not in ("0", "off", "false")
+
+
+def splits(env=None) -> dict:
+    """``SPLITS`` with ``TF_DSV41_DENSE_SPLIT``'s overrides (``KxN:SK`` comma-separated)."""
+
+    out = dict(SPLITS)
+    raw = _env(env).get(ENV + "_SPLIT", "").strip()
+    for part in filter(None, (v.strip() for v in raw.split(","))):
+        try:
+            shape, sk = part.split(":")
+            k, n = (int(v) for v in shape.lower().split("x"))
+            out[(k, n)] = int(sk)
+        except ValueError:
+            raise ValueError(f"{ENV}_SPLIT={raw!r}: expected e.g. 4096x5120:1,5120x1280:8") from None
+    return out
+
+
+def split_of(k: int, n: int, env=None) -> int:
+    """SK of a K x N matrix: the table's, else enough programs for 48 SMs (ceil(48 / strips)), at most 8 and with
+    >= 8 k steps a warp."""
+
+    kt, nb = k // 16, n // 128
+    sk = splits(env).get((k, n))
+    if sk is None:
+        sk = min(8, -(-48 // nb), max(1, kt // (8 * WARPS)))
+    if not 1 <= sk <= min(16, kt):
+        raise ValueError(f"dense: {sk} K splits of a {k} x {n} matrix")
+    return sk
+
+
+def why_not(lin) -> str | None:
+    """None when x3dn takes this upstream ``Exl3Linear``, else why not."""
+
+    if lin is None or not hasattr(lin, "words"):
+        return "not an EXL3 linear on CUDA"
+    if getattr(lin, "layout", "strips") != "strips" or lin.bias is not None:
+        return "layout / bias"
+    if lin.codebook != "mul1" or lin.k2 not in K2S:
+        return "codebook / width"
+    if lin.k % 128 or lin.n % 128:
+        return "shape (K and N multiples of 128)"
+    return None
+
+
+# -- which matrices run here (on the objects, so every path that computes one sums alike) ---------------------------
+def mark(attn, env=None) -> None:
+    """``attn`` scope: flag the attention's EXL3 matrices (``lin.x3dn``), wherever they are called from."""
+
+    if scope(env) == "0":
+        return
+    from .fused_proj import lin_of
+
+    for x in (attn.wq_a, attn.wkv, attn.comp_wkv, attn.comp_wgate, attn.wq_b, attn.ix_wq_b, attn.wo_b, *attn.wo_a):
+        lin = lin_of(x) if x is not None else None
+        if lin is not None and why_not(lin) is None:
+            lin.x3dn = True
+
+
+def wanted(lin, env=None) -> bool:
+    s = scope(env)
+    if s == "0" or lin is None:
+        return False
+    return (s == "all" or getattr(lin, "x3dn", False)) and why_not(lin) is None
+
+
+# -- the tables (pure Python: the launcher and the emulator use the same ones) -------------------------------------
+@dataclass(frozen=True)
+class Seg:
+    """One matrix: K x N, width K2, K splits ``sk``, its output buffer ``out`` at column ``col``."""
+
+    k: int
+    n: int
+    k2: int
+    sk: int = 1
+    out: int = 0
+    col: int = 0
+
+    @property
+    def programs(self) -> int:
+        return (self.n // 128) * self.sk
+
+
+@dataclass(frozen=True)
+class Layout:
+    """A call's scratch for M rows (1-ROWS): ``xh_off`` / ``c_off`` a segment (fp16 elements of the rotated inputs,
+    ints of the strip counters), ``launches`` [(K2, [segment], meta ints, programs, z_off)], Z floats in all."""
+
+    m: int
+    xh_off: tuple
+    c_off: tuple
+    xh_total: int
+    c_total: int
+    z_total: int
+    launches: tuple
+
+
+def passes(m: int) -> int:
+    return (m + 15) // 16
+
+
+def layout(segs: list[Seg], m: int) -> Layout:
+    """One launch a width (segments in order, up to MAXSEG a launch); counters sized for ROWS rows (one slice a
+    segment, whatever ``m``), Z for ``m``: passes x programs x min(m, 16) rows x 128 floats a launch with a split."""
+
+    if not 1 <= m <= ROWS:
+        raise ValueError(f"dense.layout: 1-{ROWS} rows, got {m}")
+    xh_off, c_off = [], []
+    xo = co = 0
+    for s in segs:
+        if s.k % 128 or s.n % 128 or s.k2 not in K2S or not 1 <= s.sk <= min(16, s.k // 16):
+            raise ValueError(f"dense.layout: segment {s} (K, N multiples of 128, K2 in {K2S}, 1-16 splits)")
+        xh_off.append(xo)
+        c_off.append(co)
+        xo += m * s.k
+        co += passes(ROWS) * (s.n // 128)
+    launches, zo = [], 0
+    for k2 in dict.fromkeys(s.k2 for s in segs):
+        idx = [i for i, s in enumerate(segs) if s.k2 == k2]
+        for a in range(0, len(idx), MAXSEG):
+            part = idx[a:a + MAXSEG]
+            meta, p0 = [], 0
+            for i in part:
+                s = segs[i]
+                meta += [s.k, s.n, s.sk, p0, xh_off[i], c_off[i], s.col, k2]
+                p0 += s.programs
+            launches.append((k2, tuple(part), tuple(meta), p0, zo))
+            if any(segs[i].sk > 1 for i in part):
+                zo += passes(m) * p0 * min(m, 16) * 128
+    return Layout(m, tuple(xh_off), tuple(c_off), xo, co, zo, tuple(launches))
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_x3dn_v2", sources=[str(here / "x3dn.cpp"), str(here / "x3dn.cu")],
+                extra_include_paths=[str(Path(upstream.__file__).parent)],
+                extra_cuda_cflags=["-O3", "--expt-relaxed-constexpr", "-lineinfo"], verbose=False)
+
+
+@lru_cache(maxsize=None)
+def _pdl_ok(device: int) -> bool:
+    return torch.cuda.get_device_capability(device)[0] >= 9
+
+
+class Group:
+    """Upstream ``Exl3Linear`` objects as one ``rot_in`` launch + one x3dn launch a width; ``outs[i]``: segment i's
+    output buffer (buffers in first-use order, a buffer's segments side by side): ``fused_proj.Fused``'s contract.
+    One group must not run on two streams at once (its counters), as upstream's per-layer counters."""
+
+    def __init__(self, lins: list, outs: list[int] | None = None) -> None:
+        if not 1 <= len(lins) <= MAXSEG:
+            raise ValueError(f"dense.Group: 1-{MAXSEG} matrices")
+        for lin in lins:
+            if why_not(lin) is not None:
+                raise ValueError(f"dense.Group: {why_not(lin)}")
+        outs = list(range(len(lins))) if outs is None else list(outs)
+        width: dict[int, int] = {}
+        segs = []
+        for lin, o in zip(lins, outs):
+            segs.append(Seg(lin.k, lin.n, lin.k2, split_of(lin.k, lin.n), o, width.get(o, 0)))
+            width[o] = width.get(o, 0) + lin.n
+        self.lins, self.segs, self.widths = list(lins), segs, [width[o] for o in sorted(width)]
+        dev = lins[0].words.device
+        lay = layout(segs, 1)
+        self.counters = torch.zeros((max(1, lay.c_total),), dtype=torch.int32, device=dev)
+        self._layouts: dict[int, Layout] = {}
+
+    def layout(self, m: int) -> Layout:
+        lay = self._layouts.get(m)
+        if lay is None:
+            lay = self._layouts[m] = layout(self.segs, m)
+        return lay
+
+    def __call__(self, xs, dtype: torch.dtype = N.ACC, outs: list | None = None) -> list[torch.Tensor]:
+        """y_b [M, width_b] for each output buffer b (into ``outs`` when given); ``xs``: one input [M, K] for every
+        segment or a list (row-strided views allowed: unit stride in K, 16-byte rows)."""
+
+        xs = [xs] * len(self.segs) if isinstance(xs, torch.Tensor) else list(xs)
+        xs = [x if x.stride(-1) == 1 and (x.stride(0) * x.element_size()) % 16 == 0 and x.data_ptr() % 16 == 0
+              else x.contiguous() for x in xs]
+        M = xs[0].shape[0]
+        ys = outs if outs is not None else [torch.empty((M, w), dtype=dtype, device=xs[0].device)
+                                            for w in self.widths]
+        for a in range(0, M, ROWS):
+            b = min(M, a + ROWS)
+            self._block([x[a:b] for x in xs], [y[a:b] for y in ys])
+        return ys
+
+    def _block(self, xs: list, ys: list) -> None:
+        lay = self.layout(xs[0].shape[0])
+        ext = _ext()
+        dev = xs[0].device
+        on = pdl() and _pdl_ok(dev.index or 0)
+        xh = torch.empty((lay.xh_total,), dtype=torch.float16, device=dev)
+        z = torch.empty((max(1, lay.z_total),), dtype=torch.float32, device=dev)
+        ext.rot_in(xs, [lin.suh for lin in self.lins], xh, list(lay.xh_off), on)
+        depth = pd()
+        for k2, part, meta, programs, zo in lay.launches:
+            ext.linear(xh, [self.lins[i].words for i in part], [self.lins[i].svh for i in part],
+                       [ys[self.segs[i].out] for i in part], z[zo:], self.counters, list(meta), programs, k2, depth,
+                       on)
+
+
+def single(lin) -> Group:
+    """The one-matrix group of an ``Exl3Linear`` (cached on it)."""
+
+    g = getattr(lin, "_x3dn_group", None)
+    if g is None:
+        g = lin._x3dn_group = Group([lin])
+    return g
+
+
+def nbytes(lins) -> int:
+    return sum(lin.words.numel() * 4 for lin in lins)
+
+
+__all__ = ["ENV", "Group", "Layout", "ROWS", "SPLITS", "Seg", "layout", "mark", "split_of", "splits",
+           "nbytes", "pd", "pdl", "scope", "single", "wanted", "why_not"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/dense3.cpp b/src/tensorfold/families/deepseek_v41/cuda/dense3.cpp
new file mode 100644
index 0000000..e6158cf
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/dense3.cpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of dense3.cu (TF_DSV41_DENSE_V3: x3seg's programs over the lanes layout; dense3.py). The linear launcher
+// takes x3seg's tables (fused_proj.layout) and checks every bound x3seg.cpp checks, plus whole load groups a warp,
+// so a wrong table from Python is an error, never an out-of-bounds read or write. rot_in is x3seg's own launch.
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+#include <vector>
+
+void dsv41_dense3_linear_cuda(const at::Tensor&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                              const std::vector<at::Tensor>&, const c10::optional<at::Tensor>&, at::Tensor&,
+                              const std::vector<int64_t>&, int64_t, int64_t, int64_t, int64_t, bool);
+void dsv41_dense3_relayout_cuda(const at::Tensor&, at::Tensor&, int64_t, int64_t, bool);
+void dsv41_dense3_unpack_cuda(const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t);
+
+static constexpr int MAXSEG = 8;
+
+static int64_t group_steps(int64_t K2) { return K2 == 16 ? 1 : 2; }
+
+static bool width_ok(int64_t K2) { return K2 == 4 || K2 == 6 || K2 == 8 || K2 == 10 || K2 == 12; }
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+static bool io_dtype(const at::Tensor& x) {
+    const auto t = x.scalar_type();
+    return t == at::kHalf || t == at::kBFloat16 || t == at::kFloat;
+}
+
+static bool aligned16(const at::Tensor& x) { return reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0; }
+
+void linear(const at::Tensor& xh, const std::vector<at::Tensor>& T, const std::vector<at::Tensor>& svh,
+            const std::vector<at::Tensor>& ys, const c10::optional<at::Tensor>& Z, at::Tensor counters,
+            const std::vector<int64_t>& meta, int64_t programs, int64_t K2, int64_t WK, int64_t minb, bool pdl) {
+    const size_t n = T.size();
+    TORCH_CHECK(n >= 1 && n <= MAXSEG && svh.size() == n && ys.size() == n && meta.size() == 11 * n,
+                "dense3.linear: 1-8 segments, 11 meta ints each");
+    TORCH_CHECK(width_ok(K2), "dense3.linear: K2 4, 6, 8, 10 or 12");
+    TORCH_CHECK((WK == 4 && (minb == 3 || minb == 4)) || (WK == 8 && (minb == 1 || minb == 2)),
+                "dense3.linear: WK 4 with MINB 3 / 4, WK 8 with MINB 1 / 2");
+    check(xh, at::kHalf, "xh");
+    check(counters, at::kInt, "counters");
+    if (Z) check(*Z, at::kFloat, "Z");
+    const int64_t M = ys[0].size(0);
+    TORCH_CHECK(M >= 1 && M <= 128, "dense3.linear: 1-128 rows");
+    int64_t p = 0;
+    for (size_t i = 0; i < n; ++i) {
+        const int64_t* m = meta.data() + 11 * i;
+        const int64_t K = m[0], N = m[1], SK = m[2], wk = m[3], xo = m[6], zo = m[7], co = m[8], col = m[9];
+        TORCH_CHECK(K % 128 == 0 && N % 128 == 0 && K > 0 && N > 0, "dense3.linear: K, N multiples of 128");
+        TORCH_CHECK(SK >= 1 && (wk == 4 || wk == 8) && wk <= WK && (K / 16) % (SK * wk) == 0,
+                    "dense3.linear: K / 16 must split evenly over SK * wk warps, wk <= WK");
+        TORCH_CHECK((K / 16 / (SK * wk)) % group_steps(K2) == 0, "dense3.linear: k steps a warp in whole groups");
+        TORCH_CHECK(m[10] == p, "dense3.linear: p0 must be the running sum of the programs");
+        p += (N / 128) * SK;
+        check(T[i], at::kInt, "T");
+        TORCH_CHECK(T[i].numel() == K * N * K2 / 64 && aligned16(T[i]),
+                    "dense3.linear: T holds K * N * bits / 32 words, 16-byte aligned");
+        TORCH_CHECK(m[4] == 32 * K2 && m[5] == (K / 16) * 32 * K2, "dense3.linear: strip strides");
+        check(svh[i], at::kHalf, "svh");
+        TORCH_CHECK(svh[i].numel() == N, "dense3.linear: svh [N]");
+        TORCH_CHECK(xo >= 0 && xo + M * K <= xh.numel() && xo % 8 == 0, "dense3.linear: xh slice");
+        TORCH_CHECK(co >= 0 && co + 8 * (N / 128) <= counters.numel(), "dense3.linear: counter slice");
+        if (SK > 1) TORCH_CHECK(Z && zo >= 0 && zo % 4 == 0 && zo + SK * M * N <= Z->numel(), "dense3.linear: Z slice");
+        const auto& y = ys[i];
+        TORCH_CHECK(y.is_cuda() && y.dim() == 2 && io_dtype(y) && y.scalar_type() == ys[0].scalar_type() &&
+                        y.size(0) == M && y.stride(1) == 1 && col >= 0 && col % 4 == 0 && col + N <= y.size(1) &&
+                        (M == 1 || y.stride(0) >= y.size(1)),
+                    "dense3.linear: y [M, >= col + N], unit-stride rows, one dtype a launch");
+        TORCH_CHECK(aligned16(y) && (y.stride(0) * y.element_size()) % 16 == 0, "dense3.linear: 16-byte y rows");
+    }
+    TORCH_CHECK(p == programs, "dense3.linear: programs != the segments' sum");
+    c10::cuda::CUDAGuard guard(xh.device());
+    dsv41_dense3_linear_cuda(xh, T, svh, ys, Z, counters, meta, programs, K2, WK, minb, pdl);
+}
+
+// src -> dst, one matrix's words [N/128, K/16, 8, 4 K2] (int32): strips -> lanes (lanes = true) or back
+void relayout(const at::Tensor& src, at::Tensor dst, int64_t K2, int64_t K, bool lanes) {
+    check(src, at::kInt, "src");
+    check(dst, at::kInt, "dst");
+    TORCH_CHECK(width_ok(K2) && K % 128 == 0 && src.numel() == dst.numel() && src.data_ptr() != dst.data_ptr(),
+                "dense3.relayout: K2 4-12, K a multiple of 128, two buffers of one size");
+    TORCH_CHECK(src.numel() % ((K / 16) * 32 * K2) == 0, "dense3.relayout: whole strips");
+    c10::cuda::CUDAGuard guard(src.device());
+    dsv41_dense3_relayout_cuda(src, dst, K2, K, lanes);
+}
+
+// W_q [K, N] fp16 from lanes words (upstream unpack's output)
+void unpack(const at::Tensor& T, at::Tensor W, int64_t stride_k, int64_t stride_nb, int64_t K2) {
+    check(T, at::kInt, "T");
+    check(W, at::kHalf, "W");
+    const int64_t K = W.size(0), N = W.size(1);
+    TORCH_CHECK(W.dim() == 2 && width_ok(K2) && K % 128 == 0 && N % 128 == 0 && T.numel() == K * N * K2 / 64 &&
+                    stride_k == 32 * K2 && stride_nb == (K / 16) * 32 * K2 && aligned16(T),
+                "dense3.unpack: W [K, N], T the matrix's lanes words, strip strides");
+    c10::cuda::CUDAGuard guard(T.device());
+    dsv41_dense3_unpack_cuda(T, W, stride_k, stride_nb, K2);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("linear", &linear, pybind11::arg("xh"), pybind11::arg("T"), pybind11::arg("svh"), pybind11::arg("ys"),
+          pybind11::arg("Z"), pybind11::arg("counters"), pybind11::arg("meta"), pybind11::arg("programs"),
+          pybind11::arg("K2"), pybind11::arg("WK"), pybind11::arg("minb"), pybind11::arg("pdl") = false);
+    m.def("relayout", &relayout, pybind11::arg("src"), pybind11::arg("dst"), pybind11::arg("K2"), pybind11::arg("K"),
+          pybind11::arg("lanes"));
+    m.def("unpack", &unpack, pybind11::arg("T"), pybind11::arg("W"), pybind11::arg("stride_k"),
+          pybind11::arg("stride_nb"), pybind11::arg("K2"));
+}
