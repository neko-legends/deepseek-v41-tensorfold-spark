@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Row mode through the whole forward (G8, ``rowgraphs.Rows``: what a slot-agnostic CUDA graph replays) in Triton's
+CPU interpreter, on the synthetic DSpark checkpoint with the kernels' shapes (ratio-2 and ratio-1 kv sources, the
+candidate source and reindex layers, Engram), bound to a KV pool: two forwards fed the same prompts and windows,
+one running every window as one row-mode run padded to its bucket, the other one launch sequence a segment.
+
+- every real row's logits are the same bits, for mixes of 1-3 slots, padded and not;
+- the commits keep the same carries and positions, and after every window the pool's rows (compressed rows, index
+  keys) and the stacked SWA rings hold the same bytes: padding rows wrote nothing, real rows wrote the same;
+- the DSpark pass in row mode (3 slots padded to 4, one launch a block over the stacked rings) drafts what the
+  per-slot launches draft, with the same confidences.
+
+Run: python -m pytest -q tests/test_dsv41_rowmode_fwd_interp.py (a few minutes).
+"""
+
+from __future__ import annotations
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowmode  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.forward import Seg  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+
+if type(compress._kv_store).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+LIMIT, CAP = 512, 256
+PROMPTS = [[int(t) for t in torch.randint(3, 250, (n,), generator=torch.Generator().manual_seed(n))]
+           for n in (37, 20, 61)]
+# (slot, rows) windows a step: 8 rows unpadded, 9 -> 12, 1, 7, 3 slots -> 8
+STEPS = [[(0, 3), (1, 1), (2, 4)], [(1, 5), (2, 4)], [(0, 1)], [(2, 2), (0, 5)], [(1, 3), (0, 2), (2, 3)]]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41rows"))
+
+
+def _forward(ck, dspark: bool = False):
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+    from tensorfold.families.deepseek_v41.cuda.pool import Pool
+
+    from tensorfold.families.deepseek_v41.cuda import drafter as DR
+
+    root, cfg, table, topo = ck
+    tmap = FK.token_map(cfg)
+    loader = W.Loader(cfg, W.Shards(root), 0, 1)
+    tree = loader.load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = DecodeForward(cfg, tree, csa2=Triton(32, cfg.num_attention_heads, "cpu"), limit=LIMIT, chunk=32,
+                       engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=3,
+                       dspark=DR.load(loader) if dspark else None)
+    pool = Pool(topo, 3 * CAP + 256)
+    ps = [pool.new_slot(CAP) for _ in range(3)]
+    fw.bind(ps)
+    for p in ps:
+        p.ensure(CAP)
+    assert rowmode.ready(fw)
+    for s, ids in enumerate(PROMPTS):
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(ids))], mode="full")
+    return fw, pool
+
+
+def _state(fw, pool):
+    rs = fw.rowslot
+    return ([t.clone() for t in pool.phys.values()] + [st.values.clone() for st in rs.swa.values()]
+            + [c.clone() for c in rs.carry.values()])
+
+
+def test_row_mode_equals_per_segment(ck):
+    a, pa = _forward(ck)
+    b, pb = _forward(ck)
+    rows = RG.Rows(a, max(RT.BUCKETS[:10]), 2048)
+    g = torch.Generator().manual_seed(5)
+    for step, mix in enumerate(STEPS):
+        segs = [Seg(s, a.slots[s].pos, tuple(int(t) for t in torch.randint(3, 250, (n,), generator=g)))
+                for s, n in mix]
+        key = RT.row_key([(sg.slot, sg.start, len(sg.ids)) for sg in segs], 2048, LIMIT)
+        assert key is not None and key[0] == RT.bucket_rows(sum(n for _, n in mix))
+        got = rows.run(key, segs)
+        assert a.row_out is not None and b.__dict__.get("row_out") is None       # a ran row mode, b did not
+        want = b.run(segs)
+        assert torch.equal(got, want), (step, mix)
+        for x, y in zip(_state(a, pa), _state(b, pb)):
+            assert torch.equal(x, y), step
+        for sg in segs:
+            keep = (len(sg.ids) - 1) // 2
+            pa_, pb_ = a.slots[sg.slot].pending, b.slots[sg.slot].pending
+            for L in pb_.proj:
+                assert torch.equal(pa_.proj[L], pb_.proj[L])
+            a.keep(sg.slot, keep)
+            b.keep(sg.slot, keep)
+            assert a.slots[sg.slot].pos == b.slots[sg.slot].pos
+            for L, t in b.slots[sg.slot].carry.items():
+                assert torch.equal(a.slots[sg.slot].carry[L], t)
+
+
+def test_draft_pass_row_mode_equals_per_slot(ck):
+    fw, _ = _forward(ck, dspark=True)
+    dr = fw.drafter
+    assert dr.rowmode
+    live = [2, 0, 1]
+    anchors = [17, 99, 5]
+    starts = [fw.slots[s].pos for s in live]
+    d1, c1 = dr.propose(live, anchors, starts)
+    assert {k[0] for k in dr._inputs} == {4}                  # 3 slots padded to 4: the key holds no slot
+    dr.rowmode = False                                        # the per-slot launches (the twin's loop)
+    dr._inputs.clear()
+    d2, c2 = dr.propose(live, anchors, starts)
+    assert d1 == d2 and c1 == c2
