+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The next round's DSpark pass launched speculatively right after a verify window, on the GPU, before either
+rank's host has sampled, planned, shared the plan or committed (``TF_DSV41_SPEC_DRAFT=1``, default off).
+
+Why (G7, 1-stream code): a round is window -> candidates' D2H -> host sampling -> plan -> share -> commit -> stage
+-> DSpark pass -> drafts' D2H -> depth -> window, and the GPU idles through every host step: ~4 ms a round (8 ms
+under nsys). The pass needs only the bonus token and the next position, both functions of the window's candidates,
+so the GPU can compute them itself and run the pass while the hosts do their bookkeeping.
+
+How, after ``candidates``' gather (``decode.DecodeForward.window``, both ranks, the same calls):
+
+1. ``vsample``: each row's choice (greedy or keyed top-k / top-p / min-p in float64), each window's accepted
+   drafts, bonus and next start, on the device; (accepted, bonus, start) copied to pinned memory (event ``acc``);
+2. every row of the speculated windows' taps into the drafter's rings (``Drafter.ingest`` of the whole window: rows
+   past the commit lie past every later pass's context and are rewritten by the next commit's ingest first);
+3. the pass's static inputs (``draft_graphs.DraftInputs``) staged from the host for what the host knows (sampling,
+   ring validity) and overwritten on the device from (start, bonus) (``stage_device``), then the key's CUDA graph
+   replayed (only keys already captured: a speculation never captures).
+
+The host then waits only for the candidates' copy (recorded before the pass) and goes on while the GPU drafts.
+Consumers: ``Forward.keep`` asks ``ingested(slot, start, accepted)``: true when the device's accepted count is the
+commit's, then the commit's ingest is skipped (the rings already hold those rows); otherwise the commit ingests as
+before, rewriting any row the pass wrote at a wrong position. ``draft`` asks ``take(...)``: the speculated drafts
+when the round drafts exactly the speculated slots at the speculated (pending, start), sampling, head variant and
+ring validity, else None (the pass runs as before).
+
+Exactness: the host's ``choose_rows`` and ``accepted`` decide every token as before; the device's choice only
+decides whether a speculation is used, and a used one is the pass the round would have run on the same rings (the
+ingest of extra rows does not change the kept rows' bits: row-invariant kernels, ``test_dsv41_host_round``).
+Drafts only propose, so replies are serial whatever happens here. Both ranks launch, keep and drop the same
+speculations: every decision reads the plan, the device values (identical on both ranks) or state both ranks keep.
+
+A slot whose speculations keep missing (lookup rounds, finishes) is skipped while its decayed hit rate is under
+``MIN_RATE``, with a probe every ``PROBE`` rounds. Knob: TF_DSV41_SPEC_DRAFT (0 | 1).
+"""
+
+from __future__ import annotations
+
+import collections
+import os
+from dataclasses import dataclass, field
+
+import torch
+
+from . import vsample as VS
+
+ENV = "TF_DSV41_SPEC_DRAFT"
+DECAY = 0.8
+MIN_RATE = 0.3
+PROBE = 8
+
+
+NUCLEUS_ENV = "TF_DSV41_SPEC_NUCLEUS"
+
+
+def nucleus_enabled() -> bool:
+    """G17 ``TF_DSV41_SPEC_NUCLEUS`` (0 | 1, default 0): speculate after windows with top-p-without-top-k rows too
+    (m2bench's T = 0.7 streams; every C2 / C4 mixed round). Their statistics exchange is issued before the pass
+    (``nucleus.Pre``) and the device choice uses the full-vocabulary normalizer; the host still decides every token,
+    so a wrong guess is only a dropped speculation."""
+
+    v = os.environ.get(NUCLEUS_ENV, "0").strip().lower() or "0"
+    if v not in ("0", "1", "on", "off", "true", "false"):
+        raise ValueError(f"{NUCLEUS_ENV}={v!r}: expected 0 or 1")
+    return v in ("1", "on", "true")
+
+
+def enabled() -> bool:
+    v = os.environ.get(ENV, "0").strip().lower() or "0"
+    if v not in ("0", "1", "on", "off", "true", "false"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v in ("1", "on", "true")
+
+
+def stage_device(inp, P: torch.Tensor, A: torch.Tensor, valid: torch.Tensor, ring: int,
+                 base: torch.Tensor | None = None) -> None:
+    """``DraftInputs.stage``'s position-dependent values from device int64 starts ``P`` / anchors ``A`` / ring
+    validity ``valid`` [k] (the real slots in the key's order); the rest must be staged already (``stage`` with the
+    same slots). ``base`` int64 [S]: each (padded) slot's first row in the stacked ring (row mode), else 0. Slots
+    past the k real ones (padding, ``draft_graphs.pad_slots``) mirror the first."""
+
+    S, n, W = inp.S, inp.n, inp.W
+    k = P.shape[0]
+    if k < S:
+        j = torch.tensor([*range(k), *([0] * (S - k))], dtype=torch.long, device=P.device)
+        P, A, valid = P.index_select(0, j), A.index_select(0, j), valid.index_select(0, j)
+    v64, v32 = inp._split(inp.d64, inp.l64), inp._split(inp.d32, inp.l32)
+    ids, pos, ipar = v64[0].view(S, n), v64[1].view(S, n), v64[2].view(S, 4)
+    t, tok, cnt, lo, hi, anc = v32[:6]
+    dev = P.device
+    ids[:, 0] = A
+    pos.copy_(P[:, None] + torch.arange(n, device=dev))
+    ipar[:, 1] = P + 1
+    I32 = torch.int32
+    t.copy_(P.to(I32))
+    c0 = torch.clamp(torch.maximum(P - W, valid), min=0)
+    m = P - c0
+    j = torch.arange(W, device=dev)
+    ctx = (c0[:, None] + j[None, :]) % ring + (0 if base is None else base[:, None])
+    row = torch.where(j[None, :] < m[:, None], ctx, torch.full_like(j, -1)[None, :])
+    tok.view(S, n, W).copy_(row.to(I32)[:, None, :].expand(S, n, W))
+    cnt.view(S, n).copy_(m.to(I32)[:, None].expand(S, n))
+    lo.view(S, n).copy_(P.to(I32)[:, None].expand(S, n))
+    hi.view(S, n).copy_((P + n - 1).to(I32)[:, None].expand(S, n))
+    anc.copy_(A.to(I32))
+
+
+@dataclass
+class _Win:
+    index: int                      # the window's index in the round (``accept``'s outputs)
+    start: int
+    noise: list
+
+
+@dataclass
+class _Entry:
+    key: tuple
+    slots: tuple                    # the real slots, sorted (the key holds their padded count in row mode)
+    inp: object
+    wins: dict                      # slot -> _Win
+    gen: dict                       # slot -> generation at launch
+    valid: dict                     # slot -> drafter ring validity at launch
+    host: torch.Tensor              # int64 [3, Wn]: accepted, bonus, next start (pinned on CUDA)
+    acc: object = None              # the event after ``host``'s copy (None on the CPU)
+    staged: object = None           # the event after the inputs' H2D copies
+    result: tuple | None = None     # CPU: (drafts, conf) in the key's slot order
+    matched: dict = field(default_factory=dict)
+
+
+class Spec:
+    """One rank's speculation state over ``fw`` (``decode.DecodeForward`` with a drafter)."""
+
+    def __init__(self, fw) -> None:
+        self.fw, self.dr = fw, fw.drafter
+        self.entry: _Entry | None = None
+        self.gen: dict[int, int] = {}
+        self.rate: dict[int, float] = {}
+        self.skipped: dict[int, int] = {}
+        self.stats = collections.Counter()
+        self._pin: dict[str, torch.Tensor] = {}
+
+    # -- bookkeeping -----------------------------------------------------------------------------------------------
+    def forget(self, slot: int) -> None:
+        """The slot was reset (a new request, a restore): its speculation and rate start over."""
+
+        self.gen[slot] = self.gen.get(slot, 0) + 1
+        self.rate.pop(slot, None)
+        self.skipped.pop(slot, None)
+        e = self.entry
+        if e is not None and slot in e.wins:
+            self._drop(e, "reset")
+
+    def wanted(self, slot: int) -> bool:
+        if self.rate.get(slot, 1.0) >= MIN_RATE:
+            return True
+        n = self.skipped.get(slot, 0) + 1
+        self.skipped[slot] = n
+        if n >= PROBE:
+            self.skipped[slot] = 0
+            return True
+        return False
+
+    def _score(self, slots, hit: bool) -> None:
+        for s in slots:
+            self.rate[s] = DECAY * self.rate.get(s, 1.0) + (1.0 - DECAY) * float(hit)
+
+    def _drop(self, e: _Entry, why: str) -> None:
+        if e.staged is not None:
+            e.staged.synchronize()          # the inputs' pinned mirrors are free again (``DraftInputs.stage``)
+        self.stats[f"miss.{why}"] += 1
+        self._score(e.wins, False)
+        if self.entry is e:
+            self.entry = None
+
+    def clear(self) -> None:
+        """A window without speculation: an unused one is dropped."""
+
+        if self.entry is not None:
+            self._drop(self.entry, "unused")
+
+    def _pinned(self, name: str, values, dtype) -> torch.Tensor:
+        """``values`` on the device through a reused pinned buffer (non-blocking on CUDA)."""
+
+        dev = self.fw.device
+        t = torch.tensor(values, dtype=dtype)
+        if torch.device(dev).type != "cuda":
+            return t
+        buf = self._pin.get(name)
+        if buf is None or buf.numel() < t.numel():
+            buf = self._pin[name] = torch.empty((max(4096, t.numel()),), dtype=dtype, pin_memory=True)
+        h = buf[:t.numel()]
+        h.copy_(t)
+        return h.to(dev, non_blocking=True)
+
+    # -- launch (both ranks, inside ``window``) --------------------------------------------------------------------
+    def launch(self, windows, flags, fetch, zs=None) -> bool:
+        """``windows``: the round's ``Rows``; ``flags``: (DSpark round, keyed noise) a window; ``fetch``: the
+        candidates' handle (``SlotsForward.cand_fetch``: sorted device rows); ``zs``: top-p rows' normalizers
+        (``nucleus.Pre.zs``, G17). True when a pass was launched."""
+
+        if self.entry is not None:
+            self._drop(self.entry, "unused")
+        dr = self.dr
+        elig = [i for i, (dsp, _) in enumerate(flags) if dsp and self.wanted(windows[i].slot)]
+        if not elig:
+            return False
+        slots = tuple(sorted(int(windows[i].slot) for i in elig))
+        for s in slots:
+            dr._slot(s)
+        rowmode = bool(getattr(dr, "rowmode", False))
+        if rowmode:
+            from .draft_graphs import pad_slots
+
+            key = (pad_slots(len(slots)), dr.rows, dr.head.variant(slots))
+        else:
+            key = (slots, dr.rows, dr.head.variant(slots))
+        cuda = bool(dr.cuda)
+        if cuda:
+            g = dr.graphs
+            if g is None or not g.cache.on or key not in g.cache.graphs or dr.w1.shape[1] & (dr.w1.shape[1] - 1):
+                self.stats["skip.nograph"] += 1
+                return False
+        from .lookup import sampling_of
+
+        samplings = [sampling_of(n) if n else None for _, n in flags]
+        i64, f64 = VS.row_tables([(w.start, w.tokens) for w in windows], samplings)
+        R, Wn = len(i64[:-2 * len(windows)]) // 7, len(windows)
+        by_slot = {int(windows[i].slot): i for i in elig}
+        sel = [by_slot[s] for s in slots]
+        valid = [int(dr.valid[s]) for s in slots]
+        S = key[0] if isinstance(key[0], int) else len(slots)
+        base = [(slots[j] if j < len(slots) else slots[0]) * dr.ring if rowmode else 0 for j in range(S)]
+        d64 = self._pinned("i64", i64 + sel + valid + base, torch.int64)
+        df = self._pinned("f64", f64, torch.float64)
+        _, acc, bonus, nstart = VS.run(fetch.vals, fetch.ids, d64, df, R, Wn, zs)
+        out = torch.stack([acc, bonus, nstart])
+        e = _Entry(key, slots, None, {int(windows[i].slot): _Win(i, int(windows[i].start), list(flags[i][1] or []))
+                               for i in elig}, {s: self.gen.get(s, 0) for s in slots},
+                   {s: v for s, v in zip(slots, valid)}, out)
+        if cuda:
+            buf = self._pin.get("out")
+            if buf is None or buf.numel() < out.numel():
+                buf = self._pin["out"] = torch.empty((max(192, out.numel()),), dtype=torch.int64, pin_memory=True)
+            e.host = buf[:out.numel()].view(3, Wn)
+            e.host.copy_(out, non_blocking=True)
+            e.acc = torch.cuda.Event()
+            e.acc.record()
+        for i in elig:                      # every row's taps: the commit's ingest is then skipped on a match
+            w = windows[i]
+            p = self.fw.slots[w.slot].pending
+            dr.ingest(w.slot, w.start, p.taps)
+        k = len(i64) + len(sel)
+        seli = d64[len(i64):k]
+        P, A = nstart.index_select(0, seli), bonus.index_select(0, seli)
+        inp = dr.inputs(key)
+        e.inp = inp
+        kw = {"slots": slots} if hasattr(inp, "rowwin") else {}       # the slot-agnostic DraftInputs (G8)
+        inp.stage([int(windows[i].tokens[0]) for i in sel], [int(windows[i].start) + 1 for i in sel], valid,
+                  [samplings[i] for i in sel], dr.noise, dr.ring, **kw)
+        if cuda:
+            e.staged = torch.cuda.Event()
+            e.staged.record()
+        stage_device(inp, P, A, d64[k:k + len(slots)], dr.ring, d64[k + len(slots):k + len(slots) + S])
+        if cuda:
+            dr.graphs.run(inp, dr.pass_fn(inp, key[2]))
+        else:
+            e.result = self._cpu_pass(inp, key, P.tolist(), A.tolist(), [samplings[i] for i in sel])
+        self.entry = e
+        self.stats["launched"] += 1
+        return True
+
+    def _cpu_pass(self, inp, key, P, A, samplings):
+        from .drafter import chain_host
+
+        dr = self.dr
+        S, Nn, D, k = inp.S, inp.n, dr.cfg.hidden_size, len(P)
+        for s in range(S):
+            inp.wins[s].p0 = int(P[s if s < k else 0])
+        cand, cval, hid = dr._device_pass(inp, key[2])
+        if dr.keep_tree:                    # ``tree.py``: the pass's candidates and base logits
+            from .drafter import _keep
+
+            _keep(inp, cand, cval)
+        d, c = chain_host(cand.view(S, Nn, -1)[:k].cpu().numpy(), cval.view(S, Nn, -1)[:k].cpu().numpy(), dr.w1,
+                          dr.w2, A, samplings, [int(p) + 1 for p in P],
+                          hid.view(S, Nn, D)[:k].cpu() if dr.cw is not None else None,
+                          None if dr.cw is None else dr.cw.cpu())
+        return d.tolist(), c.tolist()
+
+    # -- consumers (both ranks, the next round) --------------------------------------------------------------------
+    def _host(self, e: _Entry):
+        if e.acc is not None:
+            e.acc.synchronize()
+            e.acc = None
+        return e.host
+
+    def ingested(self, slot: int, start: int, accepted: int) -> bool:
+        """At ``keep``: True when the speculation ingested this window and the device kept ``accepted`` drafts."""
+
+        e = self.entry
+        w = e.wins.get(slot) if e is not None else None
+        if w is None or w.start != int(start) or e.gen.get(slot) != self.gen.get(slot, 0):
+            return False
+        ok = int(self._host(e)[0, w.index]) == int(accepted)
+        e.matched[slot] = ok
+        if not ok:
+            self.stats["commit.differs"] += 1
+        return ok
+
+    def take(self, slots, anchors, starts, noises=None):
+        """At ``draft``: the speculated (drafts, confidences) in the caller's slot order, or None (run the pass)."""
+
+        e = self.entry
+        if e is None:
+            return None
+        self.entry = None
+        dr = self.dr
+        noises = noises or [None] * len(slots)
+        order = sorted(range(len(slots)), key=lambda i: int(slots[i]))
+        why = None
+        if tuple(int(slots[i]) for i in order) != e.slots:
+            why = "slots"
+        elif dr.head.variant(e.slots) != e.key[2]:
+            why = "variant"
+        else:
+            h = self._host(e)
+            for s, a, p, nz in zip(slots, anchors, starts, noises):
+                w = e.wins[int(s)]
+                if not e.matched.get(int(s)) or e.gen.get(int(s)) != self.gen.get(int(s), 0):
+                    why = "commit"
+                elif int(h[1, w.index]) != int(a) or int(h[2, w.index]) != int(p):
+                    why = "pending"
+                elif list(nz or []) != w.noise or int(dr.valid[int(s)]) != e.valid[int(s)]:
+                    why = "inputs"
+                if why:
+                    break
+        if why:
+            self._drop(e, why)
+            return None
+        if e.result is not None:
+            drafts, conf = e.result
+        else:
+            drafts, conf = e.inp.result(dr.cw is not None)
+        n = len(slots)
+        if dr.cw is None or conf is None:
+            conf = [[0.5] * e.inp.n for _ in range(n)]
+        back = [0] * n
+        for j, i in enumerate(order):
+            back[i] = j
+        drafts = [[int(t) for t in drafts[back[i]]] for i in range(n)]
+        conf = [[float(q) for q in conf[back[i]]] for i in range(n)]
+        dr.last_conf = conf
+        dr.tree_of(e.inp, back)             # ``tree.py``: the siblings come from this pass too
+        self._score(e.wins, True)
+        self.stats["hit"] += 1
+        return drafts, conf
+
+    def describe(self) -> str:
+        s = self.stats
+        miss = sum(v for k, v in s.items() if k.startswith("miss."))
+        detail = ", ".join(f"{k[5:]} {v}" for k, v in sorted(s.items()) if k.startswith("miss."))
+        return (f"speculative DSpark passes {s['launched']} launched, {s['hit']} used, {miss} dropped"
+                + (f" ({detail})" if detail else "") + f", {s['skip.nograph']} without a graph")
+
+
+__all__ = ["ENV", "Spec", "enabled", "stage_device"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/stack.py b/src/tensorfold/families/deepseek_v41/cuda/stack.py
new file mode 100644
index 0000000..230a40c
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/stack.py
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The serving stack of a V4.1 rank in one call (M1's ``Dsv41Engine.__init__`` uses it): the KV pool, the session
+store (RAM tier + NVMe tier), the grammar host, the memory floor and the batcher, sized from the engine's options and
+the ``TF_DSV41_*`` knobs, the same way on both ranks.
+
+    from .stack import build
+    self.batch, self.grammar_host = build(fwd, topo, rank=rank, link=link, model_dir=model_dir, eos=self.eos,
+                                          slots=parallel, context=self.limit, device=dev, image=code_digest)
+    # rank 0: generate() -> self.batch.generate_request(prompt, max_tokens, sampling, on_tokens, draft,
+    #                                                    request=self.request, host=self.grammar_host)
+    # rank 1: follow() -> self.batch.follow()
+
+Knobs: TF_DSV41_POOL_TOKENS (default slots x (context + 64), whole pages), TF_DSV41_INDEX_KV (bf16 | fp8),
+TF_DSV41_PREFILL (full | replay), TF_DSV41_SESSIONS (1; 0: no session store), TF_DSV41_SESSION_RAM_MIB (256: the RAM
+tier's bounded state; its pages live in the pool), TF_DSV41_SESSION_DISK / _GIB / _MIN (the NVMe tier),
+TF_DSV41_FLOOR_GIB / _HARD_GIB (5 / 4; both ranks: rank 1's usable memory reaches rank 0 over ``failfast``'s
+channel), the prefill price TF_DSV41_FLOOR_PRICE (1) / _PF_CHUNK_GIB (0.533) / _PF_INDEX_GIB (1.067 at a 256 MiB index
+budget) / _PF_HOST_GIB (0.6) / _PF_OTHER_GIB (0) / _PEER_STALE_S (10) / _REFUSE_S (30) (``memory.prefill_price``),
+TF_DSV41_FAILFAST (1), TF_DSV41_PREFILL_ROWS (2048), TF_DSV41_LONG_PROMPT / _PREFILL_CONCURRENT
+(32768 / 1: long prefills one at a time, ``batch.py``), TF_DSV41_DRAFT_DEPTH (3), TF_DSV41_PACK (mia29:
+the load-time budget's weights), TF_DSV41_GRAMMAR / _TOOL_GRAMMAR.
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Sequence
+from typing import Any
+
+from . import memory, sessdisk
+from . import pool as pool_mod
+from .batch import Batcher
+from .sessions import Store, Tag, compat_extra
+from .structured import Host
+
+# knobs that change what an NVMe entry's bytes mean
+DEFAULT_PREFILL = "replay"        # G4: CED replay by default; TF_DSV41_PREFILL=full for the full prefill
+BYTE_KNOBS = ("TF_DSV41_PREFILL", "TF_DSV41_INDEX_KV", "TF_DSV41_PREFILL_KERNELS", "TF_DSV41_FAST_EXPERTS",
+              "TF_DSV41_ROUTER", "TF_DSV41_PREFILL_ROUTER")    # split | one (the same bits) | fused / gemv (other bits)
+
+
+def mode_from_env() -> str:
+    mode = os.environ.get("TF_DSV41_PREFILL", DEFAULT_PREFILL).strip() or DEFAULT_PREFILL
+    if mode not in ("full", "replay"):
+        raise ValueError(f"TF_DSV41_PREFILL={mode!r}: expected full or replay")
+    return mode
+
+
+def build(fwd, topo, *, rank: int, link, model_dir, eos: Sequence[int], slots: int, context: int,
+          device: Any = "cuda", image: str = "", quiet: bool = False, start: bool = True) -> tuple[Batcher, Host]:
+    mode = mode_from_env()
+    index_kv = os.environ.get("TF_DSV41_INDEX_KV", "bf16").strip() or "bf16"
+    try:
+        memory.load_check(topo, os.environ.get("TF_DSV41_PACK", "mia29"), rank=rank, streams=slots, context=context,
+                          index_kv=index_kv,
+                          session_ram_gib=int(os.environ.get("TF_DSV41_SESSION_RAM_MIB", "256") or 256) / 1024)
+    except KeyError:
+        pass                                            # an unknown pack name: no budget to check against
+    from . import tree as TR
+
+    tokens = pool_mod.settings(slots, context) + TR.pool_tokens(slots, pool_mod.PAGE)  # + the tree's private pages
+    pool = pool_mod.Pool(topo, tokens, index_kv=index_kv, device=device)
+    from . import prefill_mm
+
+    grid = prefill_mm.tag_grid()                    # fast prefill kernels: their own tag, no turn snapshots
+    tag = Tag(prefill="fast" if grid else "exact", grid=grid, ced=mode, kv="fp8")
+    store = None
+    if (os.environ.get("TF_DSV41_SESSIONS", "1").strip() or "1") != "0":
+        ident = sessdisk.compat_ident(image=image, knobs={k: os.environ.get(k, "") for k in BYTE_KNOBS},
+                                      layout=compat_extra(tag, topo), extra={"page": pool.page, "world": int(getattr(fwd, "world", 1))})  # TP=2 / TP=4 bytes differ
+        disk = sessdisk.from_env(rank, ident)
+        store = Store(pool, ram_bytes=int(os.environ.get("TF_DSV41_SESSION_RAM_MIB", "256") or 256) << 20, disk=disk)
+    host = Host(model_dir, topo.vocab, eos, quiet=quiet or rank != 0)
+    floor = memory.Floor.from_env() if rank == 0 else None
+    batch = Batcher(fwd, pool, n_slots=slots, capacity=context + pool.slack, eos=eos, store=store, link=link,
+                    rank=rank, grammars=host.grammars, floor=floor, mode=mode, tag=tag.code(),
+                    start=start and rank == 0)
+    if not quiet and rank == 0:
+        print(f"[tensorfold] serving: {batch.describe()}; prefill {mode} {tag.prefill}; floor {floor.target_gib if floor else '-'}"
+              f" GiB", flush=True)
+    return batch, host
diff --git a/src/tensorfold/families/deepseek_v41/cuda/stall.py b/src/tensorfold/families/deepseek_v41/cuda/stall.py
new file mode 100644
index 0000000..7403be1
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/stall.py
@@ -0,0 +1,214 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A round stall watchdog on both ranks (G12, bug 2).
+
+G10's first diagnostic stress (``7d940f0``) hung 19 minutes: both GPUs at 92-96% utilization and 17-19 W (spinning),
+four requests in flight, nothing logged. What can wait like that without a word: an NCCL all-gather (every prefill
+exchange over ``GLM53_TF_ROCE_MAX_KB``; NCCL is called through ctypes with no async-error poll and no abort), a RoCE
+wait whose clock check is defeated, a host thread waiting on a flag, an event, a future or a socket. A round is
+seconds at most (a 2,048-row prefill segment ~1.3 s, a decode window ~30 ms; a cold first segment that builds an
+extension ~2 min), so a round that runs far longer is a stall, and the useful thing is to say where it is.
+
+``Watch`` (one a rank, armed by ``batch.Batcher``: rank 0 around ``step``'s plan / share / execute / sample, rank 1
+from a plan's arrival to the end of its execution -- its idle wait for the next plan is not a stall; the executor
+names its phases: admit, prefill, finals, window, ...): a daemon thread that, once a round has run
+``TF_DSV41_STALL_S`` seconds (300; 0 = off), prints one report to stderr and again every 4x that:
+
+- rank, round, phase, seconds in the round and in the phase, the round's plan (admits / pieces / windows), the busy
+  slots;
+- the forward's waits, each read without blocking: the CUDA stream's ``query()`` (False: the GPU is still in a
+  kernel -- a spinning collective or gate; True: the host is waiting on something else), the Engram gate (its
+  control words, worker alive, queue), the prefetcher's reads in flight, the RoCE runtime's ``snapshot()``, NCCL's
+  ``ncclCommGetAsyncError``;
+- every Python thread's stack (``faulthandler``).
+
+``TF_DSV41_STALL_EXIT_S`` (0 = never): after that long in one round the process exits (code 70) after the report,
+so ``serve.sh watch`` restarts both ranks instead of a silent hang that ``/health`` still answers. The peer rank sees
+its collective fail or its own watchdog fire.
+"""
+
+from __future__ import annotations
+
+import faulthandler
+import os
+import sys
+import threading
+import time
+
+
+def _env_float(name: str, default: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    v = float(raw) if raw else default
+    if v < 0:
+        raise ValueError(f"{name}={v}: expected >= 0")
+    return v
+
+
+class Watch:
+    """``begin(round)`` / ``phase(name)`` / ``end()`` from the round thread (plain attribute stores); a daemon thread
+    reports a round past ``limit_s`` and exits the process past ``exit_s``."""
+
+    def __init__(self, rank: int, *, limit_s: float | None = None, exit_s: float | None = None, info=None, out=None,
+                 exit_fn=None, poll_s: float = 1.0) -> None:
+        self.rank = int(rank)
+        self.limit_s = _env_float("TF_DSV41_STALL_S", 300.0) if limit_s is None else float(limit_s)
+        self.exit_s = _env_float("TF_DSV41_STALL_EXIT_S", 0.0) if exit_s is None else float(exit_s)
+        self.info = info                        # () -> list[str]: what the batcher / forward can say
+        self.out = out
+        self.exit_fn = exit_fn or os._exit
+        self.poll_s = float(poll_s)
+        self.round = -1
+        self.name = "idle"
+        self.t_round = self.t_phase = 0.0
+        self.armed = False
+        self.reports = 0
+        self._next = 0.0                        # monotonic time of the next report of this round
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+
+    @property
+    def on(self) -> bool:
+        return self.limit_s > 0 or self.exit_s > 0
+
+    # -- the round thread ---------------------------------------------------------------------------------------------
+    def begin(self, round_no: int, name: str = "round") -> None:
+        if not self.on:
+            return
+        now = time.monotonic()
+        self.round, self.name, self.t_round, self.t_phase = int(round_no), name, now, now
+        self._next = now + (self.limit_s if self.limit_s > 0 else float("inf"))
+        self.armed = True
+        if self._thread is None:
+            self._thread = threading.Thread(target=self._loop, name=f"dsv41-stall-r{self.rank}", daemon=True)
+            self._thread.start()
+
+    def phase(self, name: str) -> None:
+        if self.armed:
+            self.name, self.t_phase = name, time.monotonic()
+
+    def end(self) -> None:
+        self.armed = False
+        self.name = "idle"
+
+    def close(self) -> None:
+        self._stop.set()
+        if self._thread is not None:
+            self._thread.join(timeout=5)
+
+    # -- the watchdog thread ----------------------------------------------------------------------------------------
+    def _loop(self) -> None:
+        while not self._stop.wait(self.poll_s):
+            self.tick()
+
+    def tick(self, now: float | None = None) -> bool:
+        """One look (the thread's; tests call it): True when it reported."""
+
+        if not self.armed:
+            return False
+        now = time.monotonic() if now is None else now
+        rnd, t_round = self.round, self.t_round
+        late = now - t_round
+        reported = False
+        if now >= self._next:
+            self._next = now + 4 * (self.limit_s if self.limit_s > 0 else self.exit_s)
+            self.report(now)
+            reported = True
+        if self.exit_s > 0 and late >= self.exit_s and self.armed and self.round == rnd:
+            if not reported:
+                self.report(now)
+            self._print(f"[dsv41 stall] r{self.rank}: round {rnd} ran {late:.0f} s >= TF_DSV41_STALL_EXIT_S="
+                        f"{self.exit_s:g}: exiting (70) so the watchdog restarts both ranks")
+            self.exit_fn(70)
+            return True
+        return reported
+
+    def _print(self, msg: str) -> None:
+        print(msg, file=self.out or sys.stderr, flush=True)
+
+    def report(self, now: float | None = None) -> str:
+        now = time.monotonic() if now is None else now
+        self.reports += 1
+        lines = [f"[dsv41 stall] r{self.rank}: round {self.round} has run {now - self.t_round:.1f} s (phase "
+                 f"{self.name!r} for {now - self.t_phase:.1f} s; TF_DSV41_STALL_S={self.limit_s:g})"]
+        if self.info is not None:
+            try:
+                lines += [f"  {x}" for x in self.info()]
+            except Exception as exc:            # noqa: BLE001  (a report must not raise)
+                lines.append(f"  (state not readable: {exc!r})")
+        text = "\n".join(lines)
+        self._print(text)
+        out = self.out or sys.stderr
+        try:
+            faulthandler.dump_traceback(file=out, all_threads=True)
+        except (ValueError, OSError, AttributeError):   # a stream without a file descriptor (tests): Python's view
+            import traceback
+
+            for tid, frame in sys._current_frames().items():
+                print(f"Thread {tid:#x}:\n" + "".join(traceback.format_stack(frame)), file=out, flush=True)
+        return text
+
+
+# -- what the forward can say without blocking ------------------------------------------------------------------------
+def forward_info(fw) -> list[str]:
+    out = []
+    try:
+        import torch
+
+        dev = getattr(fw, "device", None)
+        if dev is not None and getattr(dev, "type", "") == "cuda" and torch.cuda.is_initialized():
+            done = torch.cuda.current_stream(dev).query()
+            why = "the host waits on something else" if done else "a kernel still runs: a spinning wait?"
+            out.append(f"cuda stream idle: {done} ({why})")
+    except Exception as exc:                    # noqa: BLE001
+        out.append(f"cuda stream: {exc!r}")
+    gate = getattr(fw, "gate", None)
+    if gate is not None:
+        try:
+            ctl = [int(v) for v in gate.ctl[:8].tolist()]
+            th = getattr(gate, "thread", None)
+            out.append(f"Engram gate: ctl {ctl}, seq {getattr(gate, 'seq', '?')}, worker "
+                       f"{'alive' if th is not None and th.is_alive() else 'DEAD'}, queue {gate.q.qsize()}")
+        except Exception as exc:                # noqa: BLE001
+            out.append(f"Engram gate: {exc!r}")
+    pf = getattr(fw, "prefetcher", None)
+    if pf is not None:
+        try:
+            busy = sum(1 for f in pf.bulk.values() if not f.done())
+            out.append(f"Engram prefetch: {len(pf.bulk)} bulk reads held ({busy} running), stats {pf.stats}")
+        except Exception as exc:                # noqa: BLE001
+            out.append(f"Engram prefetch: {exc!r}")
+    comm = getattr(fw, "comm", None)
+    rt = getattr(comm, "rt", None) if comm is not None else None
+    if rt is not None and hasattr(rt, "snapshot"):
+        try:
+            snap = rt.snapshot()
+            snap.pop("flags", None)
+            out.append(f"RoCE: {snap}")
+        except Exception as exc:                # noqa: BLE001
+            out.append(f"RoCE: {exc!r}")
+    if comm is not None:
+        out.append(f"NCCL async error: {nccl_async_error(comm)}")
+    return out
+
+
+def nccl_async_error(comm) -> str:
+    """``ncclCommGetAsyncError`` of the communicator (thread-safe, made to be polled): 0 = ncclSuccess, 7 =
+    ncclInProgress; anything else names a failed transport."""
+
+    try:
+        import ctypes
+
+        lib, handle = getattr(comm, "lib", None), getattr(comm, "comm", None)
+        if lib is None or handle is None:
+            return "n/a"
+        fn = lib.ncclCommGetAsyncError
+        fn.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+        err = ctypes.c_int(-1)
+        rc = fn(handle, ctypes.byref(err))
+        name = lib.ncclGetErrorString(err.value) if err.value > 0 else b"ok"
+        return f"{err.value} ({name.decode() if isinstance(name, bytes) else name}; call rc {rc})"
+    except Exception as exc:                    # noqa: BLE001
+        return f"? ({exc!r})"
+
+
+__all__ = ["Watch", "forward_info", "nccl_async_error"]
