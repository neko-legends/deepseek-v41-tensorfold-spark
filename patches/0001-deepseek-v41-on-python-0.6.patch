+"""The DSpark pass's vocabulary head (``TF_DSV41_DRAFT_HEAD``): which logits the drafter's candidates come from.
+
+Verification is exact (``dspark.accept``): the drafts never change a reply, so the drafter's head may be any function
+of the pass's hidden rows. A different head only moves acceptance. Options (per rank, 1-20 rows a pass):
+
+- ``full`` (default): the target's EXL3 6-bit head, 64,640 x 5,120 a rank: 248 MB, ~1.1 ms at 220 GB/s;
+- ``q4``: a 4-bit copy of the same head, built at load: symmetric int4, one fp16 scale per 128 inputs of a row
+  (170.7 MB a rank: ~0.78 ms). Every token can still be drafted; only the logits' rounding moves;
+- ``trim[:M]``: the 4-bit copy of M listed rows a rank only (default M = 24,576: 64.9 MB, ~0.30 ms). The list
+  (``TF_DSV41_DRAFT_VOCAB``: a ranking file; none is shipped, ``draft_vocab.txt`` next to this module if present) is
+  each rank's first M ids of its half in the ranking, then the half's lowest unlisted ids, rounded up to 64 (GLM
+  patches/0420's rule; on the development ranking, held out, 24,576 a rank listed 99.8% of DeepSeek reply tokens and
+  99.2% of 4-token runs). The listed ids are ascending, so a column's order is its id's order (``candidates``'
+  (value desc, id asc) rule holds) and the candidates map columns to ids with one gather before the exchange.
+  **Fallback** (``TF_DSV41_DRAFT_VOCAB_FALLBACK`` = RATE,WINDOW, default 0.03,256; ``off``): a slot whose last WINDOW
+  committed tokens (prompt included) hold more than RATE unlisted ones (CJK text, rare scripts) drafts over the full
+  EXL3 head; a pass serves all its slots, so it is full when any slot's rule says so. The rule reads committed ids,
+  which both ranks hold alike, and both ranks' lists (computed from the same file), so both ranks decide alike.
+
+The 4-bit copy is read from the target's head itself (``probe``: the head applied to identity rows, one 128-input
+group at a time), so it needs neither the checkpoint's trellis format nor a float64 decode. Layout: packed uint8
+[n, K / 2], a byte holding inputs b G + j (low nibble) and b G + G / 2 + j (high nibble) of the 2-group block b (G =
+the group, 128 for K % 256 == 0); scales fp16 [n, K / G]. The GEMV (``_q4``) multiplies bf16 rows by the int4 codes
+(exact in bf16) with fp32 sums and applies each group's scale to its partial: one launch, row blocks of 16 or 32.
+
+Knobs: TF_DSV41_DRAFT_HEAD (full | q4 | trim | trim:M), TF_DSV41_DRAFT_VOCAB (ranking path), TF_DSV41_DRAFT_VOCAB_FALLBACK
+(0.03,256 | off), TF_DSV41_DRAFT_Q4_BN (64: output rows a program). All enter the calibration key (``calib.KNOBS``).
+"""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import os
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+import torch
+
+MODES = ("full", "q4", "trim")
+TRIM_ROWS = 24576
+FALLBACK = (0.03, 256)
+LIST = Path(__file__).with_name("draft_vocab.txt")
+F32, F16, BF16 = torch.float32, torch.float16, torch.bfloat16
+
+
+@dataclass(frozen=True)
+class Settings:
+    mode: str = "full"
+    rows: int = TRIM_ROWS                 # trim: listed ids a rank
+    vocab: str = ""                       # the ranking file ("" = the shipped one)
+    fb_rate: float | None = FALLBACK[0]   # None: no fallback
+    fb_window: int = FALLBACK[1]
+
+
+def settings(env=None) -> Settings:
+    env = os.environ if env is None else env
+    raw = (env.get("TF_DSV41_DRAFT_HEAD", "") or "full").strip().lower()
+    mode, _, n = raw.partition(":")
+    if mode not in MODES or (n and mode != "trim"):
+        raise ValueError(f"TF_DSV41_DRAFT_HEAD={raw!r}: expected full, q4, trim or trim:ROWS")
+    rows = int(n) if n else TRIM_ROWS
+    if rows < 64:
+        raise ValueError(f"TF_DSV41_DRAFT_HEAD={raw!r}: at least 64 listed ids a rank")
+    fb = (env.get("TF_DSV41_DRAFT_VOCAB_FALLBACK", "") or "").strip().lower()
+    rate, window = FALLBACK
+    if fb in ("off", "0", "none"):
+        rate = None
+    elif fb:
+        a, _, b = fb.partition(",")
+        rate, window = float(a), int(b or FALLBACK[1])
+        if not 0.0 <= rate < 1.0 or window < 1:
+            raise ValueError(f"TF_DSV41_DRAFT_VOCAB_FALLBACK={fb!r}: expected RATE,WINDOW (0 <= RATE < 1) or off")
+    return Settings(mode, rows, (env.get("TF_DSV41_DRAFT_VOCAB", "") or "").strip(), rate, window)
+
+
+def ranking(path: str | Path = "") -> list[int]:
+    """A ranking file's ids (whitespace separated, ``#`` comments), most frequent first, duplicates dropped."""
+
+    seen, out = set(), []
+    for line in Path(path or LIST).read_text().splitlines():
+        for w in line.split("#", 1)[0].split():
+            i = int(w)
+            if i not in seen:
+                seen.add(i)
+                out.append(i)
+    return out
+
+
+def per_rank(order, lo: int, hi: int, m: int) -> np.ndarray:
+    """A rank's listed ids (its half lo .. hi - 1): the first ``m`` (rounded up to 64, at most the half) of the half in
+    ``order``, then the half's lowest unlisted ids; ascending int64."""
+
+    m = min(-(-m // 64) * 64, hi - lo)
+    mine = [i for i in order if lo <= i < hi][:m]
+    taken, j = set(mine), lo
+    while len(mine) < m:
+        if j not in taken:
+            mine.append(j)
+        j += 1
+    return np.array(sorted(mine), dtype=np.int64)
+
+
+def group_of(k: int) -> int:
+    for g in (128, 64, 32, 16):
+        if k % (2 * g) == 0:
+            return g
+    raise ValueError(f"draft head: {k} inputs is not a multiple of 32")
+
+
+# -- the 4-bit copy -------------------------------------------------------------------------------------------------
+def probe(lin, k: int, cols: torch.Tensor | None, device, group: int):
+    """``lin`` (x [M, k] -> [M, n], ``lin(x, dtype)``) as int4 codes: (packed uint8 [n', k / 2], scales fp16
+    [n', k / group]) of its columns ``cols`` (all when None), read one group of identity rows at a time."""
+
+    packed = scales = None
+    for g in range(k // group):
+        eye = torch.zeros((group, k), dtype=BF16, device=device)
+        eye[:, g * group:(g + 1) * group] = torch.eye(group, dtype=BF16, device=device)
+        w = lin(eye, F32)
+        w = (w[:, cols] if cols is not None else w).t().float()                   # [n', group]: W[n, k]
+        s = (w.abs().amax(1) / 7.0).clamp_min(1e-12)
+        s16 = s.to(F16).clamp_min(torch.finfo(F16).tiny)
+        q = (torch.round(w / s16.float()[:, None]).clamp(-7, 7) + 8).to(torch.uint8)
+        if packed is None:
+            packed = torch.zeros((w.shape[0], k // 2), dtype=torch.uint8, device=device)
+            scales = torch.empty((w.shape[0], k // group), dtype=F16, device=device)
+        b = g // 2
+        dst = packed[:, b * group:(b + 1) * group]
+        dst |= q if g % 2 == 0 else (q << 4)
+        scales[:, g] = s16
+    return packed, scales
+
+
+def dequant(packed: torch.Tensor, scales: torch.Tensor, group: int) -> torch.Tensor:
+    """fp32 W [n, k] of a packed copy (the torch path and the tests' reference)."""
+
+    n, kh = packed.shape
+    lo = (packed & 15).to(torch.int32) - 8
+    hi = (packed >> 4).to(torch.int32) - 8
+    blocks = kh // group
+    w = torch.stack([lo.view(n, blocks, group), hi.view(n, blocks, group)], 2).reshape(n, 2 * kh).float()
+    return w * scales.float().repeat_interleave(group, 1)
+
+
+_KERNEL = None
+
+
+def _kernel():
+    global _KERNEL
+    if _KERNEL is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit
+        def _q4(X, W, S, OUT, M, N, x_stride, o_stride, KH: tl.constexpr, NG: tl.constexpr, G: tl.constexpr,
+                BM: tl.constexpr, BN: tl.constexpr):
+            n = tl.program_id(0) * BN + tl.arange(0, BN)
+            m = tl.program_id(1) * BM + tl.arange(0, BM)
+            nm, mm = n < N, m < M
+            n64 = n.to(tl.int64)
+            j = tl.arange(0, G)
+            acc = tl.zeros((BM, BN), tl.float32)
+            for b in range(NG // 2):
+                w = tl.load(W + n64[:, None] * KH + b * G + j[None, :], mask=nm[:, None], other=136).to(tl.int32)
+                lo = ((w & 15) - 8).to(tl.float32).to(tl.bfloat16)        # -7 .. 7: exact in bf16
+                hi = ((w >> 4) - 8).to(tl.float32).to(tl.bfloat16)
+                xl = tl.load(X + m[:, None] * x_stride + 2 * b * G + j[None, :], mask=mm[:, None], other=0.0)
+                xh = tl.load(X + m[:, None] * x_stride + (2 * b + 1) * G + j[None, :], mask=mm[:, None], other=0.0)
+                sl = tl.load(S + n64 * NG + 2 * b, mask=nm, other=0.0).to(tl.float32)
+                sh = tl.load(S + n64 * NG + 2 * b + 1, mask=nm, other=0.0).to(tl.float32)
+                acc += tl.dot(xl, tl.trans(lo)) * sl[None, :] + tl.dot(xh, tl.trans(hi)) * sh[None, :]
+            tl.store(OUT + m[:, None] * o_stride + n[None, :], acc, mask=mm[:, None] & nm[None, :])
+
+        _KERNEL = (_q4, triton)
+    return _KERNEL
+
+
+def q4_matmul(x: torch.Tensor, packed: torch.Tensor, scales: torch.Tensor, group: int,
+              out: torch.Tensor | None = None, kernel: bool | None = None) -> torch.Tensor:
+    """fp32 [M, n] = bf16(x) [M, k] @ dequant(packed, scales).T: one Triton launch on CUDA (``kernel``: force it,
+    the interpreter tests), else torch."""
+
+    M, n = x.shape[0], packed.shape[0]
+    if not (x.is_cuda if kernel is None else kernel):
+        return x.to(BF16).float() @ dequant(packed, scales, group).t()
+    kern, triton = _kernel()
+    x = x.to(BF16).contiguous()
+    out = torch.empty((M, n), dtype=F32, device=x.device) if out is None else out
+    bm = 16 if M <= 16 else 32
+    bn = int(os.environ.get("TF_DSV41_DRAFT_Q4_BN", "") or 64)
+    kern[(triton.cdiv(n, bn), triton.cdiv(M, bm))](x, packed, scales, out, M, n, x.stride(0), out.stride(0),
+                                                    KH=packed.shape[1], NG=scales.shape[1], G=group, BM=bm, BN=bn,
+                                                    num_warps=4)
+    return out
+
+
+# -- the fallback rule --------------------------------------------------------------------------------------------
+class Tracker:
+    """Per slot: the last ``window`` committed tokens' listed flags; ``full(slot)``: more than ``rate`` unlisted."""
+
+    def __init__(self, listed: np.ndarray, rate: float | None, window: int) -> None:
+        self.listed, self.rate, self.window = listed, rate, window
+        self.q: dict[int, collections.deque] = {}
+        self.misses: dict[int, int] = {}
+
+    def reset(self, slot: int) -> None:
+        self.q.pop(slot, None)
+        self.misses.pop(slot, None)
+
+    def feed(self, slot: int, ids) -> None:
+        if self.rate is None:
+            return
+        a = np.asarray(list(ids)[-self.window:], dtype=np.int64)
+        if not a.size:
+            return
+        ok = self.listed[np.clip(a, 0, len(self.listed) - 1)] & (a >= 0) & (a < len(self.listed))
+        q = self.q.setdefault(slot, collections.deque())
+        miss = self.misses.get(slot, 0)
+        for f in ok.tolist():
+            q.append(f)
+            miss += not f
+            if len(q) > self.window:
+                miss -= not q.popleft()
+        self.misses[slot] = miss
+
+    def full(self, slot: int) -> bool:
+        if self.rate is None or slot not in self.q:
+            return False
+        return self.misses[slot] > self.rate * len(self.q[slot])
+
+
+# -- the head a pass reads ----------------------------------------------------------------------------------------
+class DraftHead:
+    """``logits(x, full)`` -> (fp32 [R, n] logits, column -> id map (int32 device [n]) or None, id0)."""
+
+    def __init__(self, fw, st: Settings | None = None) -> None:
+        st = settings() if st is None else st
+        self.st, self.fw = st, fw
+        self.mode = st.mode
+        self.packed = self.scales = self.ids = self._deq = None
+        self.tracker = None
+        self.digest = ""
+        if self.mode == "full":
+            return
+        head = fw.head
+        k, n = int(head.k), int(head.n)
+        self.group = group_of(k)
+        world, V = fw.world, int(fw.cfg.vocab_size)
+        cols = None
+        if self.mode == "trim":
+            order = [i for i in ranking(st.vocab) if 0 <= i < V]
+            self.digest = hashlib.sha256(np.asarray(order, dtype=np.int64).tobytes()).hexdigest()[:12]
+            from .weights import block_bounds
+
+            spans = [block_bounds(V, world, r) for r in range(world)]     # the head's 128-block column slices
+            if spans[fw.rank] != (fw.vocab_lo, fw.vocab_lo + n):
+                raise ValueError(f"draft head: rank {fw.rank}'s columns are {fw.vocab_lo} .. {fw.vocab_lo + n - 1}, "
+                                 f"the vocabulary split says {spans[fw.rank][0]} .. {spans[fw.rank][1] - 1}")
+            lists = [per_rank(order, lo, hi, st.rows) for lo, hi in spans]
+            if len({len(x) for x in lists}) != 1:     # every rank sends the same candidates a row (one gather)
+                raise ValueError(f"draft head: TF_DSV41_DRAFT_HEAD rows {st.rows} exceed the narrowest rank's "
+                                 f"{min(hi - lo for lo, hi in spans)} columns")
+            mine = lists[fw.rank]
+            listed = np.zeros((V,), dtype=bool)
+            for x in lists:
+                listed[x] = True
+            self.tracker = Tracker(listed, st.fb_rate, st.fb_window)
+            self.ids = torch.from_numpy(mine).to(torch.int32).to(fw.device)
+            cols = torch.from_numpy(mine - fw.vocab_lo).to(fw.device)
+        self.packed, self.scales = probe(head, k, cols, fw.device, self.group)
+        if not self.packed.is_cuda:
+            self._deq = dequant(self.packed, self.scales, self.group)
+
+    @property
+    def trimmed(self) -> bool:
+        return self.mode == "trim"
+
+    def nbytes(self) -> int:
+        return 0 if self.packed is None else self.packed.numel() + 2 * self.scales.numel()
+
+    def variants(self) -> list[str]:
+        """The pass variants this head can run (graph keys)."""
+
+        if self.mode == "trim" and self.st.fb_rate is not None:
+            return ["trim", "full"]
+        return [self.mode]
+
+    def variant(self, slots) -> str:
+        if self.mode == "trim" and any(self.tracker.full(s) for s in slots):
+            return "full"
+        return self.mode
+
+    def observe(self, slot: int, ids) -> None:
+        if self.tracker is not None:
+            self.tracker.feed(slot, ids)
+
+    def reset(self, slot: int) -> None:
+        if self.tracker is not None:
+            self.tracker.reset(slot)
+
+    def logits(self, x: torch.Tensor, variant: str):
+        from . import numerics as N
+
+        fw = self.fw
+        if variant == "full" or self.packed is None:
+            return fw.head(x, N.ACC), None, fw.vocab_lo
+        if self._deq is not None:
+            y = x.to(BF16).float() @ self._deq.t()
+        else:
+            y = q4_matmul(x, self.packed, self.scales, self.group)
+        return (y, self.ids, 0) if self.mode == "trim" else (y, None, fw.vocab_lo)
+
+    def describe(self) -> str:
+        if self.mode == "full":
+            return "draft head full"
+        fb = "off" if self.st.fb_rate is None else f"{self.st.fb_rate},{self.st.fb_window}"
+        what = f"trim {self.packed.shape[0]} ids a rank (list {self.digest}, fallback {fb})" if self.trimmed else "q4"
+        return f"draft head {what}, {self.nbytes() / 2 ** 20:.1f} MB a rank"
+
+
+__all__ = ["DraftHead", "Settings", "Tracker", "dequant", "group_of", "per_rank", "probe", "q4_matmul", "ranking",
+           "settings"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/draftcap.py b/src/tensorfold/families/deepseek_v41/cuda/draftcap.py
new file mode 100644
index 0000000..774fc79
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/draftcap.py
@@ -0,0 +1,170 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Drafting-log capture on the real checkpoint, both ranks (``python -m ...cuda.draftcap`` on each; rank 1 follows
+rank 0's round plans), for ``draftsim`` / ``treesim`` / ``drafttrain``: rank 0 decodes a prompt set with DSpark on
+while ``TF_DSV41_DRAFT_LOG`` (and ``_HID`` for training features) records every pass.
+
+Prompts: ``--prompts FILE`` (JSON lines: {"msg": ..., "max": 384, "t": 0.0}) or the built-in set: prose in several
+forms over varied topics (the low-acceptance text this work targets), chat answers, and some code, as user turns with
+thinking off. ``--streams`` requests run at once (more passes a minute; each slot's passes are separate sessions in
+the log); every ``--hot``-th request samples at T = 0.7 (keyed: the log scores it against the keyed samples).
+
+Output: the log directory (``TF_DSV41_DRAFT_LOG``) and ``--out`` JSON (per request: tokens, tok/s, drafting stats).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import threading
+import time
+from pathlib import Path
+
+TOPICS = ["lighthouses and their keepers", "the history of tea in Britain", "how glaciers shape valleys",
+          "the invention of the printing press", "life in a medieval monastery", "why bees dance",
+          "the first transatlantic telegraph cable", "urban gardens in dense cities", "the science of sourdough",
+          "the Silk Road's trading towns", "how vaccines train the immune system", "the decline of night skies",
+          "the economics of a small bakery", "learning a second language as an adult", "the ethics of zoos",
+          "deep-sea hydrothermal vents", "the craft of bookbinding", "the rise and fall of the telegraph",
+          "how rivers change course", "the psychology of habits", "Roman roads and their engineering",
+          "the migration of monarch butterflies", "jazz in 1920s New Orleans", "the restoration of old paintings",
+          "the challenges of desert agriculture", "why cities flood", "the history of the bicycle",
+          "volcanic islands and new soil", "the life of a lighthouse lens maker", "public libraries in small towns",
+          "the long voyage of the Endurance", "how bridges carry load", "the culture of night markets",
+          "coral reefs under warming seas", "the slow food movement", "the history of maps",
+          "train travel across Siberia", "what owls hear at night", "the making of a violin", "the first airmail"]
+FORMS = ["Write a 350-word essay on {t}. Plain prose, no lists or headings.",
+         "Explain {t} to a curious friend in a few warm, conversational paragraphs.",
+         "Write a short story (about 300 words) set against the background of {t}.",
+         "Write a thoughtful letter to a younger relative about {t}, around 300 words."]
+CHAT = ["What are the trade-offs between renting and buying a home? Answer in prose.",
+        "How should I prepare for a job interview at a small company? Give advice in paragraphs.",
+        "Why do some people find it hard to fall asleep, and what helps?",
+        "Summarize the causes of the First World War for a high-school student.",
+        "What makes a good teacher? Discuss in a few paragraphs.",
+        "Compare living in a big city with living in the countryside."]
+TOOLS = ["You can call tools by answering with JSON {\"tool\": name, \"arguments\": {...}}. Tools: get_weather(city), "
+         "search_flights(origin, destination, date), create_event(title, start, duration_min). The user says: {t}"]
+TOOL_ASKS = ["what's the weather like in Hanoi and should I bring an umbrella?",
+             "book me something from Bangkok to Tokyo next Friday, then put the trip in my calendar",
+             "schedule a 45 minute review of the quarterly numbers tomorrow at 10",
+             "compare the weather in Oslo and Lisbon this weekend and suggest where to go",
+             "find flights from Berlin to Rome on 2026-11-02 and summarize the options"]
+CODE = ["Write a Python function that merges overlapping intervals, with a docstring and two tests.",
+        "Write a small Rust program that counts word frequencies from stdin and prints the top ten.",
+        "Write a JavaScript debounce function with comments and an example.",
+        "Write a SQL schema for a library (books, members, loans) and three example queries."]
+
+
+def builtin() -> list[dict]:
+    out = [{"msg": f.format(t=t), "max": 384} for t in TOPICS for f in FORMS]
+    out += [{"msg": m, "max": 384} for m in CHAT]
+    out += [{"msg": m, "max": 512} for m in CODE]
+    out += [{"msg": TOOLS[0].replace("{t}", q), "max": 256} for q in TOOL_ASKS]
+    return out
+
+
+def load_prompts(path: str) -> list[dict]:
+    if not path:
+        return builtin()
+    return [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
+
+
+def run_rank0(eng, a) -> dict:
+    from tokenizers import Tokenizer
+
+    from tensorfold.engine.exact_sampling import Sampling
+
+    from .batch import Job
+    from .encoding import encode
+    from .m2bench import Clock
+
+    tok = Tokenizer.from_file(str(Path(a.model) / "tokenizer.json"))
+    prompts = load_prompts(a.prompts)[a.skip:a.skip + a.count if a.count else None]
+    prompts = [dict(p, max=a.max or p.get("max", 384), t=(0.7 if r else p.get("t", 0.0)))   # repeats sample: new text
+               for r in range(max(1, a.repeat)) for p in prompts]
+    b = eng.batch
+    hot = Sampling(seed=4321, temperature=0.7, top_k=0, top_p=0.95)
+    rep = {"knobs": {k: v for k, v in sorted(os.environ.items()) if k.startswith("TF_DSV41_")}, "requests": []}
+    t0 = time.perf_counter()
+    for at in range(0, len(prompts), a.streams):
+        if a.minutes and time.perf_counter() - t0 > a.minutes * 60:
+            print(f"[draftcap] time box: {at} of {len(prompts)} requests", flush=True)
+            break
+        group = prompts[at:at + a.streams]
+        jobs, clocks, ths = [], [], []
+        for j, pr in enumerate(group):
+            ids = list(tok.encode(encode([{"role": "user", "content": pr["msg"]}], thinking=False),
+                                  add_special_tokens=False).ids)
+            n = (at + j)
+            smp = None
+            if (a.hot and n % a.hot == a.hot - 1) or float(pr.get("t", 0.0)) > 0:
+                smp = Sampling(seed=int(hot.seed) + n, temperature=hot.temperature, top_k=0, top_p=hot.top_p)
+            jobs.append(b.submit(Job(ids, int(pr.get("max", 384)), smp)))
+            c = Clock()
+            clocks.append(c)
+            th = threading.Thread(target=b.collect, args=(jobs[-1], c))
+            th.start()
+            ths.append(th)
+        for th in ths:
+            th.join()
+        for pr, jb, c in zip(group, jobs, clocks):
+            rep["requests"].append({"msg": pr["msg"][:80], "tokens": len(c.toks), "tok_s": c.tok_s(),
+                                    "drafting": jb.stats.get("drafting")})
+        print(f"[draftcap] {min(at + a.streams, len(prompts))}/{len(prompts)} requests, "
+              f"{time.perf_counter() - t0:.0f} s", flush=True)
+    dl = getattr(eng.fw, "dlog", None)
+    if dl is not None:
+        dl.flush()
+    rep["wall_s"] = round(time.perf_counter() - t0, 1)
+    rep["m2_after"] = eng.fw.describe() if hasattr(eng.fw, "describe") else ""
+    return rep
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--out", default="draftcap.json")
+    ap.add_argument("--context", type=int, default=16384)
+    ap.add_argument("--parallel", type=int, default=4)
+    ap.add_argument("--streams", type=int, default=4)
+    ap.add_argument("--hot", type=int, default=4, help="every n-th request at T = 0.7 (0: all greedy)")
+    ap.add_argument("--prompts", default="")
+    ap.add_argument("--skip", type=int, default=0)
+    ap.add_argument("--count", type=int, default=0)
+    ap.add_argument("--max", type=int, default=0, help="max tokens for every request (0: the prompt's)")
+    ap.add_argument("--repeat", type=int, default=1, help="the prompt set this many times (new seeds at T > 0)")
+    ap.add_argument("--world", type=int, default=2, help="ranks (2, or 4 on four Sparks)")
+    ap.add_argument("--minutes", type=float, default=0.0, help="stop launching requests after this long")
+    a = ap.parse_args(argv)
+    if a.rank == 0 and not os.environ.get("TF_DSV41_DRAFT_LOG"):
+        print("[draftcap] TF_DSV41_DRAFT_LOG is not set: nothing would be logged", file=sys.stderr)
+        return 2
+    from .engine import Dsv41Engine
+
+    eng = Dsv41Engine(Path(a.model), rank=a.rank, master=a.master, port=a.port, context=a.context,
+                      parallel=a.parallel, serving=True, world=a.world)
+    if a.rank != 0:
+        eng.follow()
+        return 0
+    rc = 0
+    try:
+        rep = run_rank0(eng, a)
+        Path(a.out).write_text(json.dumps(rep, indent=1))
+        print(f"[draftcap] report {a.out}: {len(rep['requests'])} requests in {rep['wall_s']} s", flush=True)
+    except Exception as exc:          # noqa: BLE001 - rank 1 must still be told to stop
+        print(f"[draftcap] failed: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
+        rc = 1
+    finally:
+        eng.batch.stop()
+        eng.batch.send_stop()
+    return rc
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tensorfold/families/deepseek_v41/cuda/drafter.py b/src/tensorfold/families/deepseek_v41/cuda/drafter.py
