+# -- memory.Adapt -------------------------------------------------------------------------------------------------------
+def test_adapt_steps_and_choice(monkeypatch):
+    for k in ("TF_DSV41_PREFILL_ADAPT", "TF_DSV41_PREFILL_ADAPT_GIB", "TF_DSV41_PREFILL_ADAPT_MIN",
+              "TF_DSV41_FLOOR_GIB", "TF_DSV41_INDEX_BUDGET_MIB", "TF_DSV41_PREFILL_ROWS"):
+        monkeypatch.delenv(k, raising=False)
+    a = M.Adapt.from_env()
+    assert a.on and a.gib == 5.0 and a.min_rows == 512 and a.release
+    assert a.steps(2048) == [2048, 1024, 512] and a.steps(1024) == [1024, 512] and a.steps(512) == [512]
+    assert M.Adapt(min_rows=1024).steps(2048) == [2048, 1024]
+    left = [(18_346, 0)]
+    need = {r: M.round_need(r, left) for r in (2048, 1024, 512)}
+    assert need[2048] > need[1024] > need[512] > 0
+    assert M.round_need(2048, []) == 0
+    # G18's refusal: rank 1 at 5.15 GiB with an 18K prompt: 2,048 rows would leave < 5, a quarter of them does not
+    assert a.choose(2048, int(9 * GiB), lambda r: M.round_need(r, left)) == 2048
+    assert a.choose(2048, int(5.15 * GiB), lambda r: M.round_need(r, left)) == 512
+    assert a.choose(2048, int(4.0 * GiB), lambda r: M.round_need(r, left)) == 512      # the smallest when none fits
+    mid = 5 * GiB + need[1024] + int(0.1 * GiB)
+    assert a.choose(2048, mid, lambda r: M.round_need(r, left)) == 1024
+    # up from 512 needs the extra 0.5 GiB; staying at 1,024 does not
+    assert a.choose(2048, mid, lambda r: M.round_need(r, left), current=512) == 512
+    assert a.choose(2048, mid + int(0.5 * GiB), lambda r: M.round_need(r, left), current=512) == 1024
+    assert a.choose(2048, mid, lambda r: M.round_need(r, left), current=1024) == 1024
+    monkeypatch.setenv("TF_DSV41_PREFILL_ADAPT", "0")
+    assert not M.Adapt.from_env().on
+    monkeypatch.setenv("TF_DSV41_PREFILL_ADAPT_MIN", "8")
+    with pytest.raises(ValueError):
+        M.Adapt.from_env()
