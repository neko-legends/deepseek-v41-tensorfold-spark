+// patches/0080: bindings of exl3_fast.cu (the fast-prefill EXL3 expert kernels).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void exl3_fast_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, double);
+void exl3_fast_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t);
+// patches/0170: the fat variants and the one-matrix input rotation
+void exl3_fat_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, double, bool,
+                          int64_t, bool);
+void exl3_fat_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                        const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, bool);
+// patches/0260: the once variants (two work items a CTA sharing their trellis decode; fat's bits)
+void exl3_once_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                           const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, double, bool,
+                           bool, bool, int64_t);
+void exl3_once_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, bool, bool,
+                         int64_t);
+void exl3_rot_in1_cuda(const at::Tensor&, int64_t, const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t,
