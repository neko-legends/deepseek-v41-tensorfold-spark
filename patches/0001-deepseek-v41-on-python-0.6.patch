+class RowMoE:
+    """A row-wise MoE stand-in: a row's output depends on that row and the bias it routes with."""
+
+    def __init__(self, bias, bias_vl=None):
+        self.bias, self.bias_vl, self.calls = bias, bias_vl, []
+
+    def __call__(self, x):
+        self.calls.append(x.shape[0])
+        pick = (x @ torch.ones(x.shape[1], 4) + self.bias).argmax(-1)
+        return x * (1 + pick[:, None].float())
+
+
+def test_moe_routes_image_rows_with_bias_vl():
+    torch.manual_seed(0)
+    x = torch.randn(7, 3)
+    bias, bias_vl = torch.tensor([0.0, 5.0, 0.0, 0.0]), torch.tensor([0.0, 0.0, 0.0, 9.0])
+    w = V.window([1, VP.VBASE, VP.VBASE + 1, 2, 3, VP.VBASE + 2, 4], "cpu")
+    m = RowMoE(bias, bias_vl)
+    got = V.moe(m, x, w)
+    text, img = RowMoE(bias)(x), RowMoE(bias_vl)(x)
+    want = torch.where((w.keep == 0)[:, None], img, text)          # the reference Gate's per-row where
+    assert torch.equal(got, want) and torch.equal(m.bias, bias) and sorted(m.calls) == [3, 4]
+    assert torch.equal(V.moe(RowMoE(bias), x, w), text)          # no bias_vl: the text bias (the kit)
+    assert torch.equal(V.moe(m, x, None), text)                  # a text window: one call, unchanged
+
