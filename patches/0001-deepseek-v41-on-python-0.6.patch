+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A lane-level emulator of ``x3gm.cu`` in numpy (no GPU): shared memory is one byte buffer a CTA with the kernel's
+views (ring stages, swizzled rows, trellis words, the aliased epilogue buffer); every index formula is transcribed
+from the kernel (load_stage, decode_a with upstream's LaneMap / cb_pair, ldmatrix.x4, the m16n8k16 fragment layouts,
+the epilogue's ep addresses, fwht128's butterflies); arithmetic is fp32 where the kernel's is (an mma adds its
+16-term product, exact in float64, to the fp32 accumulator with one rounding: the order-sensitive part, the chain over
+k tiles, is the kernel's). Stale shared memory is kept between items, so rows the kernel must not read stay garbage.
+
+``test_dsv41_x3gm_emu.py`` checks it against the float64 reference (``tensorfold.cuda.exl3.format``) and checks the
+kernel's invariants (every output stored once, row independence, any item order / CTA count gives the same bits).
+"""
+
+from __future__ import annotations
+
+from functools import cache
+
+import numpy as np
+
+HAD = np.float32(0.08838834764831845)
+NB = 8
+F32 = np.float32
+
+
+# -- the EXL3 tile (upstream experts_grouped.cuh: Fmt, LaneMap, cb_pair<2>) ---------------------------------------
+def fmt(K2: int) -> tuple[int, int, int]:
+    gv = 2 if K2 >= 13 else (4 if (K2 == 7 or 9 <= K2 <= 12 or K2 == 16) else 8)
+    return 4 * K2, gv, 8 // gv
+
+
+def _end(K2: int, p):
+    return (p >> 1) * K2 + np.where(p & 1, K2, K2 >> 1)
+
+
+@cache
+def lanemap(K2: int):
+    TW, GV, NG = fmt(K2)
+    lane = np.arange(32)
+    hi, lo, sh = (np.zeros((32, NG), dtype=np.int64) for _ in range(3))
+    for g in range(NG):
+        last_end = _end(K2, 8 * lane + g * GV + GV - 1) + 128 * K2
+        hr = (last_end - 1) >> 5
+        hi[:, g], lo[:, g], sh[:, g] = hr % TW, (hr + TW - 1) % TW, (hr + 1) * 32 - last_end
+    return hi, lo, sh
+
+
+def cb_pair(s0: np.ndarray, s1: np.ndarray) -> np.ndarray:
+    """mul1: two 16-bit states -> half2 bits (s0 low): fp16(1024 + byte sum of s * 0x83DCD12D) * 0x1EEE + 0xC931."""
+
+    def one(s):
+        x = (s.astype(np.uint64) * 0x83DCD12D) & 0xFFFFFFFF
+        h = 1024 + (x & 255) + ((x >> 8) & 255) + ((x >> 16) & 255) + (x >> 24)
+        scale = float(np.array(0x1EEE, dtype=np.uint16).view(np.float16))
+        bias = float(np.array(0xC931, dtype=np.uint16).view(np.float16))
+        v = (h.astype(np.float64) * scale + bias).astype(np.float16)       # exact in float64: hfma2's one rounding
+        return v.view(np.uint16).astype(np.uint32)
+
+    return one(s0) | (one(s1) << 16)
+
+
+def decode_a(tile: np.ndarray, K2: int) -> np.ndarray:
+    """x3gm.cu decode_a for all 32 lanes: tile uint32 [TW] (shared memory) -> a [32, 4] uint32 (W^T's A fragment)."""
+
+    _, GV, NG = fmt(K2)
+    hi, lo, sh = lanemap(K2)
+    st = np.zeros((32, 8), dtype=np.uint64)
+    t = tile.astype(np.uint64)
+    for g in range(NG):
+        mm = ((t[lo[:, g]] << np.uint64(32)) | t[hi[:, g]]) >> sh[:, g].astype(np.uint64)
+        for j in range(GV):
+            off = int(_end(K2, np.int64(GV - 1)) - _end(K2, np.int64(j)))
+            st[:, g * GV + j] = (mm >> np.uint64(off)) & np.uint64(0xFFFF)
+    return np.stack([cb_pair(st[:, 0], st[:, 1]), cb_pair(st[:, 4], st[:, 5]), cb_pair(st[:, 2], st[:, 3]),
+                     cb_pair(st[:, 6], st[:, 7])], axis=1)
+
+
+# -- the m16n8k16 fragments -----------------------------------------------------------------------------------------
+LANE = np.arange(32)
+G, T = LANE >> 2, LANE & 3
+
+
+def _halves(r: np.ndarray):
+    return (r & 0xFFFF).astype(np.uint16).view(np.float16), (r >> 16).astype(np.uint16).view(np.float16)
+
+
+def a_matrix(a: np.ndarray) -> np.ndarray:
+    """A [16 m, 16 k] float64 from a [32, 4] (PTX: a0 row g k 2t.., a1 row g+8, a2 row g k 2t+8.., a3 row g+8)."""
+
+    A = np.zeros((16, 16))
+    for q, (dr, dk) in enumerate(((0, 0), (8, 0), (0, 8), (8, 8))):
+        lo, hi = _halves(a[:, q])
+        A[G + dr, 2 * T + dk] = lo
+        A[G + dr, 2 * T + dk + 1] = hi
+    return A
+
+
+def b_matrix(b0: np.ndarray, b1: np.ndarray) -> np.ndarray:
+    """B [16 k, 8 n] float64 (b0: k 2t, 2t+1 of column g; b1: k 2t+8, 2t+9)."""
+
+    B = np.zeros((16, 8))
+    for r, dk in ((b0, 0), (b1, 8)):
+        lo, hi = _halves(r)
+        B[2 * T + dk, G] = lo
+        B[2 * T + dk + 1, G] = hi
+    return B
+
+
+def mma(d: np.ndarray, a: np.ndarray, b0: np.ndarray, b1: np.ndarray) -> np.ndarray:
+    """d [32, 4] fp32 += A B: c0 D[g][2t], c1 D[g][2t+1], c2 D[g+8][2t], c3 D[g+8][2t+1]."""
+
+    D = np.zeros((16, 8))
+    D[G, 2 * T], D[G, 2 * T + 1], D[G + 8, 2 * T], D[G + 8, 2 * T + 1] = d[:, 0], d[:, 1], d[:, 2], d[:, 3]
+    D = (D + a_matrix(a) @ b_matrix(b0, b1)).astype(F32)
+    return np.stack([D[G, 2 * T], D[G, 2 * T + 1], D[G + 8, 2 * T], D[G + 8, 2 * T + 1]], axis=1)
+
+
+def ldsm4(s16: np.ndarray, addr: np.ndarray) -> np.ndarray:
+    """ldmatrix.x4 (b16, no transpose): lane L gives the row address (in halves) of matrix L / 8, row L % 8; thread
+    T gets row T / 4, halves 2 (T % 4), +1 of each matrix."""
+
+    out = np.zeros((32, 4), dtype=np.uint32)
+    for i in range(4):
+        row = addr[8 * i + (LANE >> 2)] + 2 * (LANE & 3)
+        out[:, i] = s16[row].astype(np.uint32) | (s16[row + 1].astype(np.uint32) << 16)
+    return out
+
+
+def fwht128(v: np.ndarray) -> np.ndarray:
+    """decode.cuh fwht128 on [32 lanes, 4] fp32 (the butterflies in its order)."""
+
+    v = v.astype(F32)
+    a, b, c, d = v[:, 0] + v[:, 1], v[:, 0] - v[:, 1], v[:, 2] + v[:, 3], v[:, 2] - v[:, 3]
+    v = np.stack([a + c, b + d, a - c, b - d], axis=1).astype(F32)
+    for m in (1, 2, 4, 8, 16):
+        o = v[LANE ^ m]
+        v = np.where(((LANE & m) != 0)[:, None], o - v, v + o).astype(F32)
+    return v
+
+
+def swz(CPR: int, r, c):
+    return (c ^ (r & 7)) if CPR == 8 else (c ^ ((r >> 1) & 3))
+
+
+# -- the kernels ----------------------------------------------------------------------------------------------------
+class Cfg:
+    def __init__(self, mats: int, xm: int, K2: int, mtl: int, ng: int, ks: int, nsa: int, ngr: int) -> None:
+        self.mats, self.xm, self.K2, self.mtl = mats, xm, K2, mtl
+        self.ng, self.ks, self.nsa, self.ngr = ng, ks, nsa, ngr
+        self.BM, self.WPM = ng * 8, NB // mtl
+        self.W = mats * self.WPM
+        self.THREADS = self.W * 32
+        self.CPR, self.LDA, self.TW = ks * 2, ks * 16, 4 * K2
+        self.LDE, self.ER, self.ROUNDS = 132, ngr * 8, ng // ngr
+        self.A_BYTES = xm * self.BM * self.LDA * 2
+        self.W_BYTES = mats * ks * NB * self.TW * 4
+        self.STAGE = self.A_BYTES + self.W_BYTES
+        self.SMEM = max(nsa * self.STAGE, mats * self.ER * self.LDE * 4)
+
+
+def _tiles():
+    from tensorfold.families.deepseek_v41.cuda import x3gm
+
+    return x3gm.GU_TILES, x3gm.DN_TILES
+
+
+GU, DN = _tiles()                                          # x3gm.cu GM_GU* / GM_DN* (MTL, NG, KS, NSA, NGR)
+
+
+def gm_kernel(c: Cfg, x0, x1, t0, t1, order, pe, poff, pcnt, npass: int, K: int, N: int, sv0, sv1=None, sd=None,
+              limit: float = 10.0, out=None, stores=None, items=None, ctas: int = 1, seed: int = 0):
+    """One launch: x0 / x1 fp16 [P, K], t0 / t1 uint32 [E, K/16, N/16, TW], plan arrays; out (fp16 [P, N] for
+    gate/up, fp32 for down) is written; stores counts each (row, column) write. ``items``: the order items are
+    claimed in (ticket: any), dealt round robin to ``ctas`` CTAs, each with its own (stale) shared memory."""
+
+    KT, NTILES = K // 16, N // 16
+    S, NBLK = KT // c.ks, N // 128
+    total = npass * NBLK
+    items = list(range(total)) if items is None else list(items)
+    rng = np.random.default_rng(seed)
+    smems = [rng.integers(0, 256, size=c.SMEM, dtype=np.uint8) for _ in range(ctas)]      # garbage to start
+    x0b, x1b = x0.view(np.uint16).reshape(-1), x1.view(np.uint16).reshape(-1)
+    tw0, tw1 = t0.reshape(-1), t1.reshape(-1)
+    se = KT * NTILES * c.TW
+    lr = (LANE & 7) + ((LANE >> 4) << 3)
+    lc = (LANE >> 3) & 1
+    for n_it, item in enumerate(items):
+        sm = smems[n_it % ctas]
+        s16, s32, f32 = sm.view(np.uint16), sm.view(np.uint32), sm.view(np.float32)
+        tt, nb = item // NBLK, item % NBLK
+        e, off, cnt = int(pe[tt]), int(poff[tt]), int(pcnt[tt])
+        rows_sh = [int(order[off + i]) if i < cnt else -1 for i in range(c.BM)]
+        cnt16 = (cnt + 15) & ~15
+
+        def load_stage(s, e=e, nb=nb, cnt16=cnt16, rows_sh=rows_sh, s16=s16, s32=s32):
+            base = (s % c.nsa) * c.STAGE
+            k0 = s * c.ks * 16
+            for i in range(c.xm * c.BM * c.CPR):
+                m, r, ch = i // (c.BM * c.CPR), (i // c.CPR) % c.BM, i % c.CPR
+                if r < cnt16:
+                    row = rows_sh[r]
+                    dst = base // 2 + (m * c.BM + r) * c.LDA + swz(c.CPR, r, ch) * 8
+                    if row >= 0:
+                        src = (row * K + k0 + ch * 8)
+                        s16[dst:dst + 8] = (x1b if m else x0b)[src:src + 8]
+                    else:
+                        s16[dst:dst + 8] = 0
+            rw = (base + c.A_BYTES) // 4
+            for i in range(c.mats * c.ks * NB * c.K2):
+                q, n, kk, m = i % c.K2, (i // c.K2) % NB, (i // (c.K2 * NB)) % c.ks, i // (c.K2 * NB * c.ks)
+                src = e * se + ((s * c.ks + kk) * NTILES + nb * NB + n) * c.TW + q * 4
+                dst = rw + ((m * c.ks + kk) * NB + n) * c.TW + q * 4
+                s32[dst:dst + 4] = (tw1 if m else tw0)[src:src + 4]
+
+        acc = np.zeros((c.W, c.mtl, c.ng, 32, 4), dtype=F32)
+        for s in range(c.nsa - 1):
+            if s < S:
+                load_stage(s)
+        for s in range(S):
+            if s + c.nsa - 1 < S:
+                load_stage(s + c.nsa - 1)
+            base = (s % c.nsa) * c.STAGE
+            for w in range(c.W):
+                mat, sl = w // c.WPM, w % c.WPM
+                xmat = 0 if c.xm == 1 else mat
+                A = base // 2 + xmat * c.BM * c.LDA
+                Wd = (base + c.A_BYTES) // 4 + mat * c.ks * NB * c.TW + sl * c.mtl * c.TW
+                for kk in range(c.ks):
+                    af = [decode_a(s32[Wd + (kk * NB + l) * c.TW: Wd + (kk * NB + l + 1) * c.TW], c.K2)
+                          for l in range(c.mtl)]
+                    chunk = swz(c.CPR, lr, kk * 2 + lc)
+                    for np_ in range(c.ng // 2):
+                        if 16 * np_ < cnt:
+                            b = ldsm4(s16, A + (16 * np_ + lr) * c.LDA + chunk * 8)
+                            for l in range(c.mtl):
+                                acc[w, l, 2 * np_] = mma(acc[w, l, 2 * np_], af[l], b[:, 0], b[:, 1])
+                                acc[w, l, 2 * np_ + 1] = mma(acc[w, l, 2 * np_ + 1], af[l], b[:, 2], b[:, 3])
+        for rd in range(c.ROUNDS):
+            if c.ER * rd < cnt:
+                for w in range(c.W):
+                    mat, sl = w // c.WPM, w % c.WPM
+                    for n in range(c.ngr):
+                        ng = rd * c.ngr + n
+                        E0 = (mat * c.ER + 8 * n + 2 * T) * c.LDE + sl * 16 * c.mtl + G
+                        for l in range(c.mtl):
+                            f32[E0 + l * 16] = acc[w, l, ng, :, 0]
+                            f32[E0 + c.LDE + l * 16] = acc[w, l, ng, :, 1]
+                            f32[E0 + l * 16 + 8] = acc[w, l, ng, :, 2]
+                            f32[E0 + c.LDE + l * 16 + 8] = acc[w, l, ng, :, 3]
+            for r in range(c.ER):
+                if c.ER * rd + r >= cnt:
+                    break
+                row = rows_sh[c.ER * rd + r]
+                c0 = 4 * LANE
+                col = nb * 128 + c0[:, None] + np.arange(4)[None, :]
+                v = fwht128(f32[r * c.LDE + col - nb * 128])
+                if c.mats == 2:
+                    u = fwht128(f32[(c.ER + r) * c.LDE + col - nb * 128])
+                    gg = np.minimum((v * HAD).astype(F32) * sv0[e, col].astype(F32), F32(limit)).astype(F32)
+                    uu = np.clip((u * HAD).astype(F32) * sv1[e, col].astype(F32), F32(-limit), F32(limit)).astype(F32)
+                    act = ((gg / (F32(1) + np.exp(-gg).astype(F32))).astype(F32) * uu).astype(F32)
+                    v = fwht128((act * sd[e, col].astype(F32)).astype(F32))
+                    out[row, col] = (v * HAD).astype(F32).astype(np.float16)
+                else:
+                    out[row, col] = ((v * HAD).astype(F32) * sv0[e, col].astype(F32)).astype(F32)
+                if stores is not None:
+                    stores[row, col] += 1
+    return out
+
+
+def rot(x: np.ndarray, pick: np.ndarray, suh: np.ndarray) -> np.ndarray:
+    """rot_kernel: fp16(fwht((x[p / slots] * suh[e]) fp32) / sqrt 128) for every pair, [P, K]."""
+
+    R, S = pick.shape
+    K = x.shape[1]
+    out = np.zeros((R * S, K), dtype=np.float16)
+    for p in range(R * S):
+        e = pick.reshape(-1)[p]
+        for blk in range(K // 128):
+            sl = slice(blk * 128, blk * 128 + 128)
+            v = (x[p // S, sl].astype(F32) * suh[e, sl].astype(F32)).reshape(32, 4)
+            out[p, sl] = (fwht128(v) * HAD).astype(F32).astype(np.float16).reshape(-1)
+    return out
+
+
+def combine(y: np.ndarray, wts: np.ndarray) -> np.ndarray:
+    """upstream combine_kernel: out[r] = fma chain over slots in order from 0 (fp32)."""
+
+    R, S = wts.shape
+    acc = np.zeros((R, y.shape[1]), dtype=F32)
+    for k in range(S):
+        acc = (wts[:, k:k + 1].astype(np.float64) * y.reshape(R, S, -1)[:, k].astype(np.float64)
+               + acc.astype(np.float64)).astype(F32)
+    return acc
+
+
+def routed(x, pick, wts, tg, tu, td, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d, limit: float, *, shx: bool,
+           gu_cfg: int, dn_cfg: int, order_seed: int | None = None, ctas: int = 1):
+    """The whole ``x3gm.run`` for one block on the emulator: x fp32 [R, D] (bf16 values), pick int [R, S], trellis
+    stacks uint32 [E, K/16, N/16, TW] -> (out fp32 [R, D], stores of gate/up, stores of down)."""
+
+    import torch
+
+    from tensorfold.families.deepseek_v41.cuda import x3gm
+
+    R, S = pick.shape
+    E, D, I = tg.shape[0], tg.shape[1] * 16, tg.shape[2] * 16
+    xg = rot(x, pick, suh_g)
+    xu = xg if shx else rot(x, pick, suh_u)
+    P = R * S
+    k2g, k2d = tg.shape[-1] // 4, td.shape[-1] // 4
+    cg = Cfg(2, 1 if shx else 2, k2g, *GU[gu_cfg])
+    cd = Cfg(1, 1, k2d, *DN[dn_cfg])
+    rng = np.random.default_rng(order_seed)
+
+    def plan_of(c):                                         # x3gm.run: passes of the configuration's BM members
+        got = [t.numpy() for t in x3gm.plan(torch.from_numpy(pick.astype(np.int64)), E, c.BM)]
+        got[4] = int(got[4][0])
+        return got
+
+    def items(npass, N):
+        it = np.arange(npass * (N // 128))
+        return it if order_seed is None else rng.permutation(it)
+
+    xd = np.zeros((P, I), dtype=np.float16)
+    st_gu = np.zeros((P, I), dtype=np.int64)
+    order, pe, poff, pcnt, npass = plan_of(cg)
+    gm_kernel(cg, xg, xu, tg, tu, order, pe, poff, pcnt, npass, D, I, svh_g, svh_u, suh_d, limit, out=xd,
+              stores=st_gu, items=items(npass, I), ctas=ctas, seed=1)
+    y = np.zeros((P, D), dtype=F32)
+    st_dn = np.zeros((P, D), dtype=np.int64)
+    order, pe, poff, pcnt, npass = plan_of(cd)
+    gm_kernel(cd, xd, xd, td, td, order, pe, poff, pcnt, npass, I, D, svh_d, out=y, stores=st_dn,
+              items=items(npass, D), ctas=ctas, seed=2)
+    return combine(y, wts), st_gu, st_dn
+
+
+def reference(x, pick, wts, tg16, tu16, td16, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d, limit: float) -> np.ndarray:
+    """float64: out[r] = sum_s wts[r, s] down(silu(min(gate x, l)) * clamp(up x, +-l)), format.forward each matrix
+    (trellis int16 stacks [E, K/16, N/16, 16 bits])."""
+
+    from tensorfold.cuda.exl3 import format as F
+
+    R, S = pick.shape
+    out = np.zeros((R, x.shape[1]))
+    for r in range(R):
+        for s in range(S):
+            e = int(pick[r, s])
+            bg, bd = tg16.shape[-1] / 16, td16.shape[-1] / 16
+            g = F.forward(x[r:r + 1], tg16[e], suh_g[e], svh_g[e], bg, "mul1")
+            u = F.forward(x[r:r + 1], tu16[e], suh_u[e], svh_u[e], bg, "mul1")
+            g = np.minimum(g, limit)
+            u = np.clip(u, -limit, limit)
+            act = g / (1.0 + np.exp(-g)) * u
+            out[r] += float(wts[r, s]) * F.forward(act, td16[e], suh_d[e], svh_d[e], bd, "mul1")[0]
+    return out
