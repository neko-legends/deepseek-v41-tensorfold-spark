index 0000000..835a67e
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/__init__.py
@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash (model_type ``deepseek_v41``): a CUDA engine over two DGX Sparks (TP=2) for the EXL3 packs.
+
+What TensorFold's family discovery and CUDA CLI need (upstream's ``docs/recipes/adding-a-cuda-family.md``; the
+``CUDA_SERVE`` hook as the GLM Spark family has it). Importable without torch (family discovery runs on Macs too):
+the engine and the app load lazily.
+
+The engine (``cuda/``): CSA2 attention (FP8 584-byte KV rows, the lightning indexer with candidate blocks, sparse +
+sliding-window attention with sinks), Single-Pass mHC, Engram rows from the kit's packed NVMe shards, the MoE on
+upstream's grouped EXL3 kernels with our 0580 load path, upstream's row-invariant EXL3 linears; prepared per-rank
+folders for fast restarts. Milestone M1: exact TP=2 forward, ``full`` prefill, serial decode, one request at a time.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+MODEL_TYPES = ("deepseek_v41",)
+TITLE = "DeepSeek-V4.1-Flash"
+MODELS = ("dealignai/DeepSeek-V4.1-Flash-UNCENSORED-EXL3-2.9bpw", "MiaAI-Lab/DeepSeek-v4.1-Flash-EXL3-2.9bpw")
+QUANT_METHODS = {"cuda": ("exl3",)}
+# The KV cache is the 584-byte FP8 record (``cuda/csa2/rows.py``, the kit's ``fp8_ds_mla``): serve with --kv-dtype fp8
+CUDA_KV_DTYPES = ("fp8",)
+CUDA_TP = (2, 4)                      # ranks, one a Spark (the CLI refuses --tp 4 for families without it)
+CACHE_FORMAT = "fp8_ds_mla"
+DRAFTER = ""                          # DSpark is the checkpoint's own mtp.* blocks (M2), not a separate model
+REQUIRED_FILES: dict = {}
+ENGINES = ("spark",)
+CODEBOOKS = ("mul1", "mcg", "3inst")
+
+# Engine switches (TF_<FAMILY>_*, upstream's style); --context / --parallel apply as for the other CUDA engines.
+KNOBS = {
+    "TF_DSV41_PREPARED": "the prepared per-rank folders' root (unset / 0: read the checkpoint every start)",
+    "TF_DSV41_PREPARED_WRITE": "1: write a missing prepared folder after building it",
+    "TF_DSV41_PREPARED_VERIFY": "full | sample (default) | off: chunk checksums checked when reading a folder",
+    "TF_DSV41_PREPARED_THREADS": "reader threads (default 8)",
+    "TF_DSV41_ENGRAM_DIR": "the packed per-rank Engram shards on local NVMe (engram-l{1,14}-r{rank}of2.bin)",
+    "TF_DSV41_TOKEN_MAP": "Engram's compressed-vocabulary map as JSON (else built from tokenizer.json)",
+    "TF_DSV41_BIAS_VL": "a folder of the release's source shards with gate.bias_vl (image routing; text needs none)",
+    "TF_DSV41_EXPERT_LOADS": "1: the 0580 load path for the grouped mul1 experts (cuda/expert_loads.py)",
+    "TF_DSV41_SEAMS": "torch: run the torch fallbacks of the mHC / Engram kernels (cuda/seams.py)",
+    "TF_DSV41_CONTEXT": "positions a request may reach when --context is not given (default 65,536)",
+    "TF_DSV41_CHUNK": "prefill rows a window (1-128, default 128; rows never depend on it)",
+}
+
+
+def _text(cfg: dict) -> dict:
+    return cfg.get("text_config") or cfg
+
+
+def check(model_dir: str | Path) -> None:
+    """Refuse a checkpoint this family does not serve, from config.json alone (no torch)."""
+
+    p = Path(model_dir)
+    try:
+        cfg = json.loads((p / "config.json").read_text())
+    except (OSError, ValueError) as e:
+        raise ValueError(f"{p}: no readable config.json ({e})") from e
+    t = _text(cfg)
+    if cfg.get("model_type") not in MODEL_TYPES and t.get("model_type") not in (*MODEL_TYPES, "deepseek_v41_text"):
+        raise ValueError(f"model_type {cfg.get('model_type')!r} is not deepseek_v41")
+    q = cfg.get("quantization_config") or cfg.get("quantization") or {}
+    if str(q.get("quant_method", "")).lower() != "exl3":
+        raise ValueError(f"{TITLE}'s CUDA engine reads the EXL3 packs ({', '.join(MODELS)}); this checkpoint has "
+                         f"quant_method {q.get('quant_method')!r}")
+    if str(q.get("codebook", "mul1")).lower() not in CODEBOOKS:
+        raise ValueError(f"unknown EXL3 codebook {q.get('codebook')!r}")
+    need = {"compress_ratios", "kv_source_layer_ids", "index_source_layer_ids", "engram_layer_ids"}
+    missing = sorted(need - set(t))
+    if missing:
+        raise ValueError(f"config.json lacks {', '.join(missing)}: not a V4.1 layout")
+
+
+def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank: int = 0, master: str = "",
+                master_port: int = 29551, no_drafts: bool = False, mtp_drafts: int | None = None, **options: Any):
+    """The CLI's engine factory (GLM's ``cuda_engine`` signature): TP=2 over two Sparks only."""
+
+    if int(tp) not in (2, 4) or not master:
+        raise ValueError(f"{TITLE} runs on two ranks (or four), one a Spark: the same `tensorfold serve` command "
+                         "with --tp N --rank R --master <rank 0's address on the link> on each (followers first)")
+    from .cuda.engine import Dsv41Engine
+
+    context = int(options.get("context") or 0) if options.get("context_explicit") else 0
+    return Dsv41Engine(Path(model_dir), rank=int(rank), master=master, port=int(master_port), context=context,
+                       serial_only=bool(no_drafts), draft_depth=mtp_drafts, parallel=int(options.get("parallel", 1)),
+                       kv_dtype=str(options.get("kv_dtype", "fp8")), world=int(tp))
+
+
+def _has_app() -> bool:
+    import importlib.util
+
+    return importlib.util.find_spec(f"{__name__}.cuda.app") is not None
+
+
+def __getattr__(name: str) -> Any:
+    # M3 brings the V4.1 app (template, DSML tools) on our GLM server; until then upstream's App and server serve
+    if name == "CUDA_APP" and _has_app():
+        from .cuda.app import Dsv41App
+
+        return Dsv41App
+    if name == "CUDA_SERVE" and _has_app():
+        from tensorfold.families.glm5_next.spark.server import serve           # our server (0150-0620), as GLM's
+
+        return serve
+    raise AttributeError(name)
