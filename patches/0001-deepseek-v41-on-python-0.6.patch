index 0000000..0a3c436
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/linear.py
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The forward's linears: every matrix is ``y [M, N] = x [M, K] @ W``, one row's result independent of the others.
+
+- ``Exl3``: an EXL3 matrix on the GPU through upstream's row-invariant ``tensorfold.cuda.exl3.linear.Exl3Linear``
+  (1-128 rows a launch; longer windows run in blocks of 128 rows, which changes nothing in a row's bits), or
+  ``dense``'s x3dn when ``TF_DSV41_DENSE`` takes the matrix (row-invariant too, other summation order), or (G10,
+  ``TF_DSV41_PDL`` part ``single``) upstream's programs as a 1-segment x3seg launch with PDL (the same bits).
+- ``Dense``: the same EXL3 matrix decoded once with upstream's float64 oracle (``exl3.format.dequantize``), applied
+  as the kit's linears do (fp16 input, fp32 out) in float64 sums: the CPU twin (tests, tiny configs).
+- ``Plain``: a native weight [N, K] (indexer ``weights_proj``): float64 sums on any device; on CUDA one Triton
+  launch with a row-count-independent order (``plain_fp64``; cuBLAS's DGEMM took ~275 us a call at decode widths).
+
+``lin(x, dtype)`` returns the output rounded to ``dtype`` (bf16: what vLLM's linear wrappers return).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+from . import numerics as N
+
+F32, F64, BF16, F16 = torch.float32, torch.float64, torch.bfloat16, torch.float16
+ROWS = 128                      # upstream Exl3Linear's rows a launch
+
+
+@dataclass
+class Exl3:
+    """An upstream ``Exl3Linear`` (words in its "strips" layout)."""
+
+    lin: object                 # tensorfold.cuda.exl3.linear.Exl3Linear
+
+    @property
+    def k(self) -> int:
+        return self.lin.k
+
+    @property
+    def n(self) -> int:
+        return self.lin.n
+
+    def __call__(self, x: torch.Tensor, dtype: torch.dtype = F32) -> torch.Tensor:
+        from . import dense as D
+
+        if D.wanted(self.lin):                  # TF_DSV41_DENSE: x3dn (the matrix's own bits in any path)
+            return D.single(self.lin)(x, dtype)[0]
+        if x.is_cuda:
+            from . import pdl as P
+
+            if P.on("single", x.device.index):  # G10 TF_DSV41_PDL: upstream's programs as x3seg PDL launches
+                from . import fused_proj as FP
+
+                f = FP.single(self.lin)
+                if f is not None:
+                    return f(x, dtype)[0]
+        x = x.contiguous()
+        out = torch.empty((x.shape[0], self.lin.n), dtype=dtype, device=x.device)
+        for a in range(0, x.shape[0], ROWS):
+            b = min(x.shape[0], a + ROWS)
+            self.lin(x[a:b], out=out[a:b])
+        return out
+
+
+@dataclass
+class Dense:
+    """W [K, N] float64 (an EXL3 matrix decoded exactly); fp16 input like the kit's EXL3 linears."""
+
+    w: torch.Tensor
+    fp16_input: bool = True
+
+    @property
+    def k(self) -> int:
+        return self.w.shape[0]
+
+    @property
+    def n(self) -> int:
+        return self.w.shape[1]
+
+    def __call__(self, x: torch.Tensor, dtype: torch.dtype = F32) -> torch.Tensor:
+        x = x.to(F16) if self.fp16_input and N.QUANT else x
+        return (x.to(F64) @ self.w.to(device=x.device, dtype=F64)).to(N.ACC).to(dtype)
+
+
+@dataclass
+class Plain:
+    """A native weight [N, K] (bf16 values), float64 sums."""
+
+    w: torch.Tensor
+
+    @property
+    def k(self) -> int:
+        return self.w.shape[1]
+
+    @property
+    def n(self) -> int:
+        return self.w.shape[0]
+
+    def __call__(self, x: torch.Tensor, dtype: torch.dtype = F32) -> torch.Tensor:
+        if x.is_cuda and self.w.device == x.device:
+            from . import plain_fp64 as PF          # one Triton launch, row-invariant (G4: cuBLAS DGEMM ~275 us)
+
+            if PF.eligible(x, self.w):
+                return PF.matmul_t(x, self.w).to(N.ACC).to(dtype)
+        return (x.to(F64) @ self.w.to(device=x.device, dtype=F64).t()).to(N.ACC).to(dtype)
+
+
+def dense_from(trellis, suh, svh, codebook: str) -> Dense:
+    """Decode an EXL3 group with upstream's float64 oracle."""
+
+    from tensorfold.cuda.exl3 import format as fmt
+
+    bits = fmt.bits_of(tuple(trellis.shape))
+    w = fmt.dequantize(trellis.cpu().numpy(), suh.cpu().numpy(), svh.cpu().numpy(), bits, codebook)
+    return Dense(torch.from_numpy(w))
+
+
+def exl3_from(trellis, suh, svh, codebook: str, device) -> Exl3:
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    return Exl3(Exl3Linear.from_tensors(trellis, suh, svh, codebook, device=device))
