@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""moe_fused.cu builds for sm_121 (GB10) without torch headers (-DDSV41_MF_NO_TORCH): the 40 fused_kernel instances
+(RT 1..16 x NW 1, 2, 4, 8 x the b1 / G14 TAIL=fast tail) and combine2, no register spills, no stack, static shared
+memory under 48 KiB; with a cuobjdump: the fused kernel's logits load the whole gate row by cp.async (LDGSTS) as
+narrow_kernel does, the fast tail's selection runs REDUX (the serial one none), and upstream's rot_in_kernel still
+compiles its first butterfly stage to 2 FMUL + 4 FFMA (the form moe_fused.cu spells out). Needs an nvcc that knows
+compute_121 (TF_NVCC, PATH or CUDA_HOME); skipped otherwise."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import moe_fused as MF
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+CU = Path(MF.__file__).with_name("moe_fused.cu")
+UPSTREAM = Path(RG.__file__).parents[3] / "cuda" / "exl3" / "experts.cu"
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+pytestmark = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+FLAGS = ["-std=c++17", "-O3", "-lineinfo", "-gencode=arch=compute_121,code=sm_121"]
+
+
+def _cuobjdump() -> str | None:
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump")]
+    if NVCC:
+        cands.append(str(Path(NVCC).with_name("cuobjdump")))
+    try:
+        import triton
+
+        cands.append(str(Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "cuobjdump"))
+    except ImportError:
+        pass
+    return next((c for c in cands if c and os.path.exists(c)), None)
+
+
+def _sass(obj, fn=None) -> str | None:
+    tool = _cuobjdump()
+    if tool is None:
+        return None
+    out = subprocess.run([tool, "-sass", *(["-fun", fn] if fn else []), str(obj)], capture_output=True, text=True,
+                         timeout=300, check=False)
+    return out.stdout if out.returncode == 0 else None
+
+
+@pytest.fixture(scope="module")
+def built(tmp_path_factory):
+    tmp = tmp_path_factory.mktemp("mf")
+    src = tmp / "inst.cu"
+    src.write_text(f'#include "{CU.name}"\n' + "".join(
+        f"template cudaError_t dsv41_mf::by_rt<{nw}, {f}>(const dsv41_mf::Args&, int, cudaStream_t);\n"
+        for nw in MF.NWS for f in ("false", "true")))
+    out = subprocess.run([NVCC, *FLAGS, "-DDSV41_MF_NO_TORCH", f"-I{CU.parent}", "-Xptxas", "-v", "-c", str(src),
+                          "-o", str(tmp / "inst.o")], capture_output=True, text=True, timeout=1200, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    return tmp / "inst.o", out.stderr
+
+
+def test_builds_for_sm121_without_spills(built):
+    _, log = built
+    entries = re.findall(r"Compiling entry function '(\S+)'", log)
+    mine = [e for e in entries if "dsv41_mf" in e]
+    assert len([e for e in mine if "fused_kernel" in e]) == 2 * len(MF.NWS) * len(RG.TILES)
+    assert any("combine2_kernel" in e for e in mine)
+    blocks = re.split(r"Compiling entry function", log)[1:]
+    for b in blocks:
+        name = b.split("'")[1]
+        if "dsv41_mf" not in name:
+            continue
+        sp = re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes spill loads", b)
+        regs = re.search(r"Used (\d+) registers", b)
+        smem = re.search(r"(\d+) bytes smem", b)
+        assert sp and sp.groups() == ("0", "0", "0"), (name, b[:400])
+        assert regs and int(regs.group(1)) <= 255 and smem and int(smem.group(1)) <= 48 * 1024, name
+    regs = [int(r) for r in re.findall(r"Used (\d+) registers", log)]
+    print(f"\n[G13] moe_fused sm_121: {len(mine)} kernels, registers {min(regs)}..{max(regs)}, no spills / stack")
+
+
+def test_logits_issue_the_gate_row_by_cp_async(built):
+    obj, _ = built
+    for fast in (0, 1):
+        sass = _sass(obj, f"_ZN8dsv41_mf12fused_kernelILi1ELi2ELb{fast}EEEvNS_4ArgsE")
+        if sass is None:
+            pytest.skip("no cuobjdump")
+        ops = re.findall(r"\b(LDGSTS|FFMA)\b", sass)
+        assert ops.count("LDGSTS") == RG.NV and ops.index("FFMA") > max(i for i, o in enumerate(ops) if o == "LDGSTS")
+
+
+def test_fast_tail_selects_by_redux(built):
+    """TAIL=fast: the per-round argmax is two REDUX (max key, min id) a round; b1's tail has none (its butterfly
+    is SHFL.BFLY)."""
+
+    obj, _ = built
+    serial = _sass(obj, "_ZN8dsv41_mf12fused_kernelILi1ELi2ELb0EEEvNS_4ArgsE")
+    fast = _sass(obj, "_ZN8dsv41_mf12fused_kernelILi1ELi2ELb1EEEvNS_4ArgsE")
+    if serial is None or fast is None:
+        pytest.skip("no cuobjdump")
+    assert not re.search(r"\bREDUX\b", serial) and len(re.findall(r"\bREDUX\b", fast)) >= 2
+    print(f"\n[G14] moe_fused fast tail: {len(re.findall(r'CREDUX|REDUX', fast))} REDUX in the R=1 NW=2 instance")
+
+
+def test_upstream_rot_in_first_stage_shape(tmp_path):
+    """The contraction moe_fused.cu transcribes: upstream's rot_in<bf16> computes x1 s1 and x3 s3 with FMUL and fuses
+    x0 s0 / x2 s2 into the first stage's 4 FFMA (the bits agree regardless: bf16 x fp16 products are exact)."""
+
+    text = UPSTREAM.read_text()
+    had = re.search(r"^constexpr float HAD_SCALE.*$", text, re.MULTILINE).group(0)
+    body = text[text.index("// Walsh-Hadamard transform"):text.index("__device__ __forceinline__ float bf16r")]
+    src = tmp_path / "up.cu"
+    src.write_text("#include <cuda_fp16.h>\n#include <cuda_bf16.h>\n" + had + "\n" + body +
+                   "template __global__ void rot_in_kernel<__nv_bfloat16>(const __nv_bfloat16*, int, const int*, "
+                   "const half*, const half*, half*, half*, int, int, int);\n")
+    out = subprocess.run([NVCC, *FLAGS, "-c", str(src), "-o", str(tmp_path / "up.o")], capture_output=True,
+                         text=True, timeout=600, check=False)
+    assert out.returncode == 0, out.stderr[-2000:]
+    sass = _sass(tmp_path / "up.o")
+    if sass is None:
+        pytest.skip("no cuobjdump")
+    head = sass[:sass.index("SHFL.BFLY")]
+    assert len(re.findall(r"\bFMUL\b", head)) == 2 and len(re.findall(r"\bFFMA\b", head)) == 4
+    assert len(re.findall(r"\bFFMA R\d+, R\d+(\.reuse)?, R\d+(\.reuse)?, -R", head)) == 2
