+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 prefill levers on the GPU (collected only where PyTorch sees an NVIDIA GPU), compiled kernels:
+
+- ``TF_DSV41_PF_COPIES``: the fused prefill attention's group-major store == the default layout at 2,048 rows x 32
+  heads, bit for bit; the prefill GEMM writing a strided ``out`` view == a fresh tensor; ``torch.add(fp32, fp32,
+  out=bf16)`` == ``(a + b).to(bf16)`` on CUDA; the time of the copies it removes (printed, ``[G16]``);
+- ``TF_DSV41_PREFILL_TILES``: every swept tile set == upstream's tiles, bit for bit, at the model's dense shapes
+  (wq_a, wkv, wq_b, wo_a, wo_b, shared gate / down) at 2,048 rows; each set's ms (printed);
+- the fast tag end to end on the synthetic checkpoint: copies on == off (logits of the prompt's last row and 3 decode
+  steps), segments 1,024 / 96 equal.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_pf16_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_pf  # noqa: E402
+
+DEV = "cuda"
+R = 2048
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _ms(fn, reps: int = 10) -> float:
+    fn()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        fn()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) / reps
+
+
+def _g7():
+    import importlib.util
+    from pathlib import Path
+
+    spec = importlib.util.spec_from_file_location("dsv41_prefill2_gpu_g7", Path(__file__).with_name(
+        "test_dsv41_prefill2_gpu.py"))
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)                        # G7's attention case builder (one copy of it)
+    return mod
+
+
+@pytest.mark.parametrize("bmq", [16, 32])
+def test_grouped_attention_store_bits_and_copy_time(monkeypatch, bmq):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    q, comp, tok, cnt, swa, lo, p, sink, cs, ring = _g7()._attn_case()
+    want = torch.empty((R, 32, 512), dtype=torch.bfloat16, device=DEV)
+    attn_pf.attention(q, comp, tok, cnt, swa, lo, p, sink, cs, want, ring=ring)
+    got = torch.empty((4, R, 8 * 512), dtype=torch.bfloat16, device=DEV)
+    attn_pf.attention(q, comp, tok, cnt, swa, lo, p, sink, cs, got, ring=ring, groups=4)
+    back = got.view(4, R, 8, 512).permute(1, 0, 2, 3).reshape(R, 32, 512)
+    assert torch.equal(_bits(back), _bits(want))
+    t_def = _ms(lambda: attn_pf.attention(q, comp, tok, cnt, swa, lo, p, sink, cs, want, ring=ring), 5)
+    t_grp = _ms(lambda: attn_pf.attention(q, comp, tok, cnt, swa, lo, p, sink, cs, got, ring=ring, groups=4), 5)
+    o = torch.empty_like(want)
+    t_copy = _ms(lambda: o.copy_(want))
+    og = want.reshape(R, 4, -1)
+    t_cont = _ms(lambda: [og[:, g].contiguous() for g in range(4)])
+    print(f"[G16] attn_pf BMQ {bmq} at {R} rows: default store {t_def:.3f} ms, group-major {t_grp:.3f} ms; removed: "
+          f"o copy {t_copy:.3f} ms + wo_a .contiguous() x 4 {t_cont:.3f} ms")
+
+
+def _lin(K: int, N: int, seed: int, bits: int = 5):
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = np.random.default_rng(seed)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(K // 16, N // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16))
+    suh = torch.from_numpy(g.choice([-1.0, 1.0], size=K).astype(np.float16))
+    svh = torch.from_numpy(g.uniform(0.001, 0.002, size=N).astype(np.float16))
+    return Exl3Linear.from_tensors(t, suh, svh, "mul1", device=DEV)
+
+
+SHAPES = {"wq_a": (5120, 1280), "wkv": (5120, 512), "wq_b": (1280, 16384), "wo_a": (4096, 1024),
+          "wo_b": (4096, 5120), "sh_gate": (5120, 1152), "sh_down": (1152, 5120)}
+TILES = ("128,64,8,3,8", "128,32,8,3,8", "128,64,8,2,8", "64,64,4,3,8", "128,32,4,4,8", "256,32,8,2,8",
+         "128,32,8,4,16")
+
+
+def test_prefill_out_view_and_add_cast():
+    lin = _lin(4096, 1024, 1)
+    x = (torch.randn(R, 4096) * 0.3).to(torch.bfloat16).to(DEV)
+    want = PM.matmul(lin, x, torch.bfloat16)
+    z = torch.zeros((R, 4096), dtype=torch.bfloat16, device=DEV)
+    PM.matmul(lin, x, torch.bfloat16, out=z[:, 1024:2048])
+    assert torch.equal(_bits(z[:, 1024:2048]), _bits(want))
+    assert not z[:, :1024].any() and not z[:, 2048:].any()
+    # wo_b under TF_DSV41_PF_COPIES with bf16 exchanges: the GEMM's bf16 store == its fp32 output's .to(bf16)
+    wob = _lin(4096, 5120, 2)
+    want16 = PM.matmul(wob, x, torch.float32).to(torch.bfloat16)
+    assert torch.equal(_bits(PM.matmul(wob, x, torch.bfloat16)), _bits(want16))
+    a = torch.randn((R, 5120), device=DEV) * 3
+    b = torch.randn((R, 5120), device=DEV)
+    out = torch.empty((R, 5120), dtype=torch.bfloat16, device=DEV)
+    torch.add(a, b, out=out)
+    assert torch.equal(_bits(out), _bits((a + b).to(torch.bfloat16)))
+    t_two = _ms(lambda: (a + b).to(torch.bfloat16))
+    t_one = _ms(lambda: torch.add(a, b, out=out))
+    print(f"[G16] MoE partial at {R} rows: add + cast {t_two:.3f} ms, fused add -> bf16 {t_one:.3f} ms")
+
+
+@pytest.mark.parametrize("name", list(SHAPES))
+def test_prefill_tiles_same_bits(monkeypatch, name):
+    K, N = SHAPES[name]
+    lin = _lin(K, N, 7)
+    parts = PM.column_blocks(lin, PM.ws_limit())
+    x = (torch.randn(R, K) * 0.3).to(torch.bfloat16).to(DEV)
+    monkeypatch.delenv("TF_DSV41_PREFILL_TILES", raising=False)
+    want = PM.matmul(lin, x, torch.float32, parts)
+    base = _ms(lambda: PM.matmul(lin, x, torch.float32, parts), 5)
+    flops = 2.0 * R * K * N
+    line = [f"upstream {base:.3f} ms ({flops / base / 1e9:.0f} TFLOP/s)"]
+    for t in TILES:
+        monkeypatch.setenv("TF_DSV41_PREFILL_TILES", t)
+        try:
+            got = PM.matmul(lin, x, torch.float32, parts)
+        except Exception as exc:                        # noqa: BLE001 - an out-of-resources tile set: report, go on
+            line.append(f"{t} failed ({type(exc).__name__})")
+            continue
+        assert torch.equal(_bits(got), _bits(want)), t
+        ms = _ms(lambda: PM.matmul(lin, x, torch.float32, parts), 5)
+        line.append(f"{t} {ms:.3f} ms ({flops / ms / 1e9:.0f})")
+    print(f"[G16] prefill GEMM {name} {K}x{N} at {R} rows: " + "; ".join(line))
+
+
+def test_fast_prefill_copies_end_to_end(tmp_path_factory, monkeypatch):
+    import importlib.util
+    from pathlib import Path
+
+    import dsv41_dspark_fakes as DF
+
+    spec = importlib.util.spec_from_file_location("dsv41_prefill_gpu_g5b", Path(__file__).with_name(
+        "test_dsv41_prefill_gpu.py"))
+    G5 = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(G5)
+    PROMPT, build, prompt = G5.PROMPT, G5.build, G5.prompt
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the synthetic checkpoint's D is not the mHC kernels' 5,120
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    monkeypatch.setenv("TF_DSV41_ROPE_INPLACE", "1")
+    ck = DF.ckpt(tmp_path_factory.mktemp("dsv41g16"))
+    monkeypatch.setenv("TF_DSV41_PF_COPIES", "0")
+    off = prompt(build(ck, 1024), PROMPT)
+    monkeypatch.setenv("TF_DSV41_PF_COPIES", "1")
+    on = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(on, off)
+    assert torch.equal(prompt(build(ck, 96), PROMPT), on)
