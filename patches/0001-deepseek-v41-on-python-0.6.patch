+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Joint DSpark depth for a round of several decoding slots (``depth.Depth.choose_joint``, TF_DSV41_DEPTH_JOINT).
+
+A round verifies every slot's rows in ONE window (``rounds.Executor._windows``), so the round costs
+C(R) = verify ms of R total rows (``depth.Costs.rows_ms``: the calibration's table by total rows, ``calib.py``) plus
+fixed terms (the DSpark pass, the per-slot overhead) that no depth changes. Slot s verifying k_s drafts commits
+E_s(k_s) = 1 + q_1 + q_1 q_2 + ... tokens on average (``depth.py``). The joint depth maximizes
+
+    sum_s E_s(k_s) - lambda C(shared + sum_s (k_s + 1))
+
+with lambda the round's aggregate rate (all slots' committed tokens per modelled round-ms, ``Depth.joint_rate``): the
+renewal argument of ``glm5_next.spark.depth`` applied to the whole round, whose time all its slots share.
+
+The allocation is exact, not a stopping rule. Every candidate row costs the same C(R + 1) - C(R) whichever slot it
+joins (the cost depends on the total only), so the best ``m`` extra rows are the ``m`` largest marginal gains
+g_{s,j} = q_{s,1} ... q_{s,j+1} (the expected token draft j + 1 adds; non-increasing in j, so the top ``m`` are a
+prefix of every slot's chain: the greedy marginal allocation by dE / dC). Then ``m`` is chosen by scanning every
+total (C is a measured table with steps at the row-graph buckets, not necessarily convex, so the first row that does
+not pay is not where the scan stops). Ties go to fewer rows; the order (gain desc, slot index asc, position asc) is
+total, so both ranks pick the same rows from the same floats. No clocks, no randomness.
+
+Bounds: each slot's ``least`` (mode 1: 1, in a shared window the pass already ran and the first draft is verified;
+mode 2: 0, below) and ``top`` (the plan's depth, the DSpark block, the cap, the 16-row slot window), and ``max_rows``
+for the whole window (the largest row-graph bucket, TF_DSV41_GRAPH_ROWS_MAX, 64).
+
+**Mode 2 (G15b, TF_DSV41_DEPTH_JOINT=2).** G9 measured mode 1 against the independent depth on the old m2bench C2 /
+C4 cells (one run each) and left it off (C2 -2.1%). The simulation (``jointsim.py``: this module's policy on G14's
+measured window curve and G13's acceptance, 200 seeds) explains it. Those cells end with their slowest stream (C2's
+code stream finishes in ~100 rounds, prose runs ~130 more alone), and mode 1 trims the slow stream's rows to raise
+the shared rounds' aggregate: the steady aggregate goes up (C2 mixed +0.5%, C4 +1.0%) while the cells' wall-clock
+aggregate goes down (-0.3%, -0.9%). One 384-token run has a ~3% spread from acceptance alone, so G9's -2.1% is that
+expectation plus noise. VERSION 3's fitted table is a smaller effect (mode 1 priced from it: C2 mixed +0.4% / +0.0%;
+it costs the independent policy ~0.3%), and the allocation itself is exact (brute force, tests). Mode 2:
+
+- ``least`` 0 for every DSpark slot (TF_DSV41_DRAFT_SKIP on): a slot whose first draft is not worth a shared row
+  (prose with a low q_1: ~3 ms a row at the shared margin, against ~0.3 tokens) verifies only its pending row. The
+  zero-depth counterfactual (``Depth.bonus``) is per slot, so the calibration still learns from the unverified draft.
+  The fairness floor is that pending row: every slot commits >= 1 token every round, whatever the others draft;
+- the aggregate rate counts the round's host time (TF_DSV41_DEPTH_HOST_MS, default 3.0: G13's C2 rounds were 49.9
+  ms against 41.1 window + 5.0 pass), so lambda is the rate the round really runs at, not ~6% above it;
+- **fairness weights** (TF_DSV41_DEPTH_FAIR = alpha, default 0.5): slot s's tokens count w_s = (mean tpr / tpr_s) ^
+  alpha, tpr_s its recent tokens a round (its commits, ``Depth.slots``), normalized so sum w_s tpr_s = sum tpr_s
+  (lambda keeps its scale). alpha 0 = the pure aggregate; 0.5 keeps the slow stream of a mixed C2 at its
+  independent speed (alpha 0 slows it 6%, C4's 16%) and keeps most of the steady gain; 1 is proportional fairness
+  (sum of log rates).
+
+Simulated, mode 2 (alpha 0.5) over the independent depth, steady aggregate: C2 mixed +1.1% (wall-clock cell +0.7%),
+C2 code +0.8%, C2 prose +1.4%, C4 mixed +1.6% (cell -0.4%), C4 code +1.3%, C4 prose +3.9%. Alpha 0: C2 mixed +1.9%,
+C4 mixed +2.0%, their prose stream -6% / -16%.
+
+**Optimality (mode 2 included).** Every candidate row costs C(R + 1) - C(R) whichever slot it joins (the window's
+cost depends on its total rows only), and slot s's weighted marginal gains w_s q_1 ... q_{j+1} are non-increasing in
+j (each q <= 1, w_s > 0). For a fixed number ``m`` of extra rows the cost term is fixed, so the best allocation
+takes the ``m`` largest gains; because each chain is non-increasing (ties broken by position, ascending) those ``m``
+form a prefix of every slot's chain, i.e. a valid set of depths. Scanning every ``m`` (the table is not convex)
+gives the exact optimum: ``allocate`` == brute force over every allocation in the tests, weights and zero floors
+included.
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Callable, Sequence
+
+EPS = 1e-12
+ROWS_CAP = 64
+
+
+MODES = {"0": 0, "off": 0, "false": 0, "1": 1, "on": 1, "true": 1, "2": 2}
+FAIR = 0.5                      # TF_DSV41_DEPTH_FAIR (mode 2's alpha)
+HOST_MS = 3.0                   # TF_DSV41_DEPTH_HOST_MS (mode 2: a round's host time beside window + pass)
+TPR0 = 2.0                      # a slot's tokens a round before its first commit (``Depth.rate``'s prior)
+
+
+def env_mode() -> int:
+    """TF_DSV41_DEPTH_JOINT: 1 (branch default) = the joint depth for shared windows (G9); 2 = G15b's (zero floor,
+    host time in the rate, fairness weights); 0 = each slot alone (G8's policy, prod since G9)."""
+
+    v = os.environ.get("TF_DSV41_DEPTH_JOINT", "1").strip().lower() or "1"
+    if v not in MODES:
+        raise ValueError(f"TF_DSV41_DEPTH_JOINT={v!r}: expected 0, 1 or 2")
+    return MODES[v]
+
+
+def env_on() -> bool:
+    """The joint depth in any mode (TF_DSV41_DEPTH_JOINT 1 or 2)."""
+
+    return env_mode() > 0
+
+
+def _env_float(name: str, default: float, lo: float, hi: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    v = float(raw)
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={raw!r}: expected {lo} to {hi}")
+    return v
+
+
+def env_fair() -> float:
+    """TF_DSV41_DEPTH_FAIR: mode 2's fairness exponent alpha (0 = the pure aggregate, default 0.5, at most 4)."""
+
+    return _env_float("TF_DSV41_DEPTH_FAIR", FAIR, 0.0, 4.0)
+
+
+def env_host_ms() -> float:
+    """TF_DSV41_DEPTH_HOST_MS: mode 2's host ms a round outside the window and the pass (default 3.0)."""
+
+    return _env_float("TF_DSV41_DEPTH_HOST_MS", HOST_MS, 0.0, 100.0)
+
+
+def weights(tpr: Sequence[float | None], alpha: float) -> list[float]:
+    """Each slot's weight (mode 2): (mean tpr / tpr_s) ^ alpha, scaled so sum w_s tpr_s = sum tpr_s. ``tpr``: the
+    slots' recent tokens a round (None: no commit yet, ``TPR0``). All 1.0 when alpha is 0 or the slots are equal."""
+
+    t = [max(float(x if x is not None else TPR0), EPS) for x in tpr]
+    if not t or alpha <= 0.0:
+        return [1.0] * len(t)
+    m = sum(t) / len(t)
+    w = [(m / x) ** float(alpha) for x in t]
+    z = sum(t) / sum(a * b for a, b in zip(w, t))
+    return [a * z for a in w]
+
+
+def rows_cap() -> int:
+    """The widest window a round may verify: TF_DSV41_GRAPH_ROWS_MAX (64, the largest row-graph bucket)."""
+
+    raw = os.environ.get("TF_DSV41_GRAPH_ROWS_MAX", "").strip()
+    return max(1, min(int(raw), ROWS_CAP)) if raw else ROWS_CAP
+
+
+def gains(qs: Sequence[float], least: int, top: int) -> list[float]:
+    """Marginal expected tokens of drafts least+1 .. top: g_j = q_1 ... q_{j+1} for j = least .. top - 1."""
+
+    out, run = [], 1.0
+    for j in range(top):
+        run *= float(qs[j])
+        if j >= least:
+            out.append(run)
+    return out
+
+
+def allocate(qs: Sequence[Sequence[float]], least: Sequence[int], top: Sequence[int], *, shared: int,
+             rows_ms: Callable[[int], float], rate: float, max_rows: int = ROWS_CAP,
+             weight: Sequence[float] | None = None) -> tuple[list[int], float]:
+    """(each slot's k, the objective sum w E - rate x C(R) without the constant terms). ``qs[s]``: slot s's calibrated
+    chances (at least ``top[s]`` of them); ``shared``: rows of the round's other windows (lookup / plain); ``weight``:
+    each slot's token weight (mode 2's fairness, ``weights``; None = 1)."""
+
+    n = len(qs)
+    w = [1.0] * n if weight is None else [float(x) for x in weight]
+    lo = [max(0, min(int(least[s]), int(top[s]))) for s in range(n)]
+    base = int(shared) + sum(1 + lo[s] for s in range(n))
+    cands = []
+    for s in range(n):
+        for i, g in enumerate(gains(qs[s], lo[s], max(lo[s], int(top[s])))):
+            cands.append((-g * w[s], s, lo[s] + i))
+    cands.sort()
+    room = max(0, int(max_rows) - base)
+    best_m, best, acc = 0, -rate * rows_ms(base), 0.0
+    for m in range(1, min(room, len(cands)) + 1):
+        acc += -cands[m - 1][0]
+        v = acc - rate * rows_ms(base + m)
+        if v > best + EPS:
+            best_m, best = m, v
+    ks = list(lo)
+    for _, s, _ in cands[:best_m]:
+        ks[s] += 1
+    return ks, best
+
+
+def objective(qs: Sequence[Sequence[float]], ks: Sequence[int], least: Sequence[int], *, shared: int,
+              rows_ms: Callable[[int], float], rate: float, weight: Sequence[float] | None = None) -> float:
+    """``allocate``'s objective of a given allocation (tests: brute force)."""
+
+    tot, rows = 0.0, int(shared)
+    for s, k in enumerate(ks):
+        lo = int(least[s])
+        tot += (1.0 if weight is None else float(weight[s])) * sum(gains(qs[s], lo, int(k)))
+        rows += 1 + int(k)
+    return tot - rate * rows_ms(rows)
+
+
+__all__ = ["FAIR", "HOST_MS", "MODES", "ROWS_CAP", "TPR0", "allocate", "env_fair", "env_host_ms", "env_mode", "env_on",
+           "gains", "objective", "rows_cap", "weights"]
