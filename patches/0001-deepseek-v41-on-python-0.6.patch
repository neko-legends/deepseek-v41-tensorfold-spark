+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+void gateup(const at::Tensor& XG, const at::Tensor& XU, const at::Tensor& TG, const at::Tensor& TU,
+            const at::Tensor& uids, const at::Tensor& ucount, const at::Tensor& members, const at::Tensor& svh_g,
+            const at::Tensor& svh_u, const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t slots,
+            double limit) {
+    check(XG, at::kHalf, "XG");
+    check(XU, at::kHalf, "XU");
+    check(TG, at::kInt, "TG");
+    check(TU, at::kInt, "TU");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(XG.size(-1) == K && XU.size(-1) == K && xd.size(-1) == N, "gateup: X [P, K], Xd [P, N]");
+    TORCH_CHECK(TG.size(1) * 16 == K && TG.size(2) * 16 == N && TG.sizes() == TU.sizes(), "gateup: trellis shapes");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup: scales [E, N]");
+    c10::cuda::CUDAGuard guard(XG.device());
+    exl3_fast_gateup_cuda(XG, XU, TG, TU, uids, ucount, members, svh_g, svh_u, suh_d, xd, K, N, slots, limit);
+}
+
+void down(const at::Tensor& XD, const at::Tensor& TD, const at::Tensor& uids, const at::Tensor& ucount,
+          const at::Tensor& members, const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t slots) {
+    check(XD, at::kHalf, "XD");
+    check(TD, at::kInt, "TD");
+    check(uids, at::kInt, "uids");
+    check(ucount, at::kInt, "ucount");
+    check(members, at::kInt, "members");
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
