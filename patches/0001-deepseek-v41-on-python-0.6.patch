+    assert [int(v) != DROP for v in p[0, :K]] == [True, True, False, False, False, False]
+    p, _ = PR.reference(pick, wts, K, PR.Rule(topp=0.99, min_k=1), 1.5, DROP)
+    kept = [i for i in range(K) if int(p[0, i]) != DROP]
