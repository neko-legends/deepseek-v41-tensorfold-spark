index 0000000..4e0f59c
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/xmap.py
@@ -0,0 +1,448 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G15 "expert map": prefetch the routed experts a layer is about to read into L2 from a device-side map of expert
+ids, and the routing-trace collector that measures how predictable the map is (``TF_DSV41_XMAP``; default off).
+
+Why (G15's study; the window section is in the development tree (unpublished)). The decode window is a stream of weight bytes with
+latency-bound gaps; G10 / G14's L2PF already fills the gaps around the exchanges with the NEXT dense weights (known
+in advance). The routed experts are not known until the router, so the one gap nothing fills today is the MoE
+chain's head: router -> prune -> 2 casts -> group -> rot_in (G14a hardware trace: ~14 us after the router at 1 row,
+~21 us at 4 rows) before ``x3ld``'s gate/up launch starts reading its experts cold. ``x3ld`` sweeps z = (gate,
+split 0), (gate, split 1), ... over every distinct expert, so the first thing it reads is a contiguous prefix of
+each expert's gate trellis (one split = 540 KiB at 3 bits on a rank): that prefix is what goes into L2 here.
+
+Maps (``TF_DSV41_XMAP``):
+
+``post``  the router's own picks of THIS window (exact: no prediction), right after the router, on a side stream: the
+          prefetch runs beside prune / casts / group / rot_in and the start of x3ld. Pruned slots (an id past the
+          table) and the shared entry (L2PF's site f has it) are skipped; pre-prune picks over-fetch at most the
+          pruned tail.
+``prev``  the same layer's picks of the PREVIOUS window (a temporal map: consecutive tokens / a stream's rows reuse
+          experts), recorded on the device by every window, prefetched at ``TF_DSV41_XMAP_SITE`` (``b``: after the
+          attention exchange, before the mHC boundary; ``f``: with L2PF's site f) - ~60-80 us earlier than ``post``.
+``both``  ``prev`` at the site, then ``post`` (lines already in L2 cost nothing to request again).
+
+Distinct ids are ordered by votes (rows that picked them; ties: first appearance) and taken up to
+``TF_DSV41_XMAP_MB`` (default 4) a launch, ``TF_DSV41_XMAP_KB`` a expert (0 = one gate split: the launch's first
+z step). ``TF_DSV41_XMAP_ROWS`` (16): wider windows skip it all. ``TF_DSV41_XMAP_GBPS`` (0) paces the prefetch
+(``prev`` at site f should be paced like L2PF's: the exchange is beside it).
+
+The collector (``TF_DSV41_XMAP_TRACE=<dir>``): every window of <= ROWS rows records its picks [layers, rows, 7]
+into a device ring (``record`` kernels inside the graphs: 40 tiny launches a window), closes the window (``advance``),
+and the host drains the ring every W / 2 windows to ``<dir>/xmap-r<rank>-<pid>-<n>.npz`` (+ ``.jsonl`` with each
+window's slots / positions / ids). ``TF_DSV41_XMAP_TRACE_PREGATE=1`` also records two predictions a layer, from the
+real hidden state through the real gate (torch ops inside the graph; trace runs only, never timed): ``pre_next[L]``
+= top-6 of layer L's gate on layer L-1's MoE input ("pre-gating", AdapMoE-style), ``pre_attn[L]`` = top-6 of layer
+L's gate on layer L's attention input (one attention block of lead). ``scripts/windows/g15_xmap_report.py`` (notes
+repo) turns the files into hit rates, U(R) and the bytes model.
+
+Exactness: the prefetch kernel only reads the ids, the gate pointer table and widths, and prefetches weight memory
+into L2; the record / advance kernels write only this module's ring, which no model kernel reads; pregate trace ops
+read model tensors and write only their own temporaries. Every model kernel runs with the same arguments in the same
+stream order, and the side stream joins before the window returns (as L2PF's): the bits are unchanged.
+``post`` reads the pick tensor on the side stream while the main stream's prune rewrites it in place: the prefetch
+then sees an id from before or after pruning (both a real expert or one past the table, skipped). Only which bytes
+are prefetched can change; nothing the model reads or writes does.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from dataclasses import dataclass, field
+from functools import lru_cache
+from pathlib import Path
+
+ENV = "TF_DSV41_XMAP"
+MODES = ("post", "prev", "both")
+SITES = ("b", "f")
+MAXP = 128                     # ids a map (xmap.cu MAXP): rows x slots
+SLOTS = 7                      # routed top-6 + the shared entry (experts.MODEL.slots)
+TOPK = 6
+
+
+@dataclass(frozen=True)
+class Settings:
+    mode: str | None = None
+    kb: int = 0                       # bytes a expert (KiB; 0 = one gate split)
+    mb: float = 4.0                   # bytes a launch (MiB)
+    rows: int = 16
+    site: str = "b"
+    gbps: float = 0.0
+    chunk_kb: int = 32
+    trace: str = ""
+    pregate: bool = False
+    ring: int = 256
+
+    @property
+    def prefetch(self) -> bool:
+        return self.mode is not None
+
+    @property
+    def records(self) -> bool:
+        return self.mode in ("prev", "both") or bool(self.trace)
+
+
+def _num(env, name, default, lo, hi, kind=float):
+    raw = str(env.get(name, "")).strip()
+    if not raw:
+        return default
+    try:
+        v = kind(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def settings(env: dict | None = None) -> Settings:
+    env = os.environ if env is None else env
+    raw = str(env.get(ENV, "")).strip().lower()
+    mode = None if raw in ("", "0", "off", "none", "false") else raw
+    if mode is not None and mode not in MODES:
+        raise ValueError(f"{ENV}={raw!r}: expected 0, post, prev or both")
+    site = str(env.get(ENV + "_SITE", "")).strip().lower() or "b"
+    if site not in SITES:
+        raise ValueError(f"{ENV}_SITE={site!r}: expected b or f")
+    rows = int(_num(env, ENV + "_ROWS", 16, 1, MAXP // SLOTS, int))
+    pre = str(env.get(ENV + "_TRACE_PREGATE", "")).strip().lower() not in ("", "0", "off", "false", "no")
+    trace = str(env.get(ENV + "_TRACE", "")).strip()
+    if pre and not trace:
+        raise ValueError(f"{ENV}_TRACE_PREGATE needs {ENV}_TRACE=<dir>")
+    return Settings(mode, int(_num(env, ENV + "_KB", 0, 0, 1 << 20, int)), float(_num(env, ENV + "_MB", 4.0, 0.0625, 12.0)),
+                    rows, site, float(_num(env, ENV + "_GBPS", 0.0, 0.0, 2000.0)),
+                    int(_num(env, ENV + "_CHUNK_KB", 32, 1, 1024, int)), trace, pre,
+                    int(_num(env, ENV + "_TRACE_W", 256, 4, 65536, int)))
+
+
+# -- the selection, on the host (xmap.cu select_ids, statement for statement) ---------------------------------------
+def slab_bytes(K: int, N: int, SK: int, k2: int) -> int:
+    """Bytes of one K split of a [K, N] trellis at ``k2`` half-bits: x3ld's first z step of an expert's gate."""
+
+    return (K // 16) // SK * (N // 16) * 16 * int(k2)
+
+
+def select_host(ids, E: int, k2, K: int, N: int, SK: int, cap: int, budget: int) -> list[tuple[int, int]]:
+    """(expert, prefix bytes) in issue order for a map ``ids`` ([R][S] ints): ids outside [0, E) dropped, distinct
+    ids by (votes desc, first appearance asc), each min(slab, cap or slab), the budget cut, 16-byte multiples."""
+
+    flat = [int(v) for row in ids for v in row]
+    if not flat or len(flat) > MAXP:
+        return []
+    flat = [v if 0 <= v < E else -1 for v in flat]
+    votes: dict[int, int] = {}
+    first: dict[int, int] = {}
+    for i, v in enumerate(flat):
+        if v < 0:
+            continue
+        votes[v] = votes.get(v, 0) + 1
+        first.setdefault(v, i)
+    order = sorted(votes, key=lambda e: (-votes[e], first[e]))
+    out, used = [], 0
+    for e in order:
+        if used >= budget:
+            break
+        take = slab_bytes(K, N, SK, k2[e])
+        if cap > 0:
+            take = min(take, cap)
+        take = min(take, budget - used) & ~15
+        if take == 0:
+            break
+        out.append((e, take))
+        used += take
+    return out
+
+
+def pace_ns(chunk: int, gbps: float) -> int:
+    return 0 if gbps <= 0 else max(1, int(round(chunk / gbps)))
+
+
+# -- the device side -------------------------------------------------------------------------------------------------
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).resolve().parent
+    return load(name="tf_dsv41_xmap_v1", sources=[str(here / "xmap.cpp"), str(here / "xmap.cu")],
+                extra_cflags=["-O2"], extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@dataclass
+class Layer:
+    index: int                 # position in the ring (the block's order)
+    ex: object                 # experts.Experts.ex (gate_ptr / gate_k2)
+    E: int
+    K: int
+    N: int
+    SK: int
+    gate: object = None        # the router's weight / bias (pregate trace)
+    bias: object = None
+    topk: int = TOPK
+
+
+@dataclass
+class Stats:
+    post: int = 0
+    prev: int = 0
+    records: int = 0
+    windows: int = 0
+    skipped_rows: int = 0
+    drained: int = 0
+    files: list = field(default_factory=list)
+
+
+class XMap:
+    def __init__(self, blocks: list, device, s: Settings) -> None:
+        import torch
+
+        from . import experts as X
+
+        self.torch, self.s, self.device = torch, s, device
+        self.stats = Stats()
+        self.layers: dict[int, Layer] = {}
+        for i, blk in enumerate(blocks):
+            m = getattr(blk, "moe", None)
+            ex = getattr(getattr(m, "block", None), "ex", None)
+            if ex is None:
+                continue
+            geom = m.block.geom
+            try:
+                (_, _, sk, _), _ = X.configs_host(geom)
+            except ValueError:
+                sk = 0
+            if int(ex.dims) % 16 or int(ex.width) % 16 or not sk or (int(ex.dims) // 16) % sk \
+                    or getattr(ex, "widths", None) is not None:     # TF_DSV41_EXPERT_ROTATE: no byte ranges yet
+                sk = 0                                      # no prefetch for this shape (records still run)
+            self.layers[id(m)] = Layer(i, ex, geom.experts, int(ex.dims), int(ex.width), sk,
+                                       getattr(m, "gate", None), getattr(m, "bias", None), int(geom.topk))
+            m.xmap = self
+        self.by_index = {L.index: L for L in self.layers.values()}
+        self.slots = max([m.block.geom.slots for m in (getattr(b, "moe", None) for b in blocks)
+                          if getattr(getattr(m, "block", None), "geom", None) is not None] or [SLOTS])
+        self.topk = max([L.topk for L in self.layers.values()] or [TOPK])
+        if s.rows * self.slots > MAXP:
+            raise ValueError(f"{ENV}_ROWS={s.rows}: {s.rows} x {self.slots} ids over the map's {MAXP}")
+        self.nlayers = len(blocks)
+        self.budget = int(s.mb * 2**20)
+        self.cap = int(s.kb) * 1024
+        self.chunk = int(s.chunk_kb) * 1024
+        self.ns = pace_ns(self.chunk, s.gbps)
+        self.ext = _ext()
+        self.side = torch.cuda.Stream(device=device)
+        self.pending = False
+        self._cap = False
+        W = s.ring if s.trace else 2
+        self.W = W
+        if s.records:
+            self.ring = torch.full((W, self.nlayers, s.rows, self.slots), -1, dtype=torch.int32, device=device)
+            self.ctr = torch.zeros((1,), dtype=torch.int64, device=device)
+            self.hdr = torch.zeros((W,), dtype=torch.int32, device=device)
+        if s.pregate:
+            self.pre_next = torch.full((W, self.nlayers, s.rows, self.topk), -1, dtype=torch.int32, device=device)
+            self.pre_attn = torch.full_like(self.pre_next, -1)
+        self.meta: list = []                 # host notes of the windows not drained yet, in device order
+        self.done = 0                        # windows drained
+        self.rank = 0
+        self.segs = None
+        self.prefill = False
+
+    # -- forks ------------------------------------------------------------------------------------------------------
+    def _fork(self):
+        torch = self.torch
+        cur = torch.cuda.current_stream()
+        cap = torch.cuda.is_current_stream_capturing()
+        if self.pending and cap != self._cap:
+            self.pending = False
+        self.side.wait_stream(cur)
+        self._cap, self.pending = cap, True
+        return torch.cuda.stream(self.side)
+
+    def join(self) -> None:
+        torch = self.torch
+        if self.pending:
+            if torch.cuda.is_current_stream_capturing() == self._cap:
+                torch.cuda.current_stream().wait_stream(self.side)
+            self.pending = False
+
+    # -- hooks --------------------------------------------------------------------------------------------------------
+    def picked(self, moe, pick, R: int) -> None:
+        """Right after the router (this window's picks): the exact map (``post`` / ``both``)."""
+
+        if self.s.mode not in ("post", "both"):
+            return
+        L = self.layers.get(id(moe))
+        if L is None or not L.SK:
+            return
+        if R > self.s.rows:
+            self.stats.skipped_rows += 1
+            return
+        with self._fork():
+            self.ext.prefetch_now(pick, L.ex.gate_ptr, L.ex.gate_k2, L.E, L.K, L.N, L.SK, self.cap, self.budget,
+                                  self.chunk, self.ns)
+        self.stats.post += 1
+
+    def routed(self, moe, x, pick, R: int) -> None:
+        """After pruning (the picks x3ld reads): record them (``prev`` / ``both`` / the trace) and the pregate."""
+
+        if not self.s.records or R > self.s.rows:
+            return
+        L = self.layers.get(id(moe))
+        if L is None:
+            return
+        self.ext.record(pick, self.ring, self.ctr, L.index)
+        self.stats.records += 1
+        if self.s.pregate:
+            nxt = self.by_index.get(L.index + 1)
+            if nxt is not None and nxt.gate is not None:
+                self.ext.record(self._pregate(x, nxt), self.pre_next, self.ctr, nxt.index)
+
+    def attn_input(self, blk, out, n: int) -> None:
+        """The block's attention input (trace + pregate): its own gate on it, one attention block of lead."""
+
+        if not self.s.pregate or n > self.s.rows:
+            return
+        L = self.layers.get(id(getattr(blk, "moe", None)))
+        if L is not None and L.gate is not None:
+            self.ext.record(self._pregate(out[:n], L), self.pre_attn, self.ctr, L.index)
+
+    def _pregate(self, x, L: Layer):
+        """Top-6 of sqrt(softplus(x G^T)) + bias (the router's selection rule, fp32; a prediction, not the router)."""
+
+        torch = self.torch
+        lg = (x.to(torch.float32) @ L.gate.to(torch.float32).t())
+        s = torch.sqrt(torch.nn.functional.softplus(lg))
+        if L.bias is not None:
+            s = s + L.bias.to(torch.float32)
+        return torch.topk(s, L.topk, dim=-1, sorted=True).indices.to(torch.int32).contiguous()
+
+    def site(self, blk, site: str, n: int) -> None:
+        """A site of the block before its router: the previous window's map of this layer (``prev`` / ``both``)."""
+
+        if self.s.mode not in ("prev", "both") or site != self.s.site:
+            return
+        L = self.layers.get(id(getattr(blk, "moe", None)))
+        if L is None or not L.SK or n > self.s.rows:
+            return
+        with self._fork():
+            self.ext.prefetch_prev(self.ring, self.ctr, self.hdr, L.index, L.ex.gate_ptr, L.ex.gate_k2, L.E, L.K, L.N,
+                                   L.SK, self.cap, self.budget, self.chunk, self.ns)
+        self.stats.prev += 1
+
+    def end(self, n: int) -> None:
+        """The window's end (inside it: before the forward returns): join the side stream, close the window."""
+
+        self.join()
+        if not self.s.records or n > self.s.rows:
+            return
+        self.ext.advance(self.ctr, self.hdr, n)
+        self.stats.windows += 1
+        if self.s.trace and not self.torch.cuda.is_current_stream_capturing():
+            self.note(self.segs, n, "eager")             # segs None: a window no ``run`` began (CED replay): unnamed
+        self.segs = None
+
+    # -- the collector's host side ------------------------------------------------------------------------------------
+    def note(self, segs, rows: int, kind: str) -> None:
+        """One executed window (eager here, a replay from the graph runners), in device order."""
+
+        if not self.s.trace or rows > self.s.rows:
+            return
+        segs = segs or []
+        self.meta.append({"kind": kind, "rows": int(rows), "prefill": bool(self.prefill and kind == "eager"),
+                          "segs": [[int(sg.slot), int(sg.start), [int(t) for t in sg.ids]] for sg in segs]})
+        if len(self.meta) >= self.W // 2:
+            self.drain()
+
+    def drain(self) -> None:
+        if not self.s.trace or not self.meta:
+            return
+        import numpy as np
+
+        torch = self.torch
+        torch.cuda.synchronize(self.device)
+        c = int(self.ctr.item())
+        n = min(len(self.meta), c - self.done, self.W)
+        if n <= 0:
+            self.meta.clear()
+            return
+        idx = [(self.done + i) % self.W for i in range(n)]
+        it = torch.tensor(idx, dtype=torch.long, device=self.device)
+        arrays = {"picks": self.ring.index_select(0, it).cpu().numpy(), "rows": self.hdr.index_select(0, it).cpu().numpy(),
+                  "seq": np.arange(self.done, self.done + n, dtype=np.int64)}
+        if self.s.pregate:
+            arrays["pre_next"] = self.pre_next.index_select(0, it).cpu().numpy()
+            arrays["pre_attn"] = self.pre_attn.index_select(0, it).cpu().numpy()
+        out = Path(self.s.trace)
+        out.mkdir(parents=True, exist_ok=True)
+        stem = out / f"xmap-r{self.rank}-{os.getpid()}-{self.done:08d}"
+        np.savez_compressed(str(stem) + ".npz", **arrays)
+        lost = len(self.meta) - n
+        with open(str(stem) + ".jsonl", "w") as f:
+            for i, m in enumerate(self.meta[:n]):
+                f.write(json.dumps({"seq": self.done + i, **m}) + "\n")
+            if lost:
+                f.write(json.dumps({"warning": f"{lost} host notes without a device window (dropped)"}) + "\n")
+        self.stats.files.append(str(stem))
+        self.done += n
+        self.stats.drained += n
+        self.meta.clear()
+
+
+def install(fw, device) -> XMap | None:
+    """At forward build (before any capture): the map on every block's MoE (``moe.xmap``) when ``TF_DSV41_XMAP`` or
+    the trace is on and the device is CUDA; else None and nothing changes."""
+
+    s = settings()
+    import torch
+
+    dev = torch.device(device)
+    if not (s.prefetch or s.trace) or dev.type != "cuda" or not torch.cuda.is_available():
+        return None
+    xm = XMap(fw.blocks, dev, s)
+    xm.rank = int(getattr(fw, "rank", 0) or 0)
+    for blk in fw.blocks:
+        blk.xmap = xm
+    fw.xmap = xm
+    if s.trace:
+        import atexit
+
+        atexit.register(xm.drain)
+    print(f"[dsv41] xmap: {s.mode or 'trace only'}, {xm.budget / 2**20:g} MiB a launch, "
+          f"{'one gate split' if not s.kb else f'{s.kb} KiB'} an expert, site {s.site}, windows <= {s.rows} rows"
+          f"{f', paced {s.gbps:g} GB/s' if s.gbps else ''}{f'; trace -> {s.trace} (W {xm.W})' if s.trace else ''}"
+          f"{' + pregate' if s.pregate else ''}", flush=True)
+    return xm
+
+
+# -- the forward's hooks (off: one attribute lookup each) --------------------------------------------------------------
+def site(blk, name: str, n: int) -> None:
+    xm = getattr(blk, "xmap", None)
+    if xm is not None:
+        xm.site(blk, name, n)
+
+
+def attn_input(blk, out, n: int) -> None:
+    xm = getattr(blk, "xmap", None)
+    if xm is not None:
+        xm.attn_input(blk, out, n)
+
+
+def end(fw, n: int) -> None:
+    xm = getattr(fw, "xmap", None)
+    if xm is not None:
+        xm.end(n)
+
+
+def begin(fw, segs, prefill: bool = False) -> None:
+    xm = getattr(fw, "xmap", None)
+    if xm is not None:
+        xm.segs, xm.prefill = segs, bool(prefill)
+
+
+def replayed(fw, segs, rows: int) -> None:
+    xm = getattr(fw, "xmap", None)
+    if xm is not None:
+        xm.note(segs, rows, "replay")
+
+
+__all__ = ["ENV", "MODES", "Settings", "XMap", "install", "select_host", "settings", "slab_bytes"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/xovl.py b/src/tensorfold/families/deepseek_v41/cuda/xovl.py
new file mode 100644
index 0000000..462a399
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/xovl.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_XOVL``: a prefill segment's two exchanges a block overlapped with compute, by row halves.
+
+Today, per block of a 2,048-row segment: ``wo_b`` (all rows) -> all-gather (21 MB a rank bf16; 42 MB fp32 under the
+strict receipt) -> the mHC boundary (all rows) -> the MoE (all rows) -> all-gather -> the next boundary. Nothing runs
+while an exchange is on the wire: G5's nsys has ~1.0-1.5 ms a 21 MB gather, ~2.2 ms a 42 MB one, 80 a full-prefill
+segment (~88 ms of ~2.1 s with bf16 partials, ~180 ms strict).
+
+Here the rows of every prefill exchange go in two halves on a side stream:
+
+- attention: ``wo_b`` over rows [0, h) -> its gather starts (side stream) while ``wo_b`` runs over [h, n) -> the
+  second gather starts; the boundary runs over [0, h) as soon as the first gather lands (it overlaps the second),
+  then over [h, n);
+- MoE: the partial (all rows: the routed experts read every expert once a segment, so they never split) is sent in
+  two halves the same way; the next block's boundary (or the Engram post, or the final post) runs its rows [0, h)
+  under the second half's gather.
+
+Exact: ``wo_b`` (``exl3.prefill`` GEMM: tiles fixed by the shape, rows independent), the mHC boundary / post / final
+(rows independent, any row range: tested), and the exchange (a copy) give each row the same bits whatever the split;
+the ranks issue the same gathers in the same order (one side stream, in program order), so the collectives stay
+paired. On the CPU (the TP thread tests) the halves run in order without streams: the same values.
+
+The NCCL kernel of a 21 MB RING_LL all-gather is 64 CTAs with ~98 KB of shared memory each (G5's trace): beside
+compute it would hold whole SMs, so the window runs this with ``NCCL_MAX_NCHANNELS=4 NCCL_PROTO=Simple``
+(g16prefill.sh ``xovl``; ``nccl4`` measures those words alone).
+
+Expected (one rank, 2,048 rows): an exchange hides behind ``wo_b``'s second half (~0.7 ms) and the boundary's first
+half (~0.7-1.5 ms): ~-0.8 to -1.0 ms an exchange with bf16 partials (-60 to -80 ms a full segment, +3-4%), ~-1.5 to
+-1.8 ms strict (-120 to -140 ms, +6-7%), before SM contention. Knobs: ``TF_DSV41_PF_XOVL`` (0 / 1),
+``TF_DSV41_PF_XOVL_ROWS`` (512: the fewest rows a segment splits).
+"""
+
+from __future__ import annotations
+
+import copy
+import os
+
+import torch
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_PF_XOVL", "").strip() or "0") not in ("0", "off", "no", "false")
+
+
+def min_rows() -> int:
+    n = int(os.environ.get("TF_DSV41_PF_XOVL_ROWS", "").strip() or 512)
+    if n < 32:
+        raise ValueError(f"TF_DSV41_PF_XOVL_ROWS={n}: at least 32")
+    return n
+
+
+def active(fw, n: int) -> bool:
+    """A prefill segment of the forward ``fw`` (``n`` rows) that splits its exchanges."""
+
+    from . import prefill_mm as PM
+
+    # each half stays a prefill exchange (> ``chunk`` rows): a decode-sized one would reuse the forward's two
+    # persistent receive buffers, which a side-stream gather must not share with the main stream
+    return enabled() and fw.world > 1 and (n // 2) // 16 * 16 > fw.chunk and n >= min_rows() and PM.active()
+
+
+def spans(n: int) -> list[tuple[int, int]]:
+    """Two row halves, the first a multiple of 16 rows (whole tiles for the 16 / 64 / 128-row kernels)."""
+
+    h = max(16, (n // 2) // 16 * 16)
+    return [(0, h), (h, n)]
+
+
+_SIDE: dict = {}
+
+
+def _side(device) -> torch.cuda.Stream:
+    key = str(device)
+    s = _SIDE.get(key)
+    if s is None:
+        s = _SIDE[key] = torch.cuda.Stream(device=device)
+    return s
+
+
+class Split:
+    """One exchange's halves: ``send(a, b, part)`` gathers rows [a, b) (on the side stream on CUDA), ``wait(i)``
+    makes the current stream wait for half i; ``parts[i]`` is half i's gathered [W, b - a, D]."""
+
+    def __init__(self, fw, n: int) -> None:
+        self.fw, self.n = fw, n
+        self.spans: list[tuple[int, int]] = []
+        self.parts: list[torch.Tensor] = []
+        self.done: list = []
+
+    @staticmethod
+    def spans_of(n: int) -> list[tuple[int, int]]:
+        return spans(n)
+
+    def send(self, a: int, b: int, part: torch.Tensor) -> None:
+        if part.shape[0] != b - a:
+            raise ValueError(f"xovl: a [{a}, {b}) half with {part.shape[0]} rows")
+        if not part.is_cuda:
+            self.spans.append((a, b))
+            self.parts.append(self.fw.gather_partials(part))
+            self.done.append(None)
+            return
+        cur = torch.cuda.current_stream(part.device)
+        side = _side(part.device)
+        ready = torch.cuda.Event()
+        ready.record(cur)
+        with torch.cuda.stream(side):
+            side.wait_event(ready)
+            got = self.fw.gather_partials(part)
+            fin = torch.cuda.Event()
+            fin.record(side)
+        part.record_stream(side)            # the caching allocator: part lives until the side stream used it
+        got.record_stream(cur)              # and the gathered rows until the main stream has read them
+        self.spans.append((a, b))
+        self.parts.append(got)
+        self.done.append(fin)
+
+    def wait(self, i: int) -> None:
+        if self.done[i] is not None:
+            torch.cuda.current_stream(self.parts[i].device).wait_event(self.done[i])
+
+
+def coefs_view(c, a: int, b: int):
+    """The coefficient sets of rows [a, b) (views: the boundary writes the caller's rows)."""
+
+    return type(c)(b - a, c.pre.device, pre=c.pre[a:b], post=c.post[a:b], comb=c.comb[a:b])
+
+
+def scratch_view(s, a: int, b: int):
+    v = copy.copy(s)
+    v.rows = b - a
+    if hasattr(s, "part"):
+        v.part = s.part[a:b]
+    v.c = s.c[a:b]
+    return v
+
+
+def _rows(t, a: int, b: int):
+    return None if t is None else t[a:b]
+
+
+def boundary(ops, x, xout, sp: Split, prev, hc, norm_w, out, coefs, scratch, tap=None) -> None:
+    """``ops.boundary`` half by half, each after its gather landed."""
+
+    for i, (a, b) in enumerate(sp.spans):
+        sp.wait(i)
+        ops.boundary(x[a:b], xout[a:b], sp.parts[i], coefs_view(prev, a, b), hc, norm_w, out[a:b],
+                     coefs_view(coefs, a, b), scratch_view(scratch, a, b), _rows(tap, a, b))
+
+
+def post_only(ops, x, xout, sp: Split, prev, tap=None) -> None:
+    for i, (a, b) in enumerate(sp.spans):
+        sp.wait(i)
+        ops.post_only(x[a:b], xout[a:b], sp.parts[i], coefs_view(prev, a, b), _rows(tap, a, b))
+
+
+def final(ops, x, xout, sp: Split, prev, norm_w, out, scratch, tap=None) -> None:
+    for i, (a, b) in enumerate(sp.spans):
+        sp.wait(i)
+        ops.final(x[a:b], xout[a:b], sp.parts[i], coefs_view(prev, a, b), norm_w, out[a:b],
+                  scratch_view(scratch, a, b), _rows(tap, a, b))
+
+
+__all__ = ["Split", "active", "boundary", "coefs_view", "enabled", "final", "min_rows", "post_only",
+           "scratch_view", "spans"]
