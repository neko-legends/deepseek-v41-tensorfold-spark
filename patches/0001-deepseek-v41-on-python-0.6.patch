+def test_dup_mode_points_at_top_expert():
+    pick, wts = _row(HALVES, ids=[7, 8, 9, 10, 11, 12])
+    p, w = PR.reference(pick, wts, K, PR.Rule(topp=0.875, min_k=1), 1.5, DROP, dup=True)
+    assert p[0, :K].tolist() == [8, 8, 8, 10, 8, 12] and float(w[0, 0]) == 0.0 and float(w[0, 2]) == 0.0
+    assert PR.kept(p, K, DROP).tolist() == [3]
