+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G19: adaptive prefill rows and the graph caches' prefill-dip rule, on the CPU.
+
+- ``memory.Adapt``: the steps (full, half, quarter, ... >= the minimum), the choice from the tighter rank's usable
+  memory less the round's priced transient (``memory.round_need``), the hysteresis on the way up;
+- the batcher on the real CPU forward (the fake checkpoint), full (with and without TF_DSV41_FULL_CONE) and replay: rounds whose rows follow a
+  scripted memory (64 / 32 / 16 a round, ``plan.release`` on each step down) give the same replies (greedy and
+  sampled) and the same stored snapshots (every array, bit for bit) as fixed 64-row rounds: prefill is
+  segmentation-invariant, so the rows a round never change the logits;
+- admission prices a prompt at the smallest step; ``TF_DSV41_PREFILL_ADAPT=0`` is the fixed rows of before;
+- ``graphs.GraphCache``: a capture refused for memory within ``TF_DSV41_GRAPH_DIP_ROUNDS`` rounds of a prefill
+  evicts nothing (deferred), a dip in a decode-only stretch evicts a quarter as before; ``graphs.Recent`` counts the
+  plans' rounds the same way on both ranks.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import graphs as G  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import memory as M  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.plan import Plan  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.sessions import Store, Tag  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.slots import SlotsForward  # noqa: E402
+
+GiB = 1 << 30
+WIN = 16
+SHAPES = dict(num_attention_heads=16, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=WIN, rms_norm_eps=1e-20)
+RNG = np.random.default_rng(23)
+PROMPTS = [[int(t) for t in RNG.integers(3, 256, size=n)] for n in (230, 150, 97)]
+SAMPLINGS = [None, Sampling(5, 0.8, 20, 0.95), None]
