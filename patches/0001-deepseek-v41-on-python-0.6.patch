index 0000000..fc23aab
--- /dev/null
+++ b/tests/test_dsv41_attn_cuda_compile.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""REWRITE-PLAN 5's kernels (``csa2/attn_cuda.cu``, ``csa2/topk_cuda.cu``; TF_DSV41_ATTN_CUDA) build for sm_121 (GB10)
+without torch headers (-DDSV41_ATTN_NO_TORCH): the 8 attention instances (kWidth 2 / 4, row mode, DSpark ends) and
+the cluster top-k, no register spills and no local memory, attention <= 255 registers at 256 threads (1 CTA an SM:
+98.8 KB of shared memory), top-k <= 128 at 512 threads; the PTX holds the instructions the bit-for-bit claim needs
+(mma.sync m16n8k16 bf16 -> f32, ex2.approx.f32 never .ftz, div.full.f32, cvt.rn.f16x2.e4m3x2, cvt.rn.bf16x2.f32,
+barrier.cluster in the top-k).
+
+Tripwires on the Triton side (this machine's Triton, compiled offline for sm_121): ``_chunks``' dot operands have the
+layout ``attn_cuda.kwidth`` reads (nvidia_mma v2, warpsPerCTA [1, 8], kWidth 4) and its PTX has the operation mix
+attn_cuda.cu mirrors (96 mma.sync, 12 ex2.approx.f32, exactly 4 fma.rn.f32: fma(l, alpha, sum) x 2 paths x 2 rows;
+sums through shfl.bfly 2 then 1); ``_merge``'s has div.full.f32 and fma.rn.f32x2 (fma(o, a, rn(co * b))). Needs an
+nvcc that knows compute_121 (TF_NVCC, PATH or CUDA_HOME) and Triton with its bundled ptxas."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+D = Path(__file__).resolve().parents[1] / "src/tensorfold/families/deepseek_v41/cuda/csa2"
+INSTANCES = [(kw, rows, hi) for kw in (2, 4) for rows in (0, 1) for hi in (0, 1)]
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+needs_nvcc = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+def _src(tmp_path) -> Path:
+    b = lambda v: "true" if v else "false"
+    src = tmp_path / "inst.cu"
+    src.write_text('#include "attn_cuda.cu"\n#include "topk_cuda.cu"\n' + "".join(
+        f"template cudaError_t dsv41_attn::launch_one<{kw}, {b(r)}, {b(h)}>(const dsv41_attn::Args&, cudaStream_t);\n"
+        for kw, r, h in INSTANCES) + "cudaError_t topk_launch(const dsv41_topk::Args& a, cudaStream_t s) "
+        "{ return dsv41_topk::launch(a, 2, 4, 8, 19, s); }\n")
+    return src
+
+
+def _run(args):
+    out = subprocess.run([NVCC, "-std=c++17", "-O3", "--fmad=false", "-DDSV41_ATTN_NO_TORCH", f"-I{D}", *args],
+                         capture_output=True, text=True, timeout=900, check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    return out
+
+
+@needs_nvcc
+def test_builds_for_sm121_without_spills(tmp_path):
+    out = _run(["-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v", "-c", str(_src(tmp_path)), "-o",
+                str(tmp_path / "k.o")])
+    info = re.findall(r"Compiling entry function '(\w+)'.*?(\d+) bytes stack frame, (\d+) bytes spill stores, "
+                      r"(\d+) bytes spill loads.*?Used (\d+) registers", out.stderr, flags=re.S)
+    names = [i[0] for i in info]
+    assert sum("attn_kernel" in n for n in names) == len(INSTANCES) and any("topk_kernel" in n for n in names)
+    for name, stack, st, ld, regs in info:
+        assert int(stack) == 0 and int(st) == 0 and int(ld) == 0, (name, stack, st, ld)
+        assert int(regs) <= (128 if "topk" in name else 255), (name, regs)
+        print(f"[G13] attn_cuda sm_121 {name}: {regs} registers, 0 spills")
+
+
+@needs_nvcc
+def test_ptx_has_the_instructions_of_the_bit_claim(tmp_path):
+    _run(["-arch=compute_121", "-ptx", str(_src(tmp_path)), "-o", str(tmp_path / "k.ptx")])
+    ptx = (tmp_path / "k.ptx").read_text()
+    bodies = re.findall(r"\.entry (\w+)\((.*?)\n}\n", ptx, flags=re.S)
+    assert len(bodies) == len(INSTANCES) + 1
+    for name, body in bodies:
+        assert ".ftz" not in body and "ld.local" not in body and "st.local" not in body, name
+        if "attn_kernel" in name:
+            assert "mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32" in body, name
+            for op in ("ex2.approx.f32", "div.full.f32", "cvt.rn.f16x2.e4m3x2", "cvt.rn.bf16x2.f32",
+                       "cp.async.ca.shared.global", "atom.global.add"):
+                assert op in body, (name, op)
+            assert "div.rn" not in body and "rcp" not in body, name
+        else:
+            assert "barrier.cluster" in body and "match.any.sync" in body, name
+
+
+# ---- Triton tripwires: the codegen attn_cuda.cu mirrors ----------------------------------------------------------
+
+def _triton_target():
+    triton = pytest.importorskip("triton")
+    if os.environ.get("TRITON_INTERPRET") == "1":
+        pytest.skip("Triton's interpreter is on")
+    from triton.backends.compiler import GPUTarget
+
+    return triton, GPUTarget("cuda", 121, 32)
+
+
+def test_triton_chunks_layout_and_ops():
+    _, tgt = _triton_target()
+    from tensorfold.families.deepseek_v41.cuda.csa2 import attn_cuda as AC
+
+    try:
+        ttgir = AC.chunks_ttgir(tgt)
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f"Triton cannot compile for sm_121 here: {type(e).__name__}: {str(e)[:160]}")
+    assert AC.parse_layout(ttgir) == 4
+    assert "inputPrecision = tf32" in ttgir or "tt.dot" in ttgir
+
+
+def test_triton_ptx_op_mix():
+    triton, tgt = _triton_target()
+    from triton.compiler import ASTSource
+
+    from tensorfold.families.deepseek_v41.cuda.csa2 import attn as A
+
+    sig = {"Q": "*bf16", "CV": "*u8", "CSC": "*u8", "cvs": "i64", "css": "i64", "TOK": "*i32", "t_stride": "i32",
+           "CNT": "*i32", "SV": "*u8", "SSC": "*u8", "svs": "i64", "sss": "i64", "LO": "*i32", "HI": "*i32",
+           "POS": "*i64", "PO": "*fp32", "PM": "*fp32", "PL": "*fp32", "R": "i32", "PT": "*i32", "SL": "*i64",
+           "PTS": "i64"}
+    cst = dict(H=32, CH=128, NCOMP=4, KT=32, BMQ=16, SCALE=512 ** -0.5, RING=128, WINDOW=128, HAS_HI=False, PSH=4,
+               ROWS=True, PDL=False)
+    sig.update({k: "constexpr" for k in cst})
+    try:
+        k = triton.compile(ASTSource(fn=A._chunks, signature=sig, constexprs=cst), target=tgt,
+                           options={"num_warps": A.WARPS, "num_stages": A.STAGES})
+    except Exception as e:  # noqa: BLE001
+        pytest.skip(f"Triton cannot compile for sm_121 here: {type(e).__name__}: {str(e)[:160]}")
+    ptx = k.asm["ptx"]
+    assert ptx.count("mma.sync.aligned.m16n8k16.row.col.f32.bf16.bf16.f32") == 96
+    assert len(re.findall(r"ex2\.approx\.f32\s", ptx)) == 12 and "ex2.approx.ftz" not in ptx
+    assert len(re.findall(r"fma\.rn\.f32\s", ptx)) == 4
+    assert "0f3D3504F3" in ptx and "0f3FB8AA3B" in ptx                     # 512^-0.5 and log2(e)
+    bfly = re.findall(r"shfl\.sync\.bfly\.b32\s+%r\d+, %r\d+, (\d+),", ptx)
+    assert bfly[:2] == ["2", "1"]                                           # the quad tree: (a0 + a2) + (a1 + a3)
+    msig = {"PO": "*fp32", "PM": "*fp32", "PL": "*fp32", "SINK": "*fp32", "CS": "*fp32", "cs_stride": "i32",
+            "POS": "*i64", "OUT": "*bf16", "R": "i32"}
+    mc = dict(H=32, NCH=5, ROWS=True, PDL=False)
+    msig.update({k: "constexpr" for k in mc})
+    m = triton.compile(ASTSource(fn=A._merge, signature=msig, constexprs=mc), target=tgt, options={"num_warps": 4})
+    mp = m.asm["ptx"]
+    assert "div.full.f32" in mp and "fma.rn.f32x2" in mp and "ex2.approx.ftz" not in mp
+    assert len(re.findall(r"ex2\.approx\.f32\s", mp)) == 11                 # b for 5 chunks, a for 4, a / e final
