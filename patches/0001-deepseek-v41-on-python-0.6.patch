index 0000000..2b35276
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/mhc_pf.py
@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16: the mHC site of a PREFILL segment as one hand-written CUDA pass (``mhc_pf.cu``), ``TF_DSV41_MHC_PF=1``
+(default 0: Triton's ``mhc._site``). The finish (``mhc._finish_k``: the partials' sums, the coefficients, the
+normed input) stays Triton: it reads the same ``Scratch.part`` layout.
+
+Why. G5's nsys of a 32K prefill: ``_site`` 3.3-3.9 ms a 2,048-row boundary (16-row tiles), ~2.6-2.8 ms with G7's
+64-row tile and bf16 partials, 80 boundaries a 2,048-row segment in full prefill (40 in replay), against a DRAM floor
+of ~1.0 ms: the pass moves x 84 MB in + 84 MB out, the gathered bf16 partials 42 MB, the collapsed row 21 MB (231 MB
+at ~230 GB/s). Its FMA work is 2,048 x (4 x 5,120 x 25 + 5,120) = 1.06 G FMA (~0.1 ms at the FP32 rate), but Triton's
+``tl.dot(ieee)`` pads the 24 mixes to 32 columns and the square sums to 16 (``ones`` [BK, 16]), x 1.9 the FMAs, and
+its 16 / 64-row programs hold the 4 streams' tiles in registers: ~1 CTA an SM, latency-bound.
+
+Design (sm_121, GB10: 48 SMs, ~99 KiB shared memory a block):
+- CTA = (column block b of NB = 40, a tile of 16 rows), 128 threads, all 4 streams: grid 40 x ceil(R / 16) (5,120
+  CTAs at 2,048 rows); ~47 KiB shared memory with bf16 ``fn`` (prod's ``TF_DSV41_MHC_FN=bf16``: 2 CTAs an SM),
+  ~71 KiB with fp32 ``fn`` (strict: 1 CTA an SM).
+- ``fn``'s 24 x 4 x 128 slice of block b streams into shared memory by ``cp.async`` while phase A runs.
+- phase A: 256 items (row, 8 columns) a CTA, 2 a thread: every load of both items issued before any store (12 x 16 B
+  in flight a thread), then the post (rank-order sum of the partials, bf16, the 4 new streams), the collapsed row,
+  the taps; stores to ``xout`` / ``c`` / ``tap`` and the CTA's shared copy of the new streams.
+- phase B: 1,616 FMA chains a CTA (16 rows x (4 streams x 25 + 1)), 12-13 a thread, every chain of a thread on one
+  row of one stream, so one 16-byte shared read of 8 values feeds all of them (``fn`` reads are warp broadcasts).
+- no tickets, no atomics: the Triton finish runs after it, as after ``_site``.
+
+Bits: the SAME as Triton's ``_site`` (POST_ON, COLLAPSE 2, MIX; or COLLAPSE 1 / 2, MIX), output for output: the
+instructions of ``mhc_cuda.cu``'s decode kernel (``enable_fp_fusion=False``: a rounded product, a rounded sum; the
+ieee dots are ``fma.rn.f32`` chains over a block's 128 columns ascending from +0.0; ``cvt.rn.bf16.f32``), which G13
+compared bit for bit with Triton on the GPU. ``tests/dsv41_mhc_pf_emu.py`` walks this kernel's grid, threads and
+chains in numpy (each output stored once, each chain once, every value ``mhc_cuda_emu``'s), and the CPU tests check it
+against ``tests/dsv41_kref.py``'s ``mhc_boundary``; ``tests/cuda/test_dsv41_mhc_pf_gpu.py`` compares the kernel with
+Triton bit for bit at 2,048 / 2,047 / 300 rows. So row invariance, batched == alone and resumed == fresh hold as
+before, and the fast tag does not change.
+
+Cost model (one rank, 2,048 rows, bf16 partials): 231 MB at ~200 GB/s = ~1.15 ms; phase B ~0.1-0.2 ms, mostly
+under other CTAs' phase A (2 CTAs an SM); + the finish ~0.38 ms (unchanged). => ~1.3-1.5 ms a boundary against
+~3.0-3.2 today (site + finish): -1.5 to -1.8 ms a boundary, x 80 a full-prefill segment = -120 to -145 ms of ~2.1 s
+(+6-7%), x 41 a replay segment = -60 to -75 ms of ~1.0 s. With this project's in-engine transfer (50-70%):
+**+3-5% full prefill, +3-5% replay**.
+
+Knobs: ``TF_DSV41_MHC_PF`` (0 / 1); ``TF_DSV41_MHC_PF_ROWS`` (256: the fewest rows it takes; decode windows and
+verify rows never come near it, so their path, graphs and bits are untouched).
+"""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+
+D = 5120
+NB = 40
+BM = 16
+MODES = {"boundary": 0, "site1": 1, "site2": 2}
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_MHC_PF", "").strip() or "0") not in ("0", "off", "no", "false")
+
+
+def min_rows() -> int:
+    n = int(os.environ.get("TF_DSV41_MHC_PF_ROWS", "").strip() or 256)
+    if n < 17:
+        raise ValueError(f"TF_DSV41_MHC_PF_ROWS={n}: at least 17 (decode windows stay on their own kernels)")
+    return n
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from pathlib import Path
+
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tf_dsv41_mhc_pf_v1", sources=[str(here / "mhc_pf.cpp"), str(here / "mhc_pf.cu")],
+                extra_cuda_cflags=["-O3", "-lineinfo", "--fmad=false"], verbose=False)
+
+
+def _aligned(t, elems: int = 8) -> bool:
+    return t.data_ptr() % 16 == 0 and all(t.stride(i) % elems == 0 for i in range(t.dim() - 1))
+
+
+def why_not(rows: int, x, xout, gathered, prev, pre_in, hc, scratch, tap, post_on: bool, collapse: int,
+            mix: bool) -> str | None:
+    """None when the CUDA prefill site takes this ``mhc._launch`` call, else the reason (Triton runs)."""
+
+    import torch
+
+    from . import mhc as M
+
+    if not enabled():
+        return "off"
+    if rows < min_rows():
+        return "rows"
+    if not mix or collapse not in (1, 2) or (post_on and collapse != 2):
+        return "kind"                               # post_only / final keep Triton
+    if x.device.type != "cuda" or x.shape[1] != 4 * D or M.NB != NB:
+        return "device or shape"
+    bf, f32 = torch.bfloat16, torch.float32
+    if x.dtype != bf or x.stride(1) != 1 or not _aligned(x):
+        return "x"
+    if scratch is None or scratch.rows < rows or scratch.dims != D or not scratch.part.is_contiguous() \
+            or not scratch.c.is_contiguous() or scratch.c.data_ptr() % 16 or scratch.part.data_ptr() % 16:
+        return "scratch"
+    if hc.fn.dtype not in (bf, f32) or not hc.fn.is_contiguous() or hc.fn.shape != (24, 4 * D) \
+            or hc.fn.data_ptr() % 16:
+        return "fn"
+    if post_on:
+        if xout is None or xout.dtype != bf or xout.stride(1) != 1 or xout.stride(0) != 4 * D \
+                or xout.data_ptr() % 16:
+            return "xout"
+        if xout.data_ptr() != x.data_ptr() and M._overlap(x, xout):
+            return "partial overlap"                # in place (the same rows) is safe; a shifted alias is not
+        if x.data_ptr() == xout.data_ptr() and x.stride(0) != xout.stride(0):
+            return "in place, other stride"
+        g = gathered
+        if g.dtype not in (bf, f32) or g.dim() != 3 or g.shape[0] > 8 or g.stride(2) != 1 or g.stride(1) != D \
+                or g.data_ptr() % 16 or g.stride(0) % (8 if g.dtype == bf else 4):
+            return "gathered"
+        for t in (prev.post, prev.comb):
+            if t.dtype != f32 or not t.is_contiguous():
+                return "carried coefficients"
+    if collapse == 2 and (pre_in is None or pre_in.dtype != f32 or not pre_in.is_contiguous()):
+        return "pre-mix"
+    if tap is not None and (not post_on or tap.dtype != bf or tap.stride(1) != 1 or not _aligned(tap)):
+        return "tap"
+    return None
+
+
+def run(x, xout, gathered, prev, pre_in, hc, scratch, tap, rows: int, post_on: bool, collapse: int,
+        mix: bool) -> bool:
+    """The CUDA prefill site if it applies (``why_not``): True when it ran (the caller then runs the Triton finish)."""
+
+    if why_not(rows, x, xout, gathered, prev, pre_in, hc, scratch, tap, post_on, collapse, mix) is not None:
+        return False
+    import torch
+
+    mode = MODES["boundary"] if post_on else MODES["site2"] if collapse == 2 else MODES["site1"]
+    none = x.new_empty(0)
+    f0 = torch.empty(0, dtype=torch.float32, device=x.device)
+    _ext().run(x, xout if post_on else none, gathered if post_on else none, prev.post if post_on else f0,
+               prev.comb if post_on else f0, pre_in if collapse == 2 else f0, hc.fn, scratch.part, scratch.c,
+               tap if tap is not None else none, int(rows), int(mode))
+    return True
+
+
+__all__ = ["BM", "MODES", "enabled", "min_rows", "run", "why_not"]
