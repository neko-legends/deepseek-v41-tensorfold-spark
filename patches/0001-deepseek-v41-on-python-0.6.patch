index 0000000..2ea6341
--- /dev/null
+++ b/tests/dsv41_dspark_fakes.py
@@ -0,0 +1,127 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``dsv41_fakes``' tiny random checkpoint with DSpark (``mtp.*``) as the real pack stores it: the blocks in the
+backbone's layout (SWA-only attention, the drafter's own routed experts), ``mtp.0.main_proj`` (EXL3, 3 D -> D),
+``mtp.0.main_norm``, and on the last block ``norm``, ``markov_head.embed`` (bf16) / ``.head`` (fp16) and
+``confidence_head.proj`` (fp16 [1, D + r]); plus helpers that build the M2 forward (``decode.DecodeForward``) and a
+batcher on it, on the CPU twin of the kernels."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import dsv41_fakes as FK
+import torch
+
+# the serving layer's pool holds the kernels' 584-byte records: head_dim 512, index keys 32 x 128, SWA 128
+SHAPES = {"num_attention_heads": 16, "head_dim": 512, "qk_rope_head_dim": 64, "o_groups": 2, "o_lora_rank": 128,
+          "index_n_heads": 32, "index_head_dim": 128, "sliding_window": 128, "rms_norm_eps": 1e-20}
+
+
+def write_checkpoint(folder: Path, seed: int = 0, **over) -> Path:
+    from safetensors.torch import save_file
+
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    raw = FK.config(**over)
+    cfg = Config.from_dict(raw)
+    folder.mkdir(parents=True, exist_ok=True)
+    w = FK.Writer(cfg, seed)
+    d, r, V = cfg.hidden_size, cfg.dspark_markov_rank, cfg.vocab_size
+    w.native("embed.weight", (V, d))
+    w.native("norm.weight", (d,), scale=0.1, offset=1)
+    w.exl3("head", d, V, 6)
+    for L in range(cfg.num_hidden_layers + cfg.num_nextn_predict_layers):
+        w.layer(L)
+    last = f"mtp.{cfg.num_nextn_predict_layers - 1}"
+    w.exl3("mtp.0.main_proj", len(cfg.aux_layer_ids) * d, d, 5)
+    w.native("mtp.0.main_norm.weight", (d,), scale=0.1, offset=1)
+    w.native(f"{last}.norm.weight", (d,), scale=0.1, offset=1)
+    w.native(f"{last}.markov_head.embed.weight", (V, r))
+    w.native(f"{last}.markov_head.head.weight", (V, r), torch.float16, 0.1)
+    w.native(f"{last}.confidence_head.proj.weight", (1, d + r), torch.float16, 0.05)
+    names = sorted(w.t)
+    half = len(names) // 2
+    shards = {"model-00001-of-00002.safetensors": names[:half], "model-00002-of-00002.safetensors": names[half:]}
+    wmap = {}
+    for f, ns in shards.items():
+        save_file({n: w.t[n].contiguous() for n in ns}, str(folder / f))
+        wmap.update({n: f for n in ns})
+    (folder / "model.safetensors.index.json").write_text(json.dumps({"metadata": {}, "weight_map": wmap}))
+    (folder / "config.json").write_text(json.dumps(raw))
+    return folder
+
+
+def ckpt(root: Path, **over):
+    """(root, cfg, Engram table, topology) of a DSpark checkpoint written at ``root``."""
+
+    from tensorfold.families.deepseek_v41.cuda import topology
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    write_checkpoint(root, **{**SHAPES, **over})
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def forward(ck, *, slots: int = 1, rank: int = 0, world: int = 1, comm=None, chunk: int = 32, limit: int = 1024,
+            dspark: bool = True, prefetch: bool = False, rows=None, device: str = "cpu"):
+    """``decode.DecodeForward`` (``dspark``: with the drafter; ``rows``: Engram row sources) on the CPU twin, or on
+    the Triton kernels when ``device`` is CUDA."""
+
+    from tensorfold.families.deepseek_v41.cuda import drafter as DR
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+
+    root, cfg, table, _ = ck
+    tmap = FK.token_map(cfg)
+    loader = W.Loader(cfg, W.Shards(root), rank, world, device)
+    tree = loader.load(token_map=tmap)
+    if rows is None:
+        rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    if torch.device(device).type == "cuda":
+        from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+
+        cs = Triton(chunk, cfg.num_attention_heads // world, device)
+    else:
+        cs = Twin(cfg.qk_rope_head_dim, cfg.sliding_window)
+    return DecodeForward(cfg, tree, csa2=cs, comm=comm, limit=limit,
+                         chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=slots,
+                         dspark=DR.load(loader) if dspark else None, prefetch=prefetch, device=device)
+
+
+def batcher(ck, fw, *, n: int = 1, capacity: int = 1024, pool_tokens: int = 4096, depth: int | None = None,
+            lookup: bool = False, store=None, **kw):
+    """A rank-0 batcher (no round thread); ``depth`` 0 = serial, ``lookup``: suffix lookup drafts."""
+
+    from tensorfold.families.deepseek_v41.cuda.batch import Batcher
+    from tensorfold.families.deepseek_v41.cuda.pool import Pool
+    from tensorfold.families.deepseek_v41.cuda.sessions import Tag
+
+    pool = Pool(ck[3], -(-pool_tokens // 256) * 256, device=fw.device)
+    b = Batcher(fw, pool, n_slots=n, capacity=capacity, store=store, mode="full", tag=Tag(ced="full").code(),
+                prefill_rows=4096, depth=depth, session_min=16, start=False, **kw)
+    b.planner.lookup = lookup
+    return b
+
+
+def run(b, jobs, steps: int = 100000) -> list[list[int]]:
+    for j in jobs:
+        b.submit(j)
+    for _ in range(steps):
+        if not b.step():
+            break
+    out = []
+    for j in jobs:
+        toks = []
+        while True:
+            item = j.out.get_nowait()
+            if item is None:
+                break
+            if isinstance(item, BaseException):
+                raise item
+            toks += item
+        out.append(toks)
+    return out
