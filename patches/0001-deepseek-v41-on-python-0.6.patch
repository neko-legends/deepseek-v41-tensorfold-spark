+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The e1 CUDA mHC boundary (``mhc_cuda``, TF_DSV41_MHC_CUDA=1) on the GPU (collected only where PyTorch sees an
+NVIDIA GPU), at D = 5,120, against the Triton path it replaces (TF_DSV41_MHC_CUDA=0: ``_site_dec`` + ``_finish_k``):
+
+- boundary == Triton bit for bit at 1-16 rows (new streams, normed input, pre / post / comb, collapsed row, every
+  partial, taps), fn fp32 and bf16, bf16 and fp32 gathered partials, world 1 and 2; site (stream 0 / a carried
+  pre-mix); final (in place and out of place); a boundary in place falls back to Triton (same bits);
+- graph capture: a chain of boundaries replayed several times == eager (the ticket resets itself);
+- row invariance: each row alone == the same row of a 6-row window; batched == alone;
+- the numpy emulator == the GPU (exact outside the coefficients; the coefficients within 2 ulp-ish);
+- [G13] lines: the device's cluster support (why the ticket, not DSMEM) and us a boundary in a graph, Triton vs CUDA,
+  DRAM-cold (a ring of 48 boundaries' weights, > L2), 1 / 2 / 4 / 8 / 16 rows.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_mhc_cuda_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import mhc
+from tensorfold.families.deepseek_v41.cuda import mhc_cuda as MC
+from tensorfold.families.deepseek_v41.cuda import mhc_cuda_emu as E
+
+DEV = "cuda"
+D = 5120
+RING = 48
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def _hc(g, dtype=torch.bfloat16):
+    return mhc.Hc((torch.randn((24, 4 * D), generator=g) * 0.01).to(dtype).contiguous().to(DEV),
+                  (torch.randn(24, generator=g) * 0.5).to(DEV), (torch.rand(3, generator=g) + 0.5).to(DEV))
+
+
+def _case(R: int, world: int = 2, seed: int = 1, dtype=torch.bfloat16, gdtype=torch.bfloat16):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * D), generator=g).to(torch.bfloat16).to(DEV)
+    gathered = (torch.randn((world, R, D), generator=g) * 0.7)
+    gathered = (gathered.to(torch.bfloat16) if gdtype == torch.bfloat16 else gathered).to(DEV)
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    prev = mhc.Coefs(R, DEV, pre=(torch.rand((R, 4), generator=g) + 0.1).to(DEV),
+                     post=(torch.rand((R, 4), generator=g) * 2).to(DEV), comb=comb.to(DEV))
+    nw = (torch.rand(D, generator=g) + 0.5).to(torch.bfloat16).to(DEV)
+    return x, gathered, prev, _hc(g, dtype), nw
+
+
+class _Out:
+    def __init__(self, R: int, tap: bool = True) -> None:
+        self.xout = torch.zeros((R, 4 * D), dtype=torch.bfloat16, device=DEV)
+        self.out = torch.zeros((R, D), dtype=torch.bfloat16, device=DEV)
+        self.co = mhc.Coefs(R, DEV)
+        self.sc = mhc.Scratch(R, DEV, D)
+        self.tap = torch.zeros((R, 2 * D), dtype=torch.bfloat16, device=DEV)[:, D:] if tap else None
+
+    def all(self, R: int, mix: bool = True, streams: bool = True) -> dict:
+        d = {"out": self.out, "c": self.sc.c[:R], "p25": self.sc.part[:R, 0, :, 25]}
+        if streams:
+            d["x"] = self.xout
+        if mix:
+            d.update(pre=self.co.pre, post=self.co.post, comb=self.co.comb, part=self.sc.part[:R, :, :, :25])
+        if self.tap is not None:
+            d["tap"] = self.tap
+        return {k: v.clone() for k, v in d.items()}
+
+
+def _same(a: dict, b: dict, what: str):
+    bad = [k for k in a if not torch.equal(_bits(a[k]), _bits(b[k]))]
+    assert not bad, f"{what}: {bad}"
+
+
+def _both(monkeypatch, fn) -> dict:
+    got = {}
+    for v in ("0", "1"):
+        monkeypatch.setenv("TF_DSV41_MHC_CUDA", v)
+        got[v] = fn()
+    return got
+
+
+def _boundary(case, o: _Out):
+    x, gathered, prev, hc, nw = case
+    mhc.boundary(x, o.xout, gathered, prev, hc, nw, o.out, o.co, o.sc, tap=o.tap)
+
+
+@pytest.mark.parametrize("R", [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 16])
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+def test_boundary_bits(monkeypatch, R, dtype):
+    case = _case(R, seed=R, dtype=dtype)
+
+    def run():
+        o = _Out(R)
+        _boundary(case, o)
+        return o.all(R)
+
+    got = _both(monkeypatch, run)
+    _same(got["0"], got["1"], f"boundary R={R} fn={dtype}")
+
+
+@pytest.mark.parametrize("R,world", [(1, 1), (4, 2), (16, 2)])
+def test_boundary_fp32_partials_bits(monkeypatch, R, world):
+    case = _case(R, world, seed=50 + R, gdtype=torch.float32)
+
+    def run():
+        o = _Out(R, tap=False)
+        _boundary(case, o)
+        return o.all(R)
+
+    got = _both(monkeypatch, run)
+    _same(got["0"], got["1"], f"boundary fp32 partials R={R} world={world}")
+
+
+@pytest.mark.parametrize("R", [1, 4, 16])
+def test_site_bits(monkeypatch, R):
+    x, _, prev, hc, nw = _case(R, seed=60 + R)
+    for pre_in in (None, prev.pre):
+        def run(pre_in=pre_in):
+            o = _Out(R, tap=False)
+            mhc.site(x, hc, nw, o.out, o.co, o.sc, pre_in=pre_in)
+            return o.all(R, streams=False)
+
+        got = _both(monkeypatch, run)
+        _same(got["0"], got["1"], f"site R={R} pre_in={pre_in is not None}")
+
+
+@pytest.mark.parametrize("R", [1, 3, 16])
+@pytest.mark.parametrize("in_place", [True, False])
+def test_final_bits(monkeypatch, R, in_place):
+    x, gathered, prev, _, nw = _case(R, seed=70 + R)
+
+    def run():
+        o = _Out(R)
+        xi = x.clone()
+        dst = xi if in_place else o.xout
+        mhc.final(xi, dst, gathered, prev, nw, o.out, o.sc, o.tap)
+        d = o.all(R, mix=False, streams=False)
+        d["x"] = dst.clone()
+        return d
+
+    got = _both(monkeypatch, run)
+    _same(got["0"], got["1"], f"final R={R} in place={in_place}")
+
+
+def test_boundary_in_place_falls_back(monkeypatch):
+    R = 2
+    case = _case(R, seed=80)
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1")
+    x, gathered, prev, hc, nw = case
+    o = _Out(R, tap=False)
+    assert MC.why_not(R, x, x, gathered, prev, prev.pre, hc, nw, o.out, o.co, o.sc, None, True, True) == "in place"
+    assert MC.why_not(R, x, o.xout, gathered, prev, prev.pre, hc, nw, o.out, o.co, o.sc, None, True, True) is None
+
+    def run():
+        o2 = _Out(R, tap=False)
+        xi = x.clone()
+        mhc.boundary(xi, xi, gathered, prev, hc, nw, o2.out, o2.co, o2.sc)
+        d = o2.all(R, streams=False)
+        d["x"] = xi
+        return d
+
+    got = _both(monkeypatch, run)
+    _same(got["0"], got["1"], "boundary in place (Triton both ways)")
+
+
+def test_graph_replay_chain(monkeypatch):
+    """Three boundaries chained (each one's coefficients feed the next) in one graph, replayed 3 times == eager."""
+
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1")
+    R = 3
+    x, gathered, prev, hc, nw = _case(R, seed=90)
+    g = torch.Generator().manual_seed(91)
+    hcs = [hc, _hc(g), _hc(g)]
+    xs = [x.clone(), torch.empty_like(x)]
+    cos = [prev, mhc.Coefs(R, DEV)]
+    out = torch.empty((R, D), dtype=torch.bfloat16, device=DEV)
+    sc = mhc.Scratch(R, DEV, D)
+
+    def chain():
+        xs[0].copy_(x)
+        cos[0].pre.copy_(prev.pre), cos[0].post.copy_(prev.post), cos[0].comb.copy_(prev.comb)
+        cur = 0
+        for i, h in enumerate(hcs):
+            mhc.boundary(xs[i % 2], xs[1 - i % 2], gathered, cos[cur], h, nw, out, cos[1 - cur], sc)
+            cur = 1 - cur
+        return {"x": xs[len(hcs) % 2].clone(), "out": out.clone(), "comb": cos[cur].comb.clone(),
+                "pre": cos[cur].pre.clone()}
+
+    prev = mhc.Coefs(R, DEV, pre=prev.pre.clone(), post=prev.post.clone(), comb=prev.comb.clone())
+    cos[0] = mhc.Coefs(R, DEV, pre=prev.pre.clone(), post=prev.post.clone(), comb=prev.comb.clone())
+    eager = chain()
+    chain()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        chain()
+    for _ in range(3):
+        out.zero_()
+        graph.replay()
+        torch.cuda.synchronize()
+        now = {"x": xs[len(hcs) % 2].clone(), "out": out.clone(), "comb": cos[len(hcs) % 2].comb.clone(),
+               "pre": cos[len(hcs) % 2].pre.clone()}
+        _same(eager, now, "graph replay")
+    assert int(sc.mhc_cnt[0]) == 0
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "0")
+    _same(eager, chain(), "the chain on Triton")
+
+
+def test_row_invariance(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1")
+    R = 6
+    x, gathered, prev, hc, nw = _case(R, seed=100)
+    full = _Out(R)
+    _boundary((x, gathered, prev, hc, nw), full)
+    full = full.all(R)
+    for r in range(R):
+        sl = slice(r, r + 1)
+        p1 = mhc.Coefs(1, DEV, pre=prev.pre[sl].clone(), post=prev.post[sl].clone(), comb=prev.comb[sl].clone())
+        one = _Out(1)
+        _boundary((x[sl].clone(), gathered[:, sl].clone(), p1, hc, nw), one)
+        _same(one.all(1), {k: v[sl] for k, v in full.items()}, f"row {r} alone")
+
+
+def test_emulator_matches_gpu(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1")
+    R = 2
+    x, gathered, prev, hc, nw = _case(R, seed=110)
+    o = _Out(R)
+    _boundary((x, gathered, prev, hc, nw), o)
+    gpu = o.all(R)
+    f = lambda t: t.float().cpu().numpy()
+    e = E.emulate(f(x), f(gathered), f(prev.post), f(prev.comb), f(prev.pre), f(hc.fn), f(hc.base), f(hc.scale),
+                  f(nw), eps=mhc.EPS, hc_eps=mhc.HC_EPS, post_alpha=mhc.POST_ALPHA, iters=mhc.ITERS)
+    for k, want in (("x", e["x"]), ("out", e["out"]), ("c", e["c"]), ("tap", e["tap"]),
+                    ("part", e["part"][..., :25]), ("p25", e["part"][:, 0, :, 25])):
+        got = np.ascontiguousarray(f(gpu[k]), dtype=np.float32)
+        assert np.array_equal(got.view(np.uint32), np.ascontiguousarray(want, dtype=np.float32).view(np.uint32)), k
+    exact = []
+    for k in ("pre", "post", "comb"):
+        got = f(gpu[k]).reshape(e[k].shape)
+        np.testing.assert_allclose(got, e[k], rtol=2e-6, atol=2e-7)
+        exact.append(f"{k} {'bit for bit' if np.array_equal(got, e[k]) else 'within 2 ulp-ish'}")
+    print("[G13] emulator vs GPU: streams / c / taps / partials / normed input bit for bit; " + ", ".join(exact))
+
+
+def test_device_info():
+    i = MC.info(torch.cuda.current_device())
+    print(f"[G13] mhc_cuda device: cluster launch {i['cluster_launch']}, largest cluster for the kernel "
+          f"{i['max_cluster']}, SMs {i['sms']}, opt-in smem {i['smem_optin']} B, boundary CTAs an SM "
+          f"{i['ctas_per_sm']} (160 needed resident: {i['ctas_per_sm'] * i['sms'] >= 160})")
+    assert i["ctas_per_sm"] >= 1
+
+
+def _graph_us(R: int, cuda: bool, monkeypatch, reps: int = 5) -> float:
+    """us a boundary inside a graph of RING boundaries, each with its own bf16 weights (48 MB: DRAM-cold)."""
+
+    monkeypatch.setenv("TF_DSV41_MHC_CUDA", "1" if cuda else "0")
+    g = torch.Generator().manual_seed(5)
+    x, gathered, prev, _, nw = _case(R, seed=5)
+    hcs = [_hc(g) for _ in range(RING)]
+    o = _Out(R, tap=False)
+    run = lambda: [mhc.boundary(x, o.xout, gathered, prev, h, nw, o.out, o.co, o.sc) for h in hcs]
+    run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+    graph.replay()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(reps):
+        graph.replay()
+    b.record()
+    torch.cuda.synchronize()
+    return 1000.0 * a.elapsed_time(b) / (reps * RING)
+
+
+def test_times(monkeypatch):
+    for R in (1, 2, 4, 8, 16):
+        old = _graph_us(R, False, monkeypatch)
+        new = _graph_us(R, True, monkeypatch)
+        print(f"[G13] mhc boundary R={R}: triton {old:.1f} us, cuda {new:.1f} us, {old / new:.2f}x "
+              f"(in a graph, fn bf16, DRAM-cold ring of {RING})", flush=True)
