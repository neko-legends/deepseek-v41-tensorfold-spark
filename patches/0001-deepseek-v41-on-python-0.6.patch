+@pytest.mark.parametrize("depth", [0, 3])
+def test_long_prefills_staggered(topo, depth):
+    """Four long prompts submitted together (G4's stress, scaled: "long" = over 300 tokens here) are admitted one
+    after another, each once the previous one decodes; a short prompt behind them admits at once and decodes while
+    they prefill; every reply equals the request run alone."""
+
+    longs = prompts(5, (700, 900, 1200, 800))
+    short = prompts(6, (40,))[0]
+    samplings = [None, Sampling(7, 0.8, 20, 0.9), None, Sampling(11, 1.0, 0, 0.95), Sampling(3, 0.7, 20, 0.95)]
+
+    def jobs():
+        return [Job(list(p), 20, s) for p, s in zip(longs, samplings)] + [Job(list(short), 160, samplings[4])]
+
+    alone = [run(make(topo, n=1, depth=depth), [j])[0] for j in jobs()]
+    b = make(topo, n=4, depth=depth, rows=200, pool_tokens=32768)
+    b.long_prompt, b.prefill_concurrent = 300, 1
+    js = jobs()
+    for j in js:
+        b.submit(j)
+    plans, short_decoding_beside_long = [], 0
+    inner = b._plan
+
+    def spy():
+        plan = inner()
+        plans.append(plan)
+        return plan
+
+    b._plan = spy
+    for _ in range(100000):
+        if not b.step():
+            break
+        live = [s for s in b.seqs if s is not None]
+        prefilling = [s for s in live if s.long and not s.decoding]
+        assert len(prefilling) <= 1, [(s.slot, len(s.job.prompt), s.done) for s in prefilling]
+        if prefilling and plans[-1].windows and any(len(s.job.prompt) == len(short) for s in live if s.decoding):
+            short_decoding_beside_long += 1
+    got = [drain(j)[0] for j in js]
+    assert got == alone
+    assert [len(t) for t in got] == [20, 20, 20, 20, 160]
+    admitted = [(i, a.job) for i, p in enumerate(plans) for a in p.admits]
+    order = [job for _, job in admitted]
+    assert order[:2] == [js[0].id, js[4].id]                 # the short prompt goes past the waiting long ones
+    assert order[2:] == [js[1].id, js[2].id, js[3].id]       # the long ones in order, one at a time
+    assert b.counts["long_waits"] > 0 and short_decoding_beside_long > 3
+    size, at = {j.id: len(j.prompt) for j in js}, {}
+    for p in plans:                                          # no round's pieces mix two long prompts
+        at.update({a.slot: a.job for a in p.admits})
+        assert len({at[slot] for slot, _, _ in p.pieces if size[at[slot]] > 300}) <= 1
+    assert b.pool.alloc.n_free == b.pool.npages
+
+
+def test_long_prefills_unlimited(topo):
