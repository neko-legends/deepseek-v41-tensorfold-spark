@@ -0,0 +1,491 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Host memory during long prefills (G12, bug 1): give freed memory back as a prompt goes, and a probe that says
+where a rank's anonymous memory goes.
+
+G10's stress (one 299K prefill, three 64K prompts queued): the worker's RssAnon climbed 0.87 -> ~7 GB during the
+prefill and partly came down only later; MALLOC_ARENA_MAX=2, prefetch-ahead, sessions, L2PF and pruning off changed
+nothing. A prefill segment's host side allocates and frees tens of MB a layer (the Engram bulk reads: a 4 KiB-padded
+read buffer of ~100 MB, the records, fp32 rows [24,576, 256] and their bf16 copy; the hashes) on the Prefetcher's
+threads and the round thread; glibc keeps freed chunks in its arenas (no trim below the top chunk, one arena a
+thread). Both ranks run ``rounds.Executor`` alike, so both trim alike:
+
+- ``Trimmer.prefilled(rows)``: every ``TF_DSV41_HOST_TRIM_ROWS`` (32,768; 0 = off) prompt rows, ``malloc_trim(0)``
+  (every arena's free pages back to the kernel);
+- ``Trimmer.prompt_done()`` after a prompt of at least that many rows: a full trim (``gc.collect()``, ``malloc_trim(0)``,
+  torch's cached pinned blocks: on a GB10 that memory is the GPU's), at the next idle point;
+- ``Trimmer.finished(idle)``: trims when the box goes idle (the serving leak of 2026-10-04). All trims run on a
+  background thread a rank (``Trimmer`` explains why: the G12 trims stalled prefills).
+
+``TF_DSV41_MEMPROBE=N`` (0 = off): every N rounds one line a rank (RssAnon / RssShmem / VmRSS, MemAvailable, torch's
+device and pinned-host counters, gc counts, prompt rows so far); ``TF_DSV41_MEMPROBE_TRACE=K`` also starts
+``tracemalloc`` (12 frames) and prints the K tracebacks that grew most since the last line (slow: diagnostics only).
+"""
+
+from __future__ import annotations
+
+import ctypes
+import gc
+import os
+import sys
+import threading
+import time
+
+
+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    v = int(raw) if raw else default
+    if v < 0:
+        raise ValueError(f"{name}={v}: expected >= 0")
+    return v
+
+
+def status_kib() -> dict[str, int]:
+    """{RssAnon, RssShmem, RssFile, VmRSS} of this process in KiB (empty off Linux)."""
+
+    out = {}
+    try:
+        with open("/proc/self/status") as f:
+            for line in f:
+                k, _, v = line.partition(":")
+                if k in ("RssAnon", "RssShmem", "RssFile", "VmRSS"):
+                    out[k] = int(v.split()[0])
+    except OSError:
+        pass
+    return out
+
+
+def mem_available_gib() -> float | None:
+    try:
+        with open("/proc/meminfo") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) / 2 ** 20
+    except OSError:
+        pass
+    return None
+
+
+def malloc_trim() -> None:
+    try:
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except (OSError, AttributeError):
+        pass
+
+
+def trim(full: bool = False) -> float:
+    """``malloc_trim(0)``; ``full``: Python's cyclic garbage first and torch's cached pinned blocks after. -> MiB of
+    RssAnon given back."""
+
+    before = status_kib().get("RssAnon", 0)
+    if full:
+        gc.collect()
+    malloc_trim()
+    if full:
+        try:
+            import torch
+
+            torch._C._host_emptyCache()
+        except (ImportError, AttributeError, RuntimeError):
+            pass
+    return max(0, before - status_kib().get("RssAnon", before)) / 1024
+
+
+def numpy_hugepages(on: bool | None = None) -> bool | None:
+    """NumPy's ``madvise(MADV_HUGEPAGE)`` on its buffers of >= 4 MiB: off unless ``TF_DSV41_NUMPY_HUGEPAGE=1``.
+    -> the setting applied (None: this NumPy has no switch).
+
+    G12 (bugs 1 and 2): NumPy madvises every large buffer for transparent huge pages by default, and with the
+    Sparks' THP mode ``madvise`` / defrag ``madvise`` each first touch of such a range is a huge-page fault that
+    compacts memory synchronously when no free 2 MiB block is left. With ~103 GiB held by the weights and the KV
+    pool, a long prefill's host side (the Engram bulk reads: records, fp32 / bf16 rows, ~6-25 MB each, a layer a
+    segment, on the prefetch threads) faulted into direct compaction over and over: page migration with SMMU TLB
+    invalidations (the GPU shares the page tables), 45-51% system CPU, PSI memory "full" 64-71% on both nodes,
+    the GPUs spinning at 17 W, a 299K prefill at ~150 instead of ~1,650 tokens/s. The madvise also lands inside
+    glibc's arena heaps (buffers under the mmap threshold), whose huge pages a free or a trim then splits, so
+    RssAnon grew with the prompt too. Small pages cost nothing measurable here (the buffers are streamed once)."""
+
+    if on is None:
+        on = (os.environ.get("TF_DSV41_NUMPY_HUGEPAGE", "0").strip() or "0") != "0"
+    try:
+        import numpy as np
+
+        mod = getattr(getattr(np, "_core", None), "multiarray", None) or np.core.multiarray
+        mod._set_madvise_hugepage(bool(on))
+    except (ImportError, AttributeError):
+        return None
+    return bool(on)
+
+
+def rss_anon_mib() -> float:
+    return status_kib().get("RssAnon", 0) / 1024
+
+
+class Trimmer:
+    """One rank's trims (``rounds.Executor``: the same plan on both ranks, so the same trims are asked for).
+
+    **Off the round thread** (``TF_DSV41_HOST_TRIM_BG``, 1): the round thread only asks; a daemon thread per rank
+    (``dsv41-trim-r<rank>``) trims. ``malloc_trim`` runs in ctypes, which releases the GIL, so a trim of GiBs (page
+    table updates and SMMU TLB invalidations on GB10: tens of ms to seconds) no longer sits between two rounds of a
+    prefill or a decode. Asks coalesce: one trim pending at a time, a full one absorbing a plain one. G12's trims ran
+    on the round thread, the full one with ``gc.collect`` (the GIL) and torch's ``_host_emptyCache`` (``cudaFreeHost``
+    can wait for the device): the 2K / 16K cold-prefill outliers of 2026-10-04's prefill study line up with them.
+
+    - ``prefilled(rows)``: every ``TF_DSV41_HOST_TRIM_ROWS`` (32,768; 0 = off) prompt rows, a plain trim;
+    - ``prompt_done()`` after a prompt of at least that many rows: a full trim (``gc.collect``, ``malloc_trim``,
+      torch's cached pinned blocks), **deferred to the next idle point** (``finished(True)``), when no slot holds a
+      request and nothing waits on the GIL or the device;
+    - ``finished(idle)`` (the serving leak, 2026-10-04): a round that finished a request. Agent turns resume from the
+      slot and prefill a few thousand rows, so the trims above never ran for them, while every request allocates and
+      frees tens of MB on the host (the HTTP thread's body, rendered prompt, tokenizer output, id lists on rank 0, the
+      plan's prompt on rank 1). Once any mmapped block of up to 32 MiB is freed (a NumPy Engram row buffer, a request
+      body), glibc raises its mmap threshold to its size and its trim threshold to twice that: later blocks come from
+      the arenas and an arena heap (64 MiB at most) is never trimmed from its top. Prod 7954c1d, one agent session
+      62K -> 99K tokens: rank 0 RssAnon 1.8 -> 4.5 GiB (2.1 GiB in 58 thread-arena heaps, 0.76 in [heap]), rank 1 ->
+      3.4 GiB (1.45 in [heap]), held while idle. With every slot free (``idle``): a trim when RssAnon grew
+      ``TF_DSV41_HOST_TRIM_IDLE_MIB`` (64) since the last one and the last idle trim is ``TF_DSV41_HOST_TRIM_IDLE_S``
+      (30; 0 = off) old (and the deferred full trim, if one waits). With slots busy: a plain trim only past
+      ``TF_DSV41_HOST_TRIM_BUSY_MIB`` (1024; 0 = off) of growth, at most every ``TF_DSV41_HOST_TRIM_BUSY_S`` (300).
+    """
+
+    def __init__(self, every: int | None = None, trim_fn=trim, *, rss_fn=None, clock=time.monotonic,
+                 idle_s: float | None = None, idle_mib: float | None = None, busy_mib: float | None = None,
+                 busy_s: float | None = None, log=None, background: bool | None = None, rank: int = 0) -> None:
+        self.every = _env_int("TF_DSV41_HOST_TRIM_ROWS", 32768) if every is None else int(every)
+        self.trim_fn = trim_fn
+        self.rss_fn = rss_fn or rss_anon_mib
+        self.clock = clock
+        self.idle_s = _env_int("TF_DSV41_HOST_TRIM_IDLE_S", 30) if idle_s is None else float(idle_s)
+        self.idle_mib = _env_int("TF_DSV41_HOST_TRIM_IDLE_MIB", 64) if idle_mib is None else float(idle_mib)
+        self.busy_mib = _env_int("TF_DSV41_HOST_TRIM_BUSY_MIB", 1024) if busy_mib is None else float(busy_mib)
+        self.busy_s = _env_int("TF_DSV41_HOST_TRIM_BUSY_S", 300) if busy_s is None else float(busy_s)
+        self.background = bool(_env_int("TF_DSV41_HOST_TRIM_BG", 1)) if background is None else bool(background)
+        self.log = log if log is not None else (lambda msg: print(msg, file=sys.stderr, flush=True))
+        self.rank = int(rank)
+        self.rows = 0               # prompt rows since the last trim
+        self.long = False           # a prompt of >= ``every`` rows ran since the last full trim
+        self.full_pending = False   # a long prompt's full trim, waiting for the next idle point
+        self.base = None            # RssAnon (MiB) after the last trim (or at the first finish)
+        self.last_idle = self.last_busy = -1e18
+        self.stats = {"trims": 0, "full": 0, "mib": 0.0}
+        self.kinds = {"idle": 0, "busy": 0}     # ``finished``'s trims (also counted in ``stats``)
+        self._lock = threading.Lock()
+        self._cv = threading.Condition(self._lock)
+        self._ask: tuple[bool, str] | None = None   # (full, why) of the pending trim
+        self._busy = False
+        self._thread = None
+
+    # -- the asks (round thread) ---------------------------------------------------------------------------------
+    def prefilled(self, rows: int) -> None:
+        if not self.every:
+            return
+        self.rows += int(rows)
+        if self.rows >= self.every:
+            self.rows = 0
+            self.long = True
+            self._trim(False)
+
+    def prompt_done(self) -> None:
+        if self.every and self.long:
+            self.long, self.rows = False, 0
+            self.full_pending = True            # the full trim at the next idle point (``finished``)
+
+    def finished(self, idle: bool) -> float:
+        """A round finished a request; ``idle``: no slot holds a request now. -> MiB given back (0: no trim, or the
+        trim runs in the background)."""
+
+        if idle and self.full_pending:
+            self.full_pending = False
+            self.last_idle = self.clock()
+            return self._trim(True, "full")
+        if not (self.idle_s or self.busy_mib):
+            return 0.0
+        now, rss = self.clock(), float(self.rss_fn())
+        if self.base is None or rss < self.base:
+            self.base = rss
+        grown = rss - self.base
+        if idle and self.idle_s and grown >= self.idle_mib and now - self.last_idle >= self.idle_s:
+            self.last_idle, kind = now, "idle"
+        elif not idle and self.busy_mib and grown >= self.busy_mib and now - self.last_busy >= self.busy_s:
+            self.last_busy, kind = now, "busy"
+        else:
+            return 0.0
+        self.kinds[kind] += 1
+        return self._trim(False, kind)
+
+    def _trim(self, full: bool, why: str = "rows") -> float:
+        if not self.background:
+            return self._run(full, why)
+        with self._cv:
+            if self._ask is not None:           # coalesce: one pending trim, full wins
+                self._ask = (self._ask[0] or full, self._ask[1] if self._ask[0] or not full else why)
+            else:
+                self._ask = (full, why)
+            if self._thread is None:
+                self._thread = threading.Thread(target=self._loop, name=f"dsv41-trim-r{self.rank}", daemon=True)
+                self._thread.start()
+            self._cv.notify()
+        return 0.0
+
+    # -- the trims (the trim thread, or the caller without ``background``) ---------------------------------------
+    def _loop(self) -> None:
+        while True:
+            with self._cv:
+                while self._ask is None:
+                    self._cv.wait()
+                (full, why), self._ask = self._ask, None
+                self._busy = True
+            try:
+                self._run(full, why)
+            except Exception:                   # noqa: BLE001  (a trim never stops the engine)
+                pass
+            finally:
+                with self._cv:
+                    self._busy = False
+                    self._cv.notify_all()
+
+    def _run(self, full: bool, why: str) -> float:
+        rss = None
+        try:
+            rss = float(self.rss_fn())
+        except Exception:                       # noqa: BLE001  (a report)
+            pass
+        t0 = time.monotonic()
+        got = float(self.trim_fn(full) or 0.0)
+        dt = time.monotonic() - t0
+        with self._lock:
+            self.stats["trims"] += 1
+            self.stats["full"] += int(full)
+            self.stats["mib"] += got
+        try:
+            self.base = float(self.rss_fn())
+        except Exception:                       # noqa: BLE001  (a report)
+            pass
+        if got >= 256 or dt >= 1.0:
+            self.log(f"[dsv41] host trim ({why}{', full' if full else ''}{', background' if self.background else ''})"
+                     f" r{self.rank}: {got / 1024:.2f} GiB back in {dt * 1e3:.0f} ms, RssAnon "
+                     f"{(rss or 0) / 1024:.2f} -> {(self.base or 0) / 1024:.2f} GiB ({self.kinds['idle']} idle / "
+                     f"{self.kinds['busy']} busy trims)")
+        return got
+
+    def flush(self, timeout: float = 30.0) -> bool:
+        """Wait until no trim is pending or running (tests, shutdown). -> True when idle."""
+
+        end = time.monotonic() + timeout
+        with self._cv:
+            while self._ask is not None or self._busy:
+                left = end - time.monotonic()
+                if left <= 0:
+                    return False
+                self._cv.wait(left)
+        return True
+
+
+def anon_by_mapping() -> str:
+    """This process's anonymous RSS by kind of mapping (``/proc/self/smaps``): 1 GiB MAP_NORESERVE reservations
+    (mimalloc's arenas: c10's CPU allocator in NVIDIA's torch builds), glibc's [heap], 64 MiB-aligned regions of at
+    most 64 MiB (glibc's thread arenas), other anonymous mappings; and how much of it is in huge pages."""
+
+    kinds: dict[str, int] = {}
+    thp = 0
+    try:
+        with open("/proc/self/smaps") as f:
+            lines = f.read().split("\n")
+    except OSError:
+        return ""
+    lo = hi = 0
+    name = ""
+    rss = 0
+    for line in lines:
+        head = line.split(" ", 1)[0]
+        if "-" in head and all(c in "0123456789abcdef-" for c in head):
+            parts = line.split()
+            lo, hi = (int(v, 16) for v in head.split("-"))
+            name = parts[5] if len(parts) > 5 else ""
+            rss = 0
+        elif line.startswith("Rss:"):
+            rss = int(line.split()[1])
+        elif line.startswith("AnonHugePages:"):
+            thp += int(line.split()[1])
+        elif line.startswith("VmFlags:") and rss and (name in ("", "[heap]")):
+            size = hi - lo
+            if name == "[heap]":
+                k = "heap"
+            elif size == 1 << 30 and " nr" in line:
+                k = "mimalloc"
+            elif size <= 64 << 20 and lo % (64 << 20) == 0:
+                k = "glibc-arenas"
+            else:
+                k = "other"
+            kinds[k] = kinds.get(k, 0) + rss
+    return ("; anon rss " + ", ".join(f"{k} {v / 2 ** 20:.2f}" for k, v in sorted(kinds.items()))
+            + f" GiB (THP {thp / 2 ** 20:.2f})")
+
+
+def cpu_tensors(top: int = 8) -> str:
+    """Live CPU tensors (``gc``; each storage once): their bytes and the ``top`` largest (shape, dtype) groups.
+    torch's CPU allocations are invisible to tracemalloc (c10's own allocator; mimalloc in NVIDIA's builds), so this
+    tells live data from allocator retention (G12, bug 1). Slow: diagnostics only."""
+
+    try:
+        import torch
+    except ImportError:
+        return ""
+    seen: dict[int, tuple[int, tuple, str]] = {}
+    for o in gc.get_objects():
+        try:
+            if not issubclass(type(o), torch.Tensor) or o.device.type != "cpu":
+                continue
+            st = o.untyped_storage()
+            ptr = st.data_ptr()
+            if ptr and ptr not in seen:
+                seen[ptr] = (st.nbytes(), tuple(o.shape), str(o.dtype).replace("torch.", ""))
+        except Exception:                       # noqa: BLE001  (sparse / meta / wrapper tensors)
+            continue
+    groups: dict[tuple, list[int]] = {}
+    for nb, shape, dt in seen.values():
+        g = groups.setdefault((shape[1:] if len(shape) > 1 else (), dt), [0, 0])
+        g[0] += nb
+        g[1] += 1
+    big = sorted(groups.items(), key=lambda kv: -kv[1][0])[:top]
+    parts = [f"[*,{','.join(map(str, k[0]))}] {k[1]} x{v[1]} {v[0] / 2 ** 20:.1f} MiB" for k, v in big]
+    return (f"; cpu tensors {sum(v[0] for v in seen.values()) / 2 ** 20:.1f} MiB in {len(seen)} storages: "
+            + "; ".join(parts))
+
+
+class _Mallinfo2(ctypes.Structure):
+    _fields_ = [(n, ctypes.c_size_t) for n in ("arena", "ordblks", "smblks", "hblks", "hblkhd", "usmblks", "fsmblks",
+                                               "uordblks", "fordblks", "keepcost")]
+
+
+def glibc_heap() -> dict[str, float] | None:
+    """glibc's own count (``mallinfo2``, glibc >= 2.33), in GiB: bytes in use and free in its arenas, and in mmapped
+    blocks. ``free`` is what a ``malloc_trim`` can give back (whole pages of it): it tells allocator retention from
+    live data (the serving leak). None without glibc."""
+
+    try:
+        f = ctypes.CDLL("libc.so.6").mallinfo2
+    except (OSError, AttributeError):
+        return None
+    f.restype = _Mallinfo2
+    m = f()
+    return {"inuse": m.uordblks / 2 ** 30, "free": m.fordblks / 2 ** 30, "mmap": m.hblkhd / 2 ** 30}
+
+
+class Probe:
+    """``TF_DSV41_MEMPROBE``: a line every ``every`` rounds (stderr). ``TF_DSV41_MEMPROBE_S=N``: also a line every N
+    seconds from a daemon thread (soak.sh: rounds stop when the box is idle, memory does not), with glibc's in-use /
+    free bytes and ``extra()`` (the executor's trim counts)."""
+
+    def __init__(self, rank: int, every: int | None = None, trace: int | None = None, out=None,
+                 seconds: float | None = None) -> None:
+        self.rank = int(rank)
+        self.every = _env_int("TF_DSV41_MEMPROBE", 0) if every is None else int(every)
+        self.trace = _env_int("TF_DSV41_MEMPROBE_TRACE", 0) if trace is None else int(trace)
+        self.tensors = _env_int("TF_DSV41_MEMPROBE_TENSORS", 0)    # K: live CPU tensors, the K largest groups
+        self.smaps = _env_int("TF_DSV41_MEMPROBE_SMAPS", 0)        # 1: anonymous RSS by kind of mapping
+        self.seconds = _env_int("TF_DSV41_MEMPROBE_S", 0) if seconds is None else float(seconds)
+        self.out = out
+        self.rounds = 0
+        self.rows = 0
+        self.snap = None
+        self.t0 = time.monotonic()
+        self.extra = None                       # () -> str, appended to the timed lines
+        self._stop = None
+        if self.every and self.trace:
+            import tracemalloc
+
+            if not tracemalloc.is_tracing():
+                tracemalloc.start(12)
+        if self.seconds:
+            self.start()
+
+    def start(self) -> None:
+        import threading
+
+        self._stop = threading.Event()
+
+        def loop(stop=self._stop) -> None:
+            while not stop.wait(self.seconds):
+                try:
+                    self.timed()
+                except Exception:               # noqa: BLE001  (a report never stops the engine)
+                    pass
+
+        threading.Thread(target=loop, name=f"dsv41-memprobe-r{self.rank}", daemon=True).start()
+
+    def stop(self) -> None:
+        if self._stop is not None:
+            self._stop.set()
+
+    def _parts(self, head: str) -> list[str]:
+        st = status_kib()
+        gib = (lambda k: st.get(k, 0) / 2 ** 20)                    # noqa: E731
+        parts = [f"[dsv41 memprobe] r{self.rank} {head} t {time.monotonic() - self.t0:.0f}s "
+                 f"prompt rows {self.rows}", f"RssAnon {gib('RssAnon'):.2f} RssShmem {gib('RssShmem'):.2f} "
+                 f"VmRSS {gib('VmRSS'):.2f} GiB", f"MemAvailable {mem_available_gib() or 0:.2f} GiB",
+                 f"gc {gc.get_count()}"]
+        try:
+            import torch
+
+            if torch.cuda.is_available() and torch.cuda.is_initialized():
+                parts.append(f"cuda alloc {torch.cuda.memory_allocated() / 2 ** 30:.2f} reserved "
+                             f"{torch.cuda.memory_reserved() / 2 ** 30:.2f} GiB")
+                hs = getattr(torch.cuda, "host_memory_stats", None)
+                if callable(hs):
+                    h = hs()
+                    got = (lambda k: h.get(f"{k}.current", h.get(k, 0)) / 2 ** 30)      # noqa: E731
+                    parts.append(f"pinned {got('allocated_bytes'):.2f} / reserved {got('reserved_bytes'):.2f} GiB")
+        except Exception:                       # noqa: BLE001  (a report)
+            pass
+        return parts
+
+    def round(self, prompt_rows: int = 0) -> str | None:
+        self.rows += int(prompt_rows)
+        if not self.every:
+            return None
+        self.rounds += 1
+        if self.rounds % self.every:
+            return None
+        line = "; ".join(self._parts(f"round {self.rounds}"))
+        if self.trace:
+            line += self._trace()
+        if self.tensors:
+            line += cpu_tensors(self.tensors)
+        if self.smaps:
+            line += anon_by_mapping()
+        print(line, file=self.out or sys.stderr, flush=True)
+        return line
+
+    def timed(self) -> str:
+        """The timed line (``TF_DSV41_MEMPROBE_S``): the round line's fields, glibc's heap, the trims."""
+
+        parts = self._parts(f"timed (round {self.rounds})")
+        g = glibc_heap()
+        if g is not None:
+            parts.append(f"glibc in use {g['inuse']:.2f} free {g['free']:.2f} mmap {g['mmap']:.2f} GiB")
+        if self.extra is not None:
+            parts.append(str(self.extra()))
+        line = "; ".join(parts)
+        if self.smaps:
+            line += anon_by_mapping()
+        print(line, file=self.out or sys.stderr, flush=True)
+        return line
+
+    def _trace(self) -> str:
+        import tracemalloc
+
+        if not tracemalloc.is_tracing():
+            return ""
+        snap = tracemalloc.take_snapshot().filter_traces([tracemalloc.Filter(False, tracemalloc.__file__)])
+        prev, self.snap = self.snap, snap
+        if prev is None:
+            return f"; tracemalloc {tracemalloc.get_traced_memory()[0] / 2 ** 20:.1f} MiB (baseline)"
+        lines = [f"; tracemalloc {tracemalloc.get_traced_memory()[0] / 2 ** 20:.1f} MiB, grew:"]
+        for d in snap.compare_to(prev, "traceback")[:self.trace]:
+            frames = " <- ".join(f"{f.filename.rsplit('/', 1)[-1]}:{f.lineno}" for f in list(d.traceback)[::-1][:6])
+            lines.append(f"\n    {d.size_diff / 2 ** 20:+.1f} MiB ({d.count_diff:+d} blocks) {frames}")
+        return "".join(lines)
+
+
+__all__ = ["Probe", "Trimmer", "anon_by_mapping", "cpu_tensors", "glibc_heap", "malloc_trim", "mem_available_gib", "numpy_hugepages", "rss_anon_mib", "status_kib", "trim"]
