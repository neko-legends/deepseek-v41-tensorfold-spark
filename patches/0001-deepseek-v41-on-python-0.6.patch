+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G14 on the CPU: the L2 prefetch's placement knobs (``l2pf.py``: TF_DSV41_L2PF_PACE_GBPS / _PACE_CTAS /
+_PACE_SITES / _DELAY_US / _AT) and the plan link's ``rdma`` mode and thread pinning (``planlink.py``). The GPU half:
+``tests/cuda/test_dsv41_g14_gpu.py``; the mailbox protocol itself: ``tests/test_roce_g14_msg.py``.
+
+- l2pf: the new knobs parse (defaults = G10's behaviour; pacing needs bulk), the pace arithmetic, AT=after defers
+  sites x / f to the next exchange (``tensorfold.cuda.comm.AFTER_GATHER``) and launches o at once, a deferred site no
+  exchange followed is dropped at the join, fast_gather runs the hooks after the exchange;
+- plan link: ``rdma`` handshakes over TCP and moves plans through a mailbox (a fake one here), refuses a rank 0 that
+  is not on rdma, falls back to tcp without a RoCE runtime; TF_DSV41_PLAN_PIN parsing and the pinning wrapper.
+"""
+
+from __future__ import annotations
+
+import socket
+import threading
+import types
+
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.cuda import comm as C  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import l2pf as L2  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import planlink as PL  # noqa: E402
+
+
+# -- l2pf -------------------------------------------------------------------------------------------------------------
+def test_l2pf_g14_settings():
+    s = L2.settings({L2.ENV: "1"})
+    assert (s.pace_gbps, s.pace_ctas, s.pace_sites, s.delay_us, s.at) == (0.0, 2, ("x", "f"), 0.0, "before")
+    s = L2.settings({L2.ENV: "1", L2.ENV + "_PACE_GBPS": "150", L2.ENV + "_PACE_CTAS": "4",
+                     L2.ENV + "_PACE_SITES": "x", L2.ENV + "_DELAY_US": "3", L2.ENV + "_AT": "after"})
+    assert (s.pace_gbps, s.pace_ctas, s.pace_sites, s.delay_us, s.at) == (150.0, 4, ("x",), 3.0, "after")
+    for bad in ({L2.ENV: "lines", L2.ENV + "_PACE_GBPS": "100"}, {L2.ENV: "1", L2.ENV + "_AT": "middle"},
+                {L2.ENV: "1", L2.ENV + "_PACE_SITES": "q"}, {L2.ENV: "1", L2.ENV + "_PACE_CTAS": "0"}):
+        with pytest.raises(ValueError):
+            L2.settings(bad)
+
+
+def test_pace_args():
+    s = L2.settings({L2.ENV: "1", L2.ENV + "_PACE_GBPS": "128", L2.ENV + "_DELAY_US": "2.5"})
+    assert L2.pace_args(s, 32 * 1024) == (256, 2500)          # 32 KiB at 128 GB/s (bytes a ns): 256 ns a piece
+
+
+def _fake_prefetcher(at: str):
+    pf = object.__new__(L2.Prefetcher)
+    pf.s = L2.settings({L2.ENV: "1", L2.ENV + "_AT": at})
+    pf.stats = L2.Stats()
+    pf.tables = {}
+    pf.deferred = None
+    pf.launched = []
+    pf._launch = lambda blk, site, table: pf.launched.append((blk.name, site))
+    return pf
+
+
+def test_at_after_defers_to_the_next_exchange(monkeypatch):
+    pf = _fake_prefetcher("after")
+    blk = types.SimpleNamespace(name="b3")
+    for site in ("x", "f", "o"):
+        pf.tables[(id(blk), site)] = object()
+    pf.mark(blk, "o", 1)                                  # no exchange after o: launched at once
+    pf.mark(blk, "f", 1)
+    assert pf.launched == [("b3", "o")] and pf.deferred == (blk, "f")
+    pf.fire_deferred()
+    assert pf.launched[-1] == ("b3", "f") and pf.deferred is None and pf.stats.deferred == 1
+    pf.fire_deferred()                                    # nothing pending: nothing happens
+    assert len(pf.launched) == 2
+    pf.mark(blk, "x", 1)
+    pf.pending = False
+    pf.join()                                             # no exchange came before the join: dropped
+    assert pf.deferred is None and pf.stats.dropped == 1 and len(pf.launched) == 2
+    pf.mark(blk, "x", 99)                                 # wider than TF_DSV41_L2PF_ROWS: skipped as before
+    assert pf.deferred is None and pf.stats.skipped_rows == 1
+
+
+def test_at_before_is_g10():
+    pf = _fake_prefetcher("before")
+    blk = types.SimpleNamespace(name="b1")
+    pf.tables[(id(blk), "x")] = object()
+    pf.mark(blk, "x", 1)
+    assert pf.launched == [("b1", "x")] and pf.deferred is None
+
+
+def test_fast_gather_runs_hooks_after_the_exchange(monkeypatch):
+    order = []
+
+    class Comm:
+        def all_gather_fast(self, send, recv):
+            order.append("gather")
+
+    monkeypatch.setattr(C, "AFTER_GATHER", [lambda: order.append("hook")])
+    C.fast_gather(Comm(), torch.zeros(1), torch.zeros(2))
+    assert order == ["gather", "hook"]
+    monkeypatch.setattr(C, "AFTER_GATHER", [])
+    C.fast_gather(Comm(), torch.zeros(1), torch.zeros(2))
+    assert order == ["gather", "hook", "gather"]
