index 0000000..cc12414
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/health.py
@@ -0,0 +1,356 @@
+"""patches/0150: liveness for the Spark server (``server.py``): ``GET /health`` that can say no, and ``GET /metrics``.
+
+Upstream's ``/health`` answers ``{"ok": true}`` whatever the engine is doing. With two ranks that is not enough: a
+CUDA error or an out-of-memory in the middle of a request leaves rank 1 waiting in a collective forever, the next
+request hangs behind it, and ``/health`` still says ok (the MiaAI-Lab and vLLM-kit watchdogs found the same with
+vLLM: ``/health`` stays 200 through a stuck NCCL collective, so they watch forward progress instead). This module
+keeps, per server:
+
+- ``fatal``: the first exception (other than ``ValueError``: a bad request) raised out of ``engine.generate``. The
+  ranks are out of step after one, so nothing after it can be trusted.
+- the requests in flight, each with its prompt length, start time and the time of its last token, so a request that
+  stopped making progress is visible (a stall).
+- counters for ``/metrics`` (Prometheus text): requests, errors, prompt / completion / cached tokens, decode rounds
+  and seconds, prefill seconds. Tokens a round over an interval is the drafter's health (a broken or mismatched
+  drafter decodes one token a round).
+
+``GLM53_TF_HEALTH``:
+
+- ``basic`` (default): ``/health`` stays 200 and adds the fields below (``fatal``, ``stalled``, ``inflight``, ...),
+  so nothing that polls it today changes behaviour.
+- ``strict``: ``/health`` answers 503 once ``fatal`` is set or while a request is stalled, and new completions get a
+  503 right away once ``fatal`` is set (instead of queueing behind a hung collective). ``scripts/serve.sh watch``
+  restarts both ranks on it.
+
+patches/0600 (upstream 51b098d / c4bf25f, MIT, by MiaAI Lab and ashhart): ``/health`` also carries upstream's
+live totals under upstream's names, so pollers written for upstream (dashboards reading tok/s) work here too:
+``backend``, ``busy``, ``requests_running``, ``requests_total``, ``prompt_tokens_total``, ``completion_tokens_total``
+(finished replies plus the running replies' tokens so far: it moves as tokens are emitted), ``prefill_seconds_total``,
+``decode_seconds_total``, ``cached_tokens_total``, ``rounds_total``, ``drafted_total``, ``accepted_total``, and with the
+batch engine ``streams`` (decoding / prefilling / max slots) and ``context_length``. As upstream, a request that
+failed still counts its prompt and the tokens it emitted; the engine's own stats (seconds, rounds, drafts) come when a
+request ends. 0150's fields (``ok``, ``mode``, ``inflight``, ``requests``, ``errors``, ...) are unchanged, and
+``/metrics`` is unchanged.
+
+A request is stalled when its last token (or its start, before the first token) is older than ``GLM53_TF_STALL_S``
+(default 0: never) plus, before the first token, its prompt at ``GLM53_TF_STALL_PREFILL_TPS`` tokens a second
+(default 200, well under the slowest measured prefill, so a 1M prompt gets ~83 min before it counts).
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+import threading
+import time
+from typing import Any
+
+MODES = ("basic", "strict")
+
+
+def env_mode() -> str:
+    mode = os.environ.get("GLM53_TF_HEALTH", "basic").strip().lower() or "basic"
+    if mode not in MODES:
+        raise ValueError(f"GLM53_TF_HEALTH={mode!r}: expected one of {', '.join(MODES)}")
+    return mode
+
+
+def _env_float(name: str, default: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    value = float(raw)
+    if value < 0:
+        raise ValueError(f"{name}={raw}: must be >= 0")
+    return value
+
+
+class Health:
+    """Thread-safe request bookkeeping for ``/health`` and ``/metrics``. ``clock``: for tests."""
+
+    def __init__(self, *, mode: str | None = None, stall_s: float | None = None, prefill_tps: float | None = None,
+                 clock=time.monotonic) -> None:
+        self.mode = mode or env_mode()
+        self.stall_s = _env_float("GLM53_TF_STALL_S", 0.0) if stall_s is None else float(stall_s)
+        self.prefill_tps = _env_float("GLM53_TF_STALL_PREFILL_TPS", 200.0) if prefill_tps is None \
+            else float(prefill_tps)
+        self.clock = clock
+        self.started = clock()
+        self.lock = threading.Lock()
+        self.fatal: str | None = None
+        self.inflight: dict[int, dict[str, float]] = {}
+        self.next_id = 0
+        self.last_done = None
+        self.counters: dict[str, float] = {k: 0 for k in (
+            "requests", "errors", "rejected", "prompt_tokens", "completion_tokens", "cached_tokens",
+            "decode_rounds", "decode_seconds", "prefill_seconds")}
+        # patches/0600: upstream's /health totals (every ended request, failed ones included)
+        self.totals: dict[str, float] = dict.fromkeys(TOTALS, 0)
+
+    # -- request lifecycle -------------------------------------------------------------------------------------
+
+    def begin(self, prompt_tokens: int) -> int:
+        with self.lock:
+            rid = self.next_id
+            self.next_id += 1
+            now = self.clock()
+            self.inflight[rid] = {"prompt": float(prompt_tokens), "start": now, "last": now, "tokens": 0.0}
+            return rid
+
+    def progress(self, rid: int, n: int) -> None:
+        with self.lock:
+            entry = self.inflight.get(rid)
+            if entry is not None:
+                entry["last"] = self.clock()
+                entry["tokens"] += n
+
+    def end(self, rid: int, *, stats: dict[str, Any] | None = None, completion_tokens: int = 0,
+            error: BaseException | None = None) -> None:
+        with self.lock:
+            entry = self.inflight.pop(rid, None)
+            self.last_done = self.clock()
+            self._fold(entry, stats if error is None else None)          # patches/0600
+            c = self.counters
+            c["requests"] += 1
+            if error is not None:
+                c["errors"] += 1
+                if not isinstance(error, ValueError) and self.fatal is None:
+                    self.fatal = f"{type(error).__name__}: {error}"[:500]
+                return
+            c["prompt_tokens"] += entry["prompt"] if entry else 0
+            c["completion_tokens"] += completion_tokens
+            stats = stats or {}
+            c["cached_tokens"] += float(stats.get("cached", 0) or 0)
+            c["decode_rounds"] += float(stats.get("rounds", 0) or 0)
+            c["decode_seconds"] += float(stats.get("decode_s", 0) or 0)
+            c["prefill_seconds"] += float(stats.get("prefill_s", 0) or 0)
+
+    def _fold(self, entry: dict[str, float] | None, stats: dict[str, Any] | None) -> None:
+        """patches/0600: an ended request into upstream's totals (its prompt, the tokens it emitted, its stats)."""
+
+        t = self.totals
+        t["requests_total"] += 1
+        if entry is not None:
+            t["prompt_tokens_total"] += entry["prompt"]
+            t["completion_tokens_total"] += entry["tokens"]
+        for key, name in STATS.items():
+            value = (stats or {}).get(key)
+            if isinstance(value, (int, float)) and not isinstance(value, bool):
+                t[name] += value
+
+    def totals_now(self) -> dict[str, Any]:
+        """patches/0600: upstream's /health totals now: ended requests plus the running replies' tokens so far."""
+
+        with self.lock:
+            body: dict[str, Any] = dict(self.totals)
+            body["completion_tokens_total"] += sum(e["tokens"] for e in self.inflight.values())
+            running = len(self.inflight)
+        body = {k: (round(v, 6) if isinstance(v, float) and not float(v).is_integer() else int(v))
+                for k, v in body.items()}
+        return {"backend": "tensorfold", "busy": running > 0, "requests_running": running, **body}
+
+    def reject(self) -> str | None:
+        """Why a new completion must not start (strict mode after a fatal error), or None."""
+
+        if self.mode == "strict" and self.fatal is not None:
+            with self.lock:
+                self.counters["rejected"] += 1
+            return f"the engine failed earlier ({self.fatal}); restart both ranks"
+        return None
+
+    def track(self, engine) -> "TrackedEngine":
+        return TrackedEngine(engine, self)
+
+    # -- views -------------------------------------------------------------------------------------------------
+
+    def _stalled(self, now: float) -> list[dict[str, float]]:
+        if self.stall_s <= 0:
+            return []
+        out = []
+        for entry in self.inflight.values():
+            allow = self.stall_s
+            if entry["tokens"] == 0 and self.prefill_tps > 0:
+                allow += entry["prompt"] / self.prefill_tps
+            quiet = now - entry["last"]
+            if quiet > allow:
+                out.append({"prompt": entry["prompt"], "quiet_s": round(quiet, 1), "allowed_s": round(allow, 1)})
+        return out
+
+    def status(self, app=None) -> tuple[int, dict[str, Any]]:
+        """(HTTP code, body) for ``GET /health``. patches/0600: upstream's live totals too, and with ``app`` its
+        engine's slots (``streams``) and context (``context_length``)."""
+
+        with self.lock:
+            now = self.clock()
+            stalled = self._stalled(now)
+            body: dict[str, Any] = {
+                "ok": self.fatal is None and not stalled,
+                "mode": self.mode,
+                "uptime_s": round(now - self.started, 1),
+                "inflight": len(self.inflight),
+                "oldest_s": round(max((now - e["start"] for e in self.inflight.values()), default=0.0), 1),
+                "idle_s": round(now - self.last_done, 1) if self.last_done is not None and not self.inflight
+                else None,
+                "requests": int(self.counters["requests"]),
+                "errors": int(self.counters["errors"]),
+            }
+            if self.fatal is not None:
+                body["fatal"] = self.fatal
+            if stalled:
+                body["stalled"] = stalled
+        body.update(self.totals_now())             # patches/0600: after the lock (it takes it again)
+        if app is not None:
+            body.update(engine_view(app))
+        code = 503 if self.mode == "strict" and not body["ok"] else 200
+        return code, body
+
+    def metrics(self, served: str = "", app=None) -> str:
+        """Prometheus text exposition (counters and gauges, one ``model`` label). With ``app``: also the
+        vLLM-named series that fleet dashboards and routers read (``vllm_view``)."""
+
+        with self.lock:
+            now = self.clock()
+            c = dict(self.counters)
+            inflight = len(self.inflight)
+            stalled = len(self._stalled(now))
+            fatal = int(self.fatal is not None)
+            uptime = now - self.started
+        label = '{model="%s"}' % served.replace("\\", "\\\\").replace('"', '\\"')
+        rows = [
+            ("tensorfold_requests_total", "counter", "completions finished (errors included)", c["requests"]),
+            ("tensorfold_request_errors_total", "counter", "completions that raised", c["errors"]),
+            ("tensorfold_requests_rejected_total", "counter", "completions refused after a fatal error",
+             c["rejected"]),
+            ("tensorfold_prompt_tokens_total", "counter", "prompt tokens of finished completions", c["prompt_tokens"]),
+            ("tensorfold_cached_tokens_total", "counter", "prompt tokens resumed instead of prefilled",
+             c["cached_tokens"]),
+            ("tensorfold_completion_tokens_total", "counter", "generated tokens", c["completion_tokens"]),
+            ("tensorfold_decode_rounds_total", "counter", "decode rounds (tokens / rounds: draft acceptance)",
+             c["decode_rounds"]),
+            ("tensorfold_decode_seconds_total", "counter", "seconds decoding", c["decode_seconds"]),
+            ("tensorfold_prefill_seconds_total", "counter", "seconds prefilling", c["prefill_seconds"]),
+            ("tensorfold_requests_inflight", "gauge", "completions running now", inflight),
+            ("tensorfold_requests_stalled", "gauge", "running completions past GLM53_TF_STALL_S", stalled),
+            ("tensorfold_engine_fatal", "gauge", "1 once the engine raised (restart both ranks)", fatal),
+            ("tensorfold_uptime_seconds", "gauge", "seconds since the server started", uptime),
+        ]
+        out = []
+        for name, kind, doc, value in rows:
+            value = float(value)
+            shown = str(int(value)) if value.is_integer() else f"{value:.6f}"
+            out += [f"# HELP {name} {doc}", f"# TYPE {name} {kind}", f"{name}{label} {shown}"]
+        if app is not None:
+            out += vllm_view(self, app, served)
+        return "\n".join(out) + "\n"
+
+    def model_info(self, app) -> dict[str, Any]:
+        """``GET /v1/model_info``: the request slots and context as vLLM's debug model info names them
+        (``max_num_seqs``, ``max_model_len``), for tools that size their concurrency from it."""
+
+        view = engine_view(app)
+        out: dict[str, Any] = {"backend": "tensorfold"}
+        if "streams" in view:
+            out["max_num_seqs"] = view["streams"]["max"]
+        if "context_length" in view:
+            out["max_model_len"] = view["context_length"]
+        return out
+
+
+# patches/0600: an engine's stats key -> upstream's /health total
+STATS = {"prefill_s": "prefill_seconds_total", "decode_s": "decode_seconds_total", "cached": "cached_tokens_total",
+         "rounds": "rounds_total", "drafted": "drafted_total", "accepted": "accepted_total"}
+TOTALS = ("requests_total", "prompt_tokens_total", "completion_tokens_total", *STATS.values())
+
+
+def engine_view(app) -> dict[str, Any]:
+    """patches/0600: upstream's ``streams`` for a batch engine (GLM53_TF_BATCH: slots decoding / prefilling / all,
+    read without a lock: sizes only) and ``context_length`` (the engine's limit)."""
+
+    out: dict[str, Any] = {}
+    engine = getattr(app, "engine", None)
+    batch = getattr(engine, "batch", None)
+    seqs = getattr(batch, "seqs", None)
+    if seqs is not None:
+        live = [s for s in list(seqs) if s is not None]
+        out["streams"] = {"decoding": sum(1 for s in live if getattr(s, "stepper", None) is not None),
+                          "prefilling": sum(1 for s in live if getattr(s, "stepper", None) is None),
+                          "max": int(getattr(batch, "n", len(seqs)) or len(seqs))}
+    limit = getattr(engine, "limit", None)
+    if isinstance(limit, int) and not isinstance(limit, bool) and limit > 0:
+        out["context_length"] = limit
+    return out
+
+
+def vllm_view(health: Health, app, served: str = "") -> list[str]:
+    """The vLLM-named series dashboards and routers built for vLLM read (requests running / waiting, token and
+    finish counters), from this server's own numbers: a fleet dashboard (DGX-dash's ``LlmProbe``) then shows a
+    TensorFold engine's real slots and token rates instead of assuming one sequence."""
+
+    view = engine_view(app)
+    totals = health.totals_now()
+    with health.lock:
+        inflight = len(health.inflight)
+        requests, errors = int(health.counters["requests"]), int(health.counters["errors"])
+    streams = view.get("streams")
+    running = streams["decoding"] + streams["prefilling"] if streams else inflight
+    name = served.replace("\\", "\\\\").replace('"', '\\"')
+    label = f'model_name="{name}"'
+    rows = [
+        ("vllm:num_requests_running", "gauge", "requests in a slot (prefilling or decoding)", None, running),
+        ("vllm:num_requests_waiting", "gauge", "requests waiting for a slot", None, max(0, inflight - running)),
+        ("vllm:prompt_tokens_total", "counter", "prompt tokens", None, totals.get("prompt_tokens_total", 0)),
+        ("vllm:generation_tokens_total", "counter", "generated tokens (running replies included)", None,
+         totals.get("completion_tokens_total", 0)),
+        ("vllm:prompt_tokens_cached_total", "counter", "prompt tokens resumed from the session cache", None,
+         totals.get("cached_tokens_total", 0)),
+        ("vllm:request_success_total", "counter", "finished requests by reason", 'finished_reason="stop"',
+         max(0, requests - errors)),
+        ("vllm:request_success_total", "counter", "finished requests by reason", 'finished_reason="error"', errors),
+    ]
+    out, seen = [], set()
+    for metric, kind, doc, extra, value in rows:
+        if metric not in seen:
+            out += [f"# HELP {metric} {doc}", f"# TYPE {metric} {kind}"]
+            seen.add(metric)
+        labels = label + ("," + extra if extra else "")
+        out.append(f"{metric}{{{labels}}} {int(value)}")
+    return out
+
+
+class TrackedEngine:
+    """``engine`` with ``generate`` going through ``Health`` (begin, a progress mark per token callback, end with
+    the stats or the exception). Every other attribute is the engine's own (read and written through)."""
+
+    def __init__(self, engine, health: Health) -> None:
+        object.__setattr__(self, "_engine", engine)
+        object.__setattr__(self, "_health", health)
+        inner = engine.generate
+
+        @functools.wraps(inner)                 # keeps the signature: ``App.check`` inspects it for ``draft``
+        def generate(prompt, max_tokens, sampling, on_tokens, *args, **kwargs):
+            rid = health.begin(len(prompt))
+            count = [0]
+
+            def tracked(new):
+                count[0] += len(new)
+                health.progress(rid, len(new))
+                return on_tokens(new)
+
+            if getattr(on_tokens, "cancelled", None) is not None:
+                tracked.cancelled = on_tokens.cancelled     # patches/0600: the client check reaches the engine
+
+            try:
+                stats = inner(prompt, max_tokens, sampling, tracked, *args, **kwargs)
+            except BaseException as exc:
+                health.end(rid, error=exc)
+                raise
+            health.end(rid, stats=stats if isinstance(stats, dict) else None, completion_tokens=count[0])
+            return stats
+
+        object.__setattr__(self, "generate", generate)
+
+    def __getattr__(self, name: str):
+        return getattr(self._engine, name)
+
+    def __setattr__(self, name: str, value) -> None:
+        setattr(self._engine, name, value)
diff --git a/src/tensorfold/families/glm5_next/spark/image_fetch.py b/src/tensorfold/families/glm5_next/spark/image_fetch.py
new file mode 100644
index 0000000..d4319ad
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/image_fetch.py
@@ -0,0 +1,239 @@
+"""patches/0600: bounded image URL retrieval with validated, pinned public addresses, for 0500's ``image_url`` parts.
+
+Ported from upstream TensorFold 391713e (+ 05cbb54, b4042e8): ``tensorfold/vision/images_http.py`` (MIT License,
+Copyright (c) 2026 TensorFold contributors), with these changes for our GLM vision (``vision_prep.load_bytes``):
+
+- ``Policy.http`` (GLM53_TF_VISION_FETCH_HTTP=1, default 0) also takes ``http://`` URLs and any port, and
+  ``Policy.private`` (GLM53_TF_VISION_FETCH_PRIVATE=1, default 0) any resolved address: both for local testing only.
+  Defaults: HTTPS on port 443 to public addresses, exactly upstream's rule.
+- ``image/gif`` is accepted beside JPEG / PNG / WebP (0500 decodes a GIF's first frame, as vLLM does).
+- NAT64 (``64:ff9b::/96``, ``64:ff9b:1::/48``) and IPv4-compatible IPv6 addresses are refused too (they can carry a
+  private IPv4 address).
+- A DNS lookup waits for one of the bounded resolver slots until the deadline instead of failing at once.
+- A reply that closes the connection (``Connection: close``, HTTP/1.0) is read to its end: upstream's per-read
+  ``settimeout`` fails there once ``http.client`` has closed the socket (the watchdog still bounds the read).
+- Messages never contain the URL (the caller's 400 goes to the client, logs are redacted by the server).
+
+What it does (upstream's design): the URL must be ``https`` on 443 with a host, no credentials, fragment, backslash or
+control characters, at most ``max_url_chars``; the host is resolved on a small bounded pool of threads and **every**
+address must be public (``is_global``, not multicast / reserved / 6to4 / Teredo / IPv4-mapped, not 192.0.0.0/24, not
+Azure's 168.63.129.16; this excludes private, loopback, link-local incl. 169.254.169.254, CGNAT 100.64/10 incl.
+100.100.100.200 and fd00:ec2::254); the socket connects to the checked address (no second lookup a rebinding DNS
+could answer differently), TLS verified for the host name; ``identity`` encoding only, a declared image type, at most
+``max_bytes``; each redirect (301/302/303/307/308, at most ``max_redirects``) is checked the same way from the start;
+one deadline covers every step (a watchdog closes the socket if a handshake or header read stalls).
+"""
+
+from __future__ import annotations
+
+import http.client
+import ipaddress
+import queue
+import socket
+import ssl
+import threading
+import time
+from dataclasses import dataclass
+from urllib.parse import quote, urljoin, urlsplit
+
+MEDIA_TYPES = {"image/jpeg": "JPEG", "image/png": "PNG", "image/webp": "WEBP", "image/gif": "GIF"}
+_DNS_SLOTS = threading.BoundedSemaphore(4)
+_REDIRECTS = {301, 302, 303, 307, 308}
+_SPECIAL_V4 = (ipaddress.ip_network("192.0.0.0/24"), ipaddress.ip_network("168.63.129.16/32"))
+_SPECIAL_V6 = (ipaddress.ip_network("64:ff9b::/96"), ipaddress.ip_network("64:ff9b:1::/48"),
+               ipaddress.ip_network("::/96"))
+_BLOCKED_HOSTS = {"localhost", "metadata.google.internal", "instance-data", "metadata"}
+USER_AGENT = "tensorfold-glm53-vision/2"
+
+
+class ImageFetchError(ValueError):
+    """An invalid, inaccessible, or oversized image URL (HTTP 400; ``vision_prep`` re-raises it as VisionError)."""
+
+
+@dataclass(frozen=True)
+class Policy:
+    http: bool = False              # GLM53_TF_VISION_FETCH_HTTP: http:// and any port (local testing)
+    private: bool = False           # GLM53_TF_VISION_FETCH_PRIVATE: any address (local testing)
+    max_redirects: int = 3
+    max_url_chars: int = 4096
+
+
+def _remaining(deadline: float) -> float:
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise ImageFetchError("image download timed out")
+    return remaining
+
+
+def public_ip(value: str) -> bool:
+    """Whether ``value`` is an address a public image host may have (upstream's rule plus NAT64 / IPv4-compatible)."""
+
+    try:
+        address = ipaddress.ip_address(value.split("%", 1)[0])
+    except ValueError:
+        return False
+    if not address.is_global or address.is_multicast or address.is_reserved:
+        return False
+    if isinstance(address, ipaddress.IPv4Address):
+        return not any(address in block for block in _SPECIAL_V4)
+    if address.ipv4_mapped or address.sixtofour or address.teredo:
+        return False
+    return not any(address in block for block in _SPECIAL_V6)
+
+
+def _resolve(host: str, port: int, deadline: float, policy: Policy) -> list[tuple]:
+    """``host``'s addresses, every one checked; a stalled lookup holds one of four resolver threads at most."""
+
+    slots = _DNS_SLOTS
+    if not slots.acquire(timeout=_remaining(deadline)):
+        raise ImageFetchError("image DNS resolver is busy; retry the request")
+    result: queue.Queue = queue.Queue(maxsize=1)
+
+    def resolve() -> None:
+        try:
+            result.put(socket.getaddrinfo(host, port, type=socket.SOCK_STREAM))
+        except Exception as exc:        # noqa: BLE001
+            result.put(exc)
+        finally:
+            slots.release()
+
+    try:
+        threading.Thread(target=resolve, daemon=True, name="tf-image-dns").start()
+    except RuntimeError:
+        slots.release()
+        raise ImageFetchError("image DNS resolver is unavailable") from None
+    try:
+        addresses = result.get(timeout=_remaining(deadline))
+    except queue.Empty:
+        raise ImageFetchError("image DNS lookup timed out") from None
+    if isinstance(addresses, Exception):
+        raise ImageFetchError("image host could not be resolved") from None
+    if not addresses:
+        raise ImageFetchError("image host could not be resolved")
+    if not policy.private and any(not public_ip(item[4][0]) for item in addresses):
+        raise ImageFetchError("image URLs must resolve only to public internet addresses")
+    return addresses
+
+
+def check_url(value: str, policy: Policy = Policy()) -> tuple[str, str, int, str]:
+    """(scheme, host, port, request target) of an acceptable image URL; ImageFetchError otherwise."""
+
+    if not isinstance(value, str) or len(value) > policy.max_url_chars or any(
+            ord(char) <= 32 or ord(char) == 127 for char in value):
+        raise ImageFetchError("image URL is too long or contains whitespace/control characters")
+    try:
+        parsed = urlsplit(value)
+        scheme = parsed.scheme.lower()
+        if scheme not in (("https", "http") if policy.http else ("https",)):
+            raise ValueError
+        if not parsed.hostname or parsed.fragment:
+            raise ValueError
+        if parsed.username is not None or parsed.password is not None or "\\" in value:
+            raise ValueError
+        host = parsed.hostname.encode("idna").decode("ascii")
+        default = 443 if scheme == "https" else 80
+        port = parsed.port if parsed.port is not None else default
+        if "%" in host or (not policy.http and port != 443):
+            raise ValueError
+    except (ValueError, UnicodeError):
+        rule = "HTTP(S)" if policy.http else "HTTPS on port 443"
+        raise ImageFetchError(f"image URL must be {rule}, without credentials or a fragment") from None
+    if not policy.private and host.rstrip(".").lower() in _BLOCKED_HOSTS:
+        raise ImageFetchError("image URLs must use public internet hosts")
+    target = quote(parsed.path or "/", safe="/%:@!$&'()*+,;=-._~")
+    if parsed.query:
+        target += "?" + quote(parsed.query, safe="/%?:@!$&'()*+,;=-._~")
+    return scheme, host, port, target
+
+
+def _close_socket(sock: socket.socket) -> None:
+    try:
+        sock.shutdown(socket.SHUT_RDWR)
+    except OSError:
+        pass
+    sock.close()
+
+
+def _request(scheme: str, host: str, port: int, target: str, addresses: list[tuple], max_bytes: int,
+             deadline: float) -> tuple[bytes | None, str | None, str | None]:
+    """One GET on the first checked address: (bytes, None, type) or (None, redirect location, None)."""
+
+    timeout = _remaining(deadline)
+    family, kind, protocol, _, address = addresses[0]
+    sock = socket.socket(family, kind, protocol)
+    live_socket = [sock]
+    timer = threading.Timer(timeout, lambda: _close_socket(live_socket[0]))
+    timer.daemon = True
+    connection = http.client.HTTPConnection(host, port, timeout=timeout)
+    try:
+        timer.start()
+        sock.settimeout(_remaining(deadline))
+        sock.connect(address)
+        if scheme == "https":
+            context = ssl.create_default_context()        # TLS verified for the host, on the address checked for it
+            sock = context.wrap_socket(sock, server_hostname=host, do_handshake_on_connect=False)
+            live_socket[0] = sock
+            sock.settimeout(_remaining(deadline))
+            sock.do_handshake()
+        connection.sock = sock
+        connection.request("GET", target, headers={"Accept": ", ".join(MEDIA_TYPES), "Accept-Encoding": "identity",
+                                                   "User-Agent": USER_AGENT})
+        response = connection.getresponse()
+        _remaining(deadline)
+        if response.status in _REDIRECTS:
+            location = response.getheader("Location")
+            if not location:
+                raise ImageFetchError("image redirect has no destination")
+            return None, location, None
+        if response.status != 200:
+            raise ImageFetchError(f"image download returned HTTP {response.status}")
+        if response.getheader("Content-Encoding", "identity").lower() != "identity":
+            raise ImageFetchError("compressed HTTP image responses are unsupported")
+        media = response.getheader("Content-Type", "").split(";", 1)[0].strip().lower()
+        if media not in MEDIA_TYPES:
+            raise ImageFetchError("image URL content type must be JPEG, PNG, WebP or GIF")
+        length = response.getheader("Content-Length")
+        if length is not None:
+            if not length.isascii() or not length.isdecimal() or int(length) > max_bytes:
+                raise ImageFetchError(f"image larger than {max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+        data = bytearray()
+        while len(data) <= max_bytes:
+            try:
+                sock.settimeout(_remaining(deadline))
+            except OSError:
+                # (ours) http.client closed the connection's socket for a ``Connection: close`` / HTTP/1.0 reply; the
+                # body still reads through the response's file, bounded by the watchdog and the deadline
+                pass
+            chunk = response.read1(min(64 * 1024, max_bytes + 1 - len(data)))
+            if not chunk:
+                break
+            data.extend(chunk)
+        if len(data) > max_bytes:
+            raise ImageFetchError(f"image larger than {max_bytes} bytes (GLM53_TF_VISION_MAX_BYTES)")
+        _remaining(deadline)
+        return bytes(data), None, media
+    finally:
+        timer.cancel()
+        connection.close()
+        _close_socket(sock)
+
+
+def fetch_image(url: str, *, max_bytes: int, deadline: float, policy: Policy = Policy()) -> tuple[bytes, str]:
+    """(bytes, declared type) of an image URL: each hop (the URL, then every redirect) checked, resolved, its
+    addresses checked, then fetched from the checked address; everything before ``deadline`` (``time.monotonic``)."""
+
+    try:
+        for redirect in range(policy.max_redirects + 1):
+            scheme, host, port, target = check_url(url, policy)
+            addresses = _resolve(host, port, deadline, policy)
+            data, location, media = _request(scheme, host, port, target, addresses, max_bytes, deadline)
+            if location is None:
+                return data, media
+            if redirect == policy.max_redirects:
+                raise ImageFetchError("image download has too many redirects")
+            url = urljoin(url, location)
+    except ImageFetchError:
+        raise
+    except (OSError, ValueError, http.client.HTTPException):
+        raise ImageFetchError("image download failed or timed out") from None
+    raise ImageFetchError("image download failed")
diff --git a/src/tensorfold/families/glm5_next/spark/kda.cpp b/src/tensorfold/families/glm5_next/spark/kda.cpp
new file mode 100644
index 0000000..33e5930
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/kda.cpp
@@ -0,0 +1,106 @@
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void kda_chain_cuda(const at::Tensor&, int64_t, int64_t, const at::Tensor&, int64_t, const at::Tensor&, int64_t,
+                    const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                    const at::Tensor&, double, double, int64_t, at::Tensor&, at::Tensor&, at::Tensor&, at::Tensor&,
+                    at::Tensor&, at::Tensor&);
+void kda_replay_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                     int64_t, at::Tensor&);
+void kda_replay_layers_cuda(const at::Tensor&, int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, int64_t, int64_t, int64_t, int64_t, int64_t, at::Tensor&);
+void kda_replay_slots_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, int64_t, int64_t, int64_t,
+                           int64_t);
+void kda_chain_slots_cuda(const at::Tensor&, const at::Tensor&, int64_t, const at::Tensor&, int64_t, int64_t,
+                          int64_t, int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          double, double);
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t, name, ": expected a CUDA tensor of the right dtype");
+}
+
+void chain(const at::Tensor& P, int64_t p_stride, int64_t b_off, const at::Tensor& A, int64_t a_stride,
+           const at::Tensor& G, int64_t g_stride, const at::Tensor& cs, const at::Tensor& cw,
+           const at::Tensor& state_in, const at::Tensor& a_log, const at::Tensor& dt_bias, const at::Tensor& norm_w,
+           double eps, double lower, int64_t rows, at::Tensor out, at::Tensor state_out, at::Tensor k_save,
+           at::Tensor v_save, at::Tensor g_save, at::Tensor b_save) {
+    check(P, at::kBFloat16, "P");
+    check(A, at::kBFloat16, "A");
+    check(G, at::kBFloat16, "G");
+    check(cs, at::kBFloat16, "conv state");
+    check(cw, at::kBFloat16, "conv weight");
+    check(state_in, at::kFloat, "state");
+    check(a_log, at::kFloat, "A_log");
+    check(dt_bias, at::kFloat, "dt_bias");
+    check(norm_w, at::kBFloat16, "norm");
+    check(out, at::kBFloat16, "out");
+    TORCH_CHECK(cs.is_contiguous() && cw.is_contiguous() && state_in.is_contiguous() && out.is_contiguous(),
+                "conv state, conv weight, state and out must be contiguous");
+    const int64_t H = a_log.numel();
+    TORCH_CHECK(dt_bias.numel() == H * 128 && norm_w.numel() == 128, "dt_bias [H*128], norm [128]");
+    TORCH_CHECK(cw.size(0) == 3 * H * 128 && cw.size(1) == 4, "conv weight [3*H*128, 4]");
+    TORCH_CHECK(state_in.numel() == H * 128 * 128, "state must be [H, 128, 128]");
+    TORCH_CHECK(rows >= 1 && P.size(0) >= rows && out.size(0) >= rows, "rows");
+    c10::cuda::CUDAGuard guard(P.device());
+    kda_chain_cuda(P, p_stride, b_off, A, a_stride, G, g_stride, cs, cw, state_in, a_log, dt_bias, norm_w, eps,
+                   lower, rows, out, state_out, k_save, v_save, g_save, b_save);
+}
+
+void replay(const at::Tensor& state_in, const at::Tensor& k_save, const at::Tensor& v_save, const at::Tensor& g_save,
+            const at::Tensor& b_save, int64_t rows, at::Tensor state_out) {
+    check(state_in, at::kFloat, "state");
+    check(state_out, at::kFloat, "state out");
+    TORCH_CHECK(state_in.is_contiguous() && state_out.is_contiguous(), "states must be contiguous");
+    c10::cuda::CUDAGuard guard(state_in.device());
+    kda_replay_cuda(state_in, k_save, v_save, g_save, b_save, rows, state_out);
+}
+
+void replay_layers(const at::Tensor& state_in, int64_t state_stride, const at::Tensor& k_save, const at::Tensor& v_save,
+                   const at::Tensor& g_save, const at::Tensor& b_save, int64_t kv_stride, int64_t b_stride,
+                   int64_t layers, int64_t heads, int64_t rows, at::Tensor state_out) {
+    check(state_in, at::kFloat, "state");
+    check(state_out, at::kFloat, "state out");
+    c10::cuda::CUDAGuard guard(state_in.device());
+    kda_replay_layers_cuda(state_in, state_stride, k_save, v_save, g_save, b_save, kv_stride, b_stride, layers, heads,
+                           rows, state_out);
+}
+
+// patches/0450: every slot's replay in one launch (keeps on the device); a KDA layer's chains of several slots in one
+// launch with the previous window's commit folded in (``kda.chain_slots``)
+void replay_slots(const at::Tensor& tab, const at::Tensor& keep, const at::Tensor& run, int64_t layers, int64_t heads,
+                  int64_t state_stride, int64_t skip_full) {
+    check(tab, at::kLong, "slot table");
+    check(keep, at::kInt, "keeps");
+    check(run, at::kInt, "rows run");
+    TORCH_CHECK(tab.is_contiguous() && tab.numel() == keep.numel() * 8 && run.numel() == keep.numel(),
+                "replay_slots: a table of 8 int64 a slot, a keep and a row count a slot");
+    c10::cuda::CUDAGuard guard(tab.device());
+    kda_replay_slots_cuda(tab, keep, run, layers, heads, state_stride, skip_full);
+}
+
+void chain_slots(const at::Tensor& tab, const at::Tensor& state, int64_t ni, const at::Tensor& slot_ids,
+                 int64_t col_pre, int64_t col_real, int64_t heads, int64_t b_off, const at::Tensor& cw,
+                 const at::Tensor& a_log, const at::Tensor& dt_bias, const at::Tensor& norm_w, double eps,
+                 double lower) {
+    check(tab, at::kLong, "slot table");
+    check(state, at::kInt, "slot counters");
+    check(slot_ids, at::kInt, "slot ids");
+    check(cw, at::kBFloat16, "conv weight");
+    check(a_log, at::kFloat, "A_log");
+    check(dt_bias, at::kFloat, "dt_bias");
+    check(norm_w, at::kBFloat16, "norm");
+    TORCH_CHECK(tab.is_contiguous() && tab.numel() == slot_ids.numel() * 24 && state.is_contiguous(),
+                "chain_slots: a table of 24 int64 a slot, contiguous counters");
+    TORCH_CHECK(a_log.numel() == heads && cw.is_contiguous(), "chain_slots: heads / conv weight");
+    c10::cuda::CUDAGuard guard(tab.device());
+    kda_chain_slots_cuda(tab, state, ni, slot_ids, col_pre, col_real, heads, b_off, cw, a_log, dt_bias, norm_w, eps,
+                         lower);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("chain", &chain);
+    m.def("replay", &replay);
+    m.def("replay_layers", &replay_layers);
+    m.def("replay_slots", &replay_slots);        // patches/0450
+    m.def("chain_slots", &chain_slots);          // patches/0450
+}
diff --git a/src/tensorfold/families/glm5_next/spark/kda.cu b/src/tensorfold/families/glm5_next/spark/kda.cu
new file mode 100644
index 0000000..a91d2a2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/kda.cu
@@ -0,0 +1,475 @@
+// GLM-5.3-Flash's KDA (Kimi delta attention) on CUDA: one block of 1024 threads per head, a chain of R rows.
+//
+// Per row, following the Hugging Face definition: the depthwise conv over [conv state; q|k|v rows] (4 taps,
+// fp32) with SiLU and one bf16 rounding; fp32 L2 norms of q and k (eps inside the sum, q times DK^-0.5); the
+// per-channel decay g_i = exp(lower * sigmoid(exp(A_log) * (a_i + dt_bias_i))) in fp32; beta = bf16(sigmoid(b));
+// the delta rule in fp32 (decay along the key channel, read with k, correct toward v, read out with q);
+// read-out rounded to bf16; then the gated RMSNorm bf16(w * (y * rsqrt(mean(y^2) + eps)) * sigmoid(gate)).
+// Warp w owns value rows 4w .. 4w + 3, lane l the key columns 4l .. 4l + 3. The state update is one routine
+// (``update``) shared with ``replay``, compiled without FMA contraction, so a replayed prefix of a window gives
+// the bits of the serial steps.
+
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+namespace {
+
+constexpr int DK = 128, DV = 128, TAPS = 4;
+
+__device__ __forceinline__ float bf(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+__device__ __forceinline__ float warp_sum(float x) {
+    for (int o = 16; o; o >>= 1) x += __shfl_xor_sync(0xffffffffu, x, o);
+    return x;
+}
+
+__device__ __forceinline__ float sigmoidf_(float x) { return 1.0f / (1.0f + expf(-x)); }
+
+// One delta-rule step on this thread's 4 x 4 block of the state: per-channel decay, read (k), correct toward v.
+__device__ __forceinline__ void update(float (&s)[4][4], const float (&kk)[4], const float (&gg)[4],
+                                       const float* vrow, int warp, float beta) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        float kv = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            s[j][i] = s[j][i] * gg[i];
+            kv = kv + s[j][i] * kk[i];
+        }
+        kv = warp_sum(kv);
+        const float delta = (vrow[warp * 4 + j] - kv) * beta;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = s[j][i] + kk[i] * delta;
+    }
+}
+
+__global__ void __launch_bounds__(1024) chain_kernel(
+        int H, const __nv_bfloat16* __restrict__ P, int p_stride, int b_off,
+        const __nv_bfloat16* __restrict__ A, int a_stride, const __nv_bfloat16* __restrict__ G, int g_stride,
+        const __nv_bfloat16* __restrict__ cs, const __nv_bfloat16* __restrict__ cw,
+        const float* __restrict__ state_in, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, float lower, int rows,
+        __nv_bfloat16* __restrict__ out, float* __restrict__ state_out,
+        float* __restrict__ k_save, __nv_bfloat16* __restrict__ v_save, float* __restrict__ g_save,
+        float* __restrict__ b_save) {
+    const int C = 3 * H * DK;                         // conv channels: q | k | v
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK], vs[DV], ys[DV], gs[DK];
+    __shared__ float beta_s, rinv;
+    int c = -1;
+    if (t < 3 * DK) c = (t / DK) * H * DK + h * DK + (t % DK);
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    const float decay_rate = expf(a_log[h]);
+    for (int r = 0; r < rows; ++r) {
+        if (c >= 0) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int tap = 0; tap < TAPS; ++tap) {
+                const int at = r + tap;
+                const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                              : __bfloat162float(P[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+                acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+            }
+            const float act = bf(acc / (1.0f + expf(-acc)));
+            if (t < DK) qs[t] = act;
+            else if (t < 2 * DK) ks[t - DK] = act;
+            else vs[t - 2 * DK] = act;
+        } else if (t >= 512 && t < 512 + DK) {
+            const int i = t - 512;
+            const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+            gs[i] = expf(lower * sigmoidf_(decay_rate * a));
+        } else if (t == 1023) {
+            beta_s = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+        }
+        __syncthreads();
+        if (warp < 2) {
+            float* x = warp == 0 ? qs : ks;
+            float v4[4], ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+            ss = warp_sum(ss);
+            float inv = 1.0f / sqrtf(ss + 1e-6f);
+            __syncwarp();
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                float y = v4[i] * inv;
+                if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+                x[lane * 4 + i] = y;
+            }
+        }
+        __syncthreads();
+        const float beta = beta_s;
+        float kk[4], qq[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[lane * 4 + i]; qq[i] = qs[lane * 4 + i]; gg[i] = gs[lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, beta);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+            o = warp_sum(o);
+            if (lane == 0) ys[warp * 4 + j] = bf(o);
+        }
+        if (k_save != nullptr) {
+            const size_t base = ((size_t)r * H + h) * DK;
+            if (t < DK) { k_save[base + t] = ks[t]; g_save[base + t] = gs[t]; }
+            if (t >= DK && t < DK + DV) v_save[base + t - DK] = __float2bfloat16_rn(vs[t - DK]);
+            if (t == 0) b_save[r * H + h] = beta;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { const float y = ys[lane * 4 + i]; ss = ss + y * y; }
+            ss = warp_sum(ss);
+            if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+        }
+        __syncthreads();
+        if (t < DV) {
+            const float yn = ys[t] * rinv;
+            const float yw = __bfloat162float(norm_w[t]) * yn;
+            const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+            out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+        }
+        __syncthreads();
+    }
+    if (state_out != nullptr) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+#pragma unroll
+            for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+    }
+}
+
+__global__ void __launch_bounds__(1024) replay_kernel(
+        int H, const float* __restrict__ state_in, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save,
+        const float* __restrict__ b_save, int rows, float* __restrict__ state_out) {
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(v_save[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = k_save[base + lane * 4 + i]; gg[i] = g_save[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, b_save[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// All layers at once: block (layer, head); per-layer strides of the state buffers and saved rows.
+__global__ void __launch_bounds__(1024) replay_layers_kernel(
+        int H, const float* __restrict__ state_in, size_t state_stride, const float* __restrict__ k_save,
+        const __nv_bfloat16* __restrict__ v_save, const float* __restrict__ g_save, const float* __restrict__ b_save,
+        size_t kv_stride, size_t b_stride, int rows, float* __restrict__ state_out) {
+    const int layer = blockIdx.x / H, h = blockIdx.x % H;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const float* sin = state_in + layer * state_stride;
+    float* sout = state_out + layer * state_stride;
+    const float* ks = k_save + layer * kv_stride;
+    const __nv_bfloat16* vsv = v_save + layer * kv_stride;
+    const float* gsv = g_save + layer * kv_stride;
+    const float* bsv = b_save + layer * b_stride;
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = sin[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(vsv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[base + lane * 4 + i]; gg[i] = gsv[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, bsv[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+
+// patches/0450 (GLM53_TF_GPU_ROUND): several slots in one launch, rows read on the device.
+//
+// replay_slots_kernel: block (layer * H + head, slot). A slot's row of ``tab`` (int64 x 8): state in, state out, k, v,
+// g, b saves (addresses), the saves' per-layer strides (k / v / g, b). keep[slot] rows are replayed; a slot whose keep
+// equals run[slot] is skipped when ``skip_full`` (the chain already wrote the state after its whole window). keep 0
+// copies the state (a finished slot's round that commits nothing). The update routine and row order are
+// ``replay_layers_kernel``'s, so the bits are.
+__global__ void __launch_bounds__(1024) replay_slots_kernel(
+        int H, const long long* __restrict__ tab, const int* __restrict__ keep, const int* __restrict__ run,
+        size_t state_stride, int skip_full) {
+    const int slot = blockIdx.y;
+    const int layer = blockIdx.x / H, h = blockIdx.x % H;
+    const int rows = keep[slot];
+    if (skip_full && rows == run[slot]) return;
+    const long long* e = tab + (size_t)slot * 8;
+    const size_t kv_stride = (size_t)e[6], b_stride = (size_t)e[7];
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float vs[DV];
+    float s[4][4];
+    const float* sin = reinterpret_cast<const float*>(e[0]) + layer * state_stride;
+    float* sout = reinterpret_cast<float*>(e[1]) + layer * state_stride;
+    const float* ks = reinterpret_cast<const float*>(e[2]) + layer * kv_stride;
+    const __nv_bfloat16* vsv = reinterpret_cast<const __nv_bfloat16*>(e[3]) + layer * kv_stride;
+    const float* gsv = reinterpret_cast<const float*>(e[4]) + layer * kv_stride;
+    const float* bsv = reinterpret_cast<const float*>(e[5]) + layer * b_stride;
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = sin[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    for (int r = 0; r < rows; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(vsv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[base + lane * 4 + i]; gg[i] = gsv[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, bsv[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) sout[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+}
+
+// chain_slots_kernel: ``chain_kernel`` for one KDA layer of several slots (block (head, slot)) with the previous
+// window's commit folded in. A slot's row of ``tab`` (int64 x 24):
+//   0 P rows, 1 p_stride, 2 A rows, 3 a_stride, 4 G rows, 5 g_stride, 6 conv state, 7 state in, 8 state out,
+//   9 out rows, 10 k save, 11 v save, 12 g save, 13 b save, 14 rows, 15 prev k save, 16 prev v save, 17 prev g save,
+//   18 prev b save, 19 proj rows (the window rows the conv shift reads), 20 proj row stride, 21-23 unused.
+// The slot's counters are read on the device (``state`` int32 [slots, ni], row ``slot_ids[slot]``): the first
+// state[col_pre] rows of the previous window are replayed from its saves (``replay_kernel``'s loop: the committed
+// state), which is written to ``state out``; then the window's first min(rows, 1 + state[col_real]) rows (its real
+// rows: padded rows are not run) as ``chain_kernel`` runs them (the same statements), saving what the next window's
+// prologue (or a replay) needs, and each row's conv channels are stored to the proj rows. The state after the window
+// is not written: the next window's prologue makes it.
+__global__ void __launch_bounds__(1024) chain_slots_kernel(
+        int H, int b_off, const long long* __restrict__ tab, const int* __restrict__ state, int ni,
+        const int* __restrict__ slot_ids, int col_pre, int col_real,
+        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log, const float* __restrict__ dt_bias,
+        const __nv_bfloat16* __restrict__ norm_w, float eps, float lower) {
+    const int slot = blockIdx.y;
+    const long long* e = tab + (size_t)slot * 24;
+    const int* __restrict__ sc = state + (size_t)slot_ids[slot] * ni;
+    const __nv_bfloat16* __restrict__ P = reinterpret_cast<const __nv_bfloat16*>(e[0]);
+    const int p_stride = (int)e[1];
+    const __nv_bfloat16* __restrict__ A = reinterpret_cast<const __nv_bfloat16*>(e[2]);
+    const int a_stride = (int)e[3];
+    const __nv_bfloat16* __restrict__ G = reinterpret_cast<const __nv_bfloat16*>(e[4]);
+    const int g_stride = (int)e[5];
+    const __nv_bfloat16* __restrict__ cs = reinterpret_cast<const __nv_bfloat16*>(e[6]);
+    const float* __restrict__ state_in = reinterpret_cast<const float*>(e[7]);
+    float* __restrict__ state_out = reinterpret_cast<float*>(e[8]);
+    __nv_bfloat16* __restrict__ out = reinterpret_cast<__nv_bfloat16*>(e[9]);
+    float* __restrict__ k_save = reinterpret_cast<float*>(e[10]);
+    __nv_bfloat16* __restrict__ v_save = reinterpret_cast<__nv_bfloat16*>(e[11]);
+    float* __restrict__ g_save = reinterpret_cast<float*>(e[12]);
+    float* __restrict__ b_save = reinterpret_cast<float*>(e[13]);
+    const int rows = min((int)e[14], 1 + sc[col_real]);
+    const float* __restrict__ pk = reinterpret_cast<const float*>(e[15]);
+    const __nv_bfloat16* __restrict__ pv = reinterpret_cast<const __nv_bfloat16*>(e[16]);
+    const float* __restrict__ pg = reinterpret_cast<const float*>(e[17]);
+    const float* __restrict__ pb = reinterpret_cast<const float*>(e[18]);
+    __nv_bfloat16* __restrict__ proj = reinterpret_cast<__nv_bfloat16*>(e[19]);
+    const size_t proj_stride = (size_t)e[20];
+    const int C = 3 * H * DK;                         // conv channels: q | k | v
+    const int h = blockIdx.x;
+    const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+    __shared__ float qs[DK], ks[DK], vs[DV], ys[DV], gs[DK];
+    __shared__ float beta_s, rinv;
+    int c = -1;
+    if (t < 3 * DK) c = (t / DK) * H * DK + h * DK + (t % DK);
+    float s[4][4];
+    const size_t sbase = (size_t)h * DV * DK;
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[j][i] = state_in[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i];
+    // the previous window's kept rows (``replay_kernel``)
+    const int npre = sc[col_pre];
+    for (int r = 0; r < npre; ++r) {
+        const size_t base = ((size_t)r * H + h) * DK;
+        if (t < DV) vs[t] = __bfloat162float(pv[base + t]);
+        __syncthreads();
+        float kk[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = pk[base + lane * 4 + i]; gg[i] = pg[base + lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, pb[r * H + h]);
+        __syncthreads();
+    }
+#pragma unroll
+    for (int j = 0; j < 4; ++j)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (size_t)(warp * 4 + j) * DK + lane * 4 + i] = s[j][i];
+    // the window (``chain_kernel``)
+    const float decay_rate = expf(a_log[h]);
+    for (int r = 0; r < rows; ++r) {
+        if (c >= 0) {
+            float acc = 0.0f;
+#pragma unroll
+            for (int tap = 0; tap < TAPS; ++tap) {
+                const int at = r + tap;
+                const float x = at < TAPS - 1 ? __bfloat162float(cs[(size_t)at * C + c])
+                                              : __bfloat162float(P[(size_t)(at - (TAPS - 1)) * p_stride + c]);
+                acc = acc + __bfloat162float(cw[(size_t)c * TAPS + tap]) * x;
+            }
+            const float act = bf(acc / (1.0f + expf(-acc)));
+            if (t < DK) qs[t] = act;
+            else if (t < 2 * DK) ks[t - DK] = act;
+            else vs[t - 2 * DK] = act;
+            proj[(size_t)r * proj_stride + c] = P[(size_t)r * p_stride + c];
+        } else if (t >= 512 && t < 512 + DK) {
+            const int i = t - 512;
+            const float a = __bfloat162float(A[(size_t)r * a_stride + h * DK + i]) + dt_bias[h * DK + i];
+            gs[i] = expf(lower * sigmoidf_(decay_rate * a));
+        } else if (t == 1023) {
+            beta_s = bf(sigmoidf_(__bfloat162float(P[(size_t)r * p_stride + b_off + h])));
+        }
+        __syncthreads();
+        if (warp < 2) {
+            float* x = warp == 0 ? qs : ks;
+            float v4[4], ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { v4[i] = x[lane * 4 + i]; ss = ss + v4[i] * v4[i]; }
+            ss = warp_sum(ss);
+            float inv = 1.0f / sqrtf(ss + 1e-6f);
+            __syncwarp();
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                float y = v4[i] * inv;
+                if (warp == 0) y = y * (1.0f / sqrtf((float)DK));
+                x[lane * 4 + i] = y;
+            }
+        }
+        __syncthreads();
+        const float beta = beta_s;
+        float kk[4], qq[4], gg[4];
+#pragma unroll
+        for (int i = 0; i < 4; ++i) { kk[i] = ks[lane * 4 + i]; qq[i] = qs[lane * 4 + i]; gg[i] = gs[lane * 4 + i]; }
+        update(s, kk, gg, vs, warp, beta);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) o = o + s[j][i] * qq[i];
+            o = warp_sum(o);
+            if (lane == 0) ys[warp * 4 + j] = bf(o);
+        }
+        {
+            const size_t base = ((size_t)r * H + h) * DK;
+            if (t < DK) { k_save[base + t] = ks[t]; g_save[base + t] = gs[t]; }
+            if (t >= DK && t < DK + DV) v_save[base + t - DK] = __float2bfloat16_rn(vs[t - DK]);
+            if (t == 0) b_save[r * H + h] = beta;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float ss = 0.0f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) { const float y = ys[lane * 4 + i]; ss = ss + y * y; }
+            ss = warp_sum(ss);
+            if (lane == 0) rinv = 1.0f / sqrtf(ss / (float)DV + eps);
+        }
+        __syncthreads();
+        if (t < DV) {
+            const float yn = ys[t] * rinv;
+            const float yw = __bfloat162float(norm_w[t]) * yn;
+            const float gate = __bfloat162float(G[(size_t)r * g_stride + h * DV + t]);
+            out[(size_t)r * H * DV + h * DV + t] = __float2bfloat16_rn(yw * sigmoidf_(gate));
+        }
+        __syncthreads();
+    }
+}
+
+}  // namespace
+
+template <typename T>
+static T* ptr(const at::Tensor& x) { return x.defined() && x.numel() ? (T*)x.data_ptr() : nullptr; }
+
+void kda_chain_cuda(const at::Tensor& P, int64_t p_stride, int64_t b_off, const at::Tensor& A, int64_t a_stride,
+                    const at::Tensor& G, int64_t g_stride, const at::Tensor& cs, const at::Tensor& cw,
+                    const at::Tensor& state_in, const at::Tensor& a_log, const at::Tensor& dt_bias,
+                    const at::Tensor& norm_w, double eps, double lower, int64_t rows, at::Tensor& out,
+                    at::Tensor& state_out, at::Tensor& k_save, at::Tensor& v_save, at::Tensor& g_save,
+                    at::Tensor& b_save) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int H = (int)a_log.numel();
+    chain_kernel<<<H, 1024, 0, stream>>>(
+        H, ptr<__nv_bfloat16>(P), (int)p_stride, (int)b_off, ptr<__nv_bfloat16>(A), (int)a_stride,
+        ptr<__nv_bfloat16>(G), (int)g_stride, ptr<__nv_bfloat16>(cs), ptr<__nv_bfloat16>(cw), ptr<float>(state_in),
+        ptr<float>(a_log), ptr<float>(dt_bias), ptr<__nv_bfloat16>(norm_w), (float)eps, (float)lower, (int)rows,
+        ptr<__nv_bfloat16>(out), ptr<float>(state_out), ptr<float>(k_save), ptr<__nv_bfloat16>(v_save),
+        ptr<float>(g_save), ptr<float>(b_save));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_replay_cuda(const at::Tensor& state_in, const at::Tensor& k_save, const at::Tensor& v_save,
+                     const at::Tensor& g_save, const at::Tensor& b_save, int64_t rows, at::Tensor& state_out) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int H = (int)b_save.size(1);
+    replay_kernel<<<H, 1024, 0, stream>>>(H, ptr<float>(state_in), ptr<float>(k_save), ptr<__nv_bfloat16>(v_save),
+                                          ptr<float>(g_save), ptr<float>(b_save), (int)rows, ptr<float>(state_out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_replay_layers_cuda(const at::Tensor& state_in, int64_t state_stride, const at::Tensor& k_save,
+                            const at::Tensor& v_save, const at::Tensor& g_save, const at::Tensor& b_save,
+                            int64_t kv_stride, int64_t b_stride, int64_t layers, int64_t heads, int64_t rows,
+                            at::Tensor& state_out) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    replay_layers_kernel<<<(int)(layers * heads), 1024, 0, stream>>>(
+        (int)heads, ptr<float>(state_in), (size_t)state_stride, ptr<float>(k_save), ptr<__nv_bfloat16>(v_save),
+        ptr<float>(g_save), ptr<float>(b_save), (size_t)kv_stride, (size_t)b_stride, (int)rows, ptr<float>(state_out));
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_replay_slots_cuda(const at::Tensor& tab, const at::Tensor& keep, const at::Tensor& run, int64_t layers,
+                           int64_t heads, int64_t state_stride, int64_t skip_full) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int slots = (int)keep.numel();
+    replay_slots_kernel<<<dim3((unsigned)(layers * heads), (unsigned)slots), 1024, 0, stream>>>(
+        (int)heads, ptr<long long>(tab), ptr<int>(keep), ptr<int>(run), (size_t)state_stride, (int)skip_full);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void kda_chain_slots_cuda(const at::Tensor& tab, const at::Tensor& state, int64_t ni, const at::Tensor& slot_ids,
+                          int64_t col_pre, int64_t col_real, int64_t heads, int64_t b_off, const at::Tensor& cw,
+                          const at::Tensor& a_log, const at::Tensor& dt_bias, const at::Tensor& norm_w, double eps,
+                          double lower) {
+    auto stream = at::cuda::getCurrentCUDAStream();
+    const int slots = (int)slot_ids.numel();
+    chain_slots_kernel<<<dim3((unsigned)heads, (unsigned)slots), 1024, 0, stream>>>(
+        (int)heads, (int)b_off, ptr<long long>(tab), ptr<int>(state), (int)ni, ptr<int>(slot_ids), (int)col_pre,
+        (int)col_real, ptr<__nv_bfloat16>(cw), ptr<float>(a_log), ptr<float>(dt_bias), ptr<__nv_bfloat16>(norm_w),
+        (float)eps, (float)lower);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/src/tensorfold/families/glm5_next/spark/kda.py b/src/tensorfold/families/glm5_next/spark/kda.py
new file mode 100644
index 0000000..b70fa69
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/kda.py
@@ -0,0 +1,112 @@
+"""GLM-5.3-Flash's KDA chain on CUDA (``kda.cu``): one fused kernel per layer and window.
+
+``chain`` runs R consecutive rows from the committed state: conv + SiLU, q/k L2 norms, per-channel decay,
+beta, the delta rule and the gated RMSNorm, writing the rows' outputs, the state after the last row, and
+what a replay needs (normalized k, v, the decay and beta per row). ``replay`` rebuilds the state after the
+first ``keep`` rows of a window with the same update routine, so keeping a prefix of a window gives the
+bits of serial steps.
+"""
+
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+DK = DV = 128
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_kda_v1", sources=[str(here / "kda.cpp"), str(here / "kda.cu")],
+                extra_cuda_cflags=["-O3", "--fmad=false"], verbose=False)
+
+
+class KDAScratch:
+    """Static per-window buffers (outputs and replay inputs) for up to ``rows`` rows of ``heads`` heads. With
+    ``parent``/``index``: views into one allocation for all layers (so a commit replays every layer at once)."""
+
+    def __init__(self, rows: int, heads: int, device, parent: "KDAScratchSet | None" = None, index: int = 0) -> None:
+        if parent is None:
+            self.out = torch.empty((rows, heads * DV), dtype=torch.bfloat16, device=device)
+            self.k = torch.empty((rows, heads, DK), dtype=torch.float32, device=device)
+            self.v = torch.empty((rows, heads, DV), dtype=torch.bfloat16, device=device)
+            self.g = torch.empty((rows, heads, DK), dtype=torch.float32, device=device)
+            self.b = torch.empty((rows, heads), dtype=torch.float32, device=device)
+        else:
+            self.out = parent.out[index]
+            self.k, self.v, self.g, self.b = parent.k[index], parent.v[index], parent.g[index], parent.b[index]
+
+
+class KDAScratchSet:
+    """KDAScratch for ``layers`` layers in one allocation each."""
+
+    def __init__(self, layers: int, rows: int, heads: int, device) -> None:
+        self.layers, self.rows, self.heads = layers, rows, heads
+        self.out = torch.empty((layers, rows, heads * DV), dtype=torch.bfloat16, device=device)
+        self.k = torch.empty((layers, rows, heads, DK), dtype=torch.float32, device=device)
+        self.v = torch.empty((layers, rows, heads, DV), dtype=torch.bfloat16, device=device)
+        self.g = torch.empty((layers, rows, heads, DK), dtype=torch.float32, device=device)
+        self.b = torch.empty((layers, rows, heads), dtype=torch.float32, device=device)
+        self.views = [KDAScratch(rows, heads, device, self, i) for i in range(layers)]
+
+
+def replay_layers(state_in: torch.Tensor, scratch: KDAScratchSet, rows: int, state_out: torch.Tensor) -> None:
+    """Every layer's state after the first ``rows`` rows: state_in/state_out [layers, H, 128, 128]."""
+
+    L, H = scratch.layers, scratch.heads
+    _ext().replay_layers(state_in, H * DV * DK, scratch.k, scratch.v, scratch.g, scratch.b, scratch.rows * H * DK,
+                         scratch.rows * H, L, H, int(rows), state_out)
+
+
+def chain(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_state: torch.Tensor,
+          conv_w: torch.Tensor, state_in: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor,
+          norm_w: torch.Tensor, eps: float, lower: float, rows: int, scratch: KDAScratch,
+          state_out: torch.Tensor) -> torch.Tensor:
+    """p: projection rows [q | k | v | ... | b at b_off ...] (row stride p.stride(0)); a, g: the forget-gate and
+    output-gate rows (bf16, row strides their own). Returns scratch.out[:rows]."""
+
+    _ext().chain(p, p.stride(0), int(b_off), a, a.stride(0), g, g.stride(0), conv_state, conv_w, state_in, a_log,
+                 dt_bias, norm_w, float(eps), float(lower), int(rows), scratch.out, state_out, scratch.k, scratch.v,
+                 scratch.g, scratch.b)
+    return scratch.out[:rows]
+
+
+def replay(state_in: torch.Tensor, scratch: KDAScratch, rows: int, state_out: torch.Tensor) -> None:
+    _ext().replay(state_in, scratch.k, scratch.v, scratch.g, scratch.b, int(rows), state_out)
+
+
+# -- patches/0450 (GLM53_TF_GPU_ROUND ``kda``): several slots a launch, commits folded into the next chain -------------
+class SlotTables:
+    """``chain_slots``' per-layer tables for one round key (slots, their rows in the round, their KDA parities): per
+    slot the window's projection / gate rows in the batch buffers, its conv window, state in (``rec[cur]``, the state
+    before the previous window's kept rows) / out (``rec[1 - cur]``: the committed state it writes), its output rows,
+    this parity's saves and the previous window's, and its proj rows (the conv shift reads them). Built once; a CUDA
+    graph of the round holds these addresses."""
+
+    def __init__(self, sts, saves, prev, b, offs, Rs, state, slot_ids, ni: int, col_pre: int, col_real: int = 5):
+        self.state, self.slot_ids, self.ni, self.col_pre, self.col_real = state, slot_ids, ni, col_pre, col_real
+        n_layers = len(sts[0].cur)
+        dev = sts[0].rec.device
+        rows = []
+        for li in range(n_layers):
+            layer_rows = []
+            for st, sv, pv, o, R in zip(sts, saves, prev, offs, Rs):
+                cur = st.cur[li]
+                a, pa = sv.views[li], pv.views[li]
+                layer_rows.append([b.bproj[o].data_ptr(), b.bproj.stride(0), b.ka[o].data_ptr(), b.ka.stride(0),
+                                   b.kg[o].data_ptr(), b.kg.stride(0), st.conv[li].data_ptr(),
+                                   st.rec[cur, li].data_ptr(), st.rec[1 - cur, li].data_ptr(),
+                                   b.bkout[o].data_ptr(), a.k.data_ptr(), a.v.data_ptr(), a.g.data_ptr(),
+                                   a.b.data_ptr(), int(R), pa.k.data_ptr(), pa.v.data_ptr(), pa.g.data_ptr(),
+                                   pa.b.data_ptr(), st.proj[li].data_ptr(), st.proj.stride(1), 0, 0, 0])
+            rows.append(layer_rows)
+        self.tab = torch.tensor(rows, dtype=torch.int64, device=dev)       # [layers, slots, 24]
+
+    def chain(self, li: int, k, heads: int, eps: float, lower: float) -> None:
+        _ext().chain_slots(self.tab[li], self.state, self.ni, self.slot_ids, self.col_pre, self.col_real, heads,
+                           int(k.b_off), k.conv, k.a_log, k.dt_bias, k.norm, float(eps), float(lower))
diff --git a/src/tensorfold/families/glm5_next/spark/kda_v2.py b/src/tensorfold/families/glm5_next/spark/kda_v2.py
new file mode 100644
index 0000000..3fbc49a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/kda_v2.py
@@ -0,0 +1,525 @@
+"""KDA prefill recurrence v2 (patches/0400, ``GLM53_TF_KDA_V2``): ``fast_kda``'s bits, fewer bytes, more CTAs.
+
+``kda_prefill_v2`` is a drop-in for ``fast_kda.kda_prefill_chunked`` (same contract, same arguments) that produces
+the SAME BITS: every output row, the state after the last row (so every snapshot), whatever the call sizes. It runs
+``fast_kda``'s three stages -- (1) prep, per (64-row chunk, head): everything that does not depend on the state; (2)
+the state scan, per (head, block of value rows): E = U - W S^T, O = Q~ S^T + P E, S <- S diag(e^{G_C}) + E^T K^;
+(3) the gated RMSNorm -- with each floating-point operation unchanged, and changes only where data lives and which
+program does which piece of work.
+
+Why it is the same arithmetic (checked op by op on the compiled kernels by ``tests/kda_v2_compile.py``):
+
+- The value columns of the state are independent. In the scan, row j of S (value j, all 128 keys) only meets
+  column j of U / E / O: E[:, j] = U[:, j] - W S[j, :]^T, O[:, j] = Q~ S[j, :]^T + P E[:, j] and
+  S[j, :] <- S[j, :] * e^{G_C} + E[:, j]^T K^. The only sums run over keys (W S^T, Q~ S^T: 128) or chunk rows (P E,
+  E^T K^: 64), never over values. So a program holding 32 value rows computes, per element, exactly what a program
+  holding 64 does: the same dots over the same K, in the same order.
+- A ``tl.dot`` on sm_12x is an mma.sync chain (m16n8k8 for tf32, one per 8 of K, the accumulator carried from one
+  k-step to the next in ascending K); what an element gets depends on its row of A, its column of B, the start
+  value of the accumulator and K's order -- not on the tile's M / N or the warps. Splitting K into two dots whose
+  second one starts from the first one's accumulator (``KSPLIT``) is the same chain.
+- Reductions (``tl.sum`` / ``tl.cumsum``) are the only ops whose order depends on the layout. They sit in the prep
+  (the q / k norms, the decay's cumsum, the 16 x 16 forward substitution), which runs with ``fast_kda``'s code and
+  num_warps (8); the compile test checks every reduce / scan has the reference kernel's operand encoding.
+- fp32 values stored and loaded back are the same values: moving an fp32 intermediate between registers, L2 and
+  DRAM changes no bit. No bf16 rounding is added or removed (O is rounded to bf16 where ``fast_kda`` rounds it).
+
+Modes (``GLM53_TF_KDA_V2``, load-time; default 0 = ``fast_kda`` unchanged):
+
+1 ``split``: ``fast_kda._kda_prep`` unchanged, then ``_state2``: value blocks of ``GLM53_TF_KDA_V2_BV`` (32: 128
+  programs instead of 64 on 48 SMs), the blocks of a head launched next to each other (grid (DV / BV, H)), so they
+  read their chunk's W / Q~ / K^ / P at the same time and DRAM serves each once (``fast_kda``'s grid (H, 2) puts
+  the two blocks of a head 32 programs apart: at 1 program an SM the second one runs a wave later and reads it all
+  again from DRAM: ~74 MB a 512-row call instead of ~37). ``KSPLIT`` halves the dot operands (less shared memory).
+2 ``fused``: ONE persistent kernel of ``GLM53_TF_KDA_V2_CTAS`` programs (default: one an SM) takes work items by
+  ticket: prep(c, h) and state steps (c, value block, h), in the order prep(0..LAG-1), then per chunk c: prep(c) and
+  the state steps of chunk c - LAG. A state step waits (spinning on a flag) for its chunk's prep and for the previous
+  step of its value block; a prep waits for the ring slot it overwrites to be read by every state step of chunk
+  c - RING. Every wait points to an EARLIER ticket, held by a program that is running, so there is no deadlock
+  whatever the number of resident programs. The per-(chunk, head) workspace is a ring of RING chunks (~14 MB at
+  RING 3 with 32 heads) that stays in L2, instead of ``fast_kda``'s 46 MB a 512-row call written to and read back
+  from DRAM; the prep's A / T scratch is per program. The state passes from step to step through ``state_out``
+  (fp32, exact). The last waves of both kernels overlap instead of idling.
+
+Both modes finish with ``fast_kda._kda_norm`` unchanged. ``save_replay``, |lower| > ``fast_kda.MAX_ABS_LOWER`` and
+the precision / bv arguments of ``fast_kda`` other than the defaults go to ``fast_kda`` (same result, old speed).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import fast_kda as fk
+from .fast_kda import (OFF_A, OFF_BETA, OFF_DEC, OFF_G, OFF_K, OFF_P, OFF_Q, OFF_T, OFF_V, WORK, WORK_C, _conv_act,
+                       _kda_norm)
+
+DK = DV = 128
+CHUNK = 64
+TMP = OFF_T.value - OFF_A.value + 64 * 64     # a fused program's A / T scratch (fp32 elements)
+TMP_C = tl.constexpr(TMP)
+
+
+def _env_int(name: str, default: int) -> int:
+    v = os.environ.get(name, "").strip()
+    return int(v) if v else default
+
+
+def mode() -> int:
+    """GLM53_TF_KDA_V2: 0 (off, ``fast_kda``), 1 (split) or 2 (fused); also ``split`` / ``fused``."""
+
+    v = os.environ.get("GLM53_TF_KDA_V2", "0").strip().lower()
+    v = {"": "0", "off": "0", "no": "0", "false": "0", "split": "1", "on": "1", "yes": "1", "true": "1",
+         "fused": "2"}.get(v, v)
+    if v not in ("0", "1", "2"):
+        raise ValueError(f"GLM53_TF_KDA_V2={v!r}: expected 0, 1 (split) or 2 (fused)")
+    return int(v)
+
+
+def config() -> dict:
+    """The speed settings (none of them changes a bit): split: value rows a scan program (16 / 32 / 64), its warps,
+    a register cap (``maxnreg``: ptxas' allocation only, the PTX is the same; 168 fits 3 programs of 4 warps an SM,
+    so the 128 programs of bv 32 are all resident at once); the K split of the scan's dots; fused: value rows a
+    step (32 / 64), programs (0 = one an SM, or two with a register cap of 128), lag, ring size, register cap.
+    (num_stages > 1 needs 120-160 KB of shared memory: not offered.)"""
+
+    cfg = dict(bv=_env_int("GLM53_TF_KDA_V2_BV", 32), warps=_env_int("GLM53_TF_KDA_V2_WARPS", 4),
+               maxnreg=_env_int("GLM53_TF_KDA_V2_MAXNREG", 168), ksplit=_env_int("GLM53_TF_KDA_V2_KSPLIT", 1),
+               ctas=_env_int("GLM53_TF_KDA_V2_CTAS", 0), lag=_env_int("GLM53_TF_KDA_V2_LAG", 1),
+               ring=_env_int("GLM53_TF_KDA_V2_RING", 3), fbv=_env_int("GLM53_TF_KDA_V2_FUSED_BV", 64),
+               fmaxnreg=_env_int("GLM53_TF_KDA_V2_FUSED_MAXNREG", 0))
+    if cfg["bv"] not in (16, 32, 64) or cfg["fbv"] not in (32, 64):
+        raise ValueError("GLM53_TF_KDA_V2_BV: 16, 32 or 64; GLM53_TF_KDA_V2_FUSED_BV: 32 or 64 (128 needs > 99 KB "
+                         "of shared memory or spills)")
+    if cfg["warps"] not in (2, 4, 8):
+        raise ValueError("GLM53_TF_KDA_V2_WARPS: 2, 4 or 8")
+    for k in ("maxnreg", "fmaxnreg"):
+        if cfg[k] and not 64 <= cfg[k] <= 255:
+            raise ValueError("GLM53_TF_KDA_V2_MAXNREG / _FUSED_MAXNREG: 0 (none) or 64..255")
+    if cfg["lag"] < 1 or cfg["ring"] < cfg["lag"] + 1:
+        raise ValueError("GLM53_TF_KDA_V2_LAG >= 1 and GLM53_TF_KDA_V2_RING >= LAG + 1")
+    return cfg
+
+
+# -- the scan: one chunk of one block of value rows -------------------------------------------------------------------
+@triton.jit
+def _scan_chunk(work, SW, SU, SQ, SK, OUT, s, s1, s2, c, h, jr, R, off, H: tl.constexpr, PREC: tl.constexpr,
+                KSPLIT: tl.constexpr, CG: tl.constexpr):
+    """``fast_kda._kda_state``'s loop body for chunk c (workspace ``work``) on the value rows jr. KSPLIT == 0: the
+    state is ``s`` [BV, 128]; else its key halves ``s1`` / ``s2`` [BV, 64] and every product over the keys is two
+    dots, the second starting from the first one's accumulator (the same k-step chain). Returns the new state."""
+
+    l = tl.arange(0, 64)
+    i = tl.arange(0, 128)
+    i1 = tl.arange(0, 64)
+    i2 = 64 + tl.arange(0, 64)
+    wp = (work + OFF_G).to(SW.dtype)
+    up = (work + OFF_V).to(SU.dtype)
+    qp = (work + OFF_Q).to(SQ.dtype)
+    kp = (work + OFF_K).to(SK.dtype)
+    if KSPLIT:                  # each operand loaded right before its dot: one 16 KB staging buffer live at a time
+        ws = tl.dot(tl.load(wp + l[:, None] * 128 + i1[None, :], cache_modifier=CG).to(tl.float32), tl.trans(s1),
+                    input_precision=PREC)
+        ws = tl.dot(tl.load(wp + l[:, None] * 128 + i2[None, :], cache_modifier=CG).to(tl.float32), tl.trans(s2), ws,
+                    input_precision=PREC)
+        eb = tl.load(up + l[:, None] * 128 + jr[None, :], cache_modifier=CG).to(tl.float32) - ws
+        ob = tl.dot(tl.load(qp + l[:, None] * 128 + i1[None, :], cache_modifier=CG).to(tl.float32), tl.trans(s1),
+                    input_precision=PREC)
+        ob = tl.dot(tl.load(qp + l[:, None] * 128 + i2[None, :], cache_modifier=CG).to(tl.float32), tl.trans(s2), ob,
+                    input_precision=PREC)
+        ob = tl.dot(tl.load(work + OFF_P + l[:, None] * 64 + l[None, :], cache_modifier=CG), eb, ob,
+                    input_precision=PREC)
+    else:
+        w = tl.load(wp + l[:, None] * 128 + i[None, :], cache_modifier=CG).to(tl.float32)
+        ub = tl.load(up + l[:, None] * 128 + jr[None, :], cache_modifier=CG).to(tl.float32)
+        eb = ub - tl.dot(w, tl.trans(s), input_precision=PREC)
+        qt = tl.load(qp + l[:, None] * 128 + i[None, :], cache_modifier=CG).to(tl.float32)
+        pm = tl.load(work + OFF_P + l[:, None] * 64 + l[None, :], cache_modifier=CG)
+        ob = tl.dot(qt, tl.trans(s), input_precision=PREC) + tl.dot(pm, eb, input_precision=PREC)
+    row = c * 64 - off + l
+    valid = (row >= 0) & (row < R)
+    tl.store(OUT + tl.where(valid, row, 0).to(tl.int64)[:, None] * (H * 128) + h * 128 + jr[None, :],
+             ob.to(tl.bfloat16), mask=valid[:, None])
+    if KSPLIT:
+        d1 = tl.load(work + OFF_DEC + i1, cache_modifier=CG)
+        s1 = tl.dot(tl.trans(eb), tl.load(kp + l[:, None] * 128 + i1[None, :], cache_modifier=CG).to(tl.float32),
+                    s1 * d1[None, :], input_precision=PREC)
+        d2 = tl.load(work + OFF_DEC + i2, cache_modifier=CG)
+        s2 = tl.dot(tl.trans(eb), tl.load(kp + l[:, None] * 128 + i2[None, :], cache_modifier=CG).to(tl.float32),
+                    s2 * d2[None, :], input_precision=PREC)
+    else:
+        kh = tl.load(kp + l[:, None] * 128 + i[None, :], cache_modifier=CG).to(tl.float32)
+        dec = tl.load(work + OFF_DEC + i, cache_modifier=CG)
+        s = s * dec[None, :] + tl.dot(tl.trans(eb), kh, input_precision=PREC)
+    return s, s1, s2
+
+
+@triton.jit
+def _state2(WORKBUF, SW, SU, SQ, SK, S_IN, S_OUT, OUT, R, off, NC, H: tl.constexpr, BV: tl.constexpr,
+            PREC: tl.constexpr, KSPLIT: tl.constexpr):
+    """Mode 1's scan, program (value block, head): ``fast_kda._kda_state`` with the blocks of a head adjacent."""
+
+    h = tl.program_id(1)
+    jr = tl.program_id(0) * BV + tl.arange(0, BV)
+    i = tl.arange(0, 128)
+    i1 = tl.arange(0, 64)
+    base = h.to(tl.int64) * (128 * 128) + jr[:, None] * 128
+    if KSPLIT:
+        s = tl.zeros((BV, 128), dtype=tl.float32)          # unused
+        s1 = tl.load(S_IN + base + i1[None, :])
+        s2 = tl.load(S_IN + base + 64 + i1[None, :])
+    else:
+        s = tl.load(S_IN + base + i[None, :])
+        s1 = tl.zeros((BV, 64), dtype=tl.float32)          # unused
+        s2 = s1
+    for c in range(NC):
+        work = WORKBUF + (c * H + h).to(tl.int64) * WORK_C
+        s, s1, s2 = _scan_chunk(work, SW, SU, SQ, SK, OUT, s, s1, s2, c, h, jr, R, off, H, PREC, KSPLIT, "")
+    if KSPLIT:
+        tl.store(S_OUT + base + i1[None, :], s1)
+        tl.store(S_OUT + base + 64 + i1[None, :], s2)
+    else:
+        tl.store(S_OUT + base + i[None, :], s)
+
+
+# -- the prep of one (chunk, head): fast_kda._kda_prep's body, with the A / T scratch where the caller says ------------
+@triton.jit
+def _prep_item(c, h, work, tmp, P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, SW, SU, SQ, SK, KSAVE, VSAVE,
+               GSAVE, BSAVE, lower, R, off, H: tl.constexpr, SAVE: tl.constexpr, BCC: tl.constexpr,
+               PREC: tl.constexpr, CG: tl.constexpr):
+    """``fast_kda._kda_prep`` for chunk c, head h: K^, Q~, U, W, P, e^{G_C} into ``work`` (the chunk's slot, the
+    same layout), A and T in ``tmp`` (offsets OFF_A / OFF_T). Every statement is ``_kda_prep``'s, in its order; CG
+    (".cg" in the fused kernel) only makes the loads bypass L1, which a ring slot rewritten by another SM needs."""
+
+    C: tl.constexpr = 3 * H * 128
+    NSUB: tl.constexpr = 64 // BCC
+    l = tl.arange(0, 64)
+    i = tl.arange(0, 128)
+    bl = tl.arange(0, BCC)
+    WK = work + OFF_K
+    WQ = work + OFF_Q
+    WV = work + OFF_V
+    WG = work + OFF_G
+    WB = work + OFF_BETA
+    WA = tmp + OFF_A
+    WP = work + OFF_P
+    WT = tmp + OFF_T
+    WD = work + OFF_DEC
+    decay_rate = tl.exp(tl.load(A_LOG + h))
+    dtb = tl.load(DT_BIAS + h * 128 + i)
+    row = c * 64 - off + l
+    valid = (row >= 0) & (row < R)
+    rowc = tl.where(valid, row, 0).to(tl.int64)
+    qa = _conv_act(P, p_stride, CS, CW, row, valid, h * 128 + i, C)
+    ka = _conv_act(P, p_stride, CS, CW, row, valid, H * 128 + h * 128 + i, C)
+    va = _conv_act(P, p_stride, CS, CW, row, valid, 2 * H * 128 + h * 128 + i, C)
+    qinv = 1.0 / tl.sqrt(tl.sum(qa * qa, axis=1) + 1e-6)
+    kinv = 1.0 / tl.sqrt(tl.sum(ka * ka, axis=1) + 1e-6)
+    q = tl.where(valid[:, None], (qa * qinv[:, None]) * (1.0 / tl.sqrt(128.0)), 0.0)
+    k = tl.where(valid[:, None], ka * kinv[:, None], 0.0)
+    v = tl.where(valid[:, None], va, 0.0)
+    araw = tl.load(A + rowc[:, None] * a_stride + h * 128 + i[None, :], mask=valid[:, None], other=0.0)
+    z = decay_rate * (araw.to(tl.float32) + dtb[None, :])
+    gl = tl.where(valid[:, None], lower * (1.0 / (1.0 + tl.exp(-z))), 0.0)
+    braw = tl.load(P + rowc * p_stride + b_off + h, mask=valid, other=0.0).to(tl.float32)
+    beta = tl.where(valid, (1.0 / (1.0 + tl.exp(-braw))).to(tl.bfloat16).to(tl.float32), 0.0)
+    gc = tl.cumsum(gl, axis=0)
+    tl.store(WK + l[:, None] * 128 + i[None, :], k)
+    tl.store(WQ + l[:, None] * 128 + i[None, :], q)
+    tl.store(WV + l[:, None] * 128 + i[None, :], v)
+    tl.store(WG + l[:, None] * 128 + i[None, :], gc)
+    tl.store(WB + l, beta)
+    if SAVE:
+        sv = (rowc * H + h) * 128
+        tl.store(KSAVE + sv[:, None] + i[None, :], k, mask=valid[:, None])
+        tl.store(GSAVE + sv[:, None] + i[None, :], tl.exp(gl), mask=valid[:, None])
+        tl.store(VSAVE + sv[:, None] + i[None, :], v.to(tl.bfloat16), mask=valid[:, None])
+        tl.store(BSAVE + rowc * H + h, beta, mask=valid)
+    tl.debug_barrier()
+    gs = tl.load(WG + l[:, None] * 128 + i[None, :], cache_modifier=CG)
+    ks = tl.load(WK + l[:, None] * 128 + i[None, :], cache_modifier=CG)
+    for a in tl.static_range(NSUB):
+        ra = a * BCC + bl
+        gref = tl.load(WG + a * BCC * 128 + i, cache_modifier=CG)
+        gt = tl.load(WG + ra[:, None] * 128 + i[None, :], cache_modifier=CG)
+        lk = tl.load(WK + ra[:, None] * 128 + i[None, :], cache_modifier=CG) * tl.exp(gt - gref[None, :])
+        lq = tl.load(WQ + ra[:, None] * 128 + i[None, :], cache_modifier=CG) * tl.exp(gt - gref[None, :])
+        s_ok = l < (a + 1) * BCC
+        rk = tl.where(s_ok[:, None], ks * tl.exp(tl.where(s_ok[:, None], gref[None, :] - gs, 0.0)), 0.0)
+        aa = tl.dot(lk, tl.trans(rk), input_precision=PREC)
+        pa = tl.dot(lq, tl.trans(rk), input_precision=PREC)
+        bt = tl.load(WB + ra, cache_modifier=CG)
+        aa = tl.where(l[None, :] < ra[:, None], aa * bt[:, None], 0.0)
+        pa = tl.where(l[None, :] <= ra[:, None], pa, 0.0)
+        tl.store(WA + ra[:, None] * 64 + l[None, :], aa)
+        tl.store(WP + ra[:, None] * 64 + l[None, :], pa)
+    tl.debug_barrier()
+    ab = tl.arange(0, NSUB)
+    r3 = ab[:, None, None] * BCC + bl[None, :, None]
+    c3 = ab[:, None, None] * BCC + bl[None, None, :]
+    nd = tl.load(WA + r3 * 64 + c3, cache_modifier=CG)
+    x = tl.where(r3 == c3, 1.0, 0.0)
+    for r in tl.static_range(1, BCC):
+        nrow = tl.sum(tl.where(bl[None, :, None] == r, nd, 0.0), axis=1)
+        new = tl.where(bl[None, :] == r, 1.0, 0.0) - tl.sum(nrow[:, :, None] * x, axis=1)
+        x = tl.where(bl[None, :, None] == r, new[:, None, :], x)
+    tl.store(WT + r3 * 64 + c3, x)
+    tl.debug_barrier()
+    for a in tl.static_range(1, NSUB, 2):
+        ra = a * BCC + bl
+        rb = (a - 1) * BCC + bl
+        taa = tl.load(WT + ra[:, None] * 64 + ra[None, :], cache_modifier=CG)
+        tbb = tl.load(WT + rb[:, None] * 64 + rb[None, :], cache_modifier=CG)
+        aab = tl.load(WA + ra[:, None] * 64 + rb[None, :], cache_modifier=CG)
+        tab = -tl.dot(taa, tl.dot(aab, tbb, input_precision="ieee"), input_precision="ieee")
+        tl.store(WT + ra[:, None] * 64 + rb[None, :], tab)
+    tl.debug_barrier()
+    hi = 32 + tl.arange(0, 32)
+    lo = tl.arange(0, 32)
+    blk_lo = (lo[None, :] // BCC) <= (lo[:, None] // BCC)
+    thi = tl.load(WT + hi[:, None] * 64 + hi[None, :], mask=blk_lo, other=0.0, cache_modifier=CG)
+    tlo = tl.load(WT + lo[:, None] * 64 + lo[None, :], mask=blk_lo, other=0.0, cache_modifier=CG)
+    ahl = tl.load(WA + hi[:, None] * 64 + lo[None, :], cache_modifier=CG)
+    thl = -tl.dot(thi, tl.dot(ahl, tlo, input_precision="ieee"), input_precision="ieee")
+    tl.debug_barrier()
+    tl.store(WT + hi[:, None] * 64 + lo[None, :], thl)
+    tl.debug_barrier()
+    gc = tl.load(WG + l[:, None] * 128 + i[None, :], cache_modifier=CG)
+    glast = tl.load(WG + 63 * 128 + i, cache_modifier=CG)
+    bt = tl.load(WB + l, cache_modifier=CG)
+    k = tl.load(WK + l[:, None] * 128 + i[None, :], cache_modifier=CG)
+    kt = (bt[:, None] * k) * tl.exp(gc)
+    khat = k * tl.exp(glast[None, :] - gc)
+    qt = tl.load(WQ + l[:, None] * 128 + i[None, :], cache_modifier=CG) * tl.exp(gc)
+    tl.debug_barrier()
+    tl.store(WK.to(SK.dtype) + l[:, None] * 128 + i[None, :], khat.to(SK.dtype.element_ty))
+    tl.store(WQ.to(SQ.dtype) + l[:, None] * 128 + i[None, :], qt.to(SQ.dtype.element_ty))
+    tl.store(WD + i, tl.exp(glast))
+    lower_blk = (l[None, :] // BCC) <= (l[:, None] // BCC)
+    t = tl.load(WT + l[:, None] * 64 + l[None, :], mask=lower_blk, other=0.0, cache_modifier=CG)
+    w = tl.dot(t, kt, input_precision=PREC)
+    v = tl.load(WV + l[:, None] * 128 + i[None, :], cache_modifier=CG)
+    u = tl.dot(t, bt[:, None] * v, input_precision=PREC)
+    tl.debug_barrier()
+    tl.store(WG.to(SW.dtype) + l[:, None] * 128 + i[None, :], w.to(SW.dtype.element_ty))
+    tl.store(WV.to(SU.dtype) + l[:, None] * 128 + i[None, :], u.to(SU.dtype.element_ty))
+
+
+@triton.jit
+def _prep_ref(P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, WORKBUF, SW, SU, SQ, SK, KSAVE, VSAVE, GSAVE,
+              BSAVE, lower, R, off, H: tl.constexpr, SAVE: tl.constexpr, BCC: tl.constexpr, PREC: tl.constexpr,
+              CG: tl.constexpr):
+    """``_prep_item`` as ``fast_kda._kda_prep``'s grid (chunk, head) on its workspace: the compile test's check that
+    the helper is ``_kda_prep`` op for op (and a fallback prep)."""
+
+    c = tl.program_id(0)
+    h = tl.program_id(1)
+    work = WORKBUF + (c * H + h).to(tl.int64) * WORK_C
+    _prep_item(c, h, work, work, P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, SW, SU, SQ, SK, KSAVE, VSAVE,
+               GSAVE, BSAVE, lower, R, off, H, SAVE, BCC, PREC, CG)
+
+
+# -- mode 2: one persistent kernel --------------------------------------------------------------------------------------
+@triton.jit
+def _spin_until(FLAG, target):
+    """Wait until the int32 at FLAG is >= target (one thread polls with acquire; the CTA barrier after the
+    broadcast orders every thread's later loads after it)."""
+
+    seen = tl.atomic_add(FLAG, 0, sem="acquire", scope="gpu")
+    while seen < target:
+        seen = tl.atomic_add(FLAG, 0, sem="acquire", scope="gpu")
+    tl.debug_barrier()
+
+
+@triton.jit
+def _fused(P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, RINGBUF, TMPBUF, SW, SU, SQ, SK, S_IN, S_OUT, OUT, CTL,
+           lower, R, off, NC, LAG, H: tl.constexpr, NVB: tl.constexpr, RING: tl.constexpr, BCC: tl.constexpr,
+           PREC: tl.constexpr, KSPLIT: tl.constexpr):
+    """Mode 2. CTL (int32, zeroed by the caller): [0] ticket counter, [1 + c*H + h] prep(c, h) done,
+    [1 + NC*H + c*H + h] state steps of chunk c, head h done (0..NVB), [1 + 2*NC*H + h*NVB + vb] steps of value
+    block (h, vb) done (0..NC). Tickets: prep(0..LAG-1, all h), then for g = LAG .. NC-1: prep(g, all h) and the NVB*H
+    state steps of chunk g - LAG, then the state steps of the last LAG chunks. Item k of a state group is value
+    block k % NVB of head k // NVB (the blocks of a head adjacent)."""
+
+    BV: tl.constexpr = 128 // NVB
+    NSTATE: tl.constexpr = NVB * H
+    GROUP: tl.constexpr = H + NVB * H
+    FLAG_S = CTL + 1 + NC * H
+    FLAG_V = CTL + 1 + 2 * NC * H
+    n_items = NC * H + NC * NSTATE
+    head_items = LAG * H
+    mid_items = (NC - LAG) * GROUP
+    tmp = TMPBUF + tl.program_id(0).to(tl.int64) * TMP_C - OFF_A          # this program's A / T (P's place unused)
+    t = tl.atomic_add(CTL, 1, sem="acq_rel", scope="gpu")
+    while t < n_items:
+        # -- decode the ticket -----------------------------------------------------------------------------------
+        is_prep = t < head_items
+        c = t // H
+        k = t % H
+        if t >= head_items:
+            u = t - head_items
+            if u < mid_items:
+                g = LAG + u // GROUP
+                r = u % GROUP
+                is_prep = r < H
+                c = tl.where(is_prep, g, g - LAG)
+                k = tl.where(is_prep, r, r - H)
+            else:
+                u2 = u - mid_items
+                c = NC - LAG + u2 // NSTATE
+                k = u2 % NSTATE
+        if is_prep:
+            h = k
+            slot = RINGBUF + ((c % RING) * H + h).to(tl.int64) * WORK_C
+            if c >= RING:                               # the slot's previous chunk read by all its state steps
+                _spin_until(FLAG_S + (c - RING) * H + h, NVB)
+            _prep_item(c, h, slot, tmp, P, p_stride, b_off, A, a_stride, CS, CW, A_LOG, DT_BIAS, SW, SU, SQ, SK,
+                       SW, SW, SW, SW, lower, R, off, H, False, BCC, PREC, ".cg")
+            tl.debug_barrier()                          # every thread's stores before the flag
+            tl.atomic_add(CTL + 1 + c * H + h, 1, sem="release", scope="gpu")
+        else:
+            h = k // NVB
+            vb = k % NVB
+            jr = vb * BV + tl.arange(0, BV)
+            _spin_until(CTL + 1 + c * H + h, 1)        # the chunk's prep
+            _spin_until(FLAG_V + h * NVB + vb, c)      # the previous step of this value block
+            slot = RINGBUF + ((c % RING) * H + h).to(tl.int64) * WORK_C
+            base = h.to(tl.int64) * (128 * 128) + jr[:, None] * 128
+            i = tl.arange(0, 128)
+            i1 = tl.arange(0, 64)
+            if KSPLIT:
+                s = tl.zeros((BV, 128), dtype=tl.float32)
+                if c == 0:
+                    s1 = tl.load(S_IN + base + i1[None, :], cache_modifier=".cg")
+                    s2 = tl.load(S_IN + base + 64 + i1[None, :], cache_modifier=".cg")
+                else:
+                    s1 = tl.load(S_OUT + base + i1[None, :], cache_modifier=".cg")
+                    s2 = tl.load(S_OUT + base + 64 + i1[None, :], cache_modifier=".cg")
+            else:
+                if c == 0:
+                    s = tl.load(S_IN + base + i[None, :], cache_modifier=".cg")
+                else:
+                    s = tl.load(S_OUT + base + i[None, :], cache_modifier=".cg")
+                s1 = tl.zeros((BV, 64), dtype=tl.float32)
+                s2 = s1
+            s, s1, s2 = _scan_chunk(slot, SW, SU, SQ, SK, OUT, s, s1, s2, c, h, jr, R, off, H, PREC, KSPLIT, ".cg")
+            if KSPLIT:
+                tl.store(S_OUT + base + i1[None, :], s1)
+                tl.store(S_OUT + base + 64 + i1[None, :], s2)
+            else:
+                tl.store(S_OUT + base + i[None, :], s)
+            tl.debug_barrier()
+            tl.atomic_add(FLAG_S + c * H + h, 1, sem="release", scope="gpu")
+            tl.atomic_add(FLAG_V + h * NVB + vb, 1, sem="release", scope="gpu")
+        t = tl.atomic_add(CTL, 1, sem="acq_rel", scope="gpu")
+
+
+# -- host side ------------------------------------------------------------------------------------------------------
+_BUF: dict[tuple, torch.Tensor] = {}
+
+
+def _buf(name: str, numel: int, dtype, device) -> torch.Tensor:
+    key = (name, str(device), dtype)
+    b = _BUF.get(key)
+    if b is None or b.numel() < numel:
+        b = torch.empty((numel,), dtype=dtype, device=device)
+        _BUF[key] = b
+    return b
+
+
+def _sms(device) -> int:
+    if torch.cuda.is_available() and torch.device(device).type == "cuda":
+        return torch.cuda.get_device_properties(device).multi_processor_count
+    return 4                                              # the interpreter: any count works
+
+
+def schedule(nc: int, heads: int, nvb: int, lag: int) -> list[tuple]:
+    """The fused kernel's ticket order in Python (tests): ('p', c, h) / ('s', c, h, vb)."""
+
+    lag = min(lag, nc)
+    out = [("p", c, h) for c in range(lag) for h in range(heads)]
+    for g in range(lag, nc):
+        out += [("p", g, h) for h in range(heads)]
+        out += [("s", g - lag, k // nvb, k % nvb) for k in range(nvb * heads)]
+    for c in range(nc - lag, nc):
+        out += [("s", c, k // nvb, k % nvb) for k in range(nvb * heads)]
+    return out
+
+
+def kda_prefill_v2(p: torch.Tensor, b_off: int, a: torch.Tensor, g: torch.Tensor, conv_state: torch.Tensor,
+                   conv_w: torch.Tensor, state_in: torch.Tensor, a_log: torch.Tensor, dt_bias: torch.Tensor,
+                   norm_w: torch.Tensor, eps: float, lower: float, rows: int, scratch=None,
+                   state_out: torch.Tensor | None = None, *, pos: int, save_replay: bool = False,
+                   out: torch.Tensor | None = None, work: torch.Tensor | None = None, precision: str | None = None,
+                   bv: int | None = None, num_warps: int = 8, v2: int | None = None, cfg: dict | None = None
+                   ) -> torch.Tensor:
+    """``fast_kda.kda_prefill_chunked``'s contract and bits. ``v2``: the mode (default: ``mode()``); ``cfg``: the
+    speed settings (default: ``config()``). Anything ``fast_kda`` would do differently (save_replay, another
+    precision, an explicit bv, the serial fallback) goes to ``fast_kda``."""
+
+    m = mode() if v2 is None else int(v2)
+    prec = precision or fk.DOT_PRECISION
+    if (m == 0 or save_replay or bv is not None or num_warps != 8 or not fk.supported(lower)
+            or prec != fk.DOT_PRECISION or fk.STORE_BF16):
+        return fk.kda_prefill_chunked(p, b_off, a, g, conv_state, conv_w, state_in, a_log, dt_bias, norm_w, eps, lower,
+                                      rows, scratch, state_out, pos=pos, save_replay=save_replay, out=out, work=work,
+                                      precision=precision, **({} if bv is None else {"bv": bv}), num_warps=num_warps)
+    cfg = config() if cfg is None else cfg
+    H = int(a_log.numel())
+    if state_out is None:
+        raise ValueError("kda_prefill_v2: state_out is required")
+    if rows < 1 or p.shape[0] < rows or a.shape[0] < rows or g.shape[0] < rows:
+        raise ValueError("kda_prefill_v2: rows")
+    if p.stride(1) != 1 or a.stride(1) != 1 or g.stride(1) != 1:
+        raise ValueError("kda_prefill_v2: unit column strides expected")
+    if p.dtype != torch.bfloat16 or a.dtype != torch.bfloat16 or g.dtype != torch.bfloat16:
+        raise ValueError("kda_prefill_v2: bf16 projection/gate rows expected")
+    if not (conv_state.is_contiguous() and conv_w.is_contiguous() and state_in.is_contiguous()
+            and state_out.is_contiguous()):
+        raise ValueError("kda_prefill_v2: conv state, conv weight and states must be contiguous")
+    if state_in.numel() != H * DK * DV or state_out.numel() != H * DK * DV or state_in.dtype != torch.float32:
+        raise ValueError("kda_prefill_v2: states must be fp32 [H, 128, 128]")
+    if conv_w.shape[0] != 3 * H * DK or conv_w.shape[1] != 4:
+        raise ValueError("kda_prefill_v2: conv weight [3*H*128, 4] expected")
+    if scratch is not None:
+        o = scratch.out[:rows]
+    elif out is not None:
+        o = out[:rows]
+    else:
+        o = torch.empty((rows, H * DV), dtype=torch.bfloat16, device=p.device)
+    if o.shape != (rows, H * DV) or not o.is_contiguous():
+        raise ValueError("kda_prefill_v2: out must be a contiguous [rows, H*128] bf16")
+    off = int(pos) % CHUNK
+    nc = -(-(off + rows) // CHUNK)
+    ksplit = bool(cfg["ksplit"])
+    if m == 1:
+        if work is None:
+            work = fk.workspace(H, nc, p.device)
+        if work.numel() < nc * H * WORK:
+            raise ValueError("kda_prefill_v2: work too small")
+        fk._kda_prep[(nc, H)](p, p.stride(0), int(b_off), a, a.stride(0), conv_state, conv_w, a_log, dt_bias, work,
+                              work, work, work, work, work, work, work, work, float(lower), int(rows), off, H=H,
+                              SAVE=False, BCC=fk.BC, PREC=prec, num_warps=8, num_stages=1)
+        bvv = int(cfg["bv"])
+        extra = {"maxnreg": int(cfg["maxnreg"])} if cfg["maxnreg"] else {}
+        _state2[(DV // bvv, H)](work, work, work, work, work, state_in, state_out, o, int(rows), off, nc, H=H, BV=bvv,
+                                PREC=prec, KSPLIT=ksplit, num_warps=int(cfg["warps"]), num_stages=1, **extra)
+    else:
+        nvb = DV // int(cfg["fbv"])
+        ring = int(cfg["ring"])
+        lag = min(int(cfg["lag"]), nc)
+        ctas = int(cfg["ctas"]) or _sms(p.device) * (2 if 0 < cfg["fmaxnreg"] <= 128 else 1)
+        extra = {"maxnreg": int(cfg["fmaxnreg"])} if cfg["fmaxnreg"] else {}
+        ringbuf = _buf("ring", ring * H * WORK, torch.float32, p.device)
+        tmp = _buf("tmp", ctas * TMP, torch.float32, p.device)
+        ctl = _buf("ctl", 1 + 2 * nc * H + H * nvb, torch.int32, p.device)
+        ctl[:1 + 2 * nc * H + H * nvb].zero_()
+        _fused[(ctas,)](p, p.stride(0), int(b_off), a, a.stride(0), conv_state, conv_w, a_log, dt_bias, ringbuf, tmp,
+                        ringbuf, ringbuf, ringbuf, ringbuf, state_in, state_out, o, ctl, float(lower), int(rows), off,
+                        nc, lag, H=H, NVB=nvb, RING=ring, BCC=fk.BC, PREC=prec, KSPLIT=ksplit, num_warps=8,
+                        num_stages=1, **extra)
+    _kda_norm[(triton.cdiv(rows, 32), H)](o, g, g.stride(0), norm_w, float(eps), int(rows), H=H, BR=32, num_warps=4)
+    return o
diff --git a/src/tensorfold/families/glm5_next/spark/knobs.py b/src/tensorfold/families/glm5_next/spark/knobs.py
new file mode 100644
index 0000000..5f6884d
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/knobs.py
@@ -0,0 +1,179 @@
+"""Per-request engine knobs for GLM-5.3-Flash (patches/0090): ``"tf_knobs": {...}`` in a request body.
+
+The GLM53_TF_* environment of the earlier patches sets each knob's DEFAULT at load; a request may override any
+subset of the knobs below for itself only, so one loaded server (a load takes minutes) can A/B many variants.
+After the request, the defaults apply again. Every knob here but ``fast_prefill`` only picks among speed paths
+already proven exact (drafted == serial, chunk-size independence, bit-identical kernels), so a request's tokens do not
+depend on them. ``fast_prefill`` (patches/0091) runs the prompt through patches/0080's fast kernels: the request's
+tokens then depend on it and on ``prefill_rows`` (its chunk grid, rounded down to a multiple of 64), while drafted
+== serial and resumed == fresh still hold within the same setting (fast snapshots resume fast requests of the same
+grid only). ``fp8_prefill`` (patches/0092) likewise changes a fast request's tokens (patches/0083's FP8 kernels);
+its snapshots are tagged C + 1 and resume FP8 fast requests of the same grid only.
+
+    key             values                   env default                    what it switches
+    lookup          0 | 1                    GLM53_TF_LOOKUP (1)            prompt-lookup drafts inside ``auto``
+    lookup_min      1 .. 64                  GLM53_TF_LOOKUP_MIN (4)        shortest match ``auto``'s lookup drafts
+    auto_fdrafts    1 .. 7                   GLM53_TF_AUTO_FDRAFTS (7)      most DFlash2 drafts a round of ``auto``
+    expert_loop     0 | 1                    GLM53_TF_EXPERT_LOOP (1)       EXL3 ``grouped_loop`` for windows > 16 rows
+    prefill_rows    1 .. max | "auto"        GLM53_TF_PREFILL_ROWS (64)     prefill chunk rows (max: the buffers',
+                                                                            GLM53_TF_PREFILL_ROWS_MAX; "auto",
+                                                                            patches/0085: chosen per prefill)
+    calib_online    0 | 1                    GLM53_TF_CALIB_ONLINE (0)      rank 0's online verify-cost table
+    longctx_graphs  0 | 1                    GLM53_TF_LONGCTX_GRAPHS (1)    long-context graphs / bounded indexer
+                                                                            (1 needs the load-time default 1)
+    profile         0 | 1                    GLM53_TF_PROFILE (0)           prefill timing probe (rank 0 prints)
+    depth           "cost" | "threshold"     GLM53_TF_DEPTH (threshold)     plain ``auto``'s draft depths
+    fast_prefill    0 | 1                    GLM53_TF_FAST_PREFILL (0)      patches/0080's fast prefill (needs a
+                                                                            PREFILL_ROWS_MAX of at least 64)
+    fp8_prefill     0 | 1                    GLM53_TF_FP8_PREFILL (0)       patches/0083's FP8 kernels in fast
+                                                                            chunks (no effect with fast_prefill 0;
+                                                                            needs FP8 tensor cores)
+    prefill_overlap 0 | 1                    GLM53_TF_PREFILL_OVERLAP (0)   patches/0084's pipelined lean chunks
+                                                                            (same bits; 1 = the env's variant, or
+                                                                            gather,slab)
+    fat_experts     0 | 1 | 2                GLM53_TF_FAST_EXPERTS=fat (1)  patches/0170's fat expert kernels in
+                                             / auto (2), else 0             fast chunks (same bits as fast2); 2
+                                                                            (patches/0270): fast2 or fat by the
+                                                                            chunk's rows (GLM53_TF_FAST2_ROWS)
+    moe_glue        0 .. 7                   GLM53_TF_MOE_GLUE (0)          patches/0190, bits: 1 grouping by a
+                                                                            parallel sort, 2 one-kernel router, 4
+                                                                            shared expert read in place by the
+                                                                            combine (64+-row windows; same bits)
+    mtp_window      0 .. 2^30 tokens         GLM53_TF_MTP_PREFILL_WINDOW    patches/0190: prefill runs the MTP
+                                             (0 = off)                      head on the prompt's last ~N positions
+                                                                            only (drafts may change, replies not)
+    hc_fused        0 .. 3                   GLM53_TF_HC_FUSED (0)          patches/0190: 1 hc_post + next hc_pre's
+                                                                            dots fused, 2 unrolled hc finish, 3 both
+                                                                            (fast pipelined chunks; same bits)
+    attn_bm32       0 | 1                    GLM53_TF_ATTN_BM32 (0)         patches/0190: 32-query latent attention
+                                                                            tiles in bf16 fast chunks (same bits)
+    b12x            0 .. 7                   GLM53_TF_B12X (0)              patches/0240, bits: 1 hc mixing dots
+                                                                            fused with hc_post, 2 KDA in 16-row
+                                                                            tiles, 4 one-pass sparse attention (fast
+                                                                            chunks; NEW arithmetic, own snapshot tag)
+
+Knobs fixed at load (``LOAD_ONLY``) are refused with the reason. Rank 0 validates a request's knobs
+(``parse``), resolves every knob to the value the request runs with, and sends the integers rank 1 needs in the
+request header (``encode`` / ``decode``); both ranks set them before the prefill and restore their own values
+after the request. Nothing here imports torch (host tests).
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from . import deep as _deep                 # patches/0380
+
+DEPTHS = ("threshold", "cost")
+
+# key -> (lowest, highest or None for "the engine's limit"), all integers (JSON true/false count as 1/0)
+RANGES: dict[str, tuple[int, int | None]] = {
+    "lookup": (0, 1),
+    "lookup_min": (1, 64),
+    "auto_fdrafts": (1, _deep.DRAFTS),   # patches/0380: up to GLM53_TF_MAX_DRAFT_ROWS - 1
+    "expert_loop": (0, 1),
+    "prefill_rows": (1, None),
+    "calib_online": (0, 1),
+    "longctx_graphs": (0, 1),
+    "profile": (0, 1),
+    "fast_prefill": (0, 1),              # patches/0091
+    "fp8_prefill": (0, 1),               # patches/0092
+    "prefill_overlap": (0, 1),           # patches/0093
+    "fat_experts": (0, 2),               # patches/0170 (2: patches/0270's auto)
+    "moe_glue": (0, 7),                  # patches/0190
+    "mtp_window": (0, 1 << 30),          # patches/0190
+    "hc_fused": (0, 3),                  # patches/0190
+    "attn_bm32": (0, 1),                 # patches/0190
+    "b12x": (0, 7),                      # patches/0240
+}
+PER_REQUEST = tuple(RANGES) + ("depth",)
+
+# the knobs rank 1 applies itself, in header order (lookup / lookup_min travel in the policy code, depth as
+# patches/0071's cost flag, calib_online as rank 0's cost table)
+HEADER = ("expert_loop", "prefill_rows", "longctx_graphs", "profile", "auto_fdrafts", "calib_online", "fast_prefill",
+          "fp8_prefill", "prefill_overlap", "fat_experts", "moe_glue", "mtp_window", "hc_fused", "attn_bm32",
+          "b12x")                                                        # patches/0240
+
+LOAD_ONLY: dict[str, str] = {
+    "nonexpert": "GLM53_TF_NONEXPERT is the stored weight format, quantized once at load",
+    "latent_kv": "GLM53_TF_LATENT_KV is the attention cache layout, allocated at load",
+    "kv_dtype": "GLM53_TF_KV_DTYPE (patches/0220) is the latent cache's row format (bf16 / fp8), allocated at load",
+    "comm": "GLM53_TF_COMM (prefetch / NCCL protocol) is captured into the CUDA graphs and set before NCCL starts",
+    "batch": "GLM53_TF_BATCH builds the batch scheduler at load",
+    "prefill_rows_max": "GLM53_TF_PREFILL_ROWS_MAX sizes the window buffers at load (a request picks any "
+                        "prefill_rows up to it)",
+    "calib": "GLM53_TF_CALIB is the load-time cost calibration (use calib_online per request)",
+    "kda_proj_bf16": "GLM53_TF_KDA_PROJ_BF16 keeps (or not) the KDA projections' bf16 copies, made at load, and "
+                     "changes a fast prefill's bits (snapshots are not tagged by it)",
+    "latent_tc": "GLM53_TF_LATENT_TC (patches/0190) changes a fast prefill's bits and its snapshot tag; the batch "
+                 "scheduler and the session store key snapshots by the load-time tag",
+}
+
+
+def parse(raw: Any, *, rows_max: int, longctx_ok: bool = True, batch: bool = False,
+          fp8_ok: bool = True) -> dict[str, Any]:
+    """A request's ``tf_knobs`` as {key: value} (only the keys it sets), or ValueError naming the problem.
+    ``rows_max``: the most prefill rows the buffers hold; ``longctx_ok``: long-context graphs can be turned on
+    (the engine was loaded with GLM53_TF_LONGCTX_GRAPHS=1); ``batch``: the engine batches requests (patches/0120:
+    every knob but ``calib_online``, whose table would time shared rounds); ``fp8_ok``: the FP8 prefill kernels can
+    run here (patches/0092)."""
+
+    if raw is None:
+        return {}
+    if not isinstance(raw, Mapping):
+        raise ValueError("tf_knobs must be an object, e.g. {\"prefill_rows\": 256, \"lookup\": 0}")
+    out: dict[str, Any] = {}
+    for key, value in raw.items():
+        if key in LOAD_ONLY:
+            raise ValueError(f"tf_knobs.{key} cannot change per request: {LOAD_ONLY[key]}; restart both ranks")
+        if key == "depth":
+            v = str(value).strip().lower() if isinstance(value, str) else None
+            if v not in DEPTHS:
+                raise ValueError(f"tf_knobs.depth={value!r}: expected \"cost\" or \"threshold\"")
+            out[key] = v
+            continue
+        if key == "prefill_rows" and isinstance(value, str) and value.strip().lower() == "auto":
+            out[key] = 0                 # patches/0085: ``pfgrid.AUTO``, each prefill picks its chunk rows
+            continue
+        if key not in RANGES:
+            raise ValueError(f"tf_knobs.{key}: unknown knob (per request: {', '.join(PER_REQUEST)}; "
+                             f"fixed at load: {', '.join(LOAD_ONLY)})")
+        if isinstance(value, bool):
+            value = int(value)
+        if not isinstance(value, int):
+            raise ValueError(f"tf_knobs.{key}={value!r}: expected an integer"
+                             + (" or \"auto\"" if key == "prefill_rows" else ""))
+        lo, hi = RANGES[key]
+        hi = rows_max if hi is None else hi
+        if not lo <= value <= hi:
+            extra = " (GLM53_TF_PREFILL_ROWS_MAX at load)" if key == "prefill_rows" else ""
+            raise ValueError(f"tf_knobs.{key}={value}: expected {lo} to {hi}{extra}")
+        if key == "fast_prefill" and value and rows_max < 64:          # patches/0091: the smallest chunk grid
+            raise ValueError(f"tf_knobs.fast_prefill=1: fast prefill chunks are multiples of 64 rows, the buffers hold "
+                             f"{rows_max} (GLM53_TF_PREFILL_ROWS_MAX at load)")
+        if key == "fp8_prefill" and value and not fp8_ok:              # patches/0092
+            raise ValueError("tf_knobs.fp8_prefill=1: this GPU / Triton has no FP8 (e4m3) tensor-core dots")
+        if key == "calib_online" and value and batch:                  # patches/0120
+            raise ValueError("tf_knobs.calib_online=1: the online cost table times one request's rounds; with "
+                             "GLM53_TF_BATCH > 1 requests share their rounds")
+        if key == "longctx_graphs" and value and not longctx_ok:
+            raise ValueError("tf_knobs.longctx_graphs=1: this engine was loaded with GLM53_TF_LONGCTX_GRAPHS=0 (no "
+                             "long-context graph buffers); load with the default 1 to switch it per request")
+        out[key] = value
+    return out
+
+
+def encode(values: Mapping[str, int]) -> list[int]:
+    """The header block: [count, values in ``HEADER`` order]."""
+
+    return [len(HEADER)] + [int(values[k]) for k in HEADER]
+
+
+def decode(block: list[int]) -> tuple[dict[str, int], list[int]]:
+    """(knobs, the rest of the list) from a list starting with an ``encode`` block."""
+
+    n = int(block[0])
+    if n != len(HEADER):
+        raise RuntimeError(f"the request header carries {n} knobs, this rank expects {len(HEADER)}: both ranks must "
+                           "run the same patched TensorFold")
+    return dict(zip(HEADER, (int(v) for v in block[1:1 + n]))), list(block[1 + n:])
diff --git a/src/tensorfold/families/glm5_next/spark/kvpool.py b/src/tensorfold/families/glm5_next/spark/kvpool.py
new file mode 100644
index 0000000..4108c6d
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/kvpool.py
@@ -0,0 +1,503 @@
+"""patches/0290: one paged pool of latent KV rows shared by every batch slot (GLM53_TF_KV_POOL_TOKENS, default off).
+
+Without it every ``forward.State`` reserves its whole capacity at load: the 11 DSA layers' latent rows, the MTP head's
+latent rows, the MTP head's index keys and gates and the 12 pool-key caches (7,616 B a token a rank with FP8 rows,
+docs/MEMORY-4x256k.md), so 4 slots of 262k cost 7.45 GiB a node whether they hold 1k or 262k tokens each. With the
+pool, those caches of every slot live in one set of tensors of ``tokens`` rows cut into pages of ``page`` tokens, and
+each slot maps its logical pages (position // page) to physical ones through a page table: any one slot can grow to
+the engine's capacity (CONTEXT, e.g. 1,048,576) as long as the pages of all slots fit in the pool.
+
+Bits: a kernel reads and writes the same row values at other addresses. Every reader and writer of these caches
+translates a logical row r to ``table[r >> shift] << shift | (r & (rows a page - 1))`` (``latent._prow``) before its
+load or store, under the same masks, so what it computes is what it computed on the contiguous cache: outputs are
+byte-identical to the unpaged path (tests: ``tests/test_kvpool_interpreter.py``,
+``tests/cuda/test_kv_pool_patches.py``).
+With the knob off nothing here is built and every kernel gets PT=None / PSH=0: the paged branch is pruned at compile
+time, the same loads and stores as before.
+
+What is paged (per slot, a logical view ``Paged`` of a shared physical tensor):
+- ``State.kc`` (11 latent caches, [capacity, 528] uint8 FP8 rows or [capacity, 512] bf16) and ``State.mtp_kc``;
+- ``State.index``'s capacity-sized tensors: the MTP head's index keys and gates (and the model layers' when
+  GLM53_TF_INDEX_RING=0) and all 12 pool-key caches ([capacity / 4 + 2, 128]; page / 4 rows a page).
+Per slot as before: patches/0065's index rings (window-sized), the KDA state, conv windows, DFlash2's ring.
+
+Pages: ``page`` tokens, a multiple of the session store's 256-token page (``sessions.PAGE``), so every stored page the
+store and the NVMe tier copy lies inside one physical page and stays a plain tensor view; runs of stored pages are
+copied a page at a time, and an entry's tail (the rows past its last full page; with a fast grid it may cover several
+pages) is gathered / written page by page (``Paged.gather`` / ``write``; the disk tier stages it and writes it after the
+read is checked). The pool has one more page than it hands out, the
+null page: unmapped table entries point at it (all zeros), so a stray read reads zeros and never another slot's rows;
+``KvPool.null_clean`` checks nothing ever wrote it (GLM53_TF_KV_POOL_CHECK=1 checks after every batched round).
+
+Allocation (both ranks do the same operations in the same order, so their pools stay identical; the lowest free page
+first): ``SlotPages.ensure(end)`` maps pages up to position ``end`` (called by ``forward.check_room`` before every
+forward / MTP / lean chunk, and before a session restore or disk read); ``truncate(keep)`` returns the pages past
+``keep``. The admission policy (``batch.Batcher``, docs/KV-POOL.md) reserves a request's pages up front as a quota, so
+an admitted request can always finish.
+"""
+
+from __future__ import annotations
+
+import heapq
+import os
+from typing import Any
+
+POOL_ENV = "GLM53_TF_KV_POOL_TOKENS"
+PAGE_ENV = "GLM53_TF_KV_POOL_PAGE"
+SLACK_ENV = "GLM53_TF_KV_POOL_SLACK"
+CHECK_ENV = "GLM53_TF_KV_POOL_CHECK"
+STORE_PAGE = 256             # ``sessions.PAGE`` (not imported: this module is imported by the kernels' modules)
+DEFAULT_PAGE = 256
+DEFAULT_SLACK = 64           # tokens past prompt + max_tokens a request may write (verify / pad windows, MTP drafts)
+
+
+class PoolExhausted(ValueError):
+    """No free page for a slot that needs one. Raised instead of writing anywhere else (never a silent overwrite)."""
+
+
+def _int_env(name: str, default: int) -> int:
+    v = os.environ.get(name, "").strip()
+    if not v:
+        return default
+    try:
+        return int(v)
+    except ValueError:
+        raise ValueError(f"{name} must be an integer, not {v!r}") from None
+
+
+def settings() -> tuple[int, int, int]:
+    """(pool tokens, page tokens, slack tokens) from the environment; pool tokens 0 = off (the default).
+    Load-time; both ranks must agree (``engine.GlmEngine`` checks)."""
+
+    tokens = _int_env(POOL_ENV, 0)
+    page = _int_env(PAGE_ENV, DEFAULT_PAGE)
+    slack = _int_env(SLACK_ENV, DEFAULT_SLACK)
+    if tokens < 0:
+        raise ValueError(f"{POOL_ENV}={tokens}: expected >= 0 (0 = off)")
+    if page < STORE_PAGE or page & (page - 1):
+        raise ValueError(f"{PAGE_ENV}={page}: expected a power of two >= {STORE_PAGE} (the session store's page, so a "
+                         "stored page is never split across pool pages)")
+    if slack < 0:
+        raise ValueError(f"{SLACK_ENV}={slack}: expected >= 0")
+    if tokens:
+        tokens = -(-tokens // page) * page
+    return tokens, page, slack
+
+
+def enabled() -> bool:
+    return settings()[0] > 0
+
+
+def check_on() -> bool:
+    return os.environ.get(CHECK_ENV, "0").strip() not in ("", "0")
+
+
+def pages_for(tokens: int, page: int) -> int:
+    return -(-max(int(tokens), 0) // page)
+
+
+def need_tokens(prompt: int, max_tokens: int, capacity: int, slack: int = DEFAULT_SLACK) -> int:
+    """Positions a request may write: its prompt, its reply, the windows past the committed end; at most the slot's
+    capacity (``check_room`` refuses more)."""
+
+    return min(int(prompt) + max(int(max_tokens), 0) + int(slack), int(capacity))
+
+
+# -- host bookkeeping (no torch) --------------------------------------------------------------------------------------
+class PageAlloc:
+    """Free physical pages 0 .. n - 1, handed out lowest first (deterministic: both ranks, same operations, same
+    pages)."""
+
+    def __init__(self, n: int) -> None:
+        self.n = int(n)
+        self.heap = list(range(self.n))
+        self.used = 0
+
+    @property
+    def n_free(self) -> int:
+        return len(self.heap)
+
+    def take(self, k: int) -> list[int]:
+        if k > len(self.heap):
+            raise PoolExhausted(f"KV pool: {k} pages asked, {len(self.heap)} free of {self.n}")
+        out = [heapq.heappop(self.heap) for _ in range(k)]
+        self.used += k
+        return out
+
+    def give(self, pages) -> None:
+        for p in pages:
+            heapq.heappush(self.heap, int(p))
+        self.used -= len(pages)
+
+
+class SlotPages:
+    """One slot's page table: logical page i -> physical page ``pages[i]`` (host list) and the device table the
+    kernels read (int32 [max_pages], unmapped entries = the null page). ``quota``: pages the batcher reserved for the
+    slot's request (None: no admission control, the lone engine)."""
+
+    def __init__(self, pool: "PoolBook", capacity: int, table: Any = None) -> None:
+        self.pool = pool
+        self.page = pool.page
+        self.capacity = int(capacity)
+        self.max_pages = pages_for(capacity, pool.page)
+        self.pages: list[int] = []
+        self.quota: int | None = None
+        self.table = table                       # torch int32 [max_pages] (None: host-only tests)
+        self.over = 0                            # pages taken past the quota (from pages nobody had reserved)
+
+    @property
+    def held(self) -> int:
+        return len(self.pages)
+
+    @property
+    def outstanding(self) -> int:
+        """Reserved pages not mapped yet (the admission promise still to keep)."""
+
+        return max(0, (self.quota or 0) - len(self.pages))
+
+    def tokens(self) -> int:
+        return len(self.pages) * self.page
+
+    def _write(self, i0: int, values: list[int]) -> None:
+        if self.table is None or not values:
+            return
+        import torch
+
+        self.table[i0:i0 + len(values)].copy_(torch.tensor(values, dtype=torch.int32))
+
+    def ensure(self, end: int) -> None:
+        """Map every page holding positions < ``end`` (a no-op when mapped already: the common case)."""
+
+        need = pages_for(end, self.page)
+        have = len(self.pages)
+        if need <= have:
+            return
+        if need > self.max_pages:
+            raise ValueError("context past the cache capacity")
+        k = need - have
+        if self.quota is not None and need > self.quota:
+            # past the admission's reservation: only pages nobody else reserved (never another request's promise)
+            spare = self.pool.alloc.n_free - self.pool.outstanding(exclude=self)
+            extra = need - max(self.quota, have)
+            if extra > spare:
+                raise PoolExhausted(f"KV pool: slot needs {need} pages, reserved {self.quota}, {spare} unreserved free "
+                                    "(GLM53_TF_KV_POOL_TOKENS)")
+            self.over += extra
+        new = self.pool.alloc.take(k)
+        self.pages.extend(new)
+        self._write(have, new)
+
+    def truncate(self, keep: int) -> int:
+        """Return the pages past position ``keep`` (their rows are dead: nothing reads a slot past its kept length);
+        -> pages returned."""
+
+        k = pages_for(keep, self.page)
+        if k >= len(self.pages):
+            return 0
+        drop = self.pages[k:]
+        del self.pages[k:]
+        self.pool.alloc.give(drop)
+        self._write(k, [self.pool.null] * len(drop))
+        return len(drop)
+
+    def reserve(self, pages: int | None) -> None:
+        self.quota = None if pages is None else int(pages)
+
+
+class PoolBook:
+    """The pool's host side: the free list, the page size and every slot's table (for the reservations)."""
+
+    def __init__(self, npages: int, page: int) -> None:
+        self.npages = int(npages)
+        self.page = int(page)
+        self.shift = page.bit_length() - 1
+        self.null = self.npages                  # the extra all-zero page unmapped entries point at
+        self.alloc = PageAlloc(npages)
+        self.slots: list[SlotPages] = []
+
+    def outstanding(self, exclude: SlotPages | None = None) -> int:
+        return sum(s.outstanding for s in self.slots if s is not exclude)
+
+    def available(self) -> int:
+        """Free pages no admitted request has reserved: what a new admission may count on."""
+
+        return self.alloc.n_free - self.outstanding()
+
+    def describe(self) -> str:
+        return (f"{self.alloc.n_free} of {self.npages} pages free, {self.outstanding()} reserved, "
+                f"{self.npages - self.alloc.n_free} mapped")
+
+
+# -- the logical view of a pool tensor ------------------------------------------------------------------------------
+class Paged:
+    """A slot's cache as the rest of the engine sees it: ``shape[0]`` is the slot's logical rows (its capacity, or
+    capacity / 4 + 2 pool keys), rows live on the slot's pages of ``phys`` ([(npages + 1) x per, ...]).
+
+    Kernels take ``phys``, the slot's device ``pt`` and ``shift`` (log2 of ``per``, rows a page). Host code (the session
+    store, the NVMe tier, snapshots' tails) slices it: a slice inside one page (``[a:b]`` with a // per == (b - 1) //
+    per) is a view of those physical rows, as a slice of the contiguous cache is; a slice across pages raises (use
+    ``segments``); an int index reads a row (the null page's row where unmapped: shape / size queries only)."""
+
+    is_paged = True
+
+    def __init__(self, phys, slot: SlotPages, per: int, rows: int) -> None:
+        self.phys = phys
+        self.slot = slot
+        self.per = int(per)
+        self.shift = self.per.bit_length() - 1
+        if 1 << self.shift != self.per:
+            raise ValueError(f"paged cache: {per} rows a page is not a power of two")
+        self.rows = int(rows)
+
+    # tensor-like attributes the engine reads
+    @property
+    def shape(self):
+        return (self.rows, *self.phys.shape[1:])
+
+    @property
+    def dtype(self):
+        return self.phys.dtype
+
+    @property
+    def device(self):
+        return self.phys.device
+
+    @property
+    def is_cuda(self) -> bool:
+        return self.phys.is_cuda
+
+    @property
+    def pt(self):
+        return self.slot.table
+
+    def is_contiguous(self) -> bool:
+        return True              # rows within a page are; every slice handed out lies within one page
+
+    def data_ptr(self) -> int:
+        return self.phys.data_ptr()
+
+    def element_size(self) -> int:
+        return self.phys.element_size()
+
+    def dim(self) -> int:
+        return self.phys.dim()
+
+    def row_bytes(self) -> int:
+        return int(self.phys[0].numel() * self.phys.element_size())
+
+    def view_rows(self, dtype):
+        raise TypeError("a paged cache has no flat view: copy it page by page (segments)")
+
+    def clone(self):
+        raise TypeError("a paged State cannot be cloned (its rows live in the shared KV pool, patches/0290)")
+
+    # rows
+    def _loc(self, r: int, *, write: bool = False) -> int:
+        if not 0 <= r < self.rows:
+            raise IndexError(f"row {r} outside the paged cache's {self.rows}")
+        p, o = divmod(r, self.per)
+        if p >= len(self.slot.pages):
+            if write:
+                raise IndexError(f"row {r} is on page {p}, which this slot has not mapped (KV pool)")
+            return self.slot.pool.null * self.per + o
+        return self.slot.pages[p] * self.per + o
+
+    def _range(self, key: slice) -> tuple[int, int]:
+        a, b, step = key.indices(self.rows)
+        if step != 1:
+            raise IndexError("paged cache: slices must be contiguous")
+        return a, max(a, b)
+
+    def __getitem__(self, key):
+        if isinstance(key, int):
+            return self.phys[self._loc(key)]
+        if isinstance(key, slice):
+            a, b = self._range(key)
+            if b == a:
+                return self.phys[0:0]
+            if a // self.per != (b - 1) // self.per:
+                raise IndexError(f"paged cache: rows {a}..{b} span pages; copy them page by page (segments)")
+            base = self._loc(a, write=True)
+            return self.phys[base:base + (b - a)]
+        raise TypeError(f"paged cache: index {key!r} (an int or a slice of rows)")
+
+    def __setitem__(self, key, value) -> None:
+        if isinstance(key, int):
+            self.phys[self._loc(key, write=True)] = value
+            return
+        view = self[key]
+        if hasattr(value, "shape"):
+            view.copy_(value)
+        else:
+            view.fill_(value)
+
+    def segments(self, a: int, b: int) -> list[tuple[int, int, Any]]:
+        """Logical rows [a, b) as (first row, end row, physical view) pieces, one a page."""
+
+        out = []
+        r = a
+        while r < b:
+            end = min(b, (r // self.per + 1) * self.per)
+            base = self._loc(r, write=True)
+            out.append((r, end, self.phys[base:base + (end - r)]))
+            r = end
+        return out
+
+    def gather(self, a: int, b: int):
+        """Logical rows [a, b) as a new contiguous tensor (host checks, tests)."""
+
+        import torch
+
+        segs = self.segments(a, b)
+        if not segs:
+            return self.phys[0:0].clone()
+        return torch.cat([v for _, _, v in segs]).clone()
+
+    def write(self, a: int, src) -> None:
+        """``src`` into logical rows a .. a + len(src) (mapped already)."""
+
+        for lo, hi, view in self.segments(a, a + src.shape[0]):
+            view.copy_(src[lo - a:hi - a])
+
+    def zero_rows(self, a: int, b: int) -> None:
+        for _, _, view in self.segments(a, b):
+            view.zero_()
+
+
+def is_paged(t) -> bool:
+    return bool(getattr(t, "is_paged", False))
+
+
+def kernel_args(t):
+    """(tensor, page table, shift) a kernel takes for cache ``t``: (t, None, 0) for a plain tensor."""
+
+    if is_paged(t):
+        return t.phys, t.pt, t.shift
+    return t, None, 0
+
+
+def slot_of(st) -> SlotPages | None:
+    return getattr(st, "pages", None)
+
+
+def ensure(st, end: int) -> None:
+    """Map a State's pages up to position ``end`` (nothing without the pool)."""
+
+    sp = getattr(st, "pages", None)
+    if sp is not None:
+        sp.ensure(end)
+
+
+def ensure_comps(comps, end: int) -> None:
+    """The session store's view: map the pages of whichever slot ``comps`` (``sessions.Comp`` list) belong to."""
+
+    for c in comps:
+        if is_paged(c.live):
+            c.live.slot.ensure(end)
+            return
+
+
+# -- the device side ------------------------------------------------------------------------------------------------
+class KvPool(PoolBook):
+    """The physical tensors (built lazily per cache family: every slot uses the same families) and the tables."""
+
+    def __init__(self, w, tokens: int, page: int, slack: int = DEFAULT_SLACK) -> None:
+        import torch
+
+        super().__init__(tokens // page, page)
+        self.w = w
+        self.slack = int(slack)
+        self.device = w.device
+        self.rows = (self.npages + 1) * page         # + the null page
+        self.t: dict[tuple, Any] = {}
+        self._torch = torch
+
+    def _family(self, key: tuple, make):
+        t = self.t.get(key)
+        if t is None:
+            t = make()
+            self.t[key] = t
+        return t
+
+    def new_slot(self, capacity: int) -> SlotPages:
+        torch = self._torch
+        mp = pages_for(capacity, self.page)
+        table = torch.full((mp,), self.null, dtype=torch.int32, device=self.device)
+        sp = SlotPages(self, capacity, table)
+        self.slots.append(sp)
+        return sp
+
+    def latent(self, sp: SlotPages, n: int) -> list[Paged]:
+        """The DSA layers' latent caches of a slot (``latent.caches`` rows: FP8 528 B or bf16)."""
+
+        from . import latent
+
+        phys = self._family(("latent", n), lambda: latent.caches(self.w, self.rows, n))
+        return [Paged(t, sp, self.page, sp.capacity) for t in phys]
+
+    def mtp_latent(self, sp: SlotPages) -> Paged:
+        from . import latent
+
+        phys = self._family(("mtp",), lambda: latent.caches(self.w, self.rows, 1)[0])
+        return Paged(phys, sp, self.page, sp.capacity)
+
+    def index_rows(self, sp: SlotPages, i: int, which: str) -> Paged:
+        """Index layer i's keys (``which`` "k") or gates ("g"), [capacity, index_dim] bf16, one row a token."""
+
+        torch = self._torch
+        d = self.w.cfg.index_dim
+        phys = self._family(("index", which, i),
+                            lambda: torch.zeros((self.rows, d), dtype=torch.bfloat16, device=self.device))
+        return Paged(phys, sp, self.page, sp.capacity)
+
+    def pool_keys(self, sp: SlotPages, i: int) -> Paged:
+        """Index layer i's pool keys, [capacity / 4 + 2, index_dim] bf16 logically (one row a complete pool of 4)."""
+
+        torch = self._torch
+        d = self.w.cfg.index_dim
+        per = self.page // 4
+        phys = self._family(("pk", i), lambda: torch.zeros(((self.npages + 1) * per, d), dtype=torch.bfloat16,
+                                                           device=self.device))
+        return Paged(phys, sp, per, sp.capacity // 4 + 2)
+
+    def nbytes(self) -> int:
+        return sum(int(t.numel() * t.element_size()) for v in self.t.values()
+                   for t in (v if isinstance(v, list) else [v]))
+
+    def token_bytes(self) -> int:
+        return self.nbytes() // max(self.rows, 1)
+
+    def null_clean(self) -> bool:
+        """The null page is still all zeros in every tensor (nothing wrote an unmapped row)."""
+
+        for key, v in self.t.items():
+            per = self.page // 4 if key[0] == "pk" else self.page
+            for t in (v if isinstance(v, list) else [v]):
+                if bool(t[self.null * per:(self.null + 1) * per].ne(0).any()):
+                    return False
+        return True
+
+
+def pool_tokens(tokens: int, page: int, capacity: int, limit: int | None = None) -> int:
+    """patches/0490: the pool's size in tokens. A pool set to hold a whole request (``tokens`` >= the context limit)
+    grows to the slot capacity rounded up to a page (limit + the verify window's rows: the most ``need_tokens`` asks
+    for), so every request the context check lets through is admissible on an otherwise free pool; before, one within
+    64 tokens of CONTEXT was refused as "more than the whole pool". One page more at most; which page holds a row never
+    changes a bit. A smaller pool (``tokens`` < limit) stays as set."""
+
+    if tokens and limit is not None and tokens >= limit:
+        return max(int(tokens), pages_for(capacity, page) * page)
+    return int(tokens)
+
+
+def build(w, capacity: int, limit: int | None = None) -> KvPool | None:
+    """The engine's pool (``decode.Engine``, before any State), or None when GLM53_TF_KV_POOL_TOKENS is unset / 0.
+    ``limit``: the engine's context limit (patches/0490, ``pool_tokens``)."""
+
+    tokens, page, slack = settings()
+    if not tokens:
+        return None
+    tokens = pool_tokens(tokens, page, capacity, limit)          # patches/0490
+    if not w.meta.get("latent_kv"):
+        raise ValueError(f"{POOL_ENV} pages the latent KV cache: it needs GLM53_TF_LATENT_KV=1")
+    return KvPool(w, tokens, page, slack)
diff --git a/src/tensorfold/families/glm5_next/spark/l2pf.cpp b/src/tensorfold/families/glm5_next/spark/l2pf.cpp
new file mode 100644
index 0000000..4f7d832
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/l2pf.cpp
@@ -0,0 +1,66 @@
+// Bindings of the L2 prefetch kernels (patches/0460, GLM53_TF_L2PF; l2pf.cu). Launches go on the CURRENT stream
+// (l2pf.py switches to its side stream first), so they are captured in CUDA graphs like any kernel.
+
+#include <stdint.h>
+
+#include <stdexcept>
+#include <string>
+
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <torch/extension.h>
+
+namespace tfl2pf {
+
+cudaError_t launch_segments(const int64_t *table, int n, int grid, int threads, uint32_t chunk, bool bulk,
+                            cudaStream_t stream);
+cudaError_t launch_experts(const int32_t *ids, const int32_t *count, int maxu, const int64_t *bases, int nmat,
+                           int64_t stride_bytes, int64_t bytes, int64_t experts, int grid, int threads, uint32_t chunk,
+                           bool bulk, cudaStream_t stream);
+
+static void check(cudaError_t e, const char *what) {
+    if (e != cudaSuccess) {
+        throw std::runtime_error(std::string("l2pf: ") + what + ": " + cudaGetErrorString(e));
+    }
+}
+
+static void chunk_ok(int64_t chunk) {
+    if (chunk < 16 || chunk % 16 != 0 || chunk > (int64_t(1) << 24)) {
+        throw std::invalid_argument("l2pf: chunk must be a multiple of 16 bytes in [16, 16 MiB]");
+    }
+}
+
+// table: int64 [n, 2] on the device, (address, bytes) rows; addresses 16-byte aligned, bytes multiples of 16
+void segments(torch::Tensor table, int64_t grid, int64_t threads, int64_t chunk, bool bulk) {
+    TORCH_CHECK(table.is_cuda() && table.scalar_type() == torch::kInt64 && table.dim() == 2 && table.size(1) == 2 &&
+                    table.is_contiguous(),
+                "l2pf.segments: an int64 [n, 2] contiguous CUDA table");
+    chunk_ok(chunk);
+    if (table.size(0) == 0) {
+        return;
+    }
+    check(launch_segments(table.data_ptr<int64_t>(), int(table.size(0)), int(grid), int(threads), uint32_t(chunk), bulk,
+                          c10::cuda::getCurrentCUDAStream().stream()),
+          "segments launch");
+}
+
+// ids int32 [MAXU], count int32 [1]: qmm.Group; bases int64 [nmat] (device addresses of expert 0 of each matrix)
+void experts(torch::Tensor ids, torch::Tensor count, torch::Tensor bases, int64_t stride_bytes, int64_t bytes,
+             int64_t n_experts, int64_t grid, int64_t threads, int64_t chunk, bool bulk) {
+    TORCH_CHECK(ids.is_cuda() && ids.scalar_type() == torch::kInt32 && ids.is_contiguous(), "l2pf.experts: ids");
+    TORCH_CHECK(count.is_cuda() && count.scalar_type() == torch::kInt32 && count.numel() >= 1, "l2pf.experts: count");
+    TORCH_CHECK(bases.is_cuda() && bases.scalar_type() == torch::kInt64 && bases.is_contiguous(), "l2pf.experts: bases");
+    TORCH_CHECK(bytes > 0 && bytes % 16 == 0 && bytes <= stride_bytes, "l2pf.experts: bytes a multiple of 16, <= stride");
+    chunk_ok(chunk);
+    check(launch_experts(ids.data_ptr<int32_t>(), count.data_ptr<int32_t>(), int(ids.numel()),
+                         bases.data_ptr<int64_t>(), int(bases.numel()), stride_bytes, bytes, n_experts, int(grid),
+                         int(threads), uint32_t(chunk), bulk, c10::cuda::getCurrentCUDAStream().stream()),
+          "experts launch");
+}
+
+}  // namespace tfl2pf
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("segments", &tfl2pf::segments);
+    m.def("experts", &tfl2pf::experts);
+}
diff --git a/src/tensorfold/families/glm5_next/spark/l2pf.cu b/src/tensorfold/families/glm5_next/spark/l2pf.cu
new file mode 100644
index 0000000..ace57d9
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/l2pf.cu
@@ -0,0 +1,114 @@
+// L2 prefetch kernels for the decode rounds' idle windows (patches/0460, GLM53_TF_L2PF).
+//
+// Every kernel here only READS weight memory into the GPU's L2 and writes nothing the model reads, so it cannot change
+// a bit of any result; it only changes where the next kernels find their weights (L2 instead of DRAM).
+//
+//   bulk   one cp.async.bulk.prefetch.L2.global per CHUNK bytes (sm_90+ PTX; GB10 is sm_121): the SM's bulk-copy
+//          unit streams the range into L2 with no registers, no shared memory and no data returned to the SM, so
+//          the kernel is a handful of instructions per thread and the side stream holds no SM for the transfer
+//   lines  one prefetch.global.L2 per 128-byte line (any sm_70+ GPU): the fallback if the bulk form is slower here
+//
+// Two entry points:
+//   prefetch_segments  a static per-site table of (address, bytes) (the plans of l2pf.py: the next kernels' weights)
+//   prefetch_experts   device-indexed: the first ``bytes`` of every distinct routed expert the router picked this
+//                      window (qmm.Group ids[0 .. count)), in each listed matrix (EXL3 trellis [E, ...] per expert),
+//                      without a host round trip, so it is captured in the round's CUDA graph like the rest
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace tfl2pf {
+
+constexpr uint32_t LINE = 128;
+
+__device__ __forceinline__ void bulk_prefetch(const void *p, uint32_t bytes) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" ::"l"(p), "r"(bytes) : "memory");
+#else   // the pre-sm_90 targets of TORCH_CUDA_ARCH_LIST (never run on GB10): a line prefetch per 128 bytes
+    for (uint32_t o = 0; o < bytes; o += LINE) asm volatile("prefetch.global.L2 [%0];" ::"l"((const char *)p + o));
+#endif
+}
+
+__device__ __forceinline__ void line_prefetch(const void *p) {
+    asm volatile("prefetch.global.L2 [%0];" ::"l"(p));
+}
+
+// ``bytes`` of [p, p + bytes) in pieces of ``chunk`` bytes (a multiple of 16), piece i by thread i of ``stride``.
+// Bulk prefetches need a 16-byte aligned address and a size that is a multiple of 16: the host rounds every segment
+// to that (l2pf.py), and the last piece is the remainder (also a multiple of 16).
+template <bool Bulk>
+__device__ __forceinline__ void range(const uint8_t *p, uint64_t bytes, uint32_t chunk, uint64_t index,
+                                      uint64_t stride) {
+    if (Bulk) {
+        const uint64_t pieces = (bytes + chunk - 1) / chunk;
+        for (uint64_t i = index; i < pieces; i += stride) {
+            const uint64_t off = i * chunk;
+            const uint64_t left = bytes - off;
+            bulk_prefetch(p + off, static_cast<uint32_t>(left < chunk ? left : chunk));
+        }
+    } else {
+        const uint64_t lines = (bytes + LINE - 1) / LINE;
+        for (uint64_t i = index; i < lines; i += stride) {
+            line_prefetch(p + i * LINE);
+        }
+    }
+}
+
+// table: n pairs of int64 (device address, bytes)
+template <bool Bulk>
+__global__ void __launch_bounds__(256) segments_kernel(const int64_t *table, int n, uint32_t chunk) {
+    const uint64_t index = static_cast<uint64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const uint64_t stride = static_cast<uint64_t>(gridDim.x) * blockDim.x;
+    for (int s = 0; s < n; s++) {
+        const uint8_t *p = reinterpret_cast<const uint8_t *>(static_cast<uintptr_t>(table[2 * s]));
+        const uint64_t bytes = static_cast<uint64_t>(table[2 * s + 1]);
+        // segment s's first piece goes to thread s (mod the grid): a table of many one-piece heads (the chunk heads of
+        // a 4-bit matrix) is spread over the threads instead of all landing on thread 0
+        const uint64_t first = (index + stride - static_cast<uint64_t>(s) % stride) % stride;
+        range<Bulk>(p, bytes, chunk, first, stride);
+    }
+}
+
+// Block u (grid-stride over maxu) prefetches the first ``bytes`` of expert ids[u] in each of the ``nmat`` matrices
+// (bases[m] + ids[u] * stride_bytes) when u < count[0]. ids / count are the router's device output (qmm.Group).
+template <bool Bulk>
+__global__ void __launch_bounds__(256) experts_kernel(const int32_t *ids, const int32_t *count, int maxu,
+                                                      const int64_t *bases, int nmat, int64_t stride_bytes,
+                                                      int64_t bytes, int64_t experts, uint32_t chunk) {
+    const int n = min(static_cast<int>(*count), maxu);
+    for (int u = blockIdx.x; u < n; u += gridDim.x) {
+        const int64_t e = static_cast<int64_t>(ids[u]);
+        if (e < 0 || e >= experts) {
+            continue;                    // never read outside the expert tensors
+        }
+        for (int m = 0; m < nmat; m++) {
+            const uint8_t *p = reinterpret_cast<const uint8_t *>(static_cast<uintptr_t>(bases[m])) + e * stride_bytes;
+            range<Bulk>(p, static_cast<uint64_t>(bytes), chunk, threadIdx.x, blockDim.x);
+        }
+    }
+}
+
+cudaError_t launch_segments(const int64_t *table, int n, int grid, int threads, uint32_t chunk, bool bulk,
+                            cudaStream_t stream) {
+    if (bulk) {
+        segments_kernel<true><<<grid, threads, 0, stream>>>(table, n, chunk);
+    } else {
+        segments_kernel<false><<<grid, threads, 0, stream>>>(table, n, chunk);
+    }
+    return cudaGetLastError();
+}
+
+cudaError_t launch_experts(const int32_t *ids, const int32_t *count, int maxu, const int64_t *bases, int nmat,
+                           int64_t stride_bytes, int64_t bytes, int64_t experts, int grid, int threads, uint32_t chunk,
+                           bool bulk, cudaStream_t stream) {
+    if (bulk) {
+        experts_kernel<true><<<grid, threads, 0, stream>>>(ids, count, maxu, bases, nmat, stride_bytes, bytes, experts,
+                                                           chunk);
+    } else {
+        experts_kernel<false><<<grid, threads, 0, stream>>>(ids, count, maxu, bases, nmat, stride_bytes, bytes, experts,
+                                                            chunk);
+    }
+    return cudaGetLastError();
+}
+
+}  // namespace tfl2pf
