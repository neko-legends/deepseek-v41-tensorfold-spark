+++ b/tests/test_dsv41_four_sparks.py
@@ -0,0 +1,431 @@
+# SPDX-License-Identifier: MIT
+"""Four ranks with uneven slices: the bugs jayleaton's review of the TP=4 port found (PR #6), each pinned here.
+
+- candidates over the vocabulary at any count (verify windows, nucleus rows' full vocabulary, DSpark): every rank
+  sends the same k (``pick.rank_top``: the widest slice's, narrower ones padded), so the all-gather agrees and the
+  merged rows equal one rank's (before: ``k = min(count, own width)``, a mismatched gather at count > 32,256);
+- the trimmed draft head's per-rank lists follow the 128-block vocabulary split (before: ``r * n``, rank 2 refused
+  to boot) and four ranks draft alike, greedy, sampled and nucleus (full-vocabulary candidates) requests;
+- the TCP plan link: followers say who they are; rank 0 refuses strays, duplicates and another world size, and
+  orders the connections by rank;
+- ``--tp 4`` only for a family that declares it (``CUDA_TP``);
+- ``TF_DSV41_PREFILL_ATTN_BMQ=32`` on a rank with 16 heads runs the fused kernel with 16 heads a program;
+- the NVMe session tier's directory differs between world sizes;
+- a DSpark delta's shards follow the weights' 128-block split.
+
+The thread communicator now refuses unequal all-gather sizes (NCCL's contract), so a mismatch fails here instead of
+hanging a Spark.
+"""
+
+from __future__ import annotations
+
+import queue
+import socket
+import threading
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pick as P  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import planlink as PL  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import vsample as VS  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.weights import block_bounds  # noqa: E402
+
+V4 = {"vocab_size": 640, "o_groups": 4, "moe_intermediate_size": 640}      # slices 256 / 128 / 128 / 128
+PROMPTS = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 600, size=30 + 11 * i)] for i in range(3)]
+GREEDY, TOPK = None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95)
+NUCLEUS = Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)    # full-vocabulary rows
+
+
+# -- candidates over uneven slices -----------------------------------------------------------------------------------
+def slices(V: int, W: int):
+    return [block_bounds(V, W, r) for r in range(W)]
+
+
+@pytest.mark.parametrize("count", [1, 5, 128, 129, 200, 256, 640])
+def test_rank_top_merges_to_the_whole_vocabulary(count):
+    V, W = 640, 4
+    g = torch.Generator().manual_seed(3)
+    lg = torch.randn((6, V), generator=g).to(torch.bfloat16).float()
+    lg[:, ::7] = lg[:, :1]                                  # ties across slices: the lower id first
+    lg[2, 100:300] = float("-inf")                          # masked tokens stay real candidates
+    wide = P.widest(V, W)
+    assert wide == 256
+    parts = [P.rank_top(lg[:, lo:hi], count, lo, wide) for lo, hi in slices(V, W)]
+    assert len({k for _, _, k in parts}) == 1               # one k: the gather's sizes agree
+    k = parts[0][2]
+    packed = [torch.cat([v, i.view(torch.float32)], 1) for v, i, _ in parts]
+    vals, ids = VS.merge(torch.stack(packed), k, count)
+    want_v, want_i = P.top(lg, count)
+    assert torch.equal(ids, want_i.to(torch.int64))
+    assert torch.equal(vals, want_v)
+    assert int(ids.max()) < V                               # never a pad
+
+
+def test_engine_choose_drops_the_padding():
+    """``engine.choose``'s host merge (greedy and sampled) sees real ids only."""
+
+    V, W = 640, 4
+    lg = torch.randn((3, V), generator=torch.Generator().manual_seed(9)).to(torch.bfloat16).float()
+    parts = [P.rank_top(lg[:, lo:hi], 300, lo, P.widest(V, W)) for lo, hi in slices(V, W)]
+    tokens = torch.cat([i for _, i, _ in parts], 1).numpy().astype(np.int64)
+    assert (tokens == P.PAD).any()
+    real = tokens[0] != P.PAD
+    assert all(((t == P.PAD) == ~real).all() for t in tokens)      # the same columns in every row
+    assert real.sum() == V
+
+
+@pytest.fixture(scope="module")
+def ck4(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41tp4ds"), **V4)
+
+
+@pytest.fixture(scope="module")
+def ranking(tmp_path_factory):
+    f = tmp_path_factory.mktemp("dsv41rk") / "rank.txt"
+    f.write_text("# test ranking\n" + " ".join(map(str, list(range(1, 640, 2)) + list(range(0, 640, 2)))) + "\n")
+    return str(f)
+
+
+def test_candidates_full_vocabulary_on_four_ranks(ck4):
+    """A verify window's candidates at counts past the narrow slices (nucleus rows ask for the whole vocabulary)."""
+
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+
+    ids = PROMPTS[0][:20]
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+
+    def go(r):
+        f = DF.forward(ck4, rank=r, world=4, comm=comms[r], dspark=False)
+        lg = f.run([Seg(0, 0, tuple(ids))])
+        return [f.candidates(lg, [len(ids)], c) for c in (3, 200, 640)]
+
+    with N.exact():
+        got = pair.run([lambda r=r: go(r) for r in range(4)])
+        one = DF.forward(ck4, dspark=False)
+        lg1 = one.run([Seg(0, 0, tuple(ids))])
+        want = [one.candidates(lg1, [len(ids)], c) for c in (3, 200, 640)]
+    for rank in got:
+        for c, w in zip(rank, want):
+            assert np.array_equal(np.asarray(c.ids), np.asarray(w.ids))
+            assert np.allclose(np.asarray(c.values, dtype=np.float64), np.asarray(w.values, dtype=np.float64),
+                               rtol=0, atol=1e-9)
+    assert np.asarray(got[0][2].ids).shape[1] == 640
+
+
+class Fanout:
+    """Rank 0's plan to every follower (the batcher's ``Link``)."""
+
+    def __init__(self, world: int) -> None:
+        self.q = [queue.Queue() for _ in range(world)]
+
+    def sender(self):
+        outer = self
+
+        class S:
+            def send(self, plan):
+                for q in outer.q[1:]:
+                    q.put(list(plan))
+
+        return S()
+
+    def receiver(self, r: int):
+        q = self.q[r]
+
+        class R:
+            def recv(self):
+                return q.get(timeout=300)
+
+        return R()
+
+
+def test_four_ranks_trimmed_head_draft_alike(ck4, ranking, monkeypatch):
+    for k, v in {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "off",
+                 "TF_DSV41_DRAFT_VOCAB": ranking}.items():
+        monkeypatch.setenv(k, v)
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck4, slots=3, rank=r, world=4, comm=comms[r]) for r in range(4)])
+    heads = [f.drafter.head for f in fws]
+    assert [len(h.ids) for h in heads] == [64] * 4
+    for (lo, hi), h in zip(slices(640, 4), heads):
+        assert lo <= int(h.ids.min()) and int(h.ids.max()) < hi      # each rank lists its own slice
+    link = Fanout(4)
+    bs = [DF.batcher(ck4, fws[0], n=3, link=link.sender(), rank=0)]
+    bs += [DF.batcher(ck4, fws[r], n=3, link=link.receiver(r), rank=r) for r in range(1, 4)]
+    ts = [threading.Thread(target=b.follow, daemon=True) for b in bs[1:]]
+    for t in ts:
+        t.start()
+    got = DF.run(bs[0], [Job(list(PROMPTS[0]), 10, GREEDY), Job(list(PROMPTS[1]), 10, TOPK),
+                         Job(list(PROMPTS[2]), 10, NUCLEUS)])
+    bs[0].send_stop()
+    for t in ts:
+        t.join(timeout=300)
+        assert not t.is_alive()
+    assert all(len(g) == 10 for g in got)
+    assert all(0 <= t < 640 for g in got for t in g)
+
+
+def test_four_ranks_full_head_equal_one_rank(ck4, monkeypatch):
+    """Greedy, top-k and nucleus decoding on four ranks == one rank, token for token (exact numerics)."""
+
+    monkeypatch.delenv("TF_DSV41_DRAFT_HEAD", raising=False)
+    jobs = [(PROMPTS[0], 8, GREEDY), (PROMPTS[1], 8, TOPK), (PROMPTS[2], 8, NUCLEUS)]
+    with N.exact():
+        one = DF.run(DF.batcher(ck4, DF.forward(ck4, slots=3), n=3), [Job(list(p), n, s) for p, n, s in jobs])
+        pair = FK.ThreadPair(4)
+        comms = pair.comms()
+        fws = pair.run([lambda r=r: DF.forward(ck4, slots=3, rank=r, world=4, comm=comms[r]) for r in range(4)])
+        link = Fanout(4)
+        bs = [DF.batcher(ck4, fws[0], n=3, link=link.sender(), rank=0)]
+        bs += [DF.batcher(ck4, fws[r], n=3, link=link.receiver(r), rank=r) for r in range(1, 4)]
+        ts = [threading.Thread(target=b.follow, daemon=True) for b in bs[1:]]
+        for t in ts:
+            t.start()
+        four = DF.run(bs[0], [Job(list(p), n, s) for p, n, s in jobs])
+        bs[0].send_stop()
+        for t in ts:
+            t.join(timeout=300)
+    assert four == one
+
+
+# -- the TCP plan link -------------------------------------------------------------------------------------------
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def link_world(world: int, port: int, order, before=None, timeout: float = 20.0):
+    """Rank 0 and the followers ``order`` (ranks; connected in that order) on threads; ``before``: run first."""
+
+    out, err = {}, {}
+
+    def lead():
+        try:
+            out[0] = PL.TcpLink(0, "127.0.0.1", port, timeout_s=timeout, world=world)
+        except BaseException as e:      # noqa: BLE001
+            err[0] = e
+
+    def follow(r, w=world):
+        try:
+            out[r] = PL.TcpLink(r, "127.0.0.1", port, timeout_s=timeout, world=w)
+        except BaseException as e:      # noqa: BLE001
+            err[r] = e
+
+    t0 = threading.Thread(target=lead)
+    t0.start()
+    if before is not None:
+        before()
+    ts = []
+    for r in order:
+        t = threading.Thread(target=follow, args=r if isinstance(r, tuple) else (r,))
+        t.start()
+        t.join(timeout=timeout)
+        ts.append(t)
+    t0.join(timeout=timeout + 5)
+    return out, err
+
+
+def test_plan_link_four_ranks_in_rank_order():
+    port = free_port()
+    out, err = link_world(4, port, [3, 1, 2])
+    assert not err
+    lead = out[0]
+    lead.send([7, 8, 9])
+    for r in (1, 2, 3):
+        assert out[r].recv() == [7, 8, 9]
+    peers = [c.getpeername()[1] for c in lead.conns]
+    mine = [out[r].conn.getsockname()[1] for r in (1, 2, 3)]
+    assert peers == mine                                    # conns[i] is rank i + 1
+    for v in out.values():
+        v.close()
+
+
+def test_plan_link_refuses_strays_duplicates_and_other_worlds():
+    port = free_port()
+
+    def stray():
+        import time
+
+        for _ in range(200):
+            try:
+                s = socket.create_connection(("127.0.0.1", port), timeout=1)
+                break
+            except OSError:
+                time.sleep(0.02)
+        s.sendall(b"GET / HTTP/1.0\r\n\r\n")                # a port scanner / a web client
+        assert s.recv(1) in (PL.REFUSED, b"")
+        s.close()
+
+    out, err = link_world(4, port, [1, (2, 2), 1, 2, 3], before=stray)
+    # refused: rank 2 of a world of 2, then a second rank 1; then ranks 2 and 3 join
+    assert set(err) == {1, 2} and all(isinstance(e, ConnectionError) for e in err.values())
+    assert set(out) == {0, 1, 2, 3}
+    out[0].send([1])
+    assert [out[r].recv() for r in (1, 2, 3)] == [[1], [1], [1]]
+    for v in out.values():
+        v.close()
+
+
