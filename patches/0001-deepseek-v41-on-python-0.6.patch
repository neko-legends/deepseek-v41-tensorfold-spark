index 0000000..c279b04
--- /dev/null
+++ b/tests/test_dsv41_expert_block.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A 2,048-row prefill window under upstream's ``group`` kernel limit (48 KiB of int32 picks: 1,750 rows at 7 picks a
+row): GpuMoE runs the experts in row blocks of at most TF_DSV41_EXPERT_BLOCK (1,024) rows, into one output, with one
+block-sized scratch shared by every layer of a geometry (allocated once, never grown). The kernels are faked here
+(CPU); the GPU check is G4's 2,048-row step (``kbench --chunk 2048``)."""
+
+from __future__ import annotations
+
+import pytest
+import torch
+
+from tensorfold.families.deepseek_v41.cuda import experts as X
+from tensorfold.families.deepseek_v41.cuda import moe as M
+from tensorfold.families.deepseek_v41.cuda import router
+
+
+def test_limits():
+    assert M.group_rows_limit(X.MODEL.slots) == 1750          # 6 routed + 1 shared
+    assert M.group_rows_limit(X.DSPARK.slots) == 3064         # 3 routed + 1 shared
+    assert M.expert_block(X.MODEL.slots) == 1024
+    assert M.row_blocks(2048, 1024) == [(0, 1024), (1024, 2048)]
+    assert M.row_blocks(1500, 1024) == [(0, 1024), (1024, 1500)]
+
+
+def test_block_knob(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "4096")
+    assert M.expert_block(X.MODEL.slots) == 1750               # never over the kernel's limit
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "512")
+    assert M.expert_block(X.MODEL.slots) == 512
+    monkeypatch.setenv("TF_DSV41_EXPERT_BLOCK", "0")
+    with pytest.raises(ValueError):
+        M.expert_block(X.MODEL.slots)
+
+
+class _Block:
+    geom = X.MODEL
+
+
+class _Scratch:
+    def __init__(self, rows):
+        self.rows = rows
+
+
+@pytest.mark.parametrize("R", [1, 128, 1024, 1755, 2048])
+def test_a_2048_row_window_runs_in_blocks_under_the_group_limit(monkeypatch, R):
+    calls, made = [], []
+    D = 8
+
+    def route(x, gate, bias, *, topk, shared, scale, **kw):     # kw: keep (router keep logits, 1f46bc7)
+        pick = (torch.arange(x.shape[0] * 7, dtype=torch.int32) % 384).view(-1, 7)
+        return pick, torch.ones((x.shape[0], 7))
+
+    def routed(x, pick, wts, block, s, out, n, *, limit):
+        assert n == x.shape[0] == pick.shape[0] <= M.group_rows_limit(7) and n <= s.rows
+        calls.append(n)
+        y = x.float() * 2 + pick[:, :1].float()              # a per-row function: blocks must not change it
+        if out is None:
+            return y
+        assert out.is_contiguous()
+        out.copy_(y)
+        return out
+
+    def scratch(block, rows, device=None):
+        made.append(rows)
+        return _Scratch(rows)
+
+    monkeypatch.setattr(router, "route", route)
+    monkeypatch.setattr(X, "routed", routed)
+    monkeypatch.setattr(X, "scratch", scratch)
+    monkeypatch.setattr(M, "_SCRATCH", {})
+    layers = [M.GpuMoE(torch.zeros(384, D), torch.zeros(384), _Block(), 6, 1.5, 10.0) for _ in range(3)]
+    x = torch.randn(R, D)
+    pick = route(x, None, None, topk=6, shared=True, scale=1.5)[0]
+    for m in layers:
+        assert torch.equal(m(x), x * 2 + pick[:, :1].float())
+        m(x[:16])                                            # a decode-width call later: same scratch, no growth
+    assert max(calls) <= 1024 and sum(calls) == 3 * (R + min(R, 16))
+    assert made == [1024]                                    # one block-sized scratch for every layer, once
+    assert len({id(m.scratch) for m in layers}) == 1
+
+
+def test_the_drafter_geometry_gets_its_own_small_scratch(monkeypatch):
+    made = []
+    monkeypatch.setattr(X, "scratch", lambda block, rows, device=None: made.append((block.geom, rows)) or
+                        _Scratch(rows))
+    monkeypatch.setattr(M, "_SCRATCH", {})
+
+    class Draft:
+        geom = X.DSPARK
+
+    M.shared_scratch([M.GpuMoE(torch.zeros(128, 8), torch.zeros(128), Draft(), 3, 1.5, 10.0),
+                      M.GpuMoE(torch.zeros(384, 8), torch.zeros(384), _Block(), 6, 1.5, 10.0)])
+    assert made == [(X.DSPARK, 64), (X.MODEL, 1024)]
+    assert M.scratch_bytes_total() == X.scratch_bytes(64, X.DSPARK) + X.scratch_bytes(1024, X.MODEL)
diff --git a/tests/test_dsv41_failfast.py b/tests/test_dsv41_failfast.py
new file mode 100644
index 0000000..699bffe
--- /dev/null
+++ b/tests/test_dsv41_failfast.py
@@ -0,0 +1,485 @@
+"""Fail fast on both ranks (``failfast.py``) and the two-rank memory floor (``memory.prefill_price`` / ``Floor``), on the
+fake forward with a fake exchange: an exception injected on either rank ends both ranks (exit 70, every request
+failed with the reason) within seconds instead of the 120 s RoCE wait + the 300 s plan link; a rank that vanishes
+does too; rank 0's own planning / sampling failures fail only their requests and both ranks stay identical; rank 1's
+memory reaches rank 0's floor; a long prompt that does not fit waits, then admits when memory returns, and is refused
+only when nothing is live and it can never fit."""
+
+from __future__ import annotations
+
+import io
+import os
+import socket
+import threading
+import time
+
+import numpy as np
+import pytest
+
+pytest.importorskip("torch")
+from dsv41_serving_fakes import FakeForward, topo_fixture  # noqa: F401  (fixtures)
+
+from tensorfold.families.deepseek_v41.cuda import failfast, memory
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job
+from tensorfold.families.deepseek_v41.cuda.memory import GiB
+from tensorfold.families.deepseek_v41.cuda.pool import Pool
+from tensorfold.families.deepseek_v41.cuda.sessions import Tag
+from tensorfold.server.errors import CapacityError
+
+VOCAB = 4096
+
+
+# -- a two-rank exchange that behaves like the forward's ---------------------------------------------------------------
+class Xchg:
+    """Every forward call on a rank waits for the same call on the other (an all-gather); a rank's own ``abort``
+    releases only its own waits (each rank poisons its local RoCE runtime); ``freeze(rank)``: that rank never arrives
+    again (a killed process)."""
+
+    def __init__(self) -> None:
+        self.cv = threading.Condition()
+        self.n = [0, 0]
+        self.aborted: list[str | None] = [None, None]
+        self.frozen = [False, False]
+        self.waited = [0.0, 0.0]
+
+    def gather(self, rank: int) -> None:
+        with self.cv:
+            if self.frozen[rank]:
+                self.cv.wait_for(lambda: False, timeout=60)
+            if self.aborted[rank]:
+                raise RuntimeError(self.aborted[rank])
+            self.n[rank] += 1
+            k = self.n[rank]
+            self.cv.notify_all()
+            t0 = time.monotonic()
+            ok = self.cv.wait_for(lambda: self.n[1 - rank] >= k or self.aborted[rank], timeout=60)
+            self.waited[rank] = max(self.waited[rank], time.monotonic() - t0)
+            if self.aborted[rank]:
+                raise RuntimeError(self.aborted[rank])
+            if not ok:
+                raise TimeoutError("the exchange timed out (the 120 s RoCE wait)")
+
+    def freeze(self, rank: int) -> None:
+        with self.cv:
+            self.frozen[rank] = True
+
+
+class FakeRt:
+    def __init__(self, x: Xchg, rank: int) -> None:
+        self.x, self.rank, self.aborts = x, rank, 0
+
+    def abort(self, reason: str, hold_s: float = 0.0) -> None:
+        with self.x.cv:
+            self.aborts += 1
+            self.x.aborted[self.rank] = f"RoCE runtime aborted on rank {self.rank}: {reason}"
+            self.x.cv.notify_all()
+
+
+class XForward(FakeForward):
+    def __init__(self, *a, xchg: Xchg, rank: int, **k) -> None:
+        super().__init__(*a, **k)
+        self.xchg, self.rank = xchg, rank
+
+    def prefill(self, pieces, *, mode):
+        self.xchg.gather(self.rank)
+        return super().prefill(pieces, mode=mode)
+
+    def window(self, windows, **kw):
+        self.xchg.gather(self.rank)
+        return super().window(windows, **kw)
+
+
+class PairLink:
+    def __init__(self) -> None:
+        import queue
+
+        self.q = queue.Queue()
+
+    def send(self, plan):
+        self.q.put(list(plan))
+
+    def recv(self):
+        return self.q.get(timeout=20)
+
+
+class Pair:
+    def __init__(self, topo, monkeypatch, *, inject: str = "", grace: float = 0.05, n: int = 4) -> None:
+        if inject:
+            monkeypatch.setenv("TF_DSV41_FAILFAST_INJECT", inject)
+        else:
+            monkeypatch.delenv("TF_DSV41_FAILFAST_INJECT", raising=False)
+        self.x = Xchg()
+        self.link = PairLink()
+        self.out = io.StringIO()
+        self.exits: dict[int, list[int]] = {0: [], 1: []}
+        a, b = socket.socketpair()
+        self.socks = (a, b)
+        self.b = []
+        for rank, sock in ((0, a), (1, b)):
+            pool = Pool(topo, 16384)
+            fwd = XForward(topo, pool, n, VOCAB, xchg=self.x, rank=rank)
+            bt = Batcher(fwd, pool, n_slots=n, capacity=4096, mode="full", tag=Tag(ced="full").code(),
+                         prefill_rows=256, depth=0, session_min=16, start=False, link=self.link, rank=rank)
+            fate = failfast.Fate(rank, failfast.Channel(rank, sock), rt=FakeRt(self.x, rank),
+                                 exit_fn=self.exits[rank].append, grace_s=grace, report_s=0.05,
+                                 usable=lambda: 50 * GiB, out=self.out)
+            bt.fate = fate
+            if rank == 0:
+                fate.on_fail.append(bt.fail_everything)
+            fate.start()
+            self.b.append(bt)
+        self.r0, self.r1 = self.b
+        self.follower = threading.Thread(target=self.r1.follow, daemon=True)
+        self.follower.start()
+        self.r0.begin()
+
+    def wait_dead(self, timeout: float = 10.0) -> float:
+        t0 = time.monotonic()
+        while time.monotonic() - t0 < timeout:
+            if all(self.exits[r] for r in (0, 1)):
+                return time.monotonic() - t0
+            time.sleep(0.01)
+        raise AssertionError(f"not both ranks exited: {self.exits}; log:\n{self.out.getvalue()}")
+
+    def stop(self) -> None:
+        self.r0.send_stop()
+        self.r0.stopping = True
+        with self.r0.cv:
+            self.r0.cv.notify_all()
+        self.follower.join(timeout=20)
+        self.r0.thread.join(timeout=20)
+        for s in self.socks:
+            s.close()
+
+
+def prompts(seed=0, lens=(37, 300, 700, 1200)):
+    rng = np.random.default_rng(seed)
+    return [[int(t) for t in rng.integers(2, VOCAB, size=n)] for n in lens]
+
+
+def outcome(job: Job, timeout: float = 20.0):
+    """(tokens, the exception or None) once the job ends."""
+
+    toks, end = [], time.monotonic() + timeout
+    while time.monotonic() < end:
+        try:
+            item = job.out.get(timeout=0.05)
+        except Exception:                       # noqa: BLE001  queue.Empty
+            continue
+        if item is None:
+            return toks, None
+        if isinstance(item, BaseException):
+            return toks, item
+        toks += item
+    raise AssertionError("job did not end")
+
+
+# -- fatal failures: both ranks go down fast --------------------------------------------------------------------------
+@pytest.mark.parametrize("inject,who,kind", [
+    ("1:3:prefill", "rank 1 failed", "Injected"),               # rank 0 waits in the prefill exchange
+    ("1:6:window", "rank 1 failed", "Injected"),                # rank 0 waits in a decode exchange
+    ("0:3:prefill:key", "rank 0 failed", "KeyError"),           # G16's vision KeyError: rank 1 waits in the exchange
+    ("0:3:prefill:oom", "rank 0 failed", "OutOfMemoryError"),   # d5ceil's OOM in a long prefill
+    ("1:2:admit", "rank 1 failed", "Injected"),                 # before any exchange of the round
+])
+def test_one_rank_fails_both_exit_fast(topo, monkeypatch, inject, who, kind):
+    p = Pair(topo, monkeypatch, inject=inject)
+    jobs = [p.r0.submit(Job(pr, 400, None)) for pr in prompts(1)]       # all still running when it fails
+    took = p.wait_dead()
+    assert took < 5.0                                   # not 120 s + 300 s
+    assert p.exits == {0: [70], 1: [70]}
+    for r in (0, 1):
+        assert p.b[r].fate.dead and p.b[r].fate.code == 70
+    for j in jobs:                                      # every in-flight request: a 500 with the reason
+        _, err = outcome(j)
+        assert isinstance(err, RuntimeError) and not isinstance(err, CapacityError)
+        assert who in str(err) and kind in str(err) and "both ranks are restarting" in str(err)
+    with pytest.raises(CapacityError, match="restarting"):    # new requests: 503 while the rank exits
+        p.r0.submit(Job([5, 6, 7], 4, None))
+    assert max(p.x.waited) < 5.0                        # the peer's pending exchange returned at once
+    log = p.out.getvalue()
+    assert "[tensorfold] dsv41 fail-fast: rank 0" in log and "[tensorfold] dsv41 fail-fast: rank 1" in log
+    assert p.b[0].fate.rt.aborts >= 1 and p.b[1].fate.rt.aborts >= 1
+    p.follower.join(timeout=10)
+    p.r0.thread.join(timeout=10)
+    assert not p.follower.is_alive() and not p.r0.thread.is_alive()   # both round loops left
+
+
+@pytest.mark.parametrize("victim", [0, 1])
+def test_killed_rank_ends_the_other(topo, monkeypatch, victim):
+    """A rank killed mid-round (kill -9: no FAIL frame, the kernel closes its socket): the survivor fails its requests
+    and exits 70 at once, out of the exchange it waits in."""
+
+    p = Pair(topo, monkeypatch)
+    jobs = [p.r0.submit(Job(pr, 400, None)) for pr in prompts(2, (300, 900))]
+    for _ in range(500):                                # mid-decode
+        if p.r0.counts["rows"] > 20:
+            break
+        time.sleep(0.01)
+    p.x.freeze(victim)
+    p.b[victim].fate.dead = "killed"                    # the dead process does nothing more
+    p.socks[victim].shutdown(socket.SHUT_RDWR)
+    survivor = 1 - victim
+    t0 = time.monotonic()
+    while not p.exits[survivor] and time.monotonic() - t0 < 10:
+        time.sleep(0.01)
+    assert p.exits[survivor] == [70] and time.monotonic() - t0 < 5.0
+    assert "closed the fate channel" in p.b[survivor].fate.dead
+    if survivor == 0:
+        for j in jobs:
+            _, err = outcome(j)
+            assert isinstance(err, RuntimeError) and "rank 1 closed" in str(err)
+
+
+@pytest.mark.parametrize("inject", ["0:4:sample", "0:4:plan"])
+def test_rank0_planning_or_sampling_failure_is_not_fatal(topo, monkeypatch, inject):
+    """Nothing of a failed plan was shared; a sample is rank 0's alone: the requests concerned fail, the others and
+    later ones are served, no rank exits, and both ranks' state stays identical."""
+
+    p = Pair(topo, monkeypatch, inject=inject)
+    jobs = [p.r0.submit(Job(pr, 30, None)) for pr in prompts(3)]
+    res = [outcome(j) for j in jobs]
+    failed = [e for _, e in res if e is not None]
+    assert 1 <= len(failed) <= 4 and all(isinstance(e, RuntimeError) for e in failed)
+    if inject.endswith("sample"):
+        assert len(failed) == 1 and "sampling failed" in str(failed[0])
+    later = [p.r0.submit(Job(pr, 20, None)) for pr in prompts(4, (100, 500))]
+    for j in later:
+        toks, err = outcome(j)
+        assert err is None and len(toks) == 20
+    p.stop()
+    assert p.exits == {0: [], 1: []} and p.r0.fate.dead is None and p.r1.fate.dead is None
+    assert p.r0.fwd.calls == p.r1.fwd.calls and p.r0.fwd.digest() == p.r1.fwd.digest()
+    assert p.r0.pool.alloc.n_free == p.r1.pool.alloc.n_free == p.r0.pool.npages
+
+
+def test_rank1_reports_memory_to_rank0(topo, monkeypatch):
+    p = Pair(topo, monkeypatch)
+    for _ in range(200):
+        if p.r0.fate.reports >= 2:
+            break
+        time.sleep(0.01)
+    got = p.r0.fate.peer_mem()
+    assert got is not None and got[0] == 50 * GiB and got[1] < 1.0
+    p.stop()
+    assert p.exits == {0: [], 1: []}                    # a normal stop is not a failure
+
+
+# -- pieces -------------------------------------------------------------------------------------------------------------
+def test_inject_parsing(monkeypatch):
+    assert failfast.Inject.from_env(0, "") is None
+    assert failfast.Inject.from_env(1, "0:3:prefill") is None          # the other rank's
+    inj = failfast.Inject.from_env(0, "0:3:prefill:oom")
+    inj(2, "prefill")
+    inj(3, "window")
+    import torch
+
+    with pytest.raises(getattr(torch, "OutOfMemoryError", None) or torch.cuda.OutOfMemoryError):
+        inj(4, "prefill")
+    inj(5, "prefill")                                   # once
+    for bad in ("0:3", "0:3:nowhere", "0:3:prefill:boom"):
+        with pytest.raises(ValueError):
+            failfast.Inject.from_env(0, bad)
+    assert failfast.enabled("1") and not failfast.enabled("0")
+    monkeypatch.setenv("TF_DSV41_FAILFAST", "0")
+    assert failfast.attach(object(), object(), rank=0, master="", port=0) is None
+
+
+def test_channel_frames_and_conn_of():
+    from tensorfold.families.deepseek_v41.cuda import planlink
+
+    a, b = socket.socketpair()
+    c0, c1 = failfast.Channel(0, a), failfast.Channel(1, b)
+    assert c1.report(123) and c1.report(456)
+    assert c0.read() == (failfast.MEM, 123, "") and c0.read() == (failfast.MEM, 456, "")
+    assert not c1.hung_up(0.01)
+    c1.fail("rank 1 failed in round 9 (prefill): KeyError: 5")
+    assert c0.read() == (failfast.FAIL, len("rank 1 failed in round 9 (prefill): KeyError: 5"),
+                         "rank 1 failed in round 9 (prefill): KeyError: 5")
+    assert c0.read() is None
+    a2, b2 = socket.socketpair()
+    c0b, c1b = failfast.Channel(0, a2), failfast.Channel(1, b2)
+    c0b.hangup()
+    assert c1b.hung_up(1.0)
+    tl = planlink.TcpLink.__new__(planlink.TcpLink)
+    tl.conn = a
+    assert failfast.conn_of(tl) is a
+    rl = planlink.RoceLink.__new__(planlink.RoceLink)
+    rl.tcp = tl
+    assert failfast.conn_of(planlink.Pinned(rl, 0)) is a
+    assert failfast.conn_of(object()) is None
+    for s in (a, b, a2, b2):
+        s.close()
+
+
+def test_roce_abort_releases_waits_without_marker(monkeypatch, tmp_path):
+    """``Runtime.abort``: the failure word, the newest sequence's peer flags written (a spinning wait returns), a clear
+    ``RoceError`` on the next check, no marker file (the transport did not fail)."""
+
+    from tensorfold.families.glm5_next.spark import roce
+
+    mark = tmp_path / "roce-failed"
+    monkeypatch.setenv("GLM53_TF_ROCE_MARK", str(mark))
+    rt = roce.Runtime.__new__(roce.Runtime)
+    rt.rank, rt.world, rt.n_hca, rt.slots, rt.flag_stride = 0, 2, 2, 2, 64
+    rt.ctrl = np.zeros(roce.CTRL_WORDS, dtype=np.uint32)
+    rt.flags = np.zeros(2 * 2 * 2 * 64 // 4, dtype=np.uint32)
+    rt.proxy, rt._reported, rt.marking = None, False, True
+    rt.ctrl[roce.CTRL_SEQ] = 41
+    rt.check()
+    rt.abort("rank 1 failed in round 7 (prefill): OutOfMemoryError")
+    assert rt.ctrl[roce.CTRL_FAILED] == 1
+    assert all(rt.flags[rt._flag_word(1, 41 & 1, h)] == 41 for h in range(2))
+    with pytest.raises(roce.RoceError, match="aborted on rank 0: rank 1 failed"):
+        rt.check()
+    assert not mark.exists()
+    rt.ctrl[roce.CTRL_SEQ] = 42                         # a replay launched the next sequence: held for hold_s
+    t = threading.Thread(target=rt.abort, args=("again", 0.2))
+    t.start()
+    time.sleep(0.05)
+    rt.ctrl[roce.CTRL_SEQ] = 43
+    t.join()
+    assert rt.flags[rt._flag_word(1, 1, 0)] == 43 and rt.flags[rt._flag_word(1, 0, 0)] == 42
+
+
+# -- the two-rank floor -------------------------------------------------------------------------------------------------
+def _mi(avail_gib: float) -> dict:
+    return {"MemTotal": 121 * GiB, "MemFree": int(avail_gib * GiB), "MemAvailable": int(avail_gib * GiB),
+            "Dirty": 0, "Writeback": 0, "Mapped": 0}
+
+
+@pytest.fixture(name="clean_env")
+def clean_env_fixture(monkeypatch):
+    for k in list(os.environ):
+        if k.startswith("TF_DSV41_FLOOR") or k in ("TF_DSV41_INDEX_BUDGET_MIB", "TF_DSV41_PREFILL_ROWS",
+                                                    "GLM53_TF_ADMIT_MEM", "TF_DSV41_ADMIT_FREE_FLOOR_GIB",
+                                                    "TF_DSV41_FAILFAST_INJECT"):
+            monkeypatch.delenv(k, raising=False)
+    monkeypatch.setenv("GLM53_TF_ADMIT_CACHE_KEEP_GB", "0")
+
+
+def test_prefill_price_terms(clean_env, monkeypatch):
+    g = lambda p: round(p.total / GiB, 2)               # noqa: E731
+    # G16's measurement: 2,048-row windows, a 299K prompt: +1.60 GiB reserved at budget 256, ~0.8 at 64, + host 0.6
+    assert g(memory.prefill_price(299_000, rows=2048, budget_mib=256)) == pytest.approx(2.2, abs=0.01)
+    assert g(memory.prefill_price(299_000, rows=2048, budget_mib=64)) == pytest.approx(1.4, abs=0.01)
+    assert g(memory.prefill_price(299_000, rows=1024, budget_mib=64)) == pytest.approx(0.83, abs=0.01)
+    assert g(memory.prefill_price(299_000, rows=4096, budget_mib=256)) == pytest.approx(3.33, abs=0.01)
+    short = memory.prefill_price(200, rows=2048, budget_mib=256)       # a chat turn: a 199-row window, few keys
+    assert short.total < 0.12 * GiB
+    assert memory.prefill_price(100_000, 99_999, rows=2048).total == 0            # everything cached
+    late = memory.prefill_price(100_000, 40_000, rows=2048, budget_mib=256)       # cached past 32K: no index growth
+    assert late.index == 0 and late.once > 0
+    p = memory.prefill_price(299_000, rows=2048, budget_mib=256)
+    assert p.outstanding(0) == p.total
+    assert p.outstanding(16384) == pytest.approx(p.index / 2, rel=0.01)           # half the index growth left
+    assert p.outstanding(40_000) == 0
+    monkeypatch.setenv("TF_DSV41_FLOOR_PF_OTHER_GIB", "0.5")
+    assert g(memory.prefill_price(299_000, rows=2048, budget_mib=256)) == pytest.approx(2.7, abs=0.01)
+    monkeypatch.setenv("TF_DSV41_FLOOR_PRICE", "0")
+    assert memory.prefill_price(299_000).total == 0
+
+
+def test_floor_checks_the_tighter_rank(clean_env):
+    peer = {"v": None}
+    f = memory.Floor(5.0, 4.0, meminfo=lambda: _mi(9.0), cached=lambda: 0, peer=lambda: peer["v"])
+    assert f.check(2 * GiB) and f.last[0] == 0                   # rank 1 unknown: rank 0 alone (9 - 2 >= 4)
+    peer["v"] = (int(6.2 * GiB), 0.3)                           # G16: the worker at 6.2 GiB
+    assert not f.check(int(2.7 * GiB))                          # 6.2 - 2.7 < 4: waits for rank 1
+    assert f.last[:2] == (1, int(6.2 * GiB)) and f.stats["peer_waits"] == 1
+    assert f.check(int(2.0 * GiB))
+    peer["v"] = (int(1 * GiB), 60.0)                            # a stale report is not used
+    assert f.check(2 * GiB) and f.last[0] == 0
+
+
+def _batcher(topo, floor, n=2):
+    pool = Pool(topo, 16384)
+    fwd = FakeForward(topo, pool, n, VOCAB)
+    return Batcher(fwd, pool, n_slots=n, capacity=4096, mode="full", tag=Tag(ced="full").code(), prefill_rows=256,
+                   depth=0, session_min=16, start=False, floor=floor)
+
+
+def test_long_prompt_waits_for_rank1_then_admits(topo, clean_env, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_FLOOR_PF_OTHER_GIB", "2")      # a price of ~2.3 GiB for these toy prompts
+    peer = {"v": (int(5.0 * GiB), 0.1)}
+    f = memory.Floor(5.0, 4.0, meminfo=lambda: _mi(20.0), cached=lambda: 0, peer=lambda: peer["v"],
+                     log=None, refuse_s=0.0)
+    b = _batcher(topo, f)
+    busy = b.submit(Job(prompts(5, (300,))[0], 200, None))      # live: memory may come back, so a wait, not a refusal
+    peer["v"] = (int(20 * GiB), 0.1)
+    b.step()
+    assert b.seqs[0] is not None
+    peer["v"] = (int(5.0 * GiB), 0.1)                           # rank 1 drops under hard + price
+    job = b.submit(Job(prompts(6, (3000,))[0], 8, None))
+    for _ in range(5):
+        b.step()
+    assert job in b.queue and b.counts["mem_waits"] >= 1 and f.stats["peer_waits"] >= 1
+    peer["v"] = (int(8.0 * GiB), 0.1)                           # memory returns on rank 1
+    for _ in range(3000):
+        if not b.step():
+            break
+    toks, err = outcome(job, 1)
+    assert err is None and len(toks) == 8 and "mem_wait_since" not in job.stats
+    assert outcome(busy, 1)[1] is None
+
+
+def test_admitted_prefill_reserves_its_transient(topo, clean_env, monkeypatch):
+    """B waits while A's transient has not materialised (``Price.outstanding``), then goes once A prefilled."""
+
+    monkeypatch.setenv("TF_DSV41_FLOOR_PF_OTHER_GIB", "2")
+    f = memory.Floor(5.0, 4.0, meminfo=lambda: _mi(8.0), cached=lambda: 0, refuse_s=1e9)
+    b = _batcher(topo, f)
+    a = b.submit(Job(prompts(7, (2000,))[0], 4, None))
+    bj = b.submit(Job(prompts(8, (2000,))[0], 4, None))
+    b.step()                                                     # A admitted (8 - 2.2 >= 4); B: 8 - 4.4 < 4
+    assert b.seqs[0] is not None and b.seqs[0].job is a and bj in b.queue
+    for _ in range(3000):
+        if not b.step():
+            break
+    assert outcome(a, 1)[1] is None and outcome(bj, 1)[1] is None
+
+
+def test_never_fits_refused_only_when_idle(topo, clean_env, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_FLOOR_PF_OTHER_GIB", "3")
+    peer = {"v": (int(6.0 * GiB), 0.1)}                         # rank 1: 6 - 3.x < 4, forever
+    f = memory.Floor(5.0, 4.0, meminfo=lambda: _mi(30.0), cached=lambda: 0, peer=lambda: peer["v"], refuse_s=0.2)
+    b = _batcher(topo, f)
+    job = b.submit(Job(prompts(9, (1500,))[0], 4, None))
+    b.step()
+    assert job in b.queue                                        # waits first (memory may come back)
+    time.sleep(0.25)
+    b.step()
+    assert job not in b.queue
+    _, err = outcome(job, 1)
+    assert isinstance(err, CapacityError) and "rank 1" in str(err) and "cannot fit" in str(err)
+    assert b.counts["mem_refused"] == 1
+    small = b.submit(Job(prompts(10, (20,))[0], 4, None))        # a short prompt still fits
+    monkeypatch.setenv("TF_DSV41_FLOOR_PF_OTHER_GIB", "0")
+    for _ in range(100):
+        if not b.step():
+            break
+    assert outcome(small, 1)[1] is None
+
+
+def test_follower_link_error_while_dying_exits_70_not_1():
+    """G17 B2: rank 0 killed while rank 1 idles in ``follow``: the fate thread sees the hang-up first (``dead`` set,
+    sleeping its grace) and the plan link's recv fails next. The follower must wait for the fate's exit (70), not
+    raise (the process would exit 1 before the grace ended)."""
+
+    from types import SimpleNamespace
+
+    exits: list[int] = []
+    fate = failfast.Fate(1, None, exit_fn=exits.append, grace_s=0.3, out=io.StringIO())
+    dying = threading.Thread(target=fate.peer_failed, args=("rank 0 closed the fate channel",), daemon=True)
+    dying.start()
+    t0 = time.monotonic()
+    while fate.dead is None and time.monotonic() - t0 < 5:
+        time.sleep(0.005)
+
+    class DeadLink:
+        def recv(self):
+            raise ConnectionError("plan link: rank 0 closed the connection")
+
+    Batcher.follow(SimpleNamespace(link=DeadLink(), fate=fate))    # returns (no raise) once the fate exited
+    assert exits == [70] and fate.done.is_set()
+    dying.join(timeout=5)
