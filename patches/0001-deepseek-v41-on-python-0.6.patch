+
+    assert fastboot.stored_name(f"{fastboot.PKG}.qmm:Q4") == "tensorfold.families.glm5_next.cuda.qmm:Q4"
+    assert fastboot.loaded_name("tensorfold.families.glm5_next.cuda.qmm") == f"{fastboot.PKG}.qmm"
+    assert fastboot.stored_name("tensorfold.engine.exact_sampling") == "tensorfold.engine.exact_sampling"
+    assert fastboot._find_class("tensorfold.families.glm5_next.cuda.qmm:Q4") is qmm.Q4
+
+
+def test_the_spark_app_takes_the_cli_aliases_argument_and_refuses_a_name(tmp_path):
+    from tensorfold.families.glm5_next.spark import server
+
+    engine = type("Engine", (), {"generate": lambda self, *a, **k: None})()
+    with pytest.raises(ValueError, match="--alias"):
+        server.App(engine, tmp_path, "glm", aliases=["other"])
+    with pytest.raises(Exception, match="No such file"):          # past the alias check: no tokenizer in tmp_path
+        server.App(engine, tmp_path, "glm", aliases=["", " "])
diff --git a/tests/test_roce_g14_compile.py b/tests/test_roce_g14_compile.py
new file mode 100644
index 0000000..6967d3d
--- /dev/null
+++ b/tests/test_roce_g14_compile.py
@@ -0,0 +1,155 @@
+"""G14 (GLM53_TF_ROCE_FAST): ``glm5_next/spark/roce.cu`` builds for sm_121 (GB10) without a GPU, and the PTX holds what
+the fast path's claims rest on. Needs an nvcc that knows compute_121 (TF_NVCC, PATH or CUDA_HOME).
+
+- both kernels (``gather_kernel``, unchanged, and ``gather_fast_kernel``): <= 64 registers (``__launch_bounds__(1024)``),
+  no spills, the 8-byte stack frame the classic kernel already had (the failed wait's ``seen`` word);
+- the classic kernel keeps 0350's ``fence.sc.sys`` pairs and the 64-bit ``atomicMax`` trace stamp (now only for a
+  device ring), and its tail's system-scope read of the host failure word;
+- the fast kernel: the lean doorbell (byte counts stored before the ``st.release.sys`` of the sequence), the local
+  shard copied AFTER that release and BEFORE the first poll (the copy runs in the wait's shadow), ``nanosleep`` for the
+  poller stagger, ``fence.sc.sys`` only in the failure record (2), no ``fence.sc.gpu`` at all, no 64-bit atomic, and
+  the peer slot read with two 16-byte system loads in flight before their stores;
+- ``roce.cpp`` passes ``g++ -fsyntax-only`` when ``TF_CXX_INC`` names a directory with c10/cuda and infiniband headers.
+
+    TF_NVCC=<nvcc> [TF_CXX_INC=<dir>] pytest -q tests/test_roce_g14_compile.py
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sysconfig
+from pathlib import Path
+
+import pytest
+
+SRC = Path(__file__).resolve().parents[1] / "src/tensorfold/families/glm5_next/spark"
+FLAGS = ["-arch=sm_121", "-O3", "-include", "cstdint"]
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+needs_nvcc = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+@pytest.fixture(scope="module")
+def built(tmp_path_factory):
+    if NVCC is None:
+        pytest.skip("no nvcc with compute_121 (TF_NVCC)")
+    td = tmp_path_factory.mktemp("roce_g14")
+    r = subprocess.run([NVCC, *FLAGS, "-cubin", "-Xptxas", "-v", "-o", str(td / "k.cubin"), str(SRC / "roce.cu")],
+                       capture_output=True, text=True, timeout=900)
+    assert r.returncode == 0, r.stderr[-3000:]
+    p = subprocess.run([NVCC, *FLAGS, "-ptx", "-o", str(td / "k.ptx"), str(SRC / "roce.cu")], capture_output=True,
+                       text=True, timeout=900)
+    assert p.returncode == 0, p.stderr[-3000:]
+    return r.stderr, (td / "k.ptx").read_text()
+
+
+def _entries(ptxas: str) -> dict:
+    out, cur = {}, None
+    for line in ptxas.splitlines():
+        m = re.search(r"Compiling entry function '(\S+)'", line)
+        if m:
+            cur = m.group(1)
+            out[cur] = {}
+            continue
+        m = re.search(r"Function properties for (\S+)", line)
+        if m:
+            cur = m.group(1) if m.group(1) in out else None
+            continue
+        m = re.search(r"Used (\d+) registers", line)
+        if m and cur:
+            out[cur]["regs"] = int(m.group(1))
+        m = re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes spill loads", line)
+        if m and cur:
+            out[cur]["stack"], out[cur]["spill"] = int(m.group(1)), int(m.group(2)) + int(m.group(3))
+    return out
+
+
+def _bodies(ptx: str) -> dict:
+    return {m.group(1): m.group(2) for m in re.finditer(r"\.entry\s+(\S+)\s*\((.*?)\n\}", ptx, re.S)}
+
+
+def _one(d: dict, key: str) -> tuple[str, object]:
+    found = [(k, v) for k, v in d.items() if key in k]
+    assert len(found) == 1, (key, list(d))
+    return found[0]
+
+
+@needs_nvcc
+def test_both_kernels_build_without_spills(built):
+    ents = _entries(built[0])
+    assert len(ents) == 2, ents
+    for name, e in ents.items():
+        assert e.get("regs", 0) <= 64 and e.get("spill") == 0 and e.get("stack", 0) <= 8, (name, e)
+    print(f"[G14] roce.cu sm_121: " + ", ".join(f"{k[-24:]} {v['regs']} regs, stack {v['stack']}" for k, v in ents.items()))
+
+
+@needs_nvcc
+def test_classic_kernel_keeps_its_orderings(built):
+    _, body = _one(_bodies(built[1]), "13gather_kernel")
+    assert body.count("fence.sc.sys") >= 3                    # per-block + doorbell + failure record (0350)
+    assert "st.release.sys.global.u32" in body                # 0460's lean doorbell
+    assert re.search(r"atom\.global\.max\.u64|red\.global\.max\.u64|atom\.max\.u64", body)   # device-ring stamp
+    assert "ld.relaxed.sys.global.u32" in body
+
+
+@needs_nvcc
+def test_fast_kernel_order(built):
+    _, body = _one(_bodies(built[1]), "gather_fast_kernel")
+    assert body.count("fence.sc.sys") == 2, body.count("fence.sc.sys")   # the failure record only
+    assert "fence.sc.gpu" not in body
+    assert not re.search(r"\b(atom|red)\.[a-z.]*max\.u64", body)
+    assert "nanosleep" in body
+    assert "atom.acq_rel.sys.global.add.u32" in body and "atom.acq_rel.gpu.global.add.u32" in body
+    rel = body.index("st.release.sys.global.u32")
+    assert body[:rel].count("st.relaxed.sys.global.u32") >= 2            # byte counts before the doorbell
+    call = body.index("wait_flag_shared")
+    between = body[rel:call]
+    # the local shard: plain global loads and stores between the doorbell and the first poll
+    assert re.search(r"\bld(\.global)?\.(v4\.)?[bu](8|32)\b", between), "no local copy before the wait"
+    assert re.search(r"\bst\.global\.(v4\.)?[bu](8|32)\b", between)
+    assert not re.search(r"ld\.(relaxed|acquire)\.sys", between)        # nothing read from the peer slot yet
+    # g. the peer slot: a thread's two 16-byte system-scope loads are issued before its stores (one round trip)
+    seq = "".join("L" if o.startswith("ld") else "S" for o in
+                  re.findall(r"\bld\.relaxed\.sys\.global\.v4|\bst\.global\.v4", body[call:]))
+    assert "LLSS" in seq, seq
+
+
+def _cxx_inc() -> str | None:
+    for c in (os.environ.get("TF_CXX_INC"), str(Path.home() / ".cache/roce-inc")):
+        if c and Path(c, "infiniband").is_dir():
+            return c
+    return None
+
+
+def test_bindings_syntax():
+    torch = pytest.importorskip("torch")
+    inc = _cxx_inc()
+    cxx = shutil.which("g++")
+    if inc is None or cxx is None or NVCC is None:
+        pytest.skip("set TF_CXX_INC (c10/cuda + infiniband headers), g++ and TF_NVCC")
+    tinc = Path(torch.__file__).parent / "include"
+    cuda_inc = Path(NVCC).parent.parent / "include"
+    r = subprocess.run([cxx, "-std=c++20", "-fsyntax-only", "-DTORCH_EXTENSION_NAME=x", "-DTORCH_API_INCLUDE_EXTENSION_H",
+                        f"-I{inc}", f"-I{tinc}", f"-I{tinc / 'torch/csrc/api/include'}", f"-I{cuda_inc}",
+                        f"-I{sysconfig.get_paths()['include']}", str(SRC / "roce.cpp")], capture_output=True, text=True,
+                       timeout=600)
+    errors = [ln for ln in r.stderr.splitlines() if " error" in ln or ln.startswith("error")]
+    assert r.returncode == 0 and not errors, "\n".join(errors[:20])
