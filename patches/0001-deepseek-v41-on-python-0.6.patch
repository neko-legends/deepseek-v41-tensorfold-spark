+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fork / join plans of ``branches.py`` (TF_DSV41_BRANCHES), on the CPU: every layer kind's plan is safe (each
+op reads what its stream already has, no op races the other stream, one stream a counter group, every fork joined),
+the checker rejects the unsafe variants, the side really takes the latency-bound chains, the knob parses, and the
+plan runner issues exactly the plan's forks, joins and streams."""
+
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("torch")
+
+from tensorfold.families.deepseek_v41.cuda import branches as BR  # noqa: E402
+
+KINDS = [(ix, comp, split) for ix in (False, True) for comp in (False, True) for split in (False, True)
+         if ix or not comp]
+
+
+@pytest.mark.parametrize("kind", KINDS)
+def test_every_plan_is_safe(kind):
+    ix, comp, split = kind
+    steps = BR.plan(ix, comp, split)
+    BR.check(steps, BR.initial(ix, comp))
+    ops = [s[1] for s in steps if len(s) == 2]
+    assert ops[-1] == "attn" and steps[-2] == ("join",)
+    assert ("compress" in ops) == comp and ("select" in ops) == ix and ("ix_wp" in ops) == ix
+    assert ("wq_b" in ops) == (split or not ix) and ("q" in ops) == (ix and not split)
+
+
+def test_the_side_takes_the_indexer_and_compressor():
+    side = {s[1] for s in BR.plan(True, True, True) if s[0] == "side"}
+    assert side == {"ix_wp", "compress", "ix_wq_b", "rope_qi", "select"}
+    main = {s[1] for s in BR.plan(True, True, True) if s[0] == "main"}
+    assert {"wq_b", "rope_q", "kv_swa", "attn"} <= main and not main & side
+    assert {s[1] for s in BR.plan(False, False, False) if s[0] == "side"} == {"kv_swa"}
+
+
+def _bad(steps, init, match):
+    with pytest.raises(ValueError, match=match):
+        BR.check(steps, init)
+
+
+def test_check_rejects_unsafe_plans():
+    init = BR.initial(True, True)
+    good = list(BR.plan(True, True, True))
+    _bad([s for s in good if s != ("join",)], init, "attn on main reads")          # no join before the core
+    _bad(good[:-2], init, "open fork")                                              # ends forked
+    _bad([("side", "ix_wp")], init, "outside a fork")                              # side op without a fork
+    _bad([("fork",), ("side", "ix_wq_b")], init, "reads")                          # qr is not on the side yet
+    _bad([("fork",), ("main", "xproj"), ("side", "compress")], init, "reads")       # proj made after the fork
+    _bad([("main", "xproj"), ("main", "xproj")], init, "twice")
+
+
+def test_check_rejects_a_race():
+    init = BR.initial(True, False)
+    # main writes qi (the fused q group) while the side, forked earlier, reads qi: only a fork after it orders them
+    steps = [("main", "xproj"), ("main", "rms2"), ("fork",), ("side", "ix_wp"), ("main", "q"), ("side", "rope_qi")]
+    with pytest.raises(ValueError, match="reads"):
+        BR.check(steps, init)
+    BR.WRITES["probe"], BR.READS["probe"] = ("w",), ()       # a main op overwriting the side's output
+    try:
+        with pytest.raises(ValueError, match="races"):
+            BR.check([("fork",), ("side", "ix_wp"), ("main", "probe"), ("join",)], init)
+    finally:
+        del BR.WRITES["probe"], BR.READS["probe"]
+
+
+def test_check_rejects_a_counter_group_on_two_streams(monkeypatch):
+    monkeypatch.setitem(BR.GROUPS, "ix_wq_b", "q.main")      # as if both launches shared wq_b's counters
+    with pytest.raises(ValueError, match="counter group"):
+        BR.check(BR.plan(True, False, True), BR.initial(True, False))
+
+
+def test_settings():
+    assert BR.settings({}) == BR.Settings(False, 64)
+    assert BR.settings({"TF_DSV41_BRANCHES": "1"}).on
+    assert BR.settings({"TF_DSV41_BRANCHES": "0", "TF_DSV41_BRANCHES_ROWS": "16"}) == BR.Settings(False, 16)
+    for bad in ({"TF_DSV41_BRANCHES": "2"}, {"TF_DSV41_BRANCHES_ROWS": "0"}):
+        with pytest.raises(ValueError):
+            BR.settings(bad)
+
+
+class Fake:
+    def __init__(self):
+        self.log = []
+
+    def fork(self):
+        self.log.append(("fork",))
+
+    def join(self):
+        self.log.append(("join",))
+
+    def on(self, where):
+        from contextlib import nullcontext
+
+        self.log.append(where)
+        return nullcontext()
+
+
+@pytest.mark.parametrize("kind", KINDS)
+def test_run_issues_the_plan(kind):
+    steps = BR.plan(*kind)
+    done, drv = [], Fake()
+    BR.run(steps, {s[1]: (lambda op=s[1]: done.append(op)) for s in steps if len(s) == 2}, drv)
+    assert done == [s[1] for s in steps if len(s) == 2]
+    assert drv.log == [s if len(s) == 1 else s[0] for s in steps]
+
+
+def test_off_by_default_and_on_cpu(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_BRANCHES", raising=False)
+    assert BR.build(object(), "cpu") is None
+    monkeypatch.setenv("TF_DSV41_BRANCHES", "1")
+    assert BR.build(object(), "cpu") is None                  # the CPU twin keeps the serial path
+
+
+# -- G14: e4 alone, explicit streams and priorities, joins on every path -----------------------------------------------
+SERIAL_ORDER = {
+    (False, False): ["xproj", "rms2", "wq_b", "l2pf_o", "rope_q", "kv_swa", "attn"],
+    (True, False): ["xproj", "rms2", "q", "l2pf_o", "rope_q", "rope_qi", "ix_wp", "kv_swa", "select", "attn"],
+    (True, True): ["xproj", "rms2", "q", "l2pf_o", "rope_q", "rope_qi", "ix_wp", "kv_swa", "compress", "select",
+                   "attn"],
+}
+
+
+@pytest.mark.parametrize("kind", KINDS)
+def test_serial_plans_are_safe_and_make_the_same_values(kind):
+    ix, comp, split = kind
+    steps = BR.plan_serial(ix, comp, split)
+    BR.check(steps, BR.initial(ix, comp))
+    assert all(len(s) == 2 and s[0] == "main" for s in steps)                       # no fork, no side op
+    # the same values as the side-stream plan: only the order and the streams differ
+    assert BR.values(steps) == BR.values(BR.plan(ix, comp, split))
+    ops = [s[1] for s in steps]
+    assert ("q" in ops) == (ix and not split) and ("ix_wq_b" in ops) == (ix and split)
+
+
+@pytest.mark.parametrize("key", sorted(SERIAL_ORDER))
+def test_serial_plan_is_blocks_attention_order(key):
+    # blocks.attention: x group, rms_pair, q group, the L2 prefetch mark, RoPE q (and qi), the head weights, then a
+    # segment's SWA store, compressor, selection and core
+    assert [s[1] for s in BR.plan_serial(*key, False)] == SERIAL_ORDER[key]
+
+
+def test_plans_are_pure():
+    for kind in KINDS:          # the plan is the layer kind's alone: no warm-up, capture or boot state reaches it
+        assert BR.plan(*kind) == BR.plan(*kind) and BR.plan_serial(*kind) == BR.plan_serial(*kind)
+
+
+def test_check_wants_the_output_on_main():
+    init = BR.initial(True, True)
+    good = list(BR.plan(True, True, True))
+    _bad(good[:-1], init, r"without \['o'\] on main")                                # no attention core
+    _bad([s for s in BR.plan_serial(True, True, False) if s[1] != "attn"], init, "without")
+    BR.check(good[:-1], init, want=())                                              # the check is the want's
+
+
+def test_settings_g14():
+    assert BR.settings({}).mode == "off" and BR.settings({}).prio == "main"
+    s = BR.settings({"TF_DSV41_BRANCHES": "1"})
+    assert s.on and not s.serial and s.mode == "streams"
+    for raw in ("serial", "e4", " SERIAL "):
+        s = BR.settings({"TF_DSV41_BRANCHES": raw})
+        assert s.on and s.serial and s.mode == "serial"
+    for p in BR.PRIOS:
+        assert BR.settings({"TF_DSV41_BRANCHES": "1", "TF_DSV41_BRANCHES_PRIO": p}).prio == p
+    for bad in ({"TF_DSV41_BRANCHES_PRIO": "high"}, {"TF_DSV41_BRANCHES": "side"}):
+        with pytest.raises(ValueError):
+            BR.settings(bad)
+
+
+def test_priorities():
+    assert BR.priorities("main") == (BR.HIGH, 0)        # main high, side at CUDA's lowest (the default 0)
+    assert BR.priorities("side") == (0, BR.HIGH)
+    assert BR.priorities("equal") == (0, 0)             # G13's
+    assert BR.HIGH < 0
+    with pytest.raises(ValueError):
+        BR.priorities("low")
+
+
+class S:
+    """A stream stand-in: records the streams it waited for."""
+
+    def __init__(self, name):
+        self.name, self.waits, self.priority = name, [], 0
+
+    def wait_stream(self, other):
+        self.waits.append(other.name)
+
+
+def _driver(monkeypatch, cur):
+    d = BR.Driver.__new__(BR.Driver)                    # no CUDA here: the driver's logic on stand-in streams
+    d.prio, d.main, d.side, d.at, d.forks, d.joins, d.dedicated = "main", S("main"), S("side"), None, 0, 0, True
+    monkeypatch.setattr(BR.torch.cuda, "current_stream", lambda: cur[0])
+    return d
+
+
+def test_driver_forks_and_joins_on_one_stream(monkeypatch):
+    cur = [None]
+    d = _driver(monkeypatch, cur)
+    cur[0] = d.main
+    d.fork()
+    d.fork()                                            # an index layer's second fork, from the same stream
+    d.join()
+    assert d.side.waits == ["main", "main"] and d.main.waits == ["side"] and d.at is None
+    assert (d.forks, d.joins) == (2, 1)
+    assert d.describe().startswith("streams (dedicated), priority main")
+    with pytest.raises(RuntimeError, match="without an open fork"):
+        d.join()
+    d.fork()
+    cur[0] = S("other")                                 # a stream switch inside the plan
+    with pytest.raises(RuntimeError, match="another stream"):
+        d.join()
+    with pytest.raises(RuntimeError, match="another stream"):
+        d.fork()
+
+
+def test_run_joins_after_an_exception(monkeypatch):
+    cur = [None]
+    d = _driver(monkeypatch, cur)
+    cur[0] = d.main
+    steps = BR.plan(True, True, True)
+
+    def boom():
+        raise KeyError("compress")
+
+    impl = {s[1]: (lambda: None) for s in steps if len(s) == 2}
+    impl["compress"] = boom
+    monkeypatch.setattr(BR.torch.cuda, "stream", lambda s: __import__("contextlib").nullcontext())
+    with pytest.raises(KeyError):
+        BR.run(steps, impl, d)
+    assert d.at is None and d.main.waits == ["side"]   # the open fork was joined back to main
+    d.abort()                                           # nothing open: nothing to do
+    assert d.main.waits == ["side"]
+    BR.run(steps, {s[1]: (lambda: None) for s in steps if len(s) == 2}, d)        # the driver is usable again
+    assert d.at is None and d.joins == 1 and d.main.waits == ["side", "side"]
+
+
+def test_serial_driver_refuses_streams():
+    BR.run(BR.plan_serial(True, True, False), {k: (lambda: None) for k in BR.READS}, BR.SERIAL)
+    for steps in (BR.plan(True, True, True), BR.plan(False, False, False)):
+        with pytest.raises(RuntimeError, match="serial plan"):
+            BR.run(steps, {k: (lambda: None) for k in BR.READS}, BR.SERIAL)
+
+
+def test_capture_stream(monkeypatch):
+    class Blk:
+        def __init__(self, branch):
+            self.branch = branch
+
+    class Fw:
+        def __init__(self, *branches):
+            self.blocks = [Blk(b) for b in branches]
+
+    d = _driver(monkeypatch, [None])
+    assert BR.capture_stream(Fw(None, BR.Branch(d, 64), None)) is d.main
+    assert BR.capture_stream(Fw(None, BR.Branch(BR.SERIAL, 64))) is None       # serial: nothing forks
+    assert BR.capture_stream(Fw(None, None)) is None and BR.capture_stream(object()) is None
+
+
+def test_serial_off_on_cpu(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_BRANCHES", "serial")
+    assert BR.build(object(), "cpu") is None
+
+
+def test_streams_compare_by_handle():
+    class W:                                            # torch's wrappers: a new object each current_stream() call
+        def __init__(self, h):
+            self.cuda_stream = h
+
+    assert BR._same(W(7), W(7)) and not BR._same(W(7), W(8))
+    s = S("main")
+    assert BR._same(s, s) and not BR._same(s, S("main"))       # stand-ins without a handle: identity
