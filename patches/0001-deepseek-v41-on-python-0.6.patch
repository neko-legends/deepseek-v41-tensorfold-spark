+def test_env(monkeypatch):
+    monkeypatch.delenv("TF_DSV41_DEPTH_JOINT", raising=False)
+    assert J.env_on() is True and depth.Depth().joint is True
+    monkeypatch.setenv("TF_DSV41_DEPTH_JOINT", "0")
