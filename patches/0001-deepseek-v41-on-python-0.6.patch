@@ -0,0 +1,38 @@
+"""G18: the NVMe session tier's in-RAM index keeps (length, chain, tail), not the whole ids as a list[int]."""
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+from tensorfold.families.deepseek_v41.cuda.pool import PAGE
+from tensorfold.families.deepseek_v41.cuda.sessdisk import DiskEntry
+from tensorfold.families.deepseek_v41.cuda.sessions import chain, is_prefix
+
+
+def test_prefixes_matches_is_prefix():
+    rng = random.Random(18)
+    for _ in range(400):
+        n = rng.choice([0, 1, 7, PAGE - 1, PAGE, PAGE + 3, 3 * PAGE, 3 * PAGE + 200, 5 * PAGE + 17])
+        base = [rng.randrange(129280) for _ in range(n)]
+        extra = [rng.randrange(129280) for _ in range(rng.choice([0, 1, 50, PAGE + 9]))]
+        prompt = base + extra
+        if prompt and rng.random() < 0.3:                   # a mismatch inside the entry's span
+            k = rng.randrange(len(prompt))
+            prompt[k] = (prompt[k] + 1) % 129280
+        p_chain = chain(prompt)
+        e = DiskEntry.of("k", 3, base, "turn", 0, 0)
+        assert e.pos == n and len(e.tail) == n % PAGE and len(e.chain) == n // PAGE
+        assert not hasattr(e, "ids")
+        assert e.prefixes(prompt, p_chain) == is_prefix(base, chain(base), prompt, p_chain)
+
+
+def test_numpy_ids_index_like_lists():
+    """The boot scan hands int32 arrays (no tolist); the record must equal the one built from a list."""
+
+    ids = list(range(1000, 1000 + 2 * PAGE + 31))
+    a = DiskEntry.of("k", 1, ids, "prompt", 9, 2)
+    b = DiskEntry.of("k", 1, np.asarray(ids, dtype=np.int32), "prompt", 9, 2)
+    assert a == b
+    assert a.prefixes(ids + [5], chain(ids + [5]))
