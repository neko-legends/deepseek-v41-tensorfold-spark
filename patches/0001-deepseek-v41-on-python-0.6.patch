+def test_store_hold_release_gather():
+    st = V.Store()
+    a = V.Table([VP.VBASE + 1, VP.VBASE + 2], torch.tensor([[1.0, 1.0], [2.0, 2.0]], dtype=torch.bfloat16))
+    b = V.Table([VP.VBASE + 2, VP.VBASE + 3], torch.tensor([[2.0, 2.0], [3.0, 3.0]], dtype=torch.bfloat16))
+    ta, tb = st.hold(a), st.hold(b)
+    got = st.gather([VP.VBASE + 3, VP.VBASE + 1, VP.VBASE + 2], "cpu")
+    assert got[:, 0].tolist() == [3.0, 1.0, 2.0]
+    st.release(ta)                      # VBASE + 2 still held by b
+    assert st.gather([VP.VBASE + 2], "cpu")[0, 0] == 2.0
+    with pytest.raises(KeyError):
+        st.gather([VP.VBASE + 1], "cpu")
+    st.release(tb)
+    st.release(tb)
+    assert len(st) == 0 and st.hold(None) is None
