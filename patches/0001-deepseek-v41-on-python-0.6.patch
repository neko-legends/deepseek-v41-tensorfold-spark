index 0000000..fe455d6
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rmsnorm.py
@@ -0,0 +1,184 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``blocks.rms`` (the attention's q_norm / kv_norm, the drafter's norms) as one Triton launch in float64 (G7 decode).
+
+The torch form ``x.double(); x * rsqrt(x.square().mean(-1) + eps) * w.double()`` then ``.to(bf16)`` is 9 kernels a
+call on CUDA (widen x, pow, ``MeanOps<double>``, add, rsqrt, 2 muls, widen w, narrow): G4's nsys put ~87 such sets in
+a verify window, ~15-18 us each (~1.5 ms a window), every kernel launch-bound. Here one program a row does the same
+operations in the same precision:
+
+    ss  = sum_k x_k^2                 float64; a bf16 / fp16 value squared is exact in float64
+    r   = rsqrt(ss * (1 / K) + eps)    float64; torch's MeanOps projects with ``* (outputs / numel)`` = ``* fl(1 / K)``,
+                                       and its CUDA rsqrt is libdevice's ``__nv_rsqrt``, which this calls too
+    y   = (x * r) * w                  float64, the same two rounded products
+    out = bf16(fp32(y))                c10's double -> BFloat16 conversion goes through float: the same two roundings
+
+The one difference is the order of the float64 sum of squares: torch's reduction tree depends on the tensor's shape
+(rows included), this one on K alone (``BK`` lanes ascending, then ``tl.sum``'s fixed tree), so it is row-invariant
+by construction. The squares are exact and their sum is exact whenever a row's squares span less than ~2^37 (all
+but extreme rows); otherwise the two orders can differ in the last float64 bit, which moves the bf16 output only at
+a rounding tie within ~2^-44 of a value (``plain_fp64``'s argument). The interpreter tests find it bitwise.
+
+``TF_DSV41_RMS_TRITON`` (1 = on, the default; 0 = the torch form) selects it on CUDA; other devices keep torch.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+BK = 512
+LAUNCH = {"enable_fp_fusion": False}      # no FMA contraction: every product and sum rounded as torch rounds it
+
+_RSQRT = None
+if os.environ.get("TRITON_INTERPRET") != "1":   # libdevice's rsqrt (torch's CUDA rsqrt); the interpreter has none:
+    try:                                        # there 1 / sqrt, as torch's CPU form computes it
+        from triton.language.extra import libdevice as _ld
+
+        _RSQRT = _ld.rsqrt
+    except ImportError:                         # pragma: no cover - older Triton
+        _RSQRT = None
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_RMS_TRITON", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _rsqrt64(v):
+    return 1.0 / tl.sqrt(v)               # fp64: sqrt.rn.f64 and div.rn.f64, both correctly rounded
+
+
+_rsqrt = _RSQRT if _RSQRT is not None else _rsqrt64
+
+
+@triton.jit
+def _rms(X, x_rs, W, OUT, o_rs, K, inv_k, eps, BK: tl.constexpr, HAS_W: tl.constexpr, NARROW: tl.constexpr,
+         PDL: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, BK)
+    xr = X + r * x_rs
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        v = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += v * v
+    ss = tl.sum(acc, axis=0)
+    rn = _rsqrt(ss * inv_k + eps)
+    orow = OUT + r * o_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        y = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64) * rn
+        if HAS_W:
+            y = y * tl.load(W + c + k, mask=m, other=0.0).to(tl.float64)
+        if NARROW:
+            tl.store(orow + c + k, y.to(tl.float32).to(OUT.dtype.element_ty), mask=m)
+        else:
+            tl.store(orow + c + k, y.to(OUT.dtype.element_ty), mask=m)
+
+
+@triton.jit
+def _rms2(XA, xa_rs, WA, OA, oa_rs, KA, inv_ka, XB, xb_rs, WB, OB, ob_rs, KB, inv_kb, eps, BK: tl.constexpr,
+          NARROW: tl.constexpr, PDL: tl.constexpr = False):
+    """G9: two norms in one launch, program (row, which): ``_rms``'s program on (XA, WA, OA, KA) or (XB, ...)."""
+
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    if tl.program_id(1) == 0:
+        _rms_row(XA, xa_rs, WA, OA, oa_rs, KA, inv_ka, eps, BK, NARROW)
+    else:
+        _rms_row(XB, xb_rs, WB, OB, ob_rs, KB, inv_kb, eps, BK, NARROW)
+
+
+@triton.jit
+def _rms_row(X, x_rs, W, OUT, o_rs, K, inv_k, eps, BK: tl.constexpr, NARROW: tl.constexpr):
+    """``_rms``'s body with a weight (the same operations in the same order)."""
+
+    r = tl.program_id(0).to(tl.int64)
+    k = tl.arange(0, BK)
+    xr = X + r * x_rs
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        v = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += v * v
+    ss = tl.sum(acc, axis=0)
+    rn = _rsqrt(ss * inv_k + eps)
+    orow = OUT + r * o_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        y = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64) * rn
+        y = y * tl.load(W + c + k, mask=m, other=0.0).to(tl.float64)
+        if NARROW:
+            tl.store(orow + c + k, y.to(tl.float32).to(OUT.dtype.element_ty), mask=m)
+        else:
+            tl.store(orow + c + k, y.to(OUT.dtype.element_ty), mask=m)
+
+
+_IN = (torch.bfloat16, torch.float16, torch.float32)
+_OUT = (torch.bfloat16, torch.float16, torch.float32)
+
+
+def eligible(x: torch.Tensor, weight: torch.Tensor | None, dtype: torch.dtype) -> bool:
+    return (x.is_cuda and enabled() and x.dtype in _IN and dtype in _OUT and x.dim() >= 1 and x.shape[-1] > 0
+            and (weight is None or (weight.device == x.device and weight.dim() == 1
+                                    and weight.shape[0] == x.shape[-1] and weight.dtype in _IN + (torch.float64,))))
+
+
+def rms(x: torch.Tensor, weight: torch.Tensor | None, eps: float, dtype: torch.dtype) -> torch.Tensor:
+    """RMSNorm over the last dim in float64, rounded to ``dtype`` through fp32 (as torch's double -> bf16 does)."""
+
+    K = x.shape[-1]
+    x2 = x.reshape(-1, K)
+    if x2.stride(-1) != 1:
+        x2 = x2.contiguous()
+    w = weight
+    if w is not None and w.stride(0) != 1:
+        w = w.contiguous()
+    out = torch.empty((x2.shape[0], K), dtype=dtype, device=x.device)
+    if x2.shape[0]:
+        _rms[(x2.shape[0],)](x2, x2.stride(0), w if w is not None else x2, out, out.stride(0), K, 1.0 / K,
+                             float(eps), BK=BK, HAS_W=w is not None, NARROW=dtype != torch.float32,
+                             num_warps=4, **LAUNCH, **P.triton_kw())
+    return out.view(*x.shape[:-1], K)
+
+
+def pair_enabled() -> bool:
+    """``TF_DSV41_RMS_PAIR`` (1, the default): the attention's q_norm and kv_norm in one launch (``rms_pair``)."""
+
+    return (os.environ.get("TF_DSV41_RMS_PAIR", "1").strip() or "1") != "0"
+
+
+def rms_pair(xa: torch.Tensor, wa: torch.Tensor, xb: torch.Tensor, wb: torch.Tensor, eps: float,
+             dtype: torch.dtype) -> tuple[torch.Tensor, torch.Tensor]:
+    """``(rms(xa, wa), rms(xb, wb))`` [n, K] each, the same rows, in one launch (G9: 80 ``_rms`` launches a 1-row window
+    were 0.39 ms, the kv_norm's ~3 us mostly launch and latency). Each program is ``_rms``'s: the same bits."""
+
+    def prep(x, w):
+        x2 = x.reshape(-1, x.shape[-1])
+        return (x2 if x2.stride(-1) == 1 else x2.contiguous()), (w if w.stride(0) == 1 else w.contiguous())
+
+    (a, wa), (b, wb) = prep(xa, wa), prep(xb, wb)
+    if a.shape[0] != b.shape[0]:
+        raise ValueError("rms_pair: the same rows")
+    ka, kb = a.shape[1], b.shape[1]
+    oa = torch.empty((a.shape[0], ka), dtype=dtype, device=a.device)
+    ob = torch.empty((b.shape[0], kb), dtype=dtype, device=b.device)
+    if a.shape[0]:
+        _rms2[(a.shape[0], 2)](a, a.stride(0), wa, oa, oa.stride(0), ka, 1.0 / ka, b, b.stride(0), wb, ob,
+                               ob.stride(0), kb, 1.0 / kb, float(eps), BK=BK, NARROW=dtype != torch.float32,
+                               num_warps=4, **LAUNCH, **P.triton_kw())
+    return oa.view(*xa.shape[:-1], ka), ob.view(*xb.shape[:-1], kb)
+
+
+__all__ = ["BK", "eligible", "enabled", "pair_enabled", "rms", "rms_pair"]
