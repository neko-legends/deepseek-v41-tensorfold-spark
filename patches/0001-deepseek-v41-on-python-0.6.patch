@@ -0,0 +1,190 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Prefill performance paths on the GPU (window G5; collected only where PyTorch sees an NVIDIA GPU), on the
+synthetic DSpark checkpoint with the kernels' shapes (``dsv41_dspark_fakes``) and the compiled kernels:
+
+- big prefill segments (``TF_DSV41_PREFILL_CHUNK``): a 1,024-row segment (staging ring, attention row blocks, the
+  indexer in row blocks under a tiny budget) == 128-row segments == the verify path, logits and replies bit for bit;
+  the streaming top-k == the materialised selection;
+- the fast prefill tag (``TF_DSV41_PREFILL_KERNELS=fast``): row-independent (segments 1,024 / 256 / 96 equal, bit for
+  bit) with upstream's grouped routed experts, ``x3tc`` (``TF_DSV41_FAST_EXPERTS=tc``) and ``x3gm`` (gm); near exact;
+- ``x3tc``: the mul1 decode == upstream's ``format.unpack`` (inline PTX and plain), the routed experts vs float64,
+  rows independent, PTX == plain, the k-step settings agree;
+- ``prefill_mm``: column blocks == the whole GEMM, rows alone == in a segment;
+- CED replay on the compiled kernels: n <= 128 == full, chunked == unchunked.
+
+Run: python -m pytest -q tests/cuda/test_dsv41_prefill_gpu.py (one GPU).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_dspark_fakes as DF
+
+from tensorfold.cuda.exl3 import format as fmt
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+from tensorfold.families.deepseek_v41.cuda import x3tc
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack
+
+DEV = "cuda"
+PROMPT = [int(t) for t in np.random.default_rng(91).integers(3, 250, size=2301)]
+
+
+@pytest.fixture(autouse=True)
+def _torch_seams(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")       # the mHC / Engram kernels are laid out for D = 5,120
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41pfg"))
+
+
+def build(ck, pchunk: int, limit: int = 4096):
+    """``decode.DecodeForward`` on the compiled kernels with ``pchunk``-row prefill segments (env read now)."""
+
+    from tensorfold.families.deepseek_v41.cuda import drafter as DR
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+
+    root, cfg, table, _ = ck
+    tmap = DF.FK.token_map(cfg)
+    loader = W.Loader(cfg, W.Shards(root), 0, 1, DEV)
+    tree = loader.load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return DecodeForward(cfg, tree, csa2=Triton(128, cfg.num_attention_heads, DEV), limit=limit, chunk=128,
+                         pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=1,
+                         dspark=DR.load(loader), device=DEV)
+
+
+def prompt(fw, ids, mode: str = "full", cuts=(), budget=None, stream=0) -> torch.Tensor:
+    if budget is not None:
+        fw.csa2.index_budget = budget
+    fw.csa2.stream_min = stream
+    n, a = len(ids), 0
+    for b in list(cuts) + [n - 1]:
+        fw.prefill([Piece(0, a, tuple(ids[a:b]))], mode=mode)
+        a = b
+    fw.finish_prompt(0, n - 1, tuple(ids[max(0, n - 128):n - 1]), mode=mode)
+    out = [fw.step([ids[-1]])]
+    for t in (5, 6, 7):
+        out.append(fw.step([t]))
+    return torch.cat(out).float().cpu()
+
+
+# -- the exact path's big segments ------------------------------------------------------------------------------
+def test_big_segments_equal_small_ones(ck):
+    want = prompt(build(ck, 128), PROMPT)
+    fw = build(ck, 1024)
+    got = prompt(fw, PROMPT, budget=1 << 20)
+    assert fw.stage is not None and fw.stage[1] >= 1024 + 127
+    assert torch.equal(got, want)
+
+
+def test_stream_topk_prefill_equals_materialised(ck):
+    want = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(prompt(build(ck, 1024), PROMPT, stream=1), want)
+
+
+# -- the fast prefill tag -------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("experts", ["grouped", "tc", "gm"])
+def test_fast_prefill_row_independent_and_close(ck, monkeypatch, experts):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", experts)
+    want = prompt(build(ck, 1024), PROMPT)
+    assert torch.equal(prompt(build(ck, 256), PROMPT, cuts=(700,)), want)
+    assert torch.equal(prompt(build(ck, 96), PROMPT), want)
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "exact")
+    exact = prompt(build(ck, 1024), PROMPT)
+    assert not torch.equal(exact, want) and torch.isfinite(want).all()
+    rel = (exact - want).abs().amax(-1) / exact.abs().amax(-1)
+    print(f"[G5] fast ({experts}) vs exact logits: rel max {float(rel.max()):.3g}, argmax agree "
+          f"{float((exact.argmax(-1) == want.argmax(-1)).float().mean()):.2f}")
+
+
+# -- x3tc ---------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("bits", [2, 3, 4, 5])
+def test_x3tc_decode_is_upstreams_unpack(bits):
+    g = np.random.default_rng(bits)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(320, 72, 16 * bits), dtype=np.int64).astype(np.int16))
+    want = torch.from_numpy(fmt.unpack(t.numpy(), bits, "mul1")).view(torch.int16)
+    for asm in (True, False):
+        got = x3tc.decode(t.to(DEV), asm=asm).cpu().view(torch.int16)
+        assert torch.equal(got, want), asm
+
+
+def _stack(E, k, n, bits, seed):
+    g = np.random.default_rng(seed)
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(E, k // 16, n // 16, 16 * bits), dtype=np.int64)
+                         .astype(np.int16)).contiguous()
+    suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, (E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, (E, n))).astype(np.float16))
+    return X3Stack(t.to(DEV), suh.to(DEV), svh.to(DEV), "mul1")
+
+
+def test_x3tc_routed_on_the_gpu(monkeypatch):
+    E, D, I, S, R = 16, 512, 384, 6, 300
+    gate, up, down = _stack(E, D, I, 3, 1), _stack(E, D, I, 3, 2), _stack(E, I, D, 3, 3)
+    gen = torch.Generator().manual_seed(3)
+    x = (torch.randn(R, D, generator=gen) * 0.5).to(torch.bfloat16).to(DEV)
+    pick = torch.stack([torch.randperm(E, generator=gen)[:S] for _ in range(R)]).to(torch.int32).to(DEV)
+    w = (torch.rand(R, S, generator=gen) + 0.2).to(torch.float16).to(torch.float32).to(DEV)
+    got = x3tc.run(x, pick, w, gate, up, down, 10.0, rows=2048, asm=True)
+    assert torch.equal(got, x3tc.run(x, pick, w, gate, up, down, 10.0, rows=2048, asm=False))
+    assert torch.equal(got, x3tc.run(x, pick, w, gate, up, down, 10.0, rows=64, asm=True))
+    sub = [0, 7, 150, 299]
+    assert torch.equal(got[sub], x3tc.run(x[sub], pick[sub], w[sub], gate, up, down, 10.0, asm=True))
+    for cfg in ("1,2,8", "2,1,8", "4,1,8"):
+        monkeypatch.setenv("TF_DSV41_TC_CFG", cfg)
+        other = x3tc.run(x, pick, w, gate, up, down, 10.0, asm=True)
+        assert torch.allclose(other, got, rtol=0, atol=1e-3 * float(got.abs().max())), cfg
+    Wf = [[torch.from_numpy(fmt.dequantize(m.trellis[e].cpu().numpy(), m.suh[e].cpu().numpy(),
+                                           m.svh[e].cpu().numpy(), 3, "mul1")) for e in range(E)]
+          for m in (gate, up, down)]
+    xf, pk, wc = x.double().cpu(), pick.cpu(), w.double().cpu()
+    ref = torch.zeros(R, D, dtype=torch.float64)
+    for r in range(R):
+        for k in range(S):
+            e = int(pk[r, k])
+            gg = (xf[r] @ Wf[0][e]).clamp(max=10.0)
+            uu = (xf[r] @ Wf[1][e]).clamp(-10.0, 10.0)
+            ref[r] += float(wc[r, k]) * ((torch.nn.functional.silu(gg) * uu) @ Wf[2][e])
+    assert float((got.double().cpu() - ref).abs().max() / ref.abs().max()) < 3e-3
+
+
+# -- prefill_mm ---------------------------------------------------------------------------------------------------
+def test_prefill_gemm_column_blocks_and_rows():
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    g = np.random.default_rng(5)
+    K, N = 1280, 4096
+    t = torch.from_numpy(g.integers(-32768, 32768, size=(K // 16, N // 16, 64), dtype=np.int64).astype(np.int16))
+    suh = torch.from_numpy(g.choice([-1.0, 1.0], size=K).astype(np.float16))
+    svh = torch.from_numpy(g.uniform(0.001, 0.002, size=N).astype(np.float16))
+    lin = Exl3Linear.from_tensors(t, suh, svh, "mul1", device=DEV)
+    x = (torch.randn(700, K) * 0.3).to(torch.bfloat16).to(DEV)
+    whole = PM.matmul(lin, x, torch.float32)
+    parts = PM.column_blocks(lin, 1 << 20)
+    assert len(parts) > 1
+    assert torch.equal(PM.matmul(lin, x, torch.float32, parts), whole)
+    assert torch.equal(PM.matmul(lin, x[300:301], torch.float32), whole[300:301])
+    dec = lin(x[:64], out_dtype=torch.float32)               # the decode path's linear: the same layer, other sums
+    assert float((dec - whole[:64]).abs().max() / dec.abs().max()) < 1e-2
+
+
+# -- CED replay --------------------------------------------------------------------------------------------------
+def test_replay_on_the_gpu(ck):
+    short = PROMPT[:100]
+    assert torch.equal(prompt(build(ck, 1024), short, mode="replay"), prompt(build(ck, 1024), short, mode="full"))
+    want = prompt(build(ck, 1024), PROMPT, mode="replay")
+    assert torch.equal(prompt(build(ck, 256), PROMPT, mode="replay", cuts=(2250,)), want)
+    assert not torch.equal(want, prompt(build(ck, 1024), PROMPT, mode="full"))
