+    g = torch.Generator(device=DEV).manual_seed(E)
+    w = (torch.randn((E, 5120), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    b = (torch.randn(E, generator=g, device=DEV) * 0.1).float()
