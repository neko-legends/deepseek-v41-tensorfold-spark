@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``drafttrain`` (self-distillation of DSpark's heads from drafting logs) on synthetic passes, CPU only:
+
+- a target whose Markov interaction is w2 . (w1 + w1 M*) (M* unknown to the shipped heads): training recovers it,
+  held-out teacher-forced top-1 and the chain's tokens rise, and the folded tables reproduce the adapter exactly;
+- the context term (``ctx``) trains; the confidence refit moves toward the new chain's acceptance;
+- ``export`` -> ``drafter.heads_override`` (TF_DSV41_DSPARK_HEADS) replaces the heads, shapes checked.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("safetensors")
+
+from tensorfold.families.deepseek_v41.cuda import draftsim as DS  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import drafttrain as DT  # noqa: E402
+
+V, R, D, C, N = 400, 16, 32, 24, 5
+
+
+def _world(seed=0):
+    g = torch.Generator().manual_seed(seed)
+    w1 = (torch.randn(V, R, generator=g) * 0.6).to(torch.bfloat16)
+    w2 = (torch.randn(V, R, generator=g) * 0.6).to(torch.bfloat16)
+    M = torch.randn(R, R, generator=g) * 0.35
+    return w1, w2, M
+
+
+def _passes(w1, w2, M, n=600, seed=1, sessions=10):
+    rng = np.random.default_rng(seed)
+    w1t = w1.float() + w1.float() @ M
+    out = []
+    for k in range(n):
+        pend = int(rng.integers(V))
+        prev, serial, cands, bases = pend, [], [], []
+        hid = rng.normal(size=(N, D)).astype(np.float32)
+        for i in range(N):
+            ids = rng.choice(V, size=C, replace=False).astype(np.int32)
+            base = rng.normal(size=C).astype(np.float32) * 0.8
+            z = base + (w2.float()[torch.from_numpy(ids.astype(np.int64))] @ w1t[prev]).numpy()
+            z = z + rng.gumbel(size=C) * 0.3
+            t = int(ids[int(np.argmax(z))])
+            serial.append(t)
+            cands.append(ids)
+            bases.append(base)
+            prev = t
+        p = DS.Pass(0, 100 + k * 10, pend, serial[:], [0.5] * N, N, [], np.stack(cands), np.stack(bases),
+                    torch.from_numpy(hid).to(torch.bfloat16).view(torch.int16).numpy(), serial, None,
+                    session=k % sessions)
+        out.append(p)
+    return out
+
+
+def test_training_recovers_the_target_interaction():
+    w1, w2, M = _world()
+    passes = _passes(w1, w2, M)
+    x = DT.rows_of(passes, D)
+    assert len(x) == len(passes) * N and float((x.label >= 0).float().mean()) == 1.0
+    tr, te = DT.split(x, 0.2)
+    before = DT.evaluate(None, te, w1, w2)
+    model = DT.train(tr, w1, w2, D=D, epochs=30, lr=1e-2, wd=1e-4, batch=256, log=lambda *_: None)
+    after = DT.evaluate(model, te, w1, w2)
+    mb, ma = np.mean(before["top1_by_position"]), np.mean(after["top1_by_position"])
+    assert ma > mb + 0.05, (before, after)
+    # the folded tables are the adapter (ctx 0): the same logits
+    w1n, w2n = model.folded()
+    xb = te.take(torch.arange(64))
+    z_fold = xb.base + torch.einsum("rcd,rd->rc", w2n[xb.ids].float(), w1n[xb.prev].float())
+    assert torch.allclose(z_fold, model.z(xb), atol=0.08)
+    held = [p for p in passes if p.session in set(te.session.tolist())]
+    ch0 = DS.accept_stats(held, lambda p: DS.chain(p, w1, w2))
+    ch1 = DS.accept_stats(held, lambda p: DS.chain(p, w1n, w2n))
+    assert ch1["tokens_all_n"] > ch0["tokens_all_n"]
+
+
+def test_ctx_term_and_conf_refit():
+    w1, w2, M = _world(2)
+    passes = _passes(w1, w2, M, n=200, seed=3)
+    x = DT.rows_of(passes, D)
+    model = DT.train(x, w1, w2, D=D, ctx=4, epochs=3, lr=5e-3, batch=256, log=lambda *_: None)
+    assert model.ctx == 4 and model.z(x.take(torch.arange(8))).shape == (8, C)
+    cw = torch.zeros(D + R)
+    cwn = DT.refit_conf(model, x, w1, cw, steps=100)
+    y = (model.z(x).argmax(1) == x.label).float().mean()
+    f = torch.cat([x.hid.float(), model.folded()[0][x.prev].float()], 1)
+    pred = torch.sigmoid(f @ cwn).mean()
+    assert abs(float(pred) - float(y)) < 0.1 and cwn.shape == cw.shape
+
+
+def test_export_and_override(tmp_path):
+    from tensorfold.families.deepseek_v41.cuda.drafter import DraftW, heads_override
+
+    w1, w2, M = _world(4)
+    model = DT.Adapter(w1, w2, D)
+    with torch.no_grad():
+        model.M.copy_(M)
+    path = str(tmp_path / "heads.safetensors")
+    DT.export(path, model, torch.ones(D + R))
+    w = DraftW([], None, None, None, w1.clone(), w2.clone(), torch.zeros(D + R))
+    got = heads_override(w, path)
+    assert torch.equal(got.w1, model.folded()[0]) and torch.equal(got.conf, torch.ones(D + R))
+    assert torch.equal(got.w2, model.folded()[1].to(torch.float16).to(torch.bfloat16))
+    bad = DraftW([], None, None, None, torch.zeros(V + 1, R, dtype=torch.bfloat16), w2.clone(), None)
+    with pytest.raises(ValueError):
+        heads_override(bad, path)
+    assert heads_override(w, "") is w
