+                  "TF_DSV41_DRAFT_EXPERT_MIN_W": "0.1"})
+    assert c["target"] == PR.Rule(0.0, 0.9, 4, "orig") and c["prefill"] and c["draft"] == PR.Rule(0.1, 0.0, 2)
