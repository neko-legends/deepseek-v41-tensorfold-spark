+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G15 on the CPU: the expert map (``xmap.py`` / ``xmap.cu``, TF_DSV41_XMAP) and its trace collector.
+
+- the knobs parse (off by default; pregate needs a trace dir; bad values refuse);
+- the slab arithmetic is x3ld's first z step (K 5,120, rank width 1,152, SK 4 at 3 bits: 540 KiB) and the SK the map
+  uses is ``experts.configs_host``'s gate/up split;
+- ``select_host`` (votes desc, first appearance, ids outside [0, E) dropped, cap, budget, 16-byte multiples);
+- a thread-level emulator of ``select_ids`` (every thread's votes / first / rank, then thread 0's serial take, as the
+  kernel's statements) equals ``select_host`` on 2,000 random maps, pruned / shared / duplicate ids included;
+- the hooks: ``post`` forks after the router only, ``prev`` / ``both`` at the configured site only, rows over the cap
+  skip, records happen before the window closes, the end joins and advances, eager / replay notes stay in device order
+  and drain to npz + jsonl;
+- the forward's hooks are no-ops without ``xmap`` attributes (the default);
+- ``xmap.cu`` builds for sm_121 with no spills, and ``prefetch_kernel`` has no global store / atomic (reads and
+  ``cp.async.bulk.prefetch.L2`` only). Needs an nvcc that knows compute_121 (TF_NVCC, PATH or CUDA_HOME).
+
+The GPU half: ``tests/cuda/test_dsv41_g15_xmap_gpu.py``.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import random
+import types
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import xmap as XM  # noqa: E402
+
+K, N, SK, E = 5120, 1152, 4, 384
+
+
+# -- knobs ---------------------------------------------------------------------------------------------------------------
+def test_settings_default_off_and_parse():
+    s = XM.settings({})
+    assert s.mode is None and not s.prefetch and not s.records and s.trace == ""
+    s = XM.settings({XM.ENV: "post"})
+    assert (s.mode, s.kb, s.mb, s.rows, s.site, s.gbps, s.chunk_kb) == ("post", 0, 4.0, 16, "b", 0.0, 32)
+    assert s.prefetch and not s.records
+    s = XM.settings({XM.ENV: "both", XM.ENV + "_SITE": "f", XM.ENV + "_MB": "6", XM.ENV + "_KB": "256",
+                     XM.ENV + "_GBPS": "150", XM.ENV + "_ROWS": "8"})
+    assert (s.mode, s.site, s.mb, s.kb, s.gbps, s.rows) == ("both", "f", 6.0, 256, 150.0, 8) and s.records
+    s = XM.settings({XM.ENV + "_TRACE": "/tmp/x", XM.ENV + "_TRACE_PREGATE": "1"})
+    assert s.mode is None and s.records and s.pregate and s.ring == 256
+    for bad in ({XM.ENV: "next"}, {XM.ENV: "post", XM.ENV + "_SITE": "o"}, {XM.ENV: "post", XM.ENV + "_ROWS": "19"},
+                {XM.ENV: "post", XM.ENV + "_MB": "13"}, {XM.ENV + "_TRACE_PREGATE": "1"}):
+        with pytest.raises(ValueError):
+            XM.settings(bad)
+
+
+# -- arithmetic ------------------------------------------------------------------------------------------------------
+def test_slab_is_x3ld_first_z_step():
+    (_, _, sk, _), _ = X.configs_host(X.MODEL)
+    assert sk == SK
+    assert XM.slab_bytes(K, N, sk, 6) == 552_960                        # 3 bits: 80 k-tile rows x 72 x 96 B
+    assert XM.slab_bytes(K, N, sk, 4) == 368_640                        # 2 bits (layers 18-22)
+    plan = X.LayerPlan(X.MODEL, {X.GATE: [6] * 385, X.UP: [6] * 385, X.DOWN: [6] * 385})
+    gate_rank = plan.entry_bytes(0) // 3                                 # one matrix of the triple
+    assert XM.slab_bytes(K, N, sk, 6) * sk == gate_rank
+
+
+def test_select_host_order_dedup_budget():
+    k2 = [6] * (E + 1)
+    slab = XM.slab_bytes(K, N, SK, 6)
+    ids = [[5, 9, 7, 1, 2, 3, E], [9, 5, 11, 12, 13, 14, E], [9, 20, E + 1, E + 1, 21, 22, E]]   # E: shared; E+1: pruned
+    got = XM.select_host(ids, E, k2, K, N, SK, 0, 64 << 20)
+    assert [e for e, _ in got[:2]] == [9, 5] and all(b == slab for _, b in got)    # 9: 3 votes, 5: 2, then by position
+    assert [e for e, _ in got[2:]] == [7, 1, 2, 3, 11, 12, 13, 14, 20, 21, 22]
+    got = XM.select_host(ids, E, k2, K, N, SK, 100_000, 64 << 20)
+    assert all(b == 100_000 & ~15 for _, b in got)
+    got = XM.select_host(ids, E, k2, K, N, SK, 0, 2 * slab + 1000)
+    assert got == [(9, slab), (5, slab), (7, 1000 & ~15)]
+    assert XM.select_host([[E, E + 1]], E, k2, K, N, SK, 0, 1 << 20) == []
+    assert XM.select_host([[1] * 7] * 19, E, k2, K, N, SK, 0, 1 << 20) == []      # > 128 ids: the kernel refuses
+
+
+def _emulate_kernel(ids, E, k2, K, N, SK, cap, budget):
+    """xmap.cu select_ids, thread by thread (THREADS = 128, one CTA)."""
+
+    flat = [int(v) for row in ids for v in row]
+    P = len(flat)
+    if P <= 0 or P > XM.MAXP:
+        return []
+    ids_sh = [v if 0 <= v < E else -1 for v in flat]
+    votes_sh = [0] * XM.MAXP
+    firsts, my_votes = {}, {}
+    for t in range(128):                                  # phase 1: first / votes
+        me = ids_sh[t] if t < P else -1
+        first = votes = 0
+        if me >= 0:
+            first = 1
+            for u in range(P):
+                if ids_sh[u] == me:
+                    votes += 1
+                    if u < t:
+                        first = 0
+        firsts[t], my_votes[t] = first, votes
+        if t < XM.MAXP:
+            votes_sh[t] = votes if first else 0
+    rank_sh = [None] * XM.MAXP
+    for t in range(128):                                  # phase 2: ranks
+        if firsts[t]:
+            votes = my_votes[t]
+            r = 0
+            for u in range(P):
+                vu = votes_sh[u]
+                if vu > votes or (vu == votes and vu > 0 and u < t):
+                    r += 1
+            assert rank_sh[r] is None, "two distinct ids took one rank"
+            rank_sh[r] = t
+    out, used = [], 0                                     # phase 3: thread 0
+    distinct = sum(1 for q in range(P) if votes_sh[q] > 0)
+    for r in range(distinct):
+        if used >= budget:
+            break
+        e = ids_sh[rank_sh[r]]
+        take = (K >> 4) // SK * (N >> 4) * 16 * k2[e]
+        if cap > 0 and take > cap:
+            take = cap
+        if take > budget - used:
+            take = budget - used
+        take &= ~15
+        if take == 0:
+            break
+        out.append((e, take))
+        used += take
+    return out
+
+
+def test_kernel_selection_emulator_equals_host():
+    rng = random.Random(15)
+    for _ in range(2000):
+        R = rng.randint(1, 16)
+        hot = rng.sample(range(E), rng.randint(1, 40))
+        ids = []
+        for _r in range(R):
+            row = [rng.choice(hot) if rng.random() < 0.7 else rng.randrange(E) for _ in range(6)]
+            for j in range(6):
+                if rng.random() < 0.15:
+                    row[j] = E + 1                                   # a pruned slot
+            ids.append(row + [E])
+        k2 = [rng.choice((4, 6)) for _ in range(E + 1)]
+        cap = rng.choice((0, 0, 65536, 300_000))
+        budget = rng.choice((1 << 20, 4 << 20, 12 << 20, 777_777))
+        assert _emulate_kernel(ids, E, k2, K, N, SK, cap, budget) == XM.select_host(ids, E, k2, K, N, SK, cap, budget)
+
+
+def test_pace_ns():
+    assert XM.pace_ns(32 * 1024, 0) == 0 and XM.pace_ns(32 * 1024, 128) == 256
+
+
+# -- hooks, with a fake extension ------------------------------------------------------------------------------------
+class FakeExt:
+    def __init__(self):
+        self.calls = []
+
+    def prefetch_now(self, pick, *a):
+        self.calls.append(("now", int(pick.shape[0])))
+
+    def prefetch_prev(self, ring, ctr, hdr, layer, *a):
+        self.calls.append(("prev", int(layer)))
+
+    def record(self, src, ring, ctr, layer):
+        slot = int(ctr[0]) % ring.shape[0]
+        ring[slot, layer, :src.shape[0], :src.shape[1]] = src
+        self.calls.append(("rec", int(layer)))
+
+    def advance(self, ctr, hdr, rows):
+        hdr[int(ctr[0]) % hdr.shape[0]] = rows
+        ctr[0] += 1
+        self.calls.append(("adv", int(rows)))
+
+
+def _xmap(env: dict, layers: int = 3, tmp=None):
+    xm = object.__new__(XM.XMap)
+    xm.torch, xm.s, xm.device = torch, XM.settings(env), "cpu"
+    xm.stats, xm.ext, xm.layers = XM.Stats(), FakeExt(), {}
+    moes = [types.SimpleNamespace(name=f"m{i}") for i in range(layers)]
+    for i, m in enumerate(moes):
+        xm.layers[id(m)] = XM.Layer(i, types.SimpleNamespace(gate_ptr=None, gate_k2=None), E, K, N, SK)
+    xm.by_index = {L.index: L for L in xm.layers.values()}
+    xm.slots, xm.topk = XM.SLOTS, XM.TOPK
+    xm.nlayers, xm.budget, xm.cap, xm.chunk, xm.ns = layers, 4 << 20, 0, 32768, 0
+    xm.W = xm.s.ring if xm.s.trace else 2
+    if xm.s.records:
+        xm.ring = torch.full((xm.W, layers, xm.s.rows, xm.slots), -1, dtype=torch.int32)
+        xm.ctr = torch.zeros((1,), dtype=torch.int64)
+        xm.hdr = torch.zeros((xm.W,), dtype=torch.int32)
+    xm.meta, xm.done, xm.rank, xm.segs, xm.prefill = [], 0, 0, None, False
+    xm.pending, xm._cap = False, False
+    forks = []
+    xm._fork = lambda: (forks.append(1), contextlib.nullcontext())[1]
+    xm.join = lambda: None
+    blks = [types.SimpleNamespace(moe=m, xmap=xm) for m in moes]
+    return xm, moes, blks, forks
+
+
+def _pick(R, seed=0):
+    g = torch.Generator().manual_seed(seed)
+    p = torch.randint(0, E, (R, XM.SLOTS), generator=g, dtype=torch.int32)
+    p[:, -1] = E
+    return p
+
+
+def test_post_forks_after_the_router_only():
+    xm, moes, blks, forks = _xmap({XM.ENV: "post"})
+    xm.picked(moes[0], _pick(4), 4)
+    xm.site(blks[0], "b", 4)
+    xm.routed(moes[0], None, _pick(4), 4)                  # post records nothing (no ring)
+    xm.picked(moes[1], _pick(17), 17)                      # over TF_DSV41_XMAP_ROWS
+    xm.end(4)
+    assert xm.ext.calls == [("now", 4)] and len(forks) == 1 and xm.stats.skipped_rows == 1
+
+
+@pytest.mark.parametrize("mode", ["prev", "both"])
+def test_prev_reads_last_window_at_its_site(mode):
+    xm, moes, blks, forks = _xmap({XM.ENV: mode, XM.ENV + "_SITE": "b"})
+    xm.site(blks[1], "f", 2)                               # not the configured site
+    xm.site(blks[1], "b", 2)
+    p = _pick(2, 3)
+    xm.picked(moes[1], p, 2)
+    xm.routed(moes[1], None, p, 2)
+    xm.end(2)
+    kinds = [c[0] for c in xm.ext.calls]
+    want = ["prev", "now", "rec", "adv"] if mode == "both" else ["prev", "rec", "adv"]
+    assert kinds == want and xm.ext.calls[0] == ("prev", 1)
+    assert torch.equal(xm.ring[0, 1, :2], p) and int(xm.hdr[0]) == 2 and int(xm.ctr[0]) == 1
+    xm.end(17)                                             # a wide window is not a window of the map
+    assert int(xm.ctr[0]) == 1
+
+
+def test_trace_notes_drain_in_order(tmp_path, monkeypatch):
+    xm, moes, blks, _ = _xmap({XM.ENV + "_TRACE": str(tmp_path), XM.ENV + "_TRACE_W": "8"})
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+    monkeypatch.setattr(torch.cuda, "synchronize", lambda *a: None)
+    picks = []
+    for w in range(6):
+        R = 1 + w % 3
+        xm.segs = [types.SimpleNamespace(slot=w % 2, start=100 + w, ids=list(range(R)))]
+        for L, m in enumerate(moes):
+            p = _pick(R, 10 * w + L)
+            xm.routed(m, None, p, R)
+            picks.append(p)
+        if w % 2:
+            xm.end(R)                                      # eager: noted at the end
+        else:
+            monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: True)
+            xm.end(R)                                      # "replay": the graph runner notes it
+            monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+            xm.note(xm.segs, R, "replay")
+    xm.drain()
+    files = sorted(tmp_path.glob("*.npz"))
+    assert len(files) == 2                                 # W / 2 = 4 notes, then the rest
+    seq, rows, got = [], [], []
+    for f in files:
+        z = np.load(f)
+        seq += list(z["seq"])
+        rows += list(z["rows"])
+        meta = [json.loads(x) for x in f.with_suffix(".jsonl").read_text().splitlines()]
+        assert [m["seq"] for m in meta] == list(z["seq"])
+        for i in range(len(z["seq"])):
+            for L in range(3):
+                got.append(z["picks"][i, L, :z["rows"][i]])
+    assert seq == list(range(6)) and rows == [1, 2, 3, 1, 2, 3]
+    assert all(np.array_equal(g, p.numpy()) for g, p in zip(got, picks))
+    kinds = [json.loads(x)["kind"] for f in files for x in f.with_suffix(".jsonl").read_text().splitlines()]
+    assert kinds == ["replay", "eager"] * 3
+
+
+def test_forward_hooks_are_noops_without_a_map():
+    blk = types.SimpleNamespace()
+    fw = types.SimpleNamespace()
+    XM.site(blk, "b", 1)
+    XM.attn_input(blk, None, 1)
+    XM.end(fw, 1)
+    XM.begin(fw, [])
+    XM.replayed(fw, [], 1)
+
+
+def test_moe_hook_sites_in_source():
+    """The MoE hooks sit where the map needs them: ``picked`` right after the router (both router paths), ``routed``
+    after pruning (the ids x3ld reads) and after the fused chain."""
+
+    from pathlib import Path
+
+    from tensorfold.families.deepseek_v41.cuda import moe
+
+    src = Path(moe.__file__).read_text()
+    a = src.index("router.route_fold(")
+    assert src.index("xm.picked(self, pick, R)", a) < src.index("PR.apply(pick, wts", a)
+    b = src.index("pick, wts = router.route(x, self.gate")
+    assert b < src.index("xm.picked(self, pick, R)", b) < src.index("PR.apply(pick, wts", b)
+    c = src.index("PR.apply(pick, wts")
+    assert c < src.index("xm.routed(self, x, pick, R)", c) < src.index("P.kit_weights(wts)", c)
+
+
+# -- xmap.cu for sm_121 -------------------------------------------------------------------------------------------------
+def _nvcc():
+    import os
+    import shutil
+    import subprocess
+
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                if "compute_121" in subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True,
+                                                   timeout=60).stdout:
+                    return cand
+            except (OSError, subprocess.SubprocessError):
+                continue
+    return None
+
+
+def test_xmap_builds_for_sm121_no_spills_prefetch_read_only(tmp_path):
+    import re
+    import subprocess
+    from pathlib import Path
+
+    nvcc = _nvcc()
+    if nvcc is None:
+        pytest.skip("no nvcc with compute_121 (TF_NVCC)")
+    cu = Path(XM.__file__).with_name("xmap.cu")
+    r = subprocess.run([nvcc, "-arch=sm_121", "-O3", "-cubin", "-Xptxas", "-v", "-o", str(tmp_path / "k.cubin"),
+                        str(cu)], capture_output=True, text=True, timeout=600)
+    assert r.returncode == 0, r.stderr[-2000:]
+    stats = re.findall(r"(\d+) bytes spill stores, (\d+) bytes spill loads", r.stderr)
+    assert len(stats) == 3 and all(a == "0" and b == "0" for a, b in stats), r.stderr
+    p = subprocess.run([nvcc, "-arch=sm_121", "-O3", "-ptx", "-o", str(tmp_path / "k.ptx"), str(cu)],
+                       capture_output=True, text=True, timeout=600)
+    assert p.returncode == 0, p.stderr[-2000:]
+    ptx = (tmp_path / "k.ptx").read_text()
+    entries = dict(re.findall(r"\.entry\s+(\w+)\((.*?)\n\}\n", ptx, re.S))
+    pf = next(v for k, v in entries.items() if "prefetch_kernel" in k)
+    assert "cp.async.bulk.prefetch.L2.global" in pf and "%globaltimer" in pf
+    assert not re.search(r"\b(st\.global|st\.(?!shared)[a-z]|atom\.|red\.)", pf)         # no global writes
+    rec = next(v for k, v in entries.items() if "record_kernel" in k)
+    assert "st.global" in rec and "prefetch" not in rec
