+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DeepSeek-V4.1-Flash's prepared per-rank folders on the CPU: a folder read back gives the tree it stored, bit for
+bit (and the same logits), the key changes with the checkpoint, the rank and the building code, a damaged chunk
+fails the read, and ``cached_tree`` falls back to building when a folder is missing or unusable."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import fastboot as FB  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41f"))
+    return root, Config.from_dict(json.loads((root / "config.json").read_text()))
+
+
+def tensors(x, out=None):
+    out = [] if out is None else out
+    if isinstance(x, torch.Tensor):
+        out.append(x)
+    elif isinstance(x, (list, tuple)):
+        for v in x:
+            tensors(v, out)
+    elif hasattr(x, "__dataclass_fields__"):
+        for v in vars(x).values():
+            tensors(v, out)
+    return out
+
+
+def logits(cfg, tree, ids):
+    table = FK.engram_table(cfg)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), limit=32, chunk=16,
+                    engram_rows=rows, hasher=EH.NgramHasher(cfg, FK.token_map(cfg)))
+    return fw.step(ids)
+
+
+def test_round_trip_bit_for_bit(ckpt, tmp_path):
+    root, cfg = ckpt
+    tree = W.Loader(cfg, W.Shards(root), 1, 2).load(token_map=FK.token_map(cfg))
+    key = FB.weights_key(root, 1, 2, device="cpu")
+    d = FB.folder(tmp_path, key)
+    FB.save(tree, d, key)
+    assert FB.valid(d, key) == (True, "ok")
+    back, st = FB.read(d, "cpu", threads=3)
+    a, b = tensors(tree), tensors(back)
+    assert len(a) == len(b) and st["chunks"] >= 1
+    for x, y in zip(a, b):
+        assert x.dtype == y.dtype and x.shape == y.shape and torch.equal(x.view(-1).view(torch.uint8),
+                                                                         y.reshape(-1).view(torch.uint8))
+    assert type(back) is W.RankW and back.layers[2].attn.comp_wgate is not None
+    tree2 = W.Loader(cfg, W.Shards(root), 1, 2).load(token_map=FK.token_map(cfg))
+    assert back.nbytes() == tree2.nbytes()
+
+
+def test_folder_logits_equal_checkpoint_logits(ckpt, tmp_path):
+    root, cfg = ckpt
+    key = FB.weights_key(root, 0, 1, device="cpu")
+    d = FB.folder(tmp_path, key)
+    FB.save(W.Loader(cfg, W.Shards(root), 0, 1).load(), d, key)
+    ids = [5, 7, 9, 11, 200, 3]
+    want = logits(cfg, W.Loader(cfg, W.Shards(root), 0, 1).load(), ids)
+    got = logits(cfg, FB.read(d, "cpu")[0], ids)
+    assert torch.equal(got, want)
+
+
+def test_keys(ckpt, tmp_path):
+    root, cfg = ckpt
+    k0 = FB.weights_key(root, 0, 2, device="cpu")
+    assert FB.digest(k0) != FB.digest(FB.weights_key(root, 1, 2, device="cpu"))
+    assert FB.digest(k0) == FB.digest(FB.weights_key(root, 0, 2, device="cpu"))
+    assert FB.digest(k0) != FB.digest(FB.weights_key(root, 0, 2, device="cpu", extra={"token_map": "x"}))
+    other = tmp_path / root.name
+    other.mkdir()
+    for f in root.iterdir():
+        if f.is_file():
+            (other / f.name).write_bytes(f.read_bytes())
+    cfg_raw = json.loads((other / "config.json").read_text())
+    (other / "config.json").write_text(json.dumps({**cfg_raw, "rms_norm_eps": 1e-5}))
+    assert FB.weights_key(other, 0, 2, device="cpu")["files"] != k0["files"]
+    assert FB.model_rev("/x/models--org--name/snapshots/0123456789abcdef") == "org--name-0123456789ab"
+
+
+def test_damaged_chunk_and_fallbacks(ckpt, tmp_path, monkeypatch):
+    root, cfg = ckpt
+    key = FB.weights_key(root, 0, 1, device="cpu")
+    d = FB.folder(tmp_path, key)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load()
+    FB.save(tree, d, key)
+    with open(d / "data.bin", "r+b") as f:
+        f.seek(100)
+        b = f.read(1)
+        f.seek(100)
+        f.write(bytes([b[0] ^ 0xFF]))
+    monkeypatch.setenv("TF_DSV41_PREPARED_VERIFY", "full")
+    with pytest.raises(ValueError, match="checksum"):
+        FB.read(d, "cpu")
+    monkeypatch.setenv("TF_DSV41_PREPARED", str(tmp_path))
+    built = []
+    obj = FB.cached_tree("weights", key, lambda: built.append(1) or "built", "cpu")
+    assert obj == "built" and built == [1]                       # unusable folder: built from the checkpoint
+    other = FB.weights_key(root, 0, 1, device="cpu", extra={"token_map": "y"})
+    assert FB.valid(FB.folder(tmp_path, other), other)[1] == "no folder"
+    monkeypatch.setenv("TF_DSV41_PREPARED_WRITE", "1")
+    FB.cached_tree("weights", other, lambda: tree, "cpu")
+    assert FB.valid(FB.folder(tmp_path, other), other) == (True, "ok")
+    monkeypatch.setenv("TF_DSV41_PREPARED_VERIFY", "sample")
+    again = FB.cached_tree("weights", other, lambda: pytest.fail("read the folder"), "cpu")
+    assert type(again) is W.RankW
+
+
+def test_manifest_refuses_foreign_classes():
+    class Foreign:
+        pass
+
+    with pytest.raises(TypeError):
+        FB._Flat().enc(Foreign())
+    with pytest.raises(ValueError):
+        FB._find_class("os:system")
+
+
+def test_key_under_python_m_names_the_package(ckpt, tmp_path):
+    """``python -m ...fastboot`` (window G1's prepare) runs the module as __main__: its key must still name the
+    package's modules, so ``check`` finds the folder the engine's key names (G1's first prepare failed on
+    ``__main__.weights``)."""
+
+    import hashlib
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+
+    root, cfg = ckpt
+    tm = tmp_path / "tmap.json"
+    tm.write_text(json.dumps(list(FK.token_map(cfg))))
+    src = str(Path(FB.__file__).resolve().parents[4])
+    env = {**os.environ, "PYTHONPATH": src + os.pathsep + os.environ.get("PYTHONPATH", ""),
+           "TF_DSV41_TOKEN_MAP": str(tm)}
+    r = subprocess.run([sys.executable, "-m", "tensorfold.families.deepseek_v41.cuda.fastboot", "check", str(root),
+                        "--rank", "0", "--root", str(tmp_path / "prep")], capture_output=True, text=True, env=env)
+    assert r.returncode == 1, r.stderr[-2000:]
+    key = FB.weights_key(root, 0, 2, extra={"token_map": hashlib.sha256(tm.read_bytes()).hexdigest()[:16]})
+    assert r.stdout.split(":")[0] == str(FB.folder(tmp_path / "prep", key))
+
+
+def test_prune_keeps_the_other_kind(ckpt, tmp_path):
+    """The weights' and the drafter's folders share the model's root; writing one must not prune the other (G3: each
+    boot pruned the other's folder and rebuilt 101.8 GB from the checkpoint), while an older key of the same kind
+    goes."""
+
+    import time
+
+    root, cfg = ckpt
+    tree = W.Loader(cfg, W.Shards(root), 0, 2).load(token_map=FK.token_map(cfg))
+    k_old = FB.weights_key(root, 0, 2, device="cpu", extra={"token_map": "old"})
+    k_w = FB.weights_key(root, 0, 2, device="cpu")
+    k_d = {**k_w, "part": "dspark"}
+    paths = {}
+    for name, k in (("old", k_old), ("w", k_w), ("d", k_d)):
+        paths[name] = FB.folder(tmp_path, k)
+        FB.save(tree, paths[name], k)
+        time.sleep(0.01)
+    FB.prune(paths["w"])
+    assert not paths["old"].exists() and paths["w"].exists() and paths["d"].exists()
+    FB.prune(paths["d"])
+    assert paths["w"].exists() and paths["d"].exists()
