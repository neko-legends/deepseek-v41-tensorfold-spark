+++ b/src/tensorfold/families/deepseek_v41/cuda/mhc_cuda_emu.py
@@ -0,0 +1,248 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``mhc_cuda.cu``'s arithmetic in numpy, operation for operation (tests/test_dsv41_mhc_cuda_emu.py), and its work
+placement as data (which thread runs which chain, which stage holds which partial, which lanes own which row).
+
+Exact (fp32, one rounding an operation, nearest even): the rank sum and its bf16 rounding, the post, the collapse, the
+taps, every FMA chain (``fma32``: one rounding), the finish's row sums in (stream, block) order, rinv / rn
+(``div_rn`` / ``sqrt_rn``), the normed input. Modelled: ``ex2.approx.f32`` (``exp2`` rounded once) and
+``div.full.f32`` (rounded once) in the coefficients: the hardware's results are within ~2 ulp of these, so the
+coefficients are compared with a tolerance here and bit for bit against Triton on the GPU (the same instructions).
+The Sinkhorn's [4, 4] sums follow the kernel's butterfly: (a0 + a2) + (a1 + a3).
+
+Arrays: bf16 values are held as float32. ``x`` [R, 4 D], ``gathered`` [world, R, D], ``post`` / ``pre`` [R, 4],
+``comb`` [R, 16] (comb[i, j] at 4 i + j), ``fn`` [24, 4 D], ``base`` [24], ``scale`` [3], ``norm_w`` [D].
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+NB = 40
+NT = 128
+MAXR = 16
+NE = 4 * NB
+NQ = 7
+STAGE4 = 640
+F32 = np.float32
+LOG2E = np.array([0x3FB8AA3B], dtype=np.uint32).view(F32)[0]
+NLOG2E = np.array([0xBFB8AA3B], dtype=np.uint32).view(F32)[0]
+
+
+def bf16r(a) -> np.ndarray:
+    """fp32 -> the nearest bf16 (ties to even), held as fp32: cvt.rn.bf16.f32 (finite values)."""
+
+    u = np.ascontiguousarray(a, dtype=F32).view(np.uint32).astype(np.uint64)
+    r = ((u + 0x7FFF + ((u >> 16) & 1)) >> 16) << 16
+    return r.astype(np.uint32).view(F32)
+
+
+def fma32(a, b, c) -> np.ndarray:
+    """fp32 fma rounded once: the exact float64 product, the float64 sum rounded to odd, then to fp32."""
+
+    p = np.asarray(a, dtype=np.float64) * np.asarray(b, dtype=np.float64)
+    c = np.broadcast_to(np.asarray(c, dtype=np.float64), p.shape)
+    s = p + c
+    bb = s - p
+    err = (p - (s - bb)) + (c - bb)
+    even = (s.view(np.int64) & 1) == 0
+    fix = (err != 0) & even & np.isfinite(s)
+    if fix.any():
+        s = np.where(fix, np.nextafter(s, np.where(err > 0, np.inf, -np.inf)), s)
+    return s.astype(F32)
+
+
+def ex2(x) -> np.ndarray:                       # model of ex2.approx.f32
+    return np.exp2(np.asarray(x, dtype=np.float64)).astype(F32)
+
+
+def div_full(a, b) -> np.ndarray:               # model of div.full.f32
+    return (np.asarray(a, dtype=F32) / np.asarray(b, dtype=F32)).astype(F32)
+
+
+# -- placement ------------------------------------------------------------------------------------------------------
+def kinds(lead: bool, mix: bool) -> int:
+    """Chains a row in a CTA: 24 mixes + the stream's square sum (mix), + the collapsed row's (stream 0's CTA)."""
+
+    return (25 if mix else 0) + (1 if lead else 0)
+
+
+def chain_slots(R: int, lead: bool, mix: bool) -> list[list[tuple[int, int]]]:
+    """Per thread, its chains (row, kind) in slot order: chain c = t + s NT, row c // K, kind c % K (kind 25: the
+    collapsed row; without the mixes, every chain is kind 25)."""
+
+    K = kinds(lead, mix)
+    nch = R * K
+    ns = -(-nch // NT)
+    if ns > 4:
+        raise ValueError("more than 4 chains a thread")
+    out = []
+    for t in range(NT):
+        mine = []
+        for s in range(ns):
+            c = t + s * NT
+            if c < nch:
+                mine.append((c // K, c % K if mix else 25))
+        out.append(mine)
+    return out
+
+
+def chunk_entries(R: int) -> int:
+    return 80 if R <= 1 else 40 if R <= 2 else 20 if R <= 4 else 10 if R <= 9 else 5
+
+
+def stage_map(R: int) -> list[list[tuple[int, int, int]]]:
+    """Per finish chunk, the stage's float4 slots: slot i holds (row, entry, quad) of PART[row, entry, 4 quad:]."""
+
+    ch = chunk_entries(R)
+    out = []
+    for c in range(NE // ch):
+        out.append([(i // (ch * NQ), c * ch + (i % (ch * NQ)) // NQ, i % NQ) for i in range(R * ch * NQ)])
+    return out
+
+
+def coef_lanes(R: int) -> dict[int, tuple[int, int]]:
+    """Row -> (warp, first lane) of its 16 coefficient lanes (2 rows a warp a pass, rows r and r + 8)."""
+
+    f3w = min(4, (R + 1) // 2)
+    out = {}
+    for w in range(f3w):
+        for p in range(2):
+            if w * 2 + 8 * p >= R:
+                break
+            for half in range(2):
+                r = w * 2 + half + 8 * p
+                if r < R:
+                    out[r] = (w, 16 * half)
+    return out
+
+
+# -- arithmetic -----------------------------------------------------------------------------------------------------
+def _f(a) -> np.ndarray:
+    return np.ascontiguousarray(a, dtype=F32)
+
+
+def _rn(ssc: np.ndarray, d: int, eps) -> np.ndarray:
+    return (F32(1.0) / np.sqrt(ssc / F32(d) + F32(eps))).astype(F32)
+
+
+def phase_a(x, gathered, post, comb, pre, collapse: int) -> dict:
+    """The new streams (or the old ones without a post), the collapsed row, the taps: [R, 4, D] / [R, D]."""
+
+    x = _f(x)
+    R, d = x.shape[0], x.shape[1] // 4
+    xs = x.reshape(R, 4, d)
+    out = {}
+    if gathered is not None:
+        g = _f(gathered)
+        br = g[0].copy()
+        for w in range(1, g.shape[0]):
+            br = (br + g[w]).astype(F32)
+        br = bf16r(br)
+        cm, p = _f(comb).reshape(R, 4, 4), _f(post)
+        y = np.empty_like(xs)
+        for i in range(4):
+            c = [cm[:, k, i:i + 1] for k in range(4)]
+            m = ((c[0] * xs[:, 0] + c[1] * xs[:, 1]) + c[2] * xs[:, 2]) + c[3] * xs[:, 3]
+            y[:, i] = bf16r(p[:, i:i + 1] * br + m)
+        out["x"] = y.reshape(R, 4 * d)
+        out["tap"] = bf16r((((y[:, 0] + y[:, 1]) + y[:, 2]) + y[:, 3]) * F32(0.25))
+    else:
+        y = xs
+    if collapse == 2:
+        q = _f(pre)
+        out["c"] = bf16r(((q[:, 0:1] * y[:, 0] + q[:, 1:2] * y[:, 1]) + q[:, 2:3] * y[:, 2]) + q[:, 3:4] * y[:, 3])
+    else:
+        out["c"] = y[:, 0].copy()
+    out["y"] = y
+    return out
+
+
+def phase_b(y: np.ndarray, c: np.ndarray, fn, mix: bool) -> np.ndarray:
+    """PART [R, 4, NB, 32]: the chains of every CTA (column ascending from +0.0); unwritten entries 0."""
+
+    R, _, d = y.shape
+    cb = d // NB
+    part = np.zeros((R, 4, NB, 32), dtype=F32)
+    cv = c.reshape(R, NB, cb)
+    sc = np.zeros((R, NB), dtype=F32)
+    for k in range(cb):
+        sc = fma32(cv[:, :, k], cv[:, :, k], sc)
+    part[:, 0, :, 25] = sc
+    if mix:
+        v = y.reshape(R, 4, NB, cb)
+        w = np.moveaxis(_f(fn).reshape(24, 4, NB, cb), 0, -1)        # [4, NB, cb, 24]
+        acc = np.zeros((R, 4, NB, 24), dtype=F32)
+        sq = np.zeros((R, 4, NB), dtype=F32)
+        for k in range(cb):
+            acc = fma32(v[..., k, None], w[None, :, :, k, :], acc)
+            sq = fma32(v[..., k], v[..., k], sq)
+        part[..., :24] = acc
+        part[..., 24] = sq
+    return part
+
+
+def row_sums(part: np.ndarray, d: int, eps) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    """F1: (mixes [R, 24], the streams' square sum [R], rn [R]): each a sequential sum in (stream, block) order."""
+
+    R = part.shape[0]
+    p = part.reshape(R, NE, 32)
+    mix = np.zeros((R, 24), dtype=F32)
+    ss = np.zeros(R, dtype=F32)
+    ssc = np.zeros(R, dtype=F32)
+    for e in range(NE):
+        mix = (mix + p[:, e, :24]).astype(F32)
+        ss = (ss + p[:, e, 24]).astype(F32)
+        if e < NB:
+            ssc = (ssc + p[:, e, 25]).astype(F32)
+    return mix, ss, _rn(ssc, d, eps)
+
+
+def _rowsum(a):          # [.., 4, 4] over j: lanes xor 2 then xor 1
+    return ((a[..., 0] + a[..., 2]) + (a[..., 1] + a[..., 3]))[..., None]
+
+
+def _colsum(a):          # over i: lanes xor 8 then xor 4
+    return ((a[..., 0, :] + a[..., 2, :]) + (a[..., 1, :] + a[..., 3, :]))[..., None, :]
+
+
+def coefficients(mix, ss, base, scale, d: int, eps, hc_eps, post_alpha, iters: int):
+    """F3: pre, post [R, 4], comb [R, 16] with the kernel's order (ex2 / div.full modelled)."""
+
+    base, scale = _f(base), _f(scale)
+    hce, R = F32(hc_eps), mix.shape[0]
+    rinv = (F32(1.0) / np.sqrt(ss / F32(4.0 * d) + F32(eps))).astype(F32)
+    ms = (mix * rinv[:, None]).astype(F32)
+    pl = ms[:, 0:4] * scale[0] + base[0:4]
+    ql = ms[:, 4:8] * scale[1] + base[4:8]
+    pre = hce + div_full(F32(1.0), ex2(pl * NLOG2E) + F32(1.0))
+    post = F32(post_alpha) * div_full(F32(1.0), ex2(ql * NLOG2E) + F32(1.0))
+    cl = (ms[:, 8:24] * scale[2] + base[8:24]).reshape(R, 4, 4)
+    ce = ex2((cl - cl.max(axis=2, keepdims=True)) * LOG2E)
+    cm = hce + div_full(ce, _rowsum(ce))
+    cm = div_full(cm, hce + _colsum(cm))
+    for _ in range(iters - 1):
+        cm = div_full(cm, hce + _rowsum(cm))
+        cm = div_full(cm, hce + _colsum(cm))
+    return pre.astype(F32), post.astype(F32), cm.reshape(R, 16).astype(F32)
+
+
+def emulate(x, gathered, post, comb, pre, fn, base, scale, norm_w, *, collapse: int = 2, mix: bool = True,
+            eps: float = 1e-20, hc_eps: float = 1e-6, post_alpha: float = 2.0, iters: int = 20) -> dict:
+    """Every output of one launch: x (new streams, with a post), tap (with a post), c, part, out; with the mixes also
+    pre / post / comb. ``gathered`` None = a site (no post)."""
+
+    a = phase_a(x, gathered, post, comb, pre, collapse)
+    d = a["c"].shape[1]
+    part = phase_b(a["y"], a["c"], fn, mix)
+    msum, ss, rn = row_sums(part, d, eps)
+    out = {k: v for k, v in a.items() if k != "y"}
+    out["part"] = part
+    out["out"] = bf16r((a["c"] * rn[:, None]) * _f(norm_w)[None, :])
+    if mix:
+        out["pre"], out["post"], out["comb"] = coefficients(msum, ss, base, scale, d, eps, hc_eps, post_alpha, iters)
+    return out
+
+
+__all__ = ["bf16r", "chain_slots", "chunk_entries", "coef_lanes", "coefficients", "emulate", "fma32", "kinds",
+           "phase_a", "phase_b", "row_sums", "stage_map"]
