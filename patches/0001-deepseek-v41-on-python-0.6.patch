index 0000000..fc9fae2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/graphs.py
@@ -0,0 +1,97 @@
+"""CUDA graphs for GLM-5.3-Flash decode steps: one per (window rows, KDA state parity) for the model, one per row
+count for the MTP head. A captured step replays the eager kernels with their arguments (static buffers,
+positions read on the device), so its bits equal the eager step's; attention visits every chunk the cache
+can hold (empty chunks are skipped by the merge). Collectives (NCCL on the current stream) are captured too.
+
+patches/0050: past 2,051 tokens (every row of the window sparse) a step replays a graph per (rows, parity, pool
+bucket) for the model and per (rows, pool bucket) for the MTP head, captured the first time the key is met:
+that step runs eagerly through the same capturable code (``compute(..., npb=)``), which is the warm-up and the
+step's result (its writes are the replay's: uncommitted cache slots, the other KDA state buffer, static
+buffers), then the graph is captured for the next steps. Both ranks meet the same keys in the same order.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+import torch
+
+from . import profile
+from .forward import compute
+from .mtp import mtp_compute
+
+
+class Graphs:
+    def __init__(self, e, main_rows=(1, 2, 3, 4), mtp_rows=(1, 2, 3, 4), long_rows=()) -> None:
+        self.pool = torch.cuda.graph_pool_handle()
+        self.main: dict[tuple[int, int], torch.cuda.CUDAGraph] = {}
+        self.mtp: dict[int, torch.cuda.CUDAGraph] = {}
+        # patches/0420: with a trimmed draft vocabulary and its fallback rule, the whole-vocabulary MTP steps too
+        self.mtp_full: dict[int, torch.cuda.CUDAGraph] = {}
+        # patches/0050: long-context graphs, captured lazily; keys ("main", R, parity, npb) and ("mtp", n, npb)
+        self.long_rows = frozenset(long_rows)
+        self.long: dict[tuple, torch.cuda.CUDAGraph] = {}
+        self.long_max = int(os.environ.get("GLM53_TF_LONGCTX_MAX_GRAPHS", "256"))
+        w, st = e.w, e.st
+        # patches/0290: the warm-up / capture steps below write the window's rows at position 0 (and the head's at its
+        # length 0) without ``stage``: map those pages first (no-op without the KV pool)
+        from . import kvpool
+
+        kvpool.ensure(st, max((*main_rows, *mtp_rows, 1)) + max(st.pos, st.mtp_len))
+        saved = list(st.cur)
+        parities = (0, 1) if st.cur else (0,)
+        with torch.no_grad():
+            for R in main_rows:
+                for parity in parities:
+                    st.cur = [parity] * len(st.cur)
+                    for _ in range(2):
+                        compute(w, st, e.buf, R)
+                    torch.cuda.synchronize()
+                    g = torch.cuda.CUDAGraph()
+                    with torch.cuda.graph(g, pool=self.pool):
+                        compute(w, st, e.buf, R)
+                    self.main[(R, parity)] = g
+            st.cur = saved
+            if w.mtp is not None:
+                from . import draftvocab
+
+                dv = draftvocab.of(w)
+                heads = [(self.mtp, False)] + ([(self.mtp_full, True)] if dv is not None and dv.mtp and dv.fallback
+                                               else [])
+                e.mbuf.zero_first = False
+                for graphs, full in heads:
+                    for n in mtp_rows:
+                        for _ in range(2):
+                            mtp_compute(w, st, e.mbuf, n, full=full)
+                        torch.cuda.synchronize()
+                        g = torch.cuda.CUDAGraph()
+                        with torch.cuda.graph(g, pool=self.pool):
+                            mtp_compute(w, st, e.mbuf, n, full=full)
+                        graphs[n] = g
+        torch.cuda.synchronize()
+
+    def long_step(self, key: tuple, run) -> None:
+        """patches/0050: replay the long-context graph for ``key``; the first time, run the step eagerly (``run``,
+        the same capturable code) and capture it for the next ones. A failed capture turns the long graphs off
+        (the step's result is already in the buffers; later steps run eagerly, both ranks alike)."""
+
+        g = self.long.get(key)
+        if g is not None:
+            g.replay()
+            return
+        run()
+        if not self.long_rows or len(self.long) >= self.long_max or (profile.ON and profile.P.active):
+            return                           # (a profiled prefill's MTP absorb records timing events: no capture)
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        try:
+            with torch.cuda.graph(g, pool=self.pool, capture_error_mode="thread_local"):
+                run()
+        except Exception as exc:  # noqa: BLE001 - any capture failure: keep serving eagerly
+            self.long_rows = frozenset()
+            print(f"[tensorfold] long-context CUDA graph capture failed ({type(exc).__name__}: {exc}); "
+                  "decoding past 2,051 tokens eagerly", file=sys.stderr, flush=True)
+            torch.cuda.synchronize()
+            return
+        self.long[key] = g
diff --git a/src/tensorfold/families/glm5_next/spark/health.py b/src/tensorfold/families/glm5_next/spark/health.py
