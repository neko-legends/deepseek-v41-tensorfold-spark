+# -- x3seg.cu -------------------------------------------------------------------------------------------------------
+def _fn(src: str, sig: str) -> str:
+    a = src.index(sig)
+    b = src.index("{", a)
+    depth, i = 0, b
+    while True:
+        depth += src[i] == "{"
+        depth -= src[i] == "}"
+        i += 1
+        if depth == 0:
+            return src[b:i]
+
