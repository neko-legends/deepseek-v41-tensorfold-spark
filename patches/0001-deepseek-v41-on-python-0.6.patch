index 0000000..2670898
--- /dev/null
+++ b/tests/test_dsv41_long_prefill_memory.py
@@ -0,0 +1,396 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Host memory of a long prefill on both ranks (G12, bug 1), on the CPU with a fake forward:
+
+- the hash memo (``prefetch.CachedHasher``) is bounded by the rows it holds, not just its entries: before, a 299K
+  prefill kept every 2,048-row segment's key and hashes (256 x ~0.9 MB a rank, growing with the prompt);
+- a 299K-token prompt through rank 0's ``Batcher`` and rank 1's ``follow`` (a queue link, a thread) with a forward
+  that allocates and frees what the real one does a segment on the host (the Engram bulk read's buffers, its fp32 /
+  bf16 rows, the hashes, twice: the prefetch issue and the forward): the process's anonymous memory does not grow
+  with the prompt, the executors hold nothing of it after the reply, and both ranks trim alike
+  (``hostmem.Trimmer``: every 32,768 prompt rows, a full trim at the prompt's end);
+- ``hostmem.Probe`` lines and the Engram native gather without the int64 index array.
+"""
+
+from __future__ import annotations
+
+import io
+import queue
+import threading
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.deepseek_v41.cuda import hostmem  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefetch as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Bounded, Candidates  # noqa: E402
+
+SEG = 2048
+HEADS = 12                      # Engram heads a rank a layer (the real pack's)
+
+
+class FakeHasher:
+    """``engram_host.NgramHasher``'s output shape: [T, 2 layers, 24 columns] int64."""
+
+    calls = 0
+
+    def __call__(self, ids, dead=None, lookback=None):
+        FakeHasher.calls += 1
+        ids = torch.as_tensor(ids, dtype=torch.int64).reshape(-1)
+        return (ids[:, None, None] * 7919 + torch.arange(48).view(1, 2, 24)) % 1_000_003
+
+
+def _rss_anon_mib() -> float | None:
+    v = hostmem.status_kib().get("RssAnon")
+    return None if v is None else v / 1024
+
+
+class _Slot:
+    def __init__(self) -> None:
+        self.pages: list[int] = []
+
+    def reserve(self, quota: int) -> None:
+        self.pages = [0] * 0
+
+    def ensure(self, end: int) -> None:
+        pass
+
+    def release(self) -> int:
+        self.pages = []
+        return 0
+
+    def truncate(self, keep: int) -> int:
+        return 0
+
+
+class _Pool:
+    npages = 1 << 20
+
+    def need_pages(self, prompt: int, max_tokens: int, capacity: int) -> int:
+        return 1
+
+    def available(self) -> int:
+        return self.npages
+
+    def new_slot(self, capacity: int) -> _Slot:
+        return _Slot()
+
+    def describe(self) -> str:
+        return "fake"
+
+
+class HostForward:
+    """``protocol.Forward`` with the real prefill's host allocations a segment (freed when the segment ends)."""
+
+    vocab = 512
+
+    def __init__(self) -> None:
+        self.hasher = PF.CachedHasher(FakeHasher())
+        self.pos: dict[int, int] = {}
+        self.tail: dict[int, list[int]] = {}
+        self.segments = 0
+
+    def reset(self, slot: int) -> None:
+        self.pos[slot], self.tail[slot] = 0, []
+
+    def _segment(self, slot: int, ids: tuple) -> None:
+        lb = torch.tensor(self.tail[slot], dtype=torch.long)
+        for _ in range(2):                                  # the prefetch's issue, then the forward
+            h = self.hasher(torch.tensor(ids), lookback=lb)
+        idx = h[:, :, :HEADS].reshape(-1).numpy()
+        raw = np.empty(idx.size * 4096 // 8, dtype=np.uint8)       # the 4 KiB-padded read buffer (~100 MB real)
+        raw[::4096] = 1
+        rec = np.lib.stride_tricks.sliding_window_view(raw, 264)[np.arange(idx.size) * 4 % (raw.size - 264)]
+        rows = torch.from_numpy(rec[:, :256].astype(np.float32))    # fp32 rows, then bf16 (the forward's copy)
+        rows.to(torch.bfloat16)
+        self.pos[slot] += len(ids)
+        self.tail[slot] = (self.tail[slot] + list(ids))[-3:]
+        self.segments += 1
+
+    def prefill(self, pieces, *, mode: str = "full") -> None:
+        for pc in pieces:
+            if pc.start != self.pos[pc.slot]:
+                raise RuntimeError(f"slot {pc.slot}: a piece at {pc.start}, the slot is at {self.pos[pc.slot]}")
+            for a in range(0, len(pc.ids), SEG):
+                self._segment(pc.slot, tuple(pc.ids[a:a + SEG]))
+
+    def finish_prompt(self, slot: int, end: int, tail, *, mode: str = "full") -> None:
+        if self.pos[slot] != end:
+            raise RuntimeError("finish_prompt at the wrong position")
+
+    def window(self, windows, *, count: int, masks=None) -> Candidates:
+        n = sum(len(w.tokens) for w in windows)
+        ids = np.tile(np.arange(count, dtype=np.int64) + 3, (n, 1))
+        return Candidates(ids, -np.tile(np.arange(count, dtype=np.float32), (n, 1)))
+
+    def commit(self, slot: int, accepted: int) -> None:
+        self.pos[slot] += accepted + 1
+
+    def snapshot(self, slot: int) -> Bounded:
+        return Bounded(self.pos[slot])
+
+    def restore(self, slot: int, snap: Bounded) -> None:
+        self.pos[slot] = snap.pos
+
+
+class QueueLink:
+    def __init__(self, q: queue.Queue) -> None:
+        self.q = q
+
+    def send(self, plan) -> None:
+        self.q.put(list(plan))
+
+    def recv(self):
+        return self.q.get(timeout=60)
