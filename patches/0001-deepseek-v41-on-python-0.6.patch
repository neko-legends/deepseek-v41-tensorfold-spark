+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""x3seg.cu's kernels (fused_proj, TF_DSV41_FUSED_PROJ) build for sm_121 (GB10) without torch headers
+(-DDSV41_X3SEG_NO_TORCH): every instance the launcher dispatches (K2 4-16, 4 warps at 3 and 2 blocks an SM, 8 warps)
+and seg_rot_in, with upstream linear.cu's flags; registers within the occupancy each MINB asks for, no spills at
+MINB 2 and with 8 warps. Needs an nvcc that knows compute_121 (TF_NVCC, PATH or CUDA_HOME); skipped otherwise.
+Prints the registers / spills a K2 next to MINB, for choosing TF_DSV41_FUSED_PROJ_MINB."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+import tensorfold.cuda.exl3 as upstream
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP
+
+CU = Path(FP.__file__).with_name("x3seg.cu")
+CFGS = [(k2, wk, mb) for k2 in FP.K2S for wk, mb in ((4, 3), (4, 2), (8, 1))]
+
+
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+NVCC = _nvcc()
+pytestmark = pytest.mark.skipif(NVCC is None, reason="no nvcc with compute_121 (TF_NVCC)")
+
+
+def test_builds_for_sm121(tmp_path):
+    src = tmp_path / "inst.cu"
+    src.write_text(f'#include "{CU.name}"\n' + "".join(
+        f"template __global__ void dsv41_x3seg::seg_linear_kernel<{k2}, 2, {wk}, {mb}>"
+        "(const dsv41_x3seg::LinTable, int, int);\n" for k2, wk, mb in CFGS))
+    inc = [f"-I{CU.parent}", f"-I{Path(upstream.__file__).parent}"]
+    if os.environ.get("TF_CUDA_INCLUDE"):
+        inc.append(f"-I{os.environ['TF_CUDA_INCLUDE']}")
+    out = subprocess.run([NVCC, "-std=c++17", "-O3", "--expt-relaxed-constexpr", "-DDSV41_X3SEG_NO_TORCH", *inc,
+                          "-gencode=arch=compute_121,code=sm_121", "-Xptxas", "-v", "-c", str(src), "-o",
+                          str(tmp_path / "inst.o")], capture_output=True, text=True, timeout=1800)
+    assert out.returncode == 0, out.stderr[-3000:]
+    log = out.stderr
+    rows = []
+    for block in log.split("Compiling entry function")[1:]:
+        name = re.match(r" '(\S+)'", block).group(1)
+        regs = int(re.search(r"Used (\d+) registers", block).group(1))
+        spill = int(re.search(r"(\d+) bytes spill stores", block).group(1))
+        rows.append((name, regs, spill))
+    lin = [r for r in rows if "seg_linear_kernel" in r[0]]
+    assert len(lin) == len(CFGS) and any("seg_rot_in_kernel" in r[0] for r in rows)
+    lines = []
+    for name, regs, spill in lin:
+        k2, wk, mb = (int(v) for v in re.search(r"ILi(\d+)ELi2ELi(\d+)ELi(\d+)E", name).groups())
+        assert regs * 32 * wk * mb <= 65536 and regs <= 255, (k2, wk, mb, regs)
+        if mb == 2 or wk == 8:
+            assert spill == 0, (k2, wk, mb, spill)
+        lines.append(f"K2 {k2} WK {wk} MINB {mb}: {regs} regs, {spill} B spill")
+    print("[G7] x3seg sm_121: " + "; ".join(lines))
