+"""A rank's weights of a DeepSeek-V4.1-Flash EXL3 pack (the MiaAI / dealignai 2.9 bpw layout), as stored.
+
+Every EXL3 group (``P.trellis`` int16 [K/16, N/16, 16 bits], ``P.suh`` fp16 [K], ``P.svh`` fp16 [N], marker
+``P.mul1``) is read as its raw tensors; a group's width comes from its trellis shape (never from a K map), so the
+6-bit layer-0 ``wq_a`` / ``wkv``, the 8-bit indexer ``wk`` and the 2-bit layers 18-22 need no special case. The
+forward turns the tree into kernels' objects (``forward.build``), the prepared folder stores it as is (``fastboot``).
+
+TP (docs/ENGINE-PLAN.md section 4; every split boundary is a multiple of 128, so EXL3's Hadamard blocks stay whole
+and a rank's matrix is exactly the slice of the full one):
+
+| tensor | rank r of W holds |
+| --- | --- |
+| ``embed.weight`` | vocabulary rows [r V / W, (r + 1) V / W) |
+| ``attn.wq_b`` | output columns of heads [r H / W, ...) (trellis N tiles, ``svh``) |
+| ``attn.attn_sink`` | the same heads |
+| ``attn.wo_a.slice.g`` | groups [r G / W, ...) |
+| ``attn.wo_b`` | input rows [r K / W, ...) (trellis K tiles, ``suh``): a partial sum, exchanged |
+| ``ffn.experts.E.w1/w3``, ``shared_experts.w1/w3`` | intermediate columns [r I / W, ...) |
+| ``ffn.experts.E.w2``, ``shared_experts.w2`` | intermediate rows [r I / W, ...): a partial sum, exchanged |
+| ``head`` | vocabulary columns [r V / W, ...) |
+
+Rotated expert split (``TF_DSV41_EXPERT_ROTATE=1``; only where the intermediate width does not split evenly, i.e.
+TP4's 2,304 = 18 blocks): expert ``e`` of a block gives rank r the slice ``block_bounds`` gives rank (r - e) mod W,
+so the 5-block slices travel round the ranks with the expert id instead of always landing on ranks 0 and 1 (the
+shared expert takes the offset ``SHARED_ROT``: its 5-block slices on ranks 2 and 3, away from rank 0's extra work).
+Columns and rows still partition exactly; only which rank holds which blocks of an expert moves. The stacks become
+``X3Ragged`` (one width an expert).
+| the rest (``wq_a``, ``wkv``, compressor, indexer, norms, ``hc_*``, router, Engram ``wkv``) | all of it |
+
+Dtypes as vLLM holds them: the router ``gate.weight`` and the indexer ``weights_proj`` (fp16 in the pack) are
+rounded to bf16 once; ``gate.bias`` stays fp32; norms, ``hc_*`` and sinks are fp32 values. ``gate.bias_vl`` (image
+routing; the packs dropped it) comes from the source shards when ``TF_DSV41_BIAS_VL`` names them, else it is None
+(text only, M1).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import struct
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import torch
+
+from .config import Config
+
+DTYPES = {"F64": torch.float64, "F32": torch.float32, "F16": torch.float16, "BF16": torch.bfloat16,
+          "I64": torch.int64, "I32": torch.int32, "I16": torch.int16, "I8": torch.int8, "U8": torch.uint8,
+          "BOOL": torch.bool, "F8_E4M3": torch.float8_e4m3fn, "F8_E8M0": torch.uint8}
+MARKERS = {0x83DCD12D: "mul1", 0xCBAC1FED: "mcg"}
+ENV_BIAS_VL = "TF_DSV41_BIAS_VL"
+
+
+# -- the checkpoint folder ---------------------------------------------------------------------------------------
+@dataclass(frozen=True)
+class Info:
+    file: str
+    dtype: str
+    shape: tuple[int, ...]
+    start: int
+    nbytes: int
+
+
+class Shards:
+    """A safetensors folder read with ``pread`` (whole tensors, or a range of the first dim), no mmap."""
+
+    def __init__(self, root: str | Path) -> None:
+        self.root = Path(root)
+        idx = self.root / "model.safetensors.index.json"
+        self._headers: dict[str, dict[str, Info]] = {}
+        if idx.is_file():
+            self.weight_map: dict[str, str] = json.loads(idx.read_text())["weight_map"]
+        else:
+            self.weight_map = {n: p.name for p in sorted(self.root.glob("*.safetensors")) for n in self._header(p.name)}
+
+    def _header(self, file: str) -> dict[str, Info]:
+        if file not in self._headers:
+            with open(self.root / file, "rb") as f:
+                n = struct.unpack("<Q", f.read(8))[0]
+                raw = json.loads(f.read(n))
+            base = 8 + n
+            self._headers[file] = {k: Info(file, e["dtype"], tuple(e["shape"]), base + e["data_offsets"][0],
+                                           e["data_offsets"][1] - e["data_offsets"][0])
+                                   for k, e in raw.items() if k != "__metadata__"}
+        return self._headers[file]
+
+    def __contains__(self, name: str) -> bool:
+        return name in self.weight_map and (self.root / self.weight_map[name]).is_file()
+
+    def info(self, name: str) -> Info:
+        return self._header(self.weight_map[name])[name]
+
+    def _read(self, file: str, start: int, nbytes: int) -> bytearray:
+        buf = bytearray(nbytes)
+        fd = os.open(self.root / file, os.O_RDONLY)
+        try:
+            view, got = memoryview(buf), 0
+            while got < nbytes:
+                n = os.preadv(fd, [view[got:]], start + got)
+                if n <= 0:
+                    raise OSError(f"{self.root / file}: short read at {start + got}")
+                got += n
+            if hasattr(os, "posix_fadvise"):        # GB10: the page cache is the GPU's memory
+                os.posix_fadvise(fd, start, nbytes, os.POSIX_FADV_DONTNEED)
+        finally:
+            os.close(fd)
+        return buf
+
+    def tensor(self, name: str) -> torch.Tensor:
+        i = self.info(name)
+        if not i.nbytes:
+            return torch.empty(i.shape, dtype=DTYPES[i.dtype])
+        raw = torch.frombuffer(self._read(i.file, i.start, i.nbytes), dtype=torch.uint8)
+        return raw.view(DTYPES[i.dtype]).reshape(i.shape)
+
+    def rows(self, name: str, lo: int, hi: int) -> torch.Tensor:
+        """Rows [lo, hi) of the first dim, reading only those bytes."""
+
+        i = self.info(name)
+        row = i.nbytes // i.shape[0]
+        raw = torch.frombuffer(self._read(i.file, i.start + lo * row, (hi - lo) * row), dtype=torch.uint8)
+        return raw.view(DTYPES[i.dtype]).reshape((hi - lo, *i.shape[1:]))
+
+
+# -- the stored tree ---------------------------------------------------------------------------------------------
+@dataclass
+class X3:
+    """One EXL3 matrix (this rank's slice): y = x @ W, W [K, N]."""
+
+    trellis: torch.Tensor       # int16 [K/16, N/16, 16 bits]
+    suh: torch.Tensor           # fp16 [K]
+    svh: torch.Tensor           # fp16 [N]
+    codebook: str
+
+    @property
+    def k(self) -> int:
+        return 16 * self.trellis.shape[0]
+
+    @property
+    def n(self) -> int:
+        return 16 * self.trellis.shape[1]
+
+
+@dataclass
+class X3Stack:
+    """The routed experts of one projection, one width: trellis [E, K/16, N/16, W], suh [E, K], svh [E, N]."""
+
+    trellis: torch.Tensor
+    suh: torch.Tensor
+    svh: torch.Tensor
+    codebook: str
+
+    def item(self, e: int) -> X3:
+        return X3(self.trellis[e], self.suh[e], self.svh[e], self.codebook)
+
+    @property
+    def count(self) -> int:
+        return int(self.trellis.shape[0])
+
+
+@dataclass
+class X3Ragged:
+    """The routed experts of one projection whose slices differ in width by expert (``TF_DSV41_EXPERT_ROTATE``):
+    per expert trellis [K_e/16, N_e/16, W], suh [K_e], svh [N_e]."""
+
+    trellis: list
+    suh: list
+    svh: list
+    codebook: str
+
+    def item(self, e: int) -> X3:
+        return X3(self.trellis[e], self.suh[e], self.svh[e], self.codebook)
+
+    @property
+    def count(self) -> int:
+        return len(self.trellis)
+
+
+@dataclass
+class Hc:
+    fn: torch.Tensor            # fp32 [24, 4 D]
+    base: torch.Tensor          # fp32 [24]
+    scale: torch.Tensor         # fp32 [3]
+
+
+@dataclass
+class AttnW:
+    wq_a: X3
+    wkv: X3
+    wq_b: X3                    # this rank's heads
+    wo_a: list                  # X3 of this rank's groups
+    wo_b: X3                    # this rank's input rows
+    q_norm: torch.Tensor
+    kv_norm: torch.Tensor
+    sink: torch.Tensor          # fp32 [local heads]
+    comp_wkv: X3 | None = None
+    comp_wgate: X3 | None = None
+    comp_norm: torch.Tensor | None = None
+    ix_wq_b: X3 | None = None
+    ix_wp: torch.Tensor | None = None       # bf16 values [index heads, D]
+    ix_wk: X3 | None = None
+    ix_knorm: torch.Tensor | None = None
+
+
+@dataclass
+class MoEW:
+    gate: torch.Tensor          # bf16 [E, D]
+    bias: torch.Tensor          # fp32 [E]
+    w1: X3Stack                 # routed, this rank's half
+    w2: X3Stack
+    w3: X3Stack
+    shared: list                # [(w1, w2, w3)] X3 triples, this rank's half
+    bias_vl: torch.Tensor | None = None
+
+
+@dataclass
+class EngramW:
+    wkv: X3                     # [heads x 256] -> [(4 + 1) D], replicated
+    qk: torch.Tensor            # fp32 [4, D] = bf16(q_weight) * bf16(k_weight)
+
+
+@dataclass
+class LayerW:
+    index: int
+    attn_norm: torch.Tensor
+    ffn_norm: torch.Tensor
+    hc_attn: Hc
+    hc_ffn: Hc
+    attn: AttnW
+    moe: MoEW
+    engram: EngramW | None = None
+
+
+@dataclass
+class RankW:
+    rank: int
+    world: int
+    vocab_lo: int
+    embed: torch.Tensor         # bf16 [V / W, D]
+    layers: list
+    norm: torch.Tensor
+    head: X3                    # vocabulary columns of this rank
+    token_map: torch.Tensor | None = None   # int32 [V]: Engram's compressed ids (tokenizer.json)
+    meta: dict = field(default_factory=dict)
+
+    def nbytes(self) -> int:
+        seen, total = set(), 0
+
+        def walk(x) -> None:
+            nonlocal total
+            if isinstance(x, torch.Tensor):
+                k = (x.untyped_storage().data_ptr(), x.device.type)
+                if k not in seen:
+                    seen.add(k)
+                    total += x.untyped_storage().nbytes()
+            elif isinstance(x, (list, tuple)):
+                for v in x:
+                    walk(v)
+            elif hasattr(x, "__dataclass_fields__"):
+                for v in vars(x).values():
+                    walk(v)
+
+        walk(self)
+        return total
+
+
+# -- tensor-parallel partitions -----------------------------------------------------------------------------------
+def block_bounds(n: int, world: int, rank: int, block: int = 128) -> tuple[int, int]:
+    """``rank``'s [lo, hi) of ``n`` elements split into whole ``block``-wide pieces: every rank gets
+    ``n // block // world`` blocks and the first ``(n // block) % world`` ranks one more. Even splits (every TP2
+    shape, and TP4 attention) are the plain equal parts; TP4 experts (2,304 = 18 blocks) are 640/640/512/512 and the
+    TP4 vocabulary (1,010 blocks) 32,384/32,384/32,256/32,256. Boundaries stay on whole Hadamard blocks (EXL3)."""
+
+    if n % block or not 0 <= rank < world:
+        raise ValueError(f"{n} does not split into blocks of {block} (rank {rank} of {world})")
+    nb = n // block
+    base, extra = divmod(nb, world)
+    if base == 0:
+        raise ValueError(f"{n} has fewer blocks of {block} than {world} ranks")
+    lo = rank * base + min(rank, extra)
+    return lo * block, (lo + base + (1 if rank < extra else 0)) * block
+
+
+ENV_ROTATE = "TF_DSV41_EXPERT_ROTATE"
+SHARED_ROT = 2           # the shared expert's offset: its wide slices on ranks 2 and 3 at TP4
+
+
+def rotate_on(env: dict | None = None) -> bool:
+    """``TF_DSV41_EXPERT_ROTATE``: rotate the uneven expert split by expert id (every rank must agree)."""
+
+    v = (os.environ if env is None else env).get(ENV_ROTATE, "").strip().lower()
+    if v in ("", "0", "off", "false", "no"):
+        return False
+    if v in ("1", "on", "true", "yes"):
+        return True
+    raise ValueError(f"{ENV_ROTATE}={v!r}: expected 0 or 1")
+
+
+def expert_bounds(n: int, world: int, rank: int, e: int, rotate: bool, block: int = 128) -> tuple[int, int]:
+    """Rank ``rank``'s [lo, hi) of expert ``e``'s intermediate width ``n``: ``block_bounds`` of rank (rank - e) mod
+    world when ``rotate`` (and the split is uneven), else of ``rank``. The ranks' slices partition [0, n) either way."""
+
+    if rotate and (n // block) % world:
+        return block_bounds(n, world, (rank - e) % world, block)
+    return block_bounds(n, world, rank, block)
+
+
+# -- the loader --------------------------------------------------------------------------------------------------
+class Loader:
+    """Builds a rank's ``RankW`` from a checkpoint folder: ``Loader(cfg, Shards(dir), rank, world).load()``."""
+
+    def __init__(self, cfg: Config, src: Shards, rank: int, world: int, device="cpu",
+                 bias_vl: Shards | None = None, rotate: bool | None = None) -> None:
+        if cfg.num_attention_heads % world or cfg.o_groups % world or cfg.vocab_size % 128:
+            raise ValueError(f"heads {cfg.num_attention_heads} and o_groups {cfg.o_groups} must split over {world} "
+                             f"ranks and the vocabulary {cfg.vocab_size} into blocks of 128")
+        block_bounds(cfg.vocab_size, world, rank)
+        self.cfg, self.src, self.rank, self.world, self.device = cfg, src, rank, world, torch.device(device)
+        self.bias_vl_src = bias_vl
+        self.rotate = rotate_on() if rotate is None else bool(rotate)
+
+    # primitives
+    def _dev(self, t: torch.Tensor) -> torch.Tensor:
+        return t.contiguous().to(self.device)
+
+    def native(self, name: str, dtype: torch.dtype = torch.float32, bf16_param: bool = False) -> torch.Tensor:
+        t = self.src.tensor(name)
+        if bf16_param:
+            t = t.to(torch.bfloat16)
+        return self._dev(t.to(dtype))
+
+    def codebook(self, prefix: str) -> str:
+        for marker in ("mul1", "mcg"):
+            if f"{prefix}.{marker}" in self.src:
+                v = int(self.src.tensor(f"{prefix}.{marker}").reshape(-1)[0]) & 0xFFFFFFFF
+                if v not in MARKERS:
+                    raise ValueError(f"{prefix}.{marker}: unknown codebook marker {v:#x}")
+                return MARKERS[v]
+        return "3inst"
+
+    def x3(self, prefix: str, split: str = "", on_device: bool = True, bounds=None) -> X3:
+        """``split`` "" (whole), "col" (this rank's output columns) or "row" (this rank's input rows); ``bounds``
+        (lo, hi) of the split dimension instead of this rank's ``block_bounds`` (the rotated expert split)."""
+
+        parts, part = self.world, self.rank
+        tn = f"{prefix}.trellis"
+        if tn not in self.src:
+            raise KeyError(f"{prefix}: no EXL3 group in the checkpoint")
+        kt, nt, _ = self.src.info(tn).shape
+        suh, svh = self.src.tensor(f"{prefix}.suh"), self.src.tensor(f"{prefix}.svh")
+        if split == "row":
+            try:
+                lo, hi = bounds or block_bounds(kt * 16, parts, part)
+            except ValueError as e:
+                raise ValueError(f"{prefix}: K={kt * 16}: {e}") from None
+            t = self.src.rows(tn, lo // 16, hi // 16)
+            suh = suh[lo:hi]
+        elif split == "col":
+            try:
+                lo, hi = bounds or block_bounds(nt * 16, parts, part)
+            except ValueError as e:
+                raise ValueError(f"{prefix}: N={nt * 16}: {e}") from None
+            t = self.src.tensor(tn)[:, lo // 16:hi // 16]
+            svh = svh[lo:hi]
+        else:
+            t = self.src.tensor(tn)
+        dev = self._dev if on_device else (lambda x: x.contiguous())
+        return X3(dev(t), dev(suh.to(torch.float16)), dev(svh.to(torch.float16)), self.codebook(prefix))
+
+    def hc(self, p: str, which: str) -> Hc:
+        return Hc(self.native(f"{p}.hc_{which}_fn"), self.native(f"{p}.hc_{which}_base"),
+                  self.native(f"{p}.hc_{which}_scale"))
+
+    # blocks
+    def attn(self, layer: int, p: str) -> AttnW:
+        cfg, r, w = self.cfg, self.rank, self.world
+        a = f"{p}.attn"
+        hl, gl = cfg.num_attention_heads // w, cfg.o_groups // w
+        out = AttnW(
+            wq_a=self.x3(f"{a}.wq_a"), wkv=self.x3(f"{a}.wkv"), wq_b=self.x3(f"{a}.wq_b", "col"),
+            wo_a=[self.x3(f"{a}.wo_a.slice.{g}") for g in range(r * gl, (r + 1) * gl)],
+            wo_b=self.x3(f"{a}.wo_b", "row"), q_norm=self.native(f"{a}.q_norm.weight"),
+            kv_norm=self.native(f"{a}.kv_norm.weight"),
+            sink=self._dev(self.src.tensor(f"{a}.attn_sink").to(torch.float32)[r * hl:(r + 1) * hl]))
+        if cfg.is_backbone(layer) and cfg.is_kv_source(layer):
+            out.comp_wkv = self.x3(f"{a}.compressor.wkv")
+            if cfg.compress_ratio(layer) > 1:
+                out.comp_wgate = self.x3(f"{a}.compressor.wgate")
+            out.comp_norm = self.native(f"{a}.compressor.norm.weight")
+            out.ix_wk = self.x3(f"{a}.indexer.wk")
+            out.ix_knorm = self.native(f"{a}.indexer.k_norm.weight")
+        if cfg.is_backbone(layer) and cfg.is_index_source(layer):
+            out.ix_wq_b = self.x3(f"{a}.indexer.wq_b")
+            out.ix_wp = self.native(f"{a}.indexer.weights_proj.weight", bf16_param=True)
+        return out
+
+    def _ebounds(self, f: str, which: str, e: int, split: str):
+        """Expert ``e``'s rotated (lo, hi) of its intermediate dim, or None (this rank's plain ``block_bounds``)."""
+
+        if not self.rotate or self.world <= 1 or not split:
+            return None
+        name = f"{f}.{which}.trellis"
+        kt, nt, _ = self.src.info(name).shape
+        n = (nt if split == "col" else kt) * 16
+        return expert_bounds(n, self.world, self.rank, e, True)
+
+    def stack(self, f: str, n_exp: int, which: str, split: str) -> X3Stack | X3Ragged:
+        items = [self.x3(f"{f}.experts.{e}.{which}", split, on_device=False,
+                         bounds=self._ebounds(f"{f}.experts.{e}", which, e, split)) for e in range(n_exp)]
+        shapes = {tuple(x.trellis.shape) for x in items}
+        if len({x.codebook for x in items}) != 1:
+            raise ValueError(f"{f}.experts.*.{which}: codebooks differ within the layer")
+        if len(shapes) != 1:
+            if not self.rotate:
+                raise ValueError(f"{f}.experts.*.{which}: widths differ within the layer ({sorted(shapes)})")
+            rg = X3Ragged([self._dev(x.trellis) for x in items], [self._dev(x.suh) for x in items],
+                          [self._dev(x.svh) for x in items], items[0].codebook)
+            del items
+            return rg
+        st = X3Stack(self._dev(torch.stack([x.trellis for x in items])), self._dev(torch.stack([x.suh for x in items])),
+                     self._dev(torch.stack([x.svh for x in items])), items[0].codebook)
+        del items
+        return st
+
+    def moe(self, layer: int, p: str) -> MoEW:
+        f = f"{p}.ffn"
+        n_exp, _ = self.cfg.experts_of(layer)
+        sh = f"{f}.shared_experts"
+        shared = [(self.x3(f"{sh}.w1", "col", bounds=self._ebounds(sh, "w1", SHARED_ROT, "col")),
+                   self.x3(f"{sh}.w2", "row", bounds=self._ebounds(sh, "w2", SHARED_ROT, "row")),
+                   self.x3(f"{sh}.w3", "col", bounds=self._ebounds(sh, "w3", SHARED_ROT, "col")))] \
+            if f"{sh}.w1.trellis" in self.src else []
+        bias_vl = None
+        if self.bias_vl_src is not None and f"{f}.gate.bias_vl" in self.bias_vl_src:
+            bias_vl = self._dev(self.bias_vl_src.tensor(f"{f}.gate.bias_vl").to(torch.float32))
+        return MoEW(gate=self.native(f"{f}.gate.weight", torch.bfloat16, bf16_param=True),
+                    bias=self.native(f"{f}.gate.bias"), w1=self.stack(f, n_exp, "w1", "col"),
+                    w2=self.stack(f, n_exp, "w2", "row"), w3=self.stack(f, n_exp, "w3", "col"), shared=shared,
+                    bias_vl=bias_vl)
+
+    def engram(self, layer: int, p: str) -> EngramW | None:
+        if layer not in self.cfg.engram_layer_ids:
+            return None
+        e = f"{p}.engram"
+        q = self.src.tensor(f"{e}.q_weight").to(torch.bfloat16).float()
+        k = self.src.tensor(f"{e}.k_weight").to(torch.bfloat16).float()
+        return EngramW(self.x3(f"{e}.wkv"), self._dev(q * k))
+
+    def layer(self, layer: int) -> LayerW:
+        p = f"layers.{layer}" if self.cfg.is_backbone(layer) else f"mtp.{layer - self.cfg.num_hidden_layers}"
+        return LayerW(layer, self.native(f"{p}.attn_norm.weight"), self.native(f"{p}.ffn_norm.weight"),
+                      self.hc(p, "attn"), self.hc(p, "ffn"), self.attn(layer, p), self.moe(layer, p),
+                      self.engram(layer, p))
+
+    def load(self, layers: int | None = None, token_map: list[int] | None = None, progress=None) -> RankW:
+        cfg, r, w = self.cfg, self.rank, self.world
+        v_lo, v_hi = block_bounds(cfg.vocab_size, w, r)     # the head's columns: same 128-block partition
+        embed = self._dev(self.src.rows("embed.weight", v_lo, v_hi).to(torch.bfloat16))
+        out = []
+        for L in range(cfg.num_hidden_layers if layers is None else layers):
+            out.append(self.layer(L))
+            if progress is not None:
+                progress(L)
+        tm = None if token_map is None else self._dev(torch.tensor(token_map, dtype=torch.int32))
+        return RankW(r, w, v_lo, embed, out, self.native("norm.weight"), self.x3("head", "col"), tm,
+                     {"layers": len(out), "bias_vl": self.bias_vl_src is not None})
+
+
+def bias_vl_source(env: dict | None = None) -> Shards | None:
+    """``TF_DSV41_BIAS_VL``: a folder of the release's source shards holding ``*.ffn.gate.bias_vl`` (or unset)."""
+
+    v = (os.environ if env is None else env).get(ENV_BIAS_VL, "").strip()
+    return Shards(v) if v else None
diff --git a/src/tensorfold/families/deepseek_v41/cuda/x3dn.cpp b/src/tensorfold/families/deepseek_v41/cuda/x3dn.cpp
new file mode 100644
index 0000000..13887e4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3dn.cpp
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of x3dn.cu (TF_DSV41_DENSE: dense EXL3 linears at bandwidth; dense.py). Every bound the kernels rely on
+// is checked here, so a wrong table from Python is an error, never an out-of-bounds access.
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+#include <vector>
+
+void dsv41_x3dn_rot_in_cuda(const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, at::Tensor&,
+                            const std::vector<int64_t>&, bool);
+void dsv41_x3dn_linear_cuda(const at::Tensor&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+                            const std::vector<at::Tensor>&, at::Tensor&, at::Tensor&, const std::vector<int64_t>&,
+                            int64_t, int64_t, int64_t, bool);
+
+static constexpr int MAXSEG = 8;
+static constexpr int META = 8;
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+static bool io_dtype(const at::Tensor& x) {
+    const auto t = x.scalar_type();
+    return t == at::kHalf || t == at::kBFloat16 || t == at::kFloat;
+}
+
+static bool aligned16(const at::Tensor& x) { return reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0; }
+
+// xh (flat fp16) at xh_off[i] = fp16(((xs[i] * suh[i]) @ H) / sqrt(128)), [M, K_i] contiguous
+void rot_in(const std::vector<at::Tensor>& xs, const std::vector<at::Tensor>& suh, at::Tensor xh,
+            const std::vector<int64_t>& xh_off, bool pdl) {
+    const size_t n = xs.size();
+    TORCH_CHECK(n >= 1 && n <= MAXSEG && suh.size() == n && xh_off.size() == n, "x3dn.rot_in: 1-8 segments");
+    check(xh, at::kHalf, "xh");
+    const int64_t M = xs[0].size(0);
+    for (size_t i = 0; i < n; ++i) {
+        const auto& x = xs[i];
+        TORCH_CHECK(x.is_cuda() && x.dim() == 2 && io_dtype(x) && x.stride(1) == 1 && x.size(0) == M,
+                    "x3dn.rot_in: x [M, K] fp16 / bf16 / fp32 CUDA rows of unit stride, the same M");
+        TORCH_CHECK(M >= 1 && M <= 65535 && x.size(1) % 128 == 0, "x3dn.rot_in: K a multiple of 128");
+        TORCH_CHECK(aligned16(x) && (x.stride(0) * x.element_size()) % 16 == 0, "x3dn.rot_in: 16-byte rows");
+        check(suh[i], at::kHalf, "suh");
+        TORCH_CHECK(suh[i].numel() == x.size(1), "x3dn.rot_in: suh [K]");
+        TORCH_CHECK(xh_off[i] >= 0 && xh_off[i] % 8 == 0 && xh_off[i] + M * x.size(1) <= xh.numel(),
+                    "x3dn.rot_in: xh slice out of range or misaligned");
+    }
+    c10::cuda::CUDAGuard guard(xh.device());
+    dsv41_x3dn_rot_in_cuda(xs, suh, xh, xh_off, pdl);
+}
+
+// one launch over the segments' programs; meta: 8 ints a segment (dense.layout): K, N, SK, p0, xh_off, c_off, col, K2
+void linear(const at::Tensor& xh, const std::vector<at::Tensor>& T, const std::vector<at::Tensor>& svh,
+            const std::vector<at::Tensor>& ys, at::Tensor Z, at::Tensor counters, const std::vector<int64_t>& meta,
+            int64_t programs, int64_t K2, int64_t PD, bool pdl) {
+    const size_t n = T.size();
+    TORCH_CHECK(n >= 1 && n <= MAXSEG && svh.size() == n && ys.size() == n && meta.size() == META * n,
+                "x3dn.linear: 1-8 segments, 8 meta ints each");
+    TORCH_CHECK(PD >= 2 && PD <= 4, "x3dn.linear: PD 2-4");
+    check(xh, at::kHalf, "xh");
+    check(counters, at::kInt, "counters");
+    check(Z, at::kFloat, "Z");
+    const int64_t M = ys[0].size(0);
+    TORCH_CHECK(M >= 1 && M <= 64, "x3dn.linear: 1-64 rows a launch");
+    const int64_t passes = (M + 15) / 16, RP = std::min<int64_t>(M, 16);
+    int64_t p = 0;
+    bool split = false;
+    for (size_t i = 0; i < n; ++i) {
+        const int64_t* m = meta.data() + META * i;
+        const int64_t K = m[0], N = m[1], SK = m[2], p0 = m[3], xo = m[4], co = m[5], col = m[6];
+        TORCH_CHECK(m[7] == K2, "x3dn.linear: one width a launch");
+        TORCH_CHECK(K % 128 == 0 && N % 128 == 0 && K > 0 && N > 0, "x3dn.linear: K and N multiples of 128");
+        TORCH_CHECK(SK >= 1 && SK <= 16 && (K / 16) >= SK, "x3dn.linear: 1-16 K splits, at least a k step each");
+        TORCH_CHECK(p0 == p, "x3dn.linear: p0 must be the running sum of the programs");
+        p += (N / 128) * SK;
+        split |= SK > 1;
+        check(T[i], at::kInt, "T");
+        TORCH_CHECK(T[i].numel() == K * N * K2 / 64 && aligned16(T[i]), "x3dn.linear: T holds K * N * bits / 32 words");
+        check(svh[i], at::kHalf, "svh");
+        TORCH_CHECK(svh[i].numel() == N, "x3dn.linear: svh [N]");
+        TORCH_CHECK(xo >= 0 && xo % 8 == 0 && xo + M * K <= xh.numel(), "x3dn.linear: xh slice");
+        TORCH_CHECK(co >= 0 && co + passes * (N / 128) <= counters.numel(), "x3dn.linear: counter slice");
+        const auto& y = ys[i];
+        TORCH_CHECK(y.is_cuda() && y.dim() == 2 && io_dtype(y) && y.scalar_type() == ys[0].scalar_type() &&
+                        y.size(0) == M && y.stride(1) == 1 && col >= 0 && col % 4 == 0 && col + N <= y.size(1) &&
+                        (M == 1 || y.stride(0) >= y.size(1)),
+                    "x3dn.linear: y [M, >= col + N], unit-stride rows, one dtype a launch");
+        TORCH_CHECK(aligned16(y) && (y.stride(0) * y.element_size()) % 16 == 0, "x3dn.linear: 16-byte y rows");
+    }
+    TORCH_CHECK(p == programs && programs < (1 << 30), "x3dn.linear: programs != the segments' sum");
+    TORCH_CHECK(!split || Z.numel() >= passes * programs * RP * 128, "x3dn.linear: Z holds passes x programs x rows x 128");
+    c10::cuda::CUDAGuard guard(xh.device());
+    dsv41_x3dn_linear_cuda(xh, T, svh, ys, Z, counters, meta, programs, K2, PD, pdl);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("rot_in", &rot_in);
+    m.def("linear", &linear);
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/x3dn.cu b/src/tensorfold/families/deepseek_v41/cuda/x3dn.cu
new file mode 100644
index 0000000..74b5b90
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3dn.cu
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Dense EXL3 linears (dense.py, TF_DSV41_DENSE), v2: upstream's grid shape (one program a 128-column strip x K
+// split) with the x3ld load path (16-byte cp.async into a PD-deep shared-memory ring a warp, the input fragments
+// cp.async too), PDL (a program's first weights requested before griddepcontrol.wait), and few K splits chosen a
+// shape (dense.split_of: none where N alone fills the GPU). One launch runs up to MAXSEG matrices of one width.
+//
+// v1 (persistent CTAs over 16-step atoms from a work counter) measured 9-24% SLOWER than upstream in the engine
+// (G9-RESULTS section 2): 16-20 partials a strip, each with a fence, two atomics and a last-arriver sum, against
+// upstream's 8 (1 for wq_b). v2 has one reduction a program: the 4 warps in shared memory, and only with SK > 1 one
+// Z partial + one arrival atomic, the last split summing the SK partials.
+//
+// The arithmetic (the bits' parameters: K and SK, both the matrix's): split s of a strip = k steps
+// [s KT / SK, (s + 1) KT / SK); warp w of its program walks the quarter [lo + w L / 4, lo + (w + 1) L / 4) as one
+// mma.m16n8k16 chain (ascending k, from +0.0), decode.cuh's decode; the 4 warps added in warp order; the SK split
+// partials in split order; upstream's epilogue (fwht128, * 1/sqrt(128), * svh) and output rounding. Rows never mix:
+// row invariance, batched == alone, a matrix's bits in any group.
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#ifndef DSV41_X3DN_NO_TORCH       // the kernels alone (tests/test_dsv41_dense_compile.py: nvcc, no torch)
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#endif
+#include <algorithm>
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "decode.cuh"
+
+using namespace tf_exl3;
+
+namespace dsv41_x3dn {
+
+constexpr int MAXSEG = 8;
+constexpr int W = 4;                 // warps a CTA
+constexpr int RB = 4;                // rows a reduction round (one a warp)
+enum DType : int { F16 = 0, BF16 = 1, F32 = 2 };
+
+__device__ __forceinline__ void load4(const void* p, int dtype, size_t i, float (&v)[4]) {
+    if (dtype == F32) {
+        const float4 u = *reinterpret_cast<const float4*>(static_cast<const float*>(p) + i);
+        v[0] = u.x; v[1] = u.y; v[2] = u.z; v[3] = u.w;
+    } else if (dtype == BF16) {
+        const uint2 u = *reinterpret_cast<const uint2*>(static_cast<const __nv_bfloat16*>(p) + i);
+        const float2 a = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.x));
+        const float2 b = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&u.y));
+        v[0] = a.x; v[1] = a.y; v[2] = b.x; v[3] = b.y;
+    } else {
+        const uint2 u = *reinterpret_cast<const uint2*>(static_cast<const half*>(p) + i);
+        const float2 a = __half22float2(*reinterpret_cast<const half2*>(&u.x));
+        const float2 b = __half22float2(*reinterpret_cast<const half2*>(&u.y));
+        v[0] = a.x; v[1] = a.y; v[2] = b.x; v[3] = b.y;
+    }
+}
+
+__device__ __forceinline__ void store4(void* p, int dtype, size_t i, const float (&v)[4]) {
+    if (dtype == F32) {
+        *reinterpret_cast<float4*>(static_cast<float*>(p) + i) = make_float4(v[0], v[1], v[2], v[3]);
+    } else if (dtype == BF16) {
+        __nv_bfloat162 a = __floats2bfloat162_rn(v[0], v[1]), b = __floats2bfloat162_rn(v[2], v[3]);
+        uint2 u;
+        u.x = *reinterpret_cast<uint32_t*>(&a);
+        u.y = *reinterpret_cast<uint32_t*>(&b);
+        *reinterpret_cast<uint2*>(static_cast<__nv_bfloat16*>(p) + i) = u;
+    } else {
+        half2 a = __floats2half2_rn(v[0], v[1]), b = __floats2half2_rn(v[2], v[3]);
+        uint2 u;
+        u.x = *reinterpret_cast<uint32_t*>(&a);
+        u.y = *reinterpret_cast<uint32_t*>(&b);
+        *reinterpret_cast<uint2*>(static_cast<half*>(p) + i) = u;
+    }
+}
+
+// upstream linear.cu's epilogue (no bias): H / sqrt(128), * svh
+__device__ __forceinline__ void finish(float (&v)[4], int lane, const half* svh, int col) {
+    fwht128(v, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] = v[j] * HAD_SCALE * __half2float(__ldg(svh + col + j));
+}
+
+__device__ __forceinline__ void pdl_wait() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+#endif
+}
+
+__device__ __forceinline__ void pdl_trigger() {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+#endif
+}
+
+// release / acquire at GPU scope (the arrival counters' pattern; lighter than __threadfence's fence.sc)
+__device__ __forceinline__ void fence_gpu() { asm volatile("fence.acq_rel.gpu;" ::: "memory"); }
+
+__device__ __forceinline__ void cp16(uint32_t* dst, const uint32_t* src) {
+    const unsigned d = (unsigned)__cvta_generic_to_shared(dst);
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;" ::"r"(d), "l"(src) : "memory");
+}
+
+__device__ __forceinline__ void cp4(uint32_t* dst, const void* src) {
+    const unsigned d = (unsigned)__cvta_generic_to_shared(dst);
+    asm volatile("cp.async.ca.shared.global [%0], [%1], 4;" ::"r"(d), "l"(src) : "memory");
+}
+
+__device__ __forceinline__ void cp_commit() { asm volatile("cp.async.commit_group;" ::: "memory"); }
+
+template <int N>
+__device__ __forceinline__ void cp_wait() {
+    asm volatile("cp.async.wait_group %0;" ::"n"(N) : "memory");
+}
+
+// -- the tables (kernel parameters: graph-capture safe) ----------------------------------------------------------------
+struct RotSeg {
+    const void* x;          // [M, K] rows at x + row * ld (fp16, bf16 or fp32)
+    const half* suh;        // [K]
+    half* xh;               // [M, K] fp16, contiguous
+    long long ld;
+    int K, x_dtype;
+};
+struct RotTable {
+    RotSeg s[MAXSEG];
+    int n;
+};
+
+struct Seg {
+    const half* xh;          // [M, K] fp16 rotated input
+    const uint32_t* T;       // trellis words, upstream's strips layout [N/128, K/16, 8, TW]
+    const half* svh;         // [N]
+    void* y;                 // element (row, col) at y + row * ld + col
+    int* cnt;                // [passes, N / 128] strip arrivals (SK > 1), left zero
+    long long stride_nb;     // words between 128-column strips
+    int K, N, SK, p0, ld;    // SK: K splits of a strip (the shape's, dense.split_of); p0: first program
+};
+struct Table {
+    Seg s[MAXSEG];
+    int n, P;                // segments; programs of the launch
+};
+
+// the segment of program p: the last one with p0 <= p (unrolled selects: no local copy of the table)
+__device__ __forceinline__ int seg_of(const Table& tab, int p) {
+    int s = 0;
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i < tab.n && p >= tab.s[i].p0) s = i;
+    return s;
+}
+
+template <typename F>
+__device__ __forceinline__ auto field(const Table& tab, int s, F f) -> decltype(f(tab.s[0])) {
+    auto v = f(tab.s[0]);
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i == s) v = f(tab.s[i]);
+    return v;
+}
+
+template <int K2>
+__device__ __forceinline__ void req_w(const uint32_t* T, int kt, uint32_t* dst, int lane) {
+    constexpr int WORDS = 8 * tile_words<K2>();
+    constexpr int NV = (WORDS + 127) / 128;
+    const uint32_t* src = T + (size_t)kt * WORDS;
+#pragma unroll
+    for (int v = 0; v < NV; ++v) {
+        const int off = 128 * v + 4 * lane;
+        if (WORDS % 128 == 0 || off < WORDS) cp16(dst + off, src + off);
+    }
+}
+
+__device__ __forceinline__ void req_a(const half* x0, const half* x1, int kt, uint32_t* a) {
+    const int k = kt * 16;
+    cp4(a + 0, x0 + k);
+    cp4(a + 1, x1 + k);
+    cp4(a + 2, x0 + k + 8);
+    cp4(a + 3, x1 + k + 8);
+}
+
+template <int K2>
+__host__ __device__ constexpr int smem_words(int PD) {
+    return W * PD * (8 * tile_words<K2>() + 128) + W * RB * 128;
+}
+
+// Program p: strip nb, K split `split` of its segment ((nb, split) = divmod(p - p0, SK): a strip's splits are
+// consecutive programs, consecutive memory). Split s covers k steps [s KT / SK, (s + 1) KT / SK), warp w its quarter.
+template <int K2, int PD>
+__global__ void __launch_bounds__(W * 32, 3) dense_kernel(const Table tab, float* __restrict__ Z, int y_dtype,
+                                                          int M) {
+    constexpr int TW = tile_words<K2>(), LW = lane_words<K2>(), WORDS = 8 * TW;
+    static_assert(PD >= 2 && PD <= 4, "PD 2-4");
+    extern __shared__ __align__(16) uint32_t smem[];
+    __shared__ int last;
+
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    uint32_t* stage = smem + warp * PD * WORDS;
+    uint32_t* astg = smem + W * PD * WORDS + warp * PD * 128;
+    float* red = reinterpret_cast<float*>(smem + W * PD * (WORDS + 128));
+    const int RP = min(M, 16), passes = (M + 15) >> 4;
+    const int p = blockIdx.x, sg = seg_of(tab, p);
+    const int K = field(tab, sg, [](const Seg& s) { return s.K; });
+    const int SK = field(tab, sg, [](const Seg& s) { return s.SK; });
+    const int q = p - field(tab, sg, [](const Seg& s) { return s.p0; });
+    const int nb = q / SK, split = q - nb * SK, KT = K >> 4;
+    const int ka = split * KT / SK, L = (split + 1) * KT / SK - ka;
+    const int lo = ka + warp * L / W, n = ka + (warp + 1) * L / W - lo;
+    const uint32_t* Ts = field(tab, sg, [](const Seg& s) { return s.T; }) +
+                         (size_t)nb * field(tab, sg, [](const Seg& s) { return s.stride_nb; });
+    const half* xh = field(tab, sg, [](const Seg& s) { return s.xh; });
+    int wsel[LW];
+    {
+        int word, offset;
+        lane_start<K2>(lane, word, offset);
+#pragma unroll
+        for (int qq = 0; qq < LW; ++qq) wsel[qq] = (word + qq) % TW;
+    }
+
+    for (int pass = 0; pass < passes; ++pass) {
+        const int m0 = pass * 16, R = min(16, M - m0);
+        const half* x0 = xh + (size_t)(m0 + (g < R ? g : R - 1)) * K + 2 * t;
+        const half* x1 = xh + (size_t)(m0 + (g + 8 < R ? g + 8 : R - 1)) * K + 2 * t;
+        // the ring's first PD steps: weights before griddepcontrol.wait (the previous kernel's tail), inputs after
+#pragma unroll
+        for (int d = 0; d < PD; ++d)
+            if (d < n) req_w<K2>(Ts, lo + d, stage + d * WORDS, lane);
+        if (pass == 0) pdl_wait();
+#pragma unroll
+        for (int d = 0; d < PD; ++d)
+            if (d < n) req_a(x0, x1, lo + d, astg + d * 128 + 4 * lane);
+        cp_commit();
+
+        float acc[8][2][4];
+#pragma unroll
+        for (int i = 0; i < 8; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[i][h][c] = 0.f;
+
+#pragma unroll 1
+        for (int i = 0; i < n; ++i) {
+            const int slot = i % PD;
+            if (i == 0) cp_wait<0>();
+            else cp_wait<PD - 1>();
+            __syncwarp();
+            uint32_t w[8][LW];
+            const uint32_t* st = stage + slot * WORDS;
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+#pragma unroll
+                for (int qq = 0; qq < LW; ++qq) w[j][qq] = st[j * TW + wsel[qq]];
+            const uint4 av = *reinterpret_cast<const uint4*>(astg + slot * 128 + 4 * lane);
+            const uint32_t a[4] = {av.x, av.y, av.z, av.w};
+            __syncwarp();                    // every lane has read the slot: refill it
+            if (i + PD < n) {
+                req_w<K2>(Ts, lo + i + PD, stage + slot * WORDS, lane);
+                req_a(x0, x1, lo + i + PD, astg + slot * 128 + 4 * lane);
+            }
+            cp_commit();
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                uint32_t b0[2], b1[2];
+                decode_lane<K2, 2>(w[j], lane, b0, b1);
+                mma16816(acc[j][0], a, b0);
+                mma16816(acc[j][1], a, b1);
+            }
+        }
+        cp_wait<0>();
+
+        // the warps' partials in warp order, RB rows a round (warp w sums row rlo + w)
+        const int NB = field(tab, sg, [](const Seg& s) { return s.N; }) >> 7;
+        const half* svh = field(tab, sg, [](const Seg& s) { return s.svh; });
+        void* y = field(tab, sg, [](const Seg& s) { return s.y; });
+        const int ld = field(tab, sg, [](const Seg& s) { return s.ld; });
+        const int col0 = nb * 128;
+        for (int rlo = 0; rlo < R; rlo += RB) {
+            __syncthreads();
+            const int gr = g - (rlo & 7);
+            if (gr >= 0 && gr < RB) {
+#pragma unroll
+                for (int i = 0; i < 8; ++i)
+#pragma unroll
+                    for (int h = 0; h < 2; ++h) {
+                        const int col = i * 16 + h * 8 + 2 * t;
+                        *reinterpret_cast<float2*>(red + (warp * RB + gr) * 128 + col) =
+                            rlo >= 8 ? make_float2(acc[i][h][2], acc[i][h][3])
+                                     : make_float2(acc[i][h][0], acc[i][h][1]);
+                    }
+            }
+            __syncthreads();
+            const int r = rlo + warp;
+            if (r < R) {
+                float4 s = *reinterpret_cast<const float4*>(red + warp * 128 + 4 * lane);
+#pragma unroll
+                for (int ww = 1; ww < W; ++ww) {
+                    const float4 v4 = *reinterpret_cast<const float4*>(red + (ww * RB + warp) * 128 + 4 * lane);
+                    s.x += v4.x; s.y += v4.y; s.z += v4.z; s.w += v4.w;
+                }
+                if (SK == 1) {
+                    float v[4] = {s.x, s.y, s.z, s.w};
+                    finish(v, lane, svh, col0 + 4 * lane);
+                    store4(y, y_dtype, (size_t)(m0 + r) * ld + col0 + 4 * lane, v);
+                } else {
+                    *reinterpret_cast<float4*>(Z + ((size_t)(pass * tab.P + p) * RP + r) * 128 + 4 * lane) = s;
+                }
+            }
+        }
+        if (SK > 1) {                        // the strip's last split to arrive sums the SK partials in split order
+            int* cnt = field(tab, sg, [](const Seg& s) { return s.cnt; }) + pass * NB + nb;
+            fence_gpu();
+            __syncthreads();
+            if (threadIdx.x == 0) last = atomicAdd(cnt, 1) == SK - 1;
+            __syncthreads();
+            if (last) {
+                fence_gpu();
+                for (int r = warp; r < R; r += W) {
+                    const float* zp = Z + ((size_t)(pass * tab.P + p - split) * RP + r) * 128 + 4 * lane;
+                    float4 s = __ldcg(reinterpret_cast<const float4*>(zp));
+#pragma unroll 4
+                    for (int j = 1; j < SK; ++j) {
+                        const float4 v4 = __ldcg(reinterpret_cast<const float4*>(zp + (size_t)j * RP * 128));
+                        s.x += v4.x; s.y += v4.y; s.z += v4.z; s.w += v4.w;
+                    }
+                    float v[4] = {s.x, s.y, s.z, s.w};
+                    finish(v, lane, svh, col0 + 4 * lane);
+                    store4(y, y_dtype, (size_t)(m0 + r) * ld + col0 + 4 * lane, v);
+                }
+                if (threadIdx.x == 0) *cnt = 0;
+            }
+        }
+    }
+    pdl_trigger();
+}
+
+// upstream's rot_in for up to MAXSEG (input, suh) pairs (blockIdx.z = segment), a PDL dependent that lets its own
+// dependent (the dense kernel) launch at once: that one's weight prologue overlaps this kernel.
+__global__ void __launch_bounds__(128) rot_in_kernel(const RotTable tab) {
+    pdl_wait();
+    pdl_trigger();
+    RotSeg s = tab.s[0];
+#pragma unroll
+    for (int i = 1; i < MAXSEG; ++i)
+        if (i == (int)blockIdx.z) s = tab.s[i];
+    const int blk = blockIdx.x * 4 + (threadIdx.x >> 5), row = blockIdx.y, lane = threadIdx.x & 31;
+    if (blk * 128 >= s.K) return;
+    const int k = blk * 128 + 4 * lane;
+    float v[4], sc[4];
+    load4(s.x, s.x_dtype, (size_t)row * s.ld + k, v);
+    load4(s.suh, F16, k, sc);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] *= sc[j];
+    fwht128(v, lane);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] *= HAD_SCALE;
+    store4(s.xh, F16, (size_t)row * s.K + k, v);
+}
+
+}  // namespace dsv41_x3dn
+
+#ifndef DSV41_X3DN_NO_TORCH
+
+using namespace dsv41_x3dn;
+
+namespace {
+
+int dtype_of(const at::Tensor& t) {
+    return t.scalar_type() == at::kFloat ? F32 : t.scalar_type() == at::kBFloat16 ? BF16 : F16;
+}
+
+template <typename K, typename... A>
+void launch_ex(K kernel, dim3 grid, dim3 block, int smem, bool pdl, A... args) {
+    cudaLaunchConfig_t cfg = {};
+    cfg.gridDim = grid;
+    cfg.blockDim = block;
+    cfg.dynamicSmemBytes = (size_t)smem;
+    cfg.stream = at::cuda::getCurrentCUDAStream();
+    cudaLaunchAttribute attr[1];
+    attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+    attr[0].val.programmaticStreamSerializationAllowed = 1;
+    cfg.attrs = attr;
+    cfg.numAttrs = pdl ? 1 : 0;
+    C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, kernel, args...));
+}
+
+// the kernel's attributes, once (the schedule only, never a value)
+template <typename K>
+void prepare(K kernel, int smem) {
+    static std::map<const void*, bool> done;
+    if (done.count(reinterpret_cast<const void*>(kernel))) return;
+    if (smem > 48 * 1024)
+        C10_CUDA_CHECK(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem));
+    // the ring lives in shared memory and the weights bypass L1: the largest carveout (3 CTAs an SM at K2 10)
+    C10_CUDA_CHECK(cudaFuncSetAttribute(kernel, cudaFuncAttributePreferredSharedMemoryCarveout,
+                                        (int)cudaSharedmemCarveoutMaxShared));
+    done[reinterpret_cast<const void*>(kernel)] = true;
+}
+
+}  // namespace
+
+void dsv41_x3dn_rot_in_cuda(const std::vector<at::Tensor>& xs, const std::vector<at::Tensor>& suh, at::Tensor& xh,
+                            const std::vector<int64_t>& xh_off, bool pdl) {
+    RotTable tab{};
+    tab.n = (int)xs.size();
+    const int M = (int)xs[0].size(0);
+    int kmax = 0;
+    for (int i = 0; i < tab.n; ++i) {
+        const int K = (int)xs[i].size(1);
+        tab.s[i] = RotSeg{xs[i].data_ptr(), reinterpret_cast<const half*>(suh[i].data_ptr()),
+                          reinterpret_cast<half*>(xh.data_ptr()) + xh_off[i], (long long)xs[i].stride(0), K,
+                          dtype_of(xs[i])};
+        kmax = std::max(kmax, K);
+    }
+    launch_ex(rot_in_kernel, dim3((unsigned)((kmax / 128 + 3) / 4), (unsigned)M, (unsigned)tab.n), dim3(128), 0, pdl,
+              tab);
+}
+
+// meta: 8 ints a segment (K, N, SK, p0, xh_off, c_off, col, K2 check); ys[i]: the segment's output [M, >= col + N]
+void dsv41_x3dn_linear_cuda(const at::Tensor& xh, const std::vector<at::Tensor>& T,
+                            const std::vector<at::Tensor>& svh, const std::vector<at::Tensor>& ys, at::Tensor& Z,
+                            at::Tensor& counters, const std::vector<int64_t>& meta, int64_t programs, int64_t K2,
+                            int64_t PD, bool pdl) {
+    Table tab{};
+    tab.n = (int)T.size();
+    tab.P = (int)programs;
+    const int M = (int)ys[0].size(0);
+    for (int i = 0; i < tab.n; ++i) {
+        const int64_t* m = meta.data() + 8 * i;
+        const size_t esz = ys[i].element_size();
+        tab.s[i] = Seg{reinterpret_cast<const half*>(xh.data_ptr()) + m[4],
+                       reinterpret_cast<const uint32_t*>(T[i].data_ptr()),
+                       reinterpret_cast<const half*>(svh[i].data_ptr()),
+                       static_cast<char*>(ys[i].data_ptr()) + (size_t)m[6] * esz, counters.data_ptr<int>() + m[5],
+                       (long long)((m[0] / 16) * 8 * 4 * K2), (int)m[0], (int)m[1], (int)m[2], (int)m[3],
+                       (int)ys[i].stride(0)};
+    }
+#define TF_DN_LAUNCH(K2_, PD_)                                                                                     \
+    if (K2 == K2_ && PD == PD_) {                                                                                 \
+        auto kernel = dense_kernel<K2_, PD_>;                                                                     \
+        const int smem = smem_words<K2_>(PD_) * 4;                                                                \
+        prepare(kernel, smem);                                                                                    \
+        launch_ex(kernel, dim3((unsigned)programs), dim3(W * 32), smem, pdl, tab, Z.data_ptr<float>(),            \
+                  dtype_of(ys[0]), M);                                                                            \
+        return;                                                                                                   \
+    }
+#define TF_DN_WIDTH(K2_) TF_DN_LAUNCH(K2_, 2) TF_DN_LAUNCH(K2_, 3) TF_DN_LAUNCH(K2_, 4)
+    TF_DN_WIDTH(6) TF_DN_WIDTH(8) TF_DN_WIDTH(10) TF_DN_WIDTH(12) TF_DN_WIDTH(16)
+#undef TF_DN_WIDTH
+#undef TF_DN_LAUNCH
+    TORCH_CHECK(false, "x3dn: unsupported EXL3 width / ring depth: K2=", K2, " PD=", PD);
+}
+#endif  // DSV41_X3DN_NO_TORCH
diff --git a/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp
new file mode 100644
index 0000000..75d46e4
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/x3gm.cpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// Bindings of x3gm.cu (TF_DSV41_FAST_EXPERTS=gm: fast prefill routed experts; x3gm.py).
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void dsv41_x3gm_gateup_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                            const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, bool, int64_t, bool, double);
+void dsv41_x3gm_down_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                          const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t, bool);
+void dsv41_x3gm_rot_cuda(const at::Tensor&, int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&,
+                         at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t, int64_t);
+void dsv41_x3gm_dequant_cuda(const at::Tensor&, at::Tensor&, int64_t, int64_t, int64_t);
+
+static void check(const at::Tensor& x, at::ScalarType t, const char* name) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == t && x.is_contiguous(), name,
+                ": expected a contiguous CUDA tensor of the right dtype");
+}
+
+static void check_plan(const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff, const at::Tensor& pcnt,
+                       const at::Tensor& npass, const at::Tensor& ticket) {
+    check(order, at::kInt, "order");
+    check(pe, at::kInt, "pe");
+    check(poff, at::kInt, "poff");
+    check(pcnt, at::kInt, "pcnt");
+    check(npass, at::kInt, "npass");
+    check(ticket, at::kInt, "ticket");
+}
+
+static void check_words(const at::Tensor& t, int64_t K, int64_t N, int64_t k2, const char* name) {
+    check(t, at::kInt, name);
+    TORCH_CHECK(t.dim() == 4 && t.size(1) * 16 == K && t.size(2) * 16 == N && t.size(3) == 4 * k2, name,
+                ": trellis words [E, K/16, N/16, 4 K2]");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(t.data_ptr()) % 16 == 0, name, ": 16-byte aligned");
+}
+
+// Xd [P, N] = fp16 rotated SwiGLU of gate / up (K = D, N = this rank's width); shx: xg feeds both matrices
+void gateup(const at::Tensor& xg, const at::Tensor& xu, const at::Tensor& tg, const at::Tensor& tu,
+            const at::Tensor& order, const at::Tensor& pe, const at::Tensor& poff, const at::Tensor& pcnt,
+            const at::Tensor& npass, const at::Tensor& ticket, const at::Tensor& svh_g, const at::Tensor& svh_u,
+            const at::Tensor& suh_d, at::Tensor xd, int64_t K, int64_t N, int64_t k2, bool shx, int64_t cfg,
+            bool use_ticket, double limit) {
+    check(xg, at::kHalf, "xg");
+    check(xu, at::kHalf, "xu");
+    check_words(tg, K, N, k2, "tg");
+    check_words(tu, K, N, k2, "tu");
+    TORCH_CHECK(tg.sizes() == tu.sizes(), "gate and up trellis shapes");
+    check_plan(order, pe, poff, pcnt, npass, ticket);
+    check(svh_g, at::kHalf, "svh_g");
+    check(svh_u, at::kHalf, "svh_u");
+    check(suh_d, at::kHalf, "suh_d");
+    check(xd, at::kHalf, "xd");
+    TORCH_CHECK(xg.size(-1) == K && xd.size(-1) == N && xd.size(0) >= order.size(0) && xg.size(0) >= order.size(0),
+                "gateup: X [P, K], Xd [P, N]");
+    TORCH_CHECK(svh_g.size(-1) == N && svh_u.size(-1) == N && suh_d.size(-1) == N, "gateup: scales [E, N]");
+    TORCH_CHECK(cfg >= 0 && cfg < 6, "gateup: cfg 0..5 (x3gm.cu GM_GU*)");
+    c10::cuda::CUDAGuard guard(xg.device());
+    dsv41_x3gm_gateup_cuda(xg, xu, tg, tu, order, pe, poff, pcnt, npass, ticket, svh_g, svh_u, suh_d, xd, K, N, k2,
+                           shx, cfg, use_ticket, limit);
+}
+
+// Y [P, N] fp32 = the down projection of Xd (K = this rank's width, N = D), * svh_d
+void down(const at::Tensor& xd, const at::Tensor& td, const at::Tensor& order, const at::Tensor& pe,
+          const at::Tensor& poff, const at::Tensor& pcnt, const at::Tensor& npass, const at::Tensor& ticket,
+          const at::Tensor& svh_d, at::Tensor y, int64_t K, int64_t N, int64_t k2, int64_t cfg, bool use_ticket) {
+    check(xd, at::kHalf, "xd");
+    check_words(td, K, N, k2, "td");
+    check_plan(order, pe, poff, pcnt, npass, ticket);
+    check(svh_d, at::kHalf, "svh_d");
+    check(y, at::kFloat, "y");
+    TORCH_CHECK(xd.size(-1) == K && y.size(-1) == N && y.size(0) >= order.size(0) && xd.size(0) >= order.size(0),
+                "down: Xd [P, K], Y [P, N]");
+    TORCH_CHECK(svh_d.size(-1) == N, "down: svh_d [E, N]");
+    TORCH_CHECK(cfg >= 0 && cfg < 5, "down: cfg 0..4 (x3gm.cu GM_DN*)");
+    c10::cuda::CUDAGuard guard(xd.device());
+    dsv41_x3gm_down_cuda(xd, td, order, pe, poff, pcnt, npass, ticket, svh_d, y, K, N, k2, cfg, use_ticket);
+}
+
+// out_m [pairs, K] fp16 = rotated x rows of the routed pairs (mats 1: out0 only)
+void rot(const at::Tensor& x, int64_t x_stride, const at::Tensor& pick, const at::Tensor& suh0, const at::Tensor& suh1,
+         at::Tensor out0, at::Tensor out1, int64_t K, int64_t slots, int64_t pairs, int64_t mats) {
+    TORCH_CHECK(x.is_cuda() && (x.scalar_type() == at::kBFloat16 || x.scalar_type() == at::kHalf), "x: bf16/fp16");
+    check(pick, at::kInt, "pick");
+    check(suh0, at::kHalf, "suh0");
+    check(suh1, at::kHalf, "suh1");
+    check(out0, at::kHalf, "out0");
+    check(out1, at::kHalf, "out1");
+    TORCH_CHECK(K % 128 == 0 && pick.numel() >= pairs && out0.numel() >= pairs * K && (mats == 1 || mats == 2) &&
+                (mats == 1 || out1.numel() >= pairs * K), "rot: shapes");
+    c10::cuda::CUDAGuard guard(x.device());
+    dsv41_x3gm_rot_cuda(x, x_stride, pick, suh0, suh1, out0, out1, K, slots, pairs, mats);
+}
+
+void dequant(const at::Tensor& t, at::Tensor out, int64_t k2) {
+    check(out, at::kHalf, "out");
+    const int64_t K = out.size(0), N = out.size(1);
+    check(t, at::kInt, "t");
+    TORCH_CHECK(K % 16 == 0 && N % 16 == 0 && t.numel() == K * N / 256 * 4 * k2, "dequant: words [K/16, N/16, 4 K2]");
+    c10::cuda::CUDAGuard guard(t.device());
+    dsv41_x3gm_dequant_cuda(t, out, K, N, k2);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("gateup", &gateup);
+    m.def("down", &down);
+    m.def("rot", &rot);
+    m.def("dequant", &dequant);
+}
