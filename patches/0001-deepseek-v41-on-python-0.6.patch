@@ -0,0 +1,241 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""x3dn v2 (``dense``, TF_DSV41_DENSE) without a GPU: ``dsv41_x3dn_emu`` runs the kernel's programs, warp
+ranges, rings and reductions over ``dense.layout``'s own tables.
+
+- the plans: every real shape's K splits (``SPLITS``; the rule elsewhere; the SPLIT override); tables tile their
+  scratch; one launch a width;
+- the programs: every warp's ring slot holds the k step its mma chain consumes; every output element is written once,
+  counters end at zero, in any program order and ring depth;
+- the bits: equal across orders and ring depths; a row alone == the same row in a window (1-32 rows, both passes); a
+  matrix's outputs are the same alone and in any group (x2 vs x4); within fp32 rounding of float64 and of upstream's
+  kernel (another order); a different SK gives other bits at rounding level;
+- the real pack's layer-1 wq_a + wkv and wo_a (``TF_DSV41_PACK_CACHE``), against float64 and upstream.
+
+Run: python -m pytest -q tests/test_dsv41_dense_emu.py
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from itertools import pairwise
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+import dsv41_x3dn_emu as X  # noqa: E402
+import dsv41_x3seg_emu as E  # noqa: E402
+
+from tensorfold.cuda.exl3.linear import plan  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import dense as D  # noqa: E402
+
+WQ_A, WKV, COMP, WQ_B, IX_WQ_B, WO_A, WO_B = ((5120, 1280), (5120, 512), (5120, 512), (1280, 16384), (1280, 4096),
+                                             (4096, 1024), (4096, 5120))
+
+
+def _case(rng, segs, m: int, shared_x: bool):
+    xs, suh, W, svh = [], [], [], []
+    x0 = None
+    for s in segs:
+        if shared_x and x0 is not None and x0.shape[1] == s.k:
+            x = x0
+        else:
+            x = (rng.standard_normal((m, s.k)) * 0.7).astype(np.float32)
+            x0 = x
+        xs.append(x)
+        suh.append(np.where(rng.random(s.k) < 0.5, -1.0, 1.0).astype(np.float16))
+        W.append(rng.standard_normal((s.k, s.n)).astype(np.float16).astype(np.float64))
+        svh.append((rng.random(s.n) * 0.02 + 0.01).astype(np.float16).astype(np.float32))
+    return xs, suh, W, svh
+
+
+def _widths(segs):
+    w: dict[int, int] = {}
+    for s in segs:
+        w[s.out] = max(w.get(s.out, 0), s.col + s.n)
+    return [w[o] for o in sorted(w)]
+
+
+def _run(segs, xs, suh, W, svh, m, pd=3, seed=0):
+    lay = D.layout(segs, m)
+    ys, mem = X.dense(xs, suh, W, svh, segs, lay, _widths(segs), pd=pd, seed=seed)
+    assert all((w == 1).all() for w in mem.writes), "every output element written once"
+    assert not mem.counters.any(), "counters back to zero"
+    return ys
+
+
+def seg(k, n, out=0, col=0, k2=10, sk=None):
+    return D.Seg(k, n, k2, D.split_of(k, n) if sk is None else sk, out, col)
+
+
+def _bits(a):
+    return a.view(np.uint32)
+
+
+# -- plans and tables ----------------------------------------------------------------------------------------------
+def test_real_shapes_plans():
+    want = {WQ_A: 4, WKV: 4, WQ_B: 1, IX_WQ_B: 2, WO_A: 2, WO_B: 2}
+    for (k, n), sk in want.items():
+        assert D.split_of(k, n) == sk and (k // 16) // sk // 4 >= 10, (k, n)
+    assert D.split_of(5120, 64640) == 1 and D.split_of(6144, 25600) == 1 and D.split_of(512, 128) == 1
+    assert D.split_of(4096, 5120, {D.ENV + "_SPLIT": "4096x5120:1, 5120x1280:8"}) == 1
+    assert D.split_of(5120, 1280, {D.ENV + "_SPLIT": "4096x5120:1,5120x1280:8"}) == 8
+    with pytest.raises(ValueError):
+        D.split_of(4096, 5120, {D.ENV + "_SPLIT": "4096:1"})
+    for k, n in ((2048, 256), (1024, 4096), (768, 128)):            # the rule: >= 48 programs, >= 8 steps a warp
+        sk = D.split_of(k, n)
+        assert 1 <= sk <= 8 and ((n // 128) * sk >= 48 or sk == 8 or (k // 16) // sk // 4 < 16)
+
+
+def test_real_groups_tile_their_scratch():
+    x4 = [seg(*WQ_A, 0), seg(*WKV, 1), seg(*COMP, 2), seg(*COMP, 2, 512)]
+    q = [seg(*WQ_B, 0), seg(*IX_WQ_B, 1)]
+    o = [seg(*WO_A, 0, 1024 * g) for g in range(4)]
+    for segs, programs in ((x4, 40 + 3 * 16), (q, 128 + 64), (o, 4 * 16), ([seg(*WO_B)], 80)):
+        for m in (1, 5, 16, 17, 32):
+            lay = D.layout(segs, m)
+            assert len(lay.launches) == 1 and lay.launches[0][3] == programs
+            spans = sorted((lay.xh_off[i], lay.xh_off[i] + m * s.k) for i, s in enumerate(segs))
+            assert spans[0][0] == 0 and spans[-1][1] == lay.xh_total and all(a[1] == b[0] for a, b in pairwise(spans))
+            cs = sorted((lay.c_off[i], lay.c_off[i] + 2 * s.n // 128) for i, s in enumerate(segs))
+            assert all(a[1] == b[0] for a, b in pairwise(cs)) and cs[-1][1] == lay.c_total
+            split = any(s.sk > 1 for s in segs)
+            assert lay.z_total == (X.passes(m) * programs * min(m, 16) * 128 if split else 0)
+    mixed = D.layout([seg(*WQ_A, k2=12), seg(*WKV, k2=12), seg(512, 128, k2=16)], 3)
+    assert [l[0] for l in mixed.launches] == [12, 16]
+    with pytest.raises(ValueError):
+        D.layout([D.Seg(128, 128, 10, 9)], 1)                      # more splits than k steps
+    with pytest.raises(ValueError):
+        D.layout([seg(*WQ_A)], D.ROWS + 1)
+
+
+def test_knobs():
+    assert D.scope({}) == "0" and D.scope({D.ENV: "attn"}) == "attn" and D.scope({D.ENV: "1"}) == "attn"
+    assert D.scope({D.ENV: "all"}) == "all"
+    with pytest.raises(ValueError):
+        D.scope({D.ENV: "yes"})
+    assert D.pd({}) == 3 and D.pdl({}) and not D.pdl({D.ENV + "_PDL": "0"})
+    with pytest.raises(ValueError):
+        D.pd({D.ENV + "_PD": "5"})
+
+
+# -- programs and bits ----------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("m", [1, 3, 16, 17, 32])
+def test_any_order_and_ring_depth_same_bits(m):
+    rng = np.random.default_rng(m)
+    segs = [seg(1024, 256, 0, sk=3), seg(1024, 128, 1, sk=1), seg(256, 384, 2, sk=2), seg(128, 128, 3, sk=5)]
+    xs, suh, W, svh = _case(rng, segs, m, shared_x=False)
+    ref = _run(segs, xs, suh, W, svh, m, seed=0)
+    for pd, sd in ((2, 1), (4, 2), (3, 3)):
+        got = _run(segs, xs, suh, W, svh, m, pd=pd, seed=sd)
+        for a, b in zip(ref, got):
+            assert np.array_equal(_bits(a), _bits(b)), (pd, sd)
+    for i, s in enumerate(segs):                          # near the float64 reference
+        want = X.reference(xs[i], suh[i], W[i], svh[i])
+        assert np.abs(ref[i] - want).max() <= 2e-5 * np.abs(want).max()
+
+
+def test_row_invariance():
+    rng = np.random.default_rng(7)
+    segs = [seg(1024, 256, 0, sk=4), seg(512, 128, 1, sk=1)]
+    xs, suh, W, svh = _case(rng, segs, 32, shared_x=False)
+    whole = _run(segs, xs, suh, W, svh, 32, seed=5)
+    for r in (0, 5, 15, 16, 31):
+        alone = _run(segs, [x[r:r + 1] for x in xs], suh, W, svh, 1, seed=r)
+        for a, w in zip(alone, whole):
+            assert np.array_equal(_bits(a), _bits(w[r:r + 1])), r
+    part = _run(segs, [x[3:8] for x in xs], suh, W, svh, 5, seed=9)
+    for a, w in zip(part, whole):
+        assert np.array_equal(_bits(a), _bits(w[3:8]))
+
+
+def test_a_matrix_has_its_bits_in_any_group():
+    """x2 (wq_a + wkv) vs x4 (+ the compressor): wq_a / wkv identical; a group == each matrix alone."""
+
+    rng = np.random.default_rng(11)
+    k = 1024
+    x4 = [seg(k, 384, 0, sk=2), seg(k, 128, 1, sk=4), seg(k, 128, 2, sk=4), seg(k, 128, 2, 128, sk=4)]
+    xs, suh, W, svh = _case(rng, x4, 4, shared_x=True)
+    big = _run(x4, xs, suh, W, svh, 4, seed=1)
+    small = _run(x4[:2], xs[:2], suh[:2], W[:2], svh[:2], 4, seed=2)
+    assert np.array_equal(_bits(big[0]), _bits(small[0])) and np.array_equal(_bits(big[1]), _bits(small[1]))
+    for i in range(2):
+        alone = _run([D.Seg(k, x4[i].n, 10, x4[i].sk)], [xs[i]], [suh[i]], [W[i]], [svh[i]], 4, seed=3 + i)
+        assert np.array_equal(_bits(alone[0]), _bits(big[i]))
+
+
+def test_against_upstream_and_other_splits_is_rounding_only():
+    rng = np.random.default_rng(13)
+    s = seg(4096, 256, sk=2)
+    xs, suh, W, svh = _case(rng, [s], 5, shared_x=False)
+    ours = _run([s], xs, suh, W, svh, 5)[0]
+    one = _run([D.Seg(4096, 256, 10, 1)], xs, suh, W, svh, 5)[0]
+    sk, wk = plan(s.k, s.n)
+    up = E.upstream(xs[0], suh[0], W[0], svh[0], sk, wk)
+    want = X.reference(xs[0], suh[0], W[0], svh[0])
+    assert not np.array_equal(ours, up) and not np.array_equal(ours, one)     # other summation orders
+    scale = np.abs(want).max()
+    for y in (ours, one, up):
+        assert np.abs(y - want).max() <= 2e-5 * scale
+
+
+# -- the real pack's layer 1 (wq_a + wkv: K 5,120, 20 atoms; wo_a: K 4,096, 16 atoms) --------------------------------
+def _pack() -> Path | None:
+    p = os.environ.get("TF_DSV41_PACK_CACHE", "").strip()
+    return Path(p) if p and (Path(p) / "headers.json").is_file() else None
+
+
+def _tensor(root: Path, wm: dict, info: dict, name: str) -> np.ndarray:
+    key = hashlib.sha1(f"{wm[name]}:{name}".encode()).hexdigest()[:16]
+    dt, shape = info[name]
+    raw = (root / "tensors" / f"{key}.bin").read_bytes()
+    return np.frombuffer(raw, dtype={"I16": np.int16, "F16": np.float16}[dt]).reshape(shape)
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached layer-1 tensors")
+@pytest.mark.parametrize("group", ["x", "wo_a"])
+def test_real_layer1(group):
+    from tensorfold.cuda.exl3 import format as fmt
+
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: (e["dtype"], tuple(e["shape"])) for v in m["headers"].values() for n, e in v["header"].items()
+            if n != "__metadata__"}
+    names = ["wq_a", "wkv"] if group == "x" else [f"wo_a.slice.{g}" for g in range(4)]
+    segs, suh, W, svh = [], [], [], []
+    col = 0
+    for i, nm in enumerate(names):
+        p = f"layers.1.attn.{nm}"
+        tr = _tensor(root, wm, info, f"{p}.trellis")
+        bits = fmt.bits_of(tr.shape)
+        k, n = 16 * tr.shape[0], 16 * tr.shape[1]
+        segs.append(seg(k, n, i if group == "x" else 0, 0 if group == "x" else col, k2=int(2 * bits)))
+        col += n
+        W.append(fmt.unpack(tr, bits, "mul1").astype(np.float64))
+        suh.append(_tensor(root, wm, info, f"{p}.suh"))
+        svh.append(_tensor(root, wm, info, f"{p}.svh").astype(np.float32))
+    rng = np.random.default_rng(1)
+    rows = 3
+    if group == "x":
+        x = (rng.standard_normal((rows, 5120)) * 0.7).astype(np.float32)
+        xs = [x, x]
+    else:
+        o = (rng.standard_normal((rows, 4 * 4096)) * 0.3).astype(np.float32)
+        xs = [o[:, g * 4096:(g + 1) * 4096] for g in range(4)]
+    ys = _run(segs, xs, suh, W, svh, rows)
+    c = 0
+    for i, s in enumerate(segs):
+        y = ys[s.out][:, s.col:s.col + s.n]
+        want = X.reference(xs[i], suh[i], W[i], svh[i])
+        sk, wk = plan(s.k, s.n)
+        up = E.upstream(xs[i], suh[i], W[i], svh[i], sk, wk)
+        scale = np.abs(want).max()
+        assert np.abs(y - want).max() <= 2e-5 * scale and np.abs(y - up).max() <= 2e-5 * scale, nm
+        c += 1
+    assert c == len(segs)
