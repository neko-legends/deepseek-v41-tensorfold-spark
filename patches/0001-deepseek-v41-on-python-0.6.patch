--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/rope_fused.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The query / index-query RoPE of ``rope.Table.apply`` as one Triton launch (G4: the torch form is ~10 launches and
+two full copies a call, twice a layer on the index layers).
+
+Bit for bit the torch form: every value is fp32 (bf16 inputs widen exactly), the NoPE dims are rounded to the output
+dtype unchanged, each rotated pair is ``(even * cos - odd * sin, odd * cos + even * sin)`` with every product and sum
+rounded once (``enable_fp_fusion=False``: no FMA contraction, as torch's separate kernels), cos / sin the table's own
+fp32 entries at the row's position (``inverse``: -sin, as ``apply``), one round to bf16 (nearest even). One program a
+(row, head block): a row's output depends on that row alone.
+
+``rope.Table.apply`` calls it on CUDA for [T, H, Dh] inputs with bf16 output (``TF_DSV41_ROPE_FUSED``, 1 = on);
+elsewhere, and for any other shape or dtype, the torch form runs.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+LAUNCH = {"enable_fp_fusion": False}
+BH = 4                  # heads a program
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_ROPE_FUSED", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _rope(X, x_rs, x_hs, OUT, o_rs, o_hs, CS, cs_rs, POS, H, NOPE: tl.constexpr, NB: tl.constexpr,
+          HALF: tl.constexpr, BH: tl.constexpr, INV: tl.constexpr, COPY: tl.constexpr = True,
+          PDL: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    h = tl.program_id(1) * BH + tl.arange(0, BH)
+    hm = h < H
+    xr = X + r.to(tl.int64) * x_rs + h.to(tl.int64)[:, None] * x_hs
+    orow = OUT + r.to(tl.int64) * o_rs + h.to(tl.int64)[:, None] * o_hs
+    d = tl.arange(0, NB)
+    if COPY:                                                            # in place (bf16): the NoPE dims stay
+        for c in range(0, NOPE, NB):                                    # the NoPE dims: one rounding to bf16
+            m = hm[:, None] & ((c + d)[None, :] < NOPE)
+            v = tl.load(xr + c + d[None, :], mask=m, other=0.0).to(tl.float32)
+            tl.store(orow + c + d[None, :], v.to(tl.bfloat16), mask=m)
+    pos = tl.load(POS + r).to(tl.int64)
+    j = tl.arange(0, HALF)
+    cs = tl.load(CS + pos * cs_rs + j)
+    sn = tl.load(CS + pos * cs_rs + HALF + j)
+    if INV:
+        sn = -sn
+    m = hm[:, None]
+    ev = tl.load(xr + NOPE + 2 * j[None, :], mask=m, other=0.0).to(tl.float32)
+    od = tl.load(xr + NOPE + 2 * j[None, :] + 1, mask=m, other=0.0).to(tl.float32)
+    a = ev * cs[None, :] - od * sn[None, :]
+    b = od * cs[None, :] + ev * sn[None, :]
+    tl.store(orow + NOPE + 2 * j[None, :], a.to(tl.bfloat16), mask=m)
+    tl.store(orow + NOPE + 2 * j[None, :] + 1, b.to(tl.bfloat16), mask=m)
+
+
+def apply(x: torch.Tensor, cs: torch.Tensor, positions: torch.Tensor, rope_dim: int,
+          inverse: bool = False) -> torch.Tensor:
+    """x [T, H, Dh] (bf16 or fp32, unit stride in Dh), cs [max_pos, rope_dim] fp32, positions [T] -> bf16 [T, H, Dh]
+    with the last ``rope_dim`` dims rotated."""
+
+    T, H, Dh = x.shape
+    if x.stride(2) != 1:
+        x = x.contiguous()
+    out = torch.empty((T, H, Dh), dtype=torch.bfloat16, device=x.device)
+    if T == 0:
+        return out
+    pos = positions.reshape(-1).to(device=x.device, dtype=torch.long)
+    _rope[(T, triton.cdiv(H, BH))](x, x.stride(0), x.stride(1), out, out.stride(0), out.stride(1), cs, cs.stride(0),
+                                    pos, H, NOPE=Dh - rope_dim, NB=64, HALF=rope_dim // 2, BH=BH, INV=bool(inverse),
+                                    num_warps=4, **LAUNCH, **P.triton_kw())
+    return out
+
+
+def apply_(x: torch.Tensor, cs: torch.Tensor, positions: torch.Tensor, rope_dim: int,
+           inverse: bool = False) -> torch.Tensor:
+    """``apply`` into x itself: x bf16 [T, H, Dh] (unit stride in Dh); only the last ``rope_dim`` dims are written."""
+
+    T, H, Dh = x.shape
+    if x.dtype != torch.bfloat16 or x.stride(2) != 1:
+        raise ValueError("rope_fused.apply_: bf16 [T, H, Dh] with unit-stride Dh")
+    if T == 0:
+        return x
+    pos = positions.reshape(-1).to(device=x.device, dtype=torch.long)
+    _rope[(T, triton.cdiv(H, BH))](x, x.stride(0), x.stride(1), x, x.stride(0), x.stride(1), cs, cs.stride(0),
+                                    pos, H, NOPE=Dh - rope_dim, NB=64, HALF=rope_dim // 2, BH=BH, INV=bool(inverse),
+                                    COPY=False, num_warps=4, **LAUNCH, **P.triton_kw())
+    return x
+
+
+def eligible(x: torch.Tensor, positions: torch.Tensor, rope_dim: int, dtype) -> bool:
+    """Where ``Table.apply`` may use the kernel: CUDA, [T, H, Dh] with Dh - rope_dim a multiple of 64 (or 0), bf16 out."""
+
+    return (x.is_cuda and x.dim() == 3 and dtype == torch.bfloat16 and x.dtype in (torch.float32, torch.bfloat16)
+            and rope_dim % 2 == 0 and (rope_dim // 2) & (rope_dim // 2 - 1) == 0 and (x.shape[2] - rope_dim) % 64 == 0
+            and x.shape[2] >= rope_dim and positions.numel() == x.shape[0] and enabled())
+
+
+__all__ = ["apply", "apply_", "eligible", "enabled"]
