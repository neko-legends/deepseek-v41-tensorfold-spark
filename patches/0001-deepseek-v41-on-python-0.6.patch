diff --git a/src/tensorfold/families/deepseek_v41/cuda/phases.py b/src/tensorfold/families/deepseek_v41/cuda/phases.py
new file mode 100644
index 0000000..6587224
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/phases.py
@@ -0,0 +1,140 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Per-phase step timers for the V4.1 serving path: where every millisecond of a round goes.
+
+``TF_DSV41_PHASES``:
+
+- ``0`` (default): off; ``PH("name")`` is a shared no-op context (one attribute read and a call a phase);
+- ``1``: host wall time of each phase (``time.perf_counter``): what the round thread spends, including waits for
+  the GPU at the phases that synchronize (the candidates' D2H copy, the drafts' ``.cpu()``);
+- ``sync``: ``torch.cuda.synchronize()`` at both ends of every phase, so each phase's time is its own GPU work plus
+  its host work, and the phases add up to the round (the A/B of graphs, Engram overlap and exchanges). It removes
+  the overlap it measures: use it to attribute, ``1`` to measure throughput;
+- ``nvtx``: ``1`` plus an NVTX range a phase (nsys timelines: G4's profile step).
+
+Phases nest (``round`` > ``execute`` > ``window`` > ``forward``); a report gives each name's total ms, count and mean,
+and the sum of the top-level phases next to the wall time between ``reset`` and ``report``.
+
+Names used (``batch`` / ``rounds`` / ``decode`` / ``graphs``): round, plan, share, execute, commit, prefill, draft,
+draft.pass, draft.depth, grammar, prefetch, window, engram.wait, forward, graph.stage, graph.replay, graph.capture,
+candidates, nucleus, sample.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+from contextlib import nullcontext
+
+ENV = "TF_DSV41_PHASES"
+_NULL = nullcontext()
+
+
+class _Timer:
+    __slots__ = ("ph", "name", "t0")
+
+    def __init__(self, ph: "Phases", name: str) -> None:
+        self.ph, self.name, self.t0 = ph, name, 0.0
+
+    def __enter__(self):
+        if self.ph.sync:
+            self.ph._sync()
+        if self.ph.nvtx:
+            self.ph._nvtx(self.name)
+        self.t0 = time.perf_counter()
+        return self
+
+    def __exit__(self, *exc) -> bool:
+        if self.ph.sync:
+            self.ph._sync()
+        if self.ph.nvtx:
+            self.ph._nvtx(None)
+        self.ph.add(self.name, time.perf_counter() - self.t0)
+        return False
+
+
+class Phases:
+    """The timers (one per process: both ranks keep their own)."""
+
+    def __init__(self, mode: str = "0") -> None:
+        mode = (mode or "0").strip().lower()
+        if mode not in ("0", "1", "sync", "nvtx"):
+            raise ValueError(f"{ENV}={mode!r}: expected 0, 1, sync or nvtx")
+        self.on = mode != "0"
+        self.sync = mode == "sync"
+        self.nvtx = mode == "nvtx"
+        self.total: dict[str, float] = {}
+        self.count: dict[str, int] = {}
+        self.t0 = time.perf_counter()
+
+    @classmethod
+    def from_env(cls) -> "Phases":
+        return cls(os.environ.get(ENV, "0"))
+
+    def __call__(self, name: str):
+        return _Timer(self, name) if self.on else _NULL
+
+    def add(self, name: str, seconds: float) -> None:
+        self.total[name] = self.total.get(name, 0.0) + seconds
+        self.count[name] = self.count.get(name, 0) + 1
+
+    def _nvtx(self, name: str | None) -> None:
+        try:
+            import torch
+
+            if name is None:
+                torch.cuda.nvtx.range_pop()
+            else:
+                torch.cuda.nvtx.range_push(name)
+        except Exception:                               # noqa: BLE001
+            pass
+
+    def _sync(self) -> None:
+        try:
+            import torch
+
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+        except Exception:                               # noqa: BLE001 - a timer must never stop serving
+            pass
+
+    def reset(self) -> None:
+        self.total.clear()
+        self.count.clear()
+        self.t0 = time.perf_counter()
+
+    def report(self) -> dict:
+        """{name: {ms, n, ms_avg}} plus ``wall_ms`` since the reset and ``mode``."""
+
+        out: dict = {"mode": "sync" if self.sync else ("nvtx" if self.nvtx else ("1" if self.on else "0")),
+                     "wall_ms": round((time.perf_counter() - self.t0) * 1e3, 2)}
+        for name in sorted(self.total):
+            n = self.count[name]
+            ms = self.total[name] * 1e3
+            out[name] = {"ms": round(ms, 2), "n": n, "ms_avg": round(ms / max(n, 1), 3)}
+        return out
+
+    def describe(self) -> str:
+        if not self.on:
+            return "phases off"
+        r = self.report()
+        rounds = r.get("round", {}).get("n", 0)
+        keys = [k for k in r if isinstance(r[k], dict)]
+        per = ", ".join(f"{k} {r[k]['ms'] / max(rounds, 1):.2f}" for k in keys)
+        return f"phases ({r['mode']}, ms a round over {rounds} rounds): {per}"
+
+
+PH = Phases.from_env()
+
+
+def reload() -> Phases:
+    """Re-read TF_DSV41_PHASES (tests, benches that set it after import)."""
+
+    global PH
+    new = Phases.from_env()
+    PH.on, PH.sync, PH.nvtx = new.on, new.sync, new.nvtx
+    PH.reset()
+    return PH
+
+
+__all__ = ["ENV", "PH", "Phases", "reload"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pick.py b/src/tensorfold/families/deepseek_v41/cuda/pick.py
new file mode 100644
index 0000000..af3fb56
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pick.py
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Logits as the kit sees them, and a top-k whose ties go to the lower token id.
+
+The kit's head (an EXL3 linear) returns bf16 logits, and vLLM's greedy sampler takes their ``argmax``: the first
+(lowest) id among equal values. Its ``prompt_logprobs`` show it: every top-1 / top-2 margin is a multiple of 1/16
+(G2: 0, 0.125, 0.25, ... 1.5625), and at all 8 exact ties among G2's first-copy misses the kit took the lower id while
+our fp32 logits took the higher one. So the forward rounds the head's output to bf16 (``numerics.LOGITS``) and every
+choice uses ``top``: value descending, then id ascending, whatever the kernel's own tie order.
+
+``keys`` maps bf16-valued fp32 logits to int32 keys that sort the same way: the float's order-preserving integer image
+with its low 16 bits (zero for bf16 values) replaced by ``65535 - column``. A rank's vocabulary half (64,640 columns)
+fits; wider rows (one-rank tests with a large vocabulary, or float64 logits of the exact twins) take a stable sort.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from . import numerics as N
+
+COLS = 1 << 16
+
+
+def kit_logits(x: torch.Tensor) -> torch.Tensor:
+    """The head's fp32 output rounded through ``numerics.LOGITS`` (bf16; float64 = unchanged in ``exact()``)."""
+
+    if N.LOGITS == x.dtype or N.LOGITS == N.ACC:
+        return x
+    return x.to(N.LOGITS).to(x.dtype)
+
+
+def keys(lg: torch.Tensor) -> torch.Tensor:
+    """int32 [R, C] keys of bf16-valued fp32 logits [R, C]: larger key = larger value, then lower column."""
+
+    bits = (lg + 0.0).contiguous().view(torch.int32)          # -0.0 + 0.0 = +0.0: equal values, equal keys
+    mono = torch.where(bits >= 0, bits, bits ^ 0x7FFFFFFF)
+    col = torch.arange(lg.shape[-1], device=lg.device, dtype=torch.int32)
+    return (mono & -COLS) | (COLS - 1 - col)
+
+
+def _bf16_valued(lg: torch.Tensor) -> bool:
+    """fp32 logits the forward rounded (``kit_logits`` with LOGITS = bf16), on 16-bit columns (no device sync)."""
+
+    return lg.dtype == torch.float32 and N.LOGITS == torch.bfloat16 and lg.shape[-1] <= COLS
+
+
+def top(lg: torch.Tensor, k: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """(values, columns) of each row's best ``k``: value descending, ties by the lower column. ``lg`` must come from
+    ``kit_logits`` (or be any float tensor when LOGITS is not bf16: a stable sort then)."""
+
+    k = min(int(k), lg.shape[-1])
+    if _bf16_valued(lg):
+        _, cols = torch.topk(keys(lg), k, dim=-1)
+    else:
+        _, cols = torch.sort(lg, dim=-1, descending=True, stable=True)
+        cols = cols[..., :k]
+    return torch.gather(lg, -1, cols), cols
+
+
+def argmax(lg: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """(value, column) of each row's maximum, the lowest column among equal values."""
+
+    v, c = top(lg, 1)
+    return v[..., 0], c[..., 0]
+
+
+def kit_partial(x: torch.Tensor) -> torch.Tensor:
+    """A rank's fp32 partial (attention ``wo_b``, the MoE) as the kit exchanges it: bf16 (vLLM's row-parallel output
+    before its bf16 all-reduce; the mHC boundary then rounds the sum to bf16 as the all-reduce does). Unchanged when
+    ``numerics.KIT_ROUNDING`` is off (and in ``exact()``)."""
+
+    if not N.KIT_ROUNDING or x.dtype != torch.float32:
+        return x
+    return x.to(torch.bfloat16).to(torch.float32)
+
+
+def kit_weights(w: torch.Tensor) -> torch.Tensor:
+    """Routed expert weights (renormalized x 1.5) as the kit's EXL3 expert kernels take them: fp16."""
+
+    if not N.KIT_ROUNDING or w.dtype not in (torch.float32, torch.float64):
+        return w
+    return w.to(torch.float16).to(w.dtype)
+
+
+PAD = (1 << 31) - 1     # a padded candidate's id: after every real id (``vsample.ID_MAX``), never a token
+
+
+def widest(vocab: int, world: int) -> int:
+    """The widest rank's vocabulary columns (``weights.block_bounds``: rank 0 holds the extra 128-blocks)."""
+
+    if world <= 1:
+        return int(vocab)
+    from .weights import block_bounds
+
+    lo, hi = block_bounds(int(vocab), int(world), 0)
+    return hi - lo
+
+
+def rank_top(lg: torch.Tensor, count: int, lo: int, wide: int) -> tuple[torch.Tensor, torch.Tensor, int]:
+    """This rank's share of a top-``count`` exchange over the ranks' vocabulary slices: (values, int32 ids, k) with
+    the same ``k = min(count, wide)`` on every rank (``wide``: ``widest``), so the all-gather's sizes agree when the
+    slices are uneven (TP=4: 32,384 / 32,384 / 32,256 / 32,256). A narrower slice pads its rows with (-inf, ``PAD``),
+    which sort after every real candidate, -inf ones included; callers take at most the vocabulary's count."""
+
+    k = min(int(count), int(wide))
+    vals, ids = top(lg, k)
+    ids = (ids + lo).to(torch.int32)
+    short = k - vals.shape[-1]
+    if short > 0:
+        R = vals.shape[0]
+        vals = torch.cat([vals, torch.full((R, short), float("-inf"), dtype=vals.dtype, device=vals.device)], 1)
+        ids = torch.cat([ids, torch.full((R, short), PAD, dtype=torch.int32, device=ids.device)], 1)
+    return vals, ids, k
+
+
+__all__ = ["PAD", "argmax", "keys", "kit_logits", "kit_partial", "kit_weights", "rank_top", "top", "widest"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pipe.py b/src/tensorfold/families/deepseek_v41/cuda/pipe.py
new file mode 100644
index 0000000..65c796f
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pipe.py
@@ -0,0 +1,528 @@
+# SPDX-License-Identifier: MIT
+"""Pipelined prompt reading (``TF_DSV41_PREFILL_PIPE=<rows>``, 0 = off): CED's encoder pass as an assembly line.
+
+Tensor parallelism splits every layer W ways, yet the indexer (32 heads), the compressor and the single KV head's
+projections, the mHC streams and the selections run in full on every rank, and every sublayer ends in an all-gather.
+Here rank s also holds encoder layers [B[s], B[s + 1]) at full width (a second copy, ~27 GB a rank at W = 4: the
+encoder half of the model) and one prompt's segments flow rank 0 -> W - 1: in pipeline round t, rank s runs segment
+t - s through its layers. The last stage ends at the decoder's first layer's site and compressor (``replay.encode``'s
+``upto``). Decode is unchanged: tensor parallel over the same stores.
+
+Every round ends in one all-gather (``_exchange``) carrying
+- each stage's output for the next: the streams before its last FFN post, that pending post (the gathered partial
+  and its coefficients: the next stage's first mHC boundary applies it, as the next block would in one process), the
+  latest index source's selection;
+- the rows the round wrote into the kv sources' compressed rows and index keys (every rank's stores get them: later
+  stages read them, decode reads them everywhere);
+- the last stage's CED stash rows (``replay.Stash``: the rows entering the decoder).
+Before the prompt's state is read (``finish_prompt``, a snapshot) the line drains (W - 1 rounds without a new
+segment) and each stage's layers' SWA rows and ratio-2 carries go to every rank (``drain``).
+
+Each stage writes its layers' rings, compressed rows, index keys and carries straight into the slot's own stores
+(``Stage.bind``). Exactness: a stage's layers run at world 1, so a pipelined prompt's bits are those of one rank
+computing the encoder (they equal the tensor-parallel bits in exact numerics: ``tests/test_dsv41_pipe.py``); its
+own session tag (``prefill_mm.tag_grid`` + 2).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from tensorfold.cuda.comm import fast_gather
+
+from . import blocks as B
+from . import numerics as N
+from . import replay as RP
+
+
+def rows_min() -> int:
+    """``TF_DSV41_PREFILL_PIPE``: the segment rows that start a pipeline (0: off)."""
+
+    v = int(os.environ.get("TF_DSV41_PREFILL_PIPE", "0").strip() or 0)
+    if v < 0:
+        raise ValueError(f"TF_DSV41_PREFILL_PIPE={v}: expected 0 (off) or the rows a segment that starts a pipeline")
+    return v
+
+
+def _vbase() -> int:
+    from .vision_prep import VBASE
+
+    return int(VBASE)
+
+
+def bounds_for(cfg, world: int) -> list[int]:
+    """Stage boundaries: the encoder layers [0, D) in W near-equal parts; the last stage also runs layer D's site
+    and compressor (``TF_DSV41_PREFILL_PIPE_BOUNDS``: explicit "0,5,10,15,21")."""
+
+    raw = os.environ.get("TF_DSV41_PREFILL_PIPE_BOUNDS", "").strip()
+    d = RP.decoder_start(cfg)
+    if raw:
+        b = [int(v) for v in raw.split(",")]
+    else:
+        b = [round(d * s / world) for s in range(world)] + [d + 1]
+    if len(b) != world + 1 or b[0] != 0 or b[-1] != d + 1 or any(b[i] >= b[i + 1] for i in range(world)):
+        raise ValueError(f"pipeline bounds {b}: {world} increasing stages from 0 to {d + 1}")
+    return b
+
+
+class Stage:
+    """This rank's encoder layers [lo, hi) at full width (one rank's ``Forward`` over them, no stores of its own:
+    ``bind`` points its slot at the prompt's slot's stores)."""
+
+    def __init__(self, fw, model_dir, lo: int, hi: int) -> None:
+        from . import weights as W
+        from .forward import Forward
+
+        cfg, dev = fw.cfg, fw.device
+        self.cfg, self.lo, self.hi = cfg, lo, hi
+        self.last = hi > RP.decoder_start(cfg)
+        ld = W.Loader(cfg, W.Shards(model_dir), 0, 1, dev)
+        layers = [ld.layer(L) for L in range(lo, min(hi, cfg.num_hidden_layers))]
+        if lo == 0:
+            embed = ld._dev(ld.src.rows("embed.weight", 0, cfg.vocab_size).to(torch.bfloat16))
+        else:
+            embed = torch.zeros((128, cfg.hidden_size), dtype=torch.bfloat16, device=dev)
+        tree = W.RankW(0, 1, 0, embed, layers, ld.native("norm.weight"), ld.x3("head", "col"), None, {})
+        if dev.type == "cuda":
+            from .csa2.backend import Triton
+
+            rows = max(fw.chunk, int(os.environ.get("TF_DSV41_PREFILL_ATTN_ROWS", "") or fw.chunk))
+            cs = Triton(rows, cfg.num_attention_heads, dev)
+        else:
+            from .csa2.twin import Twin
+
+            cs = Twin(cfg.qk_rope_head_dim, cfg.sliding_window)
+        self.fw = Forward(cfg, tree, csa2=cs, device=dev, limit=fw.limit, chunk=fw.chunk, pchunk=fw.pchunk,
+                          engram_rows={L: None for L in cfg.engram_layer_ids}, hasher=fw.hasher, slots=1,
+                          contiguous=False)
+        if self.fw.ring != fw.ring:
+            raise ValueError(f"pipeline stage ring {self.fw.ring} != the forward's {fw.ring}")
+        self.layers = [b.index for b in self.fw.blocks]
+        self.sources = [b.index for b in self.fw.blocks if b.mode == "full"]       # the kv sources it writes
+
+    def bind(self, slot, start: int) -> None:
+        """The stage's slot: the prompt's slot's stores for its layers (and the kv sources they read)."""
+
+        ss = self.fw.slots[0]
+        ss.swa = {L: slot.swa[L] for L in self.layers}
+        ss.comp, ss.ikeys, ss.carry = {}, {}, {}
+        for blk in self.fw.blocks:
+            if blk.ratio > 0:
+                src = blk.kv_source
+                ss.comp[src], ss.ikeys[src] = slot.comp[src], slot.ikeys[src]
+            if blk.index in slot.carry:
+                ss.carry[blk.index] = slot.carry[blk.index]
+        ss.pos, ss.tail, ss.taps, ss.pending = start, [], {}, None
+
+    def run(self, start: int, ids, x_in, sel_in, rows: dict, pend_in):
+        """One segment through this stage's layers; returns (streams, ctx). A stage before the last leaves its last
+        FFN post pending (``st.gathered``, ``st.coefs[st.cur]``); the last stops at the decoder's first site."""
+
+        from . import prefill_mm as PM
+        from . import prune as PR
+        from .forward import Pending, Streams
+
+        fw, cfg = self.fw, self.cfg
+        dev, D, ops, n = fw.device, cfg.hidden_size, fw.hc, len(ids)
+        ss = fw.slots[0]
+        if ss.pos != start:
+            raise RuntimeError(f"pipeline stage [{self.lo}, {self.hi}): a segment at {start}, the stage is at {ss.pos}")
+        if x_in is None:
+            x = fw.embed_rows(torch.tensor(list(ids), dtype=torch.long, device=dev)).repeat(1, cfg.hc_mult)
+            x = x.contiguous()
+        else:
+            x = x_in
+        first = ops.Coefs(n, dev) if pend_in is None else ops.Coefs(n, dev, pre=pend_in[1], post=pend_in[2],
+                                                                     comb=pend_in[3])
+        st = Streams(x, torch.empty((n, D), dtype=N.ACT, device=dev), ops.Scratch(n, dev, D),
+                     [first, ops.Coefs(n, dev)], 0, None if pend_in is None else pend_in[0])
+        wants = getattr(ops, "out_of_place", None)
+        if wants is not None and wants(n):
+            st.alt = torch.empty_like(x)
+        ctx = B.Context(fw.win_of(0, start, n), fw.tables, fw.csa2, fw.ring, ss, 0, fw.staging(n))
+        if sel_in is not None:
+            ctx.sel = sel_in
+        with PM.fast(fw.fast_prefill), PR.phase(True):
+            fw._layers(st, [ctx], rows, upto=RP.decoder_start(cfg) if self.last else None)
+        ss.pending = Pending(start, list(ids), ctx.proj, {})
+        fw.keep(0, n - 1)
+        return st, ctx
+
+
+class Pipeline:
+    """One prompt at a time through the stages (``SlotsForward.prefill`` routes a replay-mode segment here when
+    ``takes`` it). Every rank calls ``step`` / ``drain`` / ``abandon`` with the same arguments in the same order."""
+
+    def __init__(self, fw, model_dir, min_rows: int) -> None:
+        cfg = fw.cfg
+        self.fw, self.cfg, self.min_rows = fw, cfg, int(min_rows)
+        self.W, self.r = fw.world, fw.rank
+        self.bounds = bounds_for(cfg, self.W)
+        self.d = RP.decoder_start(cfg)
+        self.owner = {L: next(s for s in range(self.W) if self.bounds[s] <= L < self.bounds[s + 1])
+                      for L in range(self.bounds[-1])}
+        self.stage = Stage(fw, model_dir, self.bounds[self.r], self.bounds[self.r + 1])
+        self.srcs = sorted(L for L in cfg.kv_source_layer_ids if L < self.bounds[-1])
+        self.lookback = max(1, cfg.engram_max_ngram_size - 1)
+        self.slot = None
+        self.rounds = self.segments = 0
+        base = getattr(fw.comm, "base", fw.comm)     # the RoCE transport wraps NCCL (``base``)
+        on = (os.environ.get("TF_DSV41_PIPE_P2P", "1").strip() or "1") != "0"
+        self.p2p = getattr(base, "p2p", None) if on else None     # a stage's output straight to the next rank
+        self.trace = (os.environ.get("TF_DSV41_PIPE_TRACE", "0").strip() or "0") != "0"
+        self.prof = {"engram": 0.0, "stage": 0.0, "exchange": 0.0, "rounds": 0}
+        self.laid = None                # (ACT, ACC) the exchange is laid out for (``_layout`` on first use)
+        self._clear()
+
+    # -- the exchange's layout (every rank the same) -----------------------------------------------------------------
+    def _layout(self) -> None:
+        cfg, C, fw = self.cfg, self.fw.pchunk, self.fw
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        a_, c_ = (torch.empty((), dtype=t).element_size() for t in (N.ACT, N.ACC))       # activations, fp32 values
+        probe = _row_bytes(fw.csa2.rows(1, cfg.head_dim, fw.device)) + \
+            _row_bytes(fw.csa2.keys(1, cfg.index_head_dim, fw.device))           # a compressed row + its index key
+        self.rowb = {L: probe for L in self.srcs}
+        self.cap = {L: C // max(1, cfg.compress_ratio(L)) + 2 for L in self.srcs}
+        K = RP.KEEP
+        fwd = [("flags", 4), ("x", C * D4 * a_), ("sel", C * cfg.index_topk * 4), ("cnt", C * 4),
+               ("g", C * D * c_), ("pre", C * 4 * c_), ("post", C * 4 * c_), ("comb", C * 16 * c_)]
+        bc = [("sx", K * D4 * a_), ("so", K * D * a_), ("spre", K * 4 * c_), ("spost", K * 4 * c_),
+              ("scomb", K * 16 * c_)] + [(f"src{L}", self.cap[L] * self.rowb[L]) for L in self.srcs]
+        self.off = {}
+        size = {}
+        for region, parts in (("f", fwd), ("b", bc)):
+            a = 0
+            for name, n in parts:       # 16-byte aligned parts (fp64 views in exact numerics)
+                self.off[name] = (region, a, n)
+                a += -(-n // 16) * 16
+            size[region] = a
+        self.nf, self.nb = size["f"], size["b"]
+        dev = self.fw.device
+        self.buf = {"f": torch.zeros((self.nf,), dtype=torch.uint8, device=dev),
+                    "b": torch.zeros((self.nb,), dtype=torch.uint8, device=dev)}
+        self.recv_f = torch.empty(((1 if self.p2p is not None else self.W) * self.nf,), dtype=torch.uint8, device=dev)
+        self.recv_b = torch.empty((self.W * self.nb,), dtype=torch.uint8, device=dev)
+        self.laid = (N.ACT, N.ACC)
+
+    def _put(self, name: str, t: torch.Tensor) -> None:
+        region, a, n = self.off[name]
+        b = t.contiguous().view(-1).view(torch.uint8)
+        if b.numel() > n:
+            raise RuntimeError(f"pipeline exchange: {name} holds {n} bytes, not {b.numel()}")
+        self.buf[region][a:a + b.numel()].copy_(b)
+
+    def _get(self, got: torch.Tensor, name: str, dtype, shape) -> torch.Tensor:
+        _, a, _ = self.off[name]
+        n = int(torch.Size(shape).numel()) * torch.empty((), dtype=dtype).element_size()
+        return got[a:a + n].view(dtype).view(shape).clone()
+
+    def _clear(self) -> None:
+        self.slot = None
+        self.entered: list = []         # every round's new segment (start, ids) or None (drain), since the start
+        self.inp = None                 # (x, sel, pend) of this stage's next segment (stages after the first)
+        self.hist: list = []            # the prompt's ids from ``base`` on (Engram's lookback)
+        self.base = 0
+
+    # -- the protocol ------------------------------------------------------------------------------------------------
+    def takes(self, slot: int, n: int, ids=None) -> bool:
+        """Whether this segment goes through the line: the slot's line is running, or a long enough segment. A
+        segment with image positions (``vision.py``: ids from ``VBASE``) never does: the stages run text layers only
+        (no image rows, no ``bias_vl`` routing); the caller drains the slot's line before the tensor-parallel pass."""
+
+        if ids is not None and len(ids) and max(ids) >= _vbase():
+            return False
+        return self.slot == slot or (self.min_rows > 0 and n >= self.min_rows)
+
+    def step(self, slot: int, start: int, ids) -> None:
+        """A new segment of ``slot``'s prompt enters the line (a pipeline for another slot drains first)."""
+
+        fw = self.fw
+        s = fw.slots[slot]
+        if self.slot is not None and self.slot != slot:
+            self.drain()
+        if self.slot is None:
+            if s.pos != start:
+                raise RuntimeError(f"slot {slot}: a pipelined segment at {start}, the slot is at {s.pos}")
+            self.slot = slot
+            self.stage.bind(s, start)
+            tail = list(s.tail)[-self.lookback:]
+            self.hist, self.base = tail + [], start - len(tail)
+        elif start != self.base + len(self.hist):
+            raise RuntimeError(f"slot {slot}: a pipelined segment at {start}, the line is at "
+                               f"{self.base + len(self.hist)}")
+        ids = tuple(int(t) for t in ids)
+        self.hist.extend(ids)
+        s.pos, s.pending, s.taps = start + len(ids), None, {}       # what ``keep`` leaves (the carry: ``drain``)
+        s.tail = (list(s.tail) + list(ids))[-self.lookback:]
+        self.segments += 1
+        self._round((start, ids))
+
+    def drain(self) -> None:
+        """Run the line empty, then every stage's SWA rows and carries to every rank: the slot's state is whole."""
+
+        if self.slot is None:
+            return
+        while any(e is not None for e in self.entered[-(self.W - 1):]):
+            self._round(None)
+        self._finals()
+        self._clear()
+        if self.trace:
+            print(f"[dsv41] {self.report()}", flush=True)
+            self.prof = {k: 0 * v for k, v in self.prof.items()}
+
+    def abandon(self, slot: int | None = None) -> None:
+        """The slot was reset or restored: the line's segments are dropped (every rank)."""
+
+        if self.slot is not None and (slot is None or slot == self.slot):
+            self._clear()
+
+    # -- a round -----------------------------------------------------------------------------------------------------
+    def _seg(self, t: int, s: int):
+        """The segment stage s runs in round t (or None)."""
+
+        i = t - s
+        return self.entered[i] if 0 <= i < len(self.entered) else None
+
+    def _engram(self, seg, L: int) -> torch.Tensor:
+        """Layer L's Engram rows of ``seg`` at full width: each rank's hash heads, gathered (a collective)."""
+
+        fw = self.fw
+        start, ids = seg
+        i = start - self.base
+        look = self.hist[max(0, i - self.lookback):i]
+        hashes = fw.hasher(torch.tensor(ids), lookback=torch.tensor(look, dtype=torch.long))
+        blk = next(b for b in fw.blocks if b.index == L)
+        mine = B.engram_rows(blk, hashes, fw.engram_rows[L], fw.rank, fw.world, fw.hasher.layout)
+        return fw.gather_cols(mine.to(fw.device))
+
+    def _rows_of(self, L: int, start: int, n: int) -> torch.Tensor:
+        """The compressed rows of kv source L a segment [start, start + n) can write (and the one before)."""
+
+        r = max(1, self.cfg.compress_ratio(L))
+        return torch.arange(max(0, start // r - 1), (start + n) // r, device=self.fw.device)
+
+    def _round(self, new) -> None:
+        fw, cfg, W, r = self.fw, self.cfg, self.W, self.r
+        if self.laid != (N.ACT, N.ACC):
+            self._layout()
+        self.entered.append(new)
+        t = len(self.entered) - 1
+        tick = self._tick()
+        rows = {}
+        for L in cfg.engram_layer_ids:
+            if L < self.bounds[-1]:
+                seg = self._seg(t, self.owner[L])
+                if seg is not None:
+                    full = self._engram(seg, L)
+                    if self.owner[L] == r:
+                        rows[L] = full
+        self._tock(tick, "engram")
+        tick = self._tick()
+        mine = self._seg(t, r)
+        if mine is not None:
+            start, ids = mine
+            n = len(ids)
+            x_in, sel_in, pend_in = self.inp if (r > 0 and self.inp is not None) else (None, None, None)
+            st, ctx = self.stage.run(start, ids, x_in, sel_in, rows, pend_in)
+            self._put("x", st.x.to(N.ACT))
+            self._put("flags", torch.tensor([int(ctx.sel is not None)], dtype=torch.int32, device=fw.device))
+            if ctx.sel is not None:
+                self._put("sel", ctx.sel[0].to(torch.int32))
+                self._put("cnt", ctx.sel[1].to(torch.int32))
+            acc = N.ACC
+            if not self.stage.last:
+                cf = st.coefs[st.cur]
+                self._put("g", st.gathered.to(acc))
+                self._put("pre", cf.pre.to(acc))
+                self._put("post", cf.post.to(acc))
+                self._put("comb", cf.comb.to(acc))
+            else:                       # the CED stash rows: the segment's last KEEP rows (all of a shorter one)
+                m = min(n, RP.KEEP)
+                cf = st.coefs[st.cur]
+                self._put("sx", st.x[n - m:].to(N.ACT))
+                self._put("so", st.out[n - m:].to(N.ACT))
+                self._put("spre", cf.pre[n - m:].to(acc))
+                self._put("spost", cf.post[n - m:].to(acc))
+                self._put("scomb", cf.comb[n - m:].to(acc))
+            slot = fw.slots[self.slot]
+            for L in self.stage.sources:
+                if L in self.srcs:
+                    self._put(f"src{L}", self._pack(slot, L, start, n))
+        self._tock(tick, "stage")
+        tick = self._tick()
+        prev = self._seg(t, r - 1) if r > 0 else None
+        if self.p2p is not None:        # the output to rank r + 1, rank r - 1's to this rank (one NCCL group)
+            sends = [(self.buf["f"], r + 1)] if (mine is not None and r < W - 1) else []
+            recvs = [(self.recv_f, r - 1)] if prev is not None else []
+            if sends or recvs:
+                self.p2p(sends, recvs)
+            fwd = self.recv_f
+        else:
+            fast_gather(fw.comm, self.buf["f"], self.recv_f)
+            fwd = self.recv_f.view(W, self.nf)[r - 1] if r > 0 else None
+        fast_gather(fw.comm, self.buf["b"], self.recv_b)
+        got = self.recv_b.view(W, self.nb)
+        self.rounds += 1
+        slot = fw.slots[self.slot]
+        for L in self.srcs:             # the kv sources' rows every other rank wrote this round
+            q = self.owner[L]
+            seg = self._seg(t, q)
+            if q != r and seg is not None:
+                self._unpack(slot, L, seg[0], len(seg[1]), got[q])
+        last = self._seg(t, W - 1)
+        if last is not None:
+            self._stash(last, got[W - 1])
+        if r > 0:                       # this stage's next segment: what rank r - 1 ran this round
+            self.inp = self._input(fwd, len(prev[1])) if prev is not None else None
+        self._tock(tick, "exchange")
+        self.prof["rounds"] += 1
+
+    def _tick(self):
+        if not self.trace:
+            return None
+        if self.fw.device.type == "cuda":
+            torch.cuda.synchronize()
+        import time
+
+        return time.perf_counter()
+
+    def _tock(self, tick, name: str) -> None:
+        if tick is None:
+            return
+        import time
+
+        if self.fw.device.type == "cuda":
+            torch.cuda.synchronize()
+        self.prof[name] += time.perf_counter() - tick
+
+    def report(self) -> str:
+        p = self.prof
+        n = max(1, p["rounds"])
+        return (f"pipeline rank {self.r}: {p['rounds']} rounds, a round: engram {1e3 * p['engram'] / n:.1f} ms, "
+                f"stage {1e3 * p['stage'] / n:.1f} ms, exchange {1e3 * p['exchange'] / n:.1f} ms")
+
+    def _input(self, g: torch.Tensor, n: int):
+        cfg = self.cfg
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        x = self._get(g, "x", N.ACT, (n, D4))
+        sel = None
+        if int(self._get(g, "flags", torch.int32, (1,)).item()):
+            sel = (self._get(g, "sel", torch.int32, (n, cfg.index_topk)), self._get(g, "cnt", torch.int32, (n,)))
+        acc = N.ACC
+        pend = (self._get(g, "g", acc, (1, n, D)), self._get(g, "pre", acc, (n, 4)), self._get(g, "post", acc, (n, 4)),
+                self._get(g, "comb", acc, (n, 16)))
+        return x, sel, pend
+
+    def _stash(self, seg, g: torch.Tensor) -> None:
+        """Every rank's CED stash after the last stage's segment (``replay.encode``'s extend and cut)."""
+
+        cfg, fw = self.cfg, self.fw
+        start, ids = seg
+        n = len(ids)
+        m = min(n, RP.KEEP)
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        acc = N.ACC
+        got = RP.Stash(start + n - m, self._get(g, "sx", N.ACT, (m, D4)), self._get(g, "so", N.ACT, (m, D)),
+                       self._get(g, "spre", acc, (m, 4)), self._get(g, "spost", acc, (m, 4)),
+                       self._get(g, "scomb", acc, (m, 16)), list(ids[n - m:]))
+        if m == n:
+            have = fw.stash.get(self.slot)
+            if have is None or have.hi != start:
+                have = RP.empty(fw, start)
+            fw.stash[self.slot] = have.extend(got)
+        else:
+            fw.stash[self.slot] = got
+
+    def _tensors(self, slot, L: int, rows: torch.Tensor):
+        """(row tensor, physical rows) of kv source L's compressed rows and index keys."""
+
+        out = []
+        for store in (slot.comp[L], slot.ikeys[L]):
+            for t in _ring_tensors(store):
+                out.append((t, store.phys(rows).to(t.device)))
+        return out
+
+    def _pack(self, slot, L: int, start: int, n: int) -> torch.Tensor:
+        rows = self._rows_of(L, start, n)
+        return torch.cat([t[p].contiguous().reshape(-1).view(torch.uint8) for t, p in self._tensors(slot, L, rows)])
+
+    def _unpack(self, slot, L: int, start: int, n: int, g: torch.Tensor) -> None:
+        rows = self._rows_of(L, start, n)
+        _, a, _ = self.off[f"src{L}"]
+        k = len(rows)
+        for t, p in self._tensors(slot, L, rows):
+            nb = k * t[0].numel() * t.element_size()
+            t[p] = g[a:a + nb].view(t.dtype).view((k,) + tuple(t.shape[1:]))
+            a += nb
+
+    # -- the drained line's state --------------------------------------------------------------------------------
+    def _finals(self) -> None:
+        """Each stage's layers' SWA rows of the prompt's last window and its kv sources' carries, to every rank."""
+
+        fw, W, r = self.fw, self.W, self.r
+        s = fw.slots[self.slot]
+        win = torch.arange(max(0, s.pos - self.cfg.sliding_window), s.pos, dtype=torch.long) % fw.ring
+        enc = [L for L in range(self.bounds[-1]) if L < self.d]
+        ring = {L: s.swa[L] for L in enc}
+        per = {}
+        for L in enc:
+            st = ring[L]
+            per[L] = sum(t[0].numel() * t.element_size() for t in _ring_tensors(st))
+        carries = sorted(L for L in s.carry if L < self.bounds[-1])
+        cb = {L: s.carry[L].numel() * s.carry[L].element_size() for L in carries}
+        mine = [L for L in enc if self.owner[L] == r]
+        size = max(sum(len(win) * per[L] for L in enc if self.owner[L] == q) +
+                   sum(cb[L] for L in carries if self.owner[L] == q) for q in range(W))
+        send = torch.zeros((max(16, -(-size // 16) * 16),), dtype=torch.uint8, device=fw.device)
+        a = 0
+        for L in mine:
+            for t in _ring_tensors(ring[L]):
+                b = t[win.to(t.device)].reshape(-1).view(torch.uint8)
+                send[a:a + b.numel()].copy_(b)
+                a += b.numel()
+        for L in carries:
+            if self.owner[L] == r:
+                b = s.carry[L].contiguous().reshape(-1).view(torch.uint8)
+                send[a:a + b.numel()].copy_(b)
+                a += b.numel()
+        recv = torch.empty((W * send.numel(),), dtype=torch.uint8, device=fw.device)
+        fast_gather(fw.comm, send, recv)
+        got = recv.view(W, -1)
+        for q in range(W):
+            if q == r:
+                continue
+            a = 0
+            for L in enc:
+                if self.owner[L] != q:
+                    continue
+                for t in _ring_tensors(ring[L]):
+                    w = t[0].numel() * t.element_size()
+                    nb = len(win) * w
+                    t[win.to(t.device)] = got[q, a:a + nb].view(t.dtype).view((len(win),) + tuple(t.shape[1:]))
+                    a += nb
+            for L in carries:
+                if self.owner[L] == q:
+                    c = s.carry[L]
+                    c.copy_(got[q, a:a + cb[L]].view(c.dtype).view(c.shape))
+                    a += cb[L]
+
+    def describe(self) -> str:
+        return (f"pipelined prompts from {self.min_rows} rows: stages {self.bounds} (this rank "
+                f"[{self.stage.lo}, {self.stage.hi}))")
+
+
+def _ring_tensors(store) -> list[torch.Tensor]:
+    """A ring store's row tensors (``Records``: values and scales; ``Floats``: data)."""
+
+    if hasattr(store, "values"):
+        return [store.values, store.scales]
+    return [store.data]
+
+
+def _row_bytes(store) -> int:
+    return sum(t[0].numel() * t.element_size() for t in _ring_tensors(store))
+
+
+__all__ = ["Pipeline", "Stage", "bounds_for", "rows_min"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
new file mode 100644
index 0000000..4d6dfeb
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/plain_fp64.py
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``linear.Plain`` (the indexer's ``weights_proj``, [32, 5,120] bf16) in float64 sums as one Triton launch (G4).
+
+The torch form ``x.double() @ w.double().t()`` runs cuBLAS's DGEMM: at decode widths (1-16 rows) it launches a
+split-K kernel with 5 thread blocks, ~275 us a call on sm_121 (the GPU's float64 rate is low), plus a 320-block
+conversion of the weight: G4's nsys put ~2.2 ms of every verify window there (8 calls). Here one program a (row,
+output) loads the row and the weight row, multiplies in float64 (bf16 / fp32 values widen exactly, so every product
+is exact) and adds them in a fixed order: ``BK`` lanes accumulate k ascending in steps of ``BK``, then the lanes are
+summed by ``tl.sum``'s fixed tree. That order depends on K alone, never on the number of rows, so a row's value is
+the same alone, in a verify window or in a prefill chunk (cuBLAS's split-K choice depends on M).
+
+The sums are float64 like the torch form's; they may differ from cuBLAS's in the last float64 bits (another
+order), which the caller's rounding to fp32 / bf16 hides except at a rounding tie of probability ~2^-29 a value.
+``TF_DSV41_PLAIN_TRITON`` (1 = on) selects it on CUDA; the CPU twin and every other device keep the torch form.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+from . import pdl as P
+from .pdl import gdc_launch_dependents, gdc_wait
+
+BK = 256
+
+
+def enabled() -> bool:
+    return (os.environ.get("TF_DSV41_PLAIN_TRITON", "1").strip() or "1") != "0"
+
+
+@triton.jit
+def _plain(X, x_rs, W, w_rs, OUT, K, N, BK: tl.constexpr, PDL: tl.constexpr = False, BF16: tl.constexpr = False):
+    if PDL:                                   # G10 (pdl.py, TF_DSV41_PDL): wait for the kernels before, then
+        gdc_wait()                            # let the next launch start its prologue
+        gdc_launch_dependents()
+    r = tl.program_id(0)
+    n = tl.program_id(1)
+    k = tl.arange(0, BK)
+    acc = tl.zeros((BK,), dtype=tl.float64)
+    xr = X + r.to(tl.int64) * x_rs
+    wr = W + n.to(tl.int64) * w_rs
+    for c in range(0, K, BK):
+        m = (c + k) < K
+        xv = tl.load(xr + c + k, mask=m, other=0.0).to(tl.float64)
+        wv = tl.load(wr + c + k, mask=m, other=0.0).to(tl.float64)
+        acc += xv * wv
+    v = tl.sum(acc, axis=0)
+    if BF16:                                  # ``.to(fp32).to(bf16)`` of the float64 sum, both roundings nearest-even
+        v = v.to(tl.float32).to(tl.bfloat16)
+    tl.store(OUT + r.to(tl.int64) * N + n, v)
+
+
+def matmul_t(x: torch.Tensor, w: torch.Tensor, out_dtype: torch.dtype = torch.float64) -> torch.Tensor:
+    """x [M, K] (any float dtype), w [N, K] -> float64 [M, N] = x @ w.T in float64 sums, row-invariant.
+    ``out_dtype`` bf16 (``branches``, TF_DSV41_BRANCHES): the sums rounded to fp32 and then to bf16 as they are
+    stored, the bits of ``.to(fp32).to(bf16)`` after the float64 result without the two cast launches."""
+
+    if out_dtype not in (torch.float64, torch.bfloat16):
+        raise ValueError(f"matmul_t: float64 or bf16 output, not {out_dtype}")
+
+    if x.stride(-1) != 1:
+        x = x.contiguous()
+    if w.stride(-1) != 1:
+        w = w.contiguous()
+    M, K = x.shape
+    N = w.shape[0]
+    out = torch.empty((M, N), dtype=out_dtype, device=x.device)
+    if M:
+        _plain[(M, N)](x, x.stride(0), w, w.stride(0), out, K, N, BK=BK, num_warps=2,
+                       BF16=out_dtype == torch.bfloat16, **P.triton_kw())
+    return out
+
+
+def eligible(x: torch.Tensor, w: torch.Tensor) -> bool:
+    return (x.is_cuda and x.dim() == 2 and w.dim() == 2 and w.device == x.device and x.shape[1] == w.shape[1]
+            and enabled())
+
+
+__all__ = ["BK", "eligible", "enabled", "matmul_t"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/plan.py b/src/tensorfold/families/deepseek_v41/cuda/plan.py
new file mode 100644
index 0000000..a127b17
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/plan.py
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A round plan of the V4.1 batcher: what rank 0 decided for one round and both ranks execute in the same order
+(GLM ``batchplan``'s protocol: rank 0 plans, shares, both execute; the plan is the only thing rank 1 learns).
+
+Execution order (``rounds.Executor.run``), every step on both ranks:
+
+1. ``commits``  the previous round's windows: (slot, accepted, bonus) -> ``Forward.commit``; the slot's history
+                grows by the kept rows; rank 1's grammar follows the chosen tokens;
+2. ``finishes`` (slot, save, cancelled): a turn-end snapshot into the session store when ``save``, then the slot's
+                pages are released;
+3. ``spills``   session entries let go of (parked to NVMe or dropped) so admissions find their pages;
+4. ``admits``   a request in a slot: page reservation, ``Forward.reset``, a session restore (RAM or NVMe) when
+                ``tier`` is set (``cached`` prompt tokens skipped), the request's grammar;
+5. ``pieces``   prefill pieces (slot, start, end) of several slots in one ``Forward.prefill`` (GLM 0560);
+6. ``saves``    prompt snapshots at the replay point (the slot sits at it after its piece);
+7. ``finals``   ``Forward.finish_prompt`` for slots whose prompt is done (CED replay);
+8. ``windows``  (slot, start, pending, depth, drafts, noise, nucleus): drafts from ``Forward.draft`` when depth > 0
+                (DSpark, both ranks, keyed by ``noise``) or the plan's own (host lookup drafts), cut by the slot's
+                grammar, masks filled, the Engram reads issued (``Forward.prefetch``), one ``Forward.window`` (top-p
+                rows' specs in ``nucleus``).
+
+Encoding: a list of ints for the communicator (GLM ``_share``): [MAGIC, json bytes, *json words (3 bytes an int),
+prompt count, (slot, n, *ids) ...]. Prompts travel once, at admission, as raw ids.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import asdict, dataclass, field
+
+from .protocol import pack_bytes, unpack_bytes
+
+MAGIC = 0x0D541
+VERSION = 1
+
+
+@dataclass
+class Admit:
+    slot: int
+    prompt: list[int]
+    max_tokens: int
+    tier: str = ""                  # "" | ram | disk
+    key: str = ""
+    cached: int = 0
+    quota: int = 0                  # pool pages reserved for the request
+    grammar: list[int] | None = None   # GLM ``grammar.pack(bound)`` (rank 1 compiles it)
+    job: int = 0
+
+
+@dataclass
+class WindowSpec:
+    slot: int
+    start: int
+    pending: int
+    depth: int = 0                  # DSpark depth (Forward.draft on both ranks)
+    drafts: list[int] = field(default_factory=list)    # host drafts (lookup), used when depth == 0
+    noise: list = field(default_factory=list)          # keyed draft noise (lookup.noise_of): [] = greedy drafts
+    nucleus: list = field(default_factory=list)        # [T, top_p, min_p]: top-p rows from candidates (nucleus.py)
+
+
+@dataclass
+class Plan:
+    round: int = 0
+    mode: str = "full"
+    count: int = 1                  # candidates a verify row
+    commits: list[tuple[int, int, int]] = field(default_factory=list)
+    finishes: list[tuple[int, bool, bool]] = field(default_factory=list)
+    spills: list[str] = field(default_factory=list)
+    admits: list[Admit] = field(default_factory=list)
+    pieces: list[tuple[int, int, int]] = field(default_factory=list)
+    saves: list[int] = field(default_factory=list)
+    finals: list[int] = field(default_factory=list)
+    windows: list[WindowSpec] = field(default_factory=list)
+    stop: bool = False
+    release: bool = False           # G19: torch's cached blocks back to the system before the pieces (both ranks)
+
+    def empty(self) -> bool:
+        return not (self.commits or self.finishes or self.spills or self.admits or self.pieces or self.saves
+                    or self.finals or self.windows or self.stop)
+
+    def encode(self) -> list[int]:
+        d = asdict(self)
+        prompts = [(a["slot"], a.pop("prompt")) for a in d["admits"]]
+        data = json.dumps(d, separators=(",", ":")).encode()
+        words = pack_bytes(data)
+        out = [MAGIC, VERSION, len(data), len(words), *words, len(prompts)]
+        for slot, ids in prompts:
+            out += [int(slot), len(ids), *(int(t) for t in ids)]
+        return out
+
+    @classmethod
+    def decode(cls, ints: list[int]) -> Plan:
+        ints = [int(v) for v in ints]
+        if len(ints) < 5 or ints[0] != MAGIC or ints[1] != VERSION:
+            raise ValueError("not a V4.1 round plan (or another version)")
+        n, nw = ints[2], ints[3]
+        d = json.loads(unpack_bytes(ints[4:4 + nw], n))
+        i = 4 + nw
+        count = ints[i]
+        i += 1
+        prompts = {}
+        for _ in range(count):
+            slot, k = ints[i], ints[i + 1]
+            prompts[slot] = ints[i + 2:i + 2 + k]
+            i += 2 + k
+        if i != len(ints):
+            raise ValueError("round plan: trailing ints")
+        admits = [Admit(prompt=prompts[a["slot"]], **a) for a in d.pop("admits")]
+        windows = [WindowSpec(**w) for w in d.pop("windows")]
+        p = cls(**d)
+        p.admits, p.windows = admits, windows
+        p.commits = [tuple(c) for c in p.commits]
+        p.finishes = [tuple(f) for f in p.finishes]
+        p.pieces = [tuple(x) for x in p.pieces]
+        return p
+
+
+def piece_end(done: int, target: int, budget: int, grid: int) -> int:
+    """The end of a slot's next prefill piece from ``done`` toward ``target`` with ``budget`` rows: ``target`` when
+    it fits, else the last grid point within the budget (at least one grid step: a piece is never empty)."""
+
+    if target - done <= budget:
+        return target
+    end = (done + budget) // grid * grid
+    if end <= done:
+        end = min(target, (done // grid + 1) * grid)
+    return end
diff --git a/src/tensorfold/families/deepseek_v41/cuda/planlink.py b/src/tensorfold/families/deepseek_v41/cuda/planlink.py
new file mode 100644
index 0000000..92679dd
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/planlink.py
@@ -0,0 +1,349 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The round plan from rank 0 to the followers over a TCP socket instead of the communicator (``TF_DSV41_PLAN_LINK=tcp``).
+
+Why: ``engine._Link`` shares each plan with two all-gathers on the GPU stream (its length, then its ints), each
+followed by a ``.tolist()``: ~0.74 ms of rank 0's host a round (G7 C1), and because the gathers queue behind
+whatever the stream holds, a plan could never be sent while the GPU still works (the speculative DSpark pass,
+``spec.py``). Rank 1's host waits ~12 ms a round inside that gather kernel for rank 0's host work.
+
+How: one TCP connection between the ranks (rank 0 listens on ``TF_DSV41_PLAN_PORT``, default the rendezvous port +
+7, rank 1 connects to the master address), ``TCP_NODELAY``, one frame a plan: a 4-byte length, then the plan's ints
+as little-endian int64 (``array('q')``: no Python loop). Host only: nothing waits on the GPU, the plan arrives
+while both GPUs still run. The plan is the same list of ints as before (``plan.Plan.encode``), so the protocol, its
+order and rank 1's decisions are unchanged; a closed connection raises on both sides (rank 1 stops instead of
+hanging in a collective).
+
+Who is who: a follower opens with a hello (``HELLO``: magic, its rank, the world size) and waits for rank 0's
+one-byte answer; rank 0 accepts until it holds ranks 1 .. world - 1 exactly once each, in rank order, and closes
+anything else (a stray client, a duplicate rank, another world size) without counting it. A refused follower
+raises at boot instead of following the wrong leader; rank 0 never pairs a plan stream with an unknown peer.
+
+Knobs: TF_DSV41_PLAN_LINK (nccl: the communicator, default; tcp; rdma), TF_DSV41_PLAN_PORT, TF_DSV41_PLAN_TIMEOUT
+(connect / accept seconds, 300).
+
+G14 (``rdma``). In serving, rank 1's first exchange of a window rings ~84-105 us (mean) after rank 0's (G14a traces,
+host clocks aligned through the exchanges' proxy stamps): ~55-60 us of it is rank 1 calling the window later (the plan
+over TCP: two kernel stacks + waking a thread blocked in ``recv``; plus host-work differences), ~30-45 us is rank 1's
+call -> first exchange being slower. ``rdma`` sends the plan through the RoCE runtime's host mailbox
+(``glm5_next/spark/roce_msg.h``: chunks RDMA-written by rank 0's proxy on the exchanges' queue pair, a sequence flag
+after each, credits acked back) and rank 1 SPINS on the flag in pinned memory (``TF_DSV41_PLAN_SPIN_US``, 5,000) before
+napping (``TF_DSV41_PLAN_NAP_US``, 20) between requests. The TCP connection stays open: it carries a handshake and is
+polled while rank 1 naps, so a vanished rank 0 still ends rank 1 (ConnectionError). Without a RoCE runtime (NCCL, a
+failed setup: a collective decision) both ranks use ``tcp``. Both ranks must set the same TF_DSV41_PLAN_LINK.
+``TF_DSV41_PLAN_PIN``: N | auto: the thread that sends (rank 0's round loop) / receives (rank 1's follower) the plans
+pins itself to CPU N (auto: the highest ``cpu_capacity`` among the allowed CPUs other than the RoCE proxy's) at its
+first plan: GB10's A725 cores are ~30% slower than its X925s, and nothing pins DeepSeek's threads today.
+"""
+
+from __future__ import annotations
+
+import os
+import socket
+import struct
+import time
+from array import array
+
+ENV = "TF_DSV41_PLAN_LINK"
+_LEN = struct.Struct("<I")
+HELLO = struct.Struct("<4sHH")     # b"TFPL", rank, world
+MAGIC = b"TFPL"
+OK, REFUSED = b"\x01", b"\x00"
+
+
+def mode() -> str:
+    v = (os.environ.get(ENV, "nccl").strip().lower() or "nccl")
+    if v not in ("nccl", "tcp", "rdma"):
+        raise ValueError(f"{ENV}={v!r}: expected nccl, tcp or rdma")
+    return v
+
+
+def port_for(master_port: int) -> int:
+    raw = os.environ.get("TF_DSV41_PLAN_PORT", "").strip()
+    return int(raw) if raw else int(master_port) + 7
+
+
+def keepalive(conn: socket.socket, idle: int = 30, interval: int = 10, count: int = 6) -> None:
+    """TCP keepalive: a peer that is gone (host down, cable out, process killed without a FIN) fails ``recv`` /
+    ``sendall`` after ~idle + interval x count s (90 s) instead of never. Silently skipped where unsupported."""
+
+    try:
+        conn.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
+        for name, v in (("TCP_KEEPIDLE", idle), ("TCP_KEEPINTVL", interval), ("TCP_KEEPCNT", count)):
+            opt = getattr(socket, name, None)
+            if opt is not None:
+                conn.setsockopt(socket.IPPROTO_TCP, opt, v)
+    except OSError:
+        pass
+
+
+class TcpLink:
+    """``protocol.Link`` over TCP: rank 0 ``send``s each plan to every follower (one connection each), the
+    followers (ranks 1 .. world - 1) ``recv``."""
+
+    def __init__(self, rank: int, host: str, port: int, *, timeout_s: float | None = None, world: int = 2) -> None:
+        self.rank, self.world = int(rank), int(world)
+        conns = []
+        timeout_s = float(os.environ.get("TF_DSV41_PLAN_TIMEOUT", "") or 300) if timeout_s is None else timeout_s
+        self.sent = self.received = 0
+        if self.rank == 0:
+            srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            srv.bind(("", int(port)))
+            srv.listen(max(1, self.world - 1))
+            try:
+                conns = self._accept(srv, time.monotonic() + timeout_s)
+            finally:
+                srv.close()
+        else:
+            conns.append(self._join(host, int(port), time.monotonic() + timeout_s))
+        for conn in conns:
+            conn.settimeout(None)               # a follower may idle in recv for hours: no read deadline ...
+            conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
+            keepalive(conn)                     # ... but a dead peer or link ends it (G12 bug 2)
+        self.conns = conns
+        self.conn = conns[0] if conns else None
+
+    def _accept(self, srv: socket.socket, end: float) -> list[socket.socket]:
+        """Rank 0: one connection a follower rank, identified by its hello, in rank order."""
+
+        got: dict[int, socket.socket] = {}
+        while len(got) < self.world - 1:
+            left = end - time.monotonic()
+            if left <= 0:
+                for c in got.values():
+                    c.close()
+                missing = sorted(set(range(1, self.world)) - set(got))
+                raise TimeoutError(f"plan link: rank(s) {missing} did not connect (TF_DSV41_PLAN_TIMEOUT)")
+            srv.settimeout(left)
+            try:
+                conn, addr = srv.accept()
+            except socket.timeout:
+                continue
+            why = None
+            try:
+                conn.settimeout(10.0)
+                magic, rank, world = HELLO.unpack(_read(conn, HELLO.size))
+                if magic != MAGIC:
+                    why = "not a plan link hello"
+                elif world != self.world:
+                    why = f"world {world}, this is world {self.world}"
+                elif not 0 < rank < self.world:
+                    why = f"rank {rank} outside 1 .. {self.world - 1}"
+                elif rank in got:
+                    why = f"rank {rank} is already connected"
+            except (OSError, ConnectionError, struct.error) as e:
+                why = f"no hello ({e})"
+            if why is not None:
+                print(f"[tensorfold] plan link: refused {addr[0]}: {why}", flush=True)
+                try:
+                    conn.sendall(REFUSED)
+                except OSError:
+                    pass
+                conn.close()
+                continue
+            conn.sendall(OK)
+            got[rank] = conn
+        return [got[r] for r in range(1, self.world)]
+
+    def _join(self, host: str, port: int, end: float) -> socket.socket:
+        """A follower: connect, say who it is, and wait for rank 0's yes."""
+
+        while True:
+            try:
+                conn = socket.create_connection((host, port), timeout=5.0)
+                break
+            except OSError:
+                if time.monotonic() > end:
+                    raise
+                time.sleep(0.05)
+        conn.settimeout(max(10.0, end - time.monotonic()))
+        conn.sendall(HELLO.pack(MAGIC, self.rank, self.world))
+        answer = _read(conn, 1)
+        if answer != OK:
+            conn.close()
+            raise ConnectionError(f"plan link: rank 0 at {host}:{port} refused rank {self.rank} of {self.world} "
+                                  "(a duplicate rank or a different world size; see rank 0's log)")
+        return conn
+
+    def send(self, plan) -> None:
+        body = array("q", plan).tobytes()
+        frame = _LEN.pack(len(body)) + body
+        for conn in self.conns:
+            conn.sendall(frame)
+        self.sent += 1
+
+    def _exact(self, n: int) -> bytes:
+        buf = bytearray(n)
+        view, got = memoryview(buf), 0
+        while got < n:
+            k = self.conn.recv_into(view[got:], n - got)
+            if not k:
+                raise ConnectionError("plan link: rank 0 closed the connection")
+            got += k
+        return bytes(buf)
+
+    def recv(self) -> list[int]:
+        (n,) = _LEN.unpack(self._exact(_LEN.size))
+        out = array("q")
+        out.frombytes(self._exact(n))
+        self.received += 1
+        return out.tolist()
+
+    def close(self) -> None:
+        for conn in self.conns:
+            try:
+                conn.close()
+            except OSError:
+                pass
+
+
+def _read(conn: socket.socket, n: int) -> bytes:
+    buf = bytearray()
+    while len(buf) < n:
+        k = conn.recv(n - len(buf))
+        if not k:
+            raise ConnectionError("plan link: the peer closed the connection during the handshake")
+        buf += k
+    return bytes(buf)
+
+
+RDMA_MAGIC = 0x47314452                  # "RD1G": the rdma link's TCP handshake
+
+
+def _f(name: str, default: float, lo: float, hi: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    v = float(raw) if raw else default
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+class RoceLink:
+    """G14 (TF_DSV41_PLAN_LINK=rdma): ``protocol.Link`` over the RoCE runtime's host mailbox; ``tcp`` (a ``TcpLink``)
+    carries the handshake and is rank 1's liveness check while it naps."""
+
+    def __init__(self, rank: int, tcp, box, *, spin_us: float | None = None, nap_us: float | None = None,
+                 timeout_s: float | None = None) -> None:
+        self.rank, self.tcp, self.box = int(rank), tcp, box
+        self.spin_us = _f("TF_DSV41_PLAN_SPIN_US", 5000.0, 0.0, 1e7) if spin_us is None else float(spin_us)
+        self.nap_us = _f("TF_DSV41_PLAN_NAP_US", 20.0, 1.0, 1e6) if nap_us is None else float(nap_us)
+        self.timeout_s = _f("TF_DSV41_PLAN_TIMEOUT", 300.0, 1.0, 1e6) if timeout_s is None else float(timeout_s)
+        self.sent = self.received = 0
+        if self.rank == 0:
+            tcp.send([RDMA_MAGIC])
+        else:
+            got = tcp.recv()
+            if got != [RDMA_MAGIC]:
+                raise RuntimeError(f"plan link: rank 0 is not on {ENV}=rdma (handshake {got[:4]})")
+
+    def send(self, plan) -> None:
+        if not self.box.send(array("q", plan).tobytes(), self.timeout_s):
+            raise ConnectionError(f"plan link: rank 1 consumed no plan in {self.timeout_s:g} s (mailbox credits)")
+        self.sent += 1
+
+    def recv(self) -> list[int]:
+        try:
+            raw = self.box.recv(0, self.spin_us, self.nap_us, self.tcp.conn.fileno(), 0.0)
+        except RuntimeError as exc:
+            if "closed the connection" in str(exc):
+                raise ConnectionError(str(exc)) from None
+            raise
+        out = array("q")
+        out.frombytes(raw)
+        self.received += 1
+        return out.tolist()
+
+    def close(self) -> None:
+        self.tcp.close()
+
+
+def _capacity(cpu: int) -> int:
+    try:
+        return int(open(f"/sys/devices/system/cpu/cpu{cpu}/cpu_capacity").read().strip())
+    except (OSError, ValueError):
+        return 0
+
+
+def pin_cpu(raw: str | None = None) -> int | None:
+    """TF_DSV41_PLAN_PIN: None (unset / -1 / off), an explicit CPU, or ``auto``: the highest ``cpu_capacity`` allowed CPU other
+    than the RoCE proxy's (GLM53_TF_ROCE_CPU), the highest id on ties."""
+
+    v = (os.environ.get("TF_DSV41_PLAN_PIN", "") if raw is None else raw).strip().lower()
+    if v in ("", "-1", "off", "none"):                  # GLM53_TF_ROCE_CPU's convention: -1 = not pinned
+        return None
+    allowed = sorted(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else []
+    if v != "auto":
+        cpu = int(v)
+        if allowed and cpu not in allowed:
+            raise ValueError(f"TF_DSV41_PLAN_PIN={cpu}: not an allowed CPU ({allowed[0]}..{allowed[-1]})")
+        return cpu
+    proxy = os.environ.get("GLM53_TF_ROCE_CPU", "").strip()
+    cands = [c for c in allowed if str(c) != proxy] or allowed
+    return max(cands, key=lambda c: (_capacity(c), c)) if cands else None
+
+
+class Pinned:
+    """A link whose sending / receiving thread pins itself to ``cpu`` at its first plan (TF_DSV41_PLAN_PIN)."""
+
+    def __init__(self, link, cpu: int) -> None:
+        self.link, self.cpu, self._done = link, int(cpu), set()
+
+    def _pin(self) -> None:
+        import threading
+
+        tid = threading.get_ident()
+        if tid not in self._done:
+            self._done.add(tid)
+            try:
+                os.sched_setaffinity(0, {self.cpu})         # 0: the calling thread
+                print(f"[dsv41] plan link: thread {tid} pinned to cpu {self.cpu}", flush=True)
+            except OSError as exc:
+                print(f"[dsv41] plan link: could not pin to cpu {self.cpu} ({exc})", flush=True)
+
+    def send(self, plan) -> None:
+        self._pin()
+        self.link.send(plan)
+
+    def recv(self) -> list[int]:
+        self._pin()
+        return self.link.recv()
+
+    def __getattr__(self, name):
+        return getattr(self.link, name)
+
+
+def _runtime(engine_link):
+    """The engine's RoCE runtime (proxy, not a test loop), or None (NCCL, or no engine behind the link)."""
+
+    comm = getattr(getattr(engine_link, "engine", None), "comm", None)
+    rt = getattr(comm, "rt", None)
+    return rt if rt is not None and getattr(rt, "proxy", None) is not None else None
+
+
+def make(engine_link, rank: int, master: str, master_port: int, world: int = 2):
+    """The batcher's link: ``engine_link`` (the communicator's) unless TF_DSV41_PLAN_LINK=tcp / rdma (G14); wrapped by
+    ``Pinned`` under TF_DSV41_PLAN_PIN. ``rdma`` at any world size: the mailbox (``roce_msg.h``) is one sender and
+    every other rank a receiver (the proxy posts each chunk to every peer; a slot is reused once every receiver acked
+    it); the TCP links to the followers carry the handshake and their liveness."""
+
+    m = mode()
+    if m == "nccl":
+        link = engine_link
+    elif m == "tcp":
+        link = TcpLink(rank, master, port_for(master_port), world=world)
+    else:
+        rt = _runtime(engine_link)
+        tcp = TcpLink(rank, master, port_for(master_port), world=world)
+        if rt is None:                          # NCCL on both ranks (the RoCE setup is collective): plain tcp
+            print(f"[dsv41] plan link: {ENV}=rdma without a RoCE runtime: tcp", flush=True)
+            link = tcp
+        else:
+            link = RoceLink(rank, tcp, rt.mailbox())
+            print(f"[dsv41] plan link: rdma (RoCE mailbox; spin {link.spin_us:g} us, nap {link.nap_us:g} us)",
+                  flush=True)
+    cpu = pin_cpu()
+    return Pinned(link, cpu) if cpu is not None else link
+
+
+__all__ = ["ENV", "Pinned", "RoceLink", "TcpLink", "make", "mode", "pin_cpu", "port_for"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pool.py b/src/tensorfold/families/deepseek_v41/cuda/pool.py
