+def test_store_overlapping_requests_with_duplicates():
+    """Two live requests share an image, one of them holds it twice; any release order keeps every held id
+    gatherable and ends empty."""
+
+    shot = [VP.VBASE + 20, VP.VBASE + 21]
+    rows = torch.tensor([[20.0], [21.0]], dtype=torch.bfloat16)
+    for order in ((0, 1, 2), (2, 1, 0), (1, 0, 2), (1, 2, 0)):
+        st = V.Store()
+        toks = [st.hold(V.Table(shot + shot, torch.cat([rows, rows]))),
+                st.hold(V.Table(list(shot), rows.clone())),
+                st.hold(V.Table([VP.VBASE + 7] + shot, torch.cat([torch.tensor([[7.0]], dtype=torch.bfloat16), rows])))]
+        live = set(range(3))
+        for k in order:
+            st.release(toks[k])
+            live.discard(k)
+            if live:
+                assert st.gather(shot, "cpu")[:, 0].tolist() == [20.0, 21.0]
+                assert all(st.where[v][0] in st.tables for v in st.where)
+            if 2 in live:
+                assert st.gather([VP.VBASE + 7], "cpu")[0, 0] == 7.0
+        assert len(st) == 0 and not st.refs and not st.tables
+
