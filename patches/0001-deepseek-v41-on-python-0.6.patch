--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/lookup.py
@@ -0,0 +1,272 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Rank 0's per-round drafting plan for DeepSeek-V4.1-Flash (M2): suffix lookup drafts (GLM patches/0020), DSpark
+depth caps and the keyed draft noise, decided in ``batch.Batcher._decode`` and carried by the round plan.
+
+Each decoding slot's round is one of:
+
+- ``l`` lookup: the request's history (prompt + reply) repeats its suffix earlier (``SuffixIndex``: the longest
+  backward match of the last n-gram among its most recent occurrences); the tokens that followed it are the drafts
+  (up to ``TF_DSV41_MAX_ROWS`` - 1 = 15: deep verify windows, GLM 0380). Gated as GLM's ``auto``: the band's running
+  acceptance p (per match-length band, cautious priors for short matches) prices k drafts at
+  E(k) - rate x verify[k] with ``rate`` the request's DSpark rounds' tokens a modelled ms; a lookup round only when
+  that surplus is positive; a band of 16+ token matches skipped 8 times is tried once (its estimate recovers);
+- ``d`` DSpark: ``WindowSpec.depth`` = the most drafts the forward may verify (``depth.Depth`` picks k from the
+  confidence head on both ranks), with the request's sampling settings as the keyed draft noise (``noise``);
+- ``s`` serial: no drafter (``draft=False``, the last token of ``max_tokens``, or no DSpark and no match), or a
+  **skipped pass** (TF_DSV41_DRAFT_SKIP, default 1). A DSpark round's value against a serial round, in tokens, is
+  v = kept - (verify[rows - 1] + draft - verify[0]) / verify[0] (what it committed beyond the serial token, minus its
+  extra modelled ms at the serial rate): a zero-depth round (``depth.py``) is -draft / verify[0] (~-0.13), a kept
+  first draft at k = 1 ~+0.64, a rejected one ~-0.36. The request skips the pass (a 1-row window, no DSpark) while
+  the upper bound of v's decayed mean, mean + SKIP_Z x its standard error, is below 0: only a stream whose drafting
+  reliably loses (e.g. one whose confidence head keeps choosing zero depth) skips; prose (G4: drafting ~14% above
+  serial, v noisy) does not, so noise cannot switch a good stream off. Only when the request decodes alone (this
+  and the previous round plan one window): in a shared window a slot's rows cost their marginal ~4 ms and the pass
+  runs for the others anyway. Every ``SKIP_PROBE``-th skipped round drafts again (a probe), and the evidence fades
+  by rounds while skipping, so a probe weighs as much as the rounds the skip ran and a recovered stream returns.
+
+Drafts never change a reply (the window, keyed sampler and commit decide every token); everything here is rank 0's
+and travels in the plan, so rank 1 needs none of it. Pure Python.
+
+Knobs: TF_DSV41_LOOKUP (1), TF_DSV41_LOOKUP_MIN (4: the shortest match that drafts), TF_DSV41_MAX_ROWS (16: the
+widest verify window, 2-16), TF_DSV41_DRAFT_SKIP (1, ``depth.env_skip``).
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from collections import deque
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+from tensorfold.families.glm5_next.spark.lookup import BANDS, DECAY, PRIOR_WEIGHT, PROBE_EVERY, PROBE_MATCH, SuffixIndex
+
+from .depth import MAX_ROWS, Costs, best_k, default_costs, env_mode, env_skip
+
+ALT_WINDOW = 8
+SKIP_DECAY = 0.9          # the value of a DSpark round: evidence fades by this a round (n_eff ~19)
+SKIP_MIN = 12             # DSpark rounds seen before a request may skip the pass
+SKIP_Z = 3.0              # skip while mean + SKIP_Z x standard error of the value < 0 (simulated: 2.0 cost
+                          # prose ~0.5% on noise, 3.0 is neutral there and still +2.5-7.5% on streams near 1.0-1.15
+                          # tokens a round)
+SKIP_PROBE = 8            # skipped rounds between two probes (a DSpark round that refreshes the rate)
+
+
+def env_settings() -> tuple[bool, int, int]:
+    """(lookup on, min match, max rows) from TF_DSV41_LOOKUP / _LOOKUP_MIN / _MAX_ROWS."""
+
+    on = os.environ.get("TF_DSV41_LOOKUP", "1").strip().lower() not in ("0", "false", "off", "no", "")
+    least = int(os.environ.get("TF_DSV41_LOOKUP_MIN", "") or 4)
+    rows = int(os.environ.get("TF_DSV41_MAX_ROWS", "") or MAX_ROWS)
+    if not 1 <= least <= 64:
+        raise ValueError(f"TF_DSV41_LOOKUP_MIN={least}: expected 1 to 64")
+    if not 2 <= rows <= MAX_ROWS:
+        raise ValueError(f"TF_DSV41_MAX_ROWS={rows}: expected 2 to {MAX_ROWS}")
+    return on, least, rows
+
+
+def noise_of(sampling) -> list:
+    """The keyed draft noise of a request (``WindowSpec.noise``): [seed, T, top_k, top_p, min_p], [] = greedy."""
+
+    if sampling is None or float(sampling.temperature) <= 0.0:
+        return []
+    return [int(sampling.seed), float(sampling.temperature), int(sampling.top_k), float(sampling.top_p),
+            float(sampling.min_p)]
+
+
+def sampling_of(noise: Sequence) -> object | None:
+    """``noise_of``'s inverse (rank 1 rebuilds the request's ``exact_sampling.Sampling``)."""
+
+    if not noise:
+        return None
+    from tensorfold.engine.exact_sampling import Sampling
+
+    seed, t, top_k, top_p, min_p = noise
+    return Sampling(seed=int(seed), temperature=float(t), top_k=int(top_k), top_p=float(top_p), min_p=float(min_p))
+
+
+@dataclass
+class Request:
+    """One request's drafting state (rank 0)."""
+
+    index: SuffixIndex
+    acc: list = field(default_factory=lambda: [0.0] * len(BANDS))
+    tri: list = field(default_factory=lambda: [0.0] * len(BANDS))
+    skipped: list = field(default_factory=lambda: [0] * len(BANDS))
+    alt: deque = field(default_factory=lambda: deque(maxlen=ALT_WINDOW))       # DSpark / serial rounds
+    kind: str = "s"
+    band: int = 0
+    d_w: float = 0.0                    # DSpark rounds' value v: decayed weight, weight^2, sum v, sum v^2, rounds
+    d_w2: float = 0.0
+    d_v: float = 0.0
+    d_v2: float = 0.0
+    d_n: int = 0
+    since: int = 0                      # skipped rounds since the last probe
+    stats: dict = field(default_factory=lambda: {k: 0 for k in (
+        "windows", "rows", "dspark_rounds", "dspark_drafts", "dspark_kept", "lookup_rounds", "lookup_drafts",
+        "lookup_kept", "serial_rounds", "skip_rounds")})
+
+
+class Planner:
+    """The batcher's drafting decisions: ``start`` at admission, ``window`` each round, ``observe`` after it."""
+
+    def __init__(self, costs: Costs | None = None, *, dspark: bool, cap: int | None = None,
+                 lookup: bool | None = None, min_match: int | None = None, max_rows: int | None = None,
+                 eos: Sequence[int] = (), n: int = 3, skip: bool | None = None) -> None:
+        on, least, rows = env_settings()
+        self.skip = env_skip() if skip is None else bool(skip)
+        self._seen = self._last = 0         # windows planned this round / the previous round (``alone``)
+        self._open = False
+        self.costs = costs or default_costs()
+        self.dspark = bool(dspark)
+        self.cap = env_mode()[1] if cap is None else int(cap)
+        self.lookup = on if lookup is None else bool(lookup)
+        self.min_match = least if min_match is None else int(min_match)
+        self.max_rows = rows if max_rows is None else int(max_rows)
+        self.eos = frozenset(int(t) for t in eos)
+        self.n = max(1, min(n, self.min_match))
+
+    # -- a request -----------------------------------------------------------------------------------------------
+    def start(self, prompt: Sequence[int]) -> Request:
+        idx = SuffixIndex(self.n)
+        if self.lookup:
+            idx.extend(prompt)
+        return Request(idx)
+
+    def _band(self, length: int) -> int:
+        b = 0
+        for i, (least, _) in enumerate(BANDS):
+            if length >= least:
+                b = i
+        return b
+
+    def p(self, r: Request, band: int) -> float:
+        return (r.acc[band] + BANDS[band][1] * PRIOR_WEIGHT) / (r.tri[band] + PRIOR_WEIGHT)
+
+    def alt_rate(self, r: Request) -> float:
+        """Tokens a modelled ms of the request's recent non-lookup rounds (before any: a DSpark round keeping one
+        draft, or a serial step)."""
+
+        if r.alt:
+            return sum(k for k, _ in r.alt) / sum(ms for _, ms in r.alt)
+        c = self.costs
+        return 2.0 / (c.window_ms(2) + c.draft) if self.dspark else 1.0 / c.window_ms(1)
+
+    def window(self, r: Request, left: int, draft: bool = True, stop_eos: bool = True) -> tuple[int, list[int]]:
+        """(DSpark depth cap, lookup drafts) for the round after the request's history; ``left`` tokens may still
+        be emitted (a window of k drafts emits up to k + 1)."""
+
+        room = max(0, int(left) - 1)
+        if not self._open:                  # the first window of a round (``observe`` closes one)
+            self._last, self._seen, self._open = self._seen, 0, True
+        self._seen += 1
+        r.kind = "s"
+        if not draft or room <= 0:
+            return 0, []
+        if self.lookup:
+            drafts, length = r.index.propose(min(self.max_rows - 1, room), self.min_match)
+            if stop_eos and self.eos:
+                for i, d in enumerate(drafts):
+                    if d in self.eos:                 # a draft past the reply's end is never kept
+                        drafts = drafts[:i]
+                        break
+            if drafts:
+                b = self._band(length)
+                k, surplus = best_k([min(self.p(r, b), 0.995)] * len(drafts), self.costs.verify, self.alt_rate(r),
+                                    least=1)
+                go = k > 0 and surplus > 0.0
+                if not go:
+                    r.skipped[b] += 1
+                    go = k > 0 and BANDS[b][0] >= PROBE_MATCH and r.skipped[b] >= PROBE_EVERY
+                if go:
+                    r.skipped[b] = 0
+                    r.kind, r.band = "l", b
+                    return 0, [int(t) for t in drafts[:k]]
+        if self.dspark and self.cap > 0:
+            if self.skips(r):
+                r.stats["skip_rounds"] += 1
+                return 0, []
+            r.kind = "d"
+            return min(self.cap, room), []
+        return 0, []
+
+    def alone(self) -> bool:
+        """The request's window is the only one this round and was the previous round (a one-round lag when a
+        second request starts decoding)."""
+
+        return max(self._seen, self._last) <= 1
+
+    def value(self, r: Request) -> tuple[float, float] | None:
+        """(mean, standard error) of the request's DSpark rounds' value v (tokens a round against serial rounds),
+        or None before SKIP_MIN of them."""
+
+        if r.d_n < SKIP_MIN or r.d_w <= 0:
+            return None
+        m = r.d_v / r.d_w
+        var = max(r.d_v2 / r.d_w - m * m, 0.0)
+        return m, math.sqrt(var * r.d_w2) / r.d_w          # sqrt(var / n_eff), n_eff = w^2 / w2
+
+    def skips(self, r: Request) -> bool:
+        """This round runs without the DSpark pass (a 1-row serial window): see the module docstring."""
+
+        got = self.value(r) if self.skip and self.alone() else None
+        if got is None or got[0] + SKIP_Z * got[1] >= 0.0:
+            r.since = 0
+            return False
+        r.since += 1
+        if r.since > SKIP_PROBE:            # a probe: this round drafts and refreshes the evidence
+            r.since = 0
+            return False
+        r.d_w *= SKIP_DECAY                 # the evidence fades by rounds while skipping: the next probe weighs as
+        r.d_w2 *= SKIP_DECAY * SKIP_DECAY   # much as the rounds the skip ran (mean and spread unchanged)
+        r.d_v *= SKIP_DECAY
+        r.d_v2 *= SKIP_DECAY
+        return True
+
+    def observe(self, r: Request, rows: int, kept: int, emitted: Sequence[int]) -> None:
+        """After the round: ``rows`` the window's rows, ``kept`` drafts kept, ``emitted`` the tokens it added."""
+
+        self._open = False
+        st = r.stats
+        st["windows"] += 1
+        st["rows"] += rows
+        drafts = rows - 1
+        if r.kind == "l":
+            b = r.band
+            r.acc[b] = r.acc[b] * DECAY + kept
+            r.tri[b] = r.tri[b] * DECAY + kept + (1 if kept < drafts else 0)
+            st["lookup_rounds"] += 1
+            st["lookup_drafts"] += drafts
+            st["lookup_kept"] += kept
+        else:
+            ms = self.costs.window_ms(rows) + (self.costs.draft if r.kind == "d" else 0.0)
+            r.alt.append((kept + 1, ms))
+            if r.kind == "d":
+                v0 = self.costs.window_ms(1)
+                v = kept - (ms - v0) / v0
+                r.d_w = r.d_w * SKIP_DECAY + 1.0
+                r.d_w2 = r.d_w2 * SKIP_DECAY * SKIP_DECAY + 1.0
+                r.d_v = r.d_v * SKIP_DECAY + v
+                r.d_v2 = r.d_v2 * SKIP_DECAY + v * v
+                r.d_n += 1
+                st["dspark_rounds"] += 1
+                st["dspark_drafts"] += drafts
+                st["dspark_kept"] += kept
+            else:
+                st["serial_rounds"] += 1
+        if self.lookup:
+            r.index.extend(int(t) for t in emitted)
+
+    def report(self, r: Request) -> dict:
+        """The request's drafting stats (``Job.stats``): rounds, drafts and kept per drafter, tokens a round."""
+
+        st = dict(r.stats)
+        d = st["dspark_rounds"]
+        st["dspark_tokens_per_round"] = round(1 + st["dspark_kept"] / d, 3) if d else None
+        st["tokens_per_round"] = round((st["windows"] + st["dspark_kept"] + st["lookup_kept"]) / st["windows"], 3) \
+            if st["windows"] else None
+        return st
+
+
+__all__ = ["Planner", "Request", "env_settings", "noise_of", "sampling_of"]
