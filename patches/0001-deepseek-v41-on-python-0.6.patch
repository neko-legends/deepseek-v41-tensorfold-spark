+"""patches/0420: the drafters' vocabulary trimmed to a ranked token list (GLM53_TF_DRAFT_VOCAB; DECODE-PLAN E7,
+FR-Spec style).
+
+A draft step's last matmul is the vocabulary head: 77,440 rows a rank (4-bit, 178 MB), about 0.9 ms of a 1.7 ms
+MTP step. With the knob, the drafters score only a list of token ids: each rank a head of its own listed rows (the
+same 4-bit words, scales and biases, gathered once at load), and the draft is drawn among them. The candidates'
+local indices map back to token ids (``ids_of``) before the ranks exchange them, so the draw is the usual keyed rule
+on token ids: the same Gumbel noise per (seed, position, token id) the target uses.
+
+Exactness does not depend on the list. Drafts only propose; every committed token is the target's own keyed sample
+of its full-vocabulary logits (``decode.sample_rows`` / ``batch.sample_multi`` without ``draft``: untouched), and a
+draft is kept exactly when it equals that token. A token outside the list can never be drafted, so a chain of
+accepted drafts ends there (an acceptance cost, docs/DRAFT-VOCAB.md).
+
+Knobs (load time; both ranks must agree, ``Engine`` checks):
+
+- ``GLM53_TF_DRAFT_VOCAB``: ``""`` / ``0`` / ``off`` (default): the whole vocabulary, upstream's code path and graphs.
+  ``N`` (an integer, 128..154,879): each rank drafts over the first N / 2 ids of its vocabulary half (rank 0: ids below
+  77,440) in the shipped ranking (``draft_vocab.txt``, most frequent first; bench/draftvocab.py), then that half's
+  other ids by id, rounded up to a multiple of 64 rows. A path: that file's ids (the same format: token ids, most
+  frequent first, ``#`` comments) take the place of the shipped ranking; each rank drafts over the file's ids in its
+  half (at least 64, rounded up to a multiple of 64 with the half's lowest unlisted ids), so the larger half's count
+  decides the cost. ``path:N`` takes the first N / 2 a half of that file.
+- ``GLM53_TF_DRAFT_VOCAB_ARMS``: which drafters use the list: ``mtp`` (default: the study finds DFlash2 rounds lose
+  more tokens than their one head pass saves), ``dflash``, ``all``.
+- ``GLM53_TF_DRAFT_VOCAB_FALLBACK``: ``RATE[,WINDOW]`` (default ``0.03,256``): a request drafts over the whole
+  vocabulary while more than RATE of the last WINDOW tokens its MTP head absorbed (prompt, then every committed
+  token) are unlisted: a CJK conversation, a file of rare identifiers. ``0`` / ``off``: never. The rule reads only
+  committed tokens, so both ranks decide alike; its graphs (full-head MTP steps, a full-head DFlash2 block) are
+  captured next to the trimmed ones at load.
+"""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+import torch
+
+from .qmm import BN, Q4, make_q4
+
+ENV, ARMS_ENV, FB_ENV = "GLM53_TF_DRAFT_VOCAB", "GLM53_TF_DRAFT_VOCAB_ARMS", "GLM53_TF_DRAFT_VOCAB_FALLBACK"
+RANKING = Path(__file__).with_name("draft_vocab.txt")
+ROWS = BN                               # a rank's rows are a multiple of the matmul's column tile
+MIN_ROWS = 64
+FB_DEFAULT = (0.03, 256)
+
+
+@dataclass(frozen=True)
+class Settings:
+    order: tuple[int, ...]              # token ids, most frequent first
+    half: int                           # ids a half takes from ``order`` (0: all of them)
+    mtp: bool
+    dflash: bool
+    fb_rate: float                      # > 1: never
+    fb_window: int
+    source: str
+
+    def ints(self) -> list[int]:  # noqa: D401
+        """What both ranks must agree on, as integers (``Engine._gather_ints``)."""
+
+        digest = hashlib.sha256(",".join(map(str, self.order)).encode()).digest()
+        return [1, self.half, int(self.mtp), int(self.dflash), int(round(min(self.fb_rate, 2.0) * 1e6)),
+                self.fb_window, int.from_bytes(digest[:4], "little") & 0x7FFFFFFF]
+
+
+def read_ids(path: str | Path, vocab: int | None = None) -> list[int]:
+    """A token list file: whitespace-separated ids (``#`` starts a comment), most frequent first; repeats keep
+    their first place."""
+
+    out: dict[int, None] = {}
+    for n, line in enumerate(Path(path).read_text().splitlines(), 1):
+        for word in line.split("#", 1)[0].split():
+            try:
+                i = int(word)
+            except ValueError:
+                raise ValueError(f"{ENV}: {path}:{n}: {word!r} is not a token id") from None
+            if i < 0 or (vocab is not None and i >= vocab):
+                raise ValueError(f"{ENV}: {path}:{n}: token id {i} outside the vocabulary (0..{(vocab or 1) - 1})")
+            out.setdefault(i, None)
+    if not out:
+        raise ValueError(f"{ENV}: {path}: no token ids")
+    return list(out)
+
+
+def _fallback(value: str) -> tuple[float, int]:
+    v = value.strip().lower()
+    if v in ("0", "off", "no", "none"):
+        return 2.0, 1
+    if not v:
+        return FB_DEFAULT
+    try:
+        parts = [p.strip() for p in v.split(",")]
+        rate = float(parts[0])
+        window = int(parts[1]) if len(parts) > 1 and parts[1] else FB_DEFAULT[1]
+    except (ValueError, IndexError):
+        raise ValueError(f"{FB_ENV}={value!r}: expected RATE[,WINDOW] (e.g. 0.03,256) or off") from None
+    if not 0.0 < rate < 1.0 or not 16 <= window <= 65536:
+        raise ValueError(f"{FB_ENV}={value!r}: RATE in (0, 1), WINDOW in 16..65536")
+    return rate, window
+
+
+def settings(env: dict | None = None, vocab: int = 154880) -> Settings | None:
+    """The knobs, parsed (None: off). Raises ValueError on a bad value, at load."""
+
+    env = os.environ if env is None else env
+    v = str(env.get(ENV, "")).strip()
+    if v.lower() in ("", "0", "off", "no", "false", "none"):
+        return None
+    arms = str(env.get(ARMS_ENV, "") or "mtp").strip().lower()
+    if arms not in ("mtp", "dflash", "all"):
+        raise ValueError(f"{ARMS_ENV}={arms!r}: expected mtp, dflash or all")
+    rate, window = _fallback(str(env.get(FB_ENV, "")))
+    half = 0
+    if v.isdigit():
+        n = int(v)
+        if not 2 * MIN_ROWS <= n < vocab:
+            raise ValueError(f"{ENV}={v}: expected {2 * MIN_ROWS}..{vocab - 1} token ids, a token list file, or off")
+        path, half = RANKING, -(-n // 2)
+    else:
+        path = Path(v)
+        if ":" in v and not path.exists():
+            head, _, tail = v.rpartition(":")
+            if tail.isdigit():
+                path, half = Path(head), -(-int(tail) // 2)
+        if not path.is_file():
+            raise ValueError(f"{ENV}={v!r}: not a number of token ids nor a token list file")
+    order = tuple(read_ids(path, vocab))
+    return Settings(order, half, arms in ("mtp", "all"), arms in ("dflash", "all"), rate, window, str(path))
+
+
+def rank_ids(s: Settings, rank: int, world: int, vocab: int) -> np.ndarray:
+    """This rank's listed token ids in the order of its trimmed head's rows: its half's ids from ``s.order`` (the
+    first ``s.half`` of them, or all), then the half's lowest unlisted ids. Every rank has the same number of rows:
+    ``s.half``, or the larger half's count of listed ids (a draft step lasts as long as the larger half, so the
+    other half's extra rows cost nothing), at least 64, rounded up to a multiple of 64."""
+
+    per = vocab // world
+    lo, hi = rank * per, (rank + 1) * per
+    mine = [i for i in s.order if lo <= i < hi]
+    if s.half:
+        mine = mine[:s.half]
+        want = s.half
+    else:
+        counts = collections.Counter(min(i // per, world - 1) for i in s.order)
+        want = max(counts.values())
+    want = min(per, -(-max(MIN_ROWS, want) // ROWS) * ROWS)
+    if want >= per:
+        raise ValueError(f"{ENV}: {want} rows a rank is the whole half ({per}): nothing to trim")
+    taken = set(mine)
+    j = lo
+    while len(mine) < want:
+        if j not in taken:
+            mine.append(j)
+        j += 1
+    return np.asarray(mine, dtype=np.int64)
+
+
+def take_rows(q: Q4, rows: torch.Tensor) -> Q4:
+    """The rows ``rows`` (local indices) of a tiled 4-bit matrix as a 4-bit matrix of their own: the same words,
+    scales and biases (only the listed rows are read; nothing the size of the whole head is allocated)."""
+
+    rows = rows.to(device=q.weight.device, dtype=torch.long)
+    if rows.numel() == 0 or int(rows.min()) < 0 or int(rows.max()) >= q.n:
+        raise ValueError(f"take_rows: rows outside 0..{q.n - 1}")
+    words = q.weight[rows // BN, :, rows % BN, :]                        # [m, K/64, 8]
+    words = words.reshape(rows.numel(), q.k // 8)
+    return make_q4(words.contiguous(), q.scales[:, rows].t().contiguous(), q.biases[:, rows].t().contiguous())
+
+
+@dataclass
+class DraftVocab:
+    s: Settings
+    head: Q4                            # this rank's listed rows
+    gids: torch.Tensor                  # int32 [n]: row r's token id
+    n: int
+
+    @property
+    def mtp(self) -> bool:
+        return self.s.mtp
+
+    @property
+    def dflash(self) -> bool:
+        return self.s.dflash
+
+    @property
+    def fallback(self) -> bool:
+        return self.s.fb_rate < 1.0
+
+
+def attach(w, s: Settings | None = None) -> DraftVocab | None:
+    """``w.draft_vocab`` for this rank from the knobs (None: off; upstream's heads). The rows come from the head
+    the drafters read today (``w.draft_head``, else ``w.head``), which must be 4-bit."""
+
+    s = settings() if s is None else s
+    if s is None:
+        w.draft_vocab = None
+        return None
+    src = w.draft_head if w.draft_head is not None else w.head
+    if not isinstance(src, Q4):
+        raise ValueError(f"{ENV}: the drafters' head is not 4-bit ({type(src).__name__}); trimming needs a 4-bit head")
+    ids = rank_ids(s, w.rank, w.world, w.cfg.vocab)
+    local = torch.from_numpy(ids - w.vocab_offset).to(w.device)
+    dv = DraftVocab(s, take_rows(src, local), torch.from_numpy(ids).to(device=w.device, dtype=torch.int32), len(ids))
+    w.draft_vocab = dv
+    return dv
+
+
+def of(w) -> DraftVocab | None:
+    return getattr(w, "draft_vocab", None)
+
+
+# -- which head a pass reads, and which ids its columns are -------------------------------------------------------
+def upstream_head(w):
+    return w.draft_head if w.draft_head is not None else w.head
+
+
+def head_for(w, arm: str, full: bool = False):
+    """The head a draft pass of ``arm`` ("mtp" / "dflash") reads: the listed rows unless ``full`` or the arm is
+    not trimmed."""
+
+    dv = of(w)
+    if dv is None or full or not (dv.mtp if arm == "mtp" else dv.dflash):
+        return upstream_head(w)
+    return dv.head
+
+
+def ids_of(w, local: torch.Tensor, width: int) -> torch.Tensor:
+    """Token ids (int32) of draft logits' column indices ``local``: a pass over the listed rows (``width`` == the
+    list's rows) maps through them, a full-head pass adds the rank's vocabulary offset. Capturable (a gather)."""
+
+    dv = of(w)
+    if dv is not None and width == dv.n:
+        return dv.gids[local.long()]
+    return (local + w.vocab_offset).to(torch.int32)
+
+
+# -- the fallback rule ---------------------------------------------------------------------------------------------
+def track(w, st, tokens: Sequence[int]) -> None:
+    """The tokens the MTP head is about to absorb for ``st`` (prompt positions, then committed ones): the rule's
+    window. A head starting over (``mtp_len`` 0) starts the window over."""
+
+    dv = of(w)
+    if dv is None or not dv.fallback or not len(tokens):
+        return
+    t = getattr(st, "_dv_window", None)
+    if t is None or getattr(st, "mtp_len", 0) == 0:
+        t = st._dv_window = [collections.deque(maxlen=dv.s.fb_window), 0, None]
+    q = t[0]
+    listed = t[2]
+    if listed is None:
+        listed = t[2] = _listed(dv, w)
+    for tok in list(tokens)[-dv.s.fb_window:]:
+        if int(tok) >= (1 << 24):                   # patches/0500: an image row (a virtual id) is not text
+            continue
+        miss = int(tok) not in listed
+        if len(q) == q.maxlen:
+            t[1] -= q[0]
+        q.append(miss)
+        t[1] += miss
+
+
+def _listed(dv: DraftVocab, w) -> frozenset:
+    """Every listed id of both ranks (the rule must read the same on both: it is computed from the settings)."""
+
+    got = getattr(dv, "_all", None)
+    if got is None:
+        got = frozenset(int(i) for r in range(w.world) for i in rank_ids(dv.s, r, w.world, w.cfg.vocab))
+        dv._all = got
+    return got
+
+
+def full(w, st, arm: str) -> bool:
+    """Whether ``st``'s drafts of ``arm`` ("mtp" / "dflash") use the whole vocabulary now: the fallback rule, for
+    an arm that drafts over the list (False otherwise: an untrimmed arm reads the whole head anyway)."""
+
+    dv = of(w)
+    if dv is None or not dv.fallback or st is None or not (dv.mtp if arm == "mtp" else dv.dflash):
+        return False
+    t = getattr(st, "_dv_window", None)
+    return t is not None and len(t[0]) > 0 and t[1] > dv.s.fb_rate * len(t[0])
+
+
+def describe(dv: DraftVocab, rank: int) -> str:
+    s = dv.s
+    arms = "MTP and DFlash2" if s.mtp and s.dflash else "MTP" if s.mtp else "DFlash2"
+    fb = (f"whole vocabulary while > {s.fb_rate:.1%} of a request's last {s.fb_window} tokens are unlisted"
+          if dv.fallback else "no fallback")
+    return (f"{arms} drafts over {dv.n} listed token ids a rank (rank {rank}; {s.source}"
+            + (f", first {s.half} a half" if s.half else "") + f"; {dv.head.nbytes() / 1e6:.1f} MB head); {fb} "
+            "(patches/0420)")
diff --git a/src/tensorfold/families/glm5_next/spark/dump.py b/src/tensorfold/families/glm5_next/spark/dump.py
new file mode 100644
index 0000000..253cacf
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/dump.py
@@ -0,0 +1,449 @@
+"""patches/0430: per-token training records for the drafters (GLM53_TF_DRAFT_DUMP=<dir>; off by default).
+
+While the engine serves or generates, every row it commits becomes a record for self-distilling the MTP head and
+re-fitting a block drafter (docs/DRAFTER-TRAINING.md): the token, the main model's final-normed row (what the MTP head
+reads, ``decode.Engine.main_hidden``), the DFlash2 taps of that row (the mean of the streams after the drafter's tap
+layers, ``Engine.tap_rows``) and the target's next-token distribution as its top-k log-probabilities over the whole
+vocabulary. Two sites feed it:
+
+- prefill (``decode._prefill``, every mode: exact, fast, lean, row-split, pipelined): each chunk's rows. The engine
+  computes the head for the last row only, so the hook runs the head (the engine's own ``qmm.matmul`` on the
+  final-normed rows, ``HEAD_ROWS`` rows at a time) for all of them;
+- decode (``batch.Batcher._verify``, GLM53_TF_BATCH >= 2 as in production): each round's kept rows, whose logits the
+  verify forward already computed. Single-request engines (GLM53_TF_BATCH=1) dump prefill only.
+
+So a request's records cover its prompt (kind ``p``) and every token it generated (kind ``d``, the target's own
+samples: self-distillation data) in position order.
+
+Both ranks hold half of the vocabulary: each takes the top-k of its half and the log-sum-exp of its half, one
+all-gather (the NCCL control path, never captured) brings both to both ranks, and the merge keeps the k largest of
+the 2k with log-probabilities against the full log-sum-exp. The hidden rows and taps are the same on both ranks, so
+only rank 0 writes (on its host). Both ranks must run with the same GLM53_TF_DRAFT_DUMP on/off (checked at start,
+``setup``); rank 1 computes and gathers but writes nothing.
+
+Nothing here changes a token: the hook reads buffers after the engine used them (before they are overwritten by the
+next forward) and runs its own head matmul into its own scratch; replies are byte-identical with the dump on or off.
+
+Linking. Records are written as segments (a prefill chunk; up to ``FLUSH_ROWS`` decode rows of one slot). A segment
+carries the blake2b-128 hash of the token ids before it (``h0``) and through it (``h1``); a request that resumed from
+a snapshot (sessions, shared prefixes, the previous turn) links to the segments that wrote its prefix, whichever
+request wrote them. ``train/dumpdata.py`` assembles documents by following h1 -> h0 from the empty prefix and drops
+duplicates.
+
+Files (rank 0): ``<dir>/<host>-<pid>-<start>/meta.json``, ``index.jsonl`` (one JSON line a segment: kind, start, n,
+h0, h1, shard, and every array's byte offset, dtype and shape) and ``shard-NNNNN.bin`` (raw little-endian arrays,
+``SHARD_GIB`` GiB each). Per token: tokens int32, hidden bf16 [D], taps bf16 [T D] (or e4m3 + one fp32
+power-of-two scale per tap with GLM53_TF_DRAFT_DUMP_TAPS=fp8, or none with 0), lp float16 [k] (log-probabilities of
+the top k, largest first) and ids int32 [k]. GLM-5.3-Flash (D 4,096, 5 taps, k 32): 49,348 B a token with bf16 taps,
+28,888 B with fp8 taps, 8,388 B without taps.
+
+Knobs (load time, both ranks the same):
+
+    GLM53_TF_DRAFT_DUMP              dir (empty / 0: off)
+    GLM53_TF_DRAFT_DUMP_TOPK         k (32)
+    GLM53_TF_DRAFT_DUMP_TAPS         bf16 | fp8 | 0 (bf16)
+    GLM53_TF_DRAFT_DUMP_WHAT         prefill,decode (both)
+    GLM53_TF_DRAFT_DUMP_GIB          stop writing past this many GiB (512)
+    GLM53_TF_DRAFT_DUMP_TAP_LAYERS   comma list: tap these target layers instead of the drafter's (e.g. DFlash2-G's
+                                     5,9,14,19,24,28,33,38,42 or DSpark's 20,28,32,36,40,44). The loaded DFlash2
+                                     drafter is then not used (its taps would not match): MTP / lookup drafts only.
+"""
+
+from __future__ import annotations
+
+import atexit
+import hashlib
+import json
+import os
+import queue
+import socket
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Sequence
+
+import numpy as np
+import torch
+
+VERSION = 1
+
+
+def _env(name: str, default: str) -> str:
+    return os.environ.get(name, default).strip()
+
+
+def root() -> str:
+    v = _env("GLM53_TF_DRAFT_DUMP", "")
+    return "" if v.lower() in ("", "0", "off", "no", "false") else v
+
+
+ON = bool(root())
+TOPK = int(_env("GLM53_TF_DRAFT_DUMP_TOPK", "32") or 32)
+TAPS = _env("GLM53_TF_DRAFT_DUMP_TAPS", "bf16").lower() or "bf16"
+WHAT = {x.strip() for x in (_env("GLM53_TF_DRAFT_DUMP_WHAT", "prefill,decode") or "prefill,decode").split(",")}
+GIB = float(_env("GLM53_TF_DRAFT_DUMP_GIB", "512") or 512)
+SHARD_GIB = 4.0
+HEAD_ROWS = 256          # prefill rows a head block (a [256, V/2] bf16 logits block is 40 MB)
+FLUSH_ROWS = 256         # decode rows of a slot collected before they become a segment
+FLUSH_S = 10.0           # ... or after this many seconds
+if TAPS not in ("bf16", "fp8", "0"):
+    raise ValueError(f"GLM53_TF_DRAFT_DUMP_TAPS={TAPS!r}: expected bf16, fp8 or 0")
+if not 1 <= TOPK <= 256:
+    raise ValueError(f"GLM53_TF_DRAFT_DUMP_TOPK={TOPK}: expected 1 to 256")
+
+DUMP: "Dumper | None" = None       # built by ``setup`` (both ranks), armed once the engine is ready
+
+
+def tap_layers_env() -> tuple[int, ...] | None:
+    v = _env("GLM53_TF_DRAFT_DUMP_TAP_LAYERS", "")
+    return tuple(int(x) for x in v.split(",") if x.strip()) if v else None
+
+
+def setup(engine, rank: int, drafter):
+    """Before the engine's buffers are built: check both ranks agree, pick the tap layers. -> (drafter, taps)."""
+
+    global DUMP
+    layers = tap_layers_env() if ON else None
+    mine = [int(ON), TOPK, ("bf16", "fp8", "0").index(TAPS), len(layers or ())]
+    both = engine._gather_ints(mine)
+    if both[0] != both[1]:
+        raise RuntimeError(f"the two ranks were started with different GLM53_TF_DRAFT_DUMP settings (on, topk, taps, "
+                           f"tap layers): {both[0]}, {both[1]}")
+    taps = drafter.tap_layers if drafter is not None else ()
+    if layers is not None and tuple(layers) != tuple(taps):
+        if rank == 0:
+            print(f"[tensorfold] draft dump (patches/0430): taps at layers {list(layers)}; the DFlash2 drafter "
+                  f"(taps {list(taps)}) is not used while they differ", flush=True)
+        drafter, taps = None, tuple(layers)
+    if ON:
+        DUMP = Dumper(engine.w, root(), taps)
+    return drafter, taps
+
+
+def arm() -> None:
+    """The engine is ready: records from here on (calibration and graph-capture passes are not written)."""
+
+    if DUMP is not None:
+        DUMP.armed = True
+        if DUMP.rank == 0:
+            print(f"[tensorfold] draft dump (patches/0430): {DUMP.dir} (top {TOPK}, taps {TAPS} "
+                  f"{list(DUMP.tap_layers)}, {sorted(WHAT)}, up to {GIB:g} GiB; ~{DUMP.bytes_per_token():,} B a "
+                  "token)", flush=True)
+
+
+def _nonexpert_key() -> str:
+    """The stored non-expert precision (patches/0470: GLM53_TF_NONEXPERT with GLM53_TF_NONEXPERT_MAP resolved)."""
+
+    from . import weights
+
+    return weights.precision_key()
+
+
+def _hash_ids(ids) -> "hashlib._Hash":
+    h = hashlib.blake2b(digest_size=16)
+    if len(ids):
+        h.update(np.asarray(ids, dtype="<i4").tobytes())
+    return h
+
+
+def _bf16_bytes(t: torch.Tensor) -> np.ndarray:
+    return t.contiguous().view(torch.int16).cpu().numpy().view(np.uint16)
+
+
+def fp8_rows(x: torch.Tensor, taps: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """[R, taps * D] bf16 -> (e4m3 bytes [R, taps * D] uint8, fp32 scales [R, taps]): per (row, tap) the smallest
+    power of two s with amax / s <= 448, values rounded to nearest even (patches/0220's latent-row rule)."""
+
+    R = x.shape[0]
+    xf = x.float().view(R, taps, -1)
+    amax = xf.abs().amax(-1).clamp_min(2.0 ** -120)
+    e = torch.ceil(torch.log2(amax / 448.0))
+    scale = torch.exp2(e)
+    q = (xf / scale[..., None]).to(torch.float8_e4m3fn)
+    return q.view(torch.uint8).view(R, -1), scale.float()
+
+
+class _Writer:
+    """Rank 0's shard files, index and the thread that writes them."""
+
+    def __init__(self, d: Path, meta: dict) -> None:
+        self.dir = d
+        d.mkdir(parents=True, exist_ok=True)
+        (d / "meta.json").write_text(json.dumps(meta, indent=1))
+        self.index = open(d / "index.jsonl", "a", buffering=1)
+        self.shard_no, self.shard, self.shard_bytes = 0, None, 0
+        self.total = 0
+        self.segs = 0
+        self.dropped = 0
+        self.full = False
+        self.q: queue.Queue = queue.Queue(maxsize=4)          # <= 4 segments in flight (~0.8 GB host RAM at most)
+        self.t = threading.Thread(target=self._run, name="draft-dump", daemon=True)
+        self.t.start()
+
+    def _open(self) -> None:
+        if self.shard is not None:
+            self.shard.close()
+        self.shard_no += 1
+        self.shard_name = f"shard-{self.shard_no:05d}.bin"
+        self.shard = open(self.dir / self.shard_name, "ab")
+        self.shard_bytes = self.shard.tell()
+
+    def put(self, rec: dict) -> None:
+        if self.full:
+            return
+        try:
+            self.q.put(rec, timeout=30)
+        except queue.Full:
+            self.dropped += 1
+            if self.dropped == 1:
+                print("[tensorfold] draft dump: the writer fell behind; segments dropped (counted in meta)",
+                      file=sys.stderr, flush=True)
+
+    def _run(self) -> None:
+        while True:
+            rec = self.q.get()
+            if rec is None:
+                break
+            try:
+                self._write(rec)
+            except Exception as exc:  # noqa: BLE001 - a dump failure never stops serving
+                print(f"[tensorfold] draft dump: write failed ({type(exc).__name__}: {exc}); dump stopped",
+                      file=sys.stderr, flush=True)
+                self.full = True
+
+    def _write(self, rec: dict) -> None:
+        arrays = rec.pop("arrays")
+        size = sum(a.nbytes for a in arrays.values())
+        if self.total + size > GIB * 2**30:
+            if not self.full:
+                print(f"[tensorfold] draft dump: {GIB:g} GiB written; dump stopped", file=sys.stderr, flush=True)
+            self.full = True
+            return
+        if self.shard is None or self.shard_bytes + size > SHARD_GIB * 2**30:
+            self._open()
+        where = {}
+        for name, a in arrays.items():
+            a = np.ascontiguousarray(a)
+            where[name] = [self.shard_bytes, rec["dtypes"].get(name, str(a.dtype)), list(a.shape)]
+            self.shard.write(a.tobytes())
+            self.shard_bytes += a.nbytes
+        self.shard.flush()
+        self.total += size
+        self.segs += 1
+        rec.pop("dtypes")
+        rec.update(seg=self.segs, shard=self.shard_name, arrays=where)
+        self.index.write(json.dumps(rec) + "\n")
+
+    def close(self) -> None:
+        self.q.put(None)
+        self.t.join(timeout=120)
+        if self.shard is not None:
+            self.shard.close()
+        self.index.close()
+
+
+class Dumper:
+    def __init__(self, w, where: str, taps: Sequence[int]) -> None:
+        self.w = w
+        self.rank = int(w.rank)
+        self.world = int(w.world)
+        self.tap_layers = tuple(int(t) for t in taps) if TAPS != "0" else ()
+        self.armed = False
+        self.chains: dict[int, list] = {}          # id(State) -> [pos, blake2b of the ids before pos]
+        self.pending: dict[int, dict] = {}         # id(State) -> decode rows not yet written
+        self.writer = None
+        self.stats = {"prefill_rows": 0, "decode_rows": 0, "segments": 0}
+        if self.rank == 0:
+            d = Path(where) / f"{socket.gethostname()}-{os.getpid()}-{int(time.time())}"
+            c = w.cfg
+            meta = {"version": VERSION, "topk": TOPK, "taps": TAPS, "tap_layers": list(self.tap_layers),
+                    "hidden": c.hidden, "vocab": c.vocab, "layers": c.layers, "eos": list(c.eos),
+                    "hidden_is": "final-normed row (decode.Engine.main_hidden: the MTP head's input)",
+                    "taps_are": "mean of the 4 residual streams after each tap layer (DFlash2 taps)",
+                    "lp_are": "log-probabilities of the top-k tokens of the row's next-token distribution, "
+                              "full vocabulary, temperature 1",
+                    "nonexpert": _nonexpert_key(),
+                    "model": str(w.meta.get("model_dir", "")), "started": time.time(),
+                    "env": {k: v for k, v in os.environ.items() if k.startswith("GLM53_TF_")}}
+            self.writer = _Writer(d, meta)
+            self.dir = d
+            atexit.register(self.close)
+        else:
+            self.dir = Path(where)
+
+    def bytes_per_token(self) -> int:
+        D = self.w.cfg.hidden
+        T = len(self.tap_layers)
+        taps = {"bf16": 2 * T * D, "fp8": T * D + 4 * T, "0": 0}[TAPS] if T else 0
+        return 4 + 2 * D + taps + TOPK * 6
+
+    # -- the target's distribution, both halves of the vocabulary ------------------------------------------------
+    def _local_topk(self, logits: torch.Tensor):
+        lf = logits.float()
+        k = min(TOPK, lf.shape[1])
+        vals, idx = torch.topk(lf, k, dim=-1)
+        lse = torch.logsumexp(lf, dim=-1)
+        ids = (idx + self.w.vocab_offset).to(torch.float32)          # exact: vocab < 2^24
+        return torch.cat([vals, ids, lse[:, None]], dim=1)
+
+    def _merge(self, packed: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """[R, 2k+1] of this rank -> (lp [R, k] fp32, ids [R, k] int32) over the whole vocabulary."""
+
+        R, width = packed.shape
+        k = (width - 1) // 2
+        w = self.w
+        if w.comm is not None and self.world > 1:
+            got = torch.empty((self.world * packed.numel(),), dtype=torch.float32, device=packed.device)
+            w.comm.all_gather(packed.contiguous().view(-1), got)
+            g = got.view(self.world, R, width)
+        else:
+            g = packed.view(1, R, width)
+        vals = torch.cat([g[r, :, :k] for r in range(g.shape[0])], dim=1)
+        ids = torch.cat([g[r, :, k:2 * k] for r in range(g.shape[0])], dim=1)
+        lse = torch.logsumexp(g[:, :, 2 * k], dim=0)
+        top, pick = torch.topk(vals, k, dim=-1)
+        return top - lse[:, None], torch.gather(ids, 1, pick).to(torch.int32)
+
+    def _head_rows(self, hidden: torch.Tensor) -> torch.Tensor:
+        """The engine's head over rows it did not compute logits for: the same kernel as a verify window."""
+
+        from . import qmm
+
+        w = self.w
+        out = []
+        for a in range(0, hidden.shape[0], HEAD_ROWS):
+            x = hidden[a:a + HEAD_ROWS]
+            if not x.is_contiguous():
+                x = x.contiguous()
+            xs = qmm.group_sums(x) if isinstance(w.head, qmm.Q4) else None
+            logits = qmm.matmul(x, w.head, xs)
+            out.append(self._local_topk(logits))
+            del logits
+        return torch.cat(out, dim=0)
+
+    def _taps(self, taps: torch.Tensor | None) -> dict:
+        if taps is None or not self.tap_layers:
+            return {}
+        if TAPS == "fp8":
+            q, s = fp8_rows(taps, len(self.tap_layers))
+            return {"taps": q, "tap_scale": s}
+        return {"taps": taps}
+
+    # -- sites ---------------------------------------------------------------------------------------------------
+    @torch.no_grad()
+    def prefill_chunk(self, e, prompt: Sequence[int], start: int, stop: int, begin: int) -> None:
+        if not self.armed or "prefill" not in WHAT:
+            return
+        R = stop - start
+        hidden = e.main_hidden(slice(0, R))
+        taps = e.tap_rows(R) if self.tap_layers else None
+        lp, ids = self._merge(self._head_rows(hidden))
+        key = id(e.st)
+        if self.rank != 0:
+            return
+        if start == begin or key not in self.chains or self.chains[key][0] != start:
+            self._flush(key)                         # a new request on this state: its decode rows end here
+            self.chains[key] = [start, _hash_ids(prompt[:start])]
+        chain = self.chains[key]
+        h0 = chain[1].hexdigest()
+        toks = np.asarray(prompt[start:stop], dtype="<i4")
+        chain[1].update(toks.tobytes())
+        chain[0] = stop
+        arrays = {"tokens": toks, "hidden": hidden, "lp": lp, "ids": ids, **self._taps(taps)}
+        self._emit("p", start, R, h0, chain[1].hexdigest(), arrays)
+        self.stats["prefill_rows"] += R
+
+    @torch.no_grad()
+    def decode_round(self, e, logits: torch.Tensor, items: Sequence[tuple]) -> None:
+        """``items``: (state, row offset in the forward, rows kept, the kept rows' input tokens, position of the
+        first) for every slot of the round, in the same order on both ranks."""
+
+        if not self.armed or "decode" not in WHAT or not items:
+            return
+        rows = torch.cat([torch.arange(off, off + keep, device=logits.device) for _, off, keep, _, _ in items])
+        packed = self._local_topk(logits.index_select(0, rows))
+        lp, ids = self._merge(packed)
+        if self.rank != 0:
+            return
+        b = e.buf
+        hidden = b.fnormed.index_select(0, rows)
+        taps = torch.cat([t.index_select(0, rows) for t in b.taps], dim=1) if (self.tap_layers and b.taps) else None
+        tp = self._taps(taps)
+        at = 0
+        now = time.monotonic()
+        host = {"hidden": hidden.cpu(), "lp": lp.cpu(), "ids": ids.cpu(), **{k: v.cpu() for k, v in tp.items()}}
+        for st, off, keep, toks, pos in items:
+            key = id(st)
+            chain = self.chains.get(key)
+            if chain is None or chain[0] != pos:
+                self._flush(key)
+                chain = self.chains[key] = [pos, None]          # prefix unknown: an orphan run (h0 null)
+            p = self.pending.get(key)
+            if p is None:
+                p = self.pending[key] = {"start": pos, "h0": chain[1].hexdigest() if chain[1] is not None else None,
+                                         "tok": [], "parts": [], "t": now}
+            p["tok"].extend(int(t) for t in toks[:keep])
+            p["parts"].append({k: v[at:at + keep] for k, v in host.items()})
+            if chain[1] is not None:
+                chain[1].update(np.asarray(toks[:keep], dtype="<i4").tobytes())
+            chain[0] = pos + keep
+            at += keep
+            self.stats["decode_rows"] += keep
+            if len(p["tok"]) >= FLUSH_ROWS:
+                self._flush(key)
+        for key, p in list(self.pending.items()):
+            if now - p["t"] > FLUSH_S:
+                self._flush(key)
+
+    def _flush(self, key: int) -> None:
+        p = self.pending.pop(key, None)
+        if p is None or not p["tok"]:
+            return
+        chain = self.chains.get(key)
+        h1 = chain[1].hexdigest() if chain is not None and chain[1] is not None else None
+        arrays = {"tokens": np.asarray(p["tok"], dtype="<i4")}
+        for name in p["parts"][0]:
+            arrays[name] = torch.cat([part[name] for part in p["parts"]], dim=0)
+        self._emit("d", p["start"], len(p["tok"]), p["h0"], h1, arrays)
+
+    def _emit(self, kind: str, start: int, n: int, h0, h1, arrays: dict) -> None:
+        dtypes = {}
+        host = {}
+        for name, a in arrays.items():
+            if isinstance(a, torch.Tensor):
+                if a.dtype == torch.bfloat16:
+                    host[name] = _bf16_bytes(a)
+                    dtypes[name] = "bfloat16"
+                    continue
+                if name == "lp":
+                    a = a.to(torch.float16)
+                a = a.cpu().numpy()
+            if name == "taps" and TAPS == "fp8":
+                dtypes[name] = "float8_e4m3fn"
+            host[name] = a
+        self.stats["segments"] += 1
+        self.writer.put({"kind": kind, "start": int(start), "n": int(n), "h0": h0, "h1": h1, "t": round(time.time(), 3),
+                         "tap_layers": list(self.tap_layers), "arrays": host, "dtypes": dtypes})
+
+    def close(self) -> None:
+        if self.writer is None:
+            return
+        for key in list(self.pending):
+            self._flush(key)
+        w, self.writer = self.writer, None
+        w.close()
+        meta = json.loads((w.dir / "meta.json").read_text())
+        meta.update(closed=time.time(), bytes=w.total, segments=w.segs, dropped=w.dropped, stats=self.stats)
+        (w.dir / "meta.json").write_text(json.dumps(meta, indent=1))
+
+
+# -- the engine's hooks (no-ops when the dump is off) ---------------------------------------------------------------
+def prefill_chunk(e, prompt, start: int, stop: int, begin: int) -> None:
+    if DUMP is not None:
+        DUMP.prefill_chunk(e, prompt, start, stop, begin)
+
+
+def decode_round(e, logits, items) -> None:
+    if DUMP is not None:
+        DUMP.decode_round(e, logits, items)
diff --git a/src/tensorfold/families/glm5_next/spark/engine.py b/src/tensorfold/families/glm5_next/spark/engine.py
new file mode 100644
index 0000000..f38bb1a
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/engine.py
@@ -0,0 +1,1287 @@
+"""GLM-5.3-Flash's CUDA engine behind the Spark server (``server.py``): two ranks over NCCL, one per machine.
+
+Rank 0 serves HTTP and sends each request's header and prompt to rank 1 over the engine's all-gather; both ranks
+then run the same prefill and drafted decode. Both sample every row with the same keyed rule from the same
+gathered candidates, so they agree without a broadcast, and the reply is byte-identical to serial decoding on
+the same two ranks.
+
+Prefix reuse: the committed state after the last request's prompt and after its reply are kept (``decode.
+Snapshot``), and a prompt that extends either resumes from it. Rows never depend on their chunk-mates, so a
+resumed prompt ends in the state a fresh prefill gives. Both ranks keep the same snapshots; rank 0 names the one
+it resumes from in the header.
+
+Fast prefill (patches/0080, GLM53_TF_FAST_PREFILL=1, ``fastpf.py``): prefill chunks run kernels that are not
+row-invariant, at absolute multiples of a chunk grid C; the only state kept is the prompt's at its last grid point
+(no snapshot after the reply), and fast requests resume only from such snapshots of their own grid, which keeps
+resumed == fresh and drafted == serial (the proof is in ``fastpf``).
+
+Sessions (patches/0110, GLM53_TF_SESSION_GIB > 0, ``sessions.py``): besides those two snapshots, a store of many
+sessions' snapshots and attention rows (paged, shared prefixes stored once, least recently used evicted) that a
+request resumes from by copying them into the live caches, when that resumes more of its prompt; rank 0 decides and
+sends the plan after the prompt. ``cached`` in the stats (``usage.prompt_tokens_details.cached_tokens``) is the
+prompt prefix a request resumed from either. patches/0250 (GLM53_TF_SESSION_DISK, ``sessdisk.py``): the store's entries
+also on local NVMe, restored from there (read straight into the live caches) when the RAM store no longer holds
+them, also after a restart; ``stats["disk"]`` reports the read.
+
+A request's draft policy is a spec (the engine's default, or the request's through ``app.GlmApp``):
+
+    0             serial: one token a round
+    N             N MTP drafts a round (the checkpoint's MTP head)
+    a[:LOW:HIGH]  1 to 3 MTP drafts from the running acceptance (the default, a:0.6:0.85)
+    cN:P          up to N MTP drafts while the product of the drafts' own probabilities stays at or above P
+    f...          the same with DFlash2 drafts (fN, fcN:P, fa:...), when both ranks loaded the draft model
+    auto          the default. Greedy requests: each round drafts with the MTP head (c3:0.35) or DFlash2
+                  (fc7:0.3 with patches/0010, GLM53_TF_AUTO_FDRAFTS; upstream fc5:0.3), whichever has committed
+                  more tokens per millisecond in this request
+                  (``decode.DrafterChoice``: 2 rounds of each first, then a 3% margin to switch and one round of
+                  the other every 8). Sampled requests: MTP drafts, 1 to 3 from the running acceptance
+                  (a:0.6:0.85), where DFlash2's sampled chains measured slower. MTP only without the draft model.
+                  On an EXL3 checkpoint with the draft model, every request drafts with DFlash2 (fc5:0.3), which
+                  measured best or tied in all four cells there. A checkpoint without the MTP head drafts with
+                  DFlash2 only (MTP specs run as their DFlash2 versions) and needs the draft model.
+    auto:E:EVERY:MARGIN
+                  the same choice with E rounds of each first, a probe every EVERY rounds and a MARGIN to switch,
+                  for sampled requests too (MTP a:0.6:0.85 against DFlash2 there)
+    lN[:M]        (patches/0020, ``lookup.py``) prompt-lookup drafts: each round whose history (prompt and reply)
+                  ends with a span of at least M tokens (default 3) that occurred before verifies up to N (1 to
+                  7) of the tokens that followed it, with no drafter step; other rounds draft as auto's MTP arm.
+                  ``auto`` (kinds 4, 5) also drafts from the history when GLM53_TF_LOOKUP=1 (the default): a
+                  round with a match of at least GLM53_TF_LOOKUP_MIN tokens (default 4) verifies the lookup's
+                  tokens instead when their expected tokens a millisecond beat the request's MTP / DFlash2 rounds
+    o             (patches/0071, ``depth.py``) auto with cost-derived depths: each round verifies the number of drafts
+                  that maximizes expected committed tokens less the request's running rate times their ms (verify
+                  window, draft steps), from the drafters' probabilities corrected per position by their running
+                  acceptance; the lookup gate the same way. ``auto`` does this when GLM53_TF_DEPTH=cost (rank 0's
+                  setting travels in the header; default: the thresholds above)
+    om[N], of[N]  the same depths with MTP drafts only / DFlash2 drafts only, up to N (default 7)
+"""
+
+from __future__ import annotations
+
+import os
+
+import hashlib
+import json
+import struct
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+from .lookup import LOOKUP_KIND, lookup_for, parse_policy, with_lookup     # patches/0020
+from . import depth as depth_mod                                            # patches/0071
+from . import knobs as knobs_mod                                            # patches/0090
+from . import deep as deep_mod                                              # patches/0380
+
+DEFAULT_POLICY = "auto"
+DFLASH_POLICY = "fc5:0.3"             # DFlash2 drafts every round: up to 5 while their probability product holds 0.3
+EXL3_AUTO = DFLASH_POLICY             # what auto runs on an EXL3 checkpoint with the draft model
+GRAPH_ROWS = (1, 2, 3, 4, 5, 6)       # verify windows captured as CUDA graphs
+# the widest verify window (a pending token and up to 7 drafts); patches/0380: GLM53_TF_MAX_DRAFT_ROWS (8 to 16)
+MAX_ROWS = deep_mod.ROWS
+DENSE_CAPACITY = 2560                 # cache slots while DSA attention stays dense (contexts up to 2,051 tokens)
+
+
+def auto_f_most() -> int:
+    """GLM53_TF_AUTO_FDRAFTS (patches/0010): the most DFlash2 drafts a round of ``auto`` verifies, still cut where
+    the drafts' probability product falls under 0.3 (upstream 5). A DFlash2 block proposes 7 positions for the
+    cost of one pass, and every verify row from the third on costs the same ~4.7 ms, so a 6th and 7th draft are
+    admitted by the same rule and at the same price as the 5th; on confident stretches (structured text, code
+    copied from the context) a round then commits up to 8 tokens instead of 6. Both ranks must agree on it."""
+
+    most = int(os.environ.get("GLM53_TF_AUTO_FDRAFTS", "7"))
+    if not 1 <= most < MAX_ROWS:
+        raise ValueError(f"GLM53_TF_AUTO_FDRAFTS={most}: expected 1 to {MAX_ROWS - 1}")
+    return most
+
+
+def encode_policy(spec: str) -> list[int]:
+    """A policy spec as 4 ints: kind (0 serial, 1 fixed, 2 running acceptance, 3 confidence; plus 10 for DFlash2
+    drafts), most drafts, two parameters in millionths."""
+
+    spec = str(spec).strip()
+    bad = ValueError(f"draft policy {spec!r}: expected auto[:E:EVERY:MARGIN], 0, N, a[:LOW:HIGH], cN:P, or one of "
+                     f"these after f (N from 1 to {MAX_ROWS - 1})")
+    if spec.startswith("fl"):
+        raise bad
+    if spec == "o":                                 # patches/0071: auto with cost-derived depths (header flag)
+        return encode_policy("auto")
+    if spec.startswith("o"):                        # patches/0071: om[N], of[N]
+        code = depth_mod.parse_policy(spec)
+        if code is None:
+            raise bad
+        return code
+    if spec.startswith("l"):                        # patches/0020: lN[:M], prompt-lookup drafts
+        return parse_policy(spec)
+    try:
+        if spec == "auto" or spec.startswith("auto:"):
+            parts = spec.split(":")
+            if len(parts) not in (1, 4):
+                raise bad
+            explore, every, margin = (int(parts[1]), int(parts[2]), float(parts[3])) if len(parts) == 4 else (2, 8, 0.03)
+            if explore < 1 or every < 0 or not 0 <= margin < 1:
+                raise bad
+            return [4 if len(parts) == 1 else 5, explore, every, int(round(margin * 1e6))]
+        if spec.startswith("f"):
+            code = encode_policy(spec[1:])
+            return [code[0] + 10] + code[1:] if code[0] else code
+        if spec.startswith("a"):
+            parts = spec.split(":")
+            if parts[0] != "a" or len(parts) not in (1, 3):
+                raise bad
+            low, high = (float(parts[1]), float(parts[2])) if len(parts) == 3 else (0.8, 0.9)
+            return [2, 3, int(round(low * 1e6)), int(round(high * 1e6))]
+        if spec.startswith("c"):
+            most_text, conf = spec[1:].split(":")
+            most = int(most_text)
+            if not 0 < most < MAX_ROWS:
+                raise bad
+            return [3, most, int(round(float(conf) * 1e6)), 0]
+        most = int(spec)
+    except ValueError:
+        raise bad from None
+    if not 0 <= most < MAX_ROWS:
+        raise bad
+    return [1 if most > 0 else 0, most, 0, 0]
+
+
+def decode_policy(code: list[int]):
+    """The ``decode.DepthPolicy`` for a code, None for serial decoding, or ("auto", explore, every, margin,
+    choose for sampled requests too)."""
+
+    from .decode import DepthPolicy
+
+    kind, most, a, b = code[:4]                     # patches/0020: auto codes carry lookup settings after these
+    if kind == depth_mod.OPT_KIND:                  # patches/0071: om / of; the depths come from depth.py, and this
+        # threshold policy (the drafter's usual one) only where no optimizer runs (GLM53_TF_BATCH rounds)
+        return DepthPolicy(min(most, MAX_ROWS - 1), fixed=True, confidence=0.3 if a else 0.35)
+    if kind == LOOKUP_KIND:
+        return ("lookup", most, a)
+    if kind in (4, 5):
+        return ("auto", most, a, b / 1e6, kind == 5)
+    kind %= 10
+    if kind == 2:
+        return DepthPolicy(min(most, MAX_ROWS - 1), low=a / 1e6, high=b / 1e6)
+    if kind == 3:
+        return DepthPolicy(min(most, MAX_ROWS - 1), fixed=True, confidence=a / 1e6)
+    return DepthPolicy(min(most, MAX_ROWS - 1), fixed=True) if kind == 1 else None
+
+
+def _f64_ints(x: float) -> list[int]:
+    return list(struct.unpack("<2i", struct.pack("<d", float(x))))
+
+
+def _ints_f64(lo: int, hi: int) -> float:
+    return struct.unpack("<d", struct.pack("<2i", lo, hi))[0]
+
+
+class GlmEngine:
+    """GLM-5.3-Flash on two ranks (this one ``rank``): weights, MTP and DFlash2 drafting, per-request policies."""
+
+    vision = None                           # patches/0500: rank 0's ``vision.Encoder`` with GLM53_TF_VISION=1
+
+    def __init__(self, model_dir: Path, *, rank: int, master: str, port: int, policy: str = DEFAULT_POLICY,
+                 drafter: Path | None = None, context: int = 0, serial_only: bool = False, comm=None) -> None:
+        """``comm``: a communicator with ``all_gather`` and ``barrier`` instead of NCCL between two machines (tests)."""
+
+        import torch
+
+        from .comm import NCCL
+        from .decode import Engine
+        from .weights import Config, load
+
+        encode_policy(policy)                           # a bad default fails here, not in the first request
+        torch.cuda.set_device(0)
+        from . import fastboot                          # patches/0140: the boot timeline ([boot] lines)
+
+        fastboot.set_rank(rank)
+        fastboot.mark("start: container, imports, CLI")
+        self.torch = torch
+        self.rank = rank
+        self.model_dir = Path(model_dir)     # patches/0070: the tokenizer the calibration text is tokenized with
+        self.policy = "0" if serial_only else policy
+        self.serial_only = serial_only
+        cfg = Config.read(model_dir)
+        long_context = context > cfg.dense_limit
+        capacity = max(DENSE_CAPACITY, context + MAX_ROWS) if long_context else DENSE_CAPACITY
+        self.limit = capacity - MAX_ROWS if long_context else cfg.dense_limit
+        from . import cpupin, decode_overlap
+
+        cpupin.early(rank)                  # patches/0370 (GLM53_TF_CPU_PIN): before NCCL makes its threads
+        decode_overlap.apply_gil()          # patches/0370 (GLM53_TF_DECODE_OVERLAP ``gil``)
+        self.comm = comm if comm is not None else NCCL(rank, 2, master, port)
+        self.comm.barrier()
+        fastboot.mark("NCCL init (both ranks up)")
+        if comm is None:
+            # patches/0230: GLM53_TF_COMM_BACKEND=roce sends the model's small exchanges over a one-shot RoCE
+            # all-gather (checked equal on both ranks; a failed setup falls back to NCCL on both)
+            # (both ranks always call it: it compares the ranks' settings, whichever backend they asked for)
+            from .roce import select as comm_select
+
+            self.comm = comm_select(self.comm)
+            if hasattr(self.comm, "rt"):
+                fastboot.mark("RoCE all-gather connected")
+        # both ranks must run the same calls: refuse to start when they were given different settings
+        self.f_most = auto_f_most()
+        longctx = int(os.environ.get("GLM53_TF_LONGCTX_GRAPHS", "1").strip() != "0")      # patches/0050
+        # GLM53_TF_PREFILL_ROWS: rows a prefill chunk commits at once (upstream 64). Each chunk reads every weight
+        # once, so larger chunks prefill faster; rows never depend on their chunk-mates, so the committed state
+        # keeps the same bits. Costs about 5 MB of window buffers a row on an EXL3 checkpoint. patches/0090:
+        # GLM53_TF_PREFILL_ROWS_MAX (default: GLM53_TF_PREFILL_ROWS) sizes the buffers, and a request may pick any
+        # chunk up to it (``tf_knobs.prefill_rows``); GLM53_TF_PREFILL_ROWS is the default chunk. patches/0085: it may
+        # be "auto" (``pfgrid.AUTO``: each prefill picks its chunk, up to the buffers; PREFILL_ROWS_MAX default 64).
+        from . import pfgrid
+
+        prefill_rows = pfgrid.parse_rows(os.environ.get("GLM53_TF_PREFILL_ROWS", "64"))
