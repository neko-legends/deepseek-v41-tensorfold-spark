index 0000000..6a10d40
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pfdense.py
@@ -0,0 +1,259 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The dense EXL3 GEMM of fast prefill runs with the trellis decoded inside it (``TF_DSV41_PF_DENSE=fused``, default
+``off``; ``pfdense.cuh``). G16 prefill study: the dense EXL3 GEMMs are ~400 ms of a 2,048-row chunk (one rank, 32K
+prompt, full prefill) against a ~140-160 ms floor (14.9 TFLOP at 94-110 TFLOP/s). The current path
+(``prefill_mm`` -> upstream ``prefill.matmul`` / ``dense3.prefill_matmul``) writes W_q to an fp16 workspace (1.3 ms a
+layer), then Triton's ``_gemm`` reads it back at ~55 TFLOP/s; the input rotation is another 1.4 ms a layer.
+
+What. One CUDA kernel a call (no column blocks: there is no W_q workspace any more), ``upstream rot_in`` unchanged:
+
+- a CTA = BM rows x one 128-column Hadamard block, Triton's GROUP raster; an NST-deep ``cp.async`` ring of 16-byte
+  chunks brings each stage's xh rows (XOR-swizzled for ``ldmatrix``) and the block's trellis words of KS k16 steps as
+  they are stored (the 8 tiles of a k step are contiguous in the strips, stored and dense3 lanes layouts);
+- one stage ahead of the MMA the CTA decodes the stage's 8 KS tiles ONCE into shared memory in mma B-fragment order
+  (upstream ``decode.cuh`` ``decode_lane`` for strips / stored, dense3's lane-bit layout + ``decode2`` for lanes), so
+  every warp of the M tile reads its fragments with one 16-byte ``ld.shared`` and reuses them over its m16 tiles; the
+  decode costs ~2-6 issue slots an mma, not the ~45 a tile a warp of a register-only decode;
+- ``mma.sync.m16n8k16`` f16 -> f32 (sm_121 has no wgmma / TMA tensor maps: REWRITE-PLAN section 7), warp tiles
+  64 x 32 / 32 x 64 / 32 x 32 / 64 x 64 (``CFGS``);
+- the epilogue is Triton's arithmetic: top / rest bf16 through a swizzled shared plane, the 16-step bf16 Hadamard
+  chain from +0 with H's fragments made from constants, ``* (1/sqrt 128)``, ``* svh`` (``+ bias``: one fma), RN cast.
+
+Exactness (every output element, every row count, every configuration == the current path):
+
+1. Triton's ``_gemm`` on sm_121 (Triton 3.8; ``tests/test_dsv41_pfdense.py::test_triton_lowering_pins`` compiles it
+   for sm_121 and checks the PTX): each fp32 accumulator is ONE chain of ``mma.sync.m16n8k16.row.col.f32.f16.f16.f32``
+   over k16 slices in ascending K from +0.0 (MMAv2, k-outer, a BK step = BK / 16 consecutive links); the epilogue
+   is ``cvt.rn.bf16.f32`` (top), ``sub.f32`` + ``cvt.rn`` (rest), one chain of 16 ``m16n8k16 bf16`` from +0 (top's 8
+   k steps, then rest's 8, B = H by ``ldmatrix.trans``), ``mul.f32`` by ``0f3DB504F3``, then ``mul.f32`` by svh
+   (``fma.rn.f32`` with the bias), ``cvt.rn`` to the output dtype.
+2. Here: the A fragments are the same fp16 xh (``ldmatrix`` of the same rows); the B fragments hold upstream unpack's
+   fp16 for the same (k, n) (the same integer states through the same ``decode2``: the CPU emulator checks it on
+   random and the real pack's weights, both layouts); each accumulator gets the same ``mma.sync`` over the same k16
+   slices in the same order from +0; the epilogue repeats 1.'s operations with the same operands (H = +-1 exactly).
+   The MMA is a deterministic function of (C, the A row, the B column), so the results are identical bits.
+   ``tests/dsv41_pfdense_emu.py`` emulates the kernel lane by lane (smem addresses, swizzles, fragments, rounds)
+   under an order-sensitive MMA model and matches a transcription of 1. bit for bit.
+3. Rows never mix (mma rows are independent, rows >= M load zeros and are not stored), and BM / warp grid / KS /
+   NST / GROUP only move where and when an output is computed: so the configuration may depend on the row count
+   (``pick``), the fast tag's row independence holds, and the session tag does not change (``prefill_mm.tag_grid``).
+
+Knobs: ``TF_DSV41_PF_DENSE`` = off (default) | fused; ``TF_DSV41_PF_DENSE_CFG`` = ``id[,group]`` (a sweep: one
+configuration for every shape); ``TF_DSV41_PF_DENSE_TABLE`` = a JSON tuning table (``{"K,N": {"cfg": id, "group": g,
+"small": id, "small_rows": r}}``, the G16 sweep's pick) over ``TABLE``. Prefill only (calib NOT_KNOBS): decode,
+verify and the head never call it. Formats: mul1, K2 8 / 10 / 12 (strips, stored, lanes) and 16 (strips, stored),
+K and N multiples of 128; anything else keeps the current path (``why_not``).
+
+Expected (2,048 rows, one rank; see ``expected_tflops``): wq_b / wo_b / Engram wkv / shared gate-up 80-88 TFLOP/s,
+wo_a / wq_a 75-82, wkv / compressor 70-78, the K = 1,152 / 1,280 layers ~72-78 (their Hadamard epilogue is 20-22% of
+the tensor work); overall ~78-84 vs ~55, -150 to -200 ms a 2,048-row chunk with the unpack's 52 ms.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+ENV = "TF_DSV41_PF_DENSE"
+CFG_ENV = ENV + "_CFG"
+TABLE_ENV = ENV + "_TABLE"
+MODES = ("off", "fused")
+K2S = (8, 10, 12, 16)              # strips / stored widths built (pfdense_k<K2>.cu)
+K2S_LANES = (8, 10, 12)            # lanes widths built (dense3 never repacks the 8-bit indexer wk)
+SMS = 48                           # GB10
+
+# id: (BM, WM, WN, KS, NST), pfdense_args.h's DSV41_PFD_CFGS (test_dsv41_pfdense checks the mirror)
+CFGS = {0: (128, 2, 4, 2, 3), 1: (128, 2, 4, 2, 4), 2: (128, 4, 2, 2, 3), 3: (64, 2, 2, 2, 4), 4: (64, 1, 4, 2, 4),
+        5: (128, 2, 4, 2, 2), 6: (32, 1, 4, 2, 4), 7: (256, 4, 2, 2, 3)}
+
+# The tuning table: (K, N) -> {"cfg", "group", "small", "small_rows"}. Empty until a GPU sweep (g16prefill.sh dsweep:
+# tests/cuda/test_dsv41_pfdense_gpu.py's sweep writes the JSON that TF_DSV41_PF_DENSE_TABLE reads; the window's pick
+# is copied here afterwards). Shapes not in it take ``heuristic``.
+TABLE: dict = {}
+
+
+def _env(env):
+    return os.environ if env is None else env
+
+
+def mode(env=None) -> str:
+    v = (str(_env(env).get(ENV, "off")).strip().lower() or "off")
+    if v in ("0", "no", "false"):
+        v = "off"
+    if v not in MODES:
+        raise ValueError(f"{ENV}={v!r}: expected off or fused")
+    return v
+
+
+def enabled(env=None) -> bool:
+    return mode(env) == "fused"
+
+
+def why_not(lin) -> str | None:
+    """None when this ``Exl3Linear`` runs here, else why it keeps the current path."""
+
+    if lin is None or not hasattr(lin, "words") or not hasattr(lin, "k2"):
+        return "not an EXL3 linear"
+    layout = getattr(lin, "layout", "strips")
+    if layout not in ("strips", "stored", "lanes"):
+        return f"layout {layout}"
+    if lin.codebook != "mul1":
+        return f"codebook {lin.codebook}"
+    if lin.k2 not in (K2S_LANES if layout == "lanes" else K2S):
+        return f"width K2={lin.k2} ({layout})"
+    if lin.k % 128 or lin.n % 128:
+        return "shape"
+    if lin.words.dtype != torch.int32 or not lin.words.is_cuda or not lin.words.is_contiguous():
+        return "words not contiguous int32 on the GPU"
+    return None
+
+
+def stage_k(cfg: int) -> int:
+    return 16 * CFGS[cfg][3]
+
+
+def _blocks_an_sm(cfg: int, k2: int) -> int:
+    """Blocks an SM the shared memory allows (pfdense.cuh Lay: the ring, two decoded B buffers, the epilogue planes;
+    the registers are capped for the same count by the launch bounds)."""
+
+    bm, wm, _, ks, nst = CFGS[cfg]
+    ring = nst * (bm * 16 * ks * 2 + ks * 8 * 16 * k2)
+    smem = max(ring + 2 * ks * 8 * 512, (bm // wm) * 512)
+    return 2 if 2 * (smem + 1024) <= 102400 else 1
+
+
+def _wave_eff(ctas: int, slots: int) -> float:
+    return ctas / (math.ceil(ctas / slots) * slots)
+
+
+def heuristic(k: int, n: int, k2: int, m: int) -> tuple[int, int]:
+    """(cfg, group) before a sweep: the largest row tile whose last wave is not mostly empty (8-warp BM 128 when there
+    are enough CTAs, else 4-warp BM 64, else BM 32); configurations whose stages do not divide K are skipped."""
+
+    nb = n // 128
+    best, best_eff = None, -1.0
+    for cfg in (0, 3, 6):
+        if k % stage_k(cfg):
+            continue
+        bm = CFGS[cfg][0]
+        eff = _wave_eff(math.ceil(m / bm) * nb, SMS * _blocks_an_sm(cfg, k2))
+        if eff > best_eff + 0.10:                    # a smaller tile must win clearly (its decode / A reuse is worse)
+            best, best_eff = cfg, eff
+    return (0 if best is None else best), 8
+
+
+@lru_cache(maxsize=8)
+def _table_file(path: str) -> dict:
+    raw = json.loads(Path(path).read_text())
+    out = {}
+    for key, v in raw.items():
+        k, n = (int(x) for x in key.split(",")[:2])
+        out[(k, n)] = v
+    return out
+
+
+def _override(env) -> tuple[int, int] | None:
+    raw = str(_env(env).get(CFG_ENV, "")).strip()
+    if not raw:
+        return None
+    try:
+        parts = [int(v) for v in raw.split(",")]
+    except ValueError:
+        raise ValueError(f"{CFG_ENV}={raw!r}: expected id[,group]") from None
+    if len(parts) not in (1, 2) or parts[0] not in CFGS or (len(parts) == 2 and not 1 <= parts[1] <= 1024):
+        raise ValueError(f"{CFG_ENV}={raw!r}: id one of {sorted(CFGS)}, group 1-1024")
+    return parts[0], parts[1] if len(parts) == 2 else 8
+
+
+def pick(k: int, n: int, k2: int, m: int, env=None) -> tuple[int, int]:
+    """(cfg, group) for an [m, k] @ [k, n] call: the sweep override, the JSON table, ``TABLE``, else ``heuristic``.
+    Any choice gives the same bits (module notes, 3.); a choice whose stage does not divide K falls back to it."""
+
+    got = _override(env)
+    if got is None:
+        path = str(_env(env).get(TABLE_ENV, "")).strip()
+        entry = (_table_file(path) if path else {}).get((k, n)) or TABLE.get((k, n))
+        if entry:
+            cfg = int(entry["cfg"])
+            if m <= int(entry.get("small_rows", 0)) and "small" in entry:
+                cfg = int(entry["small"])
+            got = cfg, int(entry.get("group", 8))
+    if got is None or got[0] not in CFGS or k % stage_k(got[0]):
+        return heuristic(k, n, k2, m)
+    return got
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    srcs = [here / "pfdense.cpp"] + [here / f"pfdense_k{k2}.cu" for k2 in K2S]
+    return load(name="tf_dsv41_pfdense_v1", sources=[str(s) for s in srcs],
+                extra_include_paths=[str(here), str(Path(upstream.__file__).parent)],
+                extra_cuda_cflags=["-O3", "--expt-relaxed-constexpr"], verbose=False)
+
+
+def gemm(lin, xh: torch.Tensor, out: torch.Tensor, cfg: int | None = None, group: int | None = None) -> torch.Tensor:
+    """out [M, N] (a view, unit column stride) = epi(xh @ W_q) of an eligible ``Exl3Linear`` from its rotated input."""
+
+    m = xh.shape[0]
+    c, gr = pick(lin.k, lin.n, lin.k2, m)
+    c = c if cfg is None else cfg
+    gr = gr if group is None else group
+    sk, snb = lin.strides
+    _ext().gemm(xh, lin.words, sk, snb, lin.svh, lin.bias, out, lin.k2, getattr(lin, "layout", "") == "lanes", c, gr)
+    return out
+
+
+def matmul(lin, x: torch.Tensor, out: torch.Tensor, ws) -> torch.Tensor:
+    """``prefill_mm.matmul``'s fused path: upstream ``rot_in`` into the workspace's xh, then the fused GEMM over the
+    whole layer (``out``: [M, N] of the call's dtype, unit column stride)."""
+
+    from tensorfold.cuda.exl3.linear import _ext as upstream_ext
+
+    m, k = x.shape[0], lin.k
+    if x.shape[1] != k or out.shape != (m, lin.n) or out.stride(1) != 1:
+        raise ValueError(f"pfdense: x {tuple(x.shape)} and out {tuple(out.shape)} do not match K={k}, N={lin.n}")
+    xh = ws._grow("xh", m * k, x.device)[:m * k].view(m, k)
+    upstream_ext().rot_in(x.contiguous(), lin.suh, xh)
+    return gemm(lin, xh, out)
+
+
+def dequant(lin) -> torch.Tensor:
+    """W_q [K, N] fp16 through the fused kernel's decode and fragment order (tests: == ``lin.unpack()``)."""
+
+    w = torch.empty((lin.k, lin.n), dtype=torch.float16, device=lin.words.device)
+    _ext().dequant(lin.words, w, *lin.strides, lin.k2, getattr(lin, "layout", "") == "lanes")
+    return w
+
+
+def describe(k2: int, lanes: bool, cfg: int) -> dict:
+    v = _ext().describe(k2, lanes, cfg)
+    return dict(zip(("bm", "wm", "wn", "ks", "nst", "threads", "smem", "per_sm"), v))
+
+
+# -- the model behind the expected numbers (docs; G16 GPU tuning replaces it) ----------------------------------------
+PEAK = 105.0                       # TFLOP/s, mma.sync f16 -> f32 on GB10 (M1-STATUS: ~110; the study's 94-110 floor)
+PIPE = 0.88                        # the main loop's share of peak with 2 CTAs an SM (cp.async ring + decode overlap)
+
+
+def expected_tflops(k: int, n: int, m: int = 2048, k2: int = 10) -> float:
+    """Useful TFLOP/s (2 M K N / time) by the model: peak x pipeline x the last wave's fill / (1 + the epilogue's
+    share of the tensor work: 2 bf16 chains of K = 128 an output vs the main chain's K, i.e. 256 / K)."""
+
+    cfg, _ = heuristic(k, n, k2, m)
+    bm = CFGS[cfg][0]
+    eff = _wave_eff(math.ceil(m / bm) * (n // 128), SMS * _blocks_an_sm(cfg, k2))
+    return PEAK * PIPE * eff / (1.0 + 256.0 / k)
+
+
+__all__ = ["CFGS", "CFG_ENV", "ENV", "K2S", "K2S_LANES", "MODES", "TABLE", "TABLE_ENV", "dequant", "describe",
+           "enabled", "expected_tflops", "gemm", "heuristic", "matmul", "mode", "pick", "stage_k", "why_not"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/pfdense_args.h b/src/tensorfold/families/deepseek_v41/cuda/pfdense_args.h
new file mode 100644
index 0000000..f4e1d1b
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pfdense_args.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+// pfdense (TF_DSV41_PF_DENSE=fused): the launch arguments and the configuration list, shared by the kernels
+// (pfdense.cuh, nvcc) and the bindings (pfdense.cpp, the host compiler): no device code here.
+#pragma once
+
+#include <cstdint>
+#include <cuda_runtime_api.h>
+
+namespace dsv41_pfd {
+
+enum OutType : int { OUT_F16 = 0, OUT_BF16 = 1, OUT_F32 = 2 };
+
+struct Args {
+    const void* xh;            // [M, K] fp16, the rotated input (upstream rot_in), contiguous
+    const uint32_t* T;         // trellis words: tile (kt, nt) at kt * stride_k + (nt / 8) * stride_nb + (nt % 8) * 4 K2
+    long long stride_k, stride_nb;
+    const void* svh;           // fp16 [N]
+    const void* bias;          // fp16 [N] or null
+    void* out;                 // [M, N] view of OutType, unit column stride, row stride o_stride (elements)
+    long long o_stride;
+    int M, K, N, group, out_type;
+};
+
+// the configurations built (pfdense.py CFGS mirrors this list; tests/test_dsv41_pfdense.py checks it):
+//   id   BM  WM WN KS NST     warps  warp tile
+#define DSV41_PFD_CFGS(X)  \
+    X(0, 128, 2, 4, 2, 3)  /* 8  64 x 32 */ \
+    X(1, 128, 2, 4, 2, 4)  /* 8  64 x 32, one stage more */ \
+    X(2, 128, 4, 2, 2, 3)  /* 8  32 x 64 */ \
+    X(3, 64, 2, 2, 2, 4)   /* 4  32 x 64 */ \
+    X(4, 64, 1, 4, 2, 4)   /* 4  64 x 32 */ \
+    X(5, 128, 2, 4, 2, 2)  /* 8  64 x 32, two stages (the smallest ring) */ \
+    X(6, 32, 1, 4, 2, 4)   /* 4  32 x 32: narrow layers' row tiles */ \
+    X(7, 256, 4, 2, 2, 3)  /* 8  64 x 64 */
+#define DSV41_PFD_NCFG 8
+
+// (BM, WM, WN, KS, NST) of configuration id, or all zeros
+inline void cfg_of(int id, int (&o)[5]) {
+    for (auto& v : o) v = 0;
+#define DSV41_PFD_CFG_OF(ID, BM, WM, WN, KS, NST) \
+    if (id == ID) { o[0] = BM; o[1] = WM; o[2] = WN; o[3] = KS; o[4] = NST; }
+    DSV41_PFD_CFGS(DSV41_PFD_CFG_OF)
+#undef DSV41_PFD_CFG_OF
+}
+
+// the per-width entry points (pfdense_k<K2>.cu); lanes is built for K2 8, 10, 12
+bool run_k8(const Args&, bool lanes, int cfg, cudaStream_t);
+bool run_k10(const Args&, bool lanes, int cfg, cudaStream_t);
+bool run_k12(const Args&, bool lanes, int cfg, cudaStream_t);
+bool run_k16(const Args&, bool lanes, int cfg, cudaStream_t);
+void describe_k8(bool lanes, int cfg, long long (&o)[8]);
+void describe_k10(bool lanes, int cfg, long long (&o)[8]);
+void describe_k12(bool lanes, int cfg, long long (&o)[8]);
+void describe_k16(bool lanes, int cfg, long long (&o)[8]);
+bool dequant_k8(bool lanes, const uint32_t*, long long, long long, void*, int, int, cudaStream_t);
+bool dequant_k10(bool lanes, const uint32_t*, long long, long long, void*, int, int, cudaStream_t);
+bool dequant_k12(bool lanes, const uint32_t*, long long, long long, void*, int, int, cudaStream_t);
+bool dequant_k16(bool lanes, const uint32_t*, long long, long long, void*, int, int, cudaStream_t);
+
+}  // namespace dsv41_pfd
