+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The FP8 KV record's sizes (``rows``' format), importable without Triton (the torch twin, stores, the serving
+layer's accounting)."""
+
+D = 512
+NOPE = 448
+ROPE = 64
+TILE = 64
+NT = NOPE // TILE          # 7 scale bytes
+VB = NOPE + 2 * ROPE       # 576 value bytes
+SB = 8                     # scale bytes
+ROW_BYTES = VB + SB        # 584
+AMAX_FLOOR = 1e-4
+E4M3_MAX = 448.0
+
+
+# -- index keys (``TF_DSV41_INDEX_KV=fp8``): the kit's per-token FP8 key ---------------------------------------------
+KEY_D = 128
+KEY_FP8_BYTES = KEY_D + 4  # 128 e4m3 + one fp32 power-of-two scale (vLLM ``indexer_k_store``'s per-token FP8 layout)
+
+
+def key_exponent(amax):
+    """The smallest integer e with amax <= 448 * 2^e (amax >= 1e-4, a normal fp32), from the float's bits: torch
+    int32 tensor (``rows.tile_exponent``'s rule)."""
+
+    import torch
+
+    bits = amax.to(torch.float32).contiguous().view(torch.int32)
+    return ((bits >> 23) & 0xFF) - 135 + ((bits & 0x7FFFFF) > 0x600000).to(torch.int32)
+
+
+def key_quant(k):
+    """bf16-valued keys [n, 128] -> uint8 rows [n, 132]: e4m3 of k x 2^-e (nearest even; never saturates), then
+    2^e as fp32 bytes. amax floored at 1e-4 as the kit's store."""
+
+    import torch
+
+    x = k.to(torch.float32)
+    e = key_exponent(x.abs().amax(-1).clamp(min=AMAX_FLOOR))
+    scale = torch.ldexp(torch.ones_like(x[:, 0]), e)
+    q = (x / scale[:, None]).to(torch.float8_e4m3fn).view(torch.uint8)
+    return torch.cat([q, scale.contiguous().view(torch.uint8).view(-1, 4)], 1)
+
+
+def key_dequant(raw):
+    """uint8 rows [n, 132] -> the keys' values [n, 128] fp32 (exactly bf16 values: 4 significant bits, e >= -22)."""
+
+    import torch
+
+    raw = raw.contiguous()
+    q = raw[:, :KEY_D].contiguous().view(torch.float8_e4m3fn).to(torch.float32)
+    scale = raw[:, KEY_D:].contiguous().view(torch.float32)
+    return q * scale
diff --git a/src/tensorfold/families/deepseek_v41/cuda/csa2/index.py b/src/tensorfold/families/deepseek_v41/cuda/csa2/index.py
