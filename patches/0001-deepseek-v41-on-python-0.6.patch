+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""REWRITE-PLAN 5 (``csa2/attn_cuda``, TF_DSV41_ATTN_CUDA) on the CPU, through its numpy emulator
+(``csa2/attn_cuda_emu.py``):
+
+- the cluster radix top-k == index.py's selection bit for bit (int64 keys sorted, and ``index.top_positions`` in
+  torch): dense select, candidate blocks, candidate gathers; ties straddling the cut (whole digits equal: the quota
+  path), +0.0 / -0.0, NaN, +inf, -inf rows, n < k, n == k, short rows, every cluster size 1..8 (the selection
+  does not depend on how a row is split); the launch plan (odd runs, <= 8 CTAs, None past 8 x 512 x 31 entries);
+- the attention emulator (the kernel's decomposition and operation order) == ref.attention (float64) to bf16
+  tolerance: compressed + SWA keys, -1 holes, partial chunks, no compressed rows, bounded replay (lo), DSpark's
+  block ends (hi), paging, row mode (slots), sinks at -inf and finite; a row alone == in a window, exactly;
+- Triton's mma k order for both kWidths; the dispatch (off / CPU tensors / shapes keep the Triton path).
+
+Run: python -m pytest -q tests/test_dsv41_attn_cuda_emu.py
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_cuda as AC  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_cuda_emu as E  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import ref  # noqa: E402
+
+
+def _scores(R: int, n: int, pos, ratio: int, seed: int, ties: str = "mixed") -> np.ndarray:
+    g = np.random.default_rng(seed)
+    s = g.standard_normal((R, n)).astype(np.float32)
+    if ties == "mixed" and n > 400:
+        s[:, 10:60] = 0.0
+        s[:, 61:70] = -0.0
+        s[:, 100:n:7] = 1.5                                       # ~n / 7 equal scores straddling the cut
+        s[:, n // 2] = np.nan
+        s[:, 5] = np.inf
+    elif ties == "flat":
+        s[:] = 0.25                                               # every score equal: the cut by position alone
+    for r in range(R):
+        s[r, (int(pos[r]) + 1) // ratio:] = -np.inf
+    return s
+
+
+@pytest.mark.parametrize("n", [300, 512, 700, 2048, 16384, 40000, 75000])
+@pytest.mark.parametrize("ties", ["mixed", "flat", "none"])
+def test_select_equals_index_keys(n, ties):
+    R, ratio = 3, 4
+    pos = [n * ratio - 1, n * ratio // 2, 40]                    # full, half visible, 10 visible keys
+    s = _scores(R, n, pos, ratio, n + len(ties), ties)
+    got = E.topk(0, s, pos, ratio, 512)
+    want = E.reference_topk(0, s, pos, ratio, 512)
+    assert np.array_equal(got[0], want[0]) and np.array_equal(got[1], want[1])
+
+
+def test_reference_is_index_top_positions():
+    """The numpy reference == index.sort_keys' keys through torch's index.top_positions (the path dtopk equals)."""
+
+    from tensorfold.families.deepseek_v41.cuda.csa2 import index
+
+    R, n, ratio = 2, 5000, 4
+    pos = [n * ratio - 1, 3000]
+    s = _scores(R, n, pos, ratio, 3)
+    b = E.image(s).astype(np.uint32) ^ np.uint32(0x80000000)
+    keys = (b.view(np.int32).astype(np.int64) << 32) + (0x7FFFFFFF - np.arange(n)[None, :])
+    want = index.top_positions(torch.from_numpy(keys), 512).numpy()
+    assert np.array_equal(E.reference_topk(0, s, pos, ratio, 512)[0], want)
+
+
+@pytest.mark.parametrize("n", [3000, 20000, 65536, 75000])
+def test_blocks_and_candidates_equal_reference(n):
+    R = 2
+    pos = [n - 1, n // 3]
+    s = _scores(R, n, pos, 1, n)
+    got, want = E.topk(2, s, pos, 1, 2048), E.reference_topk(2, s, pos, 1, 2048)
+    assert np.array_equal(got[0], want[0])
+    cand = got[0]                                                 # ascending blocks, -1 last
+    s2 = np.random.default_rng(n).standard_normal((R, 2048 * 8)).astype(np.float32)
+    s2[:, 50:3000:5] = 0.25
+    j = cand.astype(np.int64)[:, :, None] * 8 + np.arange(8)
+    s2 = np.where((cand[:, :, None] >= 0).repeat(8, 2).reshape(R, -1) & (j.reshape(R, -1) < np.array(
+        [[(p + 1)] for p in pos])), s2, np.float32(-np.inf)).astype(np.float32)
+    got, want = E.topk(3, s2, pos, 1, 512, cand=cand), E.reference_topk(3, s2, pos, 1, 512, cand=cand)
+    assert np.array_equal(got[0], want[0]) and np.array_equal(got[1], want[1])
+
+
+@pytest.mark.parametrize("cl", [1, 2, 3, 5, 8])
+def test_selection_does_not_depend_on_the_cluster(cl):
+    R, n, ratio = 2, 30000, 4
+    pos = [n * ratio - 1, n * ratio - 9]
+    s = _scores(R, n, pos, ratio, 11)
+    base = E.reference_topk(0, s, pos, ratio, 512)
+    if AC.plan(n, cl) is None:
+        n = 512 * 31 * cl - 7                                     # the most a cluster this size takes
+        pos = [n * ratio - 1, n * ratio - 9]
+        s = _scores(R, n, pos, ratio, 11)
+        base = E.reference_topk(0, s, pos, ratio, 512)
+    got = E.topk(0, s, pos, ratio, 512, cl=cl)
+    assert np.array_equal(got[0], base[0]) and np.array_equal(got[1], base[1])
+
+
+def test_quota_path_and_early_stop_are_exercised():
+    """Equal images straddling the K-th: the 4-pass quota path; a clean cut: the early stop."""
+
+    n = 4000
+    s = np.full((1, n), 0.5, np.float32)
+    s[0, :100] = 2.0
+    tr = []
+    u, p = E.entries(0, s[0], None, n)
+    sel, _ = E.topk_row(u, p, 512, n, *AC.plan(n), trace=tr)
+    assert len(tr) == 4 and sel == list(range(512))               # 100 above + the 412 lowest equal positions
+    s = np.arange(n, dtype=np.float32)[None, ::-1].copy()         # distinct scores
+    tr = []
+    u, p = E.entries(0, s[0], None, n)
+    sel, _ = E.topk_row(u, p, 512, n, *AC.plan(n), trace=tr)
+    assert len(tr) < 4 and sel == list(range(512))
+
+
+def test_plan_limits():
+    for nk in (1, 511, 512, 4096, 4097, 16384, 75000, 126976):
+        cl, ept = AC.plan(nk)
+        assert 1 <= cl <= 8 and ept % 2 == 1 and cl * 512 * ept >= nk
+    assert AC.plan(8 * 512 * 31 + 1) is None
+    assert AC.plan(16384)[0] == 4 and AC.plan(75000) == (8, 19)
+
+
+# ---- attention ------------------------------------------------------------------------------------------------------
+
+def _case(R: int = 3, H: int = 32, n_comp: int = 4000, ring: int = 256, seed: int = 0):
+    g = torch.Generator().manual_seed(seed)
+    q = (torch.randn((R, H, 512), generator=g) * 0.5).to(torch.bfloat16).float()
+    comp = ref.dequantize_rows(*ref.quantize_rows(torch.randn((n_comp, 512), generator=g) * 2)).float()
+    swa = ref.dequantize_rows(*ref.quantize_rows(torch.randn((2 * ring, 512), generator=g) * 2)).float()
+    cs = torch.randn((4096, 64), generator=g)
+    sink = torch.randn((H,), generator=g)
+    sink[3] = float("-inf")
+    return q, comp, swa, cs, sink
+
+
+def _lists(R: int, counts, n_comp: int, seed: int):
+    g = np.random.default_rng(seed)
+    toks = []
+    for r in range(R):
+        t = np.sort(g.choice(n_comp, counts[r], replace=False)).tolist() + [-1] * (512 - counts[r])
+        if counts[r] > 20:
+            t[7] = -1                                             # a hole inside the list
+        toks.append(t)
+    return toks
+
+
+@pytest.mark.parametrize("counts", [[512, 300, 0], [128, 129, 1]])
+def test_attention_emulator_matches_reference(counts):
+    R, ring = 3, 256
+    q, comp, swa, cs, sink = _case(R, ring=ring)
+    toks = _lists(R, counts, comp.shape[0], 1)
+    pos, lo = [1000, 1001, 1002], [0, 0, 950]
+    got = E.attention(q.numpy(), comp.numpy(), toks, counts, swa.numpy(), lo, pos, sink.numpy(), cs.numpy(),
+                      ring=ring)
+    for r in range(R):
+        tk = [t for t in toks[r][:counts[r]] if t >= 0]
+        sw = {p: swa[p % ring] for p in range(max(lo[r], pos[r] - 127, 0), pos[r] + 1)}
+        want = ref.attention(q[r:r + 1], comp, [tk], sw, [lo[r]], [pos[r]], [pos[r]], sink, cs)[0]
+        err = np.abs(got[r] - want.numpy()).max()
+        assert err <= 2e-2 * max(1.0, float(want.abs().max())), (r, err)
+
+
+def test_attention_emulator_swa_only_paged_rows_hi():
+    R, ring = 2, 256
+    q, comp, swa, cs, sink = _case(R, ring=ring, seed=5)
+    pos, lo, hi = [300, 301], [0, 280], [303, 303]
+    got = E.attention(q.numpy(), None, None, None, swa.numpy(), lo, pos, sink.numpy(), cs.numpy(), ring=ring,
+                      hi=hi, slots=[1, 0])
+    for r in range(R):
+        sw = {p: swa[(p % ring) + [1, 0][r] * ring] for p in range(max(lo[r], hi[r] - 127), hi[r] + 1)}
+        want = ref.attention(q[r:r + 1], None, [[]], sw, [lo[r]], [hi[r]], [pos[r]], sink, cs)[0]
+        assert np.abs(got[r] - want.numpy()).max() <= 2e-2 * max(1.0, float(want.abs().max()))
+    perm = np.random.default_rng(0).permutation(comp.shape[0])   # paging: logical row -> physical row
+    phys_comp = np.zeros_like(comp.numpy())
+    phys_comp[perm] = comp.numpy()
+    toks = _lists(R, [400, 200], comp.shape[0], 2)
+    a = E.attention(q.numpy(), comp.numpy(), toks, [400, 200], swa.numpy(), lo, pos, sink.numpy(), cs.numpy(),
+                    ring=ring)
+    b = E.attention(q.numpy(), phys_comp, toks, [400, 200], swa.numpy(), lo, pos, sink.numpy(), cs.numpy(),
+                    ring=ring, phys=lambda r, t: int(perm[t]))
+    assert np.array_equal(a, b)
+
+
+def test_attention_row_alone_equals_window():
+    R, ring = 4, 256
+    q, comp, swa, cs, sink = _case(R, ring=ring, seed=9)
+    counts = [512, 100, 260, 0]
+    toks = _lists(R, counts, comp.shape[0], 3)
+    pos, lo = [700, 701, 702, 703], [0, 0, 650, 0]
+    win = E.attention(q.numpy(), comp.numpy(), toks, counts, swa.numpy(), lo, pos, sink.numpy(), cs.numpy(),
+                      ring=ring)
+    for r in range(R):
+        one = E.attention(q.numpy()[r:r + 1], comp.numpy(), toks[r:r + 1], counts[r:r + 1], swa.numpy(),
+                          lo[r:r + 1], pos[r:r + 1], sink.numpy(), cs.numpy(), ring=ring)
+        assert np.array_equal(one[0], win[r])
+
+
+def test_k_steps_cover_each_k_once():
+    for kw in (2, 4):
+        for nk in (32, 512):
+            steps = E.k_steps(kw, nk)
+            assert len(steps) == nk // 16 and np.array_equal(np.sort(np.concatenate(steps)), np.arange(nk))
+    assert E.k_steps(4, 32)[0].tolist() == [0, 1, 4, 5, 8, 9, 12, 13, 16, 17, 20, 21, 24, 25, 28, 29]
+    assert E.k_steps(2, 32)[0].tolist() == list(range(16))
+
+
+def test_parse_layout():
+    good = ("#mma = #ttg.nvidia_mma<{versionMajor = 2, versionMinor = 0, warpsPerCTA = [1, 8], instrShape = [16, 8]}>"
+            "\n x #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 4}> y #ttg.dot_op<{opIdx = 1, parent = #mma, "
+            "kWidth = 4}>")
+    assert AC.parse_layout(good) == 4
+    assert AC.parse_layout(good.replace("kWidth = 4", "kWidth = 2")) == 2
+    assert AC.parse_layout(good.replace("[1, 8]", "[2, 4]")) is None
+    assert AC.parse_layout(good.replace("versionMajor = 2", "versionMajor = 3")) is None
+    assert AC.parse_layout(good.replace("kWidth = 4}> y", "kWidth = 8}> y")) is None
+
+
+def test_dispatch_keeps_triton(monkeypatch):
+    from tensorfold.families.deepseek_v41.cuda.csa2 import attn
+
+    q = torch.zeros((2, 32, 512), dtype=torch.bfloat16)
+    sw = (torch.zeros((256, 576), dtype=torch.uint8), torch.zeros((256, 8), dtype=torch.uint8))
+    lo = torch.zeros(2, dtype=torch.int32)
+    sc = attn.Scratch(4, "cpu")
+    tk = AC.Ticket(4, 32, "cpu")
+    monkeypatch.delenv("TF_DSV41_ATTN_CUDA", raising=False)
+    assert AC.why_not_attn(q, None, None, None, sw, lo, sc, tk, 256, None, None) == "off"
+    assert AC.select(torch.zeros((1, 10)), torch.zeros(1, dtype=torch.int32), 4, 512) is None
+    monkeypatch.setenv("TF_DSV41_ATTN_CUDA", "1")
+    assert AC.why_not_attn(q, None, None, None, sw, lo, sc, tk, 256, None, None) == "q"     # CPU tensors
+    assert AC.why_not_attn(torch.zeros((5, 32, 512), dtype=torch.bfloat16), None, None, None, sw, lo, sc, tk, 256,
+                           None, None) == "shape"
+    monkeypatch.setenv("TF_DSV41_ATTN_CUDA_PARTS", "topk")
+    assert AC.why_not_attn(q, None, None, None, sw, lo, sc, tk, 256, None, None) == "off"
+    assert AC.select(torch.zeros((1, 10)), torch.zeros(1, dtype=torch.int32), 4, 512) is None     # CPU scores
+    monkeypatch.setenv("TF_DSV41_ATTN_CUDA_PARTS", "bad")
+    with pytest.raises(ValueError):
+        AC.parts()
