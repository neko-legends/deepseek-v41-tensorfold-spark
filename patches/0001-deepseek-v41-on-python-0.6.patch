+"""Host memory of serving traffic (the serving leak of 2026-10-04), on the CPU with the serving tests' fake forward:
+
+- ``hostmem.Trimmer.finished``: when an idle trim runs (every slot free, RssAnon grown, the interval past), when a busy
+  one does (a large growth, a longer interval), and that both can be switched off;
+- both ranks trim at the same plan rounds: the trim follows the plan's finishes and the executor's slots, which rank 1
+  replays (``Batcher.follow``), never its own clock alone;
+- request churn like prod's: every request on a fresh thread (``ThreadingHTTPServer``) that allocates and frees
+  request-sized host buffers (the body, the rendered prompt, the tokenizer's output, id lists: 0.2-8 MB) after a
+  25 MB NumPy buffer was freed (the Engram rows: glibc raises its mmap / trim thresholds). Without the idle trim the
+  freed chunks stay in glibc's arenas; with it RssAnon comes back once the engine goes idle.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import queue
+import random
+import sys
+import threading
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+
+from dsv41_serving_fakes import FakeForward, topo_fixture  # noqa: E402,F401  (fixtures)
+
+from tensorfold.families.deepseek_v41.cuda import hostmem  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Batcher, Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.pool import Pool  # noqa: E402
+
+VOCAB = 4096
+
+
+class Clock:
+    def __init__(self) -> None:
+        self.t = 1000.0
+
+    def __call__(self) -> float:
+        return self.t
+
+
+def test_idle_and_busy_trim_rules():
+    calls: list[bool] = []
+    rss = [1000.0]
+    clk = Clock()
+    lines: list[str] = []
+
+    def trim_fn(full):
+        calls.append(full)
+        got = rss[0] - 1000.0
+        rss[0] = 1000.0
+        return got
+
+    t = hostmem.Trimmer(every=0, trim_fn=trim_fn, rss_fn=lambda: rss[0], clock=clk, idle_s=30, idle_mib=64,
+                        busy_mib=1024, busy_s=300, log=lines.append, background=False)
+    assert t.finished(True) == 0.0 and t.base == 1000.0          # the first finish sets the base
+    rss[0] = 1050.0
+    assert t.finished(True) == 0.0                               # under 64 MiB of growth
+    rss[0] = 1400.0
+    assert t.finished(True) == 400.0 and calls == [False]         # idle, grown: a trim, the base after it
+    assert t.base == 1000.0 and t.kinds == {"idle": 1, "busy": 0} and t.stats["trims"] == 1
+    assert lines and "host trim (idle)" in lines[0] and "GiB back" in lines[0]
+    rss[0] = 1400.0
+    clk.t += 10
+    assert t.finished(True) == 0.0                               # 10 s after the last idle trim
+    clk.t += 25
+    assert t.finished(True) == 400.0                             # 35 s
+    rss[0] = 1900.0
+    clk.t += 100
+    assert t.finished(False) == 0.0                              # busy: 900 MiB is under the busy line
+    rss[0] = 2100.0
+    assert t.finished(False) == 1100.0 and t.kinds == {"idle": 2, "busy": 1}
+    rss[0] = 2200.0
+    clk.t += 100
+    assert t.finished(False) == 0.0                              # busy again 100 s later: too soon
+    clk.t += 250
+    assert t.finished(False) == 1200.0
+    assert len(lines) == 4
+    off = hostmem.Trimmer(every=0, trim_fn=trim_fn, rss_fn=lambda: 10 ** 6, clock=clk, idle_s=0, busy_mib=0,
+                          background=False)
+    assert off.finished(True) == 0.0 and off.finished(False) == 0.0
+    n = len(calls)
+    small = hostmem.Trimmer(every=0, trim_fn=trim_fn, rss_fn=lambda: rss[0], clock=clk, idle_s=30, idle_mib=64,
+                            busy_mib=0, log=lines.append, background=False)
+    rss[0] = 1000.0
+    small.finished(True)
+    rss[0] = 1100.0
+    assert small.finished(True) == 100.0 and len(calls) == n + 1 and len(lines) == 4   # < 256 MiB: no line
+
+
+def test_trimmer_env(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_HOST_TRIM_IDLE_S", "0")
+    monkeypatch.setenv("TF_DSV41_HOST_TRIM_BUSY_MIB", "0")
+    t = hostmem.Trimmer(trim_fn=lambda full: pytest.fail("no trim when both are off"))
+    assert t.finished(True) == 0.0 and t.finished(False) == 0.0
+    monkeypatch.delenv("TF_DSV41_HOST_TRIM_IDLE_S")
+    monkeypatch.delenv("TF_DSV41_HOST_TRIM_BUSY_MIB")
+    t = hostmem.Trimmer()
+    assert (t.idle_s, t.idle_mib, t.busy_mib, t.busy_s, t.background) == (30, 64, 1024, 300, True)
+    monkeypatch.setenv("TF_DSV41_HOST_TRIM_IDLE_S", "-1")
+    with pytest.raises(ValueError):
+        hostmem.Trimmer()
+
+
+class PairLink:
+    def __init__(self) -> None:
+        self.q: queue.Queue = queue.Queue()
+
+    def send(self, plan) -> None:
+        self.q.put(list(plan))
+
+    def recv(self):
+        return self.q.get(timeout=30)
+
+
+def _prompt(seed: int, n: int) -> list[int]:
+    rng = random.Random(seed)
+    return [rng.randrange(2, VOCAB) for _ in range(n)]
+
+
+def test_idle_trims_alike_on_both_ranks(topo, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_STALL_S", "0")
+    link = PairLink()
+    bs = []
+    for rank in (0, 1):
+        pool = Pool(topo, 16384)
+        bs.append(Batcher(FakeForward(topo, pool, 2, VOCAB), pool, n_slots=2, capacity=4096, start=False,
+                          session_min=16, link=link, rank=rank))
+    trims: dict[int, list[int]] = {0: [], 1: []}
+    for rank, b in enumerate(bs):
+        grow = [0.0]
+
+        def rss(grow=grow):                      # every finish sees 100 MiB more: only the rules decide
+            grow[0] += 100.0
+            return 1000.0 + grow[0]
+
+        b.ex.trim = hostmem.Trimmer(every=0, trim_fn=lambda full, b=b, r=rank: trims[r].append(b.ex.rounds) or 0.0,
+                                    rss_fn=rss, clock=lambda: time.monotonic() * 1000, idle_s=1, idle_mib=64,
+                                    busy_mib=10 ** 6, log=lambda msg: None, background=False)
+    th = threading.Thread(target=bs[1].follow, daemon=True)
+    th.start()
+    b0 = bs[0]
+
+    def run(jobs):
+        for j in jobs:
+            b0.submit(j)
+        while b0.step():
+            pass
+
+    run([Job(_prompt(1, 200), 12)])                                   # alone: idle (the first finish: the base)
+    run([Job(_prompt(2, 300), 6), Job(_prompt(3, 120), 30)])           # the first end is busy, the second idle
+    run([Job(_prompt(4, 90), 8)])                                      # idle
+    b0.send_stop()
+    th.join(timeout=30)
+    assert not th.is_alive()
+    assert trims[0] == trims[1] and len(trims[0]) == 2, trims         # the same rounds on both ranks
+    assert bs[0].ex.trim.kinds == bs[1].ex.trim.kinds == {"idle": 2, "busy": 0}
+
+
+def _glibc() -> bool:
+    try:
+        ctypes.CDLL("libc.so.6").malloc_trim
+        return sys.platform.startswith("linux")
+    except (OSError, AttributeError):
+        return False
+
+
+def _request_side(seed: int) -> None:
+    """What one request's HTTP thread allocates and frees on rank 0 (body, rendered prompt, tokenizer output, ids)."""
+
+    rng = random.Random(seed)
+    keep: list = []
+    for _ in range(24):
+        keep.append(bytearray(rng.randrange(200_000, 8_000_000)))
+        if len(keep) > 5:
+            keep.pop(rng.randrange(len(keep)))
+    keep.append(np.zeros(rng.randrange(50_000, 2_000_000), np.int64))
+    del keep
+
+
+@pytest.mark.skipif(not _glibc(), reason="glibc's arenas")
+def test_request_churn_host_memory_bounded(topo, monkeypatch):
+    monkeypatch.setenv("TF_DSV41_STALL_S", "0")
+    ctypes.CDLL(None).prctl(41, 1, 0, 0, 0)     # PR_SET_THP_DISABLE: the Sparks run THP madvise, MIMALLOC_ALLOW_THP=0
+    big = np.ones(25_000_000 // 4, np.float32)  # one Engram row buffer, freed: glibc's dynamic thresholds go up
+    del big
+    pool = Pool(topo, 16384)
+    b = Batcher(FakeForward(topo, pool, 2, VOCAB), pool, n_slots=2, capacity=4096, start=True, session_min=16)
+    b.ex.trim = hostmem.Trimmer(every=0, idle_s=0, busy_mib=0)        # first without the idle trim
+    try:
+        def request(seed: int) -> None:
+            _request_side(seed)
+            out: list[int] = []
+            b.generate(_prompt(seed, 64 + seed % 200), 6, None, lambda new: out.extend(new) or False)
+            assert len(out) == 6
+
+        def wave(w: int, n: int = 16) -> None:
+            ths = [threading.Thread(target=request, args=(w * 100 + i,)) for i in range(n)]
+            for t in ths:
+                t.start()
+            for t in ths:
+                t.join(timeout=120)
+            for _ in range(200):
+                if not b.busy():
+                    break
+                time.sleep(0.01)
+
+        wave(0)
+        b.ex.trim.flush()
+        hostmem.malloc_trim()
+        base = hostmem.rss_anon_mib()
+        for w in range(1, 5):
+            wave(w)
+        held = hostmem.rss_anon_mib() - base      # the freed request buffers glibc keeps (MiB)
+        # every idle finish trims here (the interval and the growth line: test_idle_and_busy_trim_rules), so each
+        # wave ends with the engine's own trim: the last request's finish leaves every slot free
+        trims = hostmem.Trimmer(every=0, idle_s=1e-6, idle_mib=0, busy_mib=0, log=lambda msg: None)
+        b.ex.trim = trims
+        after, left = [], []
+        for w in range(5, 17):
+            wave(w)
+            assert trims.flush(30)                # the background trim of the wave's last finish is done
+            after.append(hostmem.rss_anon_mib() - base)
+            left.append(hostmem.trim())         # what the engine's trim did not give back
+        print(f"request churn: RssAnon +{held:.0f} MiB held without the idle trim; with it, after each wave: "
+              f"{' '.join(f'+{a:.0f}' for a in after)} MiB, a direct trim then finds {max(left):.0f} MiB at most "
+              f"({trims.kinds['idle']} idle trims, {trims.stats['mib']:.0f} MiB back)")
+        assert trims.kinds["idle"] >= len(after)
+        assert max(left) < 16, left                          # the engine's trim gave back all a trim can
+        assert max(after[6:]) - max(after[:6]) < 48, after   # bounded: nothing climbs over the second half
+    finally:
+        b.stop()
+
+
+def test_trims_run_off_the_round_thread():
+    """A slow trim (GB10: madvise of GiBs with SMMU TLB invalidations) never blocks the asking (round) thread; asks
+    coalesce while one runs, a full one wins; a long prompt's full trim waits for the next idle point."""
+
+    started, release = threading.Event(), threading.Event()
+    seen: list[tuple[bool, str]] = []
+
+    def slow(full):
+        seen.append((full, threading.current_thread().name))
+        started.set()
+        release.wait(5)
+        return 0.0
+
+    t = hostmem.Trimmer(every=100, trim_fn=slow, rss_fn=lambda: 1000.0, idle_s=0, busy_mib=0, rank=1,
+                        log=lambda msg: None)
+    t0 = time.monotonic()
+    t.prefilled(150)                            # a trim asked mid-prefill
+    assert started.wait(5)
+    t.prefilled(150)                            # asked again while the first runs: pending
+    t.prefilled(150)                            # coalesced into the pending one
+    t.prompt_done()
+    t.finished(False)                           # busy: the full trim waits
+    assert t.full_pending
+    t.finished(True)                            # idle: the full trim, coalesced with the pending plain one
+    assert time.monotonic() - t0 < 0.5          # the asker never waited for the 5 s trim
+    release.set()
+    assert t.flush(10)
+    assert seen == [(False, "dsv41-trim-r1"), (True, "dsv41-trim-r1")], seen
+    assert t.stats["trims"] == 2 and t.stats["full"] == 1 and not t.full_pending
+
+
+def test_timed_probe_lines(monkeypatch):
+    import io
+
+    buf = io.StringIO()
+    monkeypatch.setenv("TF_DSV41_MEMPROBE_S", "0")
+    assert hostmem.Probe(0).seconds == 0                          # off by default
+    p = hostmem.Probe(1, every=0, out=buf, seconds=0.05)
+    p.extra = lambda: "trims 3 (2 idle, 1 busy), 0.50 GiB back"
+    try:
+        for _ in range(200):
+            if buf.getvalue().count("\n") >= 2:
+                break
+            time.sleep(0.01)
+    finally:
+        p.stop()
+    line = buf.getvalue().splitlines()[0]
+    assert line.startswith("[dsv41 memprobe] r1 timed (round 0)") and "RssAnon" in line and "MemAvailable" in line
+    assert "trims 3 (2 idle, 1 busy)" in line
+    if _glibc() and hostmem.glibc_heap() is not None:
+        assert "glibc in use" in line
+        g = hostmem.glibc_heap()
+        assert g["inuse"] > 0 and g["free"] >= 0
+    assert p.round(10) is None                                    # rounds stay off (every 0)
