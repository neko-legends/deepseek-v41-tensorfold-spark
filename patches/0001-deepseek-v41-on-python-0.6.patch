+
+def _prompts(n):
+    import numpy as np
+
+    return [[int(t) for t in np.random.default_rng(40 + i).integers(3, 250, size=40 + 11 * i)] for i in range(n)]
+
+
+def _samplings(n):
+    from tensorfold.engine.exact_sampling import Sampling
+
+    return [None if i % 2 == 0 else Sampling(seed=5 + i, temperature=0.8, top_k=20, top_p=0.95) for i in range(n)]
