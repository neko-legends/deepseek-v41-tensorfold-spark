+# -- plan link ----------------------------------------------------------------------------------------------------------
+class _Box:
+    """A mailbox stand-in: rank 0's sends land in a queue rank 1's recvs read."""
+
+    def __init__(self, q):
+        self.q = q
+
+    def send(self, data: bytes, timeout_s: float) -> bool:
+        self.q.append(bytes(data))
+        return True
+
+    def recv(self, src, spin_us, nap_us, fd, timeout_s) -> bytes:
+        assert src == 0 and fd >= 0
+        return self.q.pop(0)
+
+
+def _tcp_pair(port: int):
+    out = {}
+    t = threading.Thread(target=lambda: out.__setitem__(0, PL.TcpLink(0, "127.0.0.1", port, timeout_s=10)))
+    t.start()
+    out[1] = PL.TcpLink(1, "127.0.0.1", port, timeout_s=10)
+    t.join()
+    return out[0], out[1]
+
+
+def _free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def test_rdma_link_round_trip():
+    t0, t1 = _tcp_pair(_free_port())
+    q = []
+    r1 = {}
+    th = threading.Thread(target=lambda: r1.__setitem__("l", PL.RoceLink(1, t1, _Box(q), spin_us=1, nap_us=1)))
+    th.start()
+    l0 = PL.RoceLink(0, t0, _Box(q), spin_us=1, nap_us=1)
+    th.join()
+    l1 = r1["l"]
+    plans = [[1, 2, 3], [], list(range(-5000, 5000)), [2**62, -2**62]]
+    for p in plans:
+        l0.send(p)
+    assert [l1.recv() for _ in plans] == plans
+    assert l0.sent == 4 and l1.received == 4
+    l0.close()
+    l1.close()
+
+
+def test_rdma_link_refuses_a_tcp_rank0():
+    t0, t1 = _tcp_pair(_free_port())
+    t0.send([7, 7, 7])                                    # a tcp-mode rank 0's first plan
+    with pytest.raises(RuntimeError, match="not on TF_DSV41_PLAN_LINK=rdma"):
+        PL.RoceLink(1, t1, _Box([]), spin_us=1, nap_us=1)
+    t0.close()
+    t1.close()
+
+
+def test_make_rdma_without_roce_is_tcp(monkeypatch):
+    monkeypatch.setenv(PL.ENV, "rdma")
+    monkeypatch.delenv("TF_DSV41_PLAN_PIN", raising=False)
+    port = _free_port()
+    eng = types.SimpleNamespace(engine=types.SimpleNamespace(comm=object()))      # NCCL: no ``rt``
+    out = {}
+    th = threading.Thread(target=lambda: out.__setitem__(0, PL.make(eng, 0, "127.0.0.1", port - 7)))
+    th.start()
+    l1 = PL.make(eng, 1, "127.0.0.1", port - 7)
+    th.join()
+    assert isinstance(out[0], PL.TcpLink) and isinstance(l1, PL.TcpLink)
+    out[0].send([5, 6])
+    assert l1.recv() == [5, 6]
+    out[0].close()
+    l1.close()
+    with pytest.raises(ValueError):
+        monkeypatch.setenv(PL.ENV, "udp")
+        PL.mode()
+
