@@ -0,0 +1,324 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``attn_cuda.cu`` / ``topk_cuda.cu`` in numpy, step for step (tests/test_dsv41_attn_cuda_emu.py; the GPU suite
+compares it with the kernels).
+
+- ``topk``: the cluster radix select exactly as the kernel runs it (CL CTAs a row, each with its slice of images;
+  per-pass histograms summed over the cluster, the same digit choice and early stop, (above, equal) counts, quotas
+  and offsets by rank, compaction in scan order). Integer logic only: bit for bit, so it is checked against
+  ``reference_topk`` (index.py's int64 keys, sorted) on the CPU.
+- ``attention``: the kernel's decomposition (chunks, tiles, masks, paging, SWA window, the merge's chunk order, the
+  sink, the inverse RoPE) and its operation order, with two documented models: an mma.sync step is
+  fp32(C + the exact sum of its 16 products) (the tensor core's internal alignment differs in the last bits), and
+  ex2.approx / div.full are fp32 of the exact value (both within 2 ulp on the GPU). So it matches the GPU to fp32
+  rounding noise, and ``ref.attention`` (float64) to bf16 tolerance.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+L2E = np.float32(np.frombuffer(np.uint32(0x3FB8AA3B).tobytes(), np.float32)[0])
+SCALE = np.float32(np.frombuffer(np.uint32(0x3D3504F3).tobytes(), np.float32)[0])
+NT = 512
+
+
+# ---- top-k ---------------------------------------------------------------------------------------------------------
+
+def image(s: np.ndarray) -> np.ndarray:
+    """index.py's score order as uint32 (0 never occurs for a real score: it marks a missing entry)."""
+
+    s = np.asarray(s, np.float32)
+    b = s.view(np.int32).copy()
+    b[s == 0] = 0
+    b[np.isnan(s)] = 0x7FC00000
+    neg = b < 0
+    b[neg] ^= 0x7FFFFFFF
+    return b.view(np.uint32) ^ np.uint32(0x80000000)
+
+
+def entries(mode: int, s_row: np.ndarray, cand_row, nvis: int, bs: int = 8):
+    """A row's (images [nk] uint32, 0 = missing; positions [nk] int64) in scan order."""
+
+    s_row = np.asarray(s_row, np.float32)
+    if mode == 2:
+        nb = -(-s_row.shape[0] // bs)
+        j = np.arange(nb)[:, None] * bs + np.arange(bs)[None, :]
+        v = np.where(j < nvis, s_row[np.minimum(j, s_row.shape[0] - 1)], np.float32(-np.inf)).astype(np.float32)
+        with np.errstate(invalid="ignore"):
+            m = np.fmax.reduce(v, axis=1)                        # maxnumf: NaN only when every member is NaN
+        b = np.arange(nb)
+        m = np.where(b == (nvis - 1) // bs if nvis > 0 else False, np.float32(np.inf), m).astype(np.float32)
+        u = np.where(b * bs < nvis, image(m), np.uint32(0))
+        return u.astype(np.uint32), b.astype(np.int64)
+    u = image(s_row)
+    i = np.arange(s_row.shape[0])
+    if mode == 3:
+        cb = np.asarray(cand_row, np.int64)[i // bs]
+        p = np.where(cb >= 0, cb * bs + i % bs, -1)
+        u = np.where(p >= 0, u, np.uint32(0)).astype(np.uint32)
+        return u, p
+    return u, i.astype(np.int64)
+
+
+def plan(nk: int, cl: int | None = None):
+    from .attn_cuda import plan as P
+
+    return P(nk, cl)
+
+
+def topk_row(u: np.ndarray, p: np.ndarray, k: int, nvis: int, cl: int, ept: int, trace: list | None = None):
+    """One cluster: (positions selected, ascending; visible count)."""
+
+    sl = NT * ept
+    sl_u = []
+    for q in range(cl):                                          # CTA q's images (0 past the row's entries)
+        seg = u[q * sl:(q + 1) * sl]
+        sl_u.append(np.concatenate([seg, np.zeros(sl - seg.shape[0], np.uint32)]).astype(np.uint32))
+    prefix, pmask, above, quota_mode = 0, 0, 0, False
+    for ps in range(4):
+        shift = 24 - 8 * ps
+        tot = np.zeros(256, np.int64)
+        for q in range(cl):                                      # each CTA's histogram, summed over the cluster
+            v = sl_u[q]
+            m = (v != 0) & ((v & np.uint32(pmask)) == np.uint32(prefix))
+            tot += np.bincount(((v[m] >> np.uint32(shift)) & np.uint32(255)).astype(np.int64), minlength=256)
+        ge = np.cumsum(tot[::-1])[::-1]
+        if ps == 0 and ge[0] <= k:
+            if trace is not None:
+                trace.append(("all", int(ge[0])))
+            break
+        dg = int(np.nonzero(above + ge >= k)[0].max())
+        hd = int(tot[dg])
+        above += int(ge[dg]) - hd
+        prefix |= dg << shift
+        pmask |= 255 << shift
+        if trace is not None:
+            trace.append((ps, dg, above, hd))
+        if above + hd == k:
+            break
+        if ps == 3:
+            quota_mode = True
+    gts, eqs = [], []
+    for q in range(cl):
+        v = sl_u[q]
+        mv = v & np.uint32(pmask)
+        ok = v != 0
+        gts.append(int((ok & (mv > np.uint32(prefix))).sum()))
+        eqs.append(int((ok & (mv == np.uint32(prefix))).sum()))
+    need, eq_before, out = k - above, 0, []
+    for q in range(cl):                                          # quotas and scan-order compaction
+        quota = max(0, min(eqs[q], need - eq_before)) if quota_mode else eqs[q]
+        eq_before += eqs[q]
+        v = sl_u[q]
+        mv = v & np.uint32(pmask)
+        ok = v != 0
+        eq = ok & (mv == np.uint32(prefix))
+        er = np.cumsum(eq) - 1
+        sel = (ok & (mv > np.uint32(prefix))) | (eq & (er < quota))
+        out += list(q * sl + np.nonzero(sel)[0])
+    pos = [int(p[e]) for e in out]
+    return pos, sum(1 for x in pos if x < nvis)
+
+
+def topk(mode: int, s: np.ndarray, pos_rows, ratio: int, k: int, *, cand=None, block: int = 8, cl=None):
+    """(out int32 [R, k] ascending, -1 padded; visible counts int32 [R]) as the kernel computes them."""
+
+    s = np.asarray(s, np.float32)
+    R = s.shape[0]
+    nk = -(-s.shape[1] // block) if mode == 2 else s.shape[1]
+    c, ept = plan(nk, cl)
+    out = np.full((R, k), -1, np.int32)
+    cnt = np.zeros(R, np.int32)
+    for r in range(R):
+        nvis = (int(pos_rows[r]) + 1) // ratio
+        u, p = entries(mode, s[r], None if cand is None else cand[r], nvis, block)
+        sel, vis = topk_row(u, p, k, nvis, c, ept)
+        out[r, :len(sel)] = sel
+        cnt[r] = vis
+    return out, cnt
+
+
+def reference_topk(mode: int, s: np.ndarray, pos_rows, ratio: int, k: int, *, cand=None, block: int = 8):
+    """index.sort_keys + index.top_positions (and _block_keys / candidate_keys), with numpy int64 keys."""
+
+    s = np.asarray(s, np.float32)
+    R = s.shape[0]
+    out = np.full((R, k), -1, np.int32)
+    cnt = np.zeros(R, np.int32)
+    for r in range(R):
+        nvis = (int(pos_rows[r]) + 1) // ratio
+        u, p = entries(mode, s[r], None if cand is None else cand[r], nvis, block)
+        valid = u != 0
+        b = (u ^ np.uint32(0x80000000)).view(np.int32).astype(np.int64)
+        key = (b << 32) + (0x7FFFFFFF - np.maximum(p, 0))                     # index._keys (unique per row)
+        idx = np.nonzero(valid)[0]
+        top = idx[np.argsort(-key[idx], kind="stable")[:k]]
+        sel = np.sort(p[top])
+        out[r, :len(sel)] = sel
+        cnt[r] = int((sel < nvis).sum())
+    return out, cnt
+
+
+# ---- attention -----------------------------------------------------------------------------------------------------
+
+def bf16(x) -> np.ndarray:
+    """fp32 -> bf16 (round to nearest even) -> fp32."""
+
+    b = np.asarray(x, np.float32).view(np.uint32).astype(np.uint64)
+    r = ((b + 0x7FFF + ((b >> 16) & 1)) >> 16) << 16
+    out = r.astype(np.uint32).view(np.float32)
+    return np.where(np.isnan(x), np.float32(np.nan), out)
+
+
+def f32(x) -> np.ndarray:
+    return np.asarray(x, np.float64).astype(np.float32)
+
+
+def ex2(x) -> np.ndarray:
+    return f32(np.exp2(np.asarray(x, np.float64)))
+
+
+def texp(x) -> np.ndarray:
+    return ex2(f32(np.asarray(x, np.float32).astype(np.float64) * np.float64(L2E)))
+
+
+def k_steps(kw: int, nk: int) -> list[np.ndarray]:
+    """Triton's mma k order: the k indices of each m16n8k16 step over ``nk`` (a multiple of 32)."""
+
+    steps = []
+    for s in range(nk // 16):
+        ks = []
+        for t in range(4):
+            lo = 32 * (s >> 1) + 4 * t + 2 * (s & 1) if kw == 4 else 16 * s + 2 * t
+            hi = lo + (16 if kw == 4 else 8)
+            ks += [lo, lo + 1, hi, hi + 1]
+        steps.append(np.array(sorted(ks)))
+    return steps
+
+
+def _mma_chain(acc: np.ndarray, a: np.ndarray, b: np.ndarray, steps) -> np.ndarray:
+    """acc [M, N] fp32; a [M, K], b [K, N] (bf16 values): one fp32 rounding per step (the model)."""
+
+    for ks in steps:
+        acc = f32(acc.astype(np.float64) + a[:, ks].astype(np.float64) @ b[ks, :].astype(np.float64))
+    return acc
+
+
+def chunk(q: np.ndarray, kv: np.ndarray, valid: np.ndarray, kw: int = 4):
+    """One CTA: q [16, 512] (bf16 values), kv [128, 512] (bf16 values, masked rows 0), valid [128] ->
+    (o [16, 512], m [16], l [16]) fp32."""
+
+    steps = k_steps(kw, 512)
+    psteps = k_steps(kw, 32)
+    M = q.shape[0]
+    m = np.full(M, -np.inf, np.float32)
+    l = np.zeros(M, np.float32)
+    o = np.zeros((M, 512), np.float32)
+    for t in range(4):
+        kt = kv[32 * t:32 * t + 32]
+        ok = valid[32 * t:32 * t + 32]
+        s = _mma_chain(np.zeros((M, 32), np.float32), q, kt.T, steps)
+        s = np.where(ok[None, :], f32(s.astype(np.float64) * np.float64(SCALE)), np.float32(-np.inf))
+        tm = s.max(1)
+        act = tm != -np.inf
+        nm = np.where(act, np.maximum(m, tm), m).astype(np.float32)
+        with np.errstate(invalid="ignore"):
+            al = np.where(act, np.where(m == -np.inf, np.float32(0), texp(f32(m - nm))), np.float32(1))
+            p = np.where(ok[None, :] & act[:, None], texp(f32(s - nm[:, None])), np.float32(0)).astype(np.float32)
+        a = f32(p[:, 0::2].astype(np.float64) + p[:, 1::2])                       # [M, 16]: thread pairs
+        a = a.reshape(M, 4, 4)                                                    # [M, n8, t]
+        w = f32(f32(a[:, :, 0] + a[:, :, 2]).astype(np.float64) + f32(a[:, :, 1] + a[:, :, 3]))
+        tot = f32(f32(w[:, 0] + w[:, 2]).astype(np.float64) + f32(w[:, 1] + w[:, 3]))
+        l = f32(l.astype(np.float64) * al + tot)
+        o = f32(o.astype(np.float64) * al[:, None])
+        o = _mma_chain(o, bf16(p), kt, psteps)
+        m = nm
+    return o, m, l
+
+
+def merge(parts: list, sink: np.ndarray, cs_row: np.ndarray) -> np.ndarray:
+    """Chunks [(o [H, 512], m [H], l [H])] in order -> bf16 values [H, 512] (sink, 1 / l, inverse RoPE)."""
+
+    H = sink.shape[0]
+    m = np.full(H, -np.inf, np.float32)
+    l = np.zeros(H, np.float32)
+    o = np.zeros((H, 512), np.float32)
+    with np.errstate(invalid="ignore"):
+        for c, (co, cm, cl) in enumerate(parts):
+            act = cl > 0
+            if c == 0:
+                nm = np.where(act, cm, np.float32(-np.inf)).astype(np.float32)
+                b = np.where(act, texp(f32(cm - nm)), np.float32(0))
+                o = f32(b[:, None].astype(np.float64) * co)
+                l = f32(b.astype(np.float64) * cl)
+            else:
+                nm = np.where(act, np.maximum(m, cm), m).astype(np.float32)
+                a = np.where(act, np.where(m == -np.inf, np.float32(0), texp(f32(m - nm))), np.float32(1))
+                b = np.where(act, texp(f32(cm - nm)), np.float32(0))
+                o = f32(o.astype(np.float64) * a[:, None] + f32(co.astype(np.float64) * b[:, None]))
+                l = f32(l.astype(np.float64) * a + f32(b.astype(np.float64) * cl))
+            m = nm
+        top = np.maximum(m, sink)
+        af = np.where(m == -np.inf, np.float32(0), texp(f32(m - top)))
+        e = np.where(sink == -np.inf, np.float32(0), texp(f32(sink - top)))
+    den = f32(l.astype(np.float64) * af + e)
+    x = f32(f32(o.astype(np.float64) * af[:, None]).astype(np.float64) / den[:, None])
+    ev, od = x[:, 0::2].copy(), x[:, 1::2].copy()
+    c = np.ones(256, np.float32)
+    s = np.zeros(256, np.float32)
+    c[224:], s[224:] = cs_row[:32], cs_row[32:64]
+    ne = f32(ev.astype(np.float64) * c + f32(od.astype(np.float64) * s))
+    no = f32(od.astype(np.float64) * c - f32(ev.astype(np.float64) * s))
+    out = np.empty_like(x)
+    out[:, 0::2], out[:, 1::2] = ne, no
+    return bf16(out)
+
+
+def attention(q: np.ndarray, comp, tokens, counts, swa, lo, pos, sink, cs, *, ring: int, hi=None, phys=None,
+              slots=None, kw: int = 4) -> np.ndarray:
+    """The kernel's output (bf16 values as fp32) [R, H, 512]: q [R, H, 512] bf16 values; comp: dequantized rows
+    [n, 512] (or None); tokens [R, <= 512] logical compressed rows (-1 pad), counts [R]; swa: the ring(s) rows
+    [rows, 512]; lo / pos / hi [R] ints; ``phys(r, tok)`` the page table (default identity); ``slots`` [R] (row
+    mode: ring row = slot * ring + p % ring)."""
+
+    R, H, _ = q.shape
+    out = np.zeros((R, H, 512), np.float32)
+    for r in range(R):
+        cnt = int(counts[r]) if comp is not None else 0
+        h_end = int(hi[r]) if hi is not None else int(pos[r])
+        lo_r = max(int(lo[r]), h_end - 127)
+        for hb in range(H // 16):
+            parts = []
+            for c in range(5):
+                if c < 4 and not c * 128 < cnt:
+                    parts.append((np.zeros((16, 512), np.float32), np.full(16, -np.inf, np.float32),
+                                  np.zeros(16, np.float32)))
+                    continue
+                kv = np.zeros((128, 512), np.float32)
+                valid = np.zeros(128, bool)
+                for i in range(128):
+                    if c < 4:
+                        idx = c * 128 + i
+                        if idx < cnt and tokens[r][idx] >= 0:
+                            row = int(tokens[r][idx])
+                            kv[i] = comp[phys(r, row) if phys else row]
+                            valid[i] = True
+                    else:
+                        p = h_end - 127 + i
+                        if p >= lo_r and p >= 0:
+                            kv[i] = swa[p % ring + (int(slots[r]) * ring if slots is not None else 0)]
+                            valid[i] = True
+                parts.append(chunk(q[r, 16 * hb:16 * hb + 16], kv, valid, kw))
+            out[r, 16 * hb:16 * hb + 16] = merge(parts, np.asarray(sink[16 * hb:16 * hb + 16], np.float32),
+                                                 np.asarray(cs[int(pos[r])], np.float32))
+    return out
+
+
+def work(R: int, H: int = 32, comp_keys: int = 512) -> dict:
+    """The launch's shape and bytes (the cost model's inputs): CTAs, rows staged, bytes a CTA, merge bytes."""
+
+    chunks = (min(comp_keys, 512) + 127) // 128 + 1
+    return {"ctas": chunks * (H // 16) * R, "grid": (5, H // 16, R), "rows_a_cta": 128,
+            "bytes_a_cta": 128 * 584 + 16 * 512 * 2, "merge_bytes": chunks * 16 * 512 * 4,
+            "partial_bytes": chunks * (H // 16) * R * 16 * 514 * 4}
