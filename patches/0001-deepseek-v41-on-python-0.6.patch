index 0000000..c43d7ae
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/blocks.py
@@ -0,0 +1,431 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""One rank's layers at run time: the stored tree (``weights.RankW``) turned into kernels' objects, and the
+sublayers a block runs (CSA2 attention by role, the MoE partial, Engram), on the GPU or on the CPU twin.
+
+Per block L (vLLM ``deepseek_v4_1/nvidia/model.py``, Apache-2.0, the math reference; engine/reference/model.py):
+
+    if L has Engram:  streams = engram(streams)
+    post, comb, x, pre_a = hc_pre(streams, hc_attn, pre_in = the previous block's FFN pre-mix, attn_norm)
+    streams = hc_post(attention_L(x), streams, post, comb)
+    post, comb, x, pre_f = hc_pre(streams, hc_ffn, pre_in = pre_a, ffn_norm)
+    streams = hc_post(moe_L(x), streams, post, comb)
+
+Attention (docs/ARCHITECTURE.md section 3): ``qr = bf16(rms(wq_a x) q_norm)``, ``kv = bf16(rms(wkv x) kv_norm)``,
+``q = bf16(rope(wq_b qr))`` (no per-head norm in V4.1); the layer's SWA row = rope(kv) into its ring; a kv source (``full``)
+pools its compressor rows (ratio 2 with the carry of the previous window's last row), stores the compressed row and
+its index key; an index source scores and selects (layer 20 also picks the candidate blocks; reindex layers score
+only those); every compressed layer attends to its kv source's rows through the latest selection; the output's
+grouped ``wo_a`` (this rank's groups) and ``wo_b`` (this rank's rows) give a partial sum the caller exchanges.
+
+Norms and RoPE run in float64 / fp32 elementwise torch (row-invariant on any device); every matrix through
+``linear``; the kernels through ``csa2.backend`` and ``moe``. The mHC boundaries between the sublayers and the
+Engram fusion are the forward's (``seams``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import torch
+
+from . import linear as LN
+from . import moe as MO
+from . import numerics as N
+from . import seams
+from .config import Config
+from .csa2.backend import Win, visible_counts
+from .weights import X3, LayerW
+
+F32, F64, BF16 = torch.float32, torch.float64, torch.bfloat16
+
+
+def rms(x: torch.Tensor, weight: torch.Tensor | None, eps: float, dtype: torch.dtype | None = None) -> torch.Tensor:
+    """RMSNorm over the last dim in float64 (exact squares of bf16 values), the result rounded to ``dtype``
+    (default: the activations' dtype). On CUDA one Triton launch (``rmsnorm``, G7; ``TF_DSV41_RMS_TRITON=0``: torch)."""
+
+    if x.is_cuda:
+        from . import rmsnorm as RN
+
+        if RN.eligible(x, weight, dtype or N.ACT):
+            return RN.rms(x, weight, eps, dtype or N.ACT)
+    x = x.to(F64)
+    y = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + eps)
+    return (y if weight is None else y * weight.to(F64)).to(dtype or N.ACT)
+
+
+def rms2(xa: torch.Tensor, wa: torch.Tensor, xb: torch.Tensor, wb: torch.Tensor, eps: float):
+    """``(rms(xa, wa, eps), rms(xb, wb, eps))``; on CUDA one launch for both (``rmsnorm.rms_pair``, G9
+    ``TF_DSV41_RMS_PAIR``): the same bits."""
+
+    if xa.is_cuda and xa.shape[:-1] == xb.shape[:-1] and wa is not None and wb is not None:
+        from . import rmsnorm as RN
+
+        if RN.pair_enabled() and RN.eligible(xa, wa, N.ACT) and RN.eligible(xb, wb, N.ACT) and \
+                wa.dtype == wb.dtype and xa.dtype == xb.dtype:
+            return RN.rms_pair(xa, wa, xb, wb, eps, N.ACT)
+    return rms(xa, wa, eps), rms(xb, wb, eps)
+
+
+def materialize(x: X3, device):
+    """A stored EXL3 matrix as the device runs it: upstream's Exl3Linear on CUDA, the float64 twin elsewhere."""
+
+    if torch.device(device).type == "cuda":
+        return LN.exl3_from(x.trellis, x.suh, x.svh, x.codebook, device)
+    return LN.dense_from(x.trellis, x.suh, x.svh, x.codebook)
+
+
+@dataclass
+class Attn:
+    wq_a: object
+    wkv: object
+    wq_b: object
+    wo_a: list
+    wo_b: object
+    q_norm: torch.Tensor
+    kv_norm: torch.Tensor
+    sink: torch.Tensor
+    comp_wkv: object = None
+    comp_wgate: object = None
+    comp_norm: torch.Tensor | None = None
+    ix_wq_b: object = None
+    ix_wp: object = None
+    ix_wk: object = None
+    ix_knorm: torch.Tensor | None = None
+
+
+class Block:
+    """Layer L of one rank: weights in run-time form, plus what the window needs to know about the layer."""
+
+    def __init__(self, cfg: Config, lw: LayerW, device, world: int) -> None:
+        self.cfg, self.index, self.world = cfg, lw.index, world
+        self.mode = cfg.attention_mode(lw.index)
+        self.ratio = cfg.compress_ratio(lw.index)
+        self.kv_source = cfg.kv_source(lw.index)
+        self.attn_norm, self.ffn_norm = lw.attn_norm, lw.ffn_norm
+        from . import mhc_dec as MD
+
+        self.hc_attn, self.hc_ffn = MD.prepare(lw.hc_attn), MD.prepare(lw.hc_ffn)     # TF_DSV41_MHC_FN
+        a = lw.attn
+        from . import prefill_mm as PM
+
+        wrap = PM.wrap if PM.mode() == "fast" else (lambda lin: lin)       # fast prefill runs: prefill GEMMs
+        mk = (lambda x: None if x is None else wrap(materialize(x, device)))
+        self.attn = Attn(mk(a.wq_a), mk(a.wkv), mk(a.wq_b), [mk(w) for w in a.wo_a], mk(a.wo_b), a.q_norm,
+                         a.kv_norm, a.sink, mk(a.comp_wkv), mk(a.comp_wgate), a.comp_norm, mk(a.ix_wq_b),
+                         None if a.ix_wp is None else LN.Plain(a.ix_wp), mk(a.ix_wk), a.ix_knorm)
+        from . import fused_proj as FP
+
+        self.fused = None
+        if torch.device(device).type == "cuda":
+            FP.apply_plan(self.attn, FP.plan_spec())        # TF_DSV41_PROJ_PLAN: every path sums alike
+            self.fused = FP.build(self.attn)                # TF_DSV41_FUSED_PROJ
+        from . import branches as BR
+
+        self.branch = BR.build(self, device)                # TF_DSV41_BRANCHES (off: None)
+        self.moe = self._moe(lw, device)
+        self.engram = None
+        if lw.engram is not None:
+            self.engram = (mk(lw.engram.wkv), lw.engram.qk)
+        lw.attn = lw.moe = lw.engram = None                 # the stored matrices are not needed any more
+
+    def _moe(self, lw: LayerW, device):
+        cfg, m = self.cfg, lw.moe
+        _, topk = cfg.experts_of(lw.index)
+        if torch.device(device).type == "cuda":
+            block = gpu_experts(cfg, m, lw.index, self.world, device)
+            moe = MO.GpuMoE(m.gate, m.bias, block, topk, cfg.routed_scaling_factor, cfg.swiglu_limit)
+        else:
+            experts = [MO.TwinExpert(materialize(m.w1.item(e), device), materialize(m.w2.item(e), device),
+                                     materialize(m.w3.item(e), device)) for e in range(m.w1.count)]
+            experts += [MO.TwinExpert(*(materialize(x, device) for x in s)) for s in m.shared]
+            moe = MO.TwinMoE(m.gate, m.bias, experts, topk, cfg.routed_scaling_factor, cfg.swiglu_limit)
+        moe.bias_vl = getattr(m, "bias_vl", None)          # image rows' routing bias (``vision.moe``), or None
+        return moe
+
+
+def gpu_experts(cfg: Config, m, layer: int, world: int, device):
+    """A rank's MoE block on upstream's grouped EXL3 kernels: the routed stacks' experts (views, no copy), then the
+    shared expert as table entry E (``experts.py``)."""
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    from . import experts as X
+
+    def triples(st, extra):
+        return [(st.trellis[e], st.suh[e], st.svh[e]) for e in range(st.count)] + \
+            [(t.trellis, t.suh, t.svh) for t in extra]
+
+    gate = triples(m.w1, [s[0] for s in m.shared])
+    up = triples(m.w3, [s[2] for s in m.shared])
+    down = triples(m.w2, [s[1] for s in m.shared])
+    _, topk = cfg.experts_of(layer)
+    widths = [int(t.shape[1]) * 16 for t, _, _ in gate]
+    geom = X.Geometry(dims=cfg.hidden_size, inter=cfg.moe_intermediate_size, experts=m.w1.count,
+                      topk=topk, shared=len(m.shared), world=world, local=max(widths))
+    if len(set(widths)) > 1:                            # TF_DSV41_EXPERT_ROTATE: one width an expert
+        return X.Experts(X.prepare_ragged(gate, up, down, m.w1.codebook, device=device), geom, keep=[m])
+    return X.Experts(x3.prepare(gate, up, down, m.w1.codebook, device=device), geom, keep=[m])
+
+
+class Context:
+    """One segment of a window (one slot's consecutive rows ``[a, b)`` of the window's rows) and what it carries
+    between layers: positions, tables, the latest selection and candidates, the ratio-2 projection rows (the carry a
+    commit keeps)."""
+
+    def __init__(self, win: Win, tables: dict, csa2, ring: int, slot, a: int = 0, stage=None) -> None:
+        self.win, self.tables, self.csa2, self.ring, self.slot = win, tables, csa2, ring, slot
+        self.a, self.b = a, a + win.n
+        self.stage = stage              # (store, rows) of the prefill staging ring when the slot's ring is too short
+        self.comp_done = False          # CED's decoder replay: the kv sources' rows were stored by the encoder pass
+        self.sel = None                 # (selection int32 [n, topk], counts int32 [n]) of the latest index source
+        self.cand = None                # layer 20's candidate blocks for these rows
+        self.proj: dict = {}            # ratio-2 kv source -> its [kv | score] projection rows [n, 2 D]
+        self.split = None               # ``Forward.RowSplit`` (TF_DSV41_INDEX_SPLIT): a prefill segment's selections
+        # computed for a quarter of the rows a rank and gathered (rows are independent: the same selections)
+        self.prior = None               # the segment just before these rows when its ``keep`` has not run yet (an
+        # overlapped prefill's first half, ``Forward._run_overlap``): its last projection row is the ratio-2 carry
+        self.lo = torch.zeros((win.n,), dtype=torch.int32, device=win.positions.device)
+
+
+def attention(blk: Block, x: torch.Tensor, ctxs: list[Context], out_dtype: torch.dtype | None = None,
+              emit=None) -> torch.Tensor | None:
+    """This rank's partial attention output fp32 [n, D] (its heads, its ``wo_a`` groups, its ``wo_b`` rows) for the
+    window's rows: the projections over every row at once, the CSA2 steps a segment (its slot's ring, rows, keys).
+    ``out_dtype`` bf16 (G9, a decode window's exchange): ``wo_b`` rounds its fp32 sums to bf16 as it stores them,
+    the bits of ``.to(bf16)`` after it without the cast launch. ``emit`` (G16 ``TF_DSV41_PF_XOVL``, a fast prefill
+    run): ``wo_b`` runs over ``emit.spans_of(n)``'s row ranges and hands each one's partial to ``emit.send(a, b,
+    part)`` as soon as it is stored (rows are independent in the GEMM: the same bits); returns None then."""
+
+    from . import branches as BR
+
+    br = BR.active(blk, x, ctxs)            # TF_DSV41_BRANCHES: the indexer / compressor on a side stream
+    if br is not None:
+        return BR.attention(blk, x, ctxs, out_dtype, br)
+    cfg, A = blk.cfg, blk.attn
+    eps, n = cfg.rms_norm_eps, x.shape[0]
+    act, acc = N.ACT, N.ACC
+    tables = ctxs[0].tables
+    table = tables[1 if blk.ratio > 0 else 0]
+    positions = torch.cat([c.win.positions for c in ctxs]) if len(ctxs) > 1 else ctxs[0].win.positions
+    from . import fused_proj as FP
+
+    fz = FP.active(blk)                     # one launch a shared input (x, qr, wo_a's groups), the same bits
+    comp = blk.mode == "full" and not ctxs[0].comp_done
+    ix = blk.mode in ("full", "reindex")
+    proj = qi = w = None
+    if fz is not None and (fz.x4 is not None or not comp):
+        qa, kva, proj = fz.x(x, comp)
+    else:
+        qa, kva = A.wq_a(x, act), A.wkv(x, act)
+        proj = _projection(blk, x) if comp else None
+    qr, kv = rms2(qa, A.q_norm, kva, A.kv_norm, eps)
+    if fz is not None and ix and fz.q is not None:
+        q, qi = fz.qproj(qr)
+    else:
+        q = A.wq_b(qr, act)
+        qi = A.ix_wq_b(qr, act) if ix else None
+    from . import l2pf
+
+    l2pf.mark(blk, "o", n)                  # G10 TF_DSV41_L2PF: wo_a / wo_b into L2 during the attention core
+    q = q.view(n, -1, cfg.head_dim)
+    # no per-head RMS of q in V4.1: vLLM's deepseek_v4_1 attention calls the fused q-norm / RoPE / KV insert with
+    # apply_q_norm=False (qr is normed before wq_b); V4.0 had it on. G2 found it: with the norm, top-1 vs the kit 92%
+    from .rope import inplace as rope_inplace
+
+    inplace = rope_inplace()                # G7 (TF_DSV41_ROPE_INPLACE): the same bits without the fp32 copy
+    q = table.apply_(q, positions, dtype=act) if inplace else table.apply(q.to(acc), positions, dtype=act)
+    if ix:
+        qi = qi.view(n, cfg.index_n_heads, cfg.index_head_dim)
+        qi = table.apply_(qi, positions, dtype=act) if inplace else table.apply(qi, positions, dtype=act)
+        w = A.ix_wp(x, act).to(acc)
+    from . import prefill_mm as PM
+
+    if fz is None and len(ctxs) == 1 and PM.active() and PM.copies():
+        # G16 TF_DSV41_PF_COPIES: the core's output as is (no copy into ``o``), group-major when the fused prefill
+        # attention runs (each wo_a group a contiguous slice), the wo_a groups' GEMMs writing z in place
+        o = _segment(blk, ctxs[0], table, q, kv, proj, qi, w, groups=len(A.wo_a))
+        return _out_pf(blk, o, n, out_dtype, emit)
+    o = torch.empty((n, q.shape[1], cfg.head_dim), dtype=act, device=x.device)
+    for c in ctxs:
+        o[c.a:c.b] = _segment(blk, c, table, q[c.a:c.b], kv[c.a:c.b], None if proj is None else proj[c.a:c.b],
+                              None if qi is None else qi[c.a:c.b], None if w is None else w[c.a:c.b])
+    return _out(blk, fz, o, n, out_dtype, emit)
+
+
+def _wo_b(blk: Block, z: torch.Tensor, out_dtype, emit) -> torch.Tensor | None:
+    """``wo_b`` over z's rows, or (G16 ``emit``) over its row ranges, each range's partial sent as soon as stored."""
+
+    A = blk.attn
+    if emit is None:
+        return A.wo_b(z, out_dtype or N.ACC)
+    for a, b in emit.spans_of(z.shape[0]):
+        emit.send(a, b, A.wo_b(z[a:b], out_dtype or N.ACC))
+    return None
+
+
+def _out_pf(blk: Block, o: torch.Tensor, n: int, out_dtype, emit=None) -> torch.Tensor | None:
+    """``_out`` for a fast prefill run under ``TF_DSV41_PF_COPIES`` (G16): ``o`` is the core's output, [n, heads,
+    head_dim] or group-major [groups, n, heads / groups x head_dim] (``csa2`` ``attention_grouped``); each group's
+    ``wo_a`` GEMM writes its columns of ``z`` (``FastLinear(out=)``), then ``wo_b``. The same GEMMs on the same
+    inputs as ``_out``: the same bits."""
+
+    A, act = blk.attn, N.ACT
+    gl = len(A.wo_a)
+    grouped = bool(getattr(o, "dsv41_grouped", False))
+    na = A.wo_a[0].n
+    z = torch.empty((n, gl * na), dtype=act, device=o.device)
+    og = None if grouped else o.reshape(n, gl, -1)
+    for g in range(gl):
+        A.wo_a[g](o[g] if grouped else og[:, g].contiguous(), act, out=z[:, g * na:(g + 1) * na])
+    return _wo_b(blk, z, out_dtype, emit)
+
+
+def _out(blk: Block, fz, o: torch.Tensor, n: int, out_dtype, emit=None) -> torch.Tensor | None:
+    """The attention output o [n, heads, head_dim] through wo_a's groups and wo_b."""
+
+    A, act = blk.attn, N.ACT
+    if fz is not None and fz.o is not None:
+        z = fz.oproj(o.view(n, -1))
+    else:
+        gl = len(A.wo_a)
+        og = o.reshape(n, gl, -1)
+        z = torch.cat([A.wo_a[g](og[:, g].contiguous(), act) for g in range(gl)], 1)
+    return _wo_b(blk, z, out_dtype, emit)
+
+
+def _projection(blk: Block, x: torch.Tensor) -> torch.Tensor:
+    """A kv source's compressor projection fp32 [n, D] (ratio 2: [kv | score] [n, 2 D])."""
+
+    A, act = blk.attn, N.ACT
+    proj = A.comp_wkv(x, act).to(N.ACC)
+    if blk.ratio == 2:
+        proj = torch.cat([proj, A.comp_wgate(x, act).to(N.ACC)], 1)
+    return proj
+
+
+def compress_rows(blk: Block, x: torch.Tensor, ctxs: list[Context]) -> None:
+    """A kv source's compressor alone over the window's rows: its compressed rows and index keys stored (CED's
+    encoder pass ends with the decoder's first layer's projection of H_19: ENGINE-PLAN section 8)."""
+
+    if blk.mode != "full":
+        raise ValueError(f"layer {blk.index} is not a kv source")
+    proj = _projection(blk, x)
+    table = ctxs[0].tables[1]
+    for c in ctxs:
+        _compress(blk, c, table, proj[c.a:c.b])
+
+
+def _compress(blk: Block, ctx: Context, table, proj: torch.Tensor) -> None:
+    cfg, A, win, cs, slot, L = blk.cfg, blk.attn, ctx.win, ctx.csa2, ctx.slot, blk.index
+    r = blk.ratio
+    if r == 2:
+        if win.rows:            # row mode: [every slot's carry | the rows]; ``win.prev`` names each row's pair
+            buf = torch.cat([slot.carry[L], proj], 0)
+        else:
+            buf = torch.cat([carry_of(ctx, L).view(1, -1), proj], 0)    # the carry: position start - 1
+        ctx.proj[L] = proj
+    else:
+        buf = proj
+    lat = cs.pool_norm(buf.contiguous(), A.comp_norm, win, r, cfg.rms_norm_eps)
+    cs.kv_store(lat, table, slot.comp[L], win, r)
+    cs.index_k(A.ix_wk(lat, N.ACT), A.ix_knorm, table, slot.ikeys[L], win, r, cfg.rms_norm_eps)
+
+
+def carry_of(ctx: Context, L: int) -> torch.Tensor:
+    """Layer L's ratio-2 carry for a segment: the slot's (``keep`` stored it), or the last projection row of the
+    segment just before (``Context.prior``), in the carry's dtype (what ``keep`` would store)."""
+
+    c = ctx.slot.carry[L]
+    if ctx.prior is None:
+        return c
+    return ctx.prior.proj[L][-1].to(c.dtype)
+
+
+def stage_rows(dst, dst_ring: int, src, src_ring: int, lo: int, hi: int) -> None:
+    """The SWA rows of positions [lo, hi) from one ring into another (stored bytes, device indices)."""
+
+    if hi <= lo:
+        return
+    dev = (dst.values if hasattr(dst, "values") else dst.data).device
+    p = torch.arange(lo, hi, dtype=torch.long, device=dev)
+    dst.copy_rows(p % dst_ring, src, p % src_ring)
+
+
+def _segment(blk: Block, ctx: Context, table, q, kv, proj, qi, w, groups: int = 0) -> torch.Tensor:
+    cfg, win, slot, L = blk.cfg, ctx.win, ctx.slot, blk.index
+    swa, ring = slot.swa[L], ctx.ring
+    if ctx.stage is not None:       # a prefill segment longer than the slot's ring: the staging ring, same bytes
+        swa, ring = ctx.stage
+        stage_rows(swa, ring, slot.swa[L], ctx.ring, max(0, win.p0 - cfg.sliding_window + 1), win.p0)
+    out = _segment_rows(blk, ctx, table, q, kv, proj, qi, w, swa, ring, groups)
+    if ctx.stage is not None:       # the slot's ring gets the segment's last window of rows back
+        stage_rows(slot.swa[L], ctx.ring, swa, ring, max(0, win.p0 + win.n - cfg.sliding_window), win.p0 + win.n)
+    return out
+
+
+def _segment_rows(blk: Block, ctx: Context, table, q, kv, proj, qi, w, swa, ring: int,
+                  groups: int = 0) -> torch.Tensor:
+    cs = ctx.csa2
+    cs.kv_store(kv, table, swa, ctx.win, 0, ring)
+    if blk.mode == "full" and proj is not None:
+        _compress(blk, ctx, table, proj)
+    if blk.mode in ("full", "reindex"):
+        _select(blk, ctx, qi, w)
+    return _attend(blk, ctx, table, q, swa, ring, groups)
+
+
+def _select(blk: Block, ctx: Context, qi, w) -> None:
+    """An index layer's selection of the segment's rows into ``ctx.sel`` (layer 20: its candidates, ``ctx.cand``)."""
+
+    cfg, win, cs, slot, L = blk.cfg, ctx.win, ctx.csa2, ctx.slot, blk.index
+    keys = slot.ikeys[blk.kv_source]
+    if blk.mode == "reindex" and cfg.uses_candidates(L) and ctx.cand is not None:
+        sel = cs.reindex(qi, w, keys, win, ctx.cand, blk.ratio, cfg.index_topk, cfg.candidate_block_size)
+    else:
+        if cfg.is_candidate_source(L):
+            sel, ctx.cand = cs.select_cand(qi, w, keys, win, blk.ratio, cfg.index_topk,
+                                           cfg.candidate_block_size, cfg.candidate_topk_blocks)
+        elif ctx.split is not None and ctx.split.takes(win):
+            sel = ctx.split.select(lambda a, b: cs.select(qi[a:b], w[a:b], keys, win.sub(a, b), blk.ratio,
+                                                         cfg.index_topk)[0], win.n)
+        else:
+            sel, _ = cs.select(qi, w, keys, win, blk.ratio, cfg.index_topk)
+    ctx.sel = (sel, visible_counts(sel, win, blk.ratio))
+
+
+def _attend(blk: Block, ctx: Context, table, q, swa, ring: int, groups: int = 0) -> torch.Tensor:
+    """The attention core of the segment's rows over its SWA ring and (compressed layers) the latest selection.
+    ``groups`` (G16): the backend's group-major fused prefill output when it has one (tagged ``dsv41_grouped``)."""
+
+    comp = sel = counts = None
+    if blk.ratio > 0:
+        comp = ctx.slot.comp[blk.kv_source]
+        sel, counts = ctx.sel
+    grouped = getattr(ctx.csa2, "attention_grouped", None) if groups else None
+    if grouped is not None:
+        o = grouped(q.contiguous(), comp, sel, counts, swa, ctx.lo, ctx.win, blk.attn.sink, table, ring, groups)
+        if o is not None:
+            o.dsv41_grouped = True
+            return o
+    return ctx.csa2.attention(q.contiguous(), comp, sel, counts, swa, ctx.lo, ctx.win, blk.attn.sink, table, ring)
+
+
+def engram_rows(blk: Block, hashes: torch.Tensor, rows_src, rank: int, world: int, layout) -> torch.Tensor:
+    """This rank's hash heads' rows of the window, bf16 [n, heads x 256] (rank order = head order)."""
+
+    li = blk.cfg.engram_layer_ids.index(blk.index)
+    _, _, h0, nh = layout.head_shard(li, rank, world)
+    idx = hashes[:, li, h0:h0 + nh]
+    n = idx.shape[0]
+    return rows_src.rows(idx.reshape(-1)).to(N.ACT).view(n, -1)
+
+
+def engram(blk: Block, x: torch.Tensor, rows_all: torch.Tensor, keep=None) -> torch.Tensor:
+    """Engram into the streams x [n, 4 D] (in place): ``wkv`` over the gathered rows, then the gated fusion."""
+
+    cfg = blk.cfg
+    wkv, qk = blk.engram
+    pc = getattr(rows_all, "dsv41_pcache", None)          # gated rows: ``engram_pcache`` (same bits, maybe no matmul)
+    kv = pc[0].project(pc[1], rows_all, N.ACT) if pc is not None else wkv(rows_all.to(x.device), N.ACT)
+    return seams.engram_fuse(x, kv, qk, keep, eps=cfg.rms_norm_eps, clamp=cfg.engram_gate_clamp)
