+def test_rollback_keeps_only_committed_rows(ck):
+    """A window of drafts, one kept: the drafter's rings and next drafts == a forward that stepped serially."""
+
+    p = SHORT[0]
+    serial = _serial_short(ck, [p], n=4)[0]
+    a, z = DF.forward(ck), DF.forward(ck)
+    for f in (a, z):
+        DF.batcher(ck, f).ex.slots[0].ensure(200)
+        f.reset(0)
+        f.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    P = len(p) - 1
+    a.window([Rows(0, P, (p[-1], serial[0], 99, 98))], count=1)
+    a.commit(0, 1)                                                  # pending + serial[0] kept; 99, 98 rolled back
+    for i, t in enumerate([p[-1], serial[0]]):
+        z.window([Rows(0, P + i, (t,))], count=1)
+        z.commit(0, 0)
+    assert a.slots[0].pos == z.slots[0].pos == P + 2
+    rows = torch.arange(max(0, P + 2 - 128), P + 2) % a.drafter.ring
+    for ra, rz in zip(a.drafter.rings[0], z.drafter.rings[0]):
+        x, y = ra.raw(rows), rz.raw(rows)
+        assert all(np.array_equal(x[k], y[k]) for k in x)
+    da = a.drafter.propose([0], [serial[1]], [P + 2])
+    dz = z.drafter.propose([0], [serial[1]], [P + 2])
+    assert da == dz
+    ca = a.window([Rows(0, P + 2, (serial[1],))], count=5)
+    cz = z.window([Rows(0, P + 2, (serial[1],))], count=5)
+    assert np.array_equal(ca.ids, cz.ids) and np.array_equal(ca.values, cz.values)
+
