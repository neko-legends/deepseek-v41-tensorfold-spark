+@pytest.mark.parametrize("mode", ["gemv", "fused", "split"])
+def test_router_keep_logits(mode):
+    from tensorfold.families.deepseek_v41.cuda import router
+
+    g = torch.Generator(device=DEV).manual_seed(3)
+    x = torch.randn((5, 5120), generator=g, device=DEV).to(torch.bfloat16)
+    w = (torch.randn((384, 5120), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    b = torch.rand(384, generator=g, device=DEV) * 0.1
+    p0, w0 = router.route(x, w, b, mode=mode)
+    keep = torch.empty((5, 384), dtype=torch.float32, device=DEV)
+    p1, w1 = router.route(x, w, b, mode=mode, keep=keep)
+    assert torch.equal(p0, p1) and torch.equal(w0, w1)
+    assert torch.equal(keep, router.logits(x, w, mode=mode))
+
