+@pytest.mark.parametrize("R", [1, 4, 16])
+def test_finish_fin2_bits(monkeypatch, R):
+    case = _case(R, seed=90 + R)
+    got = {}
+    for v in ("0", "1"):
+        _with(monkeypatch, TF_DSV41_MHC_FIN2=v)
+        o = _Out(R, tap=False)
+        _boundary(case, o)
+        got[v] = o.all(R)
+    _same(got["0"], got["1"], f"finish norm first R={R}")
+    for w in ("1", "2", "8"):           # another layout: the coefficients within fp32 rounding, the rest the same
+        _with(monkeypatch, TF_DSV41_MHC_FIN_WARPS=w)
+        o = _Out(R, tap=False)
+        _boundary(case, o)
+        a = o.all(R)
+        for k in ("pre", "post", "comb"):
+            torch.testing.assert_close(a[k], got["1"][k], rtol=1e-5, atol=1e-6)
+        _same({k: a[k] for k in ("x", "out", "c", "part")}, {k: got["1"][k] for k in ("x", "out", "c", "part")},
+              f"finish warps {w}")
+        same = all(torch.equal(_bits(a[k]), _bits(got["1"][k])) for k in ("pre", "post", "comb"))
+        print(f"[G9G] finish warps {w} R={R}: coefficients {'bit for bit' if same else 'differ (fp32 rounding)'}")
+    monkeypatch.delenv("TF_DSV41_MHC_FIN_WARPS")
