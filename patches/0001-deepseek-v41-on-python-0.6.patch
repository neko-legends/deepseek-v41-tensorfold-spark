@@ -0,0 +1,432 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Fail fast on both ranks: a failure inside one rank's round ends the pair in about a second, not minutes.
+
+Why (G16, 2026-10-04): an exception raised on ONE rank inside a round desyncs the TP=2 pair. The first G16 soak's
+``KeyError: 5`` (``vision.Store.gather``, inside rank 0's prefill forward) and d5ceil's ``torch.OutOfMemoryError``
+(rank 0, a 299K prefill at ``TF_DSV41_ALLOC_CEIL_GIB=1.0``) both went the same way: rank 0 left the round, rank 1
+waited in the forward's exchange (RoCE: ``GLM53_TF_ROCE_TIMEOUT_S`` = 120 s; NCCL, which carries every prefill
+exchange over 256 KiB: forever), rank 0's next plan then waited ``TF_DSV41_PLAN_TIMEOUT`` (300 s) for rank 1's
+mailbox credits, and the watchdog needed 3 bad ticks to heal. Every in-flight request was lost either way.
+
+Design: **fail-stop the pair**, not recovery. Once a rank leaves a forward between two exchanges, its peer is inside
+an exchange that only the same calls on this rank could complete: NCCL has no timeout or abort here (ctypes, no
+``ncclCommAbort``), the RoCE runtime poisons itself for good on a timeout, and the forward's device state (graphs,
+the Engram gate, the prefetcher, a half-written pool page) after a partial round is unknown. A process restart is
+the one state both ranks can agree on, so the rank that fails, and the rank whose peer failed, each:
+
+1. poison their RoCE runtime from the host (``roce.Runtime.abort``: the failure word, and the peer flags of the
+   newest sequence written so a spinning wait returns now: pending and later exchanges end at once with
+   ``RoceError``, no marker file);
+2. fail every in-flight and queued request (rank 0): ``RuntimeError`` -> HTTP 500 with the reason ("rank 1 failed
+   in prefill: OutOfMemoryError ...; both ranks are restarting"); a request arriving afterwards gets a 503
+   (``CapacityError``: retry shortly);
+3. tell the peer over the **fate channel** (below), wait ``TF_DSV41_FAILFAST_GRACE_S`` (1.0 s: the HTTP threads write
+   their 500s; the RoCE flags keep being released) and exit with code **70** (``os._exit``: no atexit, no NCCL
+   destructor that could hang), the code ``stall.py``'s exit already uses: ``serve.sh watch`` sees a rank gone.
+
+What is NOT fatal (rank 0 only, nothing shared or the peer already done): an exception while planning (before the
+plan is sent; the round's requests fail, their slots are finished in the next plan as before) or while sampling a
+slot's candidates after the round (that slot's request alone fails, its slot is finished in the next plan: rank 1
+never learns a sample, so both ranks stay identical). Per-request failures the executor already isolates on both
+ranks (grammar, a damaged NVMe entry) stay per-request. Everything raised inside ``rounds.Executor.run`` (rank 0's
+"execute", any of rank 1's) and a failed plan send / receive is fatal. An OOM inside a prefill is fatal for the
+same reason as any other mid-forward error; the per-request answer to it is not to admit what does not fit:
+``memory.Floor`` prices a prompt's prefill transient against the tighter rank before admission (``batch.py``).
+
+The fate channel is the plan link's own TCP connection (``planlink``: under ``tcp`` it carries the plans rank 0 ->
+rank 1; under ``rdma`` only the handshake, then rank 1 polls it for liveness). Its rank 1 -> rank 0 direction was
+unused, so it now carries small frames (``<IIq``: magic, kind, value): ``MEM`` (rank 1's usable memory in bytes,
+every ``TF_DSV41_PEER_MEM_S`` = 0.5 s, from rank 1's fate thread: nothing on either round thread, no collective, no
+GPU) and ``FAIL`` (rank 1's reason, then it closes). Rank 0's fate thread reads them; end of stream without a
+``FAIL`` = rank 1 is gone (killed, crashed: the kernel closes the socket). Rank 0 -> rank 1 carries no new bytes:
+rank 0 failing shuts the socket down and rank 1's fate thread sees the hang-up (``poll`` for POLLRDHUP / POLLHUP,
+which consumes no plan bytes, so the follower's reads are untouched). Under ``TF_DSV41_PLAN_LINK=nccl`` (no TCP) the
+engine opens one TCP connection for the channel alone (``TF_DSV41_FATE_PORT``, default the rendezvous port + 8).
+Exchanges with the RoCE mailbox's credits were considered and not used: they live in C++ (``roce_msg.h``), a payload
+there changes the latency-critical path, and they flow only while plans do (an idle rank 0 would see no report).
+
+Four ranks (TP=4): rank 0 holds one fate channel per follower (the plan link's connection to each, in rank order).
+A follower's ``FAIL`` or hang-up ends rank 0, whose hang-up then ends every other follower: the whole world goes
+down together, as the pair did. Rank 0's floor reads the tightest follower (``peer_mem``: the smallest last report,
+the oldest of their ages; None until every follower has reported).
+
+Knobs: ``TF_DSV41_FAILFAST`` (1; 0: the old behaviour: rank 0 fails the round's requests and carries on, rank 1's
+exception leaves ``follow``), ``TF_DSV41_FAILFAST_GRACE_S`` (1.0), ``TF_DSV41_PEER_MEM_S`` (0.5),
+``TF_DSV41_FATE_PORT``, and the test hook ``TF_DSV41_FAILFAST_INJECT=rank:round:phase[:kind]`` (raise once on that
+rank in the first round >= ``round`` at ``phase``: plan | commit | admit | prefill | saves | finals | window | sample;
+kind ``error`` (default), ``oom`` (``torch.OutOfMemoryError``), ``key`` (``KeyError``)) for the GPU test plan.
+Log lines: ``[tensorfold] dsv41 fail-fast: ...``.
+"""
+
+from __future__ import annotations
+
+import os
+import select
+import socket
+import struct
+import sys
+import threading
+import time
+import traceback
+from collections.abc import Callable
+
+ENV = "TF_DSV41_FAILFAST"
+EXIT_CODE = 70
+MAGIC = 0x46463431                      # "14FF"
+MEM, FAIL = 1, 2
+_FRAME = struct.Struct("<IIq")
+PHASES = ("plan", "commit", "admit", "prefill", "saves", "finals", "window", "sample")
+
+
+def enabled(raw: str | None = None) -> bool:
+    v = (os.environ.get(ENV, "1") if raw is None else raw).strip().lower() or "1"
+    if v not in ("0", "1", "on", "off"):
+        raise ValueError(f"{ENV}={v!r}: expected 1 or 0")
+    return v in ("1", "on")
+
+
+def _f(name: str, default: float, lo: float, hi: float) -> float:
+    raw = os.environ.get(name, "").strip()
+    v = float(raw) if raw else default
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def _log(msg: str, out=None) -> None:
+    print(f"[tensorfold] dsv41 fail-fast: {msg}", file=out or sys.stderr, flush=True)
+
+
+# -- the test hook ----------------------------------------------------------------------------------------------------
+class Injected(RuntimeError):
+    """``TF_DSV41_FAILFAST_INJECT``'s error."""
+
+
+class Inject:
+    """Raise once on this rank in the first round >= ``round`` at ``phase`` (``TF_DSV41_FAILFAST_INJECT``)."""
+
+    def __init__(self, rank: int, round_no: int, phase: str, kind: str = "error") -> None:
+        if phase not in PHASES or kind not in ("error", "oom", "key"):
+            raise ValueError(f"TF_DSV41_FAILFAST_INJECT: phase {phase!r} (one of {', '.join(PHASES)}), kind {kind!r} "
+                             "(error | oom | key)")
+        self.rank, self.round, self.phase, self.kind = int(rank), int(round_no), phase, kind
+        self.fired = False
+
+    @classmethod
+    def from_env(cls, rank: int, raw: str | None = None) -> Inject | None:
+        v = (os.environ.get("TF_DSV41_FAILFAST_INJECT", "") if raw is None else raw).strip()
+        if not v:
+            return None
+        parts = v.split(":")
+        if len(parts) not in (3, 4):
+            raise ValueError(f"TF_DSV41_FAILFAST_INJECT={v!r}: expected rank:round:phase[:kind]")
+        inj = cls(int(parts[0]), int(parts[1]), parts[2], parts[3] if len(parts) == 4 else "error")
+        if inj.rank != int(rank):
+            return None
+        _log(f"rank {rank}: TF_DSV41_FAILFAST_INJECT armed ({inj.kind} at {inj.phase}, round >= {inj.round})")
+        return inj
+
+    def __call__(self, round_no: int, phase: str) -> None:
+        if self.fired or phase != self.phase or int(round_no) < self.round:
+            return
+        self.fired = True
+        what = f"TF_DSV41_FAILFAST_INJECT: rank {self.rank} round {round_no} phase {phase}"
+        if self.kind == "oom":
+            import torch
+
+            cls = getattr(torch, "OutOfMemoryError", None) or getattr(torch.cuda, "OutOfMemoryError", MemoryError)
+            raise cls(f"CUDA out of memory ({what})")
+        if self.kind == "key":
+            raise KeyError(what)
+        raise Injected(what)
+
+
+# -- the channel ------------------------------------------------------------------------------------------------------
+def conn_of(link) -> socket.socket | None:
+    """The TCP socket behind a plan link (``planlink.TcpLink`` / ``RoceLink``, under ``Pinned``), or None (nccl)."""
+
+    conns = conns_of(link)
+    return conns[0] if conns else None
+
+
+def conns_of(link) -> list[socket.socket]:
+    """Every TCP socket behind a plan link: rank 0's one a follower (rank order), a follower's one to rank 0."""
+
+    for _ in range(4):
+        many = getattr(link, "conns", None)
+        if isinstance(many, (list, tuple)) and many and all(isinstance(c, socket.socket) for c in many):
+            return list(many)
+        conn = getattr(link, "conn", None)
+        if isinstance(conn, socket.socket):
+            return [conn]
+        inner = getattr(link, "tcp", None) or getattr(link, "link", None)
+        if inner is None:
+            return []
+        link = inner
+    return []
+
+
+class Channel:
+    """The fate channel over one stream socket: rank 1 writes ``MEM`` / ``FAIL`` frames, rank 0 reads them; either
+    side's hang-up is the other's signal."""
+
+    def __init__(self, rank: int, conn: socket.socket, peer: int | None = None) -> None:
+        self.rank, self.conn = int(rank), conn
+        self.peer = (0 if self.rank else 1) if peer is None else int(peer)       # the rank at the other end
+        self.lock = threading.Lock()
+        self.sent = 0
+
+    def report(self, usable: int) -> bool:
+        """Rank 1: one MEM frame, never blocking (a full buffer drops it: the next one comes in 0.5 s)."""
+
+        try:
+            with self.lock:
+                self.conn.send(_FRAME.pack(MAGIC, MEM, int(usable)), socket.MSG_DONTWAIT)
+            self.sent += 1
+            return True
+        except (BlockingIOError, InterruptedError):
+            return False
+        except OSError:
+            return False
+
+    def fail(self, msg: str) -> None:
+        """Rank 1: the reason (best effort, at most ~1 s), then the hang-up."""
+
+        data = msg.encode("utf-8", "replace")[:4000]
+        try:
+            with self.lock:
+                self.conn.settimeout(1.0)
+                self.conn.sendall(_FRAME.pack(MAGIC, FAIL, len(data)) + data)
+        except OSError:
+            pass
+        self.hangup()
+
+    def hangup(self) -> None:
+        try:
+            self.conn.shutdown(socket.SHUT_RDWR)
+        except OSError:
+            pass
+
+    def _exact(self, n: int) -> bytes | None:
+        buf = b""
+        while len(buf) < n:
+            try:
+                got = self.conn.recv(n - len(buf))
+            except OSError:
+                return None
+            if not got:
+                return None
+            buf += got
+        return buf
+
+    def read(self) -> tuple[int, int, str] | None:
+        """Rank 0: the next frame (kind, value, text), or None at the end of the stream (rank 1 gone)."""
+
+        head = self._exact(_FRAME.size)
+        if head is None:
+            return None
+        magic, kind, value = _FRAME.unpack(head)
+        if magic != MAGIC:
+            return FAIL, 0, f"rank {self.peer} sent a frame that is not the fate channel's (magic {magic:#x})"
+        text = ""
+        if kind == FAIL and value > 0:
+            body = self._exact(min(int(value), 4000))
+            text = body.decode("utf-8", "replace") if body is not None else ""
+        return kind, int(value), text
+
+    def hung_up(self, timeout_s: float) -> bool:
+        """Rank 1: True when rank 0 shut the socket down or it failed (poll; no plan byte is consumed)."""
+
+        p = select.poll()
+        try:
+            p.register(self.conn.fileno(), getattr(select, "POLLRDHUP", 0x2000) | select.POLLHUP | select.POLLERR)
+            return bool(p.poll(max(0, int(timeout_s * 1000))))
+        except (OSError, ValueError):           # closed here (a stop): the caller decides
+            return True
+
+
+def local_usable() -> int:
+    """This rank's usable memory in bytes, ``memory.Floor``'s measure (``memsafe.view``: MemFree + the allocator's
+    unused cache + the reclaimable page cache)."""
+
+    from tensorfold.families.glm5_next.spark import memsafe
+
+    from . import memory
+
+    mi = memsafe.read_meminfo()
+    return int(memsafe.view(mi.get("MemFree", 0), memory.allocator_cached(), "available", mi).usable)
+
+
+# -- the pair's fate --------------------------------------------------------------------------------------------------
+class Fate:
+    """One rank's side: ``fatal`` (this rank failed), the fate thread (the peer failed or left), ``peer_mem`` (rank 0:
+    rank 1's last report). ``on_fail``: callbacks given the reason (rank 0's batcher fails its requests)."""
+
+    def __init__(self, rank: int, chan: Channel | list[Channel] | None, *, rt=None, exit_fn: Callable[[int], None] | None = None,
+                 grace_s: float | None = None, report_s: float | None = None,
+                 usable: Callable[[], int] | None = None, out=None) -> None:
+        self.rank, self.rt = int(rank), rt
+        self.chans: list[Channel] = [] if chan is None else (list(chan) if isinstance(chan, (list, tuple)) else [chan])
+        self.chan = self.chans[0] if self.chans else None
+        self.exit_fn = exit_fn or os._exit
+        self.grace_s = _f("TF_DSV41_FAILFAST_GRACE_S", 1.0, 0.0, 60.0) if grace_s is None else float(grace_s)
+        self.report_s = _f("TF_DSV41_PEER_MEM_S", 0.5, 0.01, 60.0) if report_s is None else float(report_s)
+        self.usable = usable or local_usable
+        self.out = out
+        self.on_fail: list[Callable[[str], None]] = []
+        self.dead: str | None = None             # the reason, once the pair is going down
+        self.code: int | None = None             # the exit code asked for (tests: exit_fn returns)
+        self.peers: dict[int, tuple[int, float]] = {}  # follower -> (usable bytes, monotonic time of its report)
+        self.reports = 0
+        self.closing = False                     # a normal stop: the peer's hang-up is not a failure
+        self.done = threading.Event()            # set once ``_die`` asked for the exit
+        self._lock = threading.Lock()
+        self._threads: list[threading.Thread] = []
+
+    @property
+    def peer(self) -> tuple[int, float] | None:
+        """The tightest follower's (usable bytes, monotonic time), once every follower has reported."""
+
+        if not self.chans or len(self.peers) < len(self.chans):
+            return None
+        vals = list(self.peers.values())
+        return min(v[0] for v in vals), min(v[1] for v in vals)
+
+    def tightest(self) -> int | None:
+        """The follower with the smallest last report (None before every follower has reported)."""
+
+        if not self.chans or len(self.peers) < len(self.chans):
+            return None
+        return min(self.peers, key=lambda r: self.peers[r][0])
+
+    def start(self) -> Fate:
+        if self.chans and not self._threads:
+            for chan in self.chans:
+                if self.rank == 0:
+                    t = threading.Thread(target=self._watch0, args=(chan,), daemon=True,
+                                         name=f"dsv41-fate-r0-{chan.peer}")
+                else:
+                    t = threading.Thread(target=self._watch1, args=(chan,), daemon=True, name=f"dsv41-fate-r{self.rank}")
+                t.start()
+                self._threads.append(t)
+        return self
+
+    def peer_mem(self) -> tuple[int, float] | None:
+        """(the tightest follower's usable bytes, seconds since the oldest report), or None before every follower
+        has reported."""
+
+        p = self.peer
+        return None if p is None else (p[0], time.monotonic() - p[1], self.tightest())
+
+    # -- failures ------------------------------------------------------------------------------------------------
+    def fatal(self, exc: BaseException, where: str) -> None:
+        """This rank failed inside a round (``where``: its phase): the pair goes down (see the module doc)."""
+
+        if self.dead is None:
+            traceback.print_exception(type(exc), exc, exc.__traceback__, file=self.out or sys.stderr)
+        self._die(f"rank {self.rank} failed in {where}: {type(exc).__name__}: {exc}", own=True)
+
+    def peer_failed(self, reason: str) -> None:
+        self._die(reason, own=False)
+
+    def close(self) -> None:
+        """A normal stop (rank 0's stop plan / rank 1 received it): the hang-up that follows is expected."""
+
+        self.closing = True
+
+    def _die(self, reason: str, *, own: bool) -> None:
+        with self._lock:
+            first = self.dead is None
+            if first:
+                self.dead = reason
+        if not first:
+            self.done.wait(self.grace_s + 5.0)  # the first caller exits the process; a second one waits for it
+            return
+        _log(f"rank {self.rank}: {reason}; failing every request, exiting ({EXIT_CODE}) in {self.grace_s:g} s so the "
+             f"pair restarts", self.out)
+        hold = None
+        if self.rt is not None:                 # pending and later RoCE exchanges end now (a RoceError each)
+            try:
+                self.rt.abort(reason)
+                hold = threading.Thread(target=self.rt.abort, args=(reason, self.grace_s), daemon=True,
+                                        name="dsv41-fate-roce")
+                hold.start()
+            except Exception as exc:            # noqa: BLE001  exiting matters more
+                _log(f"rank {self.rank}: RoCE abort failed: {exc!r}", self.out)
+        for cb in list(self.on_fail):
+            try:
+                cb(f"{reason}; both ranks are restarting")
+            except Exception as exc:            # noqa: BLE001
+                _log(f"rank {self.rank}: failing the requests raised {exc!r}", self.out)
+        for chan in self.chans:
+            if self.rank != 0 and own:
+                chan.fail(reason)
+            else:
+                chan.hangup()
+        if self.grace_s > 0:
+            time.sleep(self.grace_s)
+        self.code = EXIT_CODE
+        self.done.set()
+        self.exit_fn(EXIT_CODE)
+
+    # -- the fate threads ----------------------------------------------------------------------------------------
+    def _watch0(self, chan: Channel | None = None) -> None:
+        chan = chan or self.chan
+        while self.dead is None:
+            got = chan.read()
+            if got is None:
+                if self.closing or self.dead is not None:
+                    return
+                self.peer_failed(f"rank {chan.peer} closed the fate channel (the process exited or was killed)")
+                return
+            kind, value, text = got
+            if kind == MEM:
+                self.peers[chan.peer] = (value, time.monotonic())
+                self.reports += 1
+            elif kind == FAIL:
+                self.peer_failed(text or f"rank {chan.peer} failed")
+                return
+
+    def _watch1(self, chan: Channel | None = None) -> None:
+        chan = chan or self.chan
+        while self.dead is None:
+            if chan.hung_up(self.report_s):
+                if self.closing or self.dead is not None:
+                    return
+                self.peer_failed("rank 0 closed the fate channel (it failed, exited or was killed)")
+                return
+            try:
+                chan.report(self.usable())
+            except Exception:                   # noqa: BLE001  a report must never end the rank
+                pass
+
+
+def attach(batch, link, *, rank: int, master: str, port: int, rt=None, out=None, world: int = 2) -> Fate | None:
+    """The engine's wiring (``engine._serve``): a ``Fate`` on the plan link's socket (or a TCP connection of its own
+    under ``TF_DSV41_PLAN_LINK=nccl``), started, given to the batcher; rank 0's floor reads rank 1's reports.
+    None with ``TF_DSV41_FAILFAST=0`` (the old behaviour)."""
+
+    if not enabled():
+        return None
+    conns = conns_of(link)
+    own = not conns
+    if own:
+        from .planlink import TcpLink, port_for
+
+        raw = os.environ.get("TF_DSV41_FATE_PORT", "").strip()
+        conns = TcpLink(rank, master, int(raw) if raw else port_for(port) + 1, world=world).conns
+    peers = list(range(1, 1 + len(conns))) if rank == 0 else [0]
+    fate = Fate(rank, [Channel(rank, c, p) for c, p in zip(conns, peers)], rt=rt, out=out)
+    batch.fate = fate
+    if rank == 0:
+        fate.on_fail.append(batch.fail_everything)
+        if getattr(batch, "floor", None) is not None:
+            batch.floor.peer = fate.peer_mem
+    fate.start()
+    _log(f"rank {rank}: on ({len(fate.chans)} fate channel(s) over {'its own TCP' if own else 'the plan link'}; "
+         f"exit {EXIT_CODE} after {fate.grace_s:g} s; followers report memory every {fate.report_s:g} s)", out)
+    return fate
+
+
+__all__ = ["Channel", "EXIT_CODE", "Fate", "Inject", "Injected", "attach", "conn_of", "conns_of", "enabled", "local_usable"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/fastboot.py b/src/tensorfold/families/deepseek_v41/cuda/fastboot.py
new file mode 100644
index 0000000..01c9284
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/fastboot.py
@@ -0,0 +1,603 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Fast restarts for DeepSeek-V4.1-Flash (our GLM patch 0140's design): a boot timeline, prepared per-rank folders
+read with parallel O_DIRECT readers, keyed by everything that decides their bytes.
+
+Boot timeline. ``mark(phase)`` prints one line a phase::
+
+    [boot] r0 +18.4s weights: prepared folder, 98.9 GB at 8.6 GB/s (11.5s) | MemFree 9.8 GiB, MemAvailable 10.4 GiB
+
+Prepared folders. A start without one reads the node-local checkpoint, slices this rank's half (``weights.Loader``)
+and builds the tree; ``cached_tree`` stores that tree (every tensor's storage bytes, dtype, shape, stride, offset;
+the dataclasses around them) in one folder a rank::
+
+    $TF_DSV41_PREPARED/<model>-<rev>/<key hash>/rank<R>/{manifest.json,data.bin}
+
+and the next start reads it back: the same bits by construction, no slicing, no conversion. The key covers the
+checkpoint (folder name / revision, file names and sizes, config.json's hash), the rank and world, torch's version,
+the device type, the token map's source and the source of the code that builds the tree (``weights.py`` and this
+format), so a change of any of them misses the old folder instead of reading stale weights. A folder whose manifest
+does not match, or that fails to read, is ignored (the checkpoint path runs). ``python -m
+tensorfold.families.deepseek_v41.cuda.fastboot prepare`` writes the folders ahead of a window;
+``TF_DSV41_PREPARED_WRITE=1`` writes a missing one after a start that had to build it.
+
+Reader. ``data.bin`` is read in 64 MiB chunks by several threads with O_DIRECT (no page cache: on GB10 the page
+cache is the GPU's memory) into pinned buffers, each copied to the device on its thread's stream. Each chunk has a
+SHA-256 in the manifest: ``TF_DSV41_PREPARED_VERIFY=full`` checks all, ``sample`` (default) every 16th and the last,
+``off`` none; a mismatch fails the read.
+
+No torch at import: the key, manifest and folder logic run in host-only tests.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib
+import inspect
+import json
+import os
+import shutil
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+FORMAT = 1
+CHUNK = 64 << 20                 # reader / checksum chunk; every chunk offset is a multiple of it
+ALIGN = 4096                     # storage offsets and the file size (O_DIRECT)
+SAMPLE_EVERY = 16
+# tensorfold.families.deepseek_v41.cuda (also under ``python -m``, where __name__ is "__main__": the key must name the
+# package's modules, the same key the engine computes)
+PKG = __spec__.parent if __spec__ is not None and __spec__.parent else __name__.rsplit(".", 1)[0]
+WEIGHT_CODE = [f"{PKG}.weights", f"{PKG}.fastboot:FORMAT"]
+ENV = "TF_DSV41_PREPARED"
+
+_IMPORT_T = time.time()
+_last: list = [None]
+_rank: list = [None]
+
+
+# -- boot timeline -----------------------------------------------------------------------------------------------
+def boot_t0() -> float:
+    for var in ("TF_DSV41_LAUNCH_T0", "TF_DSV41_T0"):
+        try:
+            v = float(os.environ.get(var, "") or 0)
+        except ValueError:
+            v = 0.0
+        if v > 0:
+            return v
+    return _IMPORT_T
+
+
+def meminfo() -> dict[str, float]:
+    out: dict[str, float] = {}
+    try:
+        for line in Path("/proc/meminfo").read_text().splitlines():
+            k, v = line.split(":", 1)
+            if k in ("MemFree", "MemAvailable"):
+                out[k] = int(v.split()[0]) / 2 ** 20
+    except OSError:
+        pass
+    return out
+
+
+def set_rank(rank: int) -> None:
+    _rank[0] = rank
+
+
+def mark(phase: str, detail: str = "") -> float:
+    now = time.time()
+    prev = _last[0] if _last[0] is not None else boot_t0()
+    _last[0] = now
+    m = meminfo()
+    mem = f" | MemFree {m.get('MemFree', 0):.1f} GiB, MemAvailable {m.get('MemAvailable', 0):.1f} GiB" if m else ""
+    who = f"r{_rank[0]} " if _rank[0] is not None else ""
+    print(f"[boot] {who}+{now - boot_t0():.1f}s {phase}{': ' + detail if detail else ''} ({now - prev:.1f}s){mem}",
+          flush=True)
+    return now - prev
+
+
+# -- keys --------------------------------------------------------------------------------------------------------
+def digest(obj: Any) -> str:
+    return hashlib.sha256(json.dumps(obj, sort_keys=True, default=str).encode()).hexdigest()
+
+
+def source_digest(names: list[str]) -> str:
+    """SHA-256 over the source of ``module`` or ``module:qualname`` objects: the code that builds the tree."""
+
+    h = hashlib.sha256()
+    for name in names:
+        mod_name, _, qual = name.partition(":")
+        mod = importlib.import_module(mod_name)
+        obj: Any = mod
+        for part in filter(None, qual.split(".")):
+            obj = getattr(obj, part)
+        if not qual:
+            src = Path(mod.__file__).read_text()
+        elif inspect.isclass(obj) or inspect.isfunction(obj):
+            src = inspect.getsource(obj)
+        else:
+            src = repr(obj)
+        h.update(name.encode() + b"\0" + src.encode() + b"\0")
+    return h.hexdigest()
+
+
+def model_rev(model_dir: str | Path) -> str:
+    """``<repo>-<revision>`` for a Hugging Face snapshot, else the folder's name."""
+
+    parts = Path(str(model_dir)).parts
+    if len(parts) >= 3 and parts[-2] == "snapshots" and parts[-3].startswith("models--"):
+        return f"{parts[-3][len('models--'):]}-{parts[-1][:12]}"
+    return Path(model_dir).name or "model"
+
+
+def files_ident(model_dir: str | Path) -> list:
+    d = Path(model_dir)
+    files = [[f.name, f.stat().st_size] for f in sorted(d.glob("*.safetensors"))]
+    cfg = d / "config.json"
+    return [files, hashlib.sha256(cfg.read_bytes()).hexdigest() if cfg.exists() else ""]
+
+
+def weights_key(model_dir: str | Path, rank: int, world: int, *, device: str = "cuda", extra: dict | None = None
+                ) -> dict:
+    import torch
+
+    key = {"format": FORMAT, "what": "weights", "model": model_rev(model_dir), "files": files_ident(model_dir),
+           "rank": int(rank), "world": int(world), "torch": torch.__version__,
+           "device": str(torch.device(device).type), "code": source_digest(WEIGHT_CODE)}
+    key.update(extra or {})
+    return key
+
+
+def weights_extra(tm_ident: str) -> dict:
+    """The weights key's extra part: the token map, and ``TF_DSV41_EXPERT_ROTATE`` when on (other bytes)."""
+
+    from .weights import rotate_on
+
+    extra = {"token_map": tm_ident}
+    if rotate_on():
+        extra["expert_rotate"] = 1
+    return extra
+
+
+def prepared_root(env: dict | None = None) -> Path | None:
+    v = (os.environ if env is None else env).get(ENV, "").strip()
+    return None if v.lower() in ("", "0", "off", "no", "false") else Path(v)
+
+
+def write_enabled() -> bool:
+    return os.environ.get(f"{ENV}_WRITE", "0").strip().lower() in ("1", "on", "yes", "true")
+
+
+def folder(root: Path, key: dict) -> Path:
+    return Path(root) / key["model"] / digest(key)[:16] / f"rank{key['rank']}"
+
+
+def valid(d: Path, key: dict) -> tuple[bool, str]:
+    man = d / "manifest.json"
+    if not man.is_file():
+        return False, "no folder"
+    try:
+        m = json.loads(man.read_text())
+    except (OSError, ValueError) as exc:
+        return False, f"unreadable manifest ({exc})"
+    if m.get("format") != FORMAT:
+        return False, f"format {m.get('format')} != {FORMAT}"
+    if m.get("key_hash") != digest(key):
+        diff = sorted(k for k in set(key) | set(m.get("key", {})) if key.get(k) != m.get("key", {}).get(k))
+        return False, f"key differs ({', '.join(diff) or 'hash'})"
+    data = d / "data.bin"
+    if not data.is_file() or data.stat().st_size != m.get("file_size"):
+        return False, "data file missing or truncated"
+    return True, "ok"
+
+
+# -- flatten / rebuild -------------------------------------------------------------------------------------------
+class _Flat:
+    def __init__(self) -> None:
+        self.storages: list = []
+        self.index: dict = {}
+
+    def storage(self, t) -> int:
+        st = t.untyped_storage()
+        k = (t.device.type, t.device.index, st.data_ptr(), st.nbytes())
+        if k not in self.index:
+            self.index[k] = len(self.storages)
+            self.storages.append((st, st.nbytes(), t.device.type))
+        return self.index[k]
+
+    def enc(self, x: Any) -> Any:
+        import dataclasses
+
+        import torch
+
+        if x is None or isinstance(x, (bool, int, float, str)):
+            return {"P": x}
+        if isinstance(x, torch.Tensor):
+            return {"T": self.storage(x), "dtype": str(x.dtype).removeprefix("torch."), "shape": list(x.shape),
+                    "stride": list(x.stride()), "off": int(x.storage_offset()), "dev": x.device.type}
+        if isinstance(x, list):
+            return {"L": [self.enc(v) for v in x]}
+        if isinstance(x, tuple):
+            return {"U": [self.enc(v) for v in x]}
+        if isinstance(x, dict):
+            if not all(isinstance(k, (str, int)) for k in x):
+                raise TypeError("dict keys must be str or int")
+            return {"D": [[k, self.enc(v)] for k, v in x.items()]}
+        if dataclasses.is_dataclass(x) and not isinstance(x, type):
+            cls = type(x)
+            if not cls.__module__.startswith("tensorfold."):
+                raise TypeError(f"{cls.__module__}.{cls.__qualname__} is not a TensorFold dataclass")
+            return {"O": f"{cls.__module__}:{cls.__qualname__}", "f": {k: self.enc(v) for k, v in vars(x).items()}}
+        raise TypeError(f"cannot store a {type(x).__module__}.{type(x).__qualname__} in a prepared folder")
+
+
+def _find_class(path: str):
+    mod, _, qual = path.partition(":")
+    if not mod.startswith("tensorfold."):
+        raise ValueError(f"refusing to build {path}")
+    obj: Any = importlib.import_module(mod)
+    for part in qual.split("."):
+        obj = getattr(obj, part)
+    return obj
+
+
+def _dec(x: dict, bufs: list) -> Any:
+    import torch
+
+    if "P" in x:
+        return x["P"]
+    if "T" in x:
+        buf = bufs[x["T"]]
+        t = torch.empty(0, dtype=getattr(torch, x["dtype"]), device=buf.device)
+        t.set_(buf.untyped_storage(), x["off"], x["shape"], x["stride"])
+        return t
+    if "L" in x:
+        return [_dec(v, bufs) for v in x["L"]]
+    if "U" in x:
+        return tuple(_dec(v, bufs) for v in x["U"])
+    if "D" in x:
+        return {k: _dec(v, bufs) for k, v in x["D"]}
+    if "O" in x:
+        cls = _find_class(x["O"])
+        obj = cls.__new__(cls)
+        for k, v in x["f"].items():
+            object.__setattr__(obj, k, _dec(v, bufs))
+        return obj
+    raise ValueError(f"bad node {list(x)[:3]}")
+
+
+# -- write -------------------------------------------------------------------------------------------------------
+def _drop_cache(fd: int, offset: int = 0, length: int = 0) -> None:
+    if hasattr(os, "posix_fadvise"):
+        os.posix_fadvise(fd, offset, length, os.POSIX_FADV_DONTNEED)
+
+
+def save(obj: Any, d: Path, key: dict) -> dict:
+    """``obj``'s tensors (storage bytes) and structure into ``d`` (a sibling first, then renamed)."""
+
+    import torch
+
+    flat = _Flat()
+    tree = flat.enc(obj)
+    d = Path(d)
+    d.parent.mkdir(parents=True, exist_ok=True)
+    tmp = d.parent / f".{d.name}.tmp-{os.getpid()}"
+    shutil.rmtree(tmp, ignore_errors=True)
+    tmp.mkdir()
+    storages, offset = [], 0
+    for _, nbytes, dev in flat.storages:
+        storages.append({"offset": offset, "nbytes": nbytes, "dev": dev})
+        offset += -(-nbytes // ALIGN) * ALIGN
+    stage = torch.empty(CHUNK, dtype=torch.uint8, pin_memory=torch.cuda.is_available())
+    stage_np = stage.numpy()
+    sums: list[str] = []
+    h, filled = hashlib.sha256(), 0
+    t0 = time.perf_counter()
+
+    def hashed(mv) -> None:
+        nonlocal h, filled
+        pos = 0
+        while pos < len(mv):
+            n = min(len(mv) - pos, CHUNK - filled)
+            h.update(mv[pos:pos + n])
+            filled, pos = filled + n, pos + n
+            if filled == CHUNK:
+                sums.append(h.hexdigest())
+                h, filled = hashlib.sha256(), 0
+
+    zeros = bytes(ALIGN)
+    with open(tmp / "data.bin", "wb", buffering=0) as f:
+        fd, since_sync = f.fileno(), 0
+        for st, nbytes, _ in flat.storages:
+            src = torch.empty(0, dtype=torch.uint8, device=st.device)
+            src.set_(st, 0, (nbytes,), (1,))
+            pos = 0
+            while pos < nbytes:
+                n = min(CHUNK, nbytes - pos)
+                stage[:n].copy_(src[pos:pos + n])
+                mv = memoryview(stage_np)[:n]
+                f.write(mv)
+                hashed(mv)
+                pos, since_sync = pos + n, since_sync + n
+                if since_sync >= 1 << 30:                 # keep the page cache (GPU memory on GB10) small
+                    os.fdatasync(fd)
+                    _drop_cache(fd)
+                    since_sync = 0
+            pad = -nbytes % ALIGN
+            if pad:
+                f.write(zeros[:pad])
+                hashed(memoryview(zeros)[:pad])
+        os.fdatasync(fd)
+        _drop_cache(fd)
+    if filled:
+        sums.append(h.hexdigest())
+    del stage, stage_np
+    _release_pinned()
+    manifest = {"format": FORMAT, "key": key, "key_hash": digest(key), "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
+                "file_size": offset, "chunk": CHUNK, "chunk_sha256": sums, "storages": storages, "tree": tree}
+    (tmp / "manifest.json").write_text(json.dumps(manifest, separators=(",", ":")))
+    shutil.rmtree(d, ignore_errors=True)
+    os.replace(tmp, d)
+    dt = time.perf_counter() - t0
+    print(f"[tensorfold] prepared folder written: {d} ({offset / 1e9:.1f} GB in {dt:.1f}s)", flush=True)
+    return manifest
+
+
+# -- read --------------------------------------------------------------------------------------------------------
+def _release_pinned() -> None:
+    """Hand the staging buffers' pinned memory back (on GB10 it is GPU memory)."""
+
+    import torch
+
+    try:
+        torch._C._host_emptyCache()
+    except (AttributeError, RuntimeError):
+        pass
+
+
+def _plan(storages: list[dict], size: int) -> list[list[tuple[int, int, int, int]]]:
+    """Per chunk k: (storage, byte offset in it, offset in the chunk, bytes)."""
+
+    plan: list[list[tuple[int, int, int, int]]] = [[] for _ in range(-(-size // CHUNK))]
+    for i, s in enumerate(storages):
+        a, n, pos = s["offset"], s["nbytes"], 0
+        while pos < n:
+            k, within = divmod(a + pos, CHUNK)
+            m = min(n - pos, CHUNK - within)
+            plan[k].append((i, pos, within, m))
+            pos += m
+    return plan
+
+
+def verify_mode() -> str:
+    v = os.environ.get(f"{ENV}_VERIFY", "sample").strip().lower() or "sample"
+    if v not in ("full", "sample", "off"):
+        raise ValueError(f"{ENV}_VERIFY={v!r}: expected full, sample or off")
+    return v
+
+
+def _open(path: Path) -> tuple[int, bool]:
+    if hasattr(os, "O_DIRECT") and os.environ.get(f"{ENV}_DIRECT", "1").strip() != "0":
+        try:
+            return os.open(path, os.O_RDONLY | os.O_DIRECT), True
+        except OSError:
+            pass
+    return os.open(path, os.O_RDONLY), False
+
+
+def read(d: Path, device: str = "cuda", threads: int | None = None) -> tuple[Any, dict]:
+    """The object ``save`` stored in ``d`` with its tensors on ``device``, and read stats."""
+
+    import mmap
+
+    import torch
+
+    d = Path(d)
+    m = json.loads((d / "manifest.json").read_text())
+    storages, size, sums = m["storages"], int(m["file_size"]), m["chunk_sha256"]
+    if int(m.get("chunk", CHUNK)) != CHUNK:
+        raise ValueError(f"{d}: chunk {m.get('chunk')} != {CHUNK}")
+    dev = torch.device(device)
+    cuda = dev.type == "cuda"
+    t0 = time.perf_counter()
+    bufs = [torch.empty(s["nbytes"], dtype=torch.uint8, device=dev if s["dev"] != "cpu" else "cpu") for s in storages]
+    plan = _plan(storages, size)
+    mode = verify_mode()
+    n_threads = max(1, min(int(threads or os.environ.get(f"{ENV}_THREADS", "") or 8), max(1, len(plan))))
+    nxt, lock, errors, verified, direct_all = [0], threading.Lock(), [], [0], [True]
+
+    def worker() -> None:
+        try:
+            stream = torch.cuda.Stream(device=dev) if cuda else None
+            if cuda:
+                stage = [torch.empty(CHUNK, dtype=torch.uint8, pin_memory=True) for _ in range(2)]
+            else:
+                stage = [torch.frombuffer(mmap.mmap(-1, CHUNK), dtype=torch.uint8) for _ in range(2)]
+            fd, direct = _open(d / "data.bin")
+            if direct and any(b.data_ptr() % ALIGN for b in stage):
+                os.close(fd)
+                fd, direct = os.open(d / "data.bin", os.O_RDONLY), False
+            direct_all[0] &= direct
+            events: list = [None, None]
+            which = 0
+            try:
+                while True:
+                    with lock:
+                        k = nxt[0]
+                        nxt[0] += 1
+                    if k >= len(plan) or errors:
+                        break
+                    if events[which] is not None:
+                        events[which].synchronize()
+                    buf = stage[which]
+                    mv = memoryview(buf.numpy())
+                    off, want = k * CHUNK, min(CHUNK, size - k * CHUNK)
+                    got = 0
+                    while got < want:
+                        r = os.preadv(fd, [mv[got:want]], off + got)
+                        if r <= 0:
+                            raise OSError(f"{d / 'data.bin'}: short read at {off + got}")
+                        got += r
+                    if not direct:
+                        _drop_cache(fd, off, want)
+                    if mode == "full" or (mode == "sample" and (k % SAMPLE_EVERY == 0 or k == len(plan) - 1)):
+                        if hashlib.sha256(mv[:want]).hexdigest() != sums[k]:
+                            raise ValueError(f"{d / 'data.bin'}: chunk {k} checksum mismatch")
+                        with lock:
+                            verified[0] += 1
+                    if cuda:
+                        with torch.cuda.stream(stream):
+                            for i, a, s, n in plan[k]:
+                                bufs[i][a:a + n].copy_(buf[s:s + n], non_blocking=bufs[i].is_cuda)
+                            ev = torch.cuda.Event()
+                            ev.record(stream)
+                        events[which] = ev
+                        which ^= 1
+                    else:
+                        for i, a, s, n in plan[k]:
+                            bufs[i][a:a + n].copy_(buf[s:s + n])
+                for ev in events:
+                    if ev is not None:
+                        ev.synchronize()
+            finally:
+                os.close(fd)
+        except BaseException as exc:  # noqa: BLE001 - reported by the caller
+            errors.append(exc)
+
+    pool = [threading.Thread(target=worker, name=f"tf-dsv41-prepared-{i}", daemon=True) for i in range(n_threads)]
+    for t in pool:
+        t.start()
+    for t in pool:
+        t.join()
+    if cuda:
+        torch.cuda.synchronize(dev)
+        _release_pinned()
+    if errors:
+        raise errors[0]
+    obj = _dec(m["tree"], bufs)
+    dt = time.perf_counter() - t0
+    return obj, {"bytes": size, "seconds": dt, "gbps": size / 1e9 / max(dt, 1e-9), "direct": direct_all[0],
+                 "verified": verified[0], "chunks": len(plan), "threads": n_threads}
+
+
+def _kind(d: Path) -> tuple:
+    """(what, part) of a folder's key: the weights tree and the DSpark drafter's share the model's root."""
+
+    try:
+        k = json.loads((d / "manifest.json").read_text()).get("key", {})
+    except (OSError, ValueError):
+        return (None, None)
+    return (k.get("what"), k.get("part"))
+
+
+def prune(d: Path, keep: int = 1) -> None:
+    """Remove this rank's older key folders of the same model and kind beyond the ``keep`` newest (~100 GB each).
+    Only the same kind: G3 found the drafter's folder pruning the weights' (and back), so every boot rebuilt
+    101.8 GB from the checkpoint (~300 s)."""
+
+    kind = _kind(d)
+    olds = sorted((p for p in d.parent.parent.glob(f"*/{d.name}") if p != d and (p / "manifest.json").exists()
+                   and _kind(p) == kind),
+                  key=lambda p: (p / "manifest.json").stat().st_mtime, reverse=True)
+    for p in olds[max(keep - 1, 0):]:
+        shutil.rmtree(p, ignore_errors=True)
+        try:
+            p.parent.rmdir()
+        except OSError:
+            pass
+        print(f"[tensorfold] removed an older prepared folder: {p}", flush=True)
+
+
+def cached_tree(what: str, key: dict, build: Callable[[], Any], device: str = "cuda") -> Any:
+    """``build()``'s result, from the prepared folder for ``key`` when a valid one exists; else built (and written
+    when ``TF_DSV41_PREPARED_WRITE=1``)."""
+
+    root = prepared_root()
+    if root is None:
+        return build()
+    d = folder(root, key)
+    ok, why = valid(d, key)
+    if ok:
+        try:
+            obj, st = read(d, device)
+            print(f"[tensorfold] {what}: prepared folder {d}, {st['bytes'] / 1e9:.1f} GB in {st['seconds']:.1f}s "
+                  f"({st['gbps']:.1f} GB/s, {st['threads']} threads, {'O_DIRECT' if st['direct'] else 'buffered'}, "
+                  f"{st['verified']}/{st['chunks']} chunks verified)", flush=True)
+            return obj
+        except Exception as exc:  # noqa: BLE001 - any failure: build as without a folder
+            print(f"[tensorfold] {what}: prepared folder {d} unusable ({type(exc).__name__}: {exc}); building from "
+                  "the checkpoint", file=sys.stderr, flush=True)
+    else:
+        print(f"[tensorfold] {what}: no usable prepared folder ({why}): building from the checkpoint"
+              + ("; will write it" if write_enabled() else ""), flush=True)
+    obj = build()
+    if write_enabled():
+        try:
+            save(obj, d, key)
+            prune(d)
+        except Exception as exc:  # noqa: BLE001 - serving does not depend on the folder
+            print(f"[tensorfold] {what}: could not write {d} ({type(exc).__name__}: {exc})", file=sys.stderr,
+                  flush=True)
+    return obj
+
+
+# -- prepare ahead of a window -----------------------------------------------------------------------------------
+def prepare(model_dir: Path, rank: int, world: int, root: Path, *, force: bool = False, device: str = "cuda") -> int:
+    """Build this rank's tree from the checkpoint and write its folder (on the node that serves the rank)."""
+
+    from . import weights as W
+    from .config import Config
+    from .engine import token_map_for
+
+    cfg = Config.from_file(Path(model_dir) / "config.json")
+    tmap, tm_ident = token_map_for(Path(model_dir), cfg)
+    key = weights_key(model_dir, rank, world, device=device, extra=weights_extra(tm_ident))
+    d = folder(root, key)
+    ok, why = valid(d, key)
+    if ok and not force:
+        print(f"[tensorfold] prepared folder current: {d}", flush=True)
+        return 0
+    t0 = time.perf_counter()
+    tree = W.Loader(cfg, W.Shards(model_dir), rank, world, device, W.bias_vl_source()).load(token_map=tmap)
+    print(f"[tensorfold] rank {rank}: {tree.nbytes() / 1e9:.1f} GB built in {time.perf_counter() - t0:.0f}s "
+          f"({why})", flush=True)
+    save(tree, d, key)
+    prune(d)
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    import argparse
+
+    ap = argparse.ArgumentParser(description="DeepSeek-V4.1-Flash prepared folders")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    p = sub.add_parser("prepare", help="write this rank's prepared folder")
+    p.add_argument("model_dir")
+    p.add_argument("--rank", type=int, required=True)
+    p.add_argument("--world", type=int, default=2)
+    p.add_argument("--root", default=os.environ.get(ENV, ""))
+    p.add_argument("--force", action="store_true")
+    c = sub.add_parser("check", help="whether this rank's folder is current (exit 0) or why not (exit 1)")
+    c.add_argument("model_dir")
+    c.add_argument("--rank", type=int, required=True)
+    c.add_argument("--world", type=int, default=2)
+    c.add_argument("--root", default=os.environ.get(ENV, ""))
+    a = ap.parse_args(argv)
+    if not a.root:
+        raise SystemExit(f"--root or {ENV} names the prepared folders' root")
+    if a.cmd == "prepare":
+        return prepare(Path(a.model_dir), a.rank, a.world, Path(a.root), force=a.force)
+    from .config import Config
+    from .engine import token_map_for
+
+    _, ident = token_map_for(Path(a.model_dir), Config.from_file(Path(a.model_dir) / "config.json"))
+    key = weights_key(a.model_dir, a.rank, a.world, extra=weights_extra(ident))
+    ok, why = valid(folder(Path(a.root), key), key)
+    print(f"{folder(Path(a.root), key)}: {why}")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
