+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""M2's decode forward: ``slots.SlotsForward`` + DSpark drafting, cost-derived depth, Engram prefetch and CUDA
+graphs, behind the serving protocol's optional hooks (``protocol.Drafts`` / ``Prefetch``), on both ranks alike.
+
+- ``draft(slots, pendings, starts, depths, noises, alone)``: one DSpark pass over the slots (``drafter.Drafter``:
+  taps -> context rings, 3 blocks of 5, Markov + confidence heads, keyed draft noise = the request's sampling at the
+  drafted positions), then each slot's k from its confidences and the cost table (``depth.Depth``), at most its
+  depth; ``alone`` (the round's only window): k may be 0 (``depth``'s zero depth). The pass reads the head of
+  ``TF_DSV41_DRAFT_HEAD`` (``draft_head``: full / q4 / trim, the commits feed trim's fallback rule) and replays a
+  CUDA graph per (slots, rows, head variant) (``draft_graphs``, warmed at boot after the windows' graphs);
+- ``commit``: the kept rows' taps into the drafter's rings (``keep``), the depth calibration and the slot's rate;
+  ``committed(slot, accepted, bonus)`` after it: a zero-depth round's first draft against the bonus token;
+- ``prefetch(pieces, windows)``: the next forward's Engram reads (``prefetch.Prefetcher``) at drafter end / before
+  a prefill; ``prefetch_pending(slot, token)`` at a commit: the next window's pending row, before the DSpark pass;
+  the forward gathers a layer's rows only when it reaches that layer (``LazyEngram``). With
+  ``TF_DSV41_ENGRAM_GATE=1`` decode windows go through ``engram_gate``: the GPU waits for the rows right before
+  layers 1 / 14 (a kernel reading a pinned flag, graph-compatible), the host never does; the drafted rows are read
+  from the end of the DSpark pass;
+- ``window``: replayed from a CUDA graph per (padded rows, context bucket) serving any mix of slots
+  (``rowgraphs.RowGraphs``; TF_DSV41_GRAPH_MODE=mix: per (mix, context bucket), ``graphs.CudaGraphs``), else
+  eager (and captured for the next time); top-p rows without top-k from a few hundred candidates (``nucleus.py``);
+- the MoE scratch: the geometry's fixed one (``moe.scratch_for``) bound at load, before any graph capture;
+- ``dlog`` (TF_DSV41_DRAFT_LOG, ``draftlog``): rank 0's drafting log for offline acceptance work (off by default);
+- ``snapshot`` / ``restore``: the bounded state + the drafter's context rows (``dspark_*`` arrays);
+- ``boot(engine)``: graph warm-up (15 s budget), then the cost table (``calib.costs_for``), shared with the batcher.
+
+Every hook is exact by construction: drafts only propose (``dspark.accept``), prefetched rows are the file's bytes,
+graphs replay the eager kernels on static buffers. ``make`` builds it for the engine (``TF_DSV41_DSPARK``: 1, 0 =
+no drafter; ``TF_DSV41_DRAFT_K``: candidates a rank, 64).
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Sequence
+
+from . import nucleus as NU
+from .csa2.backend import Win
+from .depth import Costs, Depth, default_costs
+from .forward import Seg
+from .phases import PH
+from .prefetch import CachedHasher, Prefetcher, piece_runs
+from .protocol import Bounded, Candidates
+from .slots import SlotsForward
+
+
+def dspark_enabled() -> bool:
+    return (os.environ.get("TF_DSV41_DSPARK", "1").strip() or "1") != "0"
+
+
+class LazyEngram:
+    """A window's Engram inputs, gathered a layer at a time when the forward first asks for it (``rows[L]``), so the
+    reads of layer 14 finish behind the launches of layers 0-13. ``items()`` gathers them all (graph staging). Both
+    ranks ask in the same order (the forward's), so the exchanges pair up."""
+
+    def __init__(self, fw, segs) -> None:
+        self.fw, self.segs = fw, segs
+        self.by = {blk.index: blk for blk in fw.blocks if blk.engram is not None}
+        self.hashes = None
+        self.done: dict = {}
+
+    def __getitem__(self, L: int):
+        got = self.done.get(L)
+        if got is None:
+            from . import blocks as B
+
+            fw = self.fw
+            with PH("engram.wait"):
+                if self.hashes is None:
+                    import torch
+
+                    self.hashes = torch.cat([fw.hasher(torch.tensor(sg.ids), lookback=torch.tensor(
+                        [t for t in fw.slots[sg.slot].tail if t >= 0], dtype=torch.long)) for sg in self.segs])
+                mine = B.engram_rows(self.by[L], self.hashes, fw.engram_rows[L], fw.rank, fw.world,
+                                     fw.hasher.layout)
+                if mine.shape[0] > fw.chunk:            # a prompt segment's rows: no stream sync for the copy
+                    from .forward import to_device
+
+                    mine = to_device(mine, fw.device)
+                got = self.done[L] = fw.gather_cols(mine.to(fw.device))
+        return got
+
+    def __contains__(self, L) -> bool:
+        return L in self.by
+
+    def keys(self):
+        return sorted(self.by)
+
+    def items(self):
+        return [(L, self[L]) for L in sorted(self.by)]
+
+    def __len__(self) -> int:
+        return len(self.by)
+
+
+class DecodeForward(SlotsForward):
+    """``SlotsForward`` with M2's hooks. ``dspark``: ``drafter.DraftW`` (None: no drafter, no ``draft`` hook)."""
+
+    keyed_noise = True
+    zero_depth = True                   # ``draft(alone=...)``: a lone window may verify no draft (``depth.py``)
+    joint_depth = True                  # ``draft(others=...)``: the round's other windows' rows (``joint.py``)
+    nucleus = True                      # ``window(nucleus=...)``: top-p rows from candidates (``nucleus.py``)
+
+    def __init__(self, *args, dspark=None, prefetch: bool = False, draft_k: int = 64, **kw) -> None:
+        kw["taps"] = bool(kw.get("taps")) or dspark is not None
+        super().__init__(*args, **kw)
+        self.static = None
+        self.graphs = None
+        self.drafter = None
+        self.spec = None                        # TF_DSV41_SPEC_DRAFT: the next pass launched after a window (``spec``)
+        self._ingest_from: dict[int, int] = {}
+        self._prefilling = False
+        if dspark is not None:
+            from .drafter import Drafter
+
+            self.drafter = Drafter(self, dspark, k=draft_k)
+            from . import spec as SP
+
+            if SP.enabled():
+                self.spec = SP.Spec(self)
+        else:
+            self.draft = None                   # no ``Drafts`` hook: the batcher plans no DSpark rounds
+        self.depth = Depth(default_costs(), block=int(self.cfg.dspark_block_size))
+        from . import tree as TR
+
+        self.tree = TR.make(self)               # TF_DSV41_TREE: first-position siblings on shadow slots (``tree.py``)
+        if self.tree is not None:
+            self.drafter.keep_tree = True
+        from . import draftlog
+
+        self.dlog = draftlog.make(self)         # TF_DSV41_DRAFT_LOG: rank 0's drafting log (offline acceptance work)
+        self.prefetcher = None
+        sources = dict(self.engram_rows)
+        if prefetch and self.engram_rows:
+            self.prefetcher = Prefetcher(self.engram_rows)
+            self.engram_rows = self.prefetcher.wrap()
+            if self.hasher is not None:
+                self.hasher = CachedHasher(self.hasher)
+        from . import engram_gate
+
+        self.gate = engram_gate.make(self, sources) if sources else None     # TF_DSV41_ENGRAM_GATE (decode windows)
+        from . import moe as MO
+
+        MO.shared_scratch([b.moe for b in self.blocks + (self.drafter.blocks if self.drafter is not None else [])
+                           if isinstance(b.moe, MO.GpuMoE)])          # bound before any capture (``moe.scratch_for``)
+
+    def bind(self, slots) -> None:
+        """``SlotsForward.bind`` with the tree's shadow slots after the request slots (``shadow.py``)."""
+
+        super().bind(self.tree.bind(slots) if self.tree is not None else slots)
+        if self.tree is not None:
+            self.tree.shadows.forget()
+
+    def took(self, rows):
+        """After ``window`` (``rounds.Executor``): the chain each window presents (a tree round's winning branch)."""
+
+        return self.tree.took(rows) if self.tree is not None else rows
+
+    @property
+    def costs(self) -> Costs:
+        return self.depth.costs
+
+    def set_costs(self, costs: Costs) -> None:
+        self.depth.costs = costs
+
+    # -- forward.run's hooks (static buffers while a graph is captured) ------------------------------------------
+    def win_of(self, i: int, start: int, n: int):
+        return self.static.wins[i] if self.static is not None else Win.make(start, n, self.device)
+
+    def ids_of(self, segs):
+        return self.static.ids if self.static is not None else super().ids_of(segs)
+
+    def _gated(self, segs):
+        return self.gate.inputs(self, segs) if self.gate is not None and not self._prefilling else None
+
+    def _engram_inputs(self, segs):
+        gated = self._gated(segs)
+        if gated is not None:                   # the GPU waits for the rows, in the graph too (``engram_gate``)
+            return gated
+        if self.static is not None:
+            return self.static.engram
+        return self.engram_inputs_eager(segs)
+
+    def engram_inputs_eager(self, segs):
+        """A window's Engram inputs: through the gate (graph staging only arms it: ``items()`` is empty), else
+        ``LazyEngram``."""
+
+        if self.hasher is None or not any(blk.engram is not None for blk in self.blocks):
+            return {}
+        gated = self._gated(segs)
+        return gated if gated is not None else LazyEngram(self, segs)
+
+    # -- state -----------------------------------------------------------------------------------------------------
+    def reset(self, slot: int = 0) -> None:
+        super().reset(slot)
+        if self.drafter is not None:
+            self.drafter.reset(slot)
+        if getattr(self, "spec", None) is not None:
+            self.spec.forget(slot)
+        self.depth.reset(slot)
+        if getattr(self, "dlog", None) is not None:
+            self.dlog.reset(slot)
+
+    def keep(self, slot: int, accepted: int) -> None:
+        p = self.slots[slot].pending
+        super().keep(slot, accepted)
+        if self.drafter is not None and p is not None:
+            self.drafter.observe(slot, p.ids[:accepted + 1])          # the trimmed draft head's fallback rule
+            if p.start + accepted + 1 > self._ingest_from.get(slot, 0) and not (
+                    self.spec is not None and self.spec.ingested(slot, p.start, accepted)):     # ``spec``: done
+                self.drafter.ingest(slot, p.start, self.slots[slot].taps)
+
+    def prefill(self, pieces, *, mode: str = "full") -> None:
+        """The drafter reads the last ``window`` context rows only: a piece's earlier chunks skip its ingest."""
+
+        if self.drafter is not None:
+            self._ingest_from = {pc.slot: pc.end - self.drafter.window for pc in pieces}
+        self._prefilling = True                 # prompt pieces take the prefetcher's path, not the gate
+        try:
+            super().prefill(pieces, mode=mode)
+        finally:
+            self._ingest_from = {}
+            self._prefilling = False
+
+    def replayed(self, slot: int, start: int, taps: dict) -> None:
+        """CED: the decoder replay's taps (the prompt's tail) are the drafter's context."""
+
+        if self.drafter is not None:
+            self.drafter.ingest(slot, start, taps)
+
+    def commit(self, slot: int, accepted: int) -> None:
+        p = self.slots[slot].pending
+        rows = len(p.ids) if p is not None else 1
+        if self.dlog is not None:                # the chain presented: the slot's window or a winning sibling's
+            won = self.tree.won.get(int(slot)) if self.tree is not None else None
+            j = int(won[0]) if won else 0
+            toks = list(p.ids) if p is not None else []
+            if j:
+                toks = list(next(t for jj, _, t, _ in won[1].sib if jj == j))
+            self.dlog.commit(slot, accepted, j, p.start if p is not None else -1, toks)
+        t = self.tree.commit(slot, accepted) if self.tree is not None else None     # a sibling's state -> the slot
+        super().commit(slot, accepted)
+        if t is None:
+            self.depth.record(slot, rows, accepted + 1)
+        else:
+            self.depth.record(slot, t[0], t[1], tokens=t[2])
+
+    def committed(self, slot: int, accepted: int, bonus: int) -> None:
+        """After ``commit`` (both ranks, ``rounds.Executor``): the bonus token for the depth's counterfactual."""
+
+        self.depth.bonus(slot, bonus)
+        if self.dlog is not None:
+            self.dlog.bonus(slot, bonus)
+
+    # -- the hooks -------------------------------------------------------------------------------------------------
+    def draft(self, slots: Sequence[int], pendings: Sequence[int], starts: Sequence[int], depths: Sequence[int],
+              noises: Sequence | None = None, alone: bool = False, others: Sequence[int] = ()) -> list[list[int]]:
+        if self.drafter is None or not slots:
+            return [[] for _ in slots]
+        with PH("draft.pass"):
+            got = self.spec.take(slots, pendings, starts, noises) if self.spec is not None else None
+            drafts, conf = got if got is not None else self.drafter.propose(list(slots), list(pendings), list(starts),
+                                                                             noises)
+        if self.gate is not None:               # every drafted position's rows, before depth and grammar cut them
+            self.gate.warm(self, [(s, [int(p)] + [int(t) for t in d], self.slots[s].tail)
+                                  for s, p, d in zip(slots, pendings, drafts)])
+        alone = bool(alone) and len(slots) == 1
+        if self.tree is not None:
+            with PH("draft.tree"):
+                out = self.tree.draft(slots, pendings, starts, depths, noises, drafts, conf, alone,
+                                      self.drafter.last_tree)      # the pass's (``propose`` or ``spec.take``)
+        else:
+            with PH("draft.depth"):         # the slots' k together (TF_DSV41_DEPTH_JOINT; ``choose`` when alone)
+                ks = self.depth.choose_joint(list(slots), conf, list(depths), others=[int(r) for r in others],
+                                             firsts=[d[0] if d else None for d in drafts], alone=alone)
+                out = [d[:k] for d, k in zip(drafts, ks)]
+        if self.dlog is not None:
+            self.dlog.drafted(slots, pendings, starts, noises, drafts, conf, out, self.drafter.last_tree,
+                              self.drafter.last_hid)
+        return out
+
+    def prefetch_pending(self, slot: int, token: int) -> None:
+        """At a commit (both ranks): the Engram reads of the next window's first row (the committed bonus token)."""
+
+        if self.gate is not None:
+            self.gate.warm(self, [(slot, [int(token)], self.slots[slot].tail)])
+        elif self.prefetcher is not None:
+            self.prefetcher.issue_pending(self, slot, token)
+
+    def prefetch(self, pieces, windows, ahead=()) -> None:
+        """``ahead``: the next round's likely pieces (``prefetch.next_pieces``, TF_DSV41_PREFETCH_AHEAD): their bulk
+        reads start behind this round's."""
+
+        if self.tree is not None and windows and not pieces:
+            windows = list(windows) + self.tree.peek(windows)
+        if self.gate is not None and not pieces and windows and \
+                self.gate.issue(self, [Seg(w.slot, w.start, tuple(w.tokens)) for w in windows]) is not None:
+            return                              # the round job is queued: the gate serves this window
+        if self.prefetcher is None:
+            return
+        if pieces:
+            runs = piece_runs(self, pieces)
+        else:
+            runs = [[(w.slot, tuple(int(t) for t in w.tokens), list(self.slots[w.slot].tail)) for w in windows]]
+        more = piece_runs(self, ahead, after=pieces) if ahead else []
+        if runs and runs[0]:
+            self.prefetcher.issue(self, runs, ahead=more)
+
+    @property
+    def speculates(self) -> bool:
+        """``window(spec=...)`` is understood (``rounds.Executor``): TF_DSV41_SPEC_DRAFT."""
+
+        return self.spec is not None
+
+    def window(self, windows, *, count: int, masks=None, nucleus=None, spec=None) -> Candidates:
+        """One verify forward over every window; ``nucleus[i]`` (``nucleus.spec``): window i samples top-p without
+        top-k, so its rows get keep counts (or their full rows) beside the ``count`` candidates. ``spec[i]``: (window
+        i drafted with DSpark, its keyed noise): the next pass may start on the GPU before the host decides
+        (``spec.py``; not with grammar masks or nucleus rows, whose candidates need more exchanges)."""
+
+        extra = self.tree.extra(windows, masks, nucleus) if self.tree is not None else []
+        if extra:                               # a tree round: the siblings' windows on their shadow slots
+            spec = None
+        pre = None                              # G17 ``nucleus.Pre`` (TF_DSV41_SPEC_NUCLEUS)
+        segs = [Seg(w.slot, w.start, tuple(w.tokens)) for w in list(windows) + extra]
+        sizes = [len(w.tokens) for w in list(windows) + extra]
+        self.cand_reserve(sum(sizes), count)    # before the forward: no pinned allocation while it may wait on Engram
+        with PH("forward"):
+            logits = self.graphs.run(segs) if self.graphs is not None else self.run(segs)
+        with PH("candidates"):
+            g, k = self.cand_gather(logits, sizes, count, masks)
+            got = self.cand_fetch(g, k, count)          # the candidates' D2H copy is queued before the pass
+            if self.spec is not None:
+                unmasked = not (masks is not None and any(m is not None for m in masks))
+                nuc = bool(nucleus and any(nucleus))
+                plain = unmasked and not nuc
+                if spec and unmasked and nuc and not extra:
+                    from . import spec as SP
+
+                    if SP.nucleus_enabled():    # G17: the nucleus stats first, then the pass (``nucleus.Pre``)
+                        with PH("nucleus.pre"):
+                            pre = NU.Pre(self, logits, sizes, nucleus, masks)
+                        plain = True
+                with PH("spec"):
+                    if spec and plain:
+                        self.spec.launch(windows, spec, got, zs=pre.zs if pre is not None else None)
+                    else:
+                        self.spec.clear()
+            cand = self.cand_wait(got)
+        if self.gate is not None:
+            self.gate.check()                   # a failed read / timed-out GPU wait: this window's logits are void
+        if self.dlog is not None:
+            self.dlog.window(segs, cand)
+        if extra:
+            with PH("tree"):
+                cand = self.tree.resolve(windows, extra, cand)
+        if nucleus and any(nucleus):
+            with PH("nucleus"):
+                cand = NU.finish(self, logits, cand, sizes, nucleus, masks, pre=pre)
+        return cand
+
+    # -- snapshots ---------------------------------------------------------------------------------------------------
+    def snapshot(self, slot: int) -> Bounded:
+        snap = super().snapshot(slot)
+        if self.drafter is not None:
+            snap.arrays.update(self.drafter.snapshot(slot, snap.pos))
+        return snap
+
+    def restore(self, slot: int, snap: Bounded) -> None:
+        super().restore(slot, snap)
+        if self.drafter is not None:
+            self.drafter.restore(slot, int(snap.pos), snap.arrays)
+
+    # -- boot (both ranks, after the serving stack exists) -------------------------------------------------------
+    def boot(self, eng) -> None:
+        """Graph warm-up, then the cost table (shared with the batcher). ``eng``: ``engine.Dsv41Engine``."""
+
+        import torch
+
+        from . import calib
+        from . import graphs as G
+
+        batch = getattr(eng, "batch", None)
+        if batch is None:
+            return
+        ex = batch.ex
+        cuda = self.device.type == "cuda"
+
+        def ensure(slot: int, end: int) -> None:
+            ex.slots[slot].ensure(end)
+
+        def agree_all(ok: bool) -> bool:
+            return all(v[0] for v in eng._gather_ints([int(ok)]))
+
+        def agree_any(flag: bool) -> bool:
+            return any(v[0] for v in eng._gather_ints([int(flag)]))
+
+        sync = torch.cuda.synchronize if cuda else (lambda: None)
+        try:
+            st = G.env_settings()
+            if cuda and st["on"]:
+                from . import rowgraphs as RG          # G8: one graph a (rows bucket, context bucket), any slots
+
+                self.graphs = RG.make(self, agree_all=agree_all, agree_any=agree_any, settings=st)
+                n = self.graphs.warmup(len(ex.slots), ensure, int(self.cfg.bos_token_id))
+                if eng.rank == 0:
+                    print(f"[tensorfold] dsv41 {self.graphs.cache.describe()} ({n} captured at boot)", flush=True)
+            if cuda and self.drafter is not None:
+                from . import draft_graphs as DG
+
+                dst = DG.draft_settings()
+                if dst["on"]:           # the DSpark pass's graphs (TF_DSV41_DRAFT_GRAPHS), after the windows'
+                    self.drafter.graphs = DG.DraftGraphs(self.drafter, agree_all=agree_all, agree_any=agree_any,
+                                                         settings=dst)
+                    n = self.drafter.graphs.warmup(int(self.cfg.bos_token_id))
+                    if eng.rank == 0:
+                        print(f"[tensorfold] dsv41 {self.drafter.describe()} ({n} captured at boot)", flush=True)
+            shape = {"slots": len(ex.slots), "context": int(getattr(eng, "limit", 0)), "world": self.world,
+                     "gpu": torch.cuda.get_device_name(0) if cuda else "cpu", "dspark": self.drafter is not None}
+            from .engine import code_digest
+
+            costs = calib.costs_for(self, eng, ensure=ensure, image=code_digest(), shape=shape, sync=sync)
+            self.set_costs(costs)
+            planner = getattr(batch, "planner", None)
+            if planner is not None:
+                planner.costs = costs
+        finally:
+            for s in range(len(ex.slots)):
+                self.reset(s)
+                ex.slots[s].release()
+
+    def describe(self) -> str:
+        jr = self.depth.stats.joint
+        jm = getattr(self.depth, "joint_mode", int(self.depth.joint))
+        joint = (f", joint {('off', 'on', '2')[jm]}"
+                 + (f": {jr[0]} rounds, {jr[1] / jr[0]:.2f} rows, {jr[2] / jr[0]:.2f} drafts a round" if jr[0] else "")
+                 + (f", {jr[3]} zero-depth slots" if jm == 2 and jr[0] else ""))
+        parts = [(f"DSpark {'on' if self.drafter is not None else 'off'} (depth {self.depth.mode}, cap "
+                  f"{self.depth.cap}{joint}, costs {self.costs.source})")]
+        if self.drafter is not None:
+            parts.append(self.drafter.describe())
+        if self.prefetcher is not None:
+            parts.append(f"Engram prefetch {self.prefetcher.stats}")
+        if self.gate is not None:
+            parts.append(self.gate.describe())
+        if self.spec is not None:
+            parts.append(self.spec.describe())
+        if self.tree is not None:
+            parts.append(self.tree.describe())
+        if self.graphs is not None:
+            parts.append(self.graphs.cache.describe())
+        fast, slow = getattr(self.comm, "fast_ops", None), getattr(self.comm, "slow_ops", None)
+        if fast is not None:
+            parts.append(f"RoCE exchanges {fast} fast / {slow} on NCCL")
+        if PH.on:
+            parts.append(PH.describe())
+        return "; ".join(parts)
+
+
+def make(cfg, tree, *, loader=None, cached=None, **kw) -> SlotsForward:
+    """The engine's serving forward: ``DecodeForward`` with DSpark when the checkpoint has it and
+    TF_DSV41_DSPARK != 0 (``loader``: the rank's ``weights.Loader``; ``cached(build)``: the prepared-folder cache
+    for the drafter's tree), the Engram prefetch when TF_DSV41_PREFETCH != 0."""
+
+    from . import drafter as DR
+    from . import prefetch as PF
+
+    dw = None
+    if loader is not None and dspark_enabled() and DR.present(loader.src, cfg):
+        build = lambda: DR.load(loader)
+        dw = cached(build) if cached is not None else build()
+    k = int(os.environ.get("TF_DSV41_DRAFT_K", "") or 64)
+    return DecodeForward(cfg, tree, dspark=dw, prefetch=PF.enabled(), draft_k=k, **kw)
+
+
+__all__ = ["DecodeForward", "dspark_enabled", "make"]
