+def test_snapshot_carries_the_drafter_context(ck):
+    p = SHORT[1]
+    fw = DF.forward(ck)
+    DF.batcher(ck, fw).ex.slots[0].ensure(200)
+    fw.reset(0)
+    fw.prefill([Piece(0, 0, tuple(p[:-1]))], mode="full")
+    snap = fw.snapshot(0)
+    assert any(k.startswith("dspark_") for k in snap.arrays)
+    want = fw.drafter.propose([0], [p[-1]], [len(p) - 1])
+    fw.window([Rows(0, len(p) - 1, (p[-1], 5, 6))], count=1)
+    fw.commit(0, 2)
+    fw.restore(0, snap)
+    assert fw.drafter.propose([0], [p[-1]], [len(p) - 1]) == want
+    bare = type(snap)(snap.pos, {k: v for k, v in snap.arrays.items() if not k.startswith("dspark_")}, snap.meta)
+    fw.restore(0, bare)                                             # an older entry: the context restarts there
+    assert fw.drafter.valid[0] == snap.pos
