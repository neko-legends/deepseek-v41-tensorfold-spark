+    with open(os.path.join(out, f"prefill-prof-r{rank}.txt"), "w") as f:
+        f.write(f"wall {wall:.3f} s\n")
+        f.write(prof.key_averages().table(sort_by="cuda_time_total", row_limit=60, max_name_column_width=70))
+        f.write("\n\n-- by CPU time --\n")
+        f.write(prof.key_averages(group_by_stack_n=5).table(sort_by="cpu_time_total", row_limit=40,
+                                                           max_name_column_width=70))
