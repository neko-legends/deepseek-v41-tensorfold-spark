+def test_two_ranks_draft_alike(ck):
+    import queue
+    import threading
+
+    class PairLink:
+        def __init__(self):
+            self.q = queue.Queue()
+
+        def send(self, plan):
+            self.q.put(list(plan))
+
+        def recv(self):
+            return self.q.get(timeout=120)
+
+    pair = FK.ThreadPair()
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck, slots=2, rank=r, world=2, comm=comms[r]) for r in range(2)])
+    seen = [[], []]
+    for r, f in enumerate(fws):
+        real = f.draft
+
+        def rec(*a, real=real, r=r, **k):
+            out = real(*a, **k)
+            seen[r].append(out)
+            return out
+
+        f.draft = rec
+    link = PairLink()
+    b0 = DF.batcher(ck, fws[0], n=2, link=link, rank=0)
+    b1 = DF.batcher(ck, fws[1], n=2, link=link, rank=1)
+    t = threading.Thread(target=b1.follow, daemon=True)
+    t.start()
+    jobs = [Job(list(SHORT[0]), 12, None), Job(list(SHORT[1]), 12, SAMPLINGS[1])]
+    got = DF.run(b0, jobs)
+    b0.send_stop()
+    t.join(timeout=120)
+    assert not t.is_alive()
+    assert seen[0] == seen[1] and len(seen[0]) > 0
+    one = DF.run(DF.batcher(ck, DF.forward(ck, slots=2), n=2), [Job(list(SHORT[0]), 12, None),
+                                                               Job(list(SHORT[1]), 12, SAMPLINGS[1])])
