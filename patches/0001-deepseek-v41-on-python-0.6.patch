+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``x3gm`` (TF_DSV41_FAST_EXPERTS=gm) without a GPU: the lane-level emulator of x3gm.cu (``dsv41_x3gm_emu``)
+
+- decodes every value of random 2 / 3 / 4-bit mul1 tiles into the A fragment exactly as ``format.unpack`` (bits);
+- matches the float64 reference of the routed experts (``format.forward``, SwiGLU, combine) for both gate/up
+  configurations, both down configurations, one or two rotated inputs, a 2-pass expert and 1-member experts;
+- stores every output element of every pair exactly once (gate/up's Xd and down's Y);
+- is row independent (a row's bits do not depend on its block-mates) and deterministic under any item order and CTA
+  count (the ticket), with garbage in shared memory between items;
+
+plus the host side: the plan (passes cover every pair once, no host sync), the knobs and tag, the scratch aliasing.
+"""
+
+from __future__ import annotations
+
+import dsv41_x3gm_emu as EMU
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.cuda.exl3 import format as F
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM
+from tensorfold.families.deepseek_v41.cuda import x3gm
+
+
+def _trellis(rng, E, K, N, bits):
+    return rng.integers(-32768, 32768, size=(E, K // 16, N // 16, 16 * bits), dtype=np.int16)
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4])
+def test_decode_a_is_unpack(bits):
+    rng = np.random.default_rng(bits)
+    t16 = _trellis(rng, 1, 64, 64, bits)[0]                            # [4, 4, 16 bits]
+    want = F.unpack(t16, bits, "mul1")
+    words = t16.view(np.uint32)
+    for kt in range(4):
+        for nt in range(4):
+            A = EMU.a_matrix(EMU.decode_a(words[kt, nt], 2 * bits))     # A[m][k] = W[k][m]
+            got = A.T.astype(np.float16)
+            ref = want[kt * 16:kt * 16 + 16, nt * 16:nt * 16 + 16]
+            assert np.array_equal(got.view(np.uint16), ref.view(np.uint16)), (bits, kt, nt)
+
+
+def _layer(seed, E, D, I, bits_gu, bits_d, shx):
+    rng = np.random.default_rng(seed)
+    tg, tu = _trellis(rng, E, D, I, bits_gu), _trellis(rng, E, D, I, bits_gu)
+    td = _trellis(rng, E, I, D, bits_d)
+    sign = lambda *s: np.where(rng.random(s) < 0.5, -1.0, 1.0).astype(np.float16)
+    suh_g = sign(E, D)
+    suh_u = suh_g.copy() if shx else sign(E, D)
+    svh_g = (rng.standard_normal((E, I)) * 0.08).astype(np.float16)
+    svh_u = (rng.standard_normal((E, I)) * 0.08).astype(np.float16)
+    suh_d = sign(E, I)
+    svh_d = (rng.standard_normal((E, D)) * 0.05).astype(np.float16)
+    return tg, tu, td, suh_g, suh_u, svh_g, svh_u, suh_d, svh_d
+
+
+def _picks(seed, R, S, E):
+    """Top-S distinct experts a row, expert 0 in every row (> 64 members: 2 passes), expert E - 1 in one row only."""
+
+    rng = np.random.default_rng(seed)
+    pick = np.zeros((R, S), dtype=np.int64)
+    for r in range(R):
+        rest = rng.permutation(np.arange(1, E - 1))[:S - 1]
+        pick[r] = np.concatenate([[0], rest])
+    pick[R // 2, S - 1] = E - 1
+    wts = (rng.random((R, S)) * 0.6 + 0.2).astype(np.float16).astype(np.float32)
+    return pick, wts
+
+
+def _bf16(a):
+    return torch.from_numpy(a.astype(np.float32)).to(torch.bfloat16).float().numpy()
+
+
+CASES = [  # (bits gate/up, bits down, shx, gu cfg, dn cfg)
+    (3, 3, False, 1, 0),
+    (2, 3, True, 0, 1),
+    (4, 2, False, 0, 1),
+]
+
+
+@pytest.fixture(scope="module", params=CASES, ids=lambda c: f"gu{c[0]}b-dn{c[1]}b-shx{int(c[2])}-cfg{c[3]}{c[4]}")
+def run(request):
+    bgu, bd, shx, cg, cd = request.param
+    E, D, I, R, S, limit = 6, 256, 256, 70, 2, 10.0
+    lay = _layer(7, E, D, I, bgu, bd, shx)
+    tg, tu, td = (t.view(np.uint32) for t in lay[:3])
+    pick, wts = _picks(3, R, S, E)
+    x = _bf16(np.random.default_rng(5).standard_normal((R, D)))
+    out, st_gu, st_dn = EMU.routed(x, pick, wts, tg, tu, td, *lay[3:], limit, shx=shx, gu_cfg=cg, dn_cfg=cd)
+    return {"lay": lay, "tw": (tg, tu, td), "pick": pick, "wts": wts, "x": x, "out": out, "st": (st_gu, st_dn),
+            "shx": shx, "cg": cg, "cd": cd, "limit": limit}
+
+
+def test_matches_float64_reference(run):
+    ref = EMU.reference(run["x"], run["pick"], run["wts"], *run["lay"], run["limit"])
+    err = np.abs(run["out"] - ref).max() / np.abs(ref).max()
+    assert err < 4e-3, err                                   # fp16 rotated inputs / Xd, fp32 chains
+    assert np.abs(ref).max() > 1e-2                          # not a trivially small output
+
+
+def test_every_output_stored_once(run):
+    st_gu, st_dn = run["st"]
+    assert (st_gu == 1).all() and (st_dn == 1).all()
+
+
+def test_row_independent(run):
+    rows = np.r_[3:9, 30:41]                                 # other block-mates: expert 0 drops to one pass
+    sub, _, _ = EMU.routed(run["x"][rows], run["pick"][rows], run["wts"][rows], *run["tw"], *run["lay"][3:],
+                           run["limit"], shx=run["shx"], gu_cfg=run["cg"], dn_cfg=run["cd"])
+    assert np.array_equal(sub.view(np.uint32), run["out"][rows].view(np.uint32))
+
+
+def test_any_item_order_and_cta_count(run):
+    got, _, _ = EMU.routed(run["x"], run["pick"], run["wts"], *run["tw"], *run["lay"][3:], run["limit"],
+                           shx=run["shx"], gu_cfg=run["cg"], dn_cfg=run["cd"], order_seed=11, ctas=3)
+    assert np.array_equal(got.view(np.uint32), run["out"].view(np.uint32))
+
+
+def test_configs_agree_bit_for_bit():
+    """Stage depth / k tiles a stage / column tiles a warp only move data: gu 0 == gu 1, dn 0 == dn 1."""
+
+    E, D, I, R, S = 6, 256, 256, 20, 2
+    lay = _layer(9, E, D, I, 3, 3, False)
+    tw = tuple(t.view(np.uint32) for t in lay[:3])
+    pick, wts = _picks(4, R, S, E)
+    x = _bf16(np.random.default_rng(6).standard_normal((R, D)))
+    a, _, _ = EMU.routed(x, pick, wts, *tw, *lay[3:], 10.0, shx=False, gu_cfg=0, dn_cfg=0)
+    b, _, _ = EMU.routed(x, pick, wts, *tw, *lay[3:], 10.0, shx=False, gu_cfg=1, dn_cfg=1)
+    assert np.array_equal(a.view(np.uint32), b.view(np.uint32))
+
+
+# -- host side ------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("R,S,E", [(2048, 6, 384), (37, 6, 384), (1, 6, 384), (200, 3, 8)])
+def test_plan_covers_every_pair_once(R, S, E):
+    g = torch.Generator().manual_seed(R)
+    pick = torch.stack([torch.randperm(E, generator=g)[:S] for _ in range(R)])
+    if R > 64:
+        pick[:, 0] = 5                                        # a popular expert: several passes
+    order, pe, poff, pcnt, npass = x3gm.plan(pick, E)
+    n = int(npass[0])
+    flat = pick.reshape(-1)
+    seen = torch.zeros(R * S, dtype=torch.int64)
+    for t in range(n):
+        c = int(pcnt[t])
+        assert 1 <= c <= x3gm.BM
+        mem = order[int(poff[t]):int(poff[t]) + c].long()
+        assert (flat[mem] == int(pe[t])).all()
+        assert (mem[1:] > mem[:-1]).all()                    # rows ascending inside a pass
+        seen[mem] += 1
+    assert (seen == 1).all()
+    assert n == int(((torch.bincount(flat, minlength=E) + x3gm.BM - 1) // x3gm.BM).sum())
+    assert pe.numel() >= n and (pcnt[n:] == 0).all()
+
+
+def test_knobs_and_tag(monkeypatch):
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "gm")
+    assert PM.experts_variant() == 2 and PM.tag_grid() == 48
+    monkeypatch.setenv("TF_DSV41_FAST_EXPERTS", "nope")
+    with pytest.raises(ValueError):
+        PM.experts_variant()
+    assert x3gm.config({}) == {"gu": None, "dn": None, "ticket": True, "rows": 2048, "tune": x3gm.TUNE}
+    assert x3gm.config({"TF_DSV41_GM_CFG": "1,1", "TF_DSV41_GM_TICKET": "0"})["ticket"] is False
+    assert x3gm.gu_cfg(x3gm.config({}), True) == 0 and x3gm.gu_cfg(x3gm.config({}), False) == 1
+    assert x3gm.tuned(x3gm.config({}), 2048, 6, 384, True) == (0, 0)       # G6's at 2,048 rows (``tuned``)
+    assert x3gm.tuned(x3gm.config({}), 2048, 6, 384, False) == (1, 0)
+    for bad in ("6,0", "a", "0,5", "x,1"):
+        with pytest.raises(ValueError):
+            x3gm.config({"TF_DSV41_GM_CFG": bad})
+
+
+class _Scratch:                                               # upstream Scratch's buffers at 1,024 rows x 7 slots
+    def __init__(self, rows=1024, slots=7, D=5120, I=1152):
+        P = rows * slots
+        self.xg = torch.zeros((P, D), dtype=torch.float16)
+        self.z = torch.zeros((9216 * P,), dtype=torch.float32)
+
+
+@pytest.mark.parametrize("mats_x", [1, 2])
+def test_buffers_alias_the_shared_scratch(mats_x):
+    s = _Scratch()
+    b = x3gm.Buffers(s, 2048, 2048, 6, 5120, 1152, mats_x, "cpu")
+    assert b.aliased and b.rows == 2048                       # one block a 2,048-row segment, nothing allocated
+    zs, ze = s.z.data_ptr(), s.z.data_ptr() + s.z.numel() * 4
+    for t in (b.x, b.y):
+        assert zs <= t.data_ptr() and t.data_ptr() + t.numel() * t.element_size() <= ze
+    xs = s.xg.data_ptr()
+    assert xs <= b.xd.data_ptr() and b.xd.data_ptr() + b.xd.numel() * 2 <= xs + s.xg.numel() * 2
+    small = x3gm.Buffers(_Scratch(rows=128), 2048, 2048, 6, 5120, 1152, mats_x, "cpu")
+    assert small.aliased and small.rows < 2048
+
+
+def test_supported():
+    class St:
+        def __init__(self, E, K, N, bits, cb="mul1"):
+            self.trellis = torch.zeros((E, K // 16, N // 16, 16 * bits), dtype=torch.int16)
+            self.codebook = cb
+
+    assert x3gm.supported(St(4, 5120, 1152, 3), St(4, 5120, 1152, 3), St(4, 1152, 5120, 3)) is None
+    assert x3gm.supported(St(4, 5120, 1152, 2), St(4, 5120, 1152, 2), St(4, 1152, 5120, 3)) is None
+    assert x3gm.supported(St(4, 5120, 1152, 5), St(4, 5120, 1152, 5), St(4, 1152, 5120, 3)) == "width"
+    assert x3gm.supported(St(4, 5120, 1152, 3, "mcg"), St(4, 5120, 1152, 3), St(4, 1152, 5120, 3)) == "codebook"
+    assert x3gm.supported(St(4, 5120, 1152, 3), St(4, 5120, 1152, 3), St(4, 1152, 4096, 3)) == "shapes"
