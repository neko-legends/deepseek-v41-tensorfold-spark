@@ -0,0 +1,350 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Routed EXL3 experts for fast prefill runs in Triton (``TF_DSV41_FAST_EXPERTS=tc``; ``prefill_moe``; never decode).
+
+Why. Upstream's grouped kernel (the decode path) decodes an expert's trellis again for every 16 member rows and
+splits K into partial sums written to memory: G1 measured 38 us a row a layer at 1,024 rows (~12 TFLOP/s). A
+2,048-row segment gives an expert ~32 member rows; here one program holds up to ``BM`` = 32 of them, so each
+weight tile is decoded once for all of them, K runs whole in registers (no partials), and the epilogues are fused:
+
+    gate/up  program (expert e, member block, 128-column block of the rank's width I): K = D in steps of 128,
+             A = the members' rotated inputs (upstream's ``rot_in``: fp16((x * suh) H / sqrt(128)), per pair),
+             B = the trellis tile decoded in registers (mul1: the 16-bit window's state x 0x83DCD12D, the byte sum
+             + 1024 as fp16, one fp16 fma -- upstream's values bit for bit, ``decode`` and its test),
+             then H / sqrt(128) x svh on the two accumulators, the kit's clamped fp32 SwiGLU, x suh_d, H, fp16:
+             the down projection's rotated input;
+    down     program (expert e, member block, 128-column block of D): K = I, the same B decode, H / sqrt(128) x
+             svh_d x the routed weight -> Y[pair] fp32;
+    combine  out[row] = sum over the row's 6 routed slots in slot order (torch, elementwise).
+
+The Hadamard of an fp32 accumulator is two bf16 tensor-core dots (``exl3.prefill``'s split: top + rest). Inline PTX
+(``dp4a`` byte sum) is used on the GPU when ``ASM`` (the same integers as the Triton form).
+
+Row independence (the fast tag's rule, ``prefill_mm``): BM, the K order and every tile shape are constants, a pair's
+row in its member block only places it, and every reduction is over K in a fixed order; masked rows never mix in.
+New arithmetic against the grouped kernel (full-K sums, the dot's order), hence its own tag value (32).
+
+Memory: the per-pair buffers alias the layer geometry's shared upstream scratch (``moe.scratch_for``): rotated
+inputs in its ``z``, the down input in its ``xg``, Y in its ``y`` in column halves; segments run in row blocks of
+``TF_DSV41_TC_ROWS`` (2,048) so nothing new is allocated at the default sizes.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+BM = 32                               # member rows a program (a constant: rows never depend on the segment)
+BKT = 8                               # k tiles a step (128 = one Hadamard block)
+# the kernels' globals (Triton reads module globals only as constexpr)
+HAD_SCALE = tl.constexpr(0.08838834764831845)
+MUL1 = tl.constexpr(0x83DCD12D)
+A16 = tl.constexpr(0.00676727294921875)          # fp16 0x1EEE
+B16 = tl.constexpr(-10.3828125)                  # fp16 0xC931
+BM_ = tl.constexpr(BM)
+BKT_ = tl.constexpr(BKT)
+TC_ROWS = int(os.environ.get("TF_DSV41_TC_ROWS", "") or 2048)
+
+
+def config() -> tuple[int, int, int]:
+    """``TF_DSV41_TC_CFG`` "kt,stages,warps" (default 2,2,8: sm_121 compiles of both kernels with no spills within
+    99 KiB of shared memory; tests/dsv41_x3tc_ptx.py). k tiles a step only regroup the dot's k16 steps."""
+
+    raw = os.environ.get("TF_DSV41_TC_CFG", "").strip() or "2,2,8"
+    try:
+        kt, st, w = (int(v) for v in raw.split(","))
+    except ValueError:
+        kt = st = w = -1
+    if kt not in (1, 2, 4) or st not in (1, 2, 3) or w not in (4, 8):
+        raise ValueError(f"TF_DSV41_TC_CFG={raw!r}: kt in 1/2/4, stages 1-3, warps 4/8")
+    return kt, st, w
+
+
+@triton.jit
+def _bytesum(x, ASM: tl.constexpr):
+    if ASM:
+        return tl.inline_asm_elementwise("dp4a.u32.u32 $0, $1, 16843009, 0;", "=r,r", [x], dtype=tl.uint32,
+                                         is_pure=True, pack=1)
+    return (x & 255) + ((x >> 8) & 255) + ((x >> 16) & 255) + (x >> 24)
+
+
+@triton.jit
+def _decode(T, kt0, nt0, stride_k, NT_STRIDE: tl.constexpr, BITS: tl.constexpr, BNT: tl.constexpr,
+            ASM: tl.constexpr, KT: tl.constexpr):
+    """W_q[16 kt0 .. + 16 KT, 16 nt0 .. + 16 BNT] fp16 of a mul1 trellis in stored order (tile (kt, nt) at word
+    kt * stride_k + nt * NT_STRIDE, 8 * BITS words a tile): upstream's ``format.unpack`` values."""
+
+    TW: tl.constexpr = 8 * BITS
+    p = tl.arange(0, 256)
+    b = ((p + 1) * BITS - 16 + 256 * BITS) % (256 * BITS)        # the window's first bit in the tile's ring
+    i0 = b >> 5
+    i1 = (i0 + 1) % TW
+    kt = tl.arange(0, KT)
+    nt = tl.arange(0, BNT)
+    base = (kt0 + kt).to(tl.int64)[:, None, None] * stride_k + (nt0 + nt).to(tl.int64)[None, :, None] * NT_STRIDE
+    w0 = tl.load(T + base + i0[None, None, :]).to(tl.uint32, bitcast=True)
+    w1 = tl.load(T + base + i1[None, None, :]).to(tl.uint32, bitcast=True)
+    if ASM:                                     # the window = the top 16 bits of (w0:w1) << (b & 31): one funnel shift
+        sh = tl.broadcast_to((b & 31).to(tl.uint32)[None, None, :], w0.shape)
+        top = tl.inline_asm_elementwise("shf.l.clamp.b32 $0, $1, $2, $3;", "=r,r,r,r", [w1, w0, sh],
+                                        dtype=tl.uint32, is_pure=True, pack=1)
+        x = (top >> 16) * MUL1                  # uint32: the wrapping product
+    else:
+        sh = (48 - (b & 31)).to(tl.uint64)
+        st = (((w0.to(tl.uint64) << 32) | w1.to(tl.uint64)) >> sh[None, None, :]) & 0xFFFF
+        x = ((st * MUL1) & 0xFFFFFFFF).to(tl.uint32)               # the 32-bit wrapping product
+    h = (_bytesum(x, ASM) + 1024).to(tl.float32)
+    v = (h * A16 + B16).to(tl.float16)                             # exact in fp32, one rounding: hfma2's value
+    # stream order p = 32 (c & 7) + 8 ((r >> 1) & 3) + 4 (c >> 3) + 2 (r >> 3) + (r & 1)  ->  [k = 16 kt + r, n]
+    v = tl.reshape(v, (KT, BNT, 8, 4, 2, 2, 2))
+    v = tl.permute(v, (0, 5, 3, 6, 1, 4, 2))
+    return tl.reshape(v, (KT * 16, BNT * 16))
+
+
+@triton.jit
+def _had(acc, H):
+    """acc fp32 [BM_, 128] times the +-1 Hadamard H (bf16 [128, 128]) as two bf16 dots (top + rest), fp32."""
+
+    top = acc.to(tl.bfloat16)
+    rest = (acc - top.to(tl.float32)).to(tl.bfloat16)
+    return tl.dot(rest, H, tl.dot(top, H))
+
+
+@triton.jit
+def _item(ITEM_E, ITEM_M, CNT, OFF, ORDER, pid, E):
+    e = tl.load(ITEM_E + pid)
+    ok_e = e < E
+    e = tl.minimum(e, E - 1)
+    mb = tl.load(ITEM_M + pid)
+    c = tl.load(CNT + e)
+    o = tl.load(OFF + e)
+    m = mb * BM_ + tl.arange(0, BM_)
+    ok = (m < c) & ok_e
+    pair = tl.load(ORDER + o + m, mask=ok, other=0).to(tl.int64)
+    return e, ok_e, ok, pair
+
+
+@triton.jit
+def _gateup(XG, XU, TG, TU, SVG, SVU, SUD, XD, H, ITEM_E, ITEM_M, CNT, OFF, ORDER, E, limit, se_t, sk_t,
+            D: tl.constexpr, I: tl.constexpr, BITS: tl.constexpr, ASM: tl.constexpr, KT: tl.constexpr):
+    pid, nb = tl.program_id(0), tl.program_id(1)
+    e, ok_e, ok, pair = _item(ITEM_E, ITEM_M, CNT, OFF, ORDER, pid, E)
+    if ok_e:
+        kk = tl.arange(0, 128)
+        cols = nb * 128 + kk
+        NT: tl.constexpr = 8 * BITS
+        acc_g = tl.zeros((BM_, 128), dtype=tl.float32)
+        acc_u = tl.zeros((BM_, 128), dtype=tl.float32)
+        tg = TG + e.to(tl.int64) * se_t
+        tu = TU + e.to(tl.int64) * se_t
+        ka = tl.arange(0, 16 * KT)
+        for k0 in range(0, D // 16, KT):
+            xa = pair[:, None] * D + (k0 * 16 + ka)[None, :]
+            ag = tl.load(XG + xa, mask=ok[:, None], other=0.0)
+            au = tl.load(XU + xa, mask=ok[:, None], other=0.0)
+            acc_g = tl.dot(ag, _decode(tg, k0, nb * 8, sk_t, NT, BITS, 8, ASM, KT), acc_g)
+            acc_u = tl.dot(au, _decode(tu, k0, nb * 8, sk_t, NT, BITS, 8, ASM, KT), acc_u)
+        h = tl.load(H + kk[:, None] * 128 + kk[None, :])
+        g = _had(acc_g, h) * HAD_SCALE * tl.load(SVG + e * I + cols).to(tl.float32)[None, :]
+        u = _had(acc_u, h) * HAD_SCALE * tl.load(SVU + e * I + cols).to(tl.float32)[None, :]
+        g = tl.minimum(g, limit)
+        u = tl.minimum(tl.maximum(u, -limit), limit)
+        act = g / (1.0 + tl.exp(-g)) * u
+        v = act * tl.load(SUD + e * I + cols).to(tl.float32)[None, :]
+        xd = (_had(v, h) * HAD_SCALE).to(tl.float16)
+        tl.store(XD + pair[:, None] * I + cols[None, :], xd, mask=ok[:, None])
+
+
+@triton.jit
+def _down(XD, TD, SVD, WTS, Y, H, ITEM_E, ITEM_M, CNT, OFF, ORDER, E, se_t, sk_t, n0, y_stride,
+          D: tl.constexpr, I: tl.constexpr, BITS: tl.constexpr, ASM: tl.constexpr, KT: tl.constexpr):
+    pid, nb = tl.program_id(0), tl.program_id(1)
+    e, ok_e, ok, pair = _item(ITEM_E, ITEM_M, CNT, OFF, ORDER, pid, E)
+    if ok_e:
+        kk = tl.arange(0, 128)
+        cols = n0 + nb * 128 + kk
+        NT: tl.constexpr = 8 * BITS
+        acc = tl.zeros((BM_, 128), dtype=tl.float32)
+        td = TD + e.to(tl.int64) * se_t
+        ka = tl.arange(0, 16 * KT)
+        for k0 in range(0, I // 16, KT):
+            a = tl.load(XD + pair[:, None] * I + (k0 * 16 + ka)[None, :], mask=ok[:, None], other=0.0)
+            acc = tl.dot(a, _decode(td, k0, (n0 // 16) + nb * 8, sk_t, NT, BITS, 8, ASM, KT), acc)
+        h = tl.load(H + kk[:, None] * 128 + kk[None, :])
+        y = _had(acc, h) * HAD_SCALE * tl.load(SVD + e * D + cols).to(tl.float32)[None, :]
+        y = y * tl.load(WTS + pair, mask=ok, other=0.0)[:, None]
+        tl.store(Y + pair[:, None] * y_stride + (nb * 128 + kk)[None, :], y, mask=ok[:, None])
+
+
+@triton.jit
+def _decode_kernel(T, OUT, sk_t, n_tiles, BITS: tl.constexpr, ASM: tl.constexpr):
+    """Tests: W_q of a [128 k, 128 n] block (program (k block, n block)) into OUT [K, N] fp16."""
+
+    kb, nb = tl.program_id(0), tl.program_id(1)
+    w = _decode(T, kb * BKT_, nb * 8, sk_t, 8 * BITS, BITS, 8, ASM, BKT_)
+    r = kb * 128 + tl.arange(0, 128)
+    c = nb * 128 + tl.arange(0, 128)
+    tl.store(OUT + r[:, None] * (n_tiles * 16) + c[None, :], w)
+
+
+# -- host ----------------------------------------------------------------------------------------------------------
+def asm_ok(device) -> bool:
+    """Inline PTX on a GPU (not under Triton's interpreter); ``TF_DSV41_TC_ASM=0`` turns it off (the same bits)."""
+
+    if torch.device(device).type != "cuda" or os.environ.get("TRITON_INTERPRET", "") == "1":
+        return False
+    return (os.environ.get("TF_DSV41_TC_ASM", "1").strip() or "1") != "0"
+
+
+def hadamard(device) -> torch.Tensor:
+    i = torch.arange(128)
+    par = torch.tensor([v.bit_count() & 1 for v in range(128)])[i[:, None] & i[None, :]]
+    return (1.0 - 2.0 * par.float()).to(torch.bfloat16).to(device).contiguous()
+
+
+def words(trellis: torch.Tensor) -> tuple[torch.Tensor, int]:
+    """A stored trellis stack int16 [E, K/16, N/16, 16 bits] as int32 words and its (integer) bits."""
+
+    if trellis.dtype != torch.int16 or trellis.shape[-1] % 16 or not trellis.is_contiguous():
+        raise ValueError("x3tc: contiguous int16 trellis of an integer bit width (mul1)")
+    return trellis.view(torch.int32), trellis.shape[-1] // 16
+
+
+def decode(trellis: torch.Tensor, asm: bool | None = None) -> torch.Tensor:
+    """W_q [K, N] fp16 of one stored trellis [K/16, N/16, 16 bits] through the kernel's decoder (tests)."""
+
+    w, bits = words(trellis.contiguous())
+    kt, nt = trellis.shape[0], trellis.shape[1]
+    out = torch.empty((kt * 16, nt * 16), dtype=torch.float16, device=trellis.device)
+    _decode_kernel[(kt // BKT, nt // 8)](w, out, nt * 8 * bits, nt, BITS=bits,
+                                         ASM=asm_ok(trellis.device) if asm is None else asm)
+    return out
+
+
+def items(pick: torch.Tensor, E: int):
+    """The member lists of a row block's routed pairs: (item_e, item_m, cnt, off, order, items) on the device, no
+    host sync (item i = (expert, member block); items past the last are expert E: the programs exit)."""
+
+    flat = pick.reshape(-1).to(torch.int64)
+    P = flat.numel()
+    order = torch.argsort(flat, stable=True).to(torch.int32)
+    from .x3gm import _counts
+
+    cnt = _counts(flat, E)
+    off = torch.cumsum(cnt, 0) - cnt
+    blk = (cnt + BM - 1) // BM
+    iend = torch.cumsum(blk, 0)
+    n = P // BM + E
+    i = torch.arange(n, device=pick.device)
+    ie = torch.searchsorted(iend, i, right=True)
+    im = i - (iend - blk)[ie.clamp(max=E - 1)]
+    return ie.to(torch.int32), im.to(torch.int32), cnt.to(torch.int32), off.to(torch.int32), order, n
+
+
+def rot_in_torch(x: torch.Tensor, pick: torch.Tensor, suh: torch.Tensor) -> torch.Tensor:
+    """fp16((x[row] * suh[e]) H / sqrt(128)) per pair (row-major pairs): upstream ``rot_in``'s math (CPU tests)."""
+
+    R, S = pick.shape
+    xs = x.float()[:, None, :] * suh[pick.long()].float()                  # [R, S, D]
+    h = hadamard(x.device).float()
+    y = (xs.reshape(R, S, -1, 128) @ h).reshape(R * S, -1) * HAD_SCALE.value
+    return y.to(torch.float16)
+
+
+class Buffers:
+    """Per-pair buffers of a row block: aliased into the shared upstream scratch when it is large enough."""
+
+    def __init__(self, scratch, rows: int, slots: int, D: int, I: int, device) -> None:
+        P = rows * slots
+        need_x = 2 * P * D * 2
+        z = getattr(scratch, "z", None)
+        if z is not None and z.numel() * 4 >= need_x and scratch.xg.numel() * 2 >= P * I * 2:
+            flat = z.view(torch.float16)
+            self.xg, self.xu = flat[:P * D].view(P, D), flat[P * D:2 * P * D].view(P, D)
+            self.xd = scratch.xg.view(-1)[:P * I].view(P, I)
+            ybuf = scratch.y.view(-1)
+        else:
+            self.xg = torch.empty((P, D), dtype=torch.float16, device=device)
+            self.xu = torch.empty((P, D), dtype=torch.float16, device=device)
+            self.xd = torch.empty((P, I), dtype=torch.float16, device=device)
+            ybuf = torch.empty((P * D,), dtype=torch.float32, device=device)
+        self.halves = 1
+        while P * (D // self.halves) > ybuf.numel() or (D // self.halves) % 128:
+            self.halves *= 2
+            if self.halves > D // 128:
+                raise ValueError("x3tc: the scratch cannot hold a column block of Y")
+        self.dh = D // self.halves
+        self.y = ybuf[:P * self.dh].view(P, self.dh)
+
+
+def routed(moe, x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor, limit: float) -> torch.Tensor | None:
+    """This rank's routed experts' partial fp32 [R, D] for a fast prefill run (``prefill_moe``): ``pick`` / ``wts``
+    [R, 6] (routed slots only, the kit's fp16 weights)."""
+
+    m = moe.block.keep[0]
+    if isinstance(m.w1.trellis, list):                  # TF_DSV41_EXPERT_ROTATE: the grouped kernels take it
+        return None
+    return run(x, pick, wts, m.w1, m.w3, m.w2, limit, scratch=moe.scratch)
+
+
+def run(x, pick, wts, gate, up, down, limit: float, *, scratch=None, rows: int | None = None,
+        asm: bool | None = None) -> torch.Tensor:
+    """The routed experts of rows x [R, D] (gate / up / down: ``weights.X3Stack``), in row blocks of ``rows``."""
+
+    R, D = x.shape
+    S = pick.shape[1]
+    E = gate.trellis.shape[0]
+    I = gate.trellis.shape[2] * 16
+    dev = x.device
+    tg, bits = words(gate.trellis)
+    tu, bu = words(up.trellis)
+    td, bd = words(down.trellis)
+    if not bits == bu == bd:
+        raise ValueError("x3tc: gate, up and down of one width")
+    asm = asm_ok(dev) if asm is None else asm
+    kt, stages, warps = config()
+    h = hadamard(dev)
+    rows = int(rows or TC_ROWS)
+    out = torch.empty((R, D), dtype=torch.float32, device=dev)
+    buf = Buffers(scratch, min(rows, R), S, D, I, dev)
+    se_gu, sk_gu = tg.shape[1] * tg.shape[2] * tg.shape[3], tg.shape[2] * tg.shape[3]
+    se_d, sk_d = td.shape[1] * td.shape[2] * td.shape[3], td.shape[2] * td.shape[3]
+    cuda = dev.type == "cuda"
+    for a in range(0, R, rows):
+        b = min(R, a + rows)
+        pk, w = pick[a:b].contiguous(), wts[a:b].contiguous()
+        P = (b - a) * S
+        xg, xu, xd, y = buf.xg[:P], buf.xu[:P], buf.xd[:P], buf.y[:P]
+        if cuda:
+            from tensorfold.cuda.exl3 import experts as x3
+
+            x3._ext().rot_in(x[a:b], x.stride(0), pk, gate.suh, up.suh, xg, xu, b - a, D, S, E)
+        else:
+            xg.copy_(rot_in_torch(x[a:b], pk, gate.suh))
+            xu.copy_(rot_in_torch(x[a:b], pk, up.suh))
+        ie, im, cnt, off, order, n = items(pk, E)
+        _gateup[(n, I // 128)](xg, xu, tg, tu, gate.svh, up.svh, down.suh, xd, h, ie, im, cnt, off, order, E,
+                               float(limit), se_gu, sk_gu, D=D, I=I, BITS=bits, ASM=asm, KT=kt, num_warps=warps,
+                               num_stages=stages)
+        wf = w.reshape(-1).to(torch.float32).contiguous()
+        for half in range(buf.halves):
+            n0 = half * buf.dh
+            _down[(n, buf.dh // 128)](xd, td, down.svh, wf, y, h, ie, im, cnt, off, order, E, se_d, sk_d, n0,
+                                      y.stride(0), D=D, I=I, BITS=bits, ASM=asm, KT=kt, num_warps=warps,
+                                      num_stages=stages)
+            ys = y.view(b - a, S, buf.dh)
+            o = out[a:b, n0:n0 + buf.dh]
+            o.copy_(ys[:, 0])
+            for k in range(1, S):
+                o.add_(ys[:, k])
+    return out
+
+
+def flops(rows: int, topk: int = 6, D: int = 5120, I: int = 1152) -> float:
+    return 2.0 * rows * topk * 3 * D * I
+
+
+__all__ = ["BM", "Buffers", "decode", "flops", "items", "rot_in_torch", "routed", "run", "words"]
diff --git a/src/tensorfold/families/deepseek_v41/cuda/xmap.cpp b/src/tensorfold/families/deepseek_v41/cuda/xmap.cpp
new file mode 100644
index 0000000..49a5f23
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/xmap.cpp
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+//
+// Binding of xmap.cu (G15, TF_DSV41_XMAP): every launch goes on the CURRENT stream (xmap.py switches to its side
+// stream for the prefetch), so CUDA graphs capture them like any kernel.
+
+#include <stdint.h>
+
+#include <stdexcept>
+#include <string>
+
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+#include <torch/extension.h>
+
+namespace dsv41_xmap {
+
+struct Map {
+    const int *ids;
+    const long long *ctr;
+    const int *hdr;
+    int R, S;
+    int smax;
+    int W;
+    long long slot_stride;
+    long long layer_off;
+    int use_prev;
+};
+
+struct Weights {
+    const long long *gate_ptr;
+    const int *gate_k2;
+    int E;
+    int K, N, SK;
+};
+
+cudaError_t launch_prefetch(const Map &m, const Weights &w, uint32_t cap, uint64_t budget, uint32_t chunk,
+                            uint64_t ns_per_piece, cudaStream_t stream);
+cudaError_t launch_record(const int *src, int R, int S, int src_stride, int *ring, const long long *ctr, int W,
+                          long long slot_stride, long long layer_off, int smax, cudaStream_t stream);
+cudaError_t launch_advance(long long *ctr, int *hdr, int W, int R, cudaStream_t stream);
+
+static void check(cudaError_t e, const char *what) {
+    if (e != cudaSuccess) throw std::runtime_error(std::string("xmap: ") + what + ": " + cudaGetErrorString(e));
+}
+
+static void int32_cuda(const torch::Tensor &t, const char *name) {
+    TORCH_CHECK(t.is_cuda() && t.scalar_type() == torch::kInt32, "xmap: ", name, " must be an int32 CUDA tensor");
+}
+
+static void weights_of(Weights &w, const torch::Tensor &gate_ptr, const torch::Tensor &gate_k2, int64_t E, int64_t K,
+                       int64_t N, int64_t SK) {
+    TORCH_CHECK(gate_ptr.is_cuda() && gate_ptr.scalar_type() == torch::kInt64 && gate_ptr.is_contiguous(),
+                "xmap: gate_ptr int64 contiguous CUDA");
+    int32_cuda(gate_k2, "gate_k2");
+    TORCH_CHECK(E >= 1 && E <= gate_ptr.size(0) && gate_k2.size(0) == gate_ptr.size(0), "xmap: E past the table");
+    TORCH_CHECK(K % 16 == 0 && N % 16 == 0 && SK >= 1 && (K / 16) % SK == 0, "xmap: K, N multiples of 16; SK | K/16");
+    w.gate_ptr = reinterpret_cast<const long long *>(gate_ptr.data_ptr<int64_t>());
+    w.gate_k2 = gate_k2.data_ptr<int>();
+    w.E = int(E);
+    w.K = int(K);
+    w.N = int(N);
+    w.SK = int(SK);
+}
+
+static void knobs(int64_t cap, int64_t budget, int64_t chunk, int64_t ns) {
+    if (cap < 0 || budget < 16 || chunk < 16 || chunk % 16 != 0 || chunk > (int64_t(1) << 24) || ns < 0 ||
+        cap > (int64_t(1) << 31))
+        throw std::invalid_argument("xmap: cap >= 0, budget >= 16, chunk a multiple of 16 in [16, 16 MiB], ns >= 0");
+}
+
+// this window's map: ids [R, S] int32 (row stride ids.stride(0))
+void prefetch_now(torch::Tensor ids, torch::Tensor gate_ptr, torch::Tensor gate_k2, int64_t E, int64_t K, int64_t N,
+                  int64_t SK, int64_t cap, int64_t budget, int64_t chunk, int64_t ns_per_piece) {
+    int32_cuda(ids, "ids");
+    TORCH_CHECK(ids.dim() == 2 && ids.stride(1) == 1 && ids.size(0) * ids.size(1) <= 128, "xmap: ids [R, S], R*S <= 128");
+    knobs(cap, budget, chunk, ns_per_piece);
+    Map m{};
+    m.ids = ids.data_ptr<int>();
+    m.R = int(ids.size(0));
+    m.S = int(ids.size(1));
+    m.smax = int(ids.stride(0));
+    m.W = 1;
+    m.use_prev = 0;
+    Weights w{};
+    weights_of(w, gate_ptr, gate_k2, E, K, N, SK);
+    if (m.R == 0) return;
+    check(launch_prefetch(m, w, uint32_t(cap), uint64_t(budget), uint32_t(chunk), uint64_t(ns_per_piece),
+                          c10::cuda::getCurrentCUDAStream().stream()),
+          "prefetch");
+}
+
+// the previous window's map of ``layer`` from the ring [W, layers, rmax, S]
+void prefetch_prev(torch::Tensor ring, torch::Tensor ctr, torch::Tensor hdr, int64_t layer, torch::Tensor gate_ptr,
+                   torch::Tensor gate_k2, int64_t E, int64_t K, int64_t N, int64_t SK, int64_t cap, int64_t budget,
+                   int64_t chunk, int64_t ns_per_piece) {
+    int32_cuda(ring, "ring");
+    int32_cuda(hdr, "hdr");
+    TORCH_CHECK(ring.dim() == 4 && ring.is_contiguous() && ring.size(2) * ring.size(3) <= 128,
+                "xmap: ring [W, layers, rows, S] contiguous, rows*S <= 128");
+    TORCH_CHECK(ctr.is_cuda() && ctr.scalar_type() == torch::kInt64 && ctr.numel() == 1, "xmap: ctr int64 [1]");
+    TORCH_CHECK(hdr.numel() == ring.size(0), "xmap: hdr [W]");
+    TORCH_CHECK(layer >= 0 && layer < ring.size(1), "xmap: layer past the ring");
+    knobs(cap, budget, chunk, ns_per_piece);
+    Map m{};
+    m.ids = ring.data_ptr<int>();
+    m.ctr = reinterpret_cast<const long long *>(ctr.data_ptr<int64_t>());
+    m.hdr = hdr.data_ptr<int>();
+    m.S = int(ring.size(3));
+    m.smax = int(ring.size(3));
+    m.W = int(ring.size(0));
+    m.slot_stride = ring.stride(0);
+    m.layer_off = layer * ring.stride(1);
+    m.use_prev = 1;
+    Weights w{};
+    weights_of(w, gate_ptr, gate_k2, E, K, N, SK);
+    check(launch_prefetch(m, w, uint32_t(cap), uint64_t(budget), uint32_t(chunk), uint64_t(ns_per_piece),
+                          c10::cuda::getCurrentCUDAStream().stream()),
+          "prefetch_prev");
+}
+
+// src [R, S'] int32 (S' <= the ring's S) into ring slot (*ctr % W), layer ``layer``
+void record(torch::Tensor src, torch::Tensor ring, torch::Tensor ctr, int64_t layer) {
+    int32_cuda(src, "src");
+    int32_cuda(ring, "ring");
+    TORCH_CHECK(src.dim() == 2 && src.stride(1) == 1, "xmap: src [R, S] unit-stride rows");
+    TORCH_CHECK(ring.dim() == 4 && ring.is_contiguous(), "xmap: ring [W, layers, rows, S]");
+    TORCH_CHECK(src.size(0) <= ring.size(2) && src.size(1) <= ring.size(3), "xmap: src wider than the ring");
+    TORCH_CHECK(ctr.is_cuda() && ctr.scalar_type() == torch::kInt64 && ctr.numel() == 1, "xmap: ctr int64 [1]");
+    TORCH_CHECK(layer >= 0 && layer < ring.size(1), "xmap: layer past the ring");
+    if (src.size(0) == 0) return;
+    check(launch_record(src.data_ptr<int>(), int(src.size(0)), int(src.size(1)), int(src.stride(0)),
+                        ring.data_ptr<int>(), reinterpret_cast<const long long *>(ctr.data_ptr<int64_t>()),
+                        int(ring.size(0)), ring.stride(0), layer * ring.stride(1), int(ring.size(3)),
+                        c10::cuda::getCurrentCUDAStream().stream()),
+          "record");
+}
+
+void advance(torch::Tensor ctr, torch::Tensor hdr, int64_t rows) {
+    TORCH_CHECK(ctr.is_cuda() && ctr.scalar_type() == torch::kInt64 && ctr.numel() == 1, "xmap: ctr int64 [1]");
+    int32_cuda(hdr, "hdr");
+    check(launch_advance(reinterpret_cast<long long *>(ctr.data_ptr<int64_t>()), hdr.data_ptr<int>(),
+                         int(hdr.numel()), int(rows), c10::cuda::getCurrentCUDAStream().stream()),
+          "advance");
+}
+
+}  // namespace dsv41_xmap
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("prefetch_now", &dsv41_xmap::prefetch_now);
+    m.def("prefetch_prev", &dsv41_xmap::prefetch_prev);
+    m.def("record", &dsv41_xmap::record);
+    m.def("advance", &dsv41_xmap::advance);
+}
diff --git a/src/tensorfold/families/deepseek_v41/cuda/xmap.cu b/src/tensorfold/families/deepseek_v41/cuda/xmap.cu
new file mode 100644
index 0000000..6c1891f
--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/xmap.cu
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+//
+// G15 "expert map" (TF_DSV41_XMAP, xmap.py): prefetch the routed experts a layer is about to read into L2, from a
+// map of expert ids that lives on the device, and record the picks for the routing-trace collector.
+//
+// What x3ld reads first. ld_kernel's grid is (distinct expert u, n block, (mat * SK + split) * MT + mtile) with u
+// fastest and z slowest, so the gate/up launch sweeps z = (gate, split 0), (gate, split 1), ... (up, SK - 1), each
+// z over every distinct expert. Split s of an expert's gate is the trellis rows [s * KT / SK, (s + 1) * KT / SK):
+// one CONTIGUOUS slab of KT / SK * NT * 16 * k2 bytes (540 KiB at 3 bits on a rank: K 5,120, N 1,152, SK 4). So
+// "the first slab of the gate of every expert in the window" is exactly what the launch consumes in its first
+// eighth, and a prefix of each gate trellis is the right thing to have in L2 when it starts. Bytes past that
+// prefix would sit in L2 under ~25+ MB of other traffic before their turn (the 24 MiB L2 would lose them).
+//
+// prefetch_kernel   one CTA: reads a map of ids ([R, S] int32: the router's picks of THIS window, or the same
+//                   layer's picks of the PREVIOUS window from the record ring), drops ids >= E (the shared entry,
+//                   pruned slots), dedups, orders by votes (rows that picked it; ties: first appearance), and issues
+//                   cp.async.bulk.prefetch.L2 of the first min(slab, cap) bytes of each expert's gate trellis, in
+//                   that order, up to ``budget`` bytes; optionally paced (one piece every ns_per_piece).
+// record_kernel     copies [R, S] int32 ids into ring slot (*ctr % W) at row stride smax (the trace / the previous-
+//                   window map).
+// advance_kernel    closes a window: hdr[*ctr % W] = R, then ++*ctr.
+//
+// Exactness: prefetch_kernel only READS (ids, pointer table, widths) and prefetches weight memory into L2: it writes
+// nothing. record_kernel / advance_kernel write only xmap's own ring (never read by a model kernel). The model's
+// kernels run with the same arguments in the same stream order, so every value is unchanged (timing only).
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace dsv41_xmap {
+
+constexpr int MAXP = 128;                              // ids a map at most (16 rows x 7 slots = 112)
+constexpr int THREADS = 128;
+
+__device__ __forceinline__ uint64_t now_ns() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+__device__ __forceinline__ void bulk_prefetch(const void *p, uint32_t bytes) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900)
+    asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" ::"l"(p), "r"(bytes) : "memory");
+#else
+    for (uint32_t o = 0; o < bytes; o += 128) asm volatile("prefetch.global.L2 [%0];" ::"l"((const char *)p + o));
+#endif
+}
+
+__device__ __forceinline__ void wait_until(uint64_t due) {
+    while (true) {
+        const uint64_t t = now_ns();
+        if (t >= due) return;
+        const uint64_t left = due - t;
+        __nanosleep(static_cast<unsigned>(left > 2000u ? 1000u : (left > 64u ? left / 2u : 32u)));
+    }
+}
+
+struct Map {
+    const int *ids;            // this window's ids [R, S] (use_prev 0) or the ring base (use_prev 1)
+    const long long *ctr;      // the ring's window counter (use_prev 1)
+    const int *hdr;            // rows a ring slot (use_prev 1)
+    int R, S;                  // rows, ids a row (use_prev 0: R; 1: the slot's header)
+    int smax;                  // row stride in ints of the source
+    int W;                     // ring slots
+    long long slot_stride;     // ints a ring slot
+    long long layer_off;       // ints from a slot's start to this layer's rows
+    int use_prev;
+};
+
+struct Weights {
+    const long long *gate_ptr; // int64 [E + shared]: each entry's gate trellis
+    const int *gate_k2;        // int32 [E + shared]: half-bits a value
+    int E;                     // routed experts: ids >= E are skipped (the shared entry, pruned slots)
+    int K, N, SK;              // gate/up launch's K (dims), N (the rank's width), K splits
+};
+
+// The selection (xmap.py ``select_host`` mirrors it): (expert id, prefix bytes) in issue order, the count returned.
+__device__ int select_ids(const Map &m, const Weights &w, uint32_t cap, uint64_t budget, int *out_e, uint32_t *out_b,
+                          int *ids_sh, int *votes_sh, int *rank_sh) {
+    const int t = threadIdx.x;
+    __shared__ int src_R;
+    __shared__ const int *src_p;
+    if (t == 0) {
+        src_R = 0;
+        src_p = nullptr;
+        if (!m.use_prev) {
+            src_R = m.R;
+            src_p = m.ids;
+        } else {
+            const long long c = *m.ctr;
+            if (c > 0) {
+                const long long slot = (c - 1) % m.W;
+                src_R = m.hdr[slot];
+                src_p = m.ids + slot * m.slot_stride + m.layer_off;
+            }
+        }
+    }
+    __syncthreads();
+    const int R = src_R;
+    const int P = R * m.S;
+    if (P <= 0 || P > MAXP) return 0;
+    if (t < P) {
+        const int v = __ldcg(src_p + (t / m.S) * m.smax + (t % m.S));
+        ids_sh[t] = (v >= 0 && v < w.E) ? v : -1;
+    }
+    __syncthreads();
+    int first = 0, votes = 0;
+    const int me = t < P ? ids_sh[t] : -1;
+    if (me >= 0) {
+        first = 1;
+        for (int u = 0; u < P; u++) {
+            const int o = ids_sh[u];
+            if (o == me) {
+                votes++;
+                if (u < t) first = 0;
+            }
+        }
+    }
+    if (t < MAXP) votes_sh[t] = first ? votes : 0;      // 0 = not a distinct entry
+    __syncthreads();
+    if (first) {                                         // rank among the distinct: votes desc, then position asc
+        int r = 0;
+        for (int u = 0; u < P; u++) {
+            const int vu = votes_sh[u];
+            if (vu > votes || (vu == votes && vu > 0 && u < t)) r++;
+        }
+        rank_sh[r] = t;
+    }
+    __syncthreads();
+    __shared__ int n_sel;
+    if (t == 0) {
+        int n = 0, distinct = 0;
+        uint64_t used = 0;
+        const uint64_t KT = (uint64_t)w.K >> 4, NT = (uint64_t)w.N >> 4;
+        for (int q = 0; q < P; q++) distinct += votes_sh[q] > 0;     // rank slots >= distinct were never written
+        for (int r = 0; r < distinct && used < budget; r++) {
+            const int e = ids_sh[rank_sh[r]];
+            const uint64_t slab = KT / (uint64_t)w.SK * NT * 16u * (uint64_t)w.gate_k2[e];
+            uint64_t take = slab;
+            if (cap > 0 && take > cap) take = cap;
+            if (take > budget - used) take = budget - used;
+            take &= ~uint64_t(15);
+            if (take == 0) break;
+            out_e[n] = e;
+            out_b[n] = static_cast<uint32_t>(take);
+            used += take;
+            n++;
+        }
+        n_sel = n;
+    }
+    __syncthreads();
+    return n_sel;
+}
+
+__global__ void __launch_bounds__(THREADS) prefetch_kernel(Map m, Weights w, uint32_t cap, uint64_t budget,
+                                                            uint32_t chunk, uint64_t ns_per_piece) {
+    __shared__ int ids_sh[MAXP], votes_sh[MAXP], rank_sh[MAXP], sel_e[MAXP];
+    __shared__ uint32_t sel_b[MAXP];
+    const int n = select_ids(m, w, cap, budget, sel_e, sel_b, ids_sh, votes_sh, rank_sh);
+    if (n == 0) return;
+    const uint64_t t0 = now_ns();
+    // pieces in issue order: expert 0's pieces, then expert 1's...; thread t takes pieces t, t + THREADS, ...
+    uint32_t k = 0;
+    for (int i = 0; i < n; i++) {
+        const uint8_t *base = reinterpret_cast<const uint8_t *>(static_cast<uintptr_t>(w.gate_ptr[sel_e[i]]));
+        const uint32_t bytes = sel_b[i];
+        for (uint32_t off = 0; off < bytes; off += chunk, k++) {
+            if (k % THREADS != (uint32_t)threadIdx.x) continue;
+            if (ns_per_piece) wait_until(t0 + (uint64_t)k * ns_per_piece);
+            const uint32_t left = bytes - off;
+            bulk_prefetch(base + off, left < chunk ? left : chunk);
+        }
+    }
+}
+
+__global__ void __launch_bounds__(THREADS) record_kernel(const int *__restrict__ src, int R, int S, int src_stride,
+                                                          int *__restrict__ ring, const long long *__restrict__ ctr,
+                                                          int W, long long slot_stride, long long layer_off,
+                                                          int smax) {
+    const long long slot = *ctr % W;
+    int *dst = ring + slot * slot_stride + layer_off;
+    for (int t = threadIdx.x; t < R * S; t += blockDim.x) {
+        const int r = t / S, s = t % S;
+        dst[r * smax + s] = src[r * src_stride + s];
+    }
+}
+
+__global__ void advance_kernel(long long *ctr, int *hdr, int W, int R) {
+    if (threadIdx.x == 0) {
+        const long long c = *ctr;
+        hdr[c % W] = R;
+        *ctr = c + 1;
+    }
+}
+
+cudaError_t launch_prefetch(const Map &m, const Weights &w, uint32_t cap, uint64_t budget, uint32_t chunk,
+                            uint64_t ns_per_piece, cudaStream_t stream) {
+    prefetch_kernel<<<1, THREADS, 0, stream>>>(m, w, cap, budget, chunk, ns_per_piece);
+    return cudaGetLastError();
+}
+
+cudaError_t launch_record(const int *src, int R, int S, int src_stride, int *ring, const long long *ctr, int W,
+                          long long slot_stride, long long layer_off, int smax, cudaStream_t stream) {
+    record_kernel<<<1, THREADS, 0, stream>>>(src, R, S, src_stride, ring, ctr, W, slot_stride, layer_off, smax);
+    return cudaGetLastError();
+}
+
+cudaError_t launch_advance(long long *ctr, int *hdr, int W, int R, cudaStream_t stream) {
+    advance_kernel<<<1, 32, 0, stream>>>(ctr, hdr, W, R);
+    return cudaGetLastError();
+}
+
+}  // namespace dsv41_xmap
