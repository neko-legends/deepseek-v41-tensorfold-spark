+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The draft head's int4 GEMV (families/deepseek_v41/cuda/draft_head.py ``_q4``) in Triton's CPU interpreter: equal
+to the dequantized fp32 product to fp32 rounding at 1-20 rows, groups of 128 and 64, ragged output blocks; a row's
+logits do not depend on the other rows of its block (graph replay == eager needs only determinism, but drafts of a
+slot should not move with the pass's other slots).
+
+Run: python -m pytest -q tests/test_dsv41_draft_head_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import draft_head as DH
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+
+def _copy(k, n, seed):
+    g = torch.Generator().manual_seed(seed)
+    w = torch.randn(k, n, generator=g) * 0.03
+    lin = lambda x, dtype: (x.float() @ w).to(dtype)
+    group = DH.group_of(k)
+    packed, scales = DH.probe(lin, k, None, "cpu", group)
+    return packed, scales, group, g
+
+
+@pytest.mark.parametrize("k,n", [(512, 200), (128, 70)])
+@pytest.mark.parametrize("m", [1, 5, 20])
+def test_q4_kernel_equals_dequant(k, n, m):
+    packed, scales, group, g = _copy(k, n, k + n + m)
+    x = torch.randn(m, k, generator=g).to(torch.bfloat16)
+    want = x.float() @ DH.dequant(packed, scales, group).t()
+    got = DH.q4_matmul(x, packed, scales, group, kernel=True)
+    assert got.shape == (m, n) and got.dtype == torch.float32
+    assert torch.allclose(got, want, rtol=1e-5, atol=1e-5)
+
+
+def test_q4_rows_independent():
+    packed, scales, group, g = _copy(256, 96, 5)
+    x = torch.randn(10, 256, generator=g).to(torch.bfloat16)
+    full = DH.q4_matmul(x, packed, scales, group, kernel=True)
+    for r in (0, 3, 9):
+        assert torch.equal(DH.q4_matmul(x[r:r + 1], packed, scales, group, kernel=True)[0], full[r])
