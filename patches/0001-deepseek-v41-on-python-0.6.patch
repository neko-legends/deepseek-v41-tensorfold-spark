+    got = tower.align(tower.vit(patches, vh, vw), vh, vw)
+    assert got.shape == want.shape == (-(-vh // 3) * -(-vw // 3), 128)
+    assert torch.allclose(got, want, atol=1e-5, rtol=1e-5)
