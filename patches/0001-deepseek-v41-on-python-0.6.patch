+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Window G1 checks of the mHC / Engram / DSpark / streaming top-k kernels on the GPU (collected only where PyTorch
+sees an NVIDIA GPU). The CPU interpreter tests model the GPU (FMA chains of the ieee dots, nearest-even casts); these
+prove it on sm_121:
+
+- mHC: the boundary's streams, collapse, taps, partials and normed input == the torch emulation (tests/dsv41_kref.py)
+  bit for bit at D = 5,120 (world 1 / 2); coefficients within 1e-5; a row alone == in a window of 19 (every output);
+- Engram: dequant == the reference bit for bit (every e4m3 byte, zero / subnormal-product / huge scales: no flush to
+  zero); the fusion's update == bf16(x + gate v) bit for bit given its gates, gates within 1e-6; row invariance;
+- streaming top-k: == ``index.select`` / ``reindex`` / ``candidate_blocks`` on GPU scores up to 64K keys (the shared
+  tile gives the same bits in both kernels), with the time of each path at 64K printed;
+- DSpark chain: drafts == ``exact_sampling.choose`` on the host over 64 seeds x 5 positions (libdevice vs glibc log
+  may differ at a near-tie only: at most one mismatch allowed, printed), slot alone == in a batch;
+- x3pf (``expert_prefill``): Z == upstream's grouped_kernel bit for bit on random mul1 experts of the real geometry
+  (5,120 <-> 1,152 a rank, widths 2 / 3 / 4 bit) at 16-2,048 rows, both settings, and its time against upstream's.
+
+Run: python -m pytest -q -s tests/cuda/test_dsv41_blockers_gpu.py (one GPU, ~1-2 min).
+"""
+
+from __future__ import annotations
+
+import time
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+import dsv41_kref as KR
+
+from tensorfold.families.deepseek_v41.cuda import dspark, engram, mhc
+from tensorfold.families.deepseek_v41.cuda.csa2 import index
+from tensorfold.families.deepseek_v41.cuda.csa2 import stream_topk as ST
+
+DEV = "cuda"
+
+
+def _bits(t):
+    return t.contiguous().view(-1).view(torch.uint8).cpu()
+
+
+# -- mHC -----------------------------------------------------------------------------------------------------------
+def _mhc_case(R: int, d: int, world: int, seed: int):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn((R, 4 * d), generator=g).to(torch.bfloat16)
+    gathered = torch.randn((world, R, d), generator=g) * 0.7
+    comb = torch.rand((R, 4, 4), generator=g)
+    comb = (comb / comb.sum(1, keepdim=True)).reshape(R, 16).contiguous()
+    pre, post = torch.rand((R, 4), generator=g) + 0.1, torch.rand((R, 4), generator=g) * 2
+    hc = (torch.randn((24, 4 * d), generator=g) * 0.01, torch.randn(24, generator=g) * 0.5,
+          torch.rand(3, generator=g) + 0.5)
+    nw = (torch.rand(d, generator=g) + 0.5).to(torch.bfloat16)
+    return x, gathered, pre, post, comb, hc, nw
+
+
+def _mhc_run(x, gathered, pre, post, comb, hc, nw):
+    R, d = gathered.shape[1], gathered.shape[2]
+    prev = mhc.Coefs(R, DEV, pre=pre.to(DEV), post=post.to(DEV), comb=comb.to(DEV))
