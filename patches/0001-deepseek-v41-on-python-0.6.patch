+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``blocks.attention``'s fused projection wiring (TF_DSV41_FUSED_PROJ) on the CPU twin: groups whose launches are
+stood in by the twin's own linears (each output buffer = its segments' outputs side by side, as x3seg writes them)
+give the forward's logits bit for bit, over every layer kind (SWA, ratio-2 kv source with the compressor in the x
+launch, reuse, ratio-1 candidate source, reindex) and windows of 1-16 rows; TF_DSV41_FUSED_PROJ=0 and fast prefill
+runs take the unfused calls; ``build`` / ``why_not`` refuse what x3seg cannot run. The kernels' bits are
+``test_dsv41_fused_proj_emu.py``'s (emulator) and tests/cuda/test_dsv41_fused_proj_gpu.py's (GPU)."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import fused_proj as FP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import prefill_mm as PM  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+IDS = torch.randint(0, 256, (29,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+class StandIn:
+    """``fused_proj.Fused``'s contract over the twin's linears: one buffer an output id, segments side by side."""
+
+    calls = 0
+
+    def __init__(self, lins: list, outs: list[int] | None = None) -> None:
+        self.lins = lins
+        self.segs = lins
+        self.outs = list(range(len(lins))) if outs is None else list(outs)
+
+    def __call__(self, xs, dtype):
+        StandIn.calls += 1
+        xs = [xs] * len(self.lins) if isinstance(xs, torch.Tensor) else list(xs)
+        parts: dict[int, list] = {}
+        for lin, x, o in zip(self.lins, xs, self.outs):
+            parts.setdefault(o, []).append(lin(x, dtype))
+        return [torch.cat(parts[o], 1) for o in sorted(parts)]
+
+
+def stand_in_groups(blk) -> FP.Groups:
+    a = blk.attn
+    comp = [a.comp_wkv] + ([a.comp_wgate] if a.comp_wgate is not None else []) if a.comp_wkv is not None else []
+    return FP.Groups(x2=StandIn([a.wq_a, a.wkv]),
+                     x4=StandIn([a.wq_a, a.wkv] + comp, [0, 1] + [2] * len(comp)) if comp else None,
+                     q=StandIn([a.wq_b, a.ix_wq_b]) if a.ix_wq_b is not None else None,
+                     o=StandIn(list(a.wo_a), [0] * len(a.wo_a)))
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41fp"))
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build(ckpt, fused: bool) -> FW.Forward:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    fw = FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=None, limit=96, chunk=16,
+                    engram_rows={L: EH.MemoryRows(r, s) for L, (r, s) in table.items()},
+                    hasher=EH.NgramHasher(cfg, tmap))
+    for blk in fw.blocks:
+        assert blk.fused is None                        # the CPU twin never builds x3seg groups
+        if fused:
+            blk.fused = stand_in_groups(blk)
+    return fw
+
+
+def run(fw, windows) -> torch.Tensor:
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(IDS[a:a + n]))
+        a += n
+    return torch.cat(out)
+
+
+@pytest.mark.parametrize("windows", [[1] * 29, [8, 8, 8, 5], [16, 13]])
+def test_fused_wiring_equals_unfused(ckpt, windows, monkeypatch):
+    monkeypatch.setenv(FP.ENV, "1")
+    want = run(build(ckpt, False), windows)
+    StandIn.calls = 0
+    got = run(build(ckpt, True), windows)
+    assert StandIn.calls > 0
+    assert torch.equal(got, want)
+
+
+def test_switch_off_and_fast_prefill_take_the_unfused_calls(ckpt, monkeypatch):
+    fw = build(ckpt, True)
+    monkeypatch.setenv(FP.ENV, "0")
+    assert FP.active(fw.blocks[0]) is None
+    monkeypatch.setenv(FP.ENV, "1")
+    assert FP.active(fw.blocks[0]) is fw.blocks[0].fused
+    with PM.fast():
+        assert FP.active(fw.blocks[0]) is None
+    monkeypatch.setenv(FP.ENV, "2")
+    with pytest.raises(ValueError):
+        FP.enabled()
+
+
+def _lin(**kw):
+    base = {"words": torch.zeros(1), "layout": "strips", "bias": None, "codebook": "mul1", "k2": 10, "split": (8, 4),
+            "k": 5120, "n": 1280}
+    base.update(kw)
+    return SimpleNamespace(**base)
+
+
+def test_why_not_and_lin_of():
+    assert FP.why_not(_lin()) is None
+    assert FP.why_not(None) is not None
+    assert FP.why_not(_lin(bias=torch.zeros(4))) == "layout / bias"
+    assert FP.why_not(_lin(layout="stored")) == "layout / bias"
+    assert FP.why_not(_lin(codebook="3inst")) == "codebook / width"
+    assert FP.why_not(_lin(k2=7)) == "codebook / width"
+    assert FP.why_not(_lin(split=(3, 4))) == "plan"
+    inner = SimpleNamespace(lin=_lin())
+    assert FP.lin_of(inner) is inner.lin and FP.lin_of(SimpleNamespace(inner=inner)) is inner.lin
+    assert FP.lin_of(SimpleNamespace(w=torch.zeros(2))) is None            # linear.Dense: the CPU twin
+
+
+def test_plan_spec():
+    assert FP.plan_spec({}) is None and FP.plan_spec({FP.PLAN_ENV: "upstream"}) is None
+    assert FP.plan_spec({FP.PLAN_ENV: "long"}) == FP.PLANS["long"]
+    assert FP.plan_spec({FP.PLAN_ENV: "x:2, wob:4/8"}) == {"x": (2, 4), "wob": (4, 8)}
+    for bad in ("x:0", "y:4", "x:4/2", "x:4,x:2", "long2", "x"):
+        with pytest.raises(ValueError):
+            FP.plan_spec({FP.PLAN_ENV: bad})
+
+
+def test_apply_plan_sets_every_attention_linear():
+    def lin(k, n):
+        return SimpleNamespace(lin=_lin(k=k, n=n, split=(8, 4)))
+
+    a = SimpleNamespace(wq_a=lin(5120, 1280), wkv=lin(5120, 512), comp_wkv=lin(5120, 512), comp_wgate=None,
+                        wq_b=SimpleNamespace(inner=lin(1280, 16384)), ix_wq_b=lin(1280, 4096),
+                        wo_a=[lin(4096, 1024) for _ in range(4)], wo_b=lin(4096, 5120))
+    FP.apply_plan(a, None)
+    assert a.wq_a.lin.split == (8, 4)
+    FP.apply_plan(a, FP.PLANS["long"])
+    assert {a.wq_a.lin.split, a.wkv.lin.split, a.comp_wkv.lin.split} == {(4, 4)}
+    assert a.wq_b.inner.lin.split == (1, 4) and a.ix_wq_b.lin.split == (1, 4)
+    assert {w.lin.split for w in a.wo_a} == {(2, 4)} and a.wo_b.lin.split == (2, 4)
+    with pytest.raises(ValueError):
+        FP.apply_plan(a, {"q": (3, 4)})                     # 80 k tiles do not split into 3 x 4 warps
