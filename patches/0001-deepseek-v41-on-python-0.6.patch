+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The joint DSpark depth of a shared verify window (``joint.py``, ``depth.Depth.choose_joint``,
+TF_DSV41_DEPTH_JOINT) and the calibration by total rows (``calib.py``):
+
+- ``joint.allocate`` == brute force over every allocation (random small cases, convex and bucket-stepped costs,
+  shared rows, the window's row cap, slots that draft nothing);
+- determinism: two policies fed the same inputs in the same order choose the same depths round after round (both
+  ranks), and no call depends on anything but its arguments and the commits;
+- the policy: a lone window keeps ``choose`` (zero depth there only), a shared window verifies every slot's first
+  draft, prices rows at the shared window's marginal cost and the aggregate rate, joint off == per slot;
+- calibration: the table by total rows to 64 (wide buckets on several slots, interpolated, the slot overhead apart),
+  ``Costs.slot`` through encode / cache, the cache key's version; ``measure`` on the CPU twin with 4 slots;
+- drafted == serial with the joint depth at 2 and 4 slots (T = 0 and T > 0), joint on == joint off replies.
+"""
+
+from __future__ import annotations
+
+import itertools
+import random
+
+import pytest
+
+from tensorfold.families.deepseek_v41.cuda import calib, depth
+from tensorfold.families.deepseek_v41.cuda import joint as J
+
+
+def _linear(first: float, second: float, row: float, n: int = 64) -> list[float]:
+    return [first] + [second + row * (r - 1) for r in range(1, n)]
+
+
+def _stepped(n: int = 64) -> list[float]:
+    """Row-graph padding: a window costs its bucket's rows (1-8, 12, 16, 24, 32, 48, 64)."""
+
+    from tensorfold.families.deepseek_v41.cuda.rowtab import BUCKETS
+
+    base = _linear(30.0, 37.0, 4.0, n)
+    return [base[min(b for b in BUCKETS if b >= r) - 1] for r in range(1, n + 1)]
+
+
+def _brute(qs, lo, top, shared, rows_ms, rate, max_rows):
+    best = float("-inf")
+    for ks in itertools.product(*[range(lo[s], max(lo[s], top[s]) + 1) for s in range(len(qs))]):
+        rows = shared + sum(1 + k for k in ks)
+        if rows > max_rows and any(k > lo[s] for s, k in enumerate(ks)):
+            continue
+        best = max(best, J.objective(qs, ks, lo, shared=shared, rows_ms=rows_ms, rate=rate))
+    return best
+
+
+@pytest.mark.parametrize("table", ["linear", "stepped", "bumpy"])
+def test_allocate_equals_brute_force(table):
+    rng = random.Random(7)
+    for case in range(300):
+        n = rng.randint(1, 4)
+        if table == "linear":
+            c = depth.Costs(_linear(31.2, 38.0, 4.25), 3.9)
+        elif table == "stepped":
+            c = depth.Costs(_stepped(), 3.9)
+        else:                                               # not convex: a cheap row after a dear one
+            c = depth.Costs([30.0 + 4.0 * r + (3.0 if r % 3 == 1 else 0.0) for r in range(64)], 3.9)
+        qs = [[rng.choice([rng.random(), 0.9 + 0.09 * rng.random(), 0.0]) for _ in range(5)] for _ in range(n)]
+        top = [rng.randint(0, 5) for _ in range(n)]
+        lo = [1 if t > 0 else 0 for t in top]
+        shared = rng.choice([0, 0, 1, 3, 9])
+        rate = rng.choice([0.02, 0.05, 0.07, 0.12])
+        cap = rng.choice([64, 64, 8, 12])
+        ks, val = J.allocate(qs, lo, top, shared=shared, rows_ms=c.rows_ms, rate=rate, max_rows=cap)
+        assert all(lo[s] <= ks[s] <= max(lo[s], top[s]) for s in range(n)), (case, ks)
+        assert shared + sum(1 + k for k in ks) <= max(cap, shared + sum(1 + v for v in lo))
+        assert J.objective(qs, ks, lo, shared=shared, rows_ms=c.rows_ms, rate=rate) == pytest.approx(val, abs=1e-9)
+        assert val == pytest.approx(_brute(qs, lo, top, shared, c.rows_ms, rate, cap), abs=1e-9), case
+
+
+def test_allocate_ties_and_order_are_total():
+    c = depth.Costs(_linear(30.0, 37.0, 4.0), 4.0)
+    qs = [[0.9, 0.8, 0.5], [0.9, 0.8, 0.5]]                 # equal slots: the earlier slot gets the odd row
+    ks, _ = J.allocate(qs, [1, 1], [3, 3], shared=0, rows_ms=c.rows_ms, rate=0.1)
+    assert ks == J.allocate(qs, [1, 1], [3, 3], shared=0, rows_ms=c.rows_ms, rate=0.1)[0]
+    assert ks[0] >= ks[1] and ks[0] - ks[1] <= 1
+    assert J.allocate([[0.99] * 5], [1], [5], shared=0, rows_ms=lambda r: 0.0, rate=1.0)[0] == [5]
+    assert J.allocate([[0.99] * 5], [1], [5], shared=60, rows_ms=lambda r: 0.0, rate=1.0, max_rows=64)[0] == [3]
+    assert J.allocate([[0.99] * 5], [1], [5], shared=0, rows_ms=lambda r: 1e3 * r, rate=1.0)[0] == [1]
+
+
+def _drive(d: depth.Depth, seed: int, rounds: int = 60) -> list[list[int]]:
+    rng = random.Random(seed)
+    out = []
+    for r in range(rounds):
+        n = 1 + r % 4
+        slots = list(range(n))
+        confs = [[rng.random() ** 0.3 for _ in range(5)] for _ in slots]
+        others = [1 + rng.randint(0, 6)] if r % 5 == 0 else []
+        ks = d.choose_joint(slots, confs, [5] * n, others=others, firsts=[11] * n)
+        out.append(ks)
+        for s, k in zip(slots, ks):
+            keep = 1 + sum(1 for _ in itertools.takewhile(lambda c: rng.random() < c, confs[s][:k]))
+            d.record(s, k + 1, keep)
+            d.bonus(s, 11 if rng.random() < 0.5 else 12)
+    return out
+
+
+def test_joint_is_deterministic_like_two_ranks():
+    a = depth.Depth(depth.Costs(_stepped(), 3.9, slot=6.0), block=5, mode="cost", cap=5, joint=True)
+    b = depth.Depth(depth.Costs(_stepped(), 3.9, slot=6.0), block=5, mode="cost", cap=5, joint=True)
+    ra, rb = _drive(a, 3), _drive(b, 3)
+    assert ra == rb and a.cal.kept == b.cal.kept and a.stats.report() == b.stats.report()
+    assert {n: list(v) for n, v in a._agg.items()} == {n: list(v) for n, v in b._agg.items()}
+    assert a.stats.joint[0] > 0 and len(a._agg) >= 2         # rates kept per number of windows
+    assert _drive(depth.Depth(depth.Costs(_stepped(), 3.9, slot=6.0), block=5, mode="cost", cap=5, joint=True),
+                  3) == ra
+
+
+def test_lone_window_keeps_choose_and_zero_depth():
+    c = depth.Costs([35.5, 43.5, 47.6, 51.6, 55.7, 59.7], 4.7)
+    d = depth.Depth(c, block=5, mode="cost", cap=5, skip=True, joint=True)
+    low = [0.08, 0.3, 0.3, 0.3, 0.3]
+    assert d.choose_joint([0], [low], [5], firsts=[17]) == [0]              # alone: zero depth as before
+    assert d.choose_joint([0], [low], [5], firsts=[17], alone=False) == [1]     # the caller says shared
+    assert d.choose_joint([0], [low], [5], others=[1], firsts=[17]) == [1]  # a plain row shares it: verified
+    assert d.choose_joint([0, 1], [low, low], [5, 5], firsts=[17, 17]) == [1, 1]
+    assert d.choose_joint([0, 1], [low, [0.9] * 5], [5, 0], firsts=[17, 17]) == [1, 0]     # most 0: nothing
+    s = depth.Depth(c, block=5, mode="static", cap=3, joint=True)
+    assert s.choose_joint([0, 1], [low, low], [5, 2]) == [3, 2]
+
+
+def test_shared_rows_are_priced_at_the_shared_margin():
+    """G8's measured table: alone, a 0.3 second draft does not pay its row (rate x 4 ms); in a window of 9+ rows a
+    row costs the 9-16 line's ~2.6 ms, so the same draft joins at the same rate. Joint off: each slot alone."""
+
+    v = calib.extend(calib.fit([31.2, 38.0, 42.2, 46.5, 50.7, 55.0, 59.2, 63.5, 66.1, 68.7, 71.4, 74.0, 76.6,
+                                79.2, 81.9, 84.5]), {24: 105.0, 32: 125.0, 48: 165.0, 64: 205.0})
+    c = depth.Costs(v, 3.9)
+    conf = [[0.99, 0.99, 0.99, 0.99, 0.99], [0.95, 0.3, 0.2, 0.1, 0.1]]
+    on = depth.Depth(c, block=5, mode="cost", cap=5, joint=True)
+    off = depth.Depth(c, block=5, mode="cost", cap=5, joint=False)
+    for d in (on, off):
+        for s in (0, 1):
+            d.slots[s] = depth._Slot()
+            d.slots[s].rounds.extend([(4, 50.0)] * 4)           # 0.08 tokens a ms each
+        d._agg[2] = depth.deque([(8, 100.0)] * 4, maxlen=16)
+    ks_off = off.choose_joint([0, 1], conf, [5, 5])
+    assert ks_off == [off.choose(0, conf[0], 5), off.choose(1, conf[1], 5)]
+    assert ks_off == [5, 1]                                     # 0.285 < 0.08 x 4.2 ms
+    assert on.choose_joint([0, 1], conf, [5, 5]) == [5, 2]      # 0.285 > 0.08 x ~2.6 ms (the 9th row)
+
+
+def test_costs_rows_ms_slot_and_cache(tmp_path, monkeypatch):
+    c = depth.Costs([30.0 + 4 * r for r in range(16)], 4.0, "measured", 6.5)
+    assert c.rows_ms(16) == c.verify[15] and c.rows_ms(20) == pytest.approx(c.verify[15] + 16.0)
+    assert c.window_ms(99) == c.verify[-1] and c.rows_ms(0) == c.verify[0]
+    back = depth.Costs.decode(c.encode())
+    assert back.slot == pytest.approx(6.5) and back.verify == pytest.approx(c.verify) and back.draft == 4.0
+    assert c.monotone().slot == 6.5
+    monkeypatch.setenv("TF_DSV41_CALIB_DIR", str(tmp_path))
+    k = calib.cache_key("img", {"slots": 4})
+    calib.save(k, c, {})
+    assert calib.load(k).slot == 6.5
+    monkeypatch.setattr(calib, "VERSION", calib.VERSION + 1)
+    assert calib.cache_key("img", {"slots": 4}) != k          # a new table layout: measured again
+
