+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    table = FK.engram_table(cfg)
+    ids = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(4)).tolist()
+    calls = []
+    real = attn_pf.attention
+
+    def spy(q, *a, **kw):
+        calls.append(q.shape[0])
+        return real(q, *a, **kw)
+
+    monkeypatch.setattr(attn_pf, "attention", spy)
