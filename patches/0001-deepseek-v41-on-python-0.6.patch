@@ -0,0 +1,408 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Horizontal fusion of the attention's EXL3 projections (``TF_DSV41_FUSED_PROJ``, default on; 0 = one upstream
+``Exl3Linear`` call a projection, as before). docs/DECODE-ROOFLINE.md section 5 (lever 1) has the inventory and the
+cost model.
+
+Why. A verify window runs ~300 upstream ``linear_kernel`` launches (G4 nsys: ~293 at K2 10 / 4 warps, 28 us mean,
+19 us median, + 40 ``wq_b``) and as many ``rot_in`` launches: each projection is one partial wave of short
+programs (every plan walks 8-10 k steps a warp), so a layer pays its projections' latencies one after another.
+Projections that read the same input run as ONE launch here (and one ``rot_in``):
+
+    x      wq_a (1,280) + wkv (512) [+ compressor wkv (512) + wgate (512) on the kv sources]   5,120 -> ...
+    qr     wq_b (16,384, 8 warps) + indexer wq_b (4,096, 4 warps) on the index sources       1,280 -> ...
+    o      wo_a's 4 groups of this rank (4,096 -> 1,024 each; inputs: column slices of o)
+    wo_b alone (it reads wo_a's output); the indexer ``weights_proj`` is a native bf16 matrix (``linear.Plain``).
+
+Design: a segment table, not restacked weights (``x3seg.cu``). Restacking along the output rows would be a
+concatenation of 128-column strips, but it cannot keep the bits: (1) every projection has its own input rotation
+``suh``, so a stacked matrix has no single ``rot_in``; (2) upstream's split plan ``plan(K, N)`` depends on N, and a
+stacked N changes SK (the split-K partial sums' order) or WK (the warps' ranges): other bits. The table keeps each
+projection's own words, ``svh``, ``suh`` and (SK, WK): program p of a launch is upstream's program (p - p0) % NB,
+(p - p0) // NB of its segment, so every output element is computed by the same statements in the same order.
+
+Bits: identical to the unfused path at the same plan (tests: ``test_dsv41_fused_proj_emu.py`` emulates both
+kernels' programs over this module's tables, ``tests/cuda/test_dsv41_fused_proj_gpu.py`` compares the launches on the
+real weights at R = 1..16). Prefill runs with the fast tag (``prefill_mm.active()``) keep their own GEMMs; the CPU
+twin is unchanged.
+
+The plan (G7, lever 1b; ``TF_DSV41_PROJ_PLAN``, default ``upstream``). Upstream's ``plan(K, N)`` splits K until a
+lone launch fills the SMs, so every warp walks only 8-10 k steps; fused launches are full with fewer splits. ``long``
+gives the attention's linears 20-32 k steps a warp (``PLANS``). That is another split-K summation order, so other
+bits than upstream (an fp32 reordering, a few ulp), while the structure holds: the plan is the shape's alone, set on
+the ``Exl3Linear`` objects (``apply_plan``), so every path and every row count sums alike. It is adopted after G7's
+gate (top-1 vs the kit's oracle >= 0.96, MMLU within 1 point); the disk sessions' compat ident carries the knob.
+
+``TF_DSV41_DENSE_V3`` (``dense3``): the same tables and programs over matrices repacked into the "lanes" layout at
+``build`` (16-byte coalesced loads); a group's matrices are all lanes or all strips, and the launch picks dense3.cu.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+from . import numerics as N
+
+ENV = "TF_DSV41_FUSED_PROJ"
+MAXSEG = 8
+ROWS = 128                      # rows a launch (upstream's limit; longer windows in blocks of 128 rows)
+K2S = (4, 6, 8, 10, 12, 16)     # the widths x3seg.cu is built for (2-8 bits, integer)
+META = 11                       # ints a segment in the launch table (x3seg.cpp)
+
+
+def minb(env=None) -> int:
+    """``TF_DSV41_FUSED_PROJ_MINB`` (3 or 2): blocks an SM the 4-warp kernels' registers allow (x3seg.cu). 3 is
+    upstream's occupancy at K2 10 (168 registers, some spills), 2 spends 218 registers and spills none."""
+
+    v = int(((os.environ if env is None else env).get(ENV + "_MINB", "3").strip() or "3"))
+    if v not in (2, 3):
+        raise ValueError(f"{ENV}_MINB={v}: expected 2 or 3")
+    return v
+
+
+def enabled(env=None) -> bool:
+    v = ((os.environ if env is None else env).get(ENV, "1").strip() or "1")
+    if v not in ("0", "1"):
+        raise ValueError(f"{ENV}={v!r}: expected 0 or 1")
+    return v == "1"
+
+
+# -- the attention projections' split plan (TF_DSV41_PROJ_PLAN) -----------------------------------------------------
+PLAN_ENV = "TF_DSV41_PROJ_PLAN"
+PLAN_GROUPS = ("x", "q", "o", "wob")
+# "long": fewer K splits, 4 warps: k steps a warp x 20 (SK 4), q 20 (SK 1), o 32 (SK 2), wo_b 32 (SK 2) instead of
+# upstream's 10 / 10 / 8 / 8 (the head's 40-step walks run this kernel at 239 GB/s, the 8-10-step ones at ~159)
+PLANS = {"long": {"x": (4, 4), "q": (1, 4), "o": (2, 4), "wob": (2, 4)}}
+
+
+def plan_spec(env=None) -> dict | None:
+    """``TF_DSV41_PROJ_PLAN``: None for ``upstream`` (default: upstream's ``plan(K, N)``, the bits before G7), else
+    {group: (SK, WK)} for ``long`` or an explicit ``x:4,q:1,o:2,wob:2`` (``SK`` or ``SK/WK``, WK 4 or 8; groups left
+    out keep upstream's). Groups: x (wq_a, wkv, compressor wkv / wgate), q (wq_b, indexer wq_b), o (wo_a's groups),
+    wob (wo_b)."""
+
+    raw = ((os.environ if env is None else env).get(PLAN_ENV, "upstream").strip().lower() or "upstream")
+    if raw == "upstream":
+        return None
+    if raw in PLANS:
+        return dict(PLANS[raw])
+    out = {}
+    try:
+        for part in raw.split(","):
+            g, v = (s.strip() for s in part.split(":"))
+            sk, wk = (int(t) for t in v.split("/")) if "/" in v else (int(v), 4)
+            if g not in PLAN_GROUPS or sk < 1 or wk not in (4, 8) or g in out:
+                raise ValueError(part)
+            out[g] = (sk, wk)
+    except ValueError as exc:
+        raise ValueError(f"{PLAN_ENV}={raw!r}: expected upstream, long or e.g. x:4,q:1,o:2,wob:2 ({exc})") from None
+    return out
+
+
+def apply_plan(attn, spec: dict | None) -> None:
+    """Give the attention's EXL3 linears the plan ``spec`` (``plan_spec``), on the ``Exl3Linear`` objects themselves:
+    every call (fused or not: the compressor in CED's encoder pass, the drafter, exact prefill windows) then sums in
+    the same order, so a row's bits depend on its own values only (row invariance, batched == alone, drafted ==
+    serial) whichever path computes it. Called before ``build`` (a ``Fused`` reads the plans when made)."""
+
+    if not spec:
+        return
+    groups = {"x": [attn.wq_a, attn.wkv, attn.comp_wkv, attn.comp_wgate], "q": [attn.wq_b, attn.ix_wq_b],
+              "o": list(attn.wo_a), "wob": [attn.wo_b]}
+    for g, (sk, wk) in spec.items():
+        for lin in (lin_of(x) for x in groups[g] if x is not None):
+            if lin is None:
+                continue
+            if (lin.k // 16) % (sk * wk):
+                raise ValueError(f"{PLAN_ENV}: {g} K={lin.k} does not split into {sk} x {wk} warps of whole k tiles")
+            lin.split = (sk, wk)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    import tensorfold.cuda.exl3 as upstream
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    # upstream linear's flags exactly: the same contraction / codegen choices for the transcribed statements
+    return load(name="tf_dsv41_x3seg_v3", sources=[str(here / "x3seg.cpp"), str(here / "x3seg.cu")],
+                extra_include_paths=[str(Path(upstream.__file__).parent)],
+                extra_cuda_cflags=["-O3", "--expt-relaxed-constexpr"], verbose=False)
+
+
+# -- the tables (pure Python: the CUDA launcher and the emulator use the same ones) --------------------------------
+@dataclass(frozen=True)
+class Seg:
+    """One projection as the kernel sees it: K x N, width K2 (= 2 bits), its upstream plan (SK, WK), and where its
+    output goes (buffer ``out``, column ``col``)."""
+
+    k: int
+    n: int
+    k2: int
+    sk: int
+    wk: int
+    out: int = 0
+    col: int = 0
+
+    @property
+    def programs(self) -> int:
+        return (self.n // 128) * self.sk
+
+
+@dataclass(frozen=True)
+class Layout:
+    """A call's scratch and launches for M rows: ``xh_off`` / ``z_off`` / ``c_off`` a segment (elements of the fp16
+    rotated inputs, floats of Z, ints of the counters), ``launches`` [(K2, WK, [segment], meta ints, programs)]."""
+
+    m: int
+    xh_off: tuple
+    z_off: tuple
+    c_off: tuple
+    xh_total: int
+    z_total: int
+    c_total: int
+    launches: tuple
+
+
+def layout(segs: list[Seg], m: int) -> Layout:
+    """Offsets and launches of ``segs`` at ``m`` rows (1-128): one launch a width (K2), the segments in their order,
+    up to MAXSEG a launch; WK of a launch = its segments' largest (a smaller one idles its extra warps)."""
+
+    if not 1 <= m <= ROWS:
+        raise ValueError(f"layout: 1-{ROWS} rows, got {m}")
+    xh_off, z_off, c_off = [], [], []
+    xo = zo = co = 0
+    for s in segs:
+        if s.k % 128 or s.n % 128 or (s.k // 16) % (s.sk * s.wk) or s.wk not in (4, 8) or s.sk < 1:
+            raise ValueError(f"layout: segment {s} is not a valid upstream plan")
+        xh_off.append(xo)
+        z_off.append(zo)
+        c_off.append(co)
+        xo += m * s.k
+        zo += s.sk * m * s.n if s.sk > 1 else 0
+        co += 8 * (s.n // 128)
+    launches = []
+    for k2 in dict.fromkeys(s.k2 for s in segs):
+        idx = [i for i, s in enumerate(segs) if s.k2 == k2]
+        for a in range(0, len(idx), MAXSEG):
+            part = idx[a:a + MAXSEG]
+            meta, p = [], 0
+            for i in part:
+                s = segs[i]
+                tw = 4 * s.k2
+                meta += [s.k, s.n, s.sk, s.wk, 8 * tw, (s.k // 16) * 8 * tw, xh_off[i], z_off[i], c_off[i], s.col, p]
+                p += s.programs
+            launches.append((k2, max(segs[i].wk for i in part), tuple(part), tuple(meta), p))
+    return Layout(m, tuple(xh_off), tuple(z_off), tuple(c_off), xo, zo, co, tuple(launches))
+
+
+# -- the run-time object --------------------------------------------------------------------------------------------
+def lin_of(obj):
+    """The upstream ``Exl3Linear`` behind a forward linear (``linear.Exl3``, or a ``prefill_mm.FastLinear`` around
+    one), else None."""
+
+    inner = getattr(obj, "inner", obj)
+    lin = getattr(inner, "lin", None)
+    return lin if lin is not None and hasattr(lin, "words") else None
+
+
+def why_not(lin) -> str | None:
+    """None when x3seg takes this ``Exl3Linear`` as a segment, else why not."""
+
+    if lin is None:
+        return "not an EXL3 linear on CUDA"
+    if getattr(lin, "layout", "strips") == "lanes":     # TF_DSV41_DENSE_V3: dense3's layout and its own checks
+        from . import dense3 as D3
+
+        return D3.why_not(lin)
+    if getattr(lin, "layout", "strips") != "strips" or lin.bias is not None:
+        return "layout / bias"
+    if lin.codebook != "mul1" or lin.k2 not in K2S:
+        return "codebook / width"
+    sk, wk = lin.split
+    if wk not in (4, 8) or (lin.k // 16) % (sk * wk):
+        return "plan"
+    return None
+
+
+class Fused:
+    """Several ``Exl3Linear`` as one rot_in launch + one linear launch a width. ``outs[i]``: the output buffer of
+    segment i (buffers in first-use order; a buffer's segments side by side in their order)."""
+
+    def __init__(self, lins: list, outs: list[int] | None = None, part: str = "seg") -> None:
+        if not 1 <= len(lins) <= MAXSEG:
+            raise ValueError(f"Fused: 1-{MAXSEG} projections")
+        for lin in lins:
+            if why_not(lin) is not None:
+                raise ValueError(f"Fused: {why_not(lin)}")
+        outs = list(range(len(lins))) if outs is None else list(outs)
+        width: dict[int, int] = {}
+        segs = []
+        for lin, o in zip(lins, outs):
+            sk, wk = lin.split
+            segs.append(Seg(lin.k, lin.n, lin.k2, sk, wk, o, width.get(o, 0)))
+            width[o] = width.get(o, 0) + lin.n
+        self.lins, self.segs, self.widths = list(lins), segs, [width[o] for o in sorted(width)]
+        self.part = part                                    # pdl.py's part (TF_DSV41_PDL): seg, or single
+        lanes = {getattr(lin, "layout", "strips") == "lanes" for lin in lins}
+        if len(lanes) > 1:
+            raise ValueError("Fused: strips and lanes (TF_DSV41_DENSE_V3) matrices in one group")
+        self.lanes = lanes.pop()                            # dense3.cu's launch (x3seg's programs and bits)
+        dev = lins[0].words.device
+        self.counters = torch.zeros((sum(8 * (s.n // 128) for s in segs),), dtype=torch.int32, device=dev)
+        self._layouts: dict[int, Layout] = {}
+        self._dense = None
+
+    def dense(self):
+        """The x3dn group of these matrices when every one is ``dense.wanted`` (TF_DSV41_DENSE), else None."""
+
+        from . import dense as D
+
+        if not all(D.wanted(lin) for lin in self.lins):
+            return None
+        if self._dense is None:
+            self._dense = D.Group(self.lins, [s.out for s in self.segs])
+        return self._dense
+
+    def layout(self, m: int) -> Layout:
+        lay = self._layouts.get(m)
+        if lay is None:
+            lay = self._layouts[m] = layout(self.segs, m)
+        return lay
+
+    def __call__(self, xs, dtype: torch.dtype = N.ACC) -> list[torch.Tensor]:
+        """y_b [M, width_b] for each output buffer b; ``xs``: one input [M, K] for every segment or a list (row-strided
+        views allowed: unit stride in K, 16-byte rows)."""
+
+        dn = self.dense()
+        if dn is not None:                                  # TF_DSV41_DENSE: x3dn, the same contract
+            return dn(xs, dtype)
+        xs = [xs] * len(self.segs) if isinstance(xs, torch.Tensor) else list(xs)
+        xs = [x if x.stride(-1) == 1 and (x.stride(0) * x.element_size()) % 16 == 0 and x.data_ptr() % 16 == 0
+              else x.contiguous() for x in xs]
+        M = xs[0].shape[0]
+        dev = xs[0].device
+        ys = [torch.empty((M, w), dtype=dtype, device=dev) for w in self.widths]
+        for a in range(0, M, ROWS):
+            b = min(M, a + ROWS)
+            self._block([x[a:b] for x in xs], [y[a:b] for y in ys])
+        return ys
+
+    def _block(self, xs: list, ys: list) -> None:
+        from . import pdl as P
+
+        if self.lanes != (getattr(self.lins[0], "layout", "strips") == "lanes"):
+            raise RuntimeError("Fused: a matrix changed layout after its group was built (dense3.mark runs first)")
+        lay = self.layout(xs[0].shape[0])
+        ext = _ext()
+        dev = xs[0].device
+        pdl = P.on(self.part, dev.index)                    # G10 (TF_DSV41_PDL): programmatic dependents, timing only
+        xh = torch.empty((lay.xh_total,), dtype=torch.float16, device=dev)
+        z = torch.empty((lay.z_total,), dtype=torch.float32, device=dev) if lay.z_total else None
+        for a in range(0, len(self.segs), MAXSEG):          # one rot_in launch (more only past 8 segments)
+            idx = range(a, min(len(self.segs), a + MAXSEG))
+            ext.rot_in([xs[i] for i in idx], [self.lins[i].suh for i in idx], xh, [lay.xh_off[i] for i in idx], pdl)
+        if self.lanes:
+            from . import dense3 as D3
+
+            lext, mbs = D3._ext(), {4: D3.minb(4), 8: D3.minb(8)}
+        else:
+            lext, mbs = ext, {4: minb(), 8: minb()}
+        for k2, wk, part, meta, programs in lay.launches:
+            lext.linear(xh, [self.lins[i].words for i in part], [self.lins[i].svh for i in part],
+                        [ys[self.segs[i].out] for i in part], z, self.counters, list(meta), programs, k2, wk, mbs[wk],
+                        pdl)
+
+
+_SINGLE: dict = {}
+
+
+def single(lin) -> Fused | None:
+    """G10 (TF_DSV41_PDL part ``single``): an unfused ``Exl3Linear`` as a 1-segment ``Fused`` (upstream's programs:
+    the same bits as ``lin(x, out=...)``, x3seg's PDL launches), cached on the matrix; None if x3seg cannot take it."""
+
+    key = id(lin)
+    hit = _SINGLE.get(key)
+    if hit is not None and hit.lins[0] is lin:
+        return hit
+    if why_not(lin) is not None or lin.words.device.type != "cuda" or torch.cuda.is_current_stream_capturing():
+        return None                                         # built eagerly only (its counters outlive any graph pool)
+    f = _SINGLE[key] = Fused([lin], part="single")
+    return f
+
+@dataclass
+class Groups:
+    """A block's fused attention projections (None where a group does not apply)."""
+
+    x2: Fused                   # wq_a, wkv
+    x4: Fused | None            # wq_a, wkv, compressor wkv [, wgate]: one buffer [kv | score] for the compressor
+    q: Fused | None             # wq_b, indexer wq_b
+    o: Fused | None             # wo_a's groups, one buffer (their concatenation, wo_b's input)
+
+    def x(self, x: torch.Tensor, comp: bool):
+        """(wq_a x, wkv x) in ACT, and the compressor projection fp32 [n, D] or [n, 2 D] when ``comp``."""
+
+        g = self.x4 if comp else self.x2
+        ys = g(x, N.ACT)
+        return ys[0], ys[1], (ys[2].to(N.ACC) if comp else None)
+
+    def qproj(self, qr: torch.Tensor):
+        """(wq_b qr, indexer wq_b qr) in ACT."""
+
+        q, qi = self.q(qr, N.ACT)
+        return q, qi
+
+    def oproj(self, o: torch.Tensor) -> torch.Tensor:
+        """wo_a over o [n, groups x 4,096]: [n, groups x 1,024] in ACT."""
+
+        gl = len(self.o.segs)
+        w = o.shape[1] // gl
+        return self.o([o[:, g * w:(g + 1) * w] for g in range(gl)], N.ACT)[0]
+
+
+def build(attn) -> Groups | None:
+    """The fused groups of a ``blocks.Attn`` on CUDA, or None (CPU twin, other widths / layouts). Also flags the
+    attention's matrices for x3dn under ``TF_DSV41_DENSE`` (``dense.mark``: fused or not, they sum alike)."""
+
+    from . import dense as D
+    from . import dense3 as D3
+
+    D.mark(attn)
+    D3.mark(attn)                                       # TF_DSV41_DENSE_V3: the matrices repacked in place
+    a = [lin_of(attn.wq_a), lin_of(attn.wkv)]
+    if any(why_not(x) for x in a):
+        return None
+    x2 = Fused(a)
+    x4 = None
+    if attn.comp_wkv is not None:
+        comp = [lin_of(attn.comp_wkv)] + ([lin_of(attn.comp_wgate)] if attn.comp_wgate is not None else [])
+        if not any(why_not(x) for x in comp):
+            x4 = Fused(a + comp, [0, 1] + [2] * len(comp))
+    q = None
+    if attn.ix_wq_b is not None:
+        qa = [lin_of(attn.wq_b), lin_of(attn.ix_wq_b)]
+        if not any(why_not(x) for x in qa):
+            q = Fused(qa)
+    oa = [lin_of(w) for w in attn.wo_a]
+    o = Fused(oa, [0] * len(oa)) if oa and len(oa) <= MAXSEG and not any(why_not(x) for x in oa) else None
+    return Groups(x2, x4, q, o)
+
+
+def active(blk) -> Groups | None:
+    """The block's groups when this call fuses: built, ``TF_DSV41_FUSED_PROJ`` on, not a fast prefill run."""
+
+    g = getattr(blk, "fused", None)
+    if g is None or not enabled():
+        return None
+    from . import prefill_mm as PM
+
+    return None if PM.active() else g
+
+
+__all__ = ["ENV", "PLANS", "PLAN_ENV", "Fused", "Groups", "Layout", "Seg", "active", "apply_plan", "build", "enabled",
+           "layout", "lin_of", "minb", "plan_spec", "single", "why_not"]
