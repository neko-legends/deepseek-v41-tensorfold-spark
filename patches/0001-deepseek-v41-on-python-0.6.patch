+def test_gpu_moe_under_window():
+    from tensorfold.families.deepseek_v41.cuda import moe as M
+
+    layer = _layer(6)
+    g = torch.Generator(device=DEV).manual_seed(7)
+    gate = (torch.randn((64, X.DIMS), generator=g, device=DEV) * 0.02).to(torch.bfloat16)
+    bias = torch.zeros(64, device=DEV)
+    m = M.GpuMoE(gate, bias, layer, 6, 1.5, 10.0)
+    m.ensure()
+    x = torch.randn((8, X.DIMS), generator=g, device=DEV).to(torch.bfloat16)
+    exact = m(x)
+    pe = m.last_pick.clone()
+    with BU.window([(0, 5), (5, 8)], n=8, device=DEV, cfg=BU.Cfg(0, "sub")):
+        got = m(x)
+    pb = m.last_pick.clone()
+    torch.cuda.synchronize()
+    for a in (0, 5):
+        assert torch.equal(got[a], exact[a]) and torch.equal(pb[a], pe[a])
+    for a, z in ((0, 5), (5, 8)):
+        used = {int(e) for e in pb[a:z, :6].reshape(-1)} - {layer.ex.count}
+        assert used <= set(pe[a, :6].tolist())                          # B = 0: row 1's experts only
+    rel = float((got - exact).norm() / exact.norm())
+    print(f"\nbudget B 0 on a random block: relative MoE output change {rel:.3f} (rows 2..)")
