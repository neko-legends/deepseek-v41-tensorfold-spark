index 0000000..9df8911
--- /dev/null
+++ b/tests/dsv41_fakes.py
@@ -0,0 +1,241 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A tiny random DeepSeek-V4.1-Flash checkpoint in the EXL3 pack's namespace (the MiaAI / dealignai layout): every
+EXL3 group a random mul1 trellis with fp16 scales, the widths the real pack uses per tensor kind (6-bit layer-0
+``wq_a`` / ``wkv``, 5-bit attention, 8-bit indexer ``wk``, 3-bit routed experts, 5-bit shared, 6-bit head), plus the
+Engram table (FP8 rows + UE8M0 scales) in memory and as the kit's packed per-rank shards.
+
+Every V4.1 mechanism is present at small sizes (every dimension a multiple of 128 where EXL3 needs it): SWA-only
+layers 0-1 with Engram on layer 1, a ratio-2 kv source (2) and its reuse layer, a ratio-1 kv source that is the
+candidate source (4), a reuse layer, a reindex layer (6) and its reuse layer. Two query heads and two ``wo_a`` groups,
+a 256-wide expert intermediate: everything splits over two ranks.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+MUL1 = 0x83DCD12D
+
+TEXT = {
+    "model_type": "deepseek_v41", "vocab_size": 256, "hidden_size": 128, "num_hidden_layers": 8,
+    "num_attention_heads": 2, "head_dim": 128, "qk_rope_head_dim": 64, "q_lora_rank": 128, "o_lora_rank": 128,
+    "o_groups": 2, "rms_norm_eps": 1e-6, "sliding_window": 4, "n_routed_experts": 8, "n_shared_experts": 1,
+    "num_experts_per_tok": 2, "moe_intermediate_size": 256, "routed_scaling_factor": 1.5, "norm_topk_prob": True,
+    "swiglu_limit": 10.0, "compress_ratios": [0, 0, 2, 2, 1, 1, 1, 1, 0, 0], "kv_source_layer_ids": [2, 4],
+    "index_source_layer_ids": [2, 4, 6], "index_n_heads": 2, "index_head_dim": 128, "index_topk": 3,
+    "candidate_source_layer_id": 4, "candidate_topk_blocks": 2, "candidate_block_size": 2, "hc_mult": 4,
+    "hc_sinkhorn_iters": 20, "hc_eps": 1e-6, "hc_post_alpha": 2.0, "engram_layer_ids": [1],
+    "engram_max_ngram_size": 3, "engram_vocab_size": 31, "engram_n_heads": 2, "engram_head_dim": 32,
+    "engram_pad_token_id": 2, "engram_compressed_vocab_size": 50, "engram_gate_clamp": 1e-6,
+    "num_nextn_predict_layers": 2, "dspark_block_size": 3, "dspark_noise_token_id": 255,
+    "dspark_target_layer_ids": [5, 6, 7], "dspark_markov_rank": 8, "dspark_n_routed_experts": 4,
+    "dspark_num_experts_per_tok": 2, "rope_theta": 10000.0, "compress_rope_theta": 160000.0,
+    "max_position_embeddings": 256,
+    "rope_scaling": {"type": "yarn", "factor": 4.0, "original_max_position_embeddings": 64, "beta_fast": 32,
+                     "beta_slow": 1},
+}
+
+
+def config(**over) -> dict:
+    t = dict(TEXT, **over)
+    return {**t, "bos_token_id": 0, "eos_token_id": 1,
+            "quantization_config": {"quant_method": "exl3", "codebook": "mul1", "bits": 2.9}}
+
+
+class Writer:
+    def __init__(self, cfg, seed: int = 0) -> None:
+        self.cfg, self.t, self.n, self.g = cfg, {}, 0, torch.Generator().manual_seed(seed)
+
+    def exl3(self, name: str, k: int, n: int, bits: int) -> None:
+        self.n += 1
+        g = torch.Generator().manual_seed(1000 + self.n)
+        self.t[f"{name}.trellis"] = torch.randint(-2 ** 15, 2 ** 15, (k // 16, n // 16, 16 * bits), generator=g,
+                                                  dtype=torch.int32).to(torch.int16)
+        scale = 0.5 / k ** 0.5
+        self.t[f"{name}.suh"] = ((torch.rand(k, generator=g) + 0.5) * torch.sign(torch.randn(k, generator=g))
+                                 * scale).to(torch.float16)
+        self.t[f"{name}.svh"] = ((torch.rand(n, generator=g) + 0.5) * torch.sign(torch.randn(n, generator=g))
+                                 ).to(torch.float16)
+        self.t[f"{name}.mul1"] = torch.tensor(MUL1 - 2 ** 32, dtype=torch.int32)
+
+    def native(self, name: str, shape, dtype=torch.bfloat16, scale: float = 1.0, offset: float = 0.0) -> None:
+        self.t[name] = (torch.randn(*shape, generator=self.g) * scale + offset).to(dtype)
+
+    def hc(self, p: str, which: str) -> None:
+        c = self.cfg
+        m = c.hc_mult * (c.hc_mult + 2)
+        self.native(f"{p}.hc_{which}_fn", (m, c.hc_mult * c.hidden_size), torch.float32, 0.02)
+        self.native(f"{p}.hc_{which}_base", (m,), torch.float32, 0.5)
+        self.native(f"{p}.hc_{which}_scale", (3,), torch.float32, 0.1, 1.0)
+
+    def layer(self, L: int) -> None:
+        c = self.cfg
+        p = f"layers.{L}" if L < c.num_hidden_layers else f"mtp.{L - c.num_hidden_layers}"
+        d, hd, a = c.hidden_size, c.head_dim, f"{p}.attn"
+        wide = 6 if L == 0 else 5
+        self.exl3(f"{a}.wq_a", d, c.q_lora_rank, wide)
+        self.exl3(f"{a}.wkv", d, hd, wide)
+        self.exl3(f"{a}.wq_b", c.q_lora_rank, c.num_attention_heads * hd, 5)
+        for g in range(c.o_groups):
+            self.exl3(f"{a}.wo_a.slice.{g}", c.num_attention_heads * hd // c.o_groups, c.o_lora_rank, 5)
+        self.exl3(f"{a}.wo_b", c.o_groups * c.o_lora_rank, d, 5)
+        self.native(f"{a}.q_norm.weight", (c.q_lora_rank,), scale=0.1, offset=1)
+        self.native(f"{a}.kv_norm.weight", (hd,), scale=0.1, offset=1)
+        self.native(f"{a}.attn_sink", (c.num_attention_heads,), torch.float32)
+        if c.is_backbone(L) and c.is_kv_source(L):
+            self.exl3(f"{a}.compressor.wkv", d, hd, 5)
+            if c.compress_ratio(L) > 1:
+                self.exl3(f"{a}.compressor.wgate", d, hd, 5)
+            self.native(f"{a}.compressor.norm.weight", (hd,), scale=0.1, offset=1)
+            self.exl3(f"{a}.indexer.wk", hd, c.index_head_dim, 8)
+            self.native(f"{a}.indexer.k_norm.weight", (c.index_head_dim,), scale=0.1, offset=1)
+        if c.is_backbone(L) and c.is_index_source(L):
+            self.exl3(f"{a}.indexer.wq_b", c.q_lora_rank, c.index_n_heads * c.index_head_dim, 5)
+            self.native(f"{a}.indexer.weights_proj.weight", (c.index_n_heads, d), torch.float16, 0.1)
+        n_exp, _ = c.experts_of(L)
+        f, inter = f"{p}.ffn", c.moe_intermediate_size
+        for e in range(n_exp):
+            self.exl3(f"{f}.experts.{e}.w1", d, inter, 3)
+            self.exl3(f"{f}.experts.{e}.w2", inter, d, 3)
+            self.exl3(f"{f}.experts.{e}.w3", d, inter, 3)
+        for w, (k, n) in (("w1", (d, inter)), ("w2", (inter, d)), ("w3", (d, inter))):
+            self.exl3(f"{f}.shared_experts.{w}", k, n, 5)
+        self.native(f"{f}.gate.weight", (n_exp, d), torch.float16, 0.1)
+        self.native(f"{f}.gate.bias", (n_exp,), torch.float16, 0.01)
+        if L in c.engram_layer_ids:
+            e = f"{p}.engram"
+            self.exl3(f"{e}.wkv", c.n_hash_cols * c.engram_head_dim, (c.hc_mult + 1) * d, 5)
+            self.native(f"{e}.q_weight", (c.hc_mult, d), torch.float32)
+            self.native(f"{e}.k_weight", (c.hc_mult, d), torch.float32)
+        self.native(f"{p}.attn_norm.weight", (d,), scale=0.1, offset=1)
+        self.native(f"{p}.ffn_norm.weight", (d,), scale=0.1, offset=1)
+        self.hc(p, "attn")
+        self.hc(p, "ffn")
+
+
+def engram_table(cfg, seed: int = 0) -> dict[int, tuple[torch.Tensor, torch.Tensor]]:
+    """{layer: (FP8 rows [rows, head_dim] as float8, UE8M0 scales [rows, head_dim / 32] uint8)}."""
+
+    from tensorfold.families.deepseek_v41.cuda.engram_host import EngramLayout
+
+    lay = EngramLayout(cfg)
+    g = torch.Generator().manual_seed(seed + 5)
+    out = {}
+    for li, L in enumerate(cfg.engram_layer_ids):
+        rows = lay.total_rows(li)
+        raw = (torch.randn(rows, cfg.engram_head_dim, generator=g) * 2).to(torch.float8_e4m3fn)
+        scale = torch.randint(118, 126, (rows, cfg.engram_head_dim // 32), generator=g, dtype=torch.uint8)
+        out[L] = (raw, scale)
+    return out
+
+
+def write_checkpoint(folder: Path, seed: int = 0, **over) -> Path:
+    """config.json + two safetensors shards + the index; returns ``folder``."""
+
+    from safetensors.torch import save_file
+
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    raw = config(**over)
+    cfg = Config.from_dict(raw)
+    folder.mkdir(parents=True, exist_ok=True)
+    w = Writer(cfg, seed)
+    w.native("embed.weight", (cfg.vocab_size, cfg.hidden_size))
+    w.native("norm.weight", (cfg.hidden_size,), scale=0.1, offset=1)
+    w.exl3("head", cfg.hidden_size, cfg.vocab_size, 6)
+    for L in range(cfg.num_hidden_layers):
+        w.layer(L)
+    names = sorted(w.t)
+    half = len(names) // 2
+    shards = {"model-00001-of-00002.safetensors": names[:half], "model-00002-of-00002.safetensors": names[half:]}
+    wmap = {}
+    for f, ns in shards.items():
+        save_file({n: w.t[n].contiguous() for n in ns}, str(folder / f))
+        wmap.update({n: f for n in ns})
+    (folder / "model.safetensors.index.json").write_text(json.dumps({"metadata": {}, "weight_map": wmap}))
+    (folder / "config.json").write_text(json.dumps(raw))
+    return folder
+
+
+def write_engram(folder: Path, cfg, table: dict, world: int) -> Path:
+    """The kit's packed per-rank shards of ``table`` (``engram-l{L}-r{rank}of{world}.bin``)."""
+
+    from tensorfold.families.deepseek_v41.cuda.engram_host import EngramLayout, write_shard
+
+    lay = EngramLayout(cfg)
+    folder.mkdir(parents=True, exist_ok=True)
+    for li, L in enumerate(cfg.engram_layer_ids):
+        raw, scale = table[L]
+        recs = np.zeros((raw.shape[0], 264), dtype=np.uint8)
+        recs[:, :raw.shape[1]] = raw.view(torch.uint8).numpy()
+        recs[:, 256:256 + scale.shape[1]] = scale.numpy()
+        for r in range(world):
+            lo, hi, _, _ = lay.head_shard(li, r, world)
+            write_shard(folder / f"engram-l{L}-r{r}of{world}.bin", L, lo, recs[lo:hi], raw.shape[0])
+    return folder
+
+
+def token_map(cfg) -> list[int]:
+    return [i % cfg.engram_compressed_vocab_size for i in range(cfg.vocab_size)]
+
+
+class ThreadPair:
+    """Two ranks in one process (threads): ``comms()[r]`` has the communicator interface the engine uses
+    (``all_gather`` in rank order, ``barrier``), so TP=2 runs on the CPU."""
+
+    def __init__(self, world: int = 2) -> None:
+        import threading
+
+        self.world = world
+        self.slots: list = [None] * world
+        self.bar = threading.Barrier(world)
+
+    def comms(self) -> list:
+        return [_ThreadComm(self, r) for r in range(self.world)]
+
+    def run(self, fns) -> list:
+        """Run ``fns[r]()`` on thread r; their results (an exception in any is raised)."""
+
+        import threading
+
+        out: list = [None] * self.world
+        err: list = []
+
+        def go(r):
+            try:
+                out[r] = fns[r]()
+            except BaseException as e:      # noqa: BLE001 - re-raised below
+                err.append(e)
+                self.bar.abort()
+
+        ts = [threading.Thread(target=go, args=(r,)) for r in range(self.world)]
+        for t in ts:
+            t.start()
+        for t in ts:
+            t.join()
+        if err:
+            raise err[0]
+        return out
+
+
+class _ThreadComm:
+    def __init__(self, pair: ThreadPair, rank: int) -> None:
+        self.pair, self.rank, self.world = pair, rank, pair.world
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        p = self.pair
+        p.slots[self.rank] = send.reshape(-1).clone()
+        p.bar.wait()
+        sizes = [int(x.numel()) for x in p.slots]
+        if len(set(sizes)) != 1:        # NCCL's contract: every rank sends the same count (else a hang or garbage)
+            raise RuntimeError(f"all_gather: ranks sent {sizes} elements")
+        recv.copy_(torch.cat(p.slots))
+        p.bar.wait()
+
+    def barrier(self) -> None:
+        self.pair.bar.wait()
