+@pytest.mark.parametrize("ld", [False, True], ids=["upstream", "x3ld"])
+def test_group_reads_only_allowed(ld):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    layer = _layer(3)
+    ex = layer.ex
+    s = X.scratch(layer, 16)
+    ext = x3._ext()
+    lens = [5, 4]
+    R = 9
+    pick, wts, lg, bias = _window(lens, 5, E=64, spread=2.0)
+    pick[:, K] = ex.count - 1                                           # the shared entry of this block (64)
+    cfg = BU.Cfg(1, "sub")
+    meta = BU.meta_spans(_spans(lens), R, "cpu")
+    pb, wb = BU.apply(*_dev(pick, wts, lg), bias.to(DEV), meta.to(DEV), K, cfg, ex.count)
+    sets = BU.allowed_sets(pick, wts, meta, K, 1, cfg.ratio)
+    allowed = set().union(*(a | set(x) for a, x in sets.values())) | {ex.count - 1}
+    ids, members = s.window(R)
+    pd = pick.to(DEV)
+    ext.group(pd, ids, s.count, members, R, 7, ex.count)
+    full = int(s.count[0])
+    ext.group(pb, ids, s.count, members, R, 7, ex.count)
+    n = int(s.count[0])
+    assert set(ids[:n].tolist()) <= allowed and n < full
+    g = torch.Generator(device=DEV).manual_seed(4)
+    x = torch.randn((R, ex.dims), generator=g, device=DEV).to(torch.bfloat16)
+    saved = dict(loads.CFG)
+    try:
+        loads.CFG.update(on=ld)
+        out_b = X.routed(x, pb, wb.to(torch.float16).float(), layer, s, None, R)
+        out_e = X.routed(x, pd, wts.to(DEV).to(torch.float16).float(), layer, s, None, R)
+        torch.cuda.synchronize()
+        for a, _ in _spans(lens):
+            assert torch.equal(out_b[a], out_e[a])                      # row 1: the exact window's bits
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
