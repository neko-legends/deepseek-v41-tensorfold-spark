+def test_pin_cpu_and_wrapper(monkeypatch):
+    allowed = sorted(PL.os.sched_getaffinity(0))
+    assert PL.pin_cpu("") is None and PL.pin_cpu("off") is None and PL.pin_cpu("-1") is None
+    assert PL.pin_cpu(str(allowed[0])) == allowed[0]
+    monkeypatch.setenv("GLM53_TF_ROCE_CPU", str(allowed[-1]))
+    auto = PL.pin_cpu("auto")
+    assert auto in allowed and (len(allowed) == 1 or auto != allowed[-1])
+    with pytest.raises(ValueError):
+        PL.pin_cpu(str(max(allowed) + 1000))
+
+    class L:
+        sent = 0
+
+        def send(self, p):
+            self.sent += 1
+
+        def recv(self):
+            return [1]
+
+    seen = []
+    monkeypatch.setattr(PL.os, "sched_setaffinity", lambda pid, cpus: seen.append((pid, set(cpus))))
+    w = PL.Pinned(L(), allowed[0])
+    w.send([1])
+    w.send([2])
+    assert w.recv() == [1] and seen == [(0, {allowed[0]})] and w.sent == 2      # once a thread; attributes pass
+
+
+# -- l2pace.cu for sm_121 (needs an nvcc that knows compute_121: TF_NVCC, PATH or CUDA_HOME) ------------------------
+def _nvcc():
+    import os
+    import shutil
+    import subprocess
+
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                if "compute_121" in subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True,
+                                                   timeout=60).stdout:
+                    return cand
+            except (OSError, subprocess.SubprocessError):
+                continue
+    return None
+
+
+def test_l2pace_builds_read_only_for_sm121(tmp_path):
+    import re
+    import subprocess
+    from pathlib import Path
+
+    nvcc = _nvcc()
+    if nvcc is None:
+        pytest.skip("no nvcc with compute_121 (TF_NVCC)")
+    cu = Path(L2.__file__).with_name("l2pace.cu")
+    r = subprocess.run([nvcc, "-arch=sm_121", "-O3", "-cubin", "-Xptxas", "-v", "-o", str(tmp_path / "k.cubin"),
+                        str(cu)], capture_output=True, text=True, timeout=600)
+    assert r.returncode == 0, r.stderr[-2000:]
+    assert re.search(r"0 bytes spill stores, 0 bytes spill loads", r.stderr)
+    p = subprocess.run([nvcc, "-arch=sm_121", "-O3", "-ptx", "-o", str(tmp_path / "k.ptx"), str(cu)],
+                       capture_output=True, text=True, timeout=600)
+    assert p.returncode == 0, p.stderr[-2000:]
+    ptx = (tmp_path / "k.ptx").read_text()
+    ops = set(re.findall(r"\b(st|atom|red|ld|cp)\.[A-Za-z0-9.:]+", ptx))
+    assert {o.split(".")[0] for o in ops} <= {"ld", "cp"}, ops                      # reads and prefetches only
+    assert "cp.async.bulk.prefetch.L2.global" in ptx and "nanosleep" in ptx and "%globaltimer" in ptx
