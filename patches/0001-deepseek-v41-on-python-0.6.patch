+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Image input for DeepSeek-V4.1-Flash, host side (rank 0's HTTP threads, no GPU): GLM patches/0500's front end
+(``glm5_next/spark/vision_prep.py``: fetch, decode, digests, virtual ids) with V4.1's processor and image span.
+
+- **Processor** (``plan_grid`` / ``preprocess``): DeepSeek's ``inference/image_processor.py`` (MIT) step for step:
+  images under ``min_pixels`` (295,936 = 544^2) are scaled up to it (aspect kept), the size rounded up to the 14-px
+  patch, shrunk until the span costs at most ``max_image_tokens`` (1,024) LLM positions; ``ImageOps.pad`` (bicubic
+  fit, centred, grey 127) to that size; ``(x / 255 - 0.5) / 0.5`` in bf16; 14 x 14 patches in reading order.
+  ``tests/test_dsv41_vision_prep.py`` checks the plans and pixels against the reference's own functions.
+- **The span** (``span_types``): an image of an h x w aligner grid (the ViT's patch grid / 3, ceil) is
+  ``IMAGE_START, (IMAGE x w, IMAGE_NEW_LINE) x h, IMAGE_END``: h (w + 1) + 2 positions. The reference puts the image
+  token id (129,264) at every position and tells them apart by type; here each position gets a **virtual id**
+  (>= ``VBASE`` = 2^24, past the 129,280-token vocabulary), a hash of (the image's digest, the position), so every
+  token-keyed cache (sessions, prefix shares, the NVMe tier, request-log hashes) keys the image's pixels for free and
+  shares state only for the same image. The digest is SHA-256 over a version tag, the settings (processor and
+  vision config), whether the routing bias for images is loaded (``TF_DSV41_BIAS_VL``: it changes the state the
+  span leaves), the grid and the patches.
+- **The prompt**: ``encoding`` renders each image part as ``<｜deepseek_image｜>`` (the reference's placeholder),
+  through a per-request sentinel so the images keep prompt order whatever the message order (tool results are
+  re-sorted); ``expand`` replaces each placeholder id with its span's virtual ids (``/tokenize``: 129,264 each).
+  A placeholder that is not an image part (typed into text) is refused, as the reference refuses it.
+
+Limits (``TF_DSV41_VISION_*``): MAX_IMAGES (8 a request), MAX_TOKENS (cap below 1,024 positions an image), FETCH
+(1: https URLs; 0: data: URLs only), FETCH_TIMEOUT (10 s), FETCH_TOTAL_S (30 s), MAX_BYTES (20 MB), MAX_PIXELS (64 M
+decoded), FETCH_HTTP / FETCH_PRIVATE (0; local tests only), PREP_SLOTS (8 requests preparing at once), PREP_MB (256 MB
+of preprocessed images cached by data: URL digest).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import secrets
+import threading
+import time
+from collections import OrderedDict
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from tensorfold.families.glm5_next.spark.vision_prep import (  # noqa: F401
+    VBASE,
+    Registry,
+    VisionBusy,
+    VisionError,
+    decode,
+    has_vids,
+    is_vid,
+    load_bytes,
+)
+
+from .encoding import IMAGE_PARTS, IMAGE_PLACEHOLDER
+
+VERSION = b"tensorfold-dsv41-vision/1"
+TEXT, IMAGE_START, IMAGE, IMAGE_NEW_LINE, IMAGE_END = -1, 0, 1, 2, 3
+IMAGE_TOKEN = 129264
+
+
+def _env_int(name: str, default: int, env=os.environ) -> int:
+    raw = env.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        return int(float(raw))
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected a number") from None
+
+
+def _env_flag(name: str, default: str = "0", env=os.environ) -> bool:
+    raw = env.get(name, default).strip() or default
+    if raw not in ("0", "1"):
+        raise ValueError(f"{name}={raw!r}: expected 0 or 1")
+    return raw == "1"
+
+
+@dataclass
+class Settings:
+    """``config.json``'s ``vision_config`` and image token, and the server's limits. The attribute names the GLM
+    fetch / decode helpers read (``max_bytes``, ``fetch*``, ``max_pixels``) are theirs."""
+
+    patch: int = 14
+    downsample: int = 3
+    max_tokens: int = 1024                  # LLM positions an image (its whole span)
+    min_pixels: int = 544 * 544
+    max_wh_ratio: float | None = None
+    image_token: int = IMAGE_TOKEN
+    vision_config: dict = field(default_factory=dict)
+    bias_vl: bool = False                   # the image routing bias is loaded (part of every digest)
+    max_images: int = 8
+    cap_tokens: int = 0
+    fetch: bool = True
+    fetch_timeout: float = 10.0
+    fetch_total: float = 30.0
+    max_bytes: int = 20 * 1024 * 1024
+    max_pixels: int = 64 * 1024 * 1024
+    fetch_http: bool = False
+    fetch_private: bool = False
+    prep_slots: int = 8
+    prep_mb: int = 256
+
+    @classmethod
+    def read(cls, model_dir: Path | None = None, env=os.environ) -> Settings:
+        s = cls()
+        if model_dir is not None and (Path(model_dir) / "config.json").is_file():
+            cfg = json.loads((Path(model_dir) / "config.json").read_text())
+            vc = dict(cfg.get("vision_config") or {})
+            s.vision_config = vc
+            s.image_token = int(cfg.get("image_token_id", s.image_token))
+            s.patch = int(vc.get("patch_size", s.patch))
+            s.downsample = int(vc.get("downsample_ratio", s.downsample))
+            s.max_tokens = int(vc.get("max_image_tokens", s.max_tokens))
+            s.min_pixels = int(vc.get("min_pixels", s.min_pixels))
+            s.max_wh_ratio = vc.get("max_wh_ratio", s.max_wh_ratio)
+        s.bias_vl = bool(env.get("TF_DSV41_BIAS_VL", "").strip())
+        s.max_images = _env_int("TF_DSV41_VISION_MAX_IMAGES", s.max_images, env)
+        s.cap_tokens = _env_int("TF_DSV41_VISION_MAX_TOKENS", 0, env)
+        s.fetch = _env_flag("TF_DSV41_VISION_FETCH", "1", env)
+        s.fetch_timeout = float(env.get("TF_DSV41_VISION_FETCH_TIMEOUT", "") or 10)
+        s.fetch_total = float(env.get("TF_DSV41_VISION_FETCH_TOTAL_S", "") or 30)
+        s.max_bytes = _env_int("TF_DSV41_VISION_MAX_BYTES", s.max_bytes, env)
+        s.max_pixels = _env_int("TF_DSV41_VISION_MAX_PIXELS", s.max_pixels, env)
+        s.fetch_http = _env_flag("TF_DSV41_VISION_FETCH_HTTP", "0", env)
+        s.fetch_private = _env_flag("TF_DSV41_VISION_FETCH_PRIVATE", "0", env)
+        s.prep_slots = _env_int("TF_DSV41_VISION_PREP_SLOTS", s.prep_slots, env)
+        s.prep_mb = _env_int("TF_DSV41_VISION_PREP_MB", s.prep_mb, env)
+        if s.max_images < 1 or s.cap_tokens < 0 or s.prep_slots < 1:
+            raise ValueError("TF_DSV41_VISION_MAX_IMAGES >= 1, _MAX_TOKENS >= 0, _PREP_SLOTS >= 1")
+        if s.cap_tokens and s.cap_tokens < 5:
+            raise ValueError("TF_DSV41_VISION_MAX_TOKENS: at least 5 (one row of one cell)")
+        return s
+
+    def budget(self) -> int:
+        return min(self.max_tokens, self.cap_tokens) if self.cap_tokens else self.max_tokens
+
+    def key(self) -> bytes:
+        """What an image's rows depend on besides its patches (part of every digest)."""
+
+        return json.dumps({"patch": self.patch, "downsample": self.downsample, "min_pixels": self.min_pixels,
+                           "max_wh_ratio": self.max_wh_ratio, "vision": self.vision_config,
+                           "bias_vl": self.bias_vl}, sort_keys=True).encode()
+
+
+# -- the reference's resize plan (inference/image_processor.py) ---------------------------------------------------
+def span_len(n_llm_h: int, n_llm_w: int) -> int:
+    return n_llm_h * (n_llm_w + 1) + 2
+
+
+def llm_grid(height: int, width: int, patch: int, ratio: int) -> tuple[int, int]:
+    return math.ceil((height // patch) / ratio), math.ceil((width // patch) / ratio)
+
+
+def _solve(height, width, patch, ratio, most):
+    r = height / width
+    max_w = math.sqrt((most - 2) / r + 0.25) - 0.5
+    max_h = max_w * r
+    cell = patch * ratio
+    if max_w < 1.0:
+        return (most - 2) // 2 * cell, cell
+    if max_h < 1.0:
+        return cell, (most - 3) * cell
+    beta = min(math.floor(max_w) * cell / width, math.floor(max_h) * cell / height)
+    return math.floor(height * beta / patch) * patch, math.floor(width * beta / patch) * patch
+
+
+def plan_grid(width: int, height: int, s: Settings, most: int | None = None) -> tuple[int, int, int, int]:
+    """(n_llm_h, n_llm_w, pixel height, pixel width) of an image of this original size (``plan_image_grid``)."""
+
+    most = s.budget() if most is None else most
+    p, ratio = s.patch, s.downsample
+    if s.max_wh_ratio is not None and width > height * s.max_wh_ratio:
+        width = height * s.max_wh_ratio
+    if 0 < width * height < s.min_pixels:
+        k = (s.min_pixels / (width * height)) ** 0.5
+        width, height = int(width * k), int(height * k)
+    bw, bh = math.ceil(width / p) * p, math.ceil(height / p) * p
+    h, w = llm_grid(bh, bw, p, ratio)
+    if span_len(h, w) > most:
+        bh, bw = _solve(height, width, p, ratio, most)
+        h, w = llm_grid(bh, bw, p, ratio)
+        if span_len(h, w) > most:
+            raise VisionError(f"image of {width}x{height}: no grid fits {most} positions")
+    return h, w, bh, bw
+
+
+def span_types(n_llm_h: int, n_llm_w: int) -> list[int]:
+    return [IMAGE_START] + ([IMAGE] * n_llm_w + [IMAGE_NEW_LINE]) * n_llm_h + [IMAGE_END]
+
+
+@dataclass
+class Prepared:
+    """One image: the ViT's patches bf16 [n_vit_h n_vit_w, 3, 14, 14], the grids, the span and its ids."""
+
+    patches: Any
+    n_vit_h: int
+    n_vit_w: int
+    n_llm_h: int
+    n_llm_w: int
+    digest: bytes
+    size: tuple[int, int]                   # the original (width, height)
+    vids: list[int] = field(default_factory=list)
+
+    @property
+    def tokens(self) -> int:
+        return span_len(self.n_llm_h, self.n_llm_w)
+
+    @property
+    def types(self) -> list[int]:
+        return span_types(self.n_llm_h, self.n_llm_w)
+
+
+def preprocess(image, s: Settings, most: int | None = None) -> Prepared:
+    """An RGB ``PIL.Image`` -> its patches (``load_image`` of the reference, after the RGB conversion)."""
+
+    import numpy as np
+    import torch
+    from PIL import ImageOps
+
+    p = s.patch
+    size = (int(image.width), int(image.height))
+    n_h, n_w, bh, bw = plan_grid(image.width, image.height, s, most)
+    vh, vw = bh // p, bw // p
+    if s.max_wh_ratio is not None and image.width >= s.max_wh_ratio * image.height:
+        image = image.resize((bw, bh))
+    else:
+        image = ImageOps.pad(image, (bw, bh), color=(127, 127, 127))
+    x = torch.from_numpy(np.asarray(image, dtype=np.float32).copy()).permute(2, 0, 1) / 255
+    x = ((x - 0.5) / 0.5).to(torch.bfloat16)
+    patches = x.reshape(3, vh, p, vw, p).permute(1, 3, 0, 2, 4).reshape(vh * vw, 3, p, p).contiguous()
+    h = hashlib.sha256(VERSION)
+    h.update(s.key())
+    h.update(json.dumps([vh, vw, n_h, n_w]).encode())
+    h.update(patches.view(torch.int16).numpy().tobytes())
+    return Prepared(patches, vh, vw, n_h, n_w, h.digest(), size)
+
+
+# -- content parts -----------------------------------------------------------------------------------------------
+def part_url(part: Any) -> str:
+    """An image part's URL: OpenAI ``image_url`` (object or string), ``input_image`` / ``image`` (``url`` /
+    ``image_url`` / ``image``), or Anthropic's ``source`` (base64 or url). Raises for a part without one."""
+
+    kind = part.get("type")
+    src = part.get("source")
+    if isinstance(src, dict):
+        if src.get("type") == "base64" or src.get("data") is not None:
+            media = src.get("media_type") or "image/png"
+            return f"data:{media};base64,{src.get('data') or ''}"
+        if src.get("url"):
+            return str(src["url"])
+    val = part.get("image_url") if kind == "image_url" else (
+        part.get("image_url") or part.get("url") or part.get("image"))
+    if isinstance(val, dict):
+        val = val.get("url")
+    if not isinstance(val, str) or not val:
+        raise VisionError(f"an {kind} part needs a URL (image_url.url)")
+    return val
+
+
+def count_images(messages: Any) -> int:
+    if not isinstance(messages, list):
+        return 0
+    n = 0
+    for m in messages:
+        content = m.get("content") if isinstance(m, dict) else None
+        if isinstance(content, list):
+            n += sum(1 for p in content if isinstance(p, dict) and p.get("type") in IMAGE_PARTS)
+    return n
+
+
+class Marker:
+    """A request's image parts as sentinels (``encoding``'s ``image`` hook), then the rendered text's sentinels as
+    ``<｜deepseek_image｜>`` with the URLs in prompt order (``splice``)."""
+
+    def __init__(self) -> None:
+        self.nonce = secrets.token_hex(6)
+        self.urls: list[str] = []
+
+    def tag(self, i: int) -> str:
+        return f"\x00tf-image-{self.nonce}-{i}\x00"
+
+    def __call__(self, part: dict, where: str) -> str:
+        try:
+            url = part_url(part)
+        except VisionError as exc:
+            raise VisionError(f"{where}: {exc}") from None
+        self.urls.append(url)
+        return self.tag(len(self.urls) - 1)
+
+    def splice(self, text: str) -> tuple[str, list[str]]:
+        if IMAGE_PLACEHOLDER in text:
+            raise VisionError(f"the messages hold the image placeholder {IMAGE_PLACEHOLDER} as text: send images "
+                              "as image parts")
+        at = sorted((text.find(self.tag(i)), i) for i in range(len(self.urls)))
+        if any(a < 0 for a, _ in at):
+            raise VisionError("an image part was dropped by the prompt encoding")
+        for i in range(len(self.urls)):
+            text = text.replace(self.tag(i), IMAGE_PLACEHOLDER)
+        if "\x00tf-image-" in text:
+            raise VisionError("an image sentinel survived the prompt encoding")
+        return text, [self.urls[i] for _, i in at]
+
+
+def expand(ids: Sequence[int], images: Sequence[Prepared], s: Settings, *, virtual: bool = True) -> list[int]:
+    """The rendered prompt's ids with each ``<｜deepseek_image｜>`` replaced by its image's span: the virtual ids, or
+    (``virtual=False``, ``/tokenize``) the image token at every position, as the reference's ``input_ids``."""
+
+    out: list[int] = []
+    k = 0
+    for t in ids:
+        t = int(t)
+        if t != s.image_token:
+            if t >= VBASE:
+                raise VisionError("a prompt id past the vocabulary")
+            out.append(t)
+            continue
+        if k >= len(images):
+            raise VisionError("the prompt holds an image placeholder that is not an image part")
+        img = images[k]
+        out.extend(img.vids if virtual else [s.image_token] * img.tokens)
+        k += 1
+    if k != len(images):
+        raise VisionError(f"{len(images)} image(s) sent, {k} placed in the prompt")
+    return out
+
+
+# -- rank 0's front end ------------------------------------------------------------------------------------------
+class Host:
+    """Settings, the virtual-id registry, a cache of preprocessed images (by data: URL digest), bounded preparation."""
+
+    def __init__(self, model_dir: Path | None, env=os.environ) -> None:
+        self.s = Settings.read(model_dir, env)
+        self.registry = Registry()
+        self.cache: OrderedDict[str, Prepared] = OrderedDict()
+        self.cache_bytes = 0
+        self.lock = threading.Lock()
+        self.slots = threading.BoundedSemaphore(self.s.prep_slots)
+
+    def prepare(self, url: str, deadline: float | None = None) -> Prepared:
+        key = hashlib.sha256(url.encode()).hexdigest() if url.startswith("data:") else None
+        if key is not None:
+            with self.lock:
+                hit = self.cache.get(key)
+                if hit is not None:
+                    self.cache.move_to_end(key)
+                    return hit
+        img = decode(load_bytes(url, self.s, deadline), self.s)
+        prep = preprocess(img, self.s)
+        prep.vids = self.registry.vids(prep.digest, prep.tokens)
+        if key is not None:
+            with self.lock:
+                self.cache[key] = prep
+                self.cache_bytes += prep.patches.numel() * 2
+                while self.cache_bytes > self.s.prep_mb << 20 and len(self.cache) > 1:
+                    _, old = self.cache.popitem(last=False)
+                    self.cache_bytes -= old.patches.numel() * 2
+        return prep
+
+    def images(self, urls: Sequence[str]) -> list[Prepared]:
+        if not urls:
+            return []
+        if len(urls) > self.s.max_images:
+            raise VisionError(f"{len(urls)} images in one request: at most {self.s.max_images} "
+                              "(TF_DSV41_VISION_MAX_IMAGES)")
+        if not self.slots.acquire(timeout=60):
+            raise VisionBusy("image processing capacity is busy; retry shortly")
+        try:
+            deadline = time.monotonic() + self.s.fetch_total
+            return [self.prepare(u, deadline) for u in urls]
+        finally:
+            self.slots.release()
