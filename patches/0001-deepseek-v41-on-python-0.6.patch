+def _pack() -> Path | None:
+    p = os.environ.get("TF_DSV41_PACK_CACHE", "").strip()
+    return Path(p) if p and (Path(p) / "headers.json").is_file() else None
+
+
+def _cached():
+    root = _pack()
+    m = json.loads((root / "headers.json").read_text())
+    wm = m["index"].get("weight_map", m["index"])
+    info = {n: tuple(e["shape"]) for v in m["headers"].values() for n, e in v["header"].items() if n != "__metadata__"}
+    out = {}
+    for key in sorted(wm):
+        if not key.endswith(".trellis"):
+            continue
+        h = hashlib.sha1(f"{wm[key]}:{key}".encode()).hexdigest()[:16]
+        f = root / "tensors" / f"{h}.bin"
+        if f.is_file():
+            out[key[:-len(".trellis")]] = (f, info[key])
+    return out
+
+
+def _load(f, shape):
+    return np.frombuffer(f.read_bytes(), dtype=np.int16).reshape(shape)
+
+
+@pytest.mark.skipif(_pack() is None, reason="TF_DSV41_PACK_CACHE: the real pack's cached tensors")
+def test_kernel_decode_equals_unpack_real_pack():
+    from tensorfold.cuda.exl3 import format as fmt
+
+    done = []
+    for name, (f, shape) in _cached().items():
+        tr = _load(f, shape)
+        bits = fmt.bits_of(tr.shape)
+        k2, K, N = int(2 * bits), 16 * shape[0], 16 * shape[1]
+        nb = N // 128
+        pick = sorted(set(np.linspace(0, nb - 1, min(nb, 12)).astype(int).tolist()))     # strips sampled
+        sub = np.concatenate([tr[:, 8 * p:8 * p + 8] for p in pick], axis=1)
+        want = fmt.unpack(sub, bits, "mul1").view(np.uint16)
+        layouts = ["strips", "stored"] + (["lanes"] if k2 in PD.K2S_LANES else [])
+        for layout in layouts:
+            words, sk, snb = E.words_of_trellis(sub, layout)
+            got = E.kernel_wq(words, k2, K, 128 * len(pick), sk, snb, layout == "lanes")
+            assert np.array_equal(got, want), (name, layout)
+        done.append(f"{name} {K}x{N} {bits}b")
+    assert done
+    print(f"[G16D] pfdense decode == upstream unpack on {len(done)} real matrices (strips / stored / lanes): "
+          + ", ".join(done))
+
