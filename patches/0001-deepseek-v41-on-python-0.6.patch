+# -- the forward on a synthetic checkpoint with the kernels' shapes -----------------------------------------------
+SHAPES = dict(num_attention_heads=32, head_dim=512, qk_rope_head_dim=64, o_groups=2, o_lora_rank=128,
+              index_n_heads=32, index_head_dim=128, sliding_window=128, rms_norm_eps=1e-20)
+IDS = torch.randint(0, 256, (45,), generator=torch.Generator().manual_seed(4)).tolist()
