+def test_partial_acceptance_equals_serial(ck):
+    """An oracle drafter: the serial future with its last draft wrong, every round (rollback of the rest)."""
+
+    p, s = SHORT[1], SAMPLINGS[3]
+    want = _serial_short(ck, [p], sampling=s)[0]
+    full = list(p) + want
+    fw = DF.forward(ck)
+    n = fw.drafter.n
+
+    def oracle(slots, anchors, starts, noises=None):
+        out = []
+        for st in starts:
+            d = [full[st + 1 + j] if st + 1 + j < len(full) else 3 for j in range(n)]
+            d[-1] = (d[-1] + 1) % 250 + 3
+            out.append(d)
+        return out, [[0.999] * n for _ in starts]
+
+    fw.drafter.propose = oracle
+    fw.depth.mode = "static"
+    b = DF.batcher(ck, fw, depth=n)
+    j = Job(list(p), N_SHORT, s)
+    assert DF.run(b, [j])[0] == want
+    st = j.stats["drafting"]
+    assert st["dspark_kept"] >= (n - 1) * (st["dspark_rounds"] - 1)
+
