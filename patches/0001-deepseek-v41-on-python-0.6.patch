+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``x3tc``'s kernels compile for sm_121a without a GPU at the model's shapes (3- and 2-bit experts, with and
+without the inline-PTX byte sum) at the default ``TF_DSV41_TC_CFG``: no register spills, shared memory within the
+GB10's 99 KiB a block, tensor-core mma in both, dp4a only where asked."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+if os.environ.get("TRITON_INTERPRET") == "1":
+    pytest.skip("compiles need Triton's compiler (unset TRITON_INTERPRET)", allow_module_level=True)
+pytest.importorskip("triton")
+try:
+    import dsv41_x3tc_ptx as P
+    P.ptxas  # noqa: B018
+    from triton.backends.nvidia import compiler as _nvc  # noqa: F401
+except Exception as exc:                                   # noqa: BLE001
+    pytest.skip(f"no Triton CUDA backend: {exc}", allow_module_level=True)
+
+
+def test_x3tc_compiles_for_sm121():
+    got = P.run()
+    assert len(got) == 8
+    for name, v in got.items():
+        assert v["spill"] == 0, (name, v)
+        assert v["smem"] <= P.SMEM, (name, v)
+        assert v["mma"], name
+        assert v["dp4a"] == name.endswith("_asm"), name
diff --git a/tests/test_dsv41_x3tc_interp.py b/tests/test_dsv41_x3tc_interp.py
new file mode 100644
index 0000000..9fab28e
--- /dev/null
+++ b/tests/test_dsv41_x3tc_interp.py
@@ -0,0 +1,116 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""The fast prefill experts' Triton kernels (``x3tc``) in Triton's CPU interpreter:
+
+- the in-kernel mul1 decode == upstream's ``exl3.format.unpack`` bit for bit (2, 3, 4, 5 bits; random trellises);
+- the routed experts == the float64 math of the dequantized experts (fp16 rotated inputs: rounding-level);
+- row independence, bit for bit: rows alone == in the block, any row blocks, an expert with more members than one
+  program holds (several member blocks)."""
+
+from __future__ import annotations
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401  (fixture)
+
+interpret()
+
+import numpy as np  # noqa: E402
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytestmark = [pytest.mark.torch, pytest.mark.usefixtures("gpu_like")]
+
+from tensorfold.cuda.exl3 import format as fmt  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import x3tc  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.weights import X3Stack  # noqa: E402
+
+if type(x3tc._decode_kernel).__name__ != "InterpretedFunction":
+    pytest.skip("Triton's CPU interpreter (a GPU runs the compiled kernels: tests/cuda)", allow_module_level=True)
+
+D, I, E, S = 256, 256, 6, 2
+LIMIT = 10.0
+
+
+def trellis(k: int, n: int, bits: int, seed: int, e: int | None = None) -> torch.Tensor:
+    g = np.random.default_rng(seed)
+    shape = (k // 16, n // 16, 16 * bits) if e is None else (e, k // 16, n // 16, 16 * bits)
+    return torch.from_numpy(g.integers(-32768, 32768, size=shape, dtype=np.int64).astype(np.int16))
+
+
+@pytest.mark.parametrize("bits", [2, 3, 4, 5])
+def test_decode_is_upstreams_unpack(bits):
+    t = trellis(256, 256, bits, bits)
+    got = x3tc.decode(t, asm=False)
+    want = torch.from_numpy(fmt.unpack(t.numpy(), bits, "mul1"))
+    assert torch.equal(got.view(torch.int16), want.view(torch.int16))
+
+
+def stack(k: int, n: int, bits: int, seed: int) -> X3Stack:
+    g = np.random.default_rng(seed + 100)
+    suh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, k)) * g.uniform(0.5, 1.5, size=(E, k))).astype(np.float16))
+    svh = torch.from_numpy((g.choice([-1.0, 1.0], size=(E, n)) * g.uniform(0.002, 0.004, size=(E, n)))
+                           .astype(np.float16))
+    return X3Stack(trellis(k, n, bits, seed, E).contiguous(), suh, svh, "mul1")
+
+
+@pytest.fixture(scope="module")
+def layer():
+    return stack(D, I, 3, 1), stack(D, I, 3, 2), stack(I, D, 3, 3)
+
+
+def inputs(R: int, seed: int, skew: bool = False):
+    g = torch.Generator().manual_seed(seed)
+    x = (torch.randn(R, D, generator=g) * 0.5).to(torch.bfloat16)
+    pick = torch.stack([torch.randperm(E, generator=g)[:S] for _ in range(R)]).to(torch.int32)
+    if skew:
+        pick[:, 0] = 2                                  # expert 2: every row (more than one member block)
+        pick[:, 1] = torch.where(pick[:, 1] == 2, torch.full_like(pick[:, 1], 3), pick[:, 1])
+    w = (torch.rand(R, S, generator=g) + 0.2).to(torch.float16).to(torch.float32)
+    return x, pick, w
+
+
+def reference(x, pick, w, layer) -> torch.Tensor:
+    gate, up, down = layer
+    W = [[torch.from_numpy(fmt.dequantize(m.trellis[e].numpy(), m.suh[e].numpy(), m.svh[e].numpy(), 3, "mul1"))
+          for e in range(E)] for m in (gate, up, down)]
+    out = torch.zeros(x.shape[0], D, dtype=torch.float64)
+    xf = x.double()
+    for r in range(x.shape[0]):
+        for k in range(S):
+            e = int(pick[r, k])
+            gg = (xf[r] @ W[0][e]).clamp(max=LIMIT)
+            uu = (xf[r] @ W[1][e]).clamp(-LIMIT, LIMIT)
+            out[r] += float(w[r, k]) * ((torch.nn.functional.silu(gg) * uu) @ W[2][e])
+    return out
+
+
+def test_routed_matches_float64(layer):
+    x, pick, w = inputs(40, 7, skew=True)
+    got = x3tc.run(x, pick, w, *layer, LIMIT, rows=64, asm=False)
+    want = reference(x, pick, w, layer)
+    err = (got.double() - want).abs().max() / want.abs().max()
+    assert float(err) < 2e-3                            # fp16 inputs: ~3e-4 measured
+
+
+def test_routed_rows_are_independent(layer):
+    x, pick, w = inputs(40, 8, skew=True)
+    whole = x3tc.run(x, pick, w, *layer, LIMIT, rows=64, asm=False)
+    blocks = x3tc.run(x, pick, w, *layer, LIMIT, rows=16, asm=False)
+    assert torch.equal(whole, blocks)
+    sub = [3, 17, 18, 39]
+    alone = x3tc.run(x[sub], pick[sub], w[sub], *layer, LIMIT, rows=64, asm=False)
+    assert torch.equal(alone, whole[sub])
+
+
+def test_items_cover_every_pair():
+    pick = torch.tensor([[2, 0], [2, 1], [2, 0], [5, 2]], dtype=torch.int32)
+    ie, im, cnt, off, order, n = x3tc.items(pick, E)
+    assert cnt.tolist() == [2, 1, 4, 0, 0, 1]
+    pairs = []
+    for i in range(n):
+        e = int(ie[i])
+        if e >= E:
+            continue
+        m = int(im[i])
+        pairs += order[int(off[e]) + m * x3tc.BM: int(off[e]) + min(int(cnt[e]), (m + 1) * x3tc.BM)].tolist()
+    assert sorted(pairs) == list(range(8))
