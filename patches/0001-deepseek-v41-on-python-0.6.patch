@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G16 ``TF_DSV41_PF_COPIES`` kernels in Triton's CPU interpreter (no GPU), with the ``gpu_like`` dot / cast model:
+
+- the fused prefill attention's group-major store (``attn_pf.attention(groups=)``, ``Triton.attention_grouped``)
+  holds the default layout's values, bit for bit: BMQ 16 and 32, compressed + SWA, SWA only, paged;
+- the fast-tag forward on the Triton backend (the fused attention's grouped output feeding ``wo_a`` in place):
+  copies on == off for the prompt's last row and the next decode step, and the grouped path really ran.
+
+Run: python -m pytest -q tests/test_dsv41_pf16_interp.py
+"""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+triton = pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda.csa2 import attn_pf  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import rows as RW  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(attn_pf._fused).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+
+from test_dsv41_prefill2_interp import _attn_case, _bits, _lists  # noqa: E402
+
+
+def _run(q, comp, tok, cnt, swa_t, lo, P, sink, cs, groups: int = 0, pg=None):
+    R, H = q.shape[0], q.shape[1]
+    out = torch.zeros((groups, R, H // groups * 512) if groups else (R, H, 512), dtype=torch.bfloat16)
+    return attn_pf.attention(q, comp, tok, cnt, swa_t, lo, torch.tensor([P], dtype=torch.int32), sink, cs, out,
+                             ring=256, groups=groups, **(pg or {}))
+
+
+def _ungroup(o: torch.Tensor, H: int) -> torch.Tensor:
+    G, R, W = o.shape
+    return o.view(G, R, W // 512, 512).permute(1, 0, 2, 3).reshape(R, H, 512)
+
+
+@pytest.mark.parametrize("bmq", [16, 32])
+@pytest.mark.parametrize("groups", [4, 2])
+def test_grouped_store_equals_default(monkeypatch, bmq, groups):
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN_BMQ", str(bmq))
+    R, P, ncomp = 5, 900, 700
+    q, comp, swa_t, _, sink, cs = _attn_case(R, P, ncomp, 41)
+    tok, cnt, _ = _lists(R, ncomp, 42, sizes=[512, 300, 1, 129, 64])
+    lo = torch.zeros(R, dtype=torch.int32)
+    want = _run(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    got = _run(q, comp, tok, cnt, swa_t, lo, P, sink, cs, groups)
+    assert tuple(got.shape) == (groups, R, 32 // groups * 512)
+    assert torch.equal(_bits(_ungroup(got, 32)), _bits(want))
+    # SWA only (layers 0-1), bounded replay windows
+    lo2 = torch.tensor([0, 0, 40, 40, 61], dtype=torch.int32)
+    want = _run(q, None, None, None, swa_t, lo2, 60, sink, cs)
+    got = _run(q, None, None, None, swa_t, lo2, 60, sink, cs, groups)
+    assert torch.equal(_bits(_ungroup(got, 32)), _bits(want))
+
+
+def test_grouped_store_paged_and_refusals():
+    R, P, ncomp = 4, 1000, 300
+    q, comp, swa_t, _, sink, cs = _attn_case(R, P, ncomp, 43)
+    tok, cnt, _ = _lists(R, ncomp, 44)
+    lo = torch.zeros(R, dtype=torch.int32)
+    page, n_log = 64, triton.cdiv(ncomp, 64)
+    pt = torch.randperm(n_log + 2, generator=torch.Generator().manual_seed(45))[:n_log].to(torch.int32).contiguous()
+    pv = torch.full(((n_log + 2) * page, RW.VB), 0x7F, dtype=torch.uint8)
+    ps = torch.full(((n_log + 2) * page, RW.SB), 0xFF, dtype=torch.uint8)
+    for j in range(ncomp):
+        pv[int(pt[j // page]) * page + j % page] = comp[0][j]
+        ps[int(pt[j // page]) * page + j % page] = comp[1][j]
+    pg = {"page_table": pt, "page_shift": 6}
+    want = _run(q, comp, tok, cnt, swa_t, lo, P, sink, cs)
+    got = _run(q, (pv, ps), tok, cnt, swa_t, lo, P, sink, cs, 4, pg)
+    assert torch.equal(_bits(_ungroup(got, 32)), _bits(want))
+    bad = torch.zeros((4, R + 1, 8 * 512), dtype=torch.bfloat16)
+    with pytest.raises(ValueError):
+        attn_pf.attention(q, comp, tok, cnt, swa_t, lo, torch.tensor([P], dtype=torch.int32), sink, cs, bad,
+                          ring=256, groups=4)
+    with pytest.raises(ValueError):
+        attn_pf.attention(q, comp, tok, cnt, swa_t, lo, torch.tensor([P], dtype=torch.int32), sink, cs,
+                          torch.zeros((3, R, 512), dtype=torch.bfloat16), ring=256, groups=3)
+
+
+SHAPES = {"num_attention_heads": 16, "head_dim": 512, "qk_rope_head_dim": 64, "o_groups": 2, "o_lora_rank": 128,
+          "index_n_heads": 32, "index_head_dim": 128, "sliding_window": 128, "rms_norm_eps": 1e-20}
+
+
+def test_forward_copies_on_equals_off(tmp_path, monkeypatch):
+    """The fast-tag forward on the Triton backend with the fused prefill attention: copies on == off (the prompt's
+    last row and the next decode step, bit for bit), and the grouped store fed wo_a on every prefill segment."""
+
+    import json
+
+    import dsv41_fakes as FK
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import forward as FW
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+
+    monkeypatch.setenv("TF_DSV41_PREFILL_KERNELS", "fast")
+    monkeypatch.setenv("TF_DSV41_PREFILL_ATTN", "fused")
+    root = FK.write_checkpoint(tmp_path, **SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    table = FK.engram_table(cfg)
+    ids = torch.randint(0, 256, (21,), generator=torch.Generator().manual_seed(46)).tolist()
+    grouped = []
+    real = Triton.attention_grouped
+
+    def spy(self, *a):
+        o = real(self, *a)
+        grouped.append(o is not None)
+        return o
+
+    monkeypatch.setattr(Triton, "attention_grouped", spy)
+
+    def run(copies: bool, pchunk: int):
+        monkeypatch.setenv("TF_DSV41_PF_COPIES", "1" if copies else "0")
+        tmap = FK.token_map(cfg)
+        tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+        rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+        fw = FW.Forward(cfg, tree, csa2=Triton(8, cfg.num_attention_heads, "cpu"), limit=64, chunk=1, pchunk=pchunk,
+                        engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+        last = fw.prompt(ids[:-1])
+        return torch.cat([last, fw.step([ids[-1]])])
+
+    off = run(False, 20)
+    assert not grouped
+    on = run(True, 20)
+    assert grouped and all(grouped)
+    assert torch.equal(on, off)
+    assert torch.equal(run(True, 8), off)           # chunked: the fast tag's rows do not depend on the segment
