@@ -0,0 +1,389 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Expert-budgeted verification (``TF_DSV41_VERIFY_BUDGET=B``, default unset = exact): a LOSSY speed mode for verify
+windows. Decode is bound by routed-expert bytes (G9: a 1-row window ~31 ms, row 2 +6.3 ms of which ~5 ms is new
+experts, each later row ~+3.7 ms), so the draft rows of a window are routed inside a small per-layer expert set.
+
+Per verify segment (one slot's window: the pending row, then its drafts) and per layer:
+
+- **row 1 (the pending, already-committed token) is exact**: the router's picks and weights, bit for bit;
+- the **allowed set** is row 1's experts (the anchors) plus at most ``B`` more, the experts outside the anchors
+  ranked by their acceptance-weighted router mass over the segment's draft rows (AcceptMoE, arXiv 2608.02989):
+  u_e = sum over draft rows q >= 1 and their natural top-6 slots holding e of alpha_q * w_q,slot, alpha_q =
+  r^q with r = ``ACCEPT`` ** ``BETA`` (p_d = ACCEPT^d is the chance draft position d is committed; AcceptMoE's
+  alpha = p^beta, beta 0.5). ACCEPT = 1 is MoE-Spec's plain summed mass (arXiv 2602.16052). Ties: the lower id;
+- a draft row's out-of-budget slots are **substituted** (``MODE=sub``, MoE-Spec's default; AcceptMoE's reroute
+  TopK(z + M_S)) by its best allowed experts it does not already use, in the router's selection order (s + bias
+  desc, id asc), slot by slot in slot order, or **dropped** (``MODE=drop`` or no allowed expert left: weight 0 and
+  an id past the table, prune.py's mechanism: upstream's ``group`` never lists it, so it is never read);
+- weights stay normalized by the ORIGINAL top-6 mass (Training-Free Halving, arXiv 2609.04575): kept slots keep the
+  router's weight; a substitute e gets 1.5 s_e / sum_top6 s, computed as w_0 (s_e / s_0) from the row's own logits
+  (slot 0's weight and score); nothing is renormalized up.
+
+**Exactness trade-off, plainly.** Row 1 of every segment is exact, so the token the round commits first (the
+target's choice after the pending row) is the exact model's. Every LATER token a round accepts comes from an
+approximate verification: drafted == serial does NOT hold, and greedy output differs from the exact model's (G10
+measures by how much). The accepted draft rows' cache entries (SWA ring, compressed rows, index keys, ratio-2 carry,
+DSpark taps) are kept as computed, i.e. approximate, so later rows (row 1 of the next round included) attend to an
+approximate context: row 1 is exact GIVEN the cache, not the exact model's continuation. What still holds: a segment's rows depend only on that segment's rows (per-slot budgets: no
+reduction across segments), so batched == alone per slot, row mode == per-segment runs, graph replay == eager, and
+both ranks compute the same (replicated router, the same integer / fp32 steps). Tree rounds: each branch is its own
+segment (its own budget, its own exact pending row). Prompt rows, CED replays and the DSpark drafter never budget.
+
+**Ranking arithmetic** (the same bits on GPU, interpreter and the torch ``reference``): alpha by repeated fp32
+multiplication, u = fp32(alpha w) quantized to integers u_int = floor(u 2^20 + 0.5), sums in int32 (exact, order-
+free); ranks by (sum desc, id asc). The substitute order uses the fp32 softplus / sqrt of the logits (GPU and the
+reference may differ by an ulp there: only near-ties could reorder; tests compare weights to 1e-6).
+
+**Layout** (``window``, set by ``Forward._run`` for non-prefill runs): int32 meta [2, R]: A = the row's segment's
+first row, N = its real rows; a row's depth is min(r - A, N - 1) (padding rows of row mode mirror the last real row:
+its depth, its picks, so its experts; they never vote). Row mode derives the meta from the row table in the graph
+(``meta_rows``: a segment's first row has prev == rslot); per-segment runs fill it (``meta_spans``). Segments of more
+than ``SEG`` = 16 rows (not a verify window) and 1-row windows stay exact.
+
+Cost: one launch a layer, one program a row ([128, 128] integer tiles, ~3-5 us), + the router keeping its logits
+(it computes them anyway). Knobs (read at import; a bad value refuses to start):
+
+``TF_DSV41_VERIFY_BUDGET``         B >= 0 extra experts a layer a segment (unset / off: exact verification)
+``TF_DSV41_VERIFY_BUDGET_MODE``    sub (default) | drop
+``TF_DSV41_VERIFY_BUDGET_ACCEPT``  per-position acceptance ACCEPT in (0, 1] (default 0.6; 1 = uniform)
+``TF_DSV41_VERIFY_BUDGET_BETA``    the acceptance exponent (default 0.5)
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from contextlib import contextmanager
+from dataclasses import dataclass
+
+import torch
+import triton
+import triton.language as tl
+
+ENV, ENV_MODE, ENV_ACCEPT, ENV_BETA = ("TF_DSV41_VERIFY_BUDGET", "TF_DSV41_VERIFY_BUDGET_MODE",
+                                       "TF_DSV41_VERIFY_BUDGET_ACCEPT", "TF_DSV41_VERIFY_BUDGET_BETA")
+KNOBS = (ENV, ENV_MODE, ENV_ACCEPT, ENV_BETA)
+OFF = ("", "off", "none", "exact", "no", "false")
+MODES = ("sub", "drop")
+SEG = 16                    # rows a segment the kernel takes (rowtab.SEG_MAX); longer segments stay exact
+KP = 8                      # routed slots padded (top-k <= 8)
+QUANT = 1048576.0           # 2^20: utility quantum
+
+
+@dataclass(frozen=True)
+class Cfg:
+    budget: int | None = None       # None: off (exact)
+    mode: str = "sub"
+    accept: float = 0.6
+    beta: float = 0.5
+
+    @property
+    def on(self) -> bool:
+        return self.budget is not None
+
+    @property
+    def ratio(self) -> float:
+        """r = ACCEPT ** BETA as fp32 (alpha_q = r^q by repeated fp32 multiplication)."""
+
+        return float(torch.tensor(self.accept ** self.beta, dtype=torch.float32))
+
+    def describe(self) -> str:
+        if not self.on:
+            return "verify budget off (exact)"
+        return f"verify budget B {self.budget}, {self.mode}, accept {self.accept:g}^{self.beta:g} (LOSSY)"
+
+
+def parse(env: dict | None = None) -> Cfg:
+    env = os.environ if env is None else env
+    raw = env.get(ENV, "").strip().lower()
+    if raw in OFF:
+        b = None
+    else:
+        try:
+            b = int(raw)
+        except ValueError:
+            b = -1
+        if not 0 <= b <= 64:
+            raise ValueError(f"{ENV}={raw!r}: an integer 0..64 (unset / off: exact)")
+    mode = env.get(ENV_MODE, "").strip().lower() or "sub"
+    if mode not in MODES:
+        raise ValueError(f"{ENV_MODE}={mode!r}: one of {MODES}")
+    try:
+        acc = float(env.get(ENV_ACCEPT, "").strip() or "0.6")
+        beta = float(env.get(ENV_BETA, "").strip() or "0.5")
+    except ValueError:
+        raise ValueError(f"{ENV_ACCEPT} / {ENV_BETA}: numbers") from None
+    if not 0.0 < acc <= 1.0 or not 0.0 <= beta <= 4.0:
+        raise ValueError(f"{ENV_ACCEPT} in (0, 1], {ENV_BETA} in [0, 4]")
+    return Cfg(b, mode, acc, beta)
+
+
+CFG = parse()
+_TL = threading.local()
+
+
+@dataclass
+class Plan:
+    """A window's budget layout: ``meta`` int32 [2, R] (A, N), the rule."""
+
+    meta: torch.Tensor
+    cfg: Cfg
+
+
+# -- the window's layout -----------------------------------------------------------------------------------------
+def meta_rows(rslot: torch.Tensor, wslot: torch.Tensor, prev: torch.Tensor) -> torch.Tensor:
+    """Row mode (``rowtab``): the meta of the table's rows, on the device (torch ops: graph-capturable). A segment's
+    first row is the real row with prev == rslot (its carry); padding rows (wslot -1) join their mirror's segment."""
+
+    R = rslot.shape[0]
+    q = torch.arange(R, device=rslot.device)
+    same = rslot[:, None] == rslot[None, :]
+    real = wslot >= 0
+    first = (prev == rslot) & real
+    cand = same & first[None, :] & (q[None, :] <= q[:, None])
+    A = torch.where(cand, q[None, :], torch.full_like(cand, -1, dtype=q.dtype)).amax(1)
+    N = (same & real[None, :]).sum(1)
+    bad = (A < 0) | (N > SEG)
+    A = torch.where(bad, q, A)
+    N = torch.where(bad, torch.ones_like(N), N)
+    return torch.stack([A, N]).to(torch.int32).contiguous()
+
+
+def meta_spans(spans, n: int, device) -> torch.Tensor | None:
+    """Per-segment runs: the meta of rows [a, b) a segment (fills: graph-capturable); None when every segment is
+    one row or too long (nothing to budget)."""
+
+    if all(not 2 <= b - a <= SEG for a, b in spans):
+        return None
+    meta = torch.empty((2, n), dtype=torch.int32, device=device)
+    for a, b in spans:
+        long_ = b - a > SEG
+        meta[0, a:b].fill_(a)
+        meta[1, a:b].fill_(1 if long_ else b - a)
+    return meta
+
+
+@contextmanager
+def window(spans, rv=None, *, n: int, device, prefill: bool = False, cfg: Cfg | None = None):
+    """``Forward._run``'s layers of a non-prefill run: the budget plan the MoE blocks read (``current``). Prompt
+    rows (``prefill``) and an off knob: nothing."""
+
+    cfg = CFG if cfg is None else cfg
+    plan = None
+    if cfg.on and not prefill:
+        if rv is not None:
+            w = rv.win
+            meta = meta_rows(w.rslot[:n], w.wslot[:n], w.prev[:n]) if n > 1 and w.prev is not None else None
+        else:
+            meta = meta_spans(spans, n, device)
+        plan = Plan(meta, cfg) if meta is not None else None
+    old = getattr(_TL, "plan", None)
+    _TL.plan = plan
+    try:
+        yield plan
+    finally:
+        _TL.plan = old
+
+
+def current() -> Plan | None:
+    return getattr(_TL, "plan", None)
+
+
+def plan_for(moe, R: int) -> Plan | None:
+    """The plan a MoE call of ``R`` rows uses (None: exact)."""
+
+    p = current()
+    if p is None or p.meta.shape[1] != R or R < 2 or int(moe.topk) > KP:
+        return None
+    return p
+
+
+# -- the rule: torch reference -----------------------------------------------------------------------------------
+def _alpha(q: int, ratio: float) -> torch.Tensor:
+    a = torch.tensor(1.0, dtype=torch.float32)
+    r = torch.tensor(ratio, dtype=torch.float32)
+    for _ in range(q):
+        a = a * r
+    return a
+
+
+def _score(z: torch.Tensor) -> torch.Tensor:
+    """sqrt(router._softplus(z)) in fp32."""
+
+    z = z.to(torch.float32)
+    e = torch.exp(torch.minimum(z, torch.tensor(20.0)))
+    tiny = e - 0.5 * (e * e)
+    sp = torch.where(z > 20.0, z, torch.where(z < -10.0, tiny, torch.log(1.0 + e)))
+    return torch.sqrt(sp)
+
+
+def allowed_sets(pick, wts, meta, topk: int, budget: int, ratio: float) -> dict[int, tuple[set, list]]:
+    """Each segment's (anchors, the in-budget extras in rank order), keyed by its first row (reference)."""
+
+    out = {}
+    R = pick.shape[0]
+    for r in range(R):
+        A, N = int(meta[0, r]), int(meta[1, r])
+        if A in out or N < 2:
+            continue
+        anchors = {int(v) for v in pick[A, :topk]}
+        tot: dict[int, int] = {}
+        for q in range(1, N):
+            a = _alpha(q, ratio)
+            for j in range(topk):
+                e = int(pick[A + q, j])
+                u = a * wts[A + q, j].to(torch.float32)
+                ui = int(((u * QUANT) + 0.5).to(torch.int32))
+                if e not in anchors:
+                    tot[e] = tot.get(e, 0) + ui
+        ranked = sorted(tot, key=lambda e: (-tot[e], e))
+        out[A] = (anchors, ranked[:budget])
+    return out
+
+
+def reference(pick, wts, lg, bias, meta, topk: int, cfg: Cfg, drop: int):
+    """The kernel's rule in torch, row by row: new (pick, wts) (clones; the shared slots untouched). ``lg``: the
+    router's fp32 logits [R, E] (``sub``)."""
+
+    pick, wts = pick.clone(), wts.clone()
+    K, R = int(topk), pick.shape[0]
+    sets = allowed_sets(pick, wts, meta, K, int(cfg.budget), cfg.ratio)
+    for r in range(R):
+        A, N = int(meta[0, r]), int(meta[1, r])
+        if min(r - A, N - 1) <= 0:
+            continue
+        anchors, extra = sets[A]
+        allowed = anchors | set(extra)
+        mine = [int(v) for v in pick[r, :K]]
+        out = [k for k in range(K) if mine[k] not in allowed]
+        if not out:
+            continue
+        cands = []
+        if cfg.mode == "sub":
+            s = _score(lg[r].to(torch.float32))
+            b = bias.to(torch.float32)
+            cands = sorted((e for e in allowed if e not in mine), key=lambda e: (-float(s[e] + b[e]), e))
+            w0, s0 = wts[r, 0].to(torch.float32).clone(), s[mine[0]].clone()
+        for m, k in enumerate(out):
+            if m < len(cands):
+                e = cands[m]
+                pick[r, k] = e
+                wts[r, k] = (w0 * (s[e] / s0)).to(wts.dtype)
+            else:
+                pick[r, k] = drop
+                wts[r, k] = 0.0
+    return pick, wts
+
+
+# -- the kernel --------------------------------------------------------------------------------------------------
+@triton.jit
+def _softplus(z):
+    e = tl.exp(tl.minimum(z, 20.0))
+    tiny = e - 0.5 * (e * e)
+    return tl.where(z > 20.0, z, tl.where(z < -10.0, tiny, tl.log(1.0 + e)))
+
+
+@triton.jit
+def _budget(PICK, WTS, LG, BIAS, META, OP, OW, R, stride, lstride, ostride, B, RATIO, DROP, K: tl.constexpr,
+            SLOTS: tl.constexpr, KP: tl.constexpr, SEG: tl.constexpr, SUB: tl.constexpr, QUANT: tl.constexpr):
+    """Program (row r): ``reference``'s steps for row r (its segment's [SEG, KP] picks as N = SEG KP entries), the
+    whole row written to (OP, OW): programs read their segment-mates' rows, so the inputs are never written."""
+
+    r = tl.program_id(0)
+    A = tl.load(META + r)
+    NR = tl.load(META + R + r)
+    depth = tl.minimum(r - A, NR - 1)
+    N: tl.constexpr = SEG * KP
+    i = tl.arange(0, N)
+    qq = i // KP
+    jj = i % KP
+    valid = (qq < NR) & (jj < K)
+    off = (A + qq).to(tl.int64) * stride + jj
+    pid = tl.load(PICK + off, mask=valid, other=-1)
+    w = tl.load(WTS + off, mask=valid, other=0.0)
+    alpha = tl.full((N,), 1.0, tl.float32)
+    for t in tl.static_range(SEG - 1):
+        alpha = tl.where(qq > t, alpha * RATIO, alpha)
+    anc = valid & (qq == 0)
+    con = valid & (qq > 0)
+    ui = tl.where(con, (alpha * w * QUANT + 0.5).to(tl.int32), 0)
+    eq = pid[:, None] == pid[None, :]                                           # [N, N]: entries of one expert
+    is_anc = tl.sum((eq & anc[None, :]).to(tl.int32), 1) > 0
+    tot = tl.sum(tl.where(eq, ui[None, :], 0), 1)
+    before = tl.sum((eq & con[None, :] & (i[None, :] < i[:, None])).to(tl.int32), 1) > 0
+    rep = con & ~is_anc & ~before
+    ahead = rep[None, :] & ((tot[None, :] > tot[:, None]) | ((tot[None, :] == tot[:, None]) &
+                                                              (pid[None, :] < pid[:, None])))
+    rank = tl.sum(ahead.to(tl.int32), 1)
+    allow = anc | (rep & (rank < B))                                            # one entry an allowed expert
+    k = tl.arange(0, KP)
+    kok = k < K
+    prow = r.to(tl.int64) * stride
+    sok = k < SLOTS
+    rowp = tl.load(PICK + prow + k, mask=sok, other=0)
+    roww = tl.load(WTS + prow + k, mask=sok, other=0.0)
+    mine = tl.where(kok, rowp, -2)
+    ok = tl.sum((mine[:, None] == pid[None, :]) & allow[None, :], 1) > 0
+    out = kok & ~ok
+    m = tl.sum((out[None, :] & (k[None, :] < k[:, None])).to(tl.int32), 1)     # out slots before slot k
+    new_id = tl.zeros((KP,), tl.int32) + DROP
+    new_w = tl.zeros((KP,), tl.float32)
+    if SUB:
+        cand = allow & (tl.sum((pid[:, None] == mine[None, :]).to(tl.int32), 1) == 0)
+        lrow = r.to(tl.int64) * lstride
+        s = tl.sqrt_rn(_softplus(tl.load(LG + lrow + pid, mask=cand, other=0.0)))
+        c = tl.where(cand, s + tl.load(BIAS + pid, mask=cand, other=0.0).to(tl.float32), float("-inf"))
+        crank = tl.sum((cand[None, :] & ((c[None, :] > c[:, None]) | ((c[None, :] == c[:, None]) &
+                                                                      (pid[None, :] < pid[:, None])))).to(tl.int32), 1)
+        sel = cand[None, :] & (crank[None, :] == m[:, None])                    # [KP, N]
+        has = tl.sum(sel.to(tl.int32), 1) > 0
+        sid = tl.sum(tl.where(sel, pid[None, :], 0), 1)
+        snew = tl.sum(tl.where(sel, s[None, :], 0.0), 1)
+        p0 = tl.load(PICK + prow)
+        s0 = tl.sqrt_rn(_softplus(tl.load(LG + lrow + p0)))
+        w0 = tl.load(WTS + prow)
+        new_id = tl.where(has, sid, new_id)
+        new_w = tl.where(has, w0 * tl.math.div_rn(snew, s0), new_w)
+    st = out & (depth > 0)
+    orow = r.to(tl.int64) * ostride
+    tl.store(OP + orow + k, tl.where(st, new_id, rowp), mask=sok)
+    tl.store(OW + orow + k, tl.where(st, new_w, roww), mask=sok)
+
+
+def apply(pick: torch.Tensor, wts: torch.Tensor, lg: torch.Tensor | None, bias: torch.Tensor, meta: torch.Tensor,
+          topk: int, cfg: Cfg, drop: int):
+    """Budgeted (pick int32 [R, slots], wts fp32): new tensors (one launch; graph-safe; the inputs are read by every
+    row's program, so they stay as they are). ``lg``: the router's fp32 logits [R, E] (needed for ``sub``). CPU
+    tensors without the interpreter run ``reference``."""
+
+    R = pick.shape[0]
+    if R < 2 or not cfg.on:
+        return pick, wts
+    sub = cfg.mode == "sub"
+    if sub and lg is None:
+        raise ValueError("verify budget (sub): the router's logits are needed")
+    if topk > KP or pick.stride(1) != 1 or wts.stride(1) != 1 or pick.stride(0) != wts.stride(0):
+        raise ValueError(f"verify budget: top-k <= {KP}, unit-stride rows of one stride")
+    if not pick.is_cuda and os.environ.get("TRITON_INTERPRET") != "1":
+        return reference(pick, wts, lg, bias, meta, topk, cfg, drop)
+    if wts.dtype != torch.float32 or pick.dtype != torch.int32 or meta.dtype != torch.int32:
+        raise ValueError("verify budget: wts fp32, pick / meta int32 (before kit_weights)")
+    lgt = lg if sub else wts
+    b = bias if bias.dtype == torch.float32 else bias.float()
+    if pick.shape[1] > KP:
+        raise ValueError(f"verify budget: at most {KP} slots a row")
+    op, ow = torch.empty_like(pick, memory_format=torch.contiguous_format), torch.empty_like(
+        wts, memory_format=torch.contiguous_format)
+    _budget[(R,)](pick, wts, lgt, b, meta.contiguous(), op, ow, R, pick.stride(0), lgt.stride(0), op.stride(0),
+                  int(cfg.budget), cfg.ratio, int(drop), K=int(topk), SLOTS=int(pick.shape[1]), KP=KP, SEG=SEG,
+                  SUB=sub, QUANT=QUANT, num_warps=8)
+    return op, ow
+
+
+def describe(cfg: Cfg | None = None) -> str:
+    return (CFG if cfg is None else cfg).describe()
+
+
+__all__ = ["CFG", "Cfg", "KNOBS", "Plan", "allowed_sets", "apply", "current", "describe", "meta_rows", "meta_spans",
+           "parse", "plan_for", "reference", "window"]
