+# -- the Triton kernels compiled for sm_121 (Triton's own ptxas; skipped if this Triton cannot target it) ------------
+def _compile(fn, sig, consts, pdl):
+    import triton
+    from triton.backends.compiler import GPUTarget
+    from triton.compiler import ASTSource
+
+    src = ASTSource(fn, dict(sig, PDL="constexpr"), constexprs=dict(consts, PDL=pdl))
+    try:
+        k = triton.compile(src, target=GPUTarget("cuda", 121, 32), options={"num_warps": 4, "launch_pdl": pdl})
+    except Exception as e:  # noqa: BLE001 - no ptxas / backend for sm_121 here
+        pytest.skip(f"Triton cannot compile for sm_121 here: {type(e).__name__}: {str(e)[:200]}")
+    return k.asm["ptx"]
+
+
+def _kernels():
+    from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF
+    from tensorfold.families.deepseek_v41.cuda import rmsnorm as RN
+
+    rms = {"X": "*bf16", "x_rs": "i32", "W": "*bf16", "OUT": "*bf16", "o_rs": "i32", "K": "i32", "inv_k": "fp64",
+           "eps": "fp64", "BK": "constexpr", "HAS_W": "constexpr", "NARROW": "constexpr"}
+    pair = {"XA": "*bf16", "xa_rs": "i32", "WA": "*bf16", "OA": "*bf16", "oa_rs": "i32", "KA": "i32",
+            "inv_ka": "fp64", "XB": "*bf16", "xb_rs": "i32", "WB": "*bf16", "OB": "*bf16", "ob_rs": "i32", "KB": "i32",
+            "inv_kb": "fp64", "eps": "fp64", "BK": "constexpr", "NARROW": "constexpr"}
+    plain = {"X": "*bf16", "x_rs": "i32", "W": "*bf16", "w_rs": "i32", "OUT": "*fp64", "K": "i32", "N": "i32",
+             "BK": "constexpr"}
+    return {"_rms": (RN._rms, rms, {"BK": 512, "HAS_W": True, "NARROW": True}),
+            "_rms2": (RN._rms2, pair, {"BK": 512, "NARROW": True}),
+            "_plain": (PF._plain, plain, {"BK": getattr(PF, "BK", 256)})}
+
+
+@pytest.mark.parametrize("name", ["_rms", "_rms2", "_plain"])
+def test_ptx_wait_before_stores_trigger_after(name):
+    fn, sig, consts = _kernels()[name]
+    on, off = _compile(fn, sig, consts, True), _compile(fn, sig, consts, False)
+    assert "griddepcontrol" not in off
+    lines = [ln.strip() for ln in on.splitlines()]
+    w = [i for i, ln in enumerate(lines) if ln.startswith("griddepcontrol.wait")]
+    t = [i for i, ln in enumerate(lines) if ln.startswith("griddepcontrol.launch_dependents")]
+    st = [i for i, ln in enumerate(lines) if re.match(r"(@%p\d+\s+)?st\.global", ln)]
+    assert len(w) == 1 and len(t) == 1 and w[0] < t[0], (w, t)
+    assert st and min(st) > w[0]
+    assert _norm(on) == _norm(off)                       # the same instructions besides the two (register names aside)
+
+
+def _norm(ptx: str) -> list[str]:
+    out = []
+    for ln in ptx.splitlines():
+        ln = ln.strip()
+        if ln and not ln.startswith((".loc", "//", "$L__tmp", "$L__func", ".reg", ".file", "griddepcontrol")):
+            out.append(re.sub(r"%(r|rd|rs|p|f|fd)\d+", r"%\1", ln))
+    return out
