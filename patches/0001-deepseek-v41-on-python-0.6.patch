@@ -0,0 +1,146 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""DSpark self-distillation (``dsparkdata`` / ``dsparktrain`` / ``dsparkdelta``) on the synthetic DSpark checkpoint,
+CPU twin:
+
+- a logged run (TF_DSV41_DRAFT_LOG with taps) becomes training data whose tokens are the replies;
+- the PyTorch port of the drafter reproduces the engine's drafts at the logged passes (fidelity);
+- stage B trains (loss falls), exports a delta; the engine with TF_DSV41_DSPARK_DELTA drafts what the port drafts
+  with the same delta, and replies stay serial;
+- LoRA under TP: the col / row shards of a delta sum to the whole one.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+pytest.importorskip("safetensors")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import dsparkdelta as DD  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import dsparktrain as DT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.depth import Costs  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.dsparkdata import Data, build  # noqa: E402
+
+N_TOK = 40
+NB = 3                                  # the fake checkpoint's DSpark block
+CAP = 720
+PROMPTS = [[int(t) for t in np.random.default_rng(80 + i).integers(3, 250, size=n)] for i, n in enumerate((300, 200, 260))]
+SAMPLINGS = [None, Sampling(seed=3, temperature=0.8, top_k=20, top_p=0.95), None]
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41dsparktrain"))
+
+
+def _run(ck, mp, log=None, delta=None):
+    mp.setenv("TF_DSV41_TREE", "0")
+    mp.setenv("TF_DSV41_DRAFT_SKIP", "0")
+    mp.setenv("TF_DSV41_DRAFT_DEPTH", "5")
+    for k, v in (("TF_DSV41_DRAFT_LOG", log), ("TF_DSV41_DSPARK_DELTA", delta)):
+        if v:
+            mp.setenv(k, str(v))
+        else:
+            mp.delenv(k, raising=False)
+    mp.setenv("TF_DSV41_DRAFT_LOG_TAPS", "1")
+    mp.setenv("TF_DSV41_DRAFT_LOG_TOPK", "16")
+    fw = DF.forward(ck, limit=CAP)
+    b = DF.batcher(ck, fw, capacity=CAP, pool_tokens=4 * CAP)
+    c = Costs([10.0] * 16, 1.0)
+    fw.set_costs(c)
+    b.planner.costs = c
+    got = DF.run(b, [Job(p, N_TOK, s) for p, s in zip(PROMPTS, SAMPLINGS)])
+    if fw.dlog is not None:
+        fw.dlog.flush()
+    return fw, got
+
+
+@pytest.fixture(scope="module")
+def logged(ck, tmp_path_factory):
+    root = tmp_path_factory.mktemp("dsparkdata")
+    with pytest.MonkeyPatch.context() as mp:
+        fw, got = _run(ck, mp, log=root / "log")
+    info = build(str(root / "data"), [str(root / "log")], K=16)
+    return root, got, info
+
+
+def _model(ck, stage="B", rank=4):
+    return DT.Drafter(ck[1], str(ck[0]), "cpu", stage=stage, rank=rank)
+
+
+def test_data_matches_replies(logged):
+    root, got, info = logged
+    d = Data(str(root / "data"), n=NB)
+    assert info["labels"] > 0 and len(d.sess) == len(PROMPTS)
+    seqs = [p + r for p, r in zip(PROMPTS, got)]
+    for si, z in enumerate(d.sess):
+        lo, tok = int(z["lo"]), z["tok"]
+        s = next(q for q in seqs if all(q[lo + i] == t for i, t in enumerate(tok) if t >= 0 and lo + i < len(q)))
+        assert s is not None and z["has_lab"].sum() > 10 and z["has_taps"].sum() > 10
+        ex = d.examples(si)
+        assert len(ex) > 0
+
+
+def test_port_reproduces_engine_drafts(ck, logged):
+    root, _, _ = logged
+    d = Data(str(root / "data"), n=NB)
+    m = _model(ck, "A", 0)
+    ev = DT.evaluate(m, d, list(range(len(d.sess))), seg=16, cands=16)
+    print("[dsparktrain] port fidelity", ev)
+    assert ev["logged_passes"] > 0 and ev["agree_logged_drafts"] >= 0.6
+
+
+def test_train_export_apply(ck, logged, monkeypatch, tmp_path):
+    root, serial, _ = logged
+    d = Data(str(root / "data"), n=NB)
+    m = _model(ck, "B", 4)
+    sess = list(range(len(d.sess)))
+    segs = d.segments(sess, 16)
+    with torch.no_grad():
+        l0 = float(np.mean([DT.losses(m, DT._to(d.batch(s, P), m.dev))[1]["kl"] for s, P in segs]))
+    rep = DT.train(m, d, sess, minutes=0.4, lr=3e-3, seg=16, log=lambda *_: None)
+    with torch.no_grad():
+        l1 = float(np.mean([DT.losses(m, DT._to(d.batch(s, P), m.dev))[1]["kl"] for s, P in segs]))
+    assert rep["steps"] > 3 and l1 < l0
+    path = str(tmp_path / "delta.safetensors")
+    ex = DT.export_delta(m, path)
+    assert ex["lora"] >= 1
+    fw, got = _run(ck, monkeypatch, delta=path)
+    assert got == serial                            # drafts never change a reply
+    assert fw.drafter.delta["lora"] == ex["lora"]
+    # the engine with the delta drafts what the port drafts with it: a fresh log, the port's chain
+    fw2, _ = _run(ck, monkeypatch, log=tmp_path / "log2", delta=path)
+    build(str(tmp_path / "d2"), [str(tmp_path / "log2")], K=16)
+    d2 = Data(str(tmp_path / "d2"), n=NB)
+    ev = DT.evaluate(m, d2, list(range(len(d2.sess))), seg=16, cands=16)
+    assert ev["agree_logged_drafts"] >= 0.6
+
+
+def test_lora_shards_sum_to_whole():
+    g = torch.Generator().manual_seed(0)
+    K, N, r = 64, 48, 4
+    W = torch.randn(K, N, generator=g)
+    A, B = torch.randn(r, K, generator=g), torch.randn(N, r, generator=g)
+    x = torch.randn(5, K, generator=g)
+
+    class Lin:
+        def __init__(self, w):
+            self.w, self.k, self.n = w, w.shape[0], w.shape[1]
+
+        def __call__(self, x, dtype=torch.float32):
+            return (x @ self.w).to(dtype)
+    whole = DD.LoraLin(Lin(W), A, B)(x)
+    assert torch.allclose(whole, x @ (W + (B @ A).t()), atol=1e-4)
+    cols = [DD.LoraLin(Lin(W[:, i * N // 2:(i + 1) * N // 2]), *DD.shard("col", A, B, i, 2))(x) for i in range(2)]
+    assert torch.allclose(torch.cat(cols, 1), whole, atol=1e-4)
+    rows = [DD.LoraLin(Lin(W[i * K // 2:(i + 1) * K // 2]), *DD.shard("row", A, B, i, 2))(x[:, i * K // 2:(i + 1) * K // 2])
+            for i in range(2)]
+    assert torch.allclose(rows[0] + rows[1], whole, atol=1e-4)
