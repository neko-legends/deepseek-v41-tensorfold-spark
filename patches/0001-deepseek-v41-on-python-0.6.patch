+
+def test_sources_agree_with_the_model():
+    """attn_cuda.cu / topk_cuda.cu constants == the Python side (the plan, the limits, the shared memory)."""
+
+    import re
+    from pathlib import Path
+
+    d = Path(AC.__file__).parent
+    tk = (d / "topk_cuda.cu").read_text()
+    at = (d / "attn_cuda.cu").read_text()
+    assert f"MAXCL = {AC.MAX_CL}" in tk and f"MAXEPT = {AC.MAX_EPT}" in tk and f"NT = {AC.TOPK_THREADS}" in tk
+    assert "NCH = 5" in at and "BMQ = 16" in at and AC.NCH == 5 and AC.BMQ == 16
+    sm = [int(x) for x in re.findall(r"SM_\w+ = (?:SM_\w+ \+ )?(\d+)", at)]
+    assert sm and sum(sm[1:]) < 101376
+    w = E.work(1)
+    assert w["ctas"] == 10 and w["grid"] == (5, 2, 1)
