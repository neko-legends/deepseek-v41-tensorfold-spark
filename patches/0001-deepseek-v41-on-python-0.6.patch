+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""G15 on ONE GPU: the expert map (``xmap.cu`` / ``xmap.py``, TF_DSV41_XMAP) and its trace collector.
+
+- kernels: ``prefetch_now`` / ``prefetch_prev`` leave every byte they touch unchanged and write nothing; ``record`` /
+  ``advance`` fill the ring exactly; an x3ld-shaped probe prints what a prefetched gate slab is worth ([G15] lines:
+  a cold read of 6 experts' first split against the same read after the map's prefetch; not asserted);
+- the engine: the synthetic checkpoint's windows through ``CudaGraphs`` with TF_DSV41_XMAP=post / prev / both (site f,
+  paced) and with the trace + pregate == the map off, logits bit for bit; the ring holds the routing of the last eager
+  window; the trace files parse and their picks are the picks the forward reports.
+
+    pytest -q tests/cuda/test_dsv41_g15_xmap_gpu.py   (inside the image; ~2 min)
+"""
+
+from __future__ import annotations
+
+import json
+import statistics as st
+
+import numpy as np
+import pytest
+import torch
+
+if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] < 9:
+    pytest.skip("needs an sm_90+ NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import xmap as XM  # noqa: E402
+
+KNOBS = ("TF_DSV41_XMAP", "TF_DSV41_XMAP_SITE", "TF_DSV41_XMAP_GBPS", "TF_DSV41_XMAP_MB", "TF_DSV41_XMAP_KB",
+         "TF_DSV41_XMAP_ROWS", "TF_DSV41_XMAP_TRACE", "TF_DSV41_XMAP_TRACE_PREGATE", "TF_DSV41_XMAP_TRACE_W",
+         "TF_DSV41_L2PF", "TF_DSV41_PDL")
+K, N, SK, E = 5120, 1152, 4, 384
+
+
+@pytest.fixture(autouse=True)
+def _knobs_off(monkeypatch):
+    for k in KNOBS:
+        monkeypatch.delenv(k, raising=False)
+
+
+def _experts(n: int, k2: int = 6):
+    slab = XM.slab_bytes(K, N, SK, k2)
+    gate = torch.randint(-2**31, 2**31 - 1, (n, SK * slab // 4), dtype=torch.int32, device="cuda")   # whole gates
+    ptr = torch.zeros(E + 1, dtype=torch.int64, device="cuda")
+    ptr[:n] = torch.tensor([gate[i].data_ptr() for i in range(n)], dtype=torch.int64)
+    ptr[n:] = gate[0].data_ptr()
+    k2s = torch.full((E + 1,), k2, dtype=torch.int32, device="cuda")
+    return gate, ptr, k2s, slab
+
+
+def test_kernels_read_only_and_ring():
+    ext = XM._ext()
+    gate, ptr, k2s, slab = _experts(16)
+    ref = gate.clone()
+    pick = torch.tensor([[1, 3, 5, 7, 9, 11, E], [3, 5, 2, 4, 6, E + 1, E]], dtype=torch.int32, device="cuda")
+    ext.prefetch_now(pick, ptr, k2s, E, K, N, SK, 0, 12 << 20, 32768, 0)
+    ext.prefetch_now(pick, ptr, k2s, E, K, N, SK, 65536, 1 << 20, 32768, 256)          # capped and paced
+    ring = torch.full((4, 3, 16, 7), -1, dtype=torch.int32, device="cuda")
+    ctr = torch.zeros(1, dtype=torch.int64, device="cuda")
+    hdr = torch.zeros(4, dtype=torch.int32, device="cuda")
+    ext.prefetch_prev(ring, ctr, hdr, 1, ptr, k2s, E, K, N, SK, 0, 4 << 20, 32768, 0)  # no window yet: nothing
+    for w in range(6):
+        p = torch.randint(0, 16, (2 + w % 3, 7), dtype=torch.int32, device="cuda")
+        for L in range(3):
+            ext.record(p, ring, ctr, L)
+        ext.prefetch_prev(ring, ctr, hdr, 2, ptr, k2s, E, K, N, SK, 0, 4 << 20, 32768, 0)
+        ext.advance(ctr, hdr, p.shape[0])
+        torch.cuda.synchronize()
+        slot = w % 4
+        assert int(ctr.item()) == w + 1 and int(hdr[slot]) == p.shape[0]
+        assert all(torch.equal(ring[slot, L, :p.shape[0]], p) for L in range(3))
+    torch.cuda.synchronize()
+    assert torch.equal(gate, ref)
+
+
+def test_prefetched_slab_probe():
+    """What the map buys a launch that starts on 6 experts' first gate split (printed, not asserted)."""
+
+    ext = XM._ext()
+    gate, ptr, k2s, slab = _experts(6)
+    pick = torch.tensor([[0, 1, 2, 3, 4, 5, E]], dtype=torch.int32, device="cuda")
+    views = [gate[i, :slab // 4] for i in range(6)]
+    flush = torch.empty(64 << 20, dtype=torch.uint8, device="cuda")
+    out = torch.empty(6, dtype=torch.int64, device="cuda")
+
+    def read():
+        for i, v in enumerate(views):
+            out[i] = v.sum(dtype=torch.int64)
+
+    res = {}
+    for name, pre in (("cold", None), ("mapped", True)):
+        ts = []
+        for _ in range(7):
+            flush.fill_(1)
+            if pre:
+                ext.prefetch_now(pick, ptr, k2s, E, K, N, SK, 0, 12 << 20, 32768, 0)
+                torch.cuda._sleep(200_000)                                  # ~the chain head's lead
+            a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            a.record()
+            read()
+            b.record()
+            b.synchronize()
+            ts.append(a.elapsed_time(b) * 1e3)
+        res[name] = st.median(ts)
+    print(f"[G15] 6 x {slab / 2**10:.0f} KiB gate splits: cold {res['cold']:.1f} us, after the map's prefetch "
+          f"{res['mapped']:.1f} us ({6 * slab / res['cold'] / 1e3:.0f} -> {6 * slab / res['mapped'] / 1e3:.0f} GB/s)")
+
+
+@pytest.mark.parametrize("variant", [{"TF_DSV41_XMAP": "post"},
+                                     {"TF_DSV41_XMAP": "prev"},
+                                     {"TF_DSV41_XMAP": "both", "TF_DSV41_XMAP_SITE": "f", "TF_DSV41_XMAP_GBPS": "150"},
+                                     {"TF_DSV41_XMAP_TRACE": "@", "TF_DSV41_XMAP_TRACE_PREGATE": "1",
+                                      "TF_DSV41_XMAP_TRACE_W": "8"}],
+                         ids=["post", "prev", "both-f-paced", "trace-pregate"])
+def test_engine_windows_xmap_equals_off(monkeypatch, tmp_path, variant):
+    import dsv41_dspark_fakes as DF
+
+    from tensorfold.families.deepseek_v41.cuda import graphs as G
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    monkeypatch.setenv("TF_DSV41_SEAMS", "torch")
+    monkeypatch.setenv("TF_DSV41_EXPERT_LOADS", "1")
+    ck = DF.ckpt(tmp_path / "ck")
+    settings = {"on": True, "budget_s": 120.0, "max_graphs": 64, "bucket": 2048, "slots": 2}
+    prompts = [[int(t) for t in np.random.default_rng(50 + i).integers(3, 250, size=300 + 17 * i)] for i in range(2)]
+    on_env = {k: (str(tmp_path / "trace") if v == "@" else v) for k, v in variant.items()}
+
+    def apply(on: bool):
+        for k in set(KNOBS) | set(on_env):
+            monkeypatch.delenv(k, raising=False)
+        if on:
+            for k, v in on_env.items():
+                monkeypatch.setenv(k, v)
+
+    def build(on: bool):
+        apply(on)
+        fw = DF.forward(ck, slots=2, limit=4096, dspark=False, device="cuda", chunk=128)
+        b = DF.batcher(ck, fw, n=2, capacity=4096, pool_tokens=3 * 4096)
+        fw.graphs = G.CudaGraphs(fw, settings=settings)
+        fw.graphs.warmup(2, lambda s, end: b.ex.slots[s].ensure(end))
+        for s in range(2):
+            b.ex.slots[s].ensure(4096)
+            fw.reset(s)
+            fw.prefill([Piece(s, 0, tuple(prompts[s]))], mode="full")
+        return fw
+
+    on, off = build(True), build(False)
+    xm = getattr(on, "xmap", None)
+    assert xm is not None and getattr(off, "xmap", None) is None
+    rng = np.random.default_rng(6)
+    for step in range(10):
+        widths = [int(rng.choice(G.WIDTHS)) for _ in range(2)]
+        segs = [Seg(s, off.slots[s].pos, tuple(int(t) for t in rng.integers(3, 250, size=widths[s])))
+                for s in range(2) if step % 3 or s == 0]
+        out = {}
+        for name, fw in (("on", on), ("off", off)):
+            apply(name == "on")
+            out[name] = fw.graphs.run(segs).clone()
+        assert torch.equal(out["on"], out["off"]), (step, widths)
+        for sg in segs:
+            for fw in (on, off):
+                fw.keep(sg.slot, len(sg.ids) // 2)
+    # one eager window: the ring's newest slot holds exactly the picks the forward reports
+    apply(True)
+    seg = [Seg(0, on.slots[0].pos, (5, 6, 7))]
+    on.run(seg)
+    torch.cuda.synchronize()
+    if xm.s.records:
+        slot = (int(xm.ctr.item()) - 1) % xm.W
+        R = int(xm.hdr[slot])
+        assert R == 3
+        for idx, (L, pick) in enumerate(sorted(on.routing().items())):
+            assert torch.equal(xm.ring[slot, idx, :R, :pick.shape[1]], pick[:R]), L
+    if xm.s.trace:
+        xm.drain()
+        files = sorted((tmp_path / "trace").glob("*.npz"))
+        assert files
+        n = 0
+        for f in files:
+            z = np.load(f)
+            meta = [json.loads(x) for x in f.with_suffix(".jsonl").read_text().splitlines() if '"seq"' in x]
+            assert [m["seq"] for m in meta] == list(z["seq"]) and "pre_next" in z and "pre_attn" in z
+            n += len(meta)
+        assert n == xm.stats.drained > 0
+    print(f"[G15] engine xmap {variant}: post {xm.stats.post}, prev {xm.stats.prev}, records {xm.stats.records}, "
+          f"windows {xm.stats.windows}, drained {xm.stats.drained}")
