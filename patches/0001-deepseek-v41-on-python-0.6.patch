+def test_virtual_ids_are_dead_for_engram():
+    import dsv41_fakes as FK
+
+    from tensorfold.families.deepseek_v41.cuda import engram as EG
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda.config import Config
+
+    cfg = Config.from_dict(FK.config())
+    tmap = FK.token_map(cfg)
+    h = EH.NgramHasher(cfg, tmap)
+    g = torch.Generator().manual_seed(1)
+    ids = torch.randint(0, cfg.vocab_size, (20,), generator=g)
+    dead = torch.zeros(20, dtype=torch.bool)
+    dead[6:11] = True
+    virt = ids.clone()
+    virt[6:11] = torch.arange(VP.VBASE, VP.VBASE + 5)
+    assert torch.equal(h(virt), h(ids, dead))
+    lb = [int(ids[0]), VP.VBASE + 3, int(ids[1])]                 # a chunk boundary inside a span
+    whole = torch.cat([torch.tensor(lb), ids[2:]])
+    assert torch.equal(h(ids[2:], lookback=lb), h(whole, torch.tensor([False, True, False] + [False] * 18))[3:])
+    t = EG.Tables.from_hasher(h)
+    assert (t.rows(virt.numpy()) == h(virt).numpy()).all()
+    assert t.compress([VP.VBASE, int(ids[0])]).tolist() == [EG.DEAD, int(t.token_map[int(ids[0])])]
+    assert (t.compress(ids.numpy()) == t.token_map[ids.numpy()]).all()          # text: unchanged
