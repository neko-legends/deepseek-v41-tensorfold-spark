+
+    for name in (PD.ENV, PD.CFG_ENV, PD.TABLE_ENV):
+        assert name in calib.NOT_KNOBS and name not in calib.KNOBS     # prefill only: no decode window changes
+
+
+# -- sm_121 compile ------------------------------------------------------------------------------------------------
+def _nvcc() -> str | None:
+    for cand in (os.environ.get("TF_NVCC"), shutil.which("nvcc"),
+                 os.path.join(os.environ.get("CUDA_HOME", "/usr/local/cuda"), "bin", "nvcc")):
+        if cand and os.path.exists(cand):
+            try:
+                archs = subprocess.run([cand, "--list-gpu-arch"], capture_output=True, text=True, timeout=60,
+                                       check=False).stdout
+            except (OSError, subprocess.SubprocessError):
+                continue
+            if "compute_121" in archs:
+                return cand
+    return None
+
+
+def _cuobjdump() -> str | None:
+    cands = [os.environ.get("TF_CUOBJDUMP"), shutil.which("cuobjdump")]
+    try:
+        import triton
+
+        cands += glob.glob(str(Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "cuobjdump"))
+    except ImportError:
+        pass
+    return next((c for c in cands if c and os.path.exists(c)), None)
+
+
+KNAME = re.compile(r"_ZN9dsv41_pfd10pfd_kernelILi(\d+)ELb([01])ENS_3CfgILi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)EEEEEvNS_4ArgsE")
+
+
+@pytest.mark.skipif(_nvcc() is None, reason="no nvcc with compute_121 (TF_NVCC)")
+@pytest.mark.parametrize("k2", PD.K2S)
+def test_sm121_compile_no_spills(tmp_path, k2):
+    import tensorfold.cuda.exl3 as upstream
+
+    cu = HERE / f"pfdense_k{k2}.cu"
+    cubin = tmp_path / f"pfdense_k{k2}.cubin"
+    out = subprocess.run([_nvcc(), "-std=c++17", "-O3", "--expt-relaxed-constexpr", f"-I{HERE}",
+                          f"-I{Path(upstream.__file__).parent}", "-gencode=arch=compute_121,code=sm_121", "-Xptxas",
+                          "-v", "-cubin", str(cu), "-o", str(cubin)], capture_output=True, text=True, timeout=1800,
+                         check=False)
+    assert out.returncode == 0, out.stderr[-3000:]
+    blocks = re.split(r"ptxas info\s*: Compiling entry function '", out.stderr)[1:]
+    mains, rows = 0, []
+    for blk in blocks:
+        name = blk.split("'", 1)[0]
+        regs = int(re.search(r"Used (\d+) registers", blk).group(1))
+        st, ss, sl = (int(v) for v in re.search(r"(\d+) bytes stack frame, (\d+) bytes spill stores, (\d+) bytes "
+                                                 r"spill loads", blk).groups())
+        assert (st, ss, sl) == (0, 0, 0), (name, st, ss, sl)
+        m = KNAME.search(name)
+        if m is None:
+            assert "dequant" in name
+            continue
+        mains += 1
+        kk, ln, bm, wm, wn, ks, nst = (int(v) for v in m.groups())
+        cfg = next(c for c, v in E.CFGS.items() if v == (bm, wm, wn, ks, nst))
+        geo = E.Geo(cfg, kk, bool(ln))
+        cap = min(255, (65536 // (geo.THREADS * geo.MINB)) // 8 * 8)
+        assert regs <= cap, (name, regs, cap)
+        rows.append(f"{'L' if ln else 'S'}{cfg}:{regs}")
+    assert mains == len(E.CFGS) * (1 if k2 == 16 else 2)
+    print(f"[G16D] pfdense K2 {k2} sm_121: {mains} kernels, 0 spills / stack; registers " + " ".join(rows))
+    dump = _cuobjdump()
+    if dump is None:
+        return
+    sass = subprocess.run([dump, "-sass", str(cubin)], capture_output=True, text=True, timeout=600,
+                          check=False).stdout
+    assert "LDL" not in sass and "STL" not in sass
+    assert "HMMA.16816.F32.BF16" in sass and re.search(r"HMMA\.16816\.F32(?!\.BF16)", sass)
+    assert "LDGSTS" in sass and "LDSM" in sass
