+# -- grouping and combine emulators (upstream experts.cu: group_kernel, down_combine_kernel) ------------------------
+def group_emu(pick, R: int, slots: int, E: int):
+    """group_kernel: distinct ids < E in id order, members row * 32 + slot in row order."""
+
+    flat = pick.reshape(-1).tolist()[:R * slots]
+    ids = sorted({e for e in flat if 0 <= e < E})
+    members = {e: [(i // slots) * 32 + i % slots for i, v in enumerate(flat) if v == e] for e in ids}
+    return ids, members
+
+
+def combine_emu(pick, wts, y, E: int):
+    """down_combine: every slot's y (recomputed for picks < E, stale otherwise) times its weight, fp32 fma in order."""
+
+    R, slots = pick.shape
+    out = torch.zeros((R, y.shape[-1]), dtype=torch.float32)
+    for r in range(R):
+        acc = torch.zeros(y.shape[-1], dtype=torch.float64)
+        for k in range(slots):
+            acc = (acc + wts[r, k].double() * y[r, k].double()).float().double()
+        out[r] = acc.float()
+    return out
+
+
+def test_grouping_skips_dropped_pairs():
+    pick, wts = _rows(4, 7)                                          # a 4-row verify window
+    rule = PR.Rule(topp=0.8, min_k=2)
+    p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+    T = E + 1                                                        # the table: routed + shared
+    ids0, _ = group_emu(pick, 4, S, T)
+    ids1, mem1 = group_emu(p, 4, S, T)
+    kept = {int(v) for v in p[:, :K].reshape(-1) if int(v) != DROP}
+    assert set(ids1) == kept | {E} and set(ids1) < set(ids0)
+    for e, ms in mem1.items():                                       # every member a kept (row, slot)
+        for code in ms:
+            r, s = divmod(code, 32)
+            assert int(p[r, s]) == e and (s == K or float(w[r, s]) > 0)
+    dropped = {int(pick[r, s]) for r in range(4) for s in range(K) if int(p[r, s]) == DROP}
+    assert not (dropped - kept) & set(ids1)                          # an expert nobody keeps is never read
+    assert len(ids1) < len(ids0)
+
+
+def test_combine_equals_kept_sum_with_stale_y():
+    pick, wts = _rows(6, 8)
+    p, w = PR.reference(pick, wts, K, PR.Rule(topp=0.75, min_k=2), 1.5, DROP)
+    g = torch.Generator().manual_seed(9)
+    y = torch.randn((6, S, 32), generator=g)                         # stale values in dropped pairs' rows
+    got = combine_emu(p, w, y, E + 1)
+    keep = (p != DROP).float()
+    ref = combine_emu(p, w * keep, y * keep[..., None], E + 1)
+    assert torch.equal(got, ref)
+
