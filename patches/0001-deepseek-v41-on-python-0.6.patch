+def test_min_k_never_exceeded_and_mass():
+    pick, wts = _rows(500, 1)
+    for rule in (PR.Rule(topp=0.6, min_k=3, renorm="kept"), PR.Rule(min_w=0.2, min_k=4, renorm="kept"),
+                 PR.Rule(topp=0.3, min_k=1, renorm="kept")):
+        p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+        n = PR.kept(p, K, DROP)
+        assert int(n.min()) >= rule.min_k
+        assert torch.allclose(w[:, :K].double().sum(-1), torch.full((500,), 1.5, dtype=torch.float64), rtol=1e-6)
+        assert torch.equal(p[:, K], pick[:, K]) and torch.equal(w[:, K], wts[:, K])
+        f = wts[:, :K] / wts[:, :K].sum(-1, keepdim=True)
+        for r in range(0, 500, 37):                                  # kept = a prefix by weight
+            kept = p[r, :K] != DROP
+            if (~kept).any():
