--- /dev/null
+++ b/tests/test_dsv41_prune.py
@@ -0,0 +1,311 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""Dynamic routed-expert pruning (families/deepseek_v41/cuda/prune.py) on the CPU: the rule (top-p, the weight floor,
+min-k, ties, untouched rows), the renormalization, the kernel in Triton's interpreter == the torch reference bit for
+bit, row invariance, the knobs and the phase / geometry choice, and an emulator of upstream's ``group`` kernel and
+``down_combine``: a dropped (row, expert) pair is never a group member (no trellis read), an expert nobody keeps is
+never read, and the combine equals the kept experts' sum (stale ``y`` included)."""
+
+from __future__ import annotations
+
+import os
+
+from dsv41_interp import gpu_like, interpret  # noqa: E402,F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import prune as PR  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1"
+E, K, S = 384, 6, 7                # the target's experts, top-k, slots (routed + shared)
+DROP = E + 1                       # the table size: past the shared expert
+
+
+def _rows(R: int, seed: int, K: int = K, E: int = E, scale: float = 1.5):
+    """Router-like rows: distinct ids a row, weights scale * s / sum s (fp32), the shared slot (E, 1.0)."""
+
+    g = torch.Generator().manual_seed(seed)
+    ids = torch.stack([torch.randperm(E, generator=g)[:K] for _ in range(R)]).to(torch.int32)
+    s = torch.rand((R, K), generator=g) ** 3 + 1e-3
+    w = (scale * (s / s.sum(-1, keepdim=True))).to(torch.float32)
+    pick = torch.cat([ids, torch.full((R, 1), E, dtype=torch.int32)], 1).contiguous()
+    wts = torch.cat([w, torch.ones((R, 1))], 1).contiguous()
+    return pick, wts
+
+
+def _row(fr, ids=None):
+    f = torch.tensor([fr], dtype=torch.float32)
+    k = f.shape[1]
+    ids = torch.tensor([ids or list(range(10, 10 + k))], dtype=torch.int32)
+    return torch.cat([ids, torch.tensor([[E]], dtype=torch.int32)], 1), torch.cat([1.5 * f, torch.ones((1, 1))], 1)
+
+
+HALVES = [0.03125, 0.5, 0.0625, 0.25, 0.03125, 0.125]          # exact binary fractions, out of weight order
+
+
+# -- the rule ------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("rule,keep", [
+    (PR.Rule(topp=0.875, min_k=1, renorm="kept"), {1, 3, 5}),                     # exclusive mass 0, .5, .75 < .875; then .875
+    (PR.Rule(topp=0.5, min_k=1, renorm="kept"), {1}),
+    (PR.Rule(topp=0.5, min_k=3, renorm="kept"), {1, 3, 5}),        # min-k wins
+    (PR.Rule(min_w=0.0625, min_k=1, renorm="kept"), {1, 3, 5, 2}),  # f >= 1/16
+    (PR.Rule(min_w=0.07, topp=0.99, min_k=1, renorm="kept"), {1, 3, 5}),  # both: the shorter prefix
+    (PR.Rule(min_w=0.03125, min_k=1, renorm="kept"), set(range(6))),  # all kept: the row is untouched
+])
+def test_rule(rule, keep):
+    pick, wts = _row(HALVES)
+    p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+    got = {i for i in range(K) if int(p[0, i]) != DROP}
+    assert got == keep
+    if len(keep) == K:
+        assert torch.equal(p, pick) and torch.equal(w.view(torch.int32), wts.view(torch.int32))
+        return
+    tot = sum(HALVES[i] for i in keep)
+    for i in range(K):
+        want = 1.5 * HALVES[i] / tot if i in keep else 0.0
+        assert float(w[0, i]) == pytest.approx(want, rel=1e-6)
+    assert float(w[0, :K].sum()) == pytest.approx(1.5, rel=1e-6)
+    assert int(p[0, K]) == E and float(w[0, K]) == 1.0                    # the shared slot is never touched
+
+
+def test_orig_keeps_router_weights():
+    """RENORM=orig (default): kept weights are the router's own bits, dropped ones 0 (the sum shrinks by the dropped
+    mass); same kept set as ``kept``."""
+
+    pick, wts = _rows(200, 11)
+    for rule in (PR.Rule(topp=0.85, min_k=3), PR.Rule(min_w=0.1, min_k=4)):
+        assert rule.renorm == "orig"
+        p, w = PR.reference(pick, wts, K, rule, 1.5, DROP)
+        pk, _ = PR.reference(pick, wts, K, PR.Rule(rule.min_w, rule.topp, rule.min_k, "kept"), 1.5, DROP)
+        assert torch.equal(p, pk)
+        keep = p[:, :K] != DROP
+        assert torch.equal(w[:, :K].view(torch.int32), torch.where(keep, wts[:, :K], 0.0).view(torch.int32))
+        assert bool((w[:, :K].sum(-1) <= 1.5 + 1e-6).all()) and bool((w[:, :K].sum(-1) < 1.4999).any())
+
