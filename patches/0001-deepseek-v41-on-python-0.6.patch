index 0000000..3d1788c
--- /dev/null
+++ b/tests/dsv41_moe_fused_emu.py
@@ -0,0 +1,334 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""A numpy emulator of moe_fused.cu (TF_DSV41_MOE_FUSED): what the fused kernel's tail and combine2 compute, in
+their operation order, and the counter protocol that hands rot_in tasks to the waiting CTAs.
+
+- ``select``: router_gemv's selection (numpy softplus: the same function as ``router_gemv.model_select``), then
+  ``prune_row`` (the kernel's lane-0 transcription of prune._prune) and the kit rounding; pick / wts / pickr.
+- ``rot_in``: upstream's rot_in_kernel per (pair, block, matrix) in the contraction nvcc gives it on sm_121 (x1 s1 and
+  x3 s3 rounded, x0 s0 / x2 s2 fused into the first add / sub), lane-structured butterflies; ``rot_in_plain`` the same
+  without contraction (to show the form matters).
+- ``down_combine`` (upstream) and ``combine2`` (the shared slot's partials from a compact Z).
+- ``protocol``: a step simulator of the arrive / go / next / fin counters over arbitrary dispatch orders, SM slot
+  capacities and claim interleavings (deadlock, every task once, counters back to 0); ``static=True``: G14's
+  TAIL=fast assignment (tasks by arrival rank, no claims).
+- G14: ``select_lanes`` runs one row's selection lane by lane as the kernel does, with the cross-lane argmax either
+  the shuffle butterfly (b1) or the two redux.sync of TAIL=fast (``okey``), on raw fp32 scores (NaN, +-0, -inf too).
+"""
+
+from __future__ import annotations
+
+import numpy as np
+
+from tensorfold.families.deepseek_v41.cuda import router_gemv as RG
+
+F32, F16 = np.float32, np.float16
+HAD = np.float32(0.08838834764831845)
+NB = 40
+LANE = np.arange(32)
+
+
+def _f(v):
+    return np.asarray(v, dtype=F32)
+
+
+def prune_row(w, p, K, min_w, topp, min_k, kept, scale, drop):
+    """moe_fused.cu's prune_row on one row (w fp32 [K], p int [K]); returns new (w, p)."""
+
+    w, p = _f(w).copy(), np.asarray(p).copy()
+    total = F32(0)
+    for i in range(K):
+        total = F32(total + w[i])
+    f = _f([F32(w[i] / total) for i in range(K)])
+    rank = [sum(1 for j in range(K) if f[j] > f[i] or (f[j] == f[i] and j < i)) for i in range(K)]
+    excl, acc = [F32(0)] * K, F32(0)
+    for r in range(K):
+        fr = F32(0)
+        for i in range(K):
+            if rank[i] == r:
+                excl[i], fr = acc, f[i]
+        acc = F32(acc + fr)
+    keep = [(excl[i] < F32(topp) and f[i] >= F32(min_w)) or rank[i] < min_k for i in range(K)]
+    if all(keep):
+        return w, p
+    ks = F32(0)
+    for i in range(K):
+        ks = F32(ks + (w[i] if keep[i] else F32(0)))
+    for i in range(K):
+        w[i] = (F32(F32(scale) * F32(w[i] / ks)) if kept else w[i]) if keep[i] else F32(0)
+        p[i] = p[i] if keep[i] else drop
+    return w, p
+
+
+def select(lg, bias, K, scale, kit=True, rule=None, drop=None):
+    """(pick, wts, pickr) [R, K + 1] as the fused kernel writes them; ``rule`` a prune.Rule or None."""
+
+    lg = _f(lg)
+    R, E = lg.shape
+    s = np.sqrt(RG.softplus32(lg)).astype(F32)
+    ch = (s + _f(bias)[None, :]).astype(F32)
+    pick = np.zeros((R, K + 1), np.int32)
+    wts = np.zeros((R, K + 1), F32)
+    for r in range(R):
+        order = sorted(range(E), key=lambda e: (-float(ch[r, e]), e))[:K]
+        sp = s[r, order]
+        total = F32(0)
+        for t in range(K):
+            total = F32(total + sp[t])
+        w = _f([F32(F32(scale) * F32(sp[t] / total)) for t in range(K)])
+        p = np.array(order, np.int64)
+        if rule is not None:
+            topp = rule.topp if 0.0 < rule.topp < 1.0 else 2.0
+            w, p = prune_row(w, p, K, rule.min_w, topp, rule.min_k, rule.renorm == "kept", scale, drop)
+        if kit:
+            w = w.astype(F16).astype(F32)
+        pick[r, :K], wts[r, :K] = p, w
+        pick[r, K], wts[r, K] = E, 1.0
+    pickr = pick.copy()
+    pickr[:, K] = -1
+    return pick, wts, pickr
+
+
+def _lanes(v):
+    """Upstream's cross-lane butterflies on v [..., 32, 4] (lane-major: element 4 lane + j)."""
+
+    for m in (1, 2, 4, 8, 16):
+        o = v[..., LANE ^ m, :]
+        hi = ((LANE & m) != 0)[:, None]
+        v = np.where(hi, (o - v).astype(F32), (v + o).astype(F32)).astype(F32)
+    return v
+
+
+def fwht128(v):
+    """upstream's fwht128 on v [..., 32, 4] (fp32, no products: no contraction question)."""
+
+    v0, v1, v2, v3 = (v[..., j] for j in range(4))
+    a, b, c, d = (v0 + v1).astype(F32), (v0 - v1).astype(F32), (v2 + v3).astype(F32), (v2 - v3).astype(F32)
+    v = np.stack([(a + c), (b + d), (a - c), (b - d)], -1).astype(F32)
+    return _lanes(v)
+
+
+def _rot(x, s, contracted=True):
+    """One 128-block: x, s fp32 [..., 32, 4] -> fp16 [..., 32, 4]."""
+
+    x0, x1, x2, x3 = (x[..., j] for j in range(4))
+    s0, s1, s2, s3 = (s[..., j] for j in range(4))
+    if contracted:
+        p1, p3 = (x1 * s1).astype(F32), (x3 * s3).astype(F32)
+        a, b = RG.fma32(x0, s0, p1), RG.fma32(x0, s0, -p1)
+        c, d = RG.fma32(x2, s2, p3), RG.fma32(x2, s2, -p3)
+        v = np.stack([(a + c), (b + d), (a - c), (b - d)], -1).astype(F32)
+        v = _lanes(v)
+    else:
+        v = fwht128(np.stack([(x0 * s0), (x1 * s1), (x2 * s2), (x3 * s3)], -1).astype(F32))
+    return (v * HAD).astype(F32).astype(F16)
+
+
+def rot_in(x, suh_g, suh_u, pick, E, contracted=True):
+    """{pair: (xg [D] fp16, xu [D] fp16)} for every pair whose pick is in [0, E)."""
+
+    x = _f(x)
+    R, Dm = x.shape
+    slots = pick.shape[1]
+    out = {}
+    for r in range(R):
+        xb = x[r].reshape(Dm // 128, 32, 4)
+        for k in range(slots):
+            e = int(pick[r, k])
+            if 0 <= e < E:
+                g = _rot(xb, _f(suh_g[e]).reshape(Dm // 128, 32, 4), contracted).reshape(Dm)
+                u = _rot(xb, _f(suh_u[e]).reshape(Dm // 128, 32, 4), contracted).reshape(Dm)
+                out[r * slots + k] = (g, u)
+    return out
+
+
+def _epi(zrows, SK, svh):
+    """down_combine's computed-pair value: splits summed from 0 in order, fwht128, x 1/sqrt(128), x svh."""
+
+    s = np.zeros_like(zrows[0], dtype=F32)
+    for q in range(SK):
+        s = (s + zrows[q]).astype(F32)
+    v = fwht128(s.reshape(-1, 32, 4)).reshape(-1)
+    return ((v * HAD).astype(F32) * _f(svh)).astype(F32)
+
+
+def down_combine(Z, pick, svh_d, y, wts, R, P, Dm, SK, slots, E):
+    """upstream's down_combine_kernel (Z flat [SK * P * D]); returns out, updates y [P, D] in place."""
+
+    Z = _f(Z).reshape(SK, P, Dm)
+    out = np.zeros((R, Dm), F32)
+    for r in range(R):
+        part = []
+        for k in range(slots):
+            p, e = r * slots + k, int(pick[r, k])
+            if 0 <= e < E:
+                y[p] = _epi(Z[:, p], SK, svh_d[e])
+            part.append(y[p].copy())
+        acc = np.zeros(Dm, F32)
+        for q in range(slots):
+            acc = RG.fma32(np.full(Dm, wts[r, q], F32), part[q], acc)
+        out[r] = acc
+    return out
+
+
+def combine2(Z, Zs, pick, svh_d, y, wts, R, P, Ps, Dm, SK, slots, E, ks):
+    """moe_fused.cu's combine2: as down_combine, slot ``ks`` from Zs [SK * Ps * D] at row r."""
+
+    Z, Zs = _f(Z).reshape(SK, P, Dm), _f(Zs).reshape(SK, Ps, Dm)
+    out = np.zeros((R, Dm), F32)
+    for r in range(R):
+        part = []
+        for k in range(slots):
+            p, e = r * slots + k, int(pick[r, k])
+            if 0 <= e < E:
+                y[p] = _epi(Zs[:, r] if k == ks else Z[:, p], SK, svh_d[e])
+            part.append(y[p].copy())
+        acc = np.zeros(Dm, F32)
+        for q in range(slots):
+            acc = RG.fma32(np.full(Dm, wts[r, q], F32), part[q], acc)
+        out[r] = acc
+    return out
+
+
+def protocol(nprod: int, help: int, R: int, capacity: int, nw: int, rng, ordered: bool = False,
+             static: bool = False) -> dict:
+    """Run fused_kernel's arrival / claim protocol under a random interleaving. ``capacity``: CTA slots the GPU gives
+    this kernel; dispatch in index order (``ordered``) or any order; ``static``: TAIL=fast (a CTA of arrival rank q =
+    old - (nprod - 1 - help) runs, warp w, tasks q nw + w, + (help + 1) nw, ...; no claim counter). Returns
+    {"deadlock", "done", "cnt", "roles"}."""
+
+    ntask = R * NB
+    cnt = [0, 0, 0, 0]                                  # arrive, go, next, fin
+    pending = list(range(nprod)) if ordered else list(rng.permutation(nprod))
+    state = {}                                          # cta -> [phase, role]
+    done = np.zeros(ntask, np.int64)
+    roles = {}
+    slots_used = 0
+    while True:
+        acts = []
+        if pending and slots_used < capacity:
+            acts.append(("dispatch", None))
+        for c, (ph, *_rest) in state.items():
+            if ph in ("compute", "select") or (ph == "wait" and cnt[1]) or ph == "claim":
+                acts.append((ph, c))
+        if not acts:
+            break
+        kind, c = acts[rng.integers(len(acts))]
+        if kind == "dispatch":
+            c = int(pending.pop(0))
+            state[c] = ["compute", None]
+            slots_used += 1
+        elif kind == "compute":
+            old = cnt[0]
+            cnt[0] += 1
+            role = 2 if old == nprod - 1 else (1 if old >= nprod - 1 - help else 0)
+            roles[c] = role
+            state[c] = [{2: "select", 1: "wait", 0: "claim_end"}[role], role]
+            if static:
+                state[c].append(old - (nprod - 1 - help))
+        elif kind == "select":
+            cnt[1] = 1
+            state[c][0] = "claim"
+        elif kind == "wait":
+            state[c][0] = "claim"
+        elif kind == "claim" and static:
+            q, nwarps = state[c][2], (help + 1) * nw
+            for w in range(nw):
+                for t in range(q * nw + w, ntask, nwarps):
+                    done[t] += 1
+            state[c][0] = "claim_end"
+        elif kind == "claim":
+            warp_claims = [cnt[2] + i for i in range(nw)]
+            cnt[2] += nw
+            for t in warp_claims:
+                if t < ntask:
+                    done[t] += 1
+            if all(t >= ntask for t in warp_claims):
+                state[c][0] = "claim_end"
+        for cc, st in list(state.items()):              # CTAs at their end: fin, the last one resets
+            if st[0] == "claim_end":
+                if cnt[3] == nprod - 1:
+                    cnt[:] = [0, 0, 0, 0]
+                else:
+                    cnt[3] += 1
+                del state[cc]
+                slots_used -= 1
+    return {"deadlock": bool(pending or state), "done": done, "cnt": cnt, "roles": roles}
+
+
+# -- G14: the selection's cross-lane argmax, lane by lane -------------------------------------------------------------
+EPL = 16
+IMAX = 0x7FFFFFFF
+
+
+def okey(v) -> int:
+    """moe_fused.cu's okey: an order-preserving uint32 key of a non-NaN fp32 (-0 == +0)."""
+
+    v = np.float32(v)
+    if v == 0:
+        v = np.float32(0.0)
+    u = int(np.array(v, F32).view(np.uint32))
+    return (~u & 0xFFFFFFFF) if u & 0x80000000 else (u | 0x80000000)
+
+
+def _lane_best(ch):
+    """Each lane's (bv, bi) by select_row's scan: strict >, from (-inf, IMAX); ch [32, EPL] fp32."""
+
+    bv, bi = [], []
+    for lane in range(32):
+        v, i_ = np.float32(-np.inf), IMAX
+        for i in range(EPL):
+            c = ch[lane, i]
+            if c > v:                                   # NaN compares false: never a candidate
+                v, i_ = c, lane + 32 * i
+        bv.append(v)
+        bi.append(i_)
+    return bv, bi
+
+
+def argmax_butterfly(ch) -> int:
+    bv, bi = _lane_best(ch)
+    for o in (16, 8, 4, 2, 1):
+        nv, ni = bv[:], bi[:]
+        for lane in range(32):
+            ov, oi = bv[lane ^ o], bi[lane ^ o]
+            if ov > bv[lane] or (ov == bv[lane] and oi < bi[lane]):
+                nv[lane], ni[lane] = ov, oi
+        bv, bi = nv, ni
+    assert len(set(bi)) == 1                            # every lane ends equal
+    return bi[0]
+
+
+def argmax_redux(ch) -> int:
+    bv, bi = _lane_best(ch)
+    keys = [0 if bi[lane] == IMAX else okey(bv[lane]) for lane in range(32)]
+    top = max(keys)
+    return min(bi[lane] if keys[lane] == top else IMAX for lane in range(32))
+
+
+def select_lanes(scores, bias, K: int, fast: bool):
+    """One row's (ids, sp, total) as select_row computes them from fp32 scores s [E] (already sqrt-softplus) and
+    bias: K rounds of the cross-lane argmax (butterfly or redux), the winner's s by its lane, the running total."""
+
+    s, b = _f(scores), _f(bias)
+    E = s.shape[0]
+    sl = np.zeros((32, EPL), F32)
+    ch = np.full((32, EPL), -np.inf, F32)
+    for e in range(E):
+        sl[e % 32, e // 32] = s[e]
+        ch[e % 32, e // 32] = np.float32(s[e] + b[e])
+    ids, sp, total = [], [], F32(0)
+    for _ in range(K):
+        bi = argmax_redux(ch) if fast else argmax_butterfly(ch)
+        mine = F32(0)                                   # no lane matched (bi = IMAX): lane 31's 0.0 is shuffled in
+        if bi != IMAX:
+            mine = sl[bi % 32, bi // 32]
+            ch[bi % 32, bi // 32] = -np.inf
+        ids.append(bi)
+        sp.append(mine)
+        total = F32(total + mine)
+    return ids, sp, total
+
+
+__all__ = ["argmax_butterfly", "argmax_redux", "combine2", "down_combine", "fwht128", "okey", "protocol",
+           "prune_row", "rot_in", "select", "select_lanes"]
