--- /dev/null
+++ b/tests/test_dsv41_branches_interp.py
@@ -0,0 +1,239 @@
+# SPDX-License-Identifier: MIT
+# Copyright (c) 2026 Jay Leaton. The DeepSeek-V4.1-Flash family of TensorFold (Apache-2.0): see THIRD_PARTY_NOTICES.md.
+"""``branches.py`` (TF_DSV41_BRANCHES) in Triton's CPU interpreter, bit for bit against the serial path:
+
+- e4's folded copies: ``_plain`` storing bf16 == its float64 result ``.to(fp32).to(bf16)``; ratio-2 pooling with the
+  carry through its own pointer and bf16 rows == the concatenated fp32 buffer (one slot and row mode, padding rows
+  untouched); ratio 1 on bf16 rows; the indexer scores on bf16 head weights == on their fp32 copy;
+- the whole forward (the synthetic checkpoint with the kernels' shapes: ratio-2 / ratio-1 kv sources, the candidate
+  source, reindex and reuse layers) with every attention sublayer through the branched plan (a recording driver
+  stands in for the side stream: the CPU has none) == the serial forward: logits, the pool's rows and keys, the
+  stacked rings, the pending projection rows and the carries the commits keep, row mode and one launch a segment;
+  and every sublayer issued exactly its plan's forks, joins and streams (each plan passing ``branches.check``);
+- G14: the same forward with ``TF_DSV41_BRANCHES=serial`` (e4 alone: ``plan_serial``, no fork) == the serial path.
+
+Run: python -m pytest -q tests/test_dsv41_branches_interp.py (a few minutes).
+"""
+
+from __future__ import annotations
+
+import os
+from contextlib import nullcontext
+
+from dsv41_interp import gpu_like, interpret  # noqa: F401
+
+interpret()
+
+import pytest  # noqa: E402
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.families.deepseek_v41.cuda import plain_fp64 as PF  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import rowtab as RT  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2 import compress, index  # noqa: E402
+
+INTERP = os.environ.get("TRITON_INTERPRET") == "1" and type(compress._kv_store).__name__ == "InterpretedFunction"
+pytestmark = [pytest.mark.skipif(not INTERP, reason="Triton's CPU interpreter (TRITON_INTERPRET=1)"),
+              pytest.mark.usefixtures("gpu_like")]
+BF = torch.bfloat16
+
+
+def _bits(t):
+    return t.reshape(-1).contiguous().view(torch.uint8)
+
+
+def test_plain_bf16_equals_the_cast_chain():
+    g = torch.Generator().manual_seed(3)
+    for K, rows in ((5120, 5), (300, 16)):
+        x = (torch.randn(rows, K, generator=g) * 3).to(BF)
+        w = (torch.randn(32, K, generator=g) * 0.05).to(BF)
+        want = PF.matmul_t(x, w).to(torch.float32).to(BF)
+        got = PF.matmul_t(x, w, BF)
+        assert got.dtype == BF and torch.equal(_bits(got), _bits(want)), K
+        assert torch.equal(_bits(PF.matmul_t(x[2:3], w, BF)), _bits(got[2:3]))     # row-invariant
+
+
+def _pos1(p):
+    return torch.tensor([p], dtype=torch.int32)
+
+
+def test_pool_split_one_slot():
+    g = torch.Generator().manual_seed(4)
+    w = torch.randn(512, generator=g).to(BF)
+    for P, n in ((41, 5), (10, 4), (7, 1)):
+        carry = torch.randn(1024, generator=g).to(BF).float()            # bf16 values, as kept from bf16 rows
+        rows = (torch.randn((n, 1024), generator=g) * 2).to(BF)
+        want = compress.pool_norm(torch.cat([carry.view(1, -1), rows.float()], 0).contiguous(), w, _pos1(P), n, 2,
+                                  torch.zeros((n, 512), dtype=BF))
+        for r_ in (rows, rows.float()):
+            got = compress.pool_norm(r_, w, _pos1(P), n, 2, torch.zeros((n, 512), dtype=BF), carry=carry)
+            assert torch.equal(_bits(got), _bits(want)), (P, n, r_.dtype)
+    r1 = (torch.randn((6, 512), generator=g) * 2).to(BF)
+    want = compress.pool_norm(r1.float(), w, _pos1(20), 6, 1, torch.zeros((6, 512), dtype=BF))
+    got = compress.pool_norm(r1, w, _pos1(20), 6, 1, torch.zeros((6, 512), dtype=BF))
+    assert torch.equal(_bits(got), _bits(want))
+
+
+def test_pool_split_row_mode():
+    S, R = 3, 12
+    mix = [(2, 41, 3), (0, 10, 1), (1, 119, 4)]
+    t = torch.from_numpy(RT.plan_rows(mix, list(range(8)), R, S))
+    pos, wslot, prev = t[RT.POS].contiguous(), t[RT.WSLOT].contiguous(), t[RT.PREV].contiguous()
+    g = torch.Generator().manual_seed(5)
+    carry = torch.randn((S, 1024), generator=g).to(BF).float()
+    rows = (torch.randn((R, 1024), generator=g) * 2).to(BF)
+    w = torch.randn(512, generator=g).to(BF)
+    want = compress.pool_norm(torch.cat([carry, rows.float()], 0).contiguous(), w, pos, R, 2,
+                              torch.zeros((R, 512), dtype=BF), slots=wslot, prev=prev)
+    got = compress.pool_norm(rows, w, pos, R, 2, torch.zeros((R, 512), dtype=BF), slots=wslot, prev=prev,
+                             carry=carry)
+    assert torch.equal(_bits(got), _bits(want))
+    assert not bool(got[8:].float().abs().sum())                          # padding rows: nothing pooled
+
+
+def test_scores_on_bf16_weights():
+    g = torch.Generator().manual_seed(6)
+    R, P, ratio, nv = 3, 700, 2, 360
+    qi = torch.randn((R, 32, 128), generator=g).to(BF).contiguous()
+    w = torch.randn((R, 32), generator=g).to(BF)
+    ik = torch.randn((nv + 8, 128), generator=g).to(BF).contiguous()
+    a = index.scores(qi, w.float(), ik, _pos1(P), R, nv, ratio)
+    b = index.scores(qi, w, ik, _pos1(P), R, nv, ratio)
+    assert torch.equal(_bits(a), _bits(b))
+
+
+# -- the forward ----------------------------------------------------------------------------------------------------
+LIMIT, CAP = 512, 256
+PROMPTS = [[int(t) for t in torch.randint(3, 250, (n,), generator=torch.Generator().manual_seed(n))]
+           for n in (37, 20)]
+STEPS = [[(0, 3), (1, 1)], [(1, 5)], [(0, 1), (1, 2)], [(0, 4)]]
+
+
+class Recorder:
+    """The side stream's stand-in: runs everything in order and logs the forks, joins and streams."""
+
+    def __init__(self):
+        self.log = []
+
+    def fork(self):
+        self.log.append(("fork",))
+
+    def join(self):
+        self.log.append(("join",))
+
+    def on(self, where):
+        self.log.append(where)
+        return nullcontext()
+
+
+@pytest.fixture(scope="module")
+def ck(tmp_path_factory):
+    import dsv41_dspark_fakes as DF
+
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41br"))
+
+
+def _forward(ck):
+    import dsv41_fakes as FK
+
+    from tensorfold.families.deepseek_v41.cuda import engram_host as EH
+    from tensorfold.families.deepseek_v41.cuda import rowmode
+    from tensorfold.families.deepseek_v41.cuda import weights as W
+    from tensorfold.families.deepseek_v41.cuda.csa2.backend import Triton
+    from tensorfold.families.deepseek_v41.cuda.decode import DecodeForward
+    from tensorfold.families.deepseek_v41.cuda.pool import Pool
+    from tensorfold.families.deepseek_v41.cuda.protocol import Piece
+
+    root, cfg, table, topo = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), 0, 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    fw = DecodeForward(cfg, tree, csa2=Triton(32, cfg.num_attention_heads, "cpu"), limit=LIMIT, chunk=32,
+                       engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap), slots=2)
+    pool = Pool(topo, 2 * CAP + 256)
+    ps = [pool.new_slot(CAP) for _ in range(2)]
+    fw.bind(ps)
+    for p in ps:
+        p.ensure(CAP)
+    assert rowmode.ready(fw)
+    for s, ids in enumerate(PROMPTS):
+        fw.reset(s)
+        fw.prefill([Piece(s, 0, tuple(ids))], mode="full")
+    return fw, pool
+
+
+def _state(fw, pool):
+    rs = fw.rowslot
+    return ([t.clone() for t in pool.phys.values()] + [st.values.clone() for st in rs.swa.values()]
+            + [c.clone() for c in rs.carry.values()])
+
+
+@pytest.mark.parametrize("mode", ["streams", "serial"])
+@pytest.mark.parametrize("rowmode", [True, False])
+def test_branched_forward_equals_serial(ck, monkeypatch, rowmode, mode):
+    from tensorfold.families.deepseek_v41.cuda import branches as BR
+    from tensorfold.families.deepseek_v41.cuda import rowgraphs as RG
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+
+    a, pa = _forward(ck)                # serial
+    b, pb = _forward(ck)                # branched (from here on)
+    rec = Recorder()
+    plans = []
+    on = {"b": False}
+    real_run = BR.run
+
+    drv = rec if mode == "streams" else BR.SERIAL           # G14: e4 alone runs plan_serial, no fork
+
+    def active(blk, x, ctxs):
+        return BR.Branch(drv, 64) if on["b"] and x.shape[0] <= 64 else None
+
+    def run(steps, impl, drv):
+        plans.append(steps)
+        real_run(steps, impl, drv)
+
+    monkeypatch.setattr(BR, "active", active)
+    monkeypatch.setattr(BR, "run", run)
+    ra, rb = RG.Rows(a, max(RT.BUCKETS[:10]), 2048), RG.Rows(b, max(RT.BUCKETS[:10]), 2048)
+    g = torch.Generator().manual_seed(8)
+    for step, mix in enumerate(STEPS):
+        segs = [Seg(s, a.slots[s].pos, tuple(int(t) for t in torch.randint(3, 250, (n,), generator=g)))
+                for s, n in mix]
+        if rowmode:
+            key = RT.row_key([(sg.slot, sg.start, len(sg.ids)) for sg in segs], 2048, LIMIT)
+            want = ra.run(key, segs)
+            on["b"] = True
+            got = rb.run(key, segs)
+        else:
+            want = a.run(segs)
+            on["b"] = True
+            got = b.run(segs)
+        on["b"] = False
+        assert torch.equal(_bits(got), _bits(want)), (step, mix)
+        for x, y in zip(_state(a, pa), _state(b, pb)):
+            assert torch.equal(x, y), step
+        for sg in segs:
+            keep = (len(sg.ids) - 1) // 2
+            p1, p2 = a.slots[sg.slot].pending, b.slots[sg.slot].pending
+            assert set(p1.proj) == set(p2.proj)
+            for L in p1.proj:
+                assert p2.proj[L].dtype == BF and torch.equal(p2.proj[L].float(), p1.proj[L]), (step, L)
+            a.keep(sg.slot, keep)
+            b.keep(sg.slot, keep)
+            for L, t in a.slots[sg.slot].carry.items():
+                assert torch.equal(b.slots[sg.slot].carry[L], t)
+    # every sublayer ran a checked plan, and the driver saw exactly its forks, joins and streams
+    cfg = a.cfg
+    assert len(plans) == len(STEPS) * cfg.num_hidden_layers
+    want_log = []
+    for steps in plans:
+        ops = [s[1] for s in steps if len(s) == 2]
+        ix, comp = "select" in ops, "compress" in ops
+        BR.check(steps, BR.initial(ix, comp))
+        # the plan is the layer kind's alone (no fused group on the CPU twin: split q launches)
+        assert steps == (BR.plan if mode == "streams" else BR.plan_serial)(ix, comp, ix), (mode, ix, comp)
+        want_log += [s if len(s) == 1 else s[0] for s in steps]
+    assert rec.log == (want_log if mode == "streams" else [])
+    kinds = {(("select" in [s[1] for s in p if len(s) == 2]), ("compress" in [s[1] for s in p if len(s) == 2]))
+             for p in plans}
+    assert kinds == {(False, False), (True, False), (True, True)}
