@@ -0,0 +1,536 @@
+// One-shot RoCE all-gather kernel for GLM-5.3-Flash's two-Spark tensor parallelism (patches/0230).
+//
+// Adapted from b12x's RoCEnante all-gather (b12x/comm/roce/_allgather_cute.py and _cute_intrinsics.py,
+// https://github.com/local-inference-lab/b12x, Copyright 2026 Luke Alonso and the b12x contributors, Apache
+// License 2.0; see LICENSES/Apache-2.0.txt and THIRD_PARTY_NOTICES.md). Changes: rewritten from CuTe DSL into
+// CUDA C++; only the dim-0 concatenation (NCCL's all-gather layout); any input/output alignment and any byte
+// count (the send slot is padded to 16 bytes, only nbytes are copied out); a wall-clock timeout (%globaltimer)
+// instead of a poll count; b12x PR #438's host-visible completion word and wrap-safe failure flag; the poison word
+// read once per block (no divergent early exit around a barrier).
+//
+// Protocol (one op, sequence seq = epoch + 1, slot = seq & 1; see roce.cpp for the pinned region's layout):
+//   1. every block stages its share of the input into the pinned send slot;
+//   2. the last block to finish staging publishes the padded byte count and rings the doorbell (ctrl[0] = seq)
+//      that the host proxy thread polls; the proxy RDMA-writes the slot to the peer, then a 4-byte seq flag on
+//      the same reliable-connected queue pair (so the flag lands after the payload), striped over the HCAs;
+//   3. one thread per (peer, HCA) spins on the peer's flag in this rank's pinned region with system-scope
+//      acquire loads, until it reads seq or the timeout expires (then: error words + poison, fail-stop);
+//   4. every block copies its share of every rank's shard into the output, rank order (the local shard from the
+//      input, the peer's from the NIC-written receive slot with system-scope loads);
+//   5. the last block to finish advances the device-resident epoch (so a replayed CUDA graph carries on with
+//      the next sequence) and mirrors it into the host-visible completion word.
+// Data are only moved, never combined: the gathered bytes equal NCCL's.
+//
+// patches/0350: a timed-out wait claims the failure record with a compare-and-swap on the device poison word (up
+// to blocks x HCAs threads may time out; one writes, so the record is never torn), stores what it last read of the
+// flag (CTRL_ERR_SEEN) and only then the failure word; the epoch is published only if no wait of this launch failed
+// (the device poison, not the host word). The host's view of the same flag at that moment is taken by the proxy
+// thread (roce_watch.h), which tells "arrived late" from "delivered but not seen".
+
+// G14 (GLM53_TF_ROCE_FAST, off by default): gather_fast_kernel at the end of this file, the same protocol with a
+// shorter critical path; launch_gather picks it. gather_kernel is unchanged but for the host trace ring's stamp.
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+#include "roce_common.h"
+
+namespace tfroce {
+
+__device__ __forceinline__ uint32_t ld_relaxed_gpu(const uint32_t *p) {
+    uint32_t v;
+    asm volatile("ld.relaxed.gpu.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint32_t ld_relaxed_sys(const uint32_t *p) {
+    uint32_t v;
+    asm volatile("ld.relaxed.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint32_t ld_acquire_sys(const uint32_t *p) {
+    uint32_t v;
+    asm volatile("ld.acquire.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint4 ld_relaxed_sys_v4(const void *p) {
+    uint4 v;
+    asm volatile("ld.relaxed.sys.global.v4.u32 {%0, %1, %2, %3}, [%4];"
+                 : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w)
+                 : "l"(p)
+                 : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint32_t ld_relaxed_sys_u8(const uint8_t *p) {
+    uint32_t v;
+    asm volatile("ld.relaxed.sys.global.u8 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ void st_relaxed_sys(uint32_t *p, uint32_t v) {
+    asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ __forceinline__ void st_release_gpu(uint32_t *p, uint32_t v) {
+    asm volatile("st.release.gpu.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ __forceinline__ uint32_t atom_add_relaxed_gpu(uint32_t *p, uint32_t v) {
+    uint32_t old;
+    asm volatile("atom.relaxed.gpu.global.add.u32 %0, [%1], %2;" : "=r"(old) : "l"(p), "r"(v) : "memory");
+    return old;
+}
+
+__device__ __forceinline__ void fence_sc_sys() { asm volatile("fence.sc.sys;" ::: "memory"); }
+
+// patches/0460 (``lean``): the release / acquire forms of the same orderings
+__device__ __forceinline__ void st_release_sys(uint32_t *p, uint32_t v) {
+    asm volatile("st.release.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ __forceinline__ uint32_t atom_add_acq_rel_sys(uint32_t *p, uint32_t v) {
+    uint32_t old;
+    asm volatile("atom.acq_rel.sys.global.add.u32 %0, [%1], %2;" : "=r"(old) : "l"(p), "r"(v) : "memory");
+    return old;
+}
+
+__device__ __forceinline__ uint32_t atom_add_acq_rel_gpu(uint32_t *p, uint32_t v) {
+    uint32_t old;
+    asm volatile("atom.acq_rel.gpu.global.add.u32 %0, [%1], %2;" : "=r"(old) : "l"(p), "r"(v) : "memory");
+    return old;
+}
+
+__device__ __forceinline__ void trace_at(const GatherArgs &a, uint32_t seq, int k, uint64_t t) {
+    if (a.trace != nullptr) {
+        a.trace[static_cast<uint64_t>(seq & a.trace_mask) * 4u + static_cast<uint32_t>(k)] = t;
+    }
+}
+
+__device__ __forceinline__ void fence_sc_gpu() { asm volatile("fence.sc.gpu;" ::: "memory"); }
+
+__device__ __forceinline__ uint64_t globaltimer() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+
+__device__ __forceinline__ uint32_t atom_cas_gpu(uint32_t *p, uint32_t cmp, uint32_t v) {
+    uint32_t old;
+    asm volatile("atom.relaxed.gpu.global.cas.b32 %0, [%1], %2, %3;" : "=r"(old) : "l"(p), "r"(cmp), "r"(v) : "memory");
+    return old;
+}
+
+// Spin until *flag == want (system scope, acquire). false after timeout_ns of wall-clock time without a match;
+// ``seen``: the last value read (patches/0350: the failure record keeps it).
+__device__ __noinline__ bool wait_flag(const uint32_t *flag, uint32_t want, uint64_t timeout_ns, uint32_t *seen) {
+    const uint64_t t0 = globaltimer();
+    uint32_t polls = 0;
+    while (true) {
+        const uint32_t v = ld_acquire_sys(flag);
+        if (v == want) {
+            *seen = v;
+            return true;
+        }
+        if ((++polls & 1023u) == 0u && globaltimer() - t0 > timeout_ns) {
+            *seen = ld_acquire_sys(flag);          // one last look
+            return *seen == want;
+        }
+    }
+}
+
+// dst[i] <- src[i] for i in [0, n), a grid-stride loop; vector width chosen from the alignment of both pointers and n.
+// ``sys_src``: the source is NIC-written pinned memory, read with system-scope loads.
+template <bool SysSrc>
+__device__ __forceinline__ void copy_bytes(uint8_t *dst, const uint8_t *src, uint64_t n, uint64_t index,
+                                           uint64_t stride) {
+    const uint64_t a = reinterpret_cast<uint64_t>(dst) | reinterpret_cast<uint64_t>(src) | n;
+    if ((a & 15u) == 0u) {
+        const uint64_t packs = n >> 4;
+        for (uint64_t i = index; i < packs; i += stride) {
+            uint4 v;
+            if (SysSrc) {
+                v = ld_relaxed_sys_v4(src + (i << 4));
+            } else {
+                v = reinterpret_cast<const uint4 *>(src)[i];
+            }
+            reinterpret_cast<uint4 *>(dst)[i] = v;
+        }
+    } else if ((a & 3u) == 0u) {
+        const uint64_t words = n >> 2;
+        for (uint64_t i = index; i < words; i += stride) {
+            uint32_t v;
+            if (SysSrc) {
+                v = ld_relaxed_sys(reinterpret_cast<const uint32_t *>(src) + i);
+            } else {
+                v = reinterpret_cast<const uint32_t *>(src)[i];
+            }
+            reinterpret_cast<uint32_t *>(dst)[i] = v;
+        }
+    } else {
+        for (uint64_t i = index; i < n; i += stride) {
+            uint32_t v;
+            if (SysSrc) {
+                v = ld_relaxed_sys_u8(src + i);
+            } else {
+                v = src[i];
+            }
+            dst[i] = static_cast<uint8_t>(v);
+        }
+    }
+}
+
+__global__ void __launch_bounds__(1024) gather_kernel(GatherArgs a) {
+    __shared__ uint32_t s_flag;
+    const uint32_t tid = threadIdx.x;
+    const uint32_t gdim = gridDim.x;
+    const uint64_t index = static_cast<uint64_t>(blockIdx.x) * blockDim.x + tid;
+    const uint64_t stride = static_cast<uint64_t>(gdim) * blockDim.x;
+    uint32_t *ctrl = reinterpret_cast<uint32_t *>(a.ctrl_base);
+
+    // A recorded timeout poisons the runtime: later launches do nothing (the host raises on its next check).
+    // One read per block, so no thread of the block leaves before a barrier the others wait at.
+    if (tid == 0) {
+        s_flag = ld_relaxed_gpu(a.poison);
+    }
+    __syncthreads();
+    if (s_flag != 0u) {
+        return;
+    }
+    const uint32_t seq = ld_relaxed_gpu(a.epoch) + 1u;
+    const uint64_t slot = seq & 1u;
+    uint8_t *send = reinterpret_cast<uint8_t *>(a.send_base + slot * a.slot_bytes);
+    const uint32_t padded = static_cast<uint32_t>((a.nbytes + 15u) & ~static_cast<uint64_t>(15u));
+    if (blockIdx.x == 0 && tid == 0) {
+        trace_at(a, seq, 0, globaltimer());               // patches/0460 (no-op without a trace ring)
+    }
+
+    // 1. stage this rank's shard into the pinned send slot
+    copy_bytes<false>(send, a.in, a.nbytes, index, stride);
+    __syncthreads();
+
+    // 2. the last block to finish staging rings the proxy's doorbell (one system fence per block after the
+    //    barrier orders the block's staging stores before its arrival)
+    if (tid == 0) {
+        if (a.lean) {
+            // patches/0460: the same message-passing order with release / acquire instead of two sequentially
+            // consistent system fences: a block's arrival is a release RMW (the barrier made the block's staging
+            // stores precede it); the last arrival also acquires every earlier block's; the doorbell is a release
+            // store, so the byte counts and every staged byte are visible to the proxy's acquire load of it. One
+            // block (a 16 KiB shard): no arrival at all, one release store.
+            const bool last = gdim == 1u || ((atom_add_acq_rel_sys(a.stage_ctr, 1u) + 1u) & (gdim - 1u)) == 0u;
+            if (last) {
+                st_relaxed_sys(ctrl + CTRL_NBYTES, padded);
+                st_relaxed_sys(ctrl + CTRL_SLOT_NBYTES + slot, padded);
+                st_release_sys(ctrl + CTRL_SEQ, seq);
+                trace_at(a, seq, 1, globaltimer());
+            }
+        } else {
+            fence_sc_sys();
+            const uint32_t prior = atom_add_relaxed_gpu(a.stage_ctr, 1u);
+            if (((prior + 1u) & (gdim - 1u)) == 0u) {
+                st_relaxed_sys(ctrl + CTRL_NBYTES, padded);
+                st_relaxed_sys(ctrl + CTRL_SLOT_NBYTES + slot, padded);
+                fence_sc_sys();
+                st_relaxed_sys(ctrl + CTRL_SEQ, seq);
+                trace_at(a, seq, 1, globaltimer());
+            }
+        }
+    }
+
+    // 3. wait for every peer's per-HCA flag of this sequence (patches/0460: only the one HCA a small op used)
+    const bool one = one_hca(padded, a.stripe_min, a.n_hca);
+    const int used = one ? single_hca(seq, a.n_hca) : -1;
+    if (tid < static_cast<uint32_t>(a.world * a.n_hca)) {
+        const int peer = static_cast<int>(tid) / a.n_hca;
+        const int hca = static_cast<int>(tid) - peer * a.n_hca;
+        if (peer != a.rank && (used < 0 || hca == used)) {
+            const uint32_t *flag = reinterpret_cast<const uint32_t *>(
+                a.flag_base + ((static_cast<uint64_t>(peer) * a.slots + slot) * a.n_hca + hca) * a.flag_stride);
+            uint32_t seen = 0u;
+            if (!wait_flag(flag, seq, a.timeout_ns, &seen) && atom_cas_gpu(a.poison, 0u, 1u) == 0u) {
+                // the first timed-out wait of the runtime writes the record; the failure word goes last, after a
+                // system fence, so a host that sees it reads a whole record (roce_watch.h, Runtime.check)
+                st_relaxed_sys(ctrl + CTRL_ERR_PEER, static_cast<uint32_t>(peer));
+                st_relaxed_sys(ctrl + CTRL_ERR_HCA, static_cast<uint32_t>(hca));
+                st_relaxed_sys(ctrl + CTRL_ERR_SEQ, seq);
+                st_relaxed_sys(ctrl + CTRL_ERR_SEEN, seen);
+                fence_sc_sys();
+                st_relaxed_sys(ctrl + CTRL_FAILED, 1u);
+                fence_sc_sys();
+            }
+            if (a.trace != nullptr && blockIdx.x == 0 && a.trace_host == 0u) {
+                atomicMax(reinterpret_cast<unsigned long long *>(a.trace + static_cast<uint64_t>(seq & a.trace_mask) * 4u + 2u),
+                          static_cast<unsigned long long>(globaltimer()));
+            }
+        }
+    }
+    __syncthreads();
+    if (tid == 0) {
+        s_flag = ld_relaxed_gpu(a.poison);
+        if (a.trace != nullptr && a.trace_host != 0u && blockIdx.x == 0) {
+            trace_at(a, seq, 2, globaltimer());     // G14: a host ring takes no atomics
+        }
+    }
+    __syncthreads();
+
+    // 4. every rank's shard, in rank order (a timed-out wait leaves the peer slot unreliable: nothing is copied)
+    if (s_flag == 0u) {
+        for (int src = 0; src < a.world; src++) {
+            uint8_t *dst = a.out + static_cast<uint64_t>(src) * a.nbytes;
+            if (src == a.rank) {
+                copy_bytes<false>(dst, a.in, a.nbytes, index, stride);
+            } else {
+                const uint8_t *peer_slot = reinterpret_cast<const uint8_t *>(
+                    a.recv_base + (static_cast<uint64_t>(src) * a.slots + slot) * a.slot_bytes);
+                copy_bytes<true>(dst, peer_slot, a.nbytes, index, stride);
+            }
+        }
+    }
+
+    // 5. the last block to finish publishes the next epoch (not after a failure: later launches stay no-ops)
+    if (a.lean) {
+        // patches/0460: the next launch reads the epoch after this kernel ended (stream order), so the copy-out needs
+        // no fence before it; the arrival is an acq_rel RMW so the last block sees every block's poison CAS
+        __syncthreads();
+        if (tid == 0) {
+            const bool last = gdim == 1u || ((atom_add_acq_rel_gpu(a.tail_ctr, 1u) + 1u) & (gdim - 1u)) == 0u;
+            if (last && ld_relaxed_gpu(a.poison) == 0u && ld_relaxed_sys(ctrl + CTRL_FAILED) == 0u) {
+                st_release_gpu(a.epoch, seq);
+                st_relaxed_sys(ctrl + CTRL_COMPLETED, seq);
+            }
+            if (last) {
+                trace_at(a, seq, 3, globaltimer());
+            }
+        }
+        return;
+    }
+    fence_sc_gpu();
+    __syncthreads();
+    if (tid == 0) {
+        const uint32_t prior = atom_add_relaxed_gpu(a.tail_ctr, 1u);
+        if (((prior + 1u) & (gdim - 1u)) == 0u) {
+            fence_sc_gpu();
+            if (ld_relaxed_gpu(a.poison) == 0u && ld_relaxed_sys(ctrl + CTRL_FAILED) == 0u) {
+                st_release_gpu(a.epoch, seq);
+                st_relaxed_sys(ctrl + CTRL_COMPLETED, seq);
+            }
+            trace_at(a, seq, 3, globaltimer());
+        }
+    }
+}
+
+// ---- G14: the fast path (GLM53_TF_ROCE_FAST=1) -------------------------------------------------------------------
+// The same protocol as gather_kernel (stage -> byte counts -> release doorbell -> wait for the peers' flags -> copy
+// out in rank order -> epoch), the same bytes in the same places; only what lies on one exchange's critical path is
+// shorter (measured by the development tree's (unpublished) G14 comm window):
+//   a. the prologue reads the poison word and the epoch in ONE round trip (tid 0, both loads in flight) instead of a
+//      poison read, a barrier, then the epoch;
+//   b. patches/0460's lean order (release / acquire forms, no fence.sc.sys), always;
+//   c. the LOCAL shard is copied into ``out`` right after the doorbell, while the peer's payload is on the wire,
+//      instead of after the wait (``out`` is written only by this kernel; the bytes are the input's either way);
+//   d. a block copies the peer's shard if ITS OWN waits saw the sequence (a shared word), instead of re-reading the
+//      global poison word after the wait: data a block's acquire load observed are the op's data. A timed-out wait
+//      still records the failure (CAS on the poison, the record, the failure word) and its block copies nothing; the
+//      epoch is published only if no block failed (as before), so the runtime is poisoned all the same;
+//   e. ``pollers`` threads (each in its own warp, start-staggered by ``stagger_ns``) poll each flag: the flag is seen
+//      a fraction of a host round trip sooner (one poller: a full round trip on average); the first to see it stops
+//      the others through a shared word;
+//   f. the tail publishes the epoch without a system-scope load of the host's failure word (only kernels write it,
+//      and they set the device poison first); one block (shards up to 16 KiB at 512 threads): no tail atomic either;
+//   g. every copy issues a thread's two loads before its stores (copy_bytes2): the peer slot costs one host round
+//      trip, not two in a row.
+// Exactness: the kernel moves bytes and never combines them, so ``out`` holds exactly gather_kernel's bytes.
+
+// copy_bytes with the loads of two grid strides issued before their stores (16-byte aligned case; else copy_bytes).
+// b12x's grid gives a thread ~2 packs, so a thread's whole share costs ONE load round trip instead of two in a row:
+// G14a's trace (1-row windows, 10 KiB, one block of 512 threads, 640 packs) put the classic copy-out at 4-6.6 us, i.e.
+// about two host round trips for the peer slot plus the tail's. The bytes and their places are copy_bytes'.
+template <bool SysSrc>
+__device__ __forceinline__ void copy_bytes2(uint8_t *dst, const uint8_t *src, uint64_t n, uint64_t index,
+                                            uint64_t stride) {
+    const uint64_t a = reinterpret_cast<uint64_t>(dst) | reinterpret_cast<uint64_t>(src) | n;
+    if ((a & 15u) != 0u) {
+        copy_bytes<SysSrc>(dst, src, n, index, stride);
+        return;
+    }
+    const uint64_t packs = n >> 4;
+    for (uint64_t i = index; i < packs; i += 2u * stride) {
+        const uint64_t j = i + stride;
+        uint4 v0, v1 = make_uint4(0u, 0u, 0u, 0u);
+        if (SysSrc) {
+            v0 = ld_relaxed_sys_v4(src + (i << 4));
+            if (j < packs) {
+                v1 = ld_relaxed_sys_v4(src + (j << 4));
+            }
+        } else {
+            v0 = reinterpret_cast<const uint4 *>(src)[i];
+            if (j < packs) {
+                v1 = reinterpret_cast<const uint4 *>(src)[j];
+            }
+        }
+        reinterpret_cast<uint4 *>(dst)[i] = v0;
+        if (j < packs) {
+            reinterpret_cast<uint4 *>(dst)[j] = v1;
+        }
+    }
+}
+
+// Spin until *flag == want or another poller of this block saw it (``done``). false after timeout_ns.
+__device__ __noinline__ bool wait_flag_shared(const uint32_t *flag, uint32_t want, uint64_t timeout_ns, uint32_t *seen,
+                                              volatile uint32_t *done) {
+    const uint64_t t0 = globaltimer();
+    uint32_t polls = 0;
+    while (true) {
+        const uint32_t v = ld_acquire_sys(flag);
+        if (v == want) {
+            *done = 1u;
+            *seen = v;
+            return true;
+        }
+        if (*done != 0u) {                      // another poller's acquire saw it; the barrier after the wait orders
+            *seen = want;                       // this block's reads of the payload after that acquire
+            return true;
+        }
+        if ((++polls & 1023u) == 0u && globaltimer() - t0 > timeout_ns) {
+            *seen = ld_acquire_sys(flag);       // one last look
+            if (*seen == want) {
+                *done = 1u;
+                return true;
+            }
+            return *done != 0u;
+        }
+    }
+}
+
+__global__ void __launch_bounds__(1024) gather_fast_kernel(GatherArgs a) {
+    __shared__ uint32_t s_head[2];              // poison, epoch
+    __shared__ uint32_t s_bad;                  // a wait of this block timed out
+    __shared__ uint32_t s_done[MAX_WAITERS];    // per (peer, HCA): some poller saw the flag
+    const uint32_t tid = threadIdx.x;
+    const uint32_t gdim = gridDim.x;
+    const uint64_t index = static_cast<uint64_t>(blockIdx.x) * blockDim.x + tid;
+    const uint64_t stride = static_cast<uint64_t>(gdim) * blockDim.x;
+    uint32_t *ctrl = reinterpret_cast<uint32_t *>(a.ctrl_base);
+
+    // a. both words in one round trip
+    if (tid == 0) {
+        const uint32_t p = ld_relaxed_gpu(a.poison);
+        const uint32_t e = ld_relaxed_gpu(a.epoch);
+        s_head[0] = p;
+        s_head[1] = e;
+        s_bad = 0u;
+    }
+    if (tid < static_cast<uint32_t>(MAX_WAITERS)) {
+        s_done[tid] = 0u;
+    }
+    __syncthreads();
+    if (s_head[0] != 0u) {
+        return;
+    }
+    const uint32_t seq = s_head[1] + 1u;
+    const uint64_t slot = seq & 1u;
+    uint8_t *send = reinterpret_cast<uint8_t *>(a.send_base + slot * a.slot_bytes);
+    const uint32_t padded = static_cast<uint32_t>((a.nbytes + 15u) & ~static_cast<uint64_t>(15u));
+    if (blockIdx.x == 0 && tid == 0) {
+        trace_at(a, seq, 0, globaltimer());
+    }
+
+    // 1. stage this rank's shard into the pinned send slot
+    copy_bytes2<false>(send, a.in, a.nbytes, index, stride);
+    __syncthreads();
+
+    // 2. b. the lean doorbell (gather_kernel's ``lean`` branch, verbatim)
+    if (tid == 0) {
+        const bool last = gdim == 1u || ((atom_add_acq_rel_sys(a.stage_ctr, 1u) + 1u) & (gdim - 1u)) == 0u;
+        if (last) {
+            st_relaxed_sys(ctrl + CTRL_NBYTES, padded);
+            st_relaxed_sys(ctrl + CTRL_SLOT_NBYTES + slot, padded);
+            st_release_sys(ctrl + CTRL_SEQ, seq);
+            trace_at(a, seq, 1, globaltimer());
+        }
+    }
+
+    // c. the local shard while the peer's payload travels
+    copy_bytes2<false>(a.out + static_cast<uint64_t>(a.rank) * a.nbytes, a.in, a.nbytes, index, stride);
+
+    // 3. e. wait: poller k of (peer, HCA) w is thread 32 k + w (its own warp, so the staggered loads really interleave)
+    const bool one = one_hca(padded, a.stripe_min, a.n_hca);
+    const int used = one ? single_hca(seq, a.n_hca) : -1;
+    const uint32_t lane = tid & 31u;
+    const uint32_t k = tid >> 5;
+    if (lane < static_cast<uint32_t>(a.world * a.n_hca) && k < a.pollers) {
+        const int peer = static_cast<int>(lane) / a.n_hca;
+        const int hca = static_cast<int>(lane) - peer * a.n_hca;
+        if (peer != a.rank && (used < 0 || hca == used)) {
+            const uint32_t *flag = reinterpret_cast<const uint32_t *>(
+                a.flag_base + ((static_cast<uint64_t>(peer) * a.slots + slot) * a.n_hca + hca) * a.flag_stride);
+            if (k > 0u && a.stagger_ns != 0u) {
+                __nanosleep(k * a.stagger_ns);
+            }
+            uint32_t seen = 0u;
+            if (!wait_flag_shared(flag, seq, a.timeout_ns, &seen, &s_done[lane])) {
+                s_bad = 1u;
+                if (atom_cas_gpu(a.poison, 0u, 1u) == 0u) {     // gather_kernel's failure record, unchanged
+                    st_relaxed_sys(ctrl + CTRL_ERR_PEER, static_cast<uint32_t>(peer));
+                    st_relaxed_sys(ctrl + CTRL_ERR_HCA, static_cast<uint32_t>(hca));
+                    st_relaxed_sys(ctrl + CTRL_ERR_SEQ, seq);
+                    st_relaxed_sys(ctrl + CTRL_ERR_SEEN, seen);
+                    fence_sc_sys();
+                    st_relaxed_sys(ctrl + CTRL_FAILED, 1u);
+                    fence_sc_sys();
+                }
+            }
+        }
+    }
+    __syncthreads();
+    if (a.trace != nullptr && blockIdx.x == 0 && tid == 0) {
+        trace_at(a, seq, 2, globaltimer());     // block 0's waits all returned
+    }
+
+    // 4. d. every peer's shard, gated by this block's own waits
+    if (s_bad == 0u) {
+        for (int src = 0; src < a.world; src++) {
+            if (src == a.rank) {
+                continue;
+            }
+            const uint8_t *peer_slot = reinterpret_cast<const uint8_t *>(
+                a.recv_base + (static_cast<uint64_t>(src) * a.slots + slot) * a.slot_bytes);
+            copy_bytes2<true>(a.out + static_cast<uint64_t>(src) * a.nbytes, peer_slot, a.nbytes, index, stride);
+        }
+    }
+
+    // 5. f. the epoch (lean; no host word read). One block: its own waits decide (no other block can fail).
+    __syncthreads();
+    if (tid == 0) {
+        bool ok;
+        bool last;
+        if (gdim == 1u) {
+            last = true;
+            ok = s_bad == 0u;
+        } else {
+            last = ((atom_add_acq_rel_gpu(a.tail_ctr, 1u) + 1u) & (gdim - 1u)) == 0u;
+            ok = last && ld_relaxed_gpu(a.poison) == 0u;
+        }
+        if (last && ok) {
+            st_release_gpu(a.epoch, seq);
+            st_relaxed_sys(ctrl + CTRL_COMPLETED, seq);
+        }
+        if (last) {
+            trace_at(a, seq, 3, globaltimer());
+        }
+    }
+}
+
+cudaError_t launch_gather(const GatherArgs &args, int grid, int threads, cudaStream_t stream) {
+    if (args.fast != 0u) {
+        gather_fast_kernel<<<grid, threads, 0, stream>>>(args);
+    } else {
+        gather_kernel<<<grid, threads, 0, stream>>>(args);
+    }
+    return cudaGetLastError();
+}
+
+}  // namespace tfroce
diff --git a/src/tensorfold/families/glm5_next/spark/roce.py b/src/tensorfold/families/glm5_next/spark/roce.py
new file mode 100644
index 0000000..d70d3c3
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce.py
@@ -0,0 +1,952 @@
+"""One-shot RoCE all-gather for the decode-sized exchanges of GLM-5.3-Flash's two-Spark tensor parallelism
+(patches/0230, ``GLM53_TF_COMM_BACKEND=roce``).
+
+Why
+---
+Every forward exchanges 90 fp32 partials (16 KiB a row a rank; ``docs/COMM-ANALYSIS.md``). NCCL's all-gather
+captured in a CUDA graph costs about 27 us however small the payload: its kernel hands the send to NCCL's network
+proxy thread, and the one-row step spends ~2.4 ms of its ~30 ms there, all latency. This transport is b12x's
+"RoCEnante" (https://github.com/local-inference-lab/b12x, ``b12x/comm/roce``, Apache-2.0; adapted in
+``roce.cpp`` / ``roce.cu``, see their headers): each rank owns a pinned host region that the ConnectX-7 RDMA-writes
+into and the GB10 reads in place (no GPUDirect RDMA needed); one kernel stages the shard, rings a doorbell that a
+busy-spinning C++ proxy thread turns into RDMA writes (payload, then a 4-byte sequence flag on the same RC queue
+pair, striped over both CX7 PCIe functions), waits for the peer's flags with system-scope loads and copies the shards
+out in rank order. The epoch lives on the device, so a replayed CUDA graph continues the sequence.
+
+Exactness: an all-gather moves bytes. The output is every rank's shard in rank order, exactly NCCL's layout and
+bits; the consumers (``glue.hc_post``, the MTP head's residual add, the drafter's row sum, the samplers) are
+unchanged, so both ranks still add the same partials rank 0 first and hold identical bits.
+
+What goes over RoCE
+-------------------
+Only the model's own exchanges, through ``comm.fast_gather``: ``forward.gather`` (every block's partials; decode,
+verify, MTP, batched rounds and prefill chunks that fit), the samplers' candidate exchanges, the DFlash2 drafter's
+rows and candidates, and 0084's pipelined prefill exchanges -- each only when one rank's shard is at most
+``GLM53_TF_ROCE_MAX_KB`` (default 256 KiB: a 16-row fp32 window; larger ones stay on NCCL). Everything else stays
+on NCCL: the engine's control exchanges (settings checks, request headers and prompts sent to rank 1, calibration),
+in particular the follower's idle wait for the next request, which must be able to wait forever.
+
+Knobs (both ranks must agree on all but the CPU; checked at load)
+-----------------------------------------------------------------
+``GLM53_TF_COMM_BACKEND``   ``nccl`` (default) | ``roce``
+``GLM53_TF_ROCE_MAX_KB``    largest shard (KiB a rank) sent over RoCE; also the slot size (pinned: 6 slots). 256
+``GLM53_TF_ROCE_TIMEOUT_S`` a wait for the peer's flag gives up after this many seconds (fail-stop, below). 120
+``GLM53_TF_ROCE_HCA``       ``name[:gid],...`` RDMA devices (and optionally RoCE v2 GID indices); default: every
+                            ACTIVE Ethernet port, GID auto-detected
+``GLM53_TF_ROCE_HCAS``      stripe over at most this many HCAs (1 or 2). 2
+``GLM53_TF_ROCE_BLOCKS`` / ``_THREADS``   largest kernel grid (power of two) / threads a block. 8 / 512
+``GLM53_TF_ROCE_TC``        RoCE traffic class (DSCP/ECN byte); default ``NCCL_IB_TC`` or 0
+``GLM53_TF_ROCE_CPU``       pin the proxy thread to this CPU (default: not pinned; the thread busy-spins one core)
+``GLM53_TF_ROCE_FALLBACK``  ``nccl`` (default): a failed setup or load-time probe on either rank -> both ranks
+                            serve on NCCL, with a log line; ``error``: refuse to start
+``GLM53_TF_ROCE_MARK``      file written when a RoCE collective fails at run time; while it exists (on either rank)
+                            both ranks start on NCCL. Default ``/cache/roce-failed`` when ``/cache`` exists; empty:
+                            none. Delete it to try RoCE again.
+
+patches/0460 (latency of one exchange; every one off by default = 0350's path, docs/PREFETCH-COMM.md):
+``GLM53_TF_ROCE_STRIPE_KB`` shards (16-byte padded) below this many KiB travel on ONE HCA (sequence % HCAs: one post,
+                            one flag, no max over two paths) instead of striped over both. 0 = always striped.
+                            Both ranks must agree (checked at load)
+``GLM53_TF_ROCE_INLINE``    stripes of at most this many bytes are posted inline (the proxy copies the staged bytes
+                            into the work request; no NIC read of the send slot). Capped by what the queue pairs
+                            grant (mlx5: ~200-900 B); 0 = off
+``GLM53_TF_ROCE_LAZY_CQ``   1: the proxy reaps completions in its idle loop, not right after every post
+``GLM53_TF_ROCE_LEAN``      1: the kernel's doorbell and tail use release / acquire operations instead of
+                            sequentially consistent fences (the same happens-before edges; one fewer system fence)
+``GLM53_TF_ROCE_TRACE``     N (a power of two): a ring of the last N ops' timestamps (kernel: start, doorbell, flags
+                            seen, end; proxy: doorbell seen, posted) for ``Runtime.trace_rows`` / bench_roce ``--trace``
+
+G14 (one exchange's fixed cost inside the kernel; off by default = the kernels above; the development tree's
+(unpublished) G14 comm window). Local knobs: the wire protocol is unchanged, so the ranks may differ:
+``GLM53_TF_ROCE_FAST``      1: ``roce.cu``'s ``gather_fast_kernel``: one prologue round trip, lean order, the local shard
+                            copied while the peer's payload travels, a block's own wait gates its copy (no re-read of
+                            the poison word), no system-scope read in the tail. The same bytes (it only moves them)
+``GLM53_TF_ROCE_POLLERS``   fast only: threads polling each peer flag, 1..8 (default 1), start-staggered by
+``GLM53_TF_ROCE_STAGGER_NS`` (default 150): the flag is seen up to ~half a host round trip sooner
+``GLM53_TF_ROCE_TRACE_DUMP_S``  with ``GLM53_TF_ROCE_TRACE`` and ``GLM53_TF_ROCE_TRACE_DUMP``: a daemon thread dumps the
+                            ring every this many seconds (``rocedump.start_thread``) for engines whose round loop does
+                            not call ``rocedump.tick`` (DeepSeek-V4.1); 0 (default): GLM's tick only
+
+GIDs: RoCE v2 GID indices move on reboot and differ per port, so they are never hard-coded: for each ACTIVE port
+the lowest index whose type is ``RoCE v2`` and whose GID is IPv4-mapped (``::ffff:a.b.c.d``) is used (the same rule
+as the vLLM kit's ``detect-gids.sh``). The ranks' HCAs are paired by IPv4 subnet (e.g. rocep1s0f1 <-> 198.51.100.x,
+roceP2p1s0f1 <-> 203.0.113.x), so names and order may differ between the nodes.
+
+Failure model (b12x issues #313 / PR #438, sparkring #278)
+-----------------------------------------------------------
+Setup (HCA detection, queue pairs, a probe gather compared with NCCL's result) is collective: any failure on any
+rank makes both ranks fall back to NCCL (or both refuse, with ``GLM53_TF_ROCE_FALLBACK=error``). At run time a wait
+that times out records the peer, HCA and sequence in the host-visible control record, sets a wrap-safe failure word
+and poisons the runtime (later launches do nothing, so a wedged peer costs one timeout, not one per exchange). The
+engine checks after every sampler exchange (each step has one, after the step's graphs) and raises a clear error
+that says whether the peer's flag had reached this host's memory (lost in the GPU's view, sparkring #278's
+signature) or never arrived, and what this rank's proxy had posted; the marker file makes the restarted pair use
+NCCL. A timed-out step's data are not trusted: nothing derived from it is returned.
+
+patches/0350: "had reached this host's memory" is decided at the moment of the failure, not at the check. The
+kernel records its last read of the flag (``CTRL_ERR_SEEN``); the proxy thread notices the failure word within
+microseconds and records the flag as host memory holds it then, and how long after the failure it arrived, if it
+did (``roce_watch.h``). ``classify`` turns that into one of: ``not_seen`` (in host memory at the failure while the
+GPU read a stale value: a visibility problem), ``late`` (arrived after the timeout: a late or absent peer, e.g. a
+single process that ran one rank's collectives alone -- the W2 loopback), ``never`` (not arrived), ``unknown`` (no
+watch: only the check-time value). The W2 loopback failure was ``late`` (tests/test_roce_protocol_model.py).
+"""
+
+from __future__ import annotations
+
+import ctypes
+import fcntl
+import json
+import os
+import socket
+import struct
+import sys
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+import torch
+
+BACKEND_ENV = "GLM53_TF_COMM_BACKEND"
+BACKENDS = ("nccl", "roce")
+PACK = 16
+SLOT_ALIGN = 4096
+SYSFS = "/sys/class/infiniband"
+PROBE_TIMEOUT_S = 15.0
+DEFAULT_MARK = "/cache/roce-failed"
+# control record words (roce_common.h)
+CTRL_SEQ, CTRL_NBYTES, CTRL_ERR_SEQ, CTRL_ERR_PEER, CTRL_SLOT_NBYTES, CTRL_ERR_HCA, CTRL_FAILED, CTRL_COMPLETED = \
+    0, 1, 2, 3, 4, 6, 7, 8
+CTRL_ERR_SEEN = 9                     # patches/0350: the failed wait's last read of the flag
+CTRL_WORDS = 10
+MAX_HCAS = 2
+
+
+class RoceError(RuntimeError):
+    """A RoCE collective failed at run time (timeout or proxy error); the runtime is poisoned."""
+
+
+class SetupError(RuntimeError):
+    """RoCE setup failed on some rank (every rank raises it, with every rank's reason)."""
+
+
+def _log(msg: str) -> None:
+    print(f"[tensorfold] roce: {msg}", file=sys.stderr, flush=True)
+
+
+# -- knobs ------------------------------------------------------------------------------------------------------------
+def backend(raw: str | None = None) -> str:
+    v = (os.environ.get(BACKEND_ENV, "") if raw is None else raw).strip().lower() or "nccl"
+    if v not in BACKENDS:
+        raise ValueError(f"{BACKEND_ENV}={v!r}: expected nccl or roce")
+    return v
+
+
+@dataclass(frozen=True)
+class Settings:
+    max_bytes: int = 256 * 1024
+    timeout_s: float = 120.0
+    hcas: int = 2
+    blocks: int = 8
+    threads: int = 512
+    traffic_class: int = 0
+    fallback: str = "nccl"
+    cpu: int = -1
+    hca_spec: str = ""
+    stripe_kb: int = 0                    # patches/0460 (agreed): shards below this travel on one HCA
+    inline_bytes: int = 0                 # patches/0460 (local): inline posts up to this many bytes
+    lazy_cq: bool = False                 # patches/0460 (local)
+    lean: bool = False                    # patches/0460 (local): release / acquire kernel ordering
+    trace: int = 0                        # patches/0460 (local): timestamp ring entries (0: off)
+    fast: bool = False                    # G14 (local): gather_fast_kernel
+    pollers: int = 1                      # G14 (local): pollers a flag (fast only)
+    stagger_ns: int = 150                 # G14 (local): their start stagger
+    trace_host: bool = False              # G14 (local): the trace ring in pinned host memory (GLM53_TF_ROCE_TRACE_DUMP_S)
+
+    def agreed(self) -> list[int]:
+        """The integers both ranks must share (everything but the proxy's CPU and the device names)."""
+
+        return [self.max_bytes, int(round(self.timeout_s * 1000)), self.hcas, self.blocks, self.threads,
+                self.traffic_class, int(self.fallback == "error"), self.stripe_kb]
+
+
+def _int(name: str, default: int, lo: int, hi: int) -> int:
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return default
+    try:
+        v = int(raw, 0)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r}: expected an integer") from None
+    if not lo <= v <= hi:
+        raise ValueError(f"{name}={v}: expected {lo}..{hi}")
+    return v
+
+
+def settings() -> Settings:
+    kb = _int("GLM53_TF_ROCE_MAX_KB", 256, 1, 65536)
+    raw_t = os.environ.get("GLM53_TF_ROCE_TIMEOUT_S", "").strip()
+    try:
+        timeout = float(raw_t) if raw_t else 120.0
+    except ValueError:
+        raise ValueError(f"GLM53_TF_ROCE_TIMEOUT_S={raw_t!r}: expected seconds") from None
+    if not 0.01 <= timeout <= 86400:
+        raise ValueError(f"GLM53_TF_ROCE_TIMEOUT_S={timeout}: expected 0.01..86400")
+    blocks = _int("GLM53_TF_ROCE_BLOCKS", 8, 1, 64)
+    if blocks & (blocks - 1):
+        raise ValueError(f"GLM53_TF_ROCE_BLOCKS={blocks}: expected a power of two")   # the arrival counters' modulus
+    threads = _int("GLM53_TF_ROCE_THREADS", 512, 32, 1024)
+    if threads % 32:
+        raise ValueError(f"GLM53_TF_ROCE_THREADS={threads}: expected a multiple of 32")
+    tc_name = "GLM53_TF_ROCE_TC" if os.environ.get("GLM53_TF_ROCE_TC", "").strip() else "NCCL_IB_TC"
+    fallback = os.environ.get("GLM53_TF_ROCE_FALLBACK", "").strip().lower() or "nccl"
+    if fallback not in ("nccl", "error"):
+        raise ValueError(f"GLM53_TF_ROCE_FALLBACK={fallback!r}: expected nccl or error")
+    trace = _int("GLM53_TF_ROCE_TRACE", 0, 0, 1 << 20)
+    if trace & (trace - 1):
+        raise ValueError(f"GLM53_TF_ROCE_TRACE={trace}: expected 0 or a power of two")
+    return Settings(max_bytes=kb * 1024, timeout_s=timeout, hcas=_int("GLM53_TF_ROCE_HCAS", 2, 1, MAX_HCAS),
+                    blocks=blocks, threads=threads, traffic_class=_int(tc_name, 0, 0, 255), fallback=fallback,
+                    cpu=_int("GLM53_TF_ROCE_CPU", -1, -1, 4095), hca_spec=os.environ.get("GLM53_TF_ROCE_HCA", ""),
+                    stripe_kb=_int("GLM53_TF_ROCE_STRIPE_KB", 0, 0, 65536),
+                    inline_bytes=_int("GLM53_TF_ROCE_INLINE", 0, 0, 4096),
+                    lazy_cq=bool(_int("GLM53_TF_ROCE_LAZY_CQ", 0, 0, 1)), lean=bool(_int("GLM53_TF_ROCE_LEAN", 0, 0, 1)),
+                    trace=trace, fast=bool(_int("GLM53_TF_ROCE_FAST", 0, 0, 1)),
+                    pollers=_int("GLM53_TF_ROCE_POLLERS", 1, 1, 8),
+                    stagger_ns=_int("GLM53_TF_ROCE_STAGGER_NS", 150, 0, 100000),
+                    trace_host=bool(trace) and _dump_period() > 0)
+
+
+def _dump_period() -> float:
+    """G14: ``GLM53_TF_ROCE_TRACE_DUMP_S`` (seconds; 0 = no dump thread) when ``GLM53_TF_ROCE_TRACE_DUMP`` is set."""
+
+    if not os.environ.get("GLM53_TF_ROCE_TRACE_DUMP", "").strip():
+        return 0.0
+    raw = os.environ.get("GLM53_TF_ROCE_TRACE_DUMP_S", "").strip()
+    try:
+        v = float(raw) if raw else 0.0
+    except ValueError:
+        raise ValueError(f"GLM53_TF_ROCE_TRACE_DUMP_S={raw!r}: expected seconds") from None
+    if v < 0 or v > 3600:
+        raise ValueError(f"GLM53_TF_ROCE_TRACE_DUMP_S={v}: expected 0..3600")
+    return v
+
+
+def marker() -> Path | None:
+    raw = os.environ.get("GLM53_TF_ROCE_MARK")
+    if raw is None:
+        return Path(DEFAULT_MARK) if Path(DEFAULT_MARK).parent.is_dir() else None
+    return Path(raw) if raw.strip() else None
+
+
+# -- HCAs and GIDs ----------------------------------------------------------------------------------------------------
+@dataclass(frozen=True)
+class Hca:
+    name: str
+    gid_index: int
+    ipv4: str | None = None
+    prefix: int = 24
+    netdev: str | None = None
+
+    def key(self) -> tuple:
+        """What pairs this port with a peer's: its IPv4 subnet (else its name)."""
+
+        if self.ipv4 is None:
+            return ("name", self.name)
+        ip = int.from_bytes(socket.inet_aton(self.ipv4), "big")
+        mask = (0xFFFFFFFF << (32 - self.prefix)) & 0xFFFFFFFF
+        return ("net", ip & mask, self.prefix)
+
+
+def _read(path: Path) -> str | None:
+    try:
+        return path.read_text().strip()
+    except OSError:
+        return None
+
+
+def ipv4_of_gid(gid: str) -> str | None:
+    """``0000:...:ffff:c633:640a`` -> ``198.51.100.10``; None for a GID that is not IPv4-mapped."""
+
+    h = gid.replace(":", "").lower()
+    if len(h) != 32 or h[:20] != "0" * 20 or h[20:24] != "ffff":
+        return None
+    return ".".join(str(int(h[24 + 2 * i:26 + 2 * i], 16)) for i in range(4))
+
+
+def _prefix(netdev: str | None) -> int:
+    """The IPv4 prefix length of ``netdev`` (SIOCGIFNETMASK), 24 when unknown."""
+
+    if not netdev:
+        return 24
+    try:
+        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
+            res = fcntl.ioctl(s.fileno(), 0x891B, struct.pack("256s", netdev.encode()[:15]))
+        return bin(int.from_bytes(res[20:24], "big")).count("1")
+    except OSError:
+        return 24
+
+
+def parse_hca_spec(spec: str) -> list[tuple[str, int | None]]:
+    out = []
+    for item in spec.split(","):
+        item = item.strip()
+        if not item:
+            continue
+        name, _, gid = item.partition(":")
+        try:
+            out.append((name.strip(), int(gid) if gid.strip() else None))
+        except ValueError:
+            raise ValueError(f"GLM53_TF_ROCE_HCA: {item!r}: expected name or name:gid_index") from None
+    return out
+
+
+def detect(spec: str = "", root: str | None = None) -> list[Hca]:
+    """Active RoCE ports with their RoCE v2 GID index (the lowest IPv4-mapped one; ``name:gid`` in ``spec`` forces
+    it). ``spec`` (``GLM53_TF_ROCE_HCA``) restricts to the named devices, in its order."""
+
+    wanted = parse_hca_spec(spec)
+    base = Path(root or SYSFS)
+    names = [n for n, _ in wanted] if wanted else sorted(p.name for p in base.iterdir()) if base.is_dir() else []
+    forced = dict(wanted)
+    out = []
+    for name in names:
+        port = base / name / "ports" / "1"
+        state = _read(port / "state")
+        if state is None or "ACTIVE" not in state:
+            if wanted:
+                raise ValueError(f"GLM53_TF_ROCE_HCA: {name} port 1 is {state or 'missing'}, not ACTIVE")
+            continue
+        link = _read(port / "link_layer")
+        if link is not None and link != "Ethernet":
+            continue
+        try:
+            indices = sorted(int(x) for x in os.listdir(port / "gids"))
+        except OSError:
+            indices = []
+        chosen = None
+        for i in indices:
+            gid = _read(port / "gids" / str(i))
+            if gid is None:
+                continue
+            if forced.get(name) is not None and i != forced[name]:
+                continue
+            if forced.get(name) is None and _read(port / "gid_attrs" / "types" / str(i)) != "RoCE v2":
+                continue
+            ip = ipv4_of_gid(gid)
+            if ip is None and forced.get(name) is None:
+                continue
+            netdev = _read(port / "gid_attrs" / "ndevs" / str(i))
+            chosen = Hca(name, i, ip, _prefix(netdev) if ip else 24, netdev)
+            break
+        if chosen is None and forced.get(name) is not None:
+            chosen = Hca(name, int(forced[name]))
+        if chosen is None:
+            if wanted:
+                raise ValueError(f"GLM53_TF_ROCE_HCA: {name} has no IPv4-mapped RoCE v2 GID")
+            continue
+        out.append(chosen)
+    return out
+
+
+def pair(lists: list[list[Hca]], most: int) -> list[list[int]]:
+    """Per rank, the indices of the HCAs to use, HCA h of every rank on one subnet (rank 0's order); at most
+    ``most``. The same answer on every rank (a function of every rank's list)."""
+
+    chosen: list[list[int]] = [[] for _ in lists]
+    for i, h0 in enumerate(lists[0]):
+        if len(chosen[0]) >= most:
+            break
+        picks = [i]
+        for r in range(1, len(lists)):
+            j = next((j for j, h in enumerate(lists[r]) if j not in chosen[r] and h.key() == h0.key()), None)
+            if j is None:
+                break
+            picks.append(j)
+        if len(picks) == len(lists):
+            for r, j in enumerate(picks):
+                chosen[r].append(j)
+    return chosen
+
+
+# -- the extension ----------------------------------------------------------------------------------------------------
+_EXT = None
+
+
+def _ext():
+    global _EXT
+    if _EXT is None:
+        from tensorfold.cuda.build import load
+
+        here = Path(__file__).parent
+        _EXT = load(name="tensorfold_glm_roce_v4", sources=[str(here / "roce.cpp"), str(here / "roce.cu")],  # G14: v4
+                    extra_cflags=["-O2"], extra_cuda_cflags=["-O3"], extra_ldflags=["-libverbs"], verbose=False)
+    return _EXT
+
+
+def _align(v: int, a: int) -> int:
+    return (int(v) + a - 1) // a * a
+
+
+def grid_blocks(nbytes: int, threads: int, most: int) -> int:
+    """A power-of-two grid with about two 16-byte packs a thread (b12x's choice), at most ``most`` blocks."""
+
+    packs = max(1, (int(nbytes) + PACK - 1) // PACK)
+    need = max(1, (packs + 2 * threads - 1) // (2 * threads))
+    return min(1 << (need - 1).bit_length(), most)
+
+
+class Runtime:
+    """This rank's pinned region, device counters, kernel launcher and RDMA proxy (``hcas``), or, for tests on one
+    GPU, a loop-back thread that plays the peers (``loop_xor``: every peer's shard = this rank's XOR the key)."""
+
+    def __init__(self, *, rank: int, world: int, hcas: list[Hca], s: Settings, loop_xor: int | None = None,
+                 loop_stall_after: int = -1, n_hca: int | None = None, loop_late: bool = False) -> None:
+        ext = _ext()
+        self.ext, self.rank, self.world, self.s = ext, rank, world, s
+        self.hcas = list(hcas)
+        self.n_hca = len(self.hcas) if n_hca is None else int(n_hca)
+        if not 1 <= self.n_hca <= MAX_HCAS:
+            raise ValueError(f"roce: {self.n_hca} HCAs")
+        self.slot_bytes = _align(max(s.max_bytes, PACK), SLOT_ALIGN)
+        (self.recv_off, self.flag_off, self.send_off, self.ctrl_off, self.total, self.flag_stride,
+         self.slots) = (int(v) for v in ext.layout(world, self.slot_bytes))
+        self.host, self.dev = (int(v) for v in ext.alloc_pinned(self.total))
+        self._freed = False
+        self.proxy = None
+        self.loop = None
+        self.classes = s.blocks.bit_length()
+        # epoch, stage arrivals per grid size, tail arrivals per grid size, poison
+        self.counters = torch.zeros(2 + 2 * self.classes, dtype=torch.int32, device="cuda")
+        base = self.counters.data_ptr()
+        self._epoch_addr, self._poison_addr = base, base + 4 * (1 + 2 * self.classes)
+        words = (ctypes.c_uint32 * CTRL_WORDS).from_address(self.host + self.ctrl_off)
+        self.ctrl = np.frombuffer(words, dtype=np.uint32)
+        nflag = world * self.slots * MAX_HCAS * self.flag_stride // 4
+        self.flags = np.frombuffer((ctypes.c_uint32 * nflag).from_address(self.host + self.flag_off), dtype=np.uint32)
+        d = self.dev
+        self.stripe_min = stripe_min(s)                   # patches/0460
+        self.trace_buf = torch.zeros(4 * s.trace, dtype=torch.int64, device="cuda") \
+            if s.trace and not s.trace_host else None
+        self.trace_host, self._trace_pin, trace_dev = None, None, 0       # G14: a host ring (rocedump's thread)
+        if s.trace and s.trace_host:
+            th, trace_dev = (int(v) for v in ext.alloc_pinned(32 * s.trace))
+            self._trace_pin = th
+            self.trace_host = np.frombuffer((ctypes.c_int64 * (4 * s.trace)).from_address(th), dtype=np.int64)
+        elif self.trace_buf is not None:
+            trace_dev = self.trace_buf.data_ptr()
+        self.launcher = ext.Launcher(d + self.recv_off, d + self.flag_off, d + self.send_off, d + self.ctrl_off,
+                                     self.slot_bytes, self._epoch_addr, self._poison_addr, world, rank, self.n_hca,
+                                     self.flag_stride, self.slots, s.threads, self.stripe_min, bool(s.lean),
+                                     trace_dev, int(s.trace), bool(s.fast), int(s.pollers),   # G14
+                                     int(s.stagger_ns), bool(self.trace_host is not None))
+        self.timeout_ns = int(s.timeout_s * 1e9)
+        self.lock = threading.Lock()
+        self.event = torch.cuda.Event()
+        self._last: tuple | None = None           # (stream, capture id) of the last collective
+        self._mbox = None                          # G14: the host mailbox (``mailbox``)
+        self.ops = 0
+        self._reported = False
+        self.marking = True                        # a run-time failure leaves the marker (not the load-time probe)
+        try:
+            if loop_xor is not None:
+                self.loop = ext.Loop(self.host, self.recv_off, self.flag_off, self.send_off, self.ctrl_off,
+                                     self.slot_bytes, world, rank, self.n_hca, self.flag_stride, self.slots,
+                                     int(loop_xor) & 0xFF, int(loop_stall_after), bool(loop_late), self.stripe_min)
+            else:
+                self.proxy = ext.Proxy(world, rank, [h.name for h in self.hcas], [h.gid_index for h in self.hcas],
+                                       s.traffic_class, self.host, self.total, self.slot_bytes, self.stripe_min,
+                                       int(s.inline_bytes), bool(s.lazy_cq), int(s.trace))
+        except Exception:
+            self._free()
+            raise
+
+    # -- setup
+    def blob(self) -> bytes:
+        return bytes(self.proxy.local_blob())
+
+    def connect(self, blobs: list[bytes]) -> None:
+        self.proxy.connect(b"".join(blobs))
+        self.proxy.start(self.s.cpu)
+
+    # -- the collective
+    def _counter_addrs(self, blocks: int) -> tuple[int, int]:
+        c = blocks.bit_length() - 1
+        return self._epoch_addr + 4 * (1 + c), self._epoch_addr + 4 * (1 + self.classes + c)
+
+    def _order(self) -> None:
+        """One epoch, one doorbell, two slots: collectives must run in launch order even across streams. Eager, or
+        both in one capture: a switch of stream waits for the previous stream (an event recorded there now covers
+        the last collective). A capture starts after a device sync, so its first collective needs no edge."""
+
+        cur = torch.cuda.current_stream()
+        cid = int(self.ext.capture_id()) if torch.cuda.is_current_stream_capturing() else 0
+        last = self._last
+        if last is not None and last[0] != cur and last[1] == cid:
+            self.event.record(last[0])
+            cur.wait_event(self.event)
+        self._last = (cur, cid)
+
+    def gather(self, send: torch.Tensor, recv: torch.Tensor, timeout_ns: int | None = None) -> None:
+        """recv [world x n] <- every rank's send [n], rank order (NCCL's all-gather), on the current stream."""
+
+        nbytes = send.numel() * send.element_size()
+        if recv.numel() * recv.element_size() != self.world * nbytes or recv.dtype != send.dtype:
+            raise ValueError("roce all_gather: recv must hold world x send of the same dtype")
+        if not (send.is_contiguous() and recv.is_contiguous() and send.is_cuda and recv.is_cuda):
+            raise ValueError("roce all_gather: contiguous CUDA tensors only")
+        if nbytes == 0:
+            return
+        with self.lock:
+            capturing = torch.cuda.is_current_stream_capturing()
+            if not capturing:
+                self.check()
+            self._order()
+            blocks = grid_blocks(nbytes, self.s.threads, self.s.blocks)
+            stage, tail = self._counter_addrs(blocks)
+            self.launcher.run(send.data_ptr(), recv.data_ptr(), nbytes, blocks, stage, tail,
+                              self.timeout_ns if timeout_ns is None else int(timeout_ns))
+            self.ops += 1
+
+    # -- G14: the host mailbox (roce_msg.h; TF_DSV41_PLAN_LINK=rdma)
+    def mailbox(self):
+        """``ext.Mailbox`` over this runtime's pinned region: ``send(bytes, timeout_s) -> bool`` (one sender rank) and
+        ``recv(src, spin_us, nap_us, fd, timeout_s) -> bytes``; the proxy (or the test loop) delivers the chunks."""
+
+        if self._mbox is None:
+            lay = [int(v) for v in self.ext.msg_layout(self.world, self.slot_bytes)]
+            self._mbox = self.ext.Mailbox(self.host, self.ctrl_off, lay[5], self.world, self.rank)
+        return self._mbox
+
+    # -- health
+    @property
+    def failed(self) -> bool:
+        return bool(self.ctrl[CTRL_FAILED]) or (self.proxy is not None and self.proxy.failed())
+
+    def check(self) -> None:
+        """Raise ``RoceError`` if a wait timed out or the proxy stopped on an error (two host memory reads). Reads no
+        device memory and never synchronizes, so it is safe while a kernel is still running."""
+
+        proxy_failed = self.proxy is not None and self.proxy.failed()
+        if not self.ctrl[CTRL_FAILED] and not proxy_failed:
+            return
+        if getattr(self, "aborted", None):         # fail-fast's host poison (``abort``): not a transport failure
+            raise RoceError(self.aborted)
+        msg = self.diagnose()
+        if not self._reported:
+            self._reported = True
+            _log(msg)
+            mark = marker() if self.marking else None
+            if mark is not None:
+                try:
+                    mark.write_text(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} rank {self.rank}: {msg}\n")
+                except OSError:
+                    pass
+        raise RoceError(msg)
+
+    def abort(self, reason: str, hold_s: float = 0.0) -> None:
+        """Poison this runtime from the host because the PEER failed (DeepSeek-V4.1's ``failfast.py``): the failure
+        word is set (``check`` and every later eager ``gather`` raise ``RoceError(reason)`` at once, no marker file:
+        the transport is fine), and every peer flag of the newest staged sequence (the doorbell) is written to that
+        sequence, so a kernel spinning on a peer that will never write returns now instead of after
+        ``GLM53_TF_ROCE_TIMEOUT_S`` (120 s). Its output is garbage and is never used: the host raises on its next
+        check. For ``hold_s`` seconds the flags keep following the doorbell (the fast kernel publishes the epoch
+        without reading the failure word, so a graph replay launches the next sequence), then it returns. Host
+        stores only (pinned memory): safe while a kernel runs, from any thread."""
+
+        self.aborted = f"RoCE runtime aborted on rank {self.rank}: {reason}"
+        self.marking = False
+        self.ctrl[CTRL_FAILED] = 1
+        end = time.monotonic() + max(0.0, float(hold_s))
+        while True:
+            seq = int(self.ctrl[CTRL_SEQ])
+            for p in range(self.world):
+                if p == self.rank:
+                    continue
+                for h in range(self.n_hca):
+                    self.flags[self._flag_word(p, seq & 1, h)] = seq
+            if time.monotonic() >= end:
+                return
+            time.sleep(0.001)
+
+    def snapshot(self) -> dict:
+        """The control record, every flag word per (peer, slot, HCA) and the proxy's counters, from host memory."""
+
+        flags = {}
+        for p in range(self.world):
+            if p == self.rank:
+                continue
+            for slot in range(self.slots):
+                for h in range(self.n_hca):
+                    flags[f"{p}/{slot}/{h}"] = int(self.flags[self._flag_word(p, slot, h)])
+        out = {"doorbell": int(self.ctrl[CTRL_SEQ]), "completed": int(self.ctrl[CTRL_COMPLETED]),
+               "failed": int(self.ctrl[CTRL_FAILED]), "err_seq": int(self.ctrl[CTRL_ERR_SEQ]),
+               "err_peer": int(self.ctrl[CTRL_ERR_PEER]), "err_hca": int(self.ctrl[CTRL_ERR_HCA]),
+               "gpu_seen": int(self.ctrl[CTRL_ERR_SEEN]), "flags": flags, "ops": self.ops}
+        watcher = self.proxy if self.proxy is not None else self.loop            # patches/0350
+        if watcher is not None and hasattr(watcher, "watch"):
+            w = [int(v) for v in watcher.watch()]
+            out["watch"] = {"state": w[0], "seq": w[1], "peer": w[2], "hca": w[3], "host_at_fail": w[4],
+                            "gpu_seen": w[5], "late_ms": round(w[6] / 1e6, 3)}
+        if self.proxy is not None:
+            st = [int(v) for v in self.proxy.stats()]
+            out.update(ops_posted=st[0], writes_completed=st[1], proxy_last_seq=st[2],
+                       per_hca=[{"writes": st[3 + 2 * h], "bytes": st[4 + 2 * h]} for h in range(self.n_hca)],
+                       proxy_error=self.proxy.error())
+            if hasattr(self.proxy, "stats2"):             # patches/0460
+                s2 = [int(v) for v in self.proxy.stats2()]
+                out.update(inline_posts=s2[0], single_hca_ops=s2[1], inline_cap=s2[2:])
+        return out
+
+    def _flag_word(self, peer: int, slot: int, hca: int) -> int:
+        return ((peer * self.slots + slot) * self.n_hca + hca) * self.flag_stride // 4
+
+    def diagnose(self) -> str:
+        snap = self.snapshot()
+        if self.proxy is not None and self.proxy.failed():
+            return (f"RoCE proxy on rank {self.rank} stopped: {snap.get('proxy_error')} (doorbell "
+                    f"{snap['doorbell']}, completed {snap['completed']}); the runtime is unusable")
+        seq, peer, h = snap["err_seq"], snap["err_peer"], snap["err_hca"]
+        seen = int(self.flags[self._flag_word(peer, seq & 1, h)]) if peer < self.world and h < self.n_hca else -1
+        name = self.hcas[h].name if h < len(self.hcas) else f"HCA {h}"
+        where = classify(seq, snap["gpu_seen"], seen, snap.get("watch"))[1]      # patches/0350
+        posted = f", this rank's proxy posted up to {snap['proxy_last_seq']}" if "proxy_last_seq" in snap else ""
+        return (f"RoCE all-gather on rank {self.rank} timed out after {self.s.timeout_s:g} s waiting for rank "
+                f"{peer} on {name} at sequence {seq}: {where}; doorbell {snap['doorbell']}, completed "
+                f"{snap['completed']}{posted}. The runtime is poisoned (later exchanges do nothing) and this step's "
+                f"data are not trusted: restart both ranks (GLM53_TF_COMM_BACKEND=nccl avoids RoCE; "
+                f"{marker() or 'GLM53_TF_ROCE_MARK'} makes the next start use NCCL)")
+
+    # -- patches/0460: timestamps
+    def trace_rows(self, seqs=None) -> list[dict]:
+        """The trace ring after a synchronize: per op still in it, the kernel's globaltimer stamps (ns) and the proxy's
+        CLOCK_REALTIME stamps (``trace_summary`` turns them into components)."""
+
+        if self.trace_buf is None and self.trace_host is None:
+            return []
+        ring = self.s.trace
+        if self.trace_host is not None:                 # G14: pinned host memory, no CUDA call
+            k = self.trace_host.reshape(ring, 4).tolist()
+        else:
+            k = self.trace_buf.view(ring, 4).cpu().tolist()
+        last = int(self.ctrl[CTRL_COMPLETED])
+        seqs = range(max(1, last - ring + 1), last + 1) if seqs is None else seqs
+        out = []
+        for q in seqs:
+            t0, bell, flag, end = k[q & (ring - 1)]
+            row = {"seq": int(q), "start": t0, "bell": bell, "flag": flag, "end": end}
+            if self.proxy is not None and hasattr(self.proxy, "trace"):
+                row["seen"], row["posted"] = (int(v) for v in self.proxy.trace(int(q)))
+            out.append(row)
+        return out
+
+    # -- teardown
+    def _free(self) -> None:
+        if not self._freed:
+            self._freed = True
+            self.ext.free_pinned(self.host)
+            if self._trace_pin is not None:           # G14: a dump thread may be reading it: then it stays (128 KiB)
+                self.trace_host = None
+                if not getattr(self, "_trace_dumped", False):
+                    self.ext.free_pinned(self._trace_pin)
+                self._trace_pin = None
+
+    def close(self, free: bool = True) -> None:
+        """Stop the proxy (or loop) and release the queue pairs; ``free``: also the pinned region (only when no
+        kernel can still use it: after a device sync)."""
+
+        for x in (self.proxy, self.loop):
+            if x is not None:
+                x.destroy()
+        self.proxy = self.loop = None
+        if free:
+            self._free()
+
+
+def stripe_min(s: Settings) -> int:
+    """patches/0460: the kernel's / proxy's ``stripe_min`` in (16-byte padded) bytes; 0 = always striped."""
+
+    return int(s.stripe_kb) * 1024
+
+
+def one_hca(padded: int, stripe_min_bytes: int, n_hca: int) -> bool:
+    """roce_common.h's rule, for tests and the protocol model: does an op of ``padded`` bytes use one HCA?"""
+
+    return stripe_min_bytes != 0 and padded < stripe_min_bytes and n_hca > 1
+
+
+def _pct(v: list, q: float) -> float:
+    if not v:
+        return 0.0
+    v = sorted(v)
+    return float(v[min(len(v) - 1, int(q * (len(v) - 1) + 0.5))])
+
+
+def trace_summary(rows: list[dict], peer_rows: list[dict] | None = None) -> dict:
+    """patches/0460: per component, median / p90 in microseconds over the traced ops of one rank:
+
+    - ``stage``  kernel start -> doorbell (staging copy + fences);
+    - ``wait``   doorbell -> the peer's flags seen (the peer's lateness + proxy + wire + NIC write + visibility);
+    - ``copy``   flags seen -> kernel end (copy-out + tail);
+    - ``total``  start -> end;
+    - ``notice`` doorbell (GPU globaltimer) -> the proxy saw it (CPU CLOCK_REALTIME): meaningful only if the two
+      clocks agree (on GB10 the driver keeps globaltimer on the host's clock; check that ``notice`` is small and
+      positive), ``post`` the proxy's ibv_post_send calls.
+    With ``peer_rows`` (the other rank's rows, same seqs): per op the smaller of the two ranks' waits is the
+    transport (neither rank was waiting for a late peer), the difference is the skew (``transport`` / ``skew``)."""
+
+    comp: dict[str, list] = {k: [] for k in ("stage", "wait", "copy", "total", "notice", "post")}
+    by_seq = {}
+    for r in rows:
+        if not (r["start"] and r["bell"] and r["flag"] and r["end"]):
+            continue
+        comp["stage"].append((r["bell"] - r["start"]) / 1e3)
+        comp["wait"].append((r["flag"] - r["bell"]) / 1e3)
+        comp["copy"].append((r["end"] - r["flag"]) / 1e3)
+        comp["total"].append((r["end"] - r["start"]) / 1e3)
+        by_seq[r["seq"]] = (r["flag"] - r["bell"]) / 1e3
+        if r.get("seen") and r.get("posted"):
+            comp["notice"].append((r["seen"] - r["bell"]) / 1e3)
+            comp["post"].append((r["posted"] - r["seen"]) / 1e3)
+    if peer_rows is not None:
+        comp["transport"], comp["skew"] = [], []
+        for r in peer_rows:
+            if r["seq"] in by_seq and r["bell"] and r["flag"]:
+                a, b = by_seq[r["seq"]], (r["flag"] - r["bell"]) / 1e3
+                comp["transport"].append(min(a, b))
+                comp["skew"].append(abs(a - b))
+    return {k: {"n": len(v), "p50_us": round(_pct(v, 0.5), 2), "p90_us": round(_pct(v, 0.9), 2)}
+            for k, v in comp.items() if v}
+
+
+def classify(seq: int, gpu_seen: int, host_now: int, watch: dict | None) -> tuple[str, str]:
+    """patches/0350: (kind, sentence) for a wait that timed out at ``seq``: ``gpu_seen`` the kernel's last read of the
+    flag, ``host_now`` the flag in host memory at the check, ``watch`` the proxy's record (``roce_watch.h``; None or
+    state 0 when there is none). Kinds: not_seen, late, never, unknown (see the module doc)."""
+
+    if watch and watch.get("state") and watch.get("seq") == seq:
+        at = watch["host_at_fail"]
+        if at == seq and gpu_seen != seq:
+            return "not_seen", (f"the flag WAS in this host's memory when the wait failed while the GPU's last read "
+                                f"returned {gpu_seen}: a GPU-visibility failure (sparkring #278's signature)")
+        if watch["state"] == 2:
+            return "late", (f"the flag arrived {watch['late_ms']:g} ms AFTER the wait failed (the GPU's last read "
+                            f"{gpu_seen}, host memory {at} then): the peer was late or had not launched this "
+                            f"collective, not a visibility problem")
+        if at == seq:
+            return "unknown", (f"the flag was in host memory at the failure and the GPU's last read also returned it "
+                               f"({gpu_seen}): the wait gave up at its last look")
+        return "never", (f"the flag never arrived (host memory held {at} at the failure, {host_now} now; the GPU's "
+                         f"last read {gpu_seen})")
+    if host_now == seq:
+        return "unknown", (f"the flag is in this host's memory NOW (the GPU's last read returned {gpu_seen}); "
+                           f"whether it arrived before the timeout is not known (no watch record)")
+    return "never", f"the flag never arrived (host memory holds {host_now})"
+
+
+COMMS: list = []                                # patches/0530: every RoceComm made in this process
+
+
+class RoceComm:
+    """The engine's communicator with the RoCE runtime beside NCCL: ``all_gather`` (control exchanges) stays on
+    ``base``; ``all_gather_fast`` (the model's exchanges) goes over RoCE when one rank's shard is at most
+    ``max_bytes`` (a decision of the size alone, so both ranks take the same path)."""
+
+    def __init__(self, base, rt, max_bytes: int) -> None:
+        self.base, self.rt, self.max_bytes = base, rt, int(max_bytes)
+        self.rank, self.world = base.rank, base.world
+        self.fast_ops = self.slow_ops = 0
+        COMMS.append(self)                      # patches/0530: rocedump finds the runtime here
+
+    def __getattr__(self, name):                   # store, lib, comm, ... of the NCCL communicator
+        if name == "base":
+            raise AttributeError(name)
+        return getattr(self.base, name)
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        self.base.all_gather(send, recv)
+
+    def all_gather_fast(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        n = send.numel() * send.element_size()
+        if 0 < n <= self.max_bytes and send.is_contiguous() and recv.is_contiguous():
+            self.rt.gather(send, recv)
+            self.fast_ops += 1
+        else:
+            self.base.all_gather(send, recv)
+            self.slow_ops += 1
+
+    def barrier(self) -> None:
+        self.base.barrier()
+        self.rt.check()
+
+    def check(self) -> None:
+        self.rt.check()
+
+
+# -- collective setup -------------------------------------------------------------------------------------------------
+def _dev(base) -> str:
+    return getattr(base, "device", "cuda")      # host-only tests pass a communicator on the CPU
+
+
+def _gather_ints(base, values: list[int]) -> list[list[int]]:
+    mine = torch.tensor(values, dtype=torch.int64, device=_dev(base))
+    got = torch.empty((base.world * len(values),), dtype=torch.int64, device=_dev(base))
+    base.all_gather(mine, got)
+    flat = got.tolist()
+    return [flat[r * len(values):(r + 1) * len(values)] for r in range(base.world)]
+
+
+def exchange(base, obj) -> list:
+    """Every rank's JSON-able ``obj`` in rank order, over ``base``'s all-gather."""
+
+    data = json.dumps(obj).encode()
+    lens = [v[0] for v in _gather_ints(base, [len(data)])]
+    width = max(1, (max(lens) + 3) // 4)
+    buf = np.zeros((width * 4,), dtype=np.uint8)
+    buf[:len(data)] = np.frombuffer(data, dtype=np.uint8)
+    mine = torch.from_numpy(buf.view(np.int32).copy()).to(_dev(base))
+    got = torch.empty((base.world * width,), dtype=torch.int32, device=_dev(base))
+    base.all_gather(mine, got)
+    raw = got.cpu().numpy().tobytes()
+    return [json.loads(raw[r * width * 4:r * width * 4 + lens[r]]) for r in range(base.world)]
+
+
+def _verdict(base, error: str | None, what: str) -> list:
+    got = exchange(base, {"error": error})
+    bad = [f"rank {r}: {g['error']}" for r, g in enumerate(got) if g.get("error")]
+    if bad:
+        raise SetupError(f"{what}: " + "; ".join(bad))
+    return got
+
+
+def pattern(rank: int, nbytes: int, salt: int) -> torch.Tensor:
+    """Deterministic bytes a rank sends in the probe."""
+
+    i = torch.arange(nbytes, dtype=torch.int64, device="cuda")
+    return ((i * 131 + rank * 71 + salt * 29 + (i >> 8) * 7) & 0xFF).to(torch.uint8)
+
+
+def probe(rt: Runtime, base, sizes=None, timeout_s: float = PROBE_TIMEOUT_S) -> float:
+    """Gathers of several sizes (odd, unaligned, the largest slot) compared byte for byte with NCCL's result for the
+    same inputs; returns the mean eager latency (us) of 16-KiB gathers. Raises on any difference or timeout."""
+
+    sizes = sizes or [4, 7, 100, 16 * 1024, 16 * 1024 + 4, min(rt.s.max_bytes, 128 * 1024), rt.s.max_bytes]
+    timeout_ns = int(timeout_s * 1e9)
+    for salt, n in enumerate(sizes):
+        off = (4 if n % 16 else 0) if n % 4 == 0 else 1     # unaligned views too (NCCL takes any pointer)
+        src = torch.empty((n + off,), dtype=torch.uint8, device="cuda")
+        src[off:] = pattern(rt.rank, n, salt)
+        send = src[off:]
+        mine = torch.empty((rt.world * n,), dtype=torch.uint8, device="cuda")
+        ref = torch.empty_like(mine)
+        rt.gather(send, mine, timeout_ns)
+        base.all_gather(send, ref)
+        torch.cuda.synchronize()
+        rt.check()
+        if not torch.equal(mine, ref):
+            bad = int((mine != ref).nonzero()[0].item())
+            raise RuntimeError(f"probe of {n} bytes: RoCE result differs from NCCL's at byte {bad}")
+    x = pattern(rt.rank, 16 * 1024, 99)
+    y = torch.empty((rt.world * x.numel(),), dtype=torch.uint8, device="cuda")
+    for _ in range(8):
+        rt.gather(x, y, timeout_ns)
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(64):
+        rt.gather(x, y, timeout_ns)
+    torch.cuda.synchronize()
+    rt.check()
+    return (time.perf_counter() - t) / 64 * 1e6
+
+
+def connect(base, s: Settings) -> RoceComm:
+    """Collective: detect and pair the HCAs, open and connect the queue pairs, start the proxy, probe. Every rank
+    raises ``SetupError`` (with every rank's reason) when any rank fails."""
+
+    rank, world = base.rank, base.world
+    try:
+        mine = [h.__dict__ for h in detect(s.hca_spec)]
+        err = None if mine else f"no ACTIVE RoCE port with an IPv4-mapped RoCE v2 GID under {SYSFS}"
+    except Exception as exc:  # noqa: BLE001 - reported collectively
+        mine, err = [], f"{type(exc).__name__}: {exc}"
+    got = exchange(base, {"hcas": mine, "error": err})
+    bad = [f"rank {r}: {g['error']}" for r, g in enumerate(got) if g.get("error")]
+    if bad:
+        raise SetupError("HCA detection: " + "; ".join(bad))
+    lists = [[Hca(**h) for h in g["hcas"]] for g in got]
+    chosen = pair(lists, s.hcas)
+    if not chosen[0]:
+        raise SetupError("no pair of RoCE ports on a common subnet: " +
+                         "; ".join(f"rank {r}: {[(h.name, h.ipv4) for h in lst]}" for r, lst in enumerate(lists)))
+    hcas = [lists[rank][j] for j in chosen[rank]]
+    rt, err, blob = None, None, ""
+    try:
+        rt = Runtime(rank=rank, world=world, hcas=hcas, s=s)
+        blob = rt.blob().hex()
+    except Exception as exc:  # noqa: BLE001
+        err = f"{type(exc).__name__}: {exc}"
+    try:
+        got = exchange(base, {"blob": blob, "error": err})
+        bad = [f"rank {r}: {g['error']}" for r, g in enumerate(got) if g.get("error")]
+        if bad:
+            raise SetupError("queue pairs: " + "; ".join(bad))
+        err = None
+        try:
+            rt.connect([bytes.fromhex(g["blob"]) for g in got])
+        except Exception as exc:  # noqa: BLE001
+            err = f"{type(exc).__name__}: {exc}"
+        _verdict(base, err, "connect")
+        err, us = None, 0.0
+        rt.marking = False                         # a failed probe falls back now; it need not pin later starts
+        try:
+            us = probe(rt, base)
+        except Exception as exc:  # noqa: BLE001
+            err = f"{type(exc).__name__}: {exc}"
+        _verdict(base, err, "probe")
+        rt.marking = True
+    except BaseException:
+        if rt is not None:
+            torch.cuda.synchronize()
+            rt.close()
+        raise
+    if rank == 0:
+        ports = ", ".join(f"{h.name} (GID {h.gid_index}, {h.ipv4})" for h in hcas)
+        fast = f"; fast kernel, {s.pollers} poller(s)" if s.fast else ""          # G14
+        _log(f"all-gathers of up to {s.max_bytes // 1024} KiB a rank over RoCE on {ports}; timeout "
+             f"{s.timeout_s:g} s; probe {us:.1f} us eager at 16 KiB{fast}")
+    comm = RoceComm(base, rt, s.max_bytes)
+    from . import rocedump                      # G14: GLM53_TF_ROCE_TRACE_DUMP_S (off: nothing happens)
+
+    rocedump.start_thread(rt)
+    return comm
+
+
+def select(base):
+    """``GLM53_TF_COMM_BACKEND``: ``base`` (NCCL) or a ``RoceComm`` over it. Collective (both ranks call it at the same
+    point); refuses to start when the ranks' settings differ."""
+
+    want = backend()
+    s = settings()
+    mark = marker()
+    marked = mark is not None and mark.exists()
+    both = _gather_ints(base, [BACKENDS.index(want)] + s.agreed() + [int(marked)])
+    if any(b[:-1] != both[0][:-1] for b in both):
+        raise RuntimeError("the two ranks were started with different GLM53_TF_COMM_BACKEND / GLM53_TF_ROCE_* "
+                           f"settings: {[b[:-1] for b in both]} (backend, max bytes, timeout ms, HCAs, blocks, "
+                           "threads, traffic class, fallback=error)")
+    if want == "nccl":
+        return base
+    if any(b[-1] for b in both):
+        who = [r for r, b in enumerate(both) if b[-1]]
+        _log(f"a RoCE failure marker is present on rank(s) {who} ({mark}): serving on NCCL; delete it to use RoCE")
+        return base
+    try:
+        return connect(base, s)
+    except SetupError as exc:
+        if s.fallback == "error":
+            raise RuntimeError(f"GLM53_TF_COMM_BACKEND=roce: setup failed ({exc}); GLM53_TF_ROCE_FALLBACK=error") \
+                from None
+        _log(f"setup failed, serving on NCCL: {exc}")
+        return base
diff --git a/src/tensorfold/families/glm5_next/spark/roce_bench.py b/src/tensorfold/families/glm5_next/spark/roce_bench.py
new file mode 100644
index 0000000..d7a70d1
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce_bench.py
@@ -0,0 +1,217 @@
+"""G14: the RoCE all-gather's latency per exchange between the two Sparks, at DeepSeek-V4.1's decode sizes, with bits
+checked every op. One process a node, the same arguments but ``--rank`` (the development tree's
+(unpublished) G14 comm window, ``micro``):
+
+    python -m tensorfold.families.glm5_next.spark.roce_bench --rank 0 --master 198.51.100.10 --out /out/r0.json
+    python -m tensorfold.families.glm5_next.spark.roce_bench --rank 1 --master 198.51.100.10
+
+The transport is whatever ``GLM53_TF_COMM_BACKEND=roce`` + ``GLM53_TF_ROCE_*`` select (``roce.select``, the engine's
+own setup, probe included): run it once per variant. Per size (bytes ONE rank sends; default 10k / 20k / 40k / 80k =
+1 / 2 / 4 / 8 bf16 rows of 5,120):
+
+- **bits**: the RoCE result == NCCL's for the same inputs (odd offset too);
+- **eager** us an op (launch + wait: a sampler exchange);
+- **graph** us an op: ``--ops`` exchanges in one CUDA graph (a 1-row window has 81) with ``--work-us`` of GPU sleep
+  after each (taken off the result). 0: back to back, the critical path ``stage + T + copy`` an op; ~300: a decode
+  segment, the proxy idles between ops as in the engine;
+- **checked**: the same graph where a kernel makes each op's payload ``base + counter`` and another counts the peer
+  elements that differ from ``peer base + counter`` (a stale slot, a flag ahead of its payload or a lost op shows up),
+  ``--reps x --ops`` ops;
+- with ``GLM53_TF_ROCE_TRACE`` (or ``--trace N``, which sets it): both ranks' trace rows of the timed replays are
+  exchanged over NCCL and rank 0 splits them (``roce_split``: staging / wire / skew an op).
+
+Rank 0 writes ``--out`` (JSON) and prints one ``[G14] micro`` line per size. Exit status 1 on any mismatch or a fall
+back to NCCL.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+
+
+def _size(tok: str) -> int:
+    tok = tok.strip().lower()
+    mult = {"k": 1024, "m": 1024 * 1024}.get(tok[-1:], 1)
+    return int(float(tok[:-1] if tok[-1:] in "km" else tok) * mult)
+
+
+def _sleep_cycles_per_us(torch) -> float:
+    """GPU sleep cycles a microsecond (``torch.cuda._sleep``), measured."""
+
+    torch.cuda._sleep(1000)
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    torch.cuda._sleep(2_000_000)
+    b.record()
+    b.synchronize()
+    return 2_000_000 / max(1e-3, a.elapsed_time(b) * 1e3)
+
+
+def _graph(torch, body, warm: int = 2):
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        for _ in range(warm):
+            body()
+    torch.cuda.current_stream().wait_stream(s)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        body()
+    return g
+
+
+def main(argv: list | None = None) -> int:
+    ap = argparse.ArgumentParser(description="G14 RoCE exchange micro-benchmark (two nodes)")
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--master", required=True, help="rank 0's address on the link")
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--sizes", default="10k,20k,40k,80k")
+    ap.add_argument("--ops", type=int, default=81)
+    ap.add_argument("--reps", type=int, default=60, help="timed graph replays a size")
+    ap.add_argument("--eager", type=int, default=300)
+    ap.add_argument("--work-us", type=float, default=0.0)
+    ap.add_argument("--trace", type=int, default=0, help="sets GLM53_TF_ROCE_TRACE (a power of two, e.g. 8192)")
+    ap.add_argument("--out", default="")
+    a = ap.parse_args(argv)
+    if a.trace:
+        os.environ["GLM53_TF_ROCE_TRACE"] = str(a.trace)
+    os.environ.setdefault("GLM53_TF_COMM_BACKEND", "roce")
+
+    import torch
+
+    from tensorfold.cuda.comm import NCCL
+
+    from . import roce, roce_split
+
+    torch.cuda.set_device(0)
+    base = NCCL(a.rank, 2, a.master, a.port)
+    base.barrier()
+    comm = roce.select(base)
+    rt = getattr(comm, "rt", None)
+    s = roce.settings()
+    knobs = {k: v for k, v in sorted(os.environ.items()) if k.startswith("GLM53_TF_ROCE_")}
+    result = {"rank": a.rank, "knobs": knobs, "settings": s.__dict__, "ops": a.ops, "work_us": a.work_us,
+              "transport": "roce" if rt is not None else "nccl", "sizes": {}}
+    if rt is None:
+        print("[G14] micro: RoCE setup fell back to NCCL (see the roce: lines above)", file=sys.stderr, flush=True)
+        if a.out:
+            json.dump(result, open(a.out, "w"), indent=1)
+        return 1
+    cyc = _sleep_cycles_per_us(torch) if a.work_us > 0 else 0.0
+    work = int(a.work_us * cyc)
+    bad_total = 0
+    for n in [_size(t) for t in a.sizes.split(",") if t.strip()]:
+        n = max(4, n // 4 * 4)
+        e = n // 4                                          # int32 elements a rank
+        if n > s.max_bytes:
+            result["sizes"][n] = {"skipped": f"above GLM53_TF_ROCE_MAX_KB ({s.max_bytes // 1024} KiB)"}
+            continue
+        row = {}
+        # bits: RoCE == NCCL, aligned and at an odd byte offset
+        ok = True
+        for off in (0, 1):
+            src = torch.empty((n + off,), dtype=torch.uint8, device="cuda")
+            src[off:] = roce.pattern(a.rank, n, 3 + off)
+            got = torch.empty((2 * n,), dtype=torch.uint8, device="cuda")
+            ref = torch.empty_like(got)
+            comm.all_gather_fast(src[off:], got)
+            base.all_gather(src[off:], ref)
+            torch.cuda.synchronize()
+            rt.check()
+            ok = ok and bool(torch.equal(got, ref))
+        row["equal_nccl"] = ok
+        # eager
+        x = roce.pattern(a.rank, n, 9)
+        y = torch.empty((2 * n,), dtype=torch.uint8, device="cuda")
+        for _ in range(16):
+            comm.all_gather_fast(x, y)
+        torch.cuda.synchronize()
+        t = time.perf_counter()
+        for _ in range(a.eager):
+            comm.all_gather_fast(x, y)
+        torch.cuda.synchronize()
+        row["eager_us"] = round((time.perf_counter() - t) / a.eager * 1e6, 2)
+        # graph, pure: ``--ops`` exchanges (and the work) only: the latency an op the variants are compared on
+        def pure():
+            for _ in range(a.ops):
+                comm.all_gather_fast(x, y)
+                if work:
+                    torch.cuda._sleep(work)
+
+        gp = _graph(torch, pure)
+        for _ in range(3):
+            gp.replay()
+        torch.cuda.synchronize()
+        done0 = int(rt.ctrl[roce.CTRL_COMPLETED])
+        t = time.perf_counter()
+        for _ in range(a.reps):
+            gp.replay()
+        torch.cuda.synchronize()
+        dt = time.perf_counter() - t
+        rt.check()
+        row["graph_us"] = round(dt / (a.reps * a.ops) * 1e6 - a.work_us, 2)
+        del gp
+        # trace: both ranks' rows of these timed replays (at most the ring; before more ops overwrite it) -> rank 0
+        # splits them (roce_split: staging / wire / skew an op)
+        if rt.s.trace:
+            done = int(rt.ctrl[roce.CTRL_COMPLETED])
+            first = max(done0 + 1, done - rt.s.trace + 1)
+            rows = rt.trace_rows(range(first, done + 1))
+            both = roce.exchange(base, [[r["seq"], r["start"], r["bell"], r["flag"], r["end"]] for r in rows])
+            rr = [[{"seq": q, "start": t0, "bell": b, "flag": f, "end": e2} for q, t0, b, f, e2 in x] for x in both]
+            row["split"] = roce_split.split(roce_split.pair(rr[0], rr[1]), ops=a.ops)
+            row["trace_rank"] = roce.trace_summary(rr[a.rank], rr[1 - a.rank])
+        # graph, checked: payload = base + counter, every op checked against the peer's base + counter
+        mine = roce.pattern(a.rank, n, 11).view(torch.int32).clone()
+        peer = roce.pattern(1 - a.rank, n, 11).view(torch.int32).clone()
+        cnt = torch.zeros((1,), dtype=torch.int32, device="cuda")
+        send = torch.empty((e,), dtype=torch.int32, device="cuda")
+        recv = torch.empty((2 * e,), dtype=torch.int32, device="cuda")
+        bad = torch.zeros((1,), dtype=torch.int64, device="cuda")
+        lo, hi = (e, 2 * e) if a.rank == 0 else (0, e)
+
+        def body():
+            for _ in range(a.ops):
+                cnt.add_(1)
+                torch.add(mine, cnt, out=send)
+                comm.all_gather_fast(send, recv)
+                bad.add_((recv[lo:hi] != peer + cnt).sum())
+                if work:
+                    torch.cuda._sleep(work)
+
+        g = _graph(torch, body)
+        bad.zero_()
+        cnt.zero_()                                     # both ranks: the same counter sequence from here
+        torch.cuda.synchronize()
+        base.barrier()
+        for _ in range(a.reps):
+            g.replay()
+        torch.cuda.synchronize()
+        rt.check()
+        row["checked_ops"] = a.reps * a.ops
+        row["mismatches"] = int(bad.item())
+        bad_total += row["mismatches"] + (0 if ok else 1)
+        del g
+        result["sizes"][n] = row
+        if a.rank == 0:
+            sp = row.get("split", {}).get("per_op_us", {})
+            print(f"[G14] micro {n} B: equal_nccl {ok}, eager {row['eager_us']} us, graph {row['graph_us']} us an op "
+                  f"({a.ops} ops, work {a.work_us:g} us taken off), mismatches {row['mismatches']} of "
+                  f"{row['checked_ops']} checked ops"
+                  + (f"; staging {sp.get('staging')} wire {sp.get('wire')} skew {sp.get('skew')} us an op" if sp else ""),
+                  flush=True)
+    result["stats"] = rt.snapshot()
+    if a.out and a.rank == 0:
+        json.dump(result, open(a.out, "w"), indent=1, default=str)
+    base.barrier()
+    return 1 if bad_total else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tensorfold/families/glm5_next/spark/roce_common.h b/src/tensorfold/families/glm5_next/spark/roce_common.h
new file mode 100644
index 0000000..f5a4ecb
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce_common.h
@@ -0,0 +1,72 @@
+// Shared by roce.cpp (host proxy, bindings) and roce.cu (kernel): the control record and the kernel arguments.
+// patches/0230; the protocol is adapted from b12x's RoCEnante (Apache-2.0, see roce.cu).
+#pragma once
+
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace tfroce {
+
+// 32-bit words of the control record (one FLAG_STRIDE block at the end of the pinned region). The kernel writes all
+// of them but CTRL_SEQ's reader (the proxy); the host reads them without touching the device.
+enum : int {
+    CTRL_SEQ = 0,          // doorbell: the newest sequence staged (proxy polls it)
+    CTRL_NBYTES = 1,       // padded bytes of the newest op
+    CTRL_ERR_SEQ = 2,      // sequence whose wait timed out
+    CTRL_ERR_PEER = 3,     // the peer it waited for
+    CTRL_SLOT_NBYTES = 4,  // [4], [5]: padded bytes per slot (the proxy's catch-up after a missed doorbell)
+    CTRL_ERR_HCA = 6,      // the HCA whose flag never came
+    CTRL_FAILED = 7,       // 1 once any wait timed out (wrap-safe, unlike a sequence number)
+    CTRL_COMPLETED = 8,    // the last sequence completed on this rank (doorbell ahead of it: an op is in flight)
+    CTRL_ERR_SEEN = 9,     // patches/0350: the failed wait's last read of the flag (what the GPU observed)
+    CTRL_WORDS = 10,
+};
+
+struct GatherArgs {
+    const uint8_t *in;
+    uint8_t *out;
+    uint64_t nbytes;       // bytes of one rank's shard
+    uint64_t recv_base;    // device addresses of the pinned region's parts
+    uint64_t flag_base;
+    uint64_t send_base;
+    uint64_t ctrl_base;
+    uint64_t slot_bytes;
+    uint32_t *epoch;       // device counters: epoch, this grid size's stage / tail arrivals, poison
+    uint32_t *stage_ctr;
+    uint32_t *tail_ctr;
+    uint32_t *poison;
+    uint64_t timeout_ns;
+    int world;
+    int rank;
+    int n_hca;
+    int flag_stride;
+    int slots;
+    // patches/0460 (all 0: 0230 / 0350's behaviour)
+    uint32_t stripe_min;   // padded shards below this many bytes travel on ONE HCA (seq % n_hca), else striped
+    uint32_t lean;         // 1: release / acquire ordering instead of the sequentially consistent fences (same order)
+    uint64_t *trace;       // optional ring of 4 x u64 per op (globaltimer ns): start, doorbell, flags seen, end
+    uint32_t trace_mask;   // ring entries - 1 (a power of two minus one)
+    // G14 (GLM53_TF_ROCE_FAST / _POLLERS; 0 / 1: the kernels above, unchanged). The same wire protocol (slots, flags,
+    // doorbell, byte counts): only the kernel's own critical path changes, so the knob is local to a rank.
+    uint32_t fast;         // 1: gather_fast_kernel (roce.cu): one prologue read, lean order, local shard copied
+                           // while waiting, a block's own wait gates its copy, no system-scope read in the tail
+    uint32_t pollers;      // fast only: 1..MAX_POLLERS threads poll each (peer, HCA) flag, start-staggered
+    uint32_t stagger_ns;   // fast only: the stagger between two pollers' first loads
+    uint32_t trace_host;   // G14: the trace ring is pinned host memory (rocedump's thread reads it without a CUDA
+                           // call): the flags-seen stamp is a plain store after the wait, not a 64-bit atomicMax
+};
+
+constexpr int MAX_POLLERS = 8;
+constexpr int MAX_WAITERS = 32;   // world x HCAs (roce.cpp: MAX_PEERS 16 x MAX_HCAS 2): a poller's lane in its warp
+
+// patches/0460: the HCAs an op of ``padded`` bytes uses -- ALL when striped, else only ``single_hca``. The kernel
+// (which flags to wait for), the proxy (which queue pairs to post on) and the test loop evaluate the same function of
+// (padded bytes, seq), so both ranks agree without exchanging anything.
+__host__ __device__ inline bool one_hca(uint32_t padded, uint32_t stripe_min, int n_hca) {
+    return stripe_min != 0u && padded < stripe_min && n_hca > 1;
+}
+__host__ __device__ inline int single_hca(uint32_t seq, int n_hca) { return static_cast<int>(seq % uint32_t(n_hca)); }
+
+cudaError_t launch_gather(const GatherArgs &args, int grid, int threads, cudaStream_t stream);
+
+}  // namespace tfroce
diff --git a/src/tensorfold/families/glm5_next/spark/roce_msg.h b/src/tensorfold/families/glm5_next/spark/roce_msg.h
new file mode 100644
index 0000000..cc09fd2
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce_msg.h
@@ -0,0 +1,221 @@
+// G14: a host-to-host mailbox on the RoCE runtime's pinned region (DeepSeek-V4.1's round plan, TF_DSV41_PLAN_LINK=rdma).
+//
+// Why. Rank 1 starts every serving window late (G14a: its first exchange doorbell ~84-105 us after rank 0's, mean):
+// the plan travels over TCP (planlink.TcpLink), i.e. two kernel network stacks and a scheduler wake-up of rank 1's
+// thread blocked in recv. Here the plan is an RDMA write + a sequence flag on the same reliable-connected queue pair the
+// exchanges use (one-way ~5 us), and rank 1's host spins on the flag in pinned memory (then naps once idle).
+//
+// Protocol (ONE sender rank, every other rank receives; the plan link is rank 0 -> rank 1):
+//   region parts (msg_layout, after the control record): send[MSG_SLOTS] (this rank's outgoing chunks),
+//   recv[src][MSG_SLOTS] (NIC-written), flag[src][MSG_SLOTS] (the chunk's sequence, written after it on the same QP),
+//   ack[src] (the receiver's consumed count, written by the receiver's proxy).
+//   send: a message is cut into chunks of <= MSG_SLOT_BYTES - MSG_HDR bytes; chunk m (m = 1, 2, ...) goes to slot
+//     m % MSG_SLOTS once every receiver acked >= m - MSG_SLOTS (credit: the slot is free on every receiver); header
+//     {bytes, last, total}; then ctrl[CTRL_MSG_SEQ] = m (release). The proxy thread posts every new m (data + flag).
+//   recv: wait flag[src][m % MSG_SLOTS] == m (acquire), copy the chunk out, ctrl[CTRL_MSG_ACK] = m (release): the proxy
+//     posts it to the sender's ack[me]. Chunks until ``last``.
+// No CUDA, torch or verbs here: tests/test_roce_g14_msg.py compiles it with a plain C++ compiler and plays the proxy.
+
+#pragma once
+
+#include <poll.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace tfroce {
+
+constexpr int MSG_SLOTS = 8;
+constexpr uint64_t MSG_SLOT_BYTES = 64 * 1024;
+constexpr uint64_t MSG_HDR = 16;
+constexpr uint64_t MSG_STRIDE = 64;           // a flag / ack word each on its own 64-byte line
+constexpr int MSG_MAX_PEERS = 16;
+enum : int { CTRL_MSG_SEQ = 10, CTRL_MSG_ACK = 11 };   // ctrl words after 0230 / 0350 / 0460's ten
+
+struct MsgHeader {
+    uint32_t bytes;     // payload bytes of this chunk (after the header)
+    uint32_t last;      // 1: the message's last chunk
+    uint32_t total;     // the whole message's bytes (low 32 bits; a check)
+    uint32_t pad;
+};
+
+struct MsgLayout {
+    uint64_t send_off, recv_off, flag_off, ack_off, end;
+};
+
+// the mailbox's parts from ``base`` (rounded up to 4 KiB) for ``world`` ranks
+inline MsgLayout msg_layout(uint64_t base, int world) {
+    MsgLayout L;
+    L.send_off = (base + 4095) / 4096 * 4096;
+    L.recv_off = L.send_off + MSG_SLOTS * MSG_SLOT_BYTES;
+    L.flag_off = L.recv_off + uint64_t(world) * MSG_SLOTS * MSG_SLOT_BYTES;
+    L.ack_off = L.flag_off + uint64_t(world) * MSG_SLOTS * MSG_STRIDE;
+    L.end = L.ack_off + uint64_t(world) * MSG_STRIDE;
+    return L;
+}
+
+inline uint64_t msg_now_ns() {
+    timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return uint64_t(t.tv_sec) * 1000000000ull + uint64_t(t.tv_nsec);
+}
+
+inline void msg_relax() {
+#if defined(__aarch64__)
+    asm volatile("yield" ::: "memory");
+#elif defined(__x86_64__)
+    asm volatile("pause" ::: "memory");
+#endif
+}
+
+class MsgHost {
+  public:
+    MsgHost(uint8_t *region, uint64_t ctrl_off, uint64_t msg_base, int world, int rank)
+        : region_(region), ctrl_off_(ctrl_off), L_(msg_layout(msg_base, world)), world_(world), rank_(rank) {
+        if (world < 2 || world > MSG_MAX_PEERS || rank < 0 || rank >= world) {
+            throw std::invalid_argument("roce mailbox: bad geometry");
+        }
+        sent_ = load(ctrl() + CTRL_MSG_SEQ);          // a runtime that sent before continues its sequence
+        for (int s = 0; s < MSG_MAX_PEERS; s++) {
+            got_[s] = 0;
+        }
+        got_any_ = load(ctrl() + CTRL_MSG_ACK);
+    }
+
+    const MsgLayout &layout() const { return L_; }
+
+    // the whole message, chunked; false on a credit timeout (a receiver that stopped consuming)
+    bool send(const uint8_t *data, uint64_t n, double timeout_s) {
+        const uint64_t room = MSG_SLOT_BYTES - MSG_HDR;
+        uint64_t off = 0;
+        do {
+            const uint64_t take = n - off < room ? n - off : room;
+            const uint32_t m = sent_ + 1;
+            const uint64_t t0 = msg_now_ns();
+            while (!credit(m)) {
+                if (timeout_s > 0 && double(msg_now_ns() - t0) * 1e-9 > timeout_s) {
+                    return false;
+                }
+                msg_relax();
+            }
+            uint8_t *slot = region_ + L_.send_off + uint64_t(m % MSG_SLOTS) * MSG_SLOT_BYTES;
+            MsgHeader h{uint32_t(take), off + take == n ? 1u : 0u, uint32_t(n), 0u};
+            memcpy(slot, &h, sizeof(h));
+            if (take) {
+                memcpy(slot + MSG_HDR, data + off, take);
+            }
+            __atomic_store_n(ctrl() + CTRL_MSG_SEQ, m, __ATOMIC_RELEASE);
+            sent_ = m;
+            off += take;
+        } while (off < n);
+        return true;
+    }
+
+    // the next message from ``src``: spin ``spin_ns`` after each chunk's wait starts, then nap ``nap_ns`` at a time;
+    // ``fd`` >= 0: a stream socket to the sender, polled while napping (closed -> throw); ``timeout_s`` > 0: throw after it
+    std::vector<uint8_t> recv(int src, uint64_t spin_ns, uint64_t nap_ns, int fd, double timeout_s) {
+        if (src < 0 || src >= world_ || src == rank_) {
+            throw std::invalid_argument("roce mailbox: bad source rank");
+        }
+        std::vector<uint8_t> out;
+        while (true) {
+            const uint32_t m = got_any_ + 1;
+            wait(src, m, spin_ns, nap_ns, fd, timeout_s);
+            const uint8_t *slot = region_ + L_.recv_off + (uint64_t(src) * MSG_SLOTS + m % MSG_SLOTS) * MSG_SLOT_BYTES;
+            MsgHeader h;
+            memcpy(&h, slot, sizeof(h));
+            if (h.bytes > MSG_SLOT_BYTES - MSG_HDR) {
+                throw std::runtime_error("roce mailbox: a chunk header of " + std::to_string(h.bytes) + " bytes");
+            }
+            out.insert(out.end(), slot + MSG_HDR, slot + MSG_HDR + h.bytes);
+            got_any_ = m;
+            got_[src] = m;
+            __atomic_store_n(ctrl() + CTRL_MSG_ACK, m, __ATOMIC_RELEASE);    // the proxy acks it to the sender
+            if (h.last) {
+                if (uint32_t(out.size()) != h.total) {
+                    throw std::runtime_error("roce mailbox: message of " + std::to_string(out.size()) +
+                                             " bytes, header says " + std::to_string(h.total));
+                }
+                return out;
+            }
+        }
+    }
+
+    uint32_t sent() const { return sent_; }
+    uint32_t received() const { return got_any_; }
+
+    // the address of flag[src][slot] / recv[src][slot] / ack[r] (the proxy's and the test peer's view)
+    uint64_t flag_off(int src, int slot) const { return L_.flag_off + (uint64_t(src) * MSG_SLOTS + slot) * MSG_STRIDE; }
+    uint64_t recv_off(int src, int slot) const {
+        return L_.recv_off + (uint64_t(src) * MSG_SLOTS + slot) * MSG_SLOT_BYTES;
+    }
+    uint64_t ack_off(int r) const { return L_.ack_off + uint64_t(r) * MSG_STRIDE; }
+
+  private:
+    uint32_t *ctrl() const { return reinterpret_cast<uint32_t *>(region_ + ctrl_off_); }
+
+    static uint32_t load(const uint32_t *p) { return __atomic_load_n(p, __ATOMIC_ACQUIRE); }
+
+    bool credit(uint32_t m) const {
+        if (m <= uint32_t(MSG_SLOTS)) {
+            return true;
+        }
+        for (int r = 0; r < world_; r++) {
+            if (r == rank_) {
+                continue;
+            }
+            const uint32_t a = load(reinterpret_cast<const uint32_t *>(region_ + ack_off(r)));
+            if (int32_t(a - (m - MSG_SLOTS)) < 0) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void wait(int src, uint32_t m, uint64_t spin_ns, uint64_t nap_ns, int fd, double timeout_s) {
+        const uint32_t *flag = reinterpret_cast<const uint32_t *>(region_ + flag_off(src, int(m % MSG_SLOTS)));
+        const uint64_t t0 = msg_now_ns();
+        uint32_t polls = 0;
+        while (load(flag) != m) {
+            if ((++polls & 255u) != 0u) {
+                msg_relax();
+                continue;
+            }
+            const uint64_t t = msg_now_ns();
+            if (timeout_s > 0 && double(t - t0) * 1e-9 > timeout_s) {
+                throw std::runtime_error("roce mailbox: no message from rank " + std::to_string(src) + " in " +
+                                         std::to_string(timeout_s) + " s");
+            }
+            if (t - t0 < spin_ns) {
+                continue;
+            }
+            if (fd >= 0) {                              // napping: is the sender still there?
+                pollfd p{fd, POLLIN, 0};
+                if (::poll(&p, 1, 0) > 0) {
+                    char c;
+                    const ssize_t k = ::recv(fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+                    if (k == 0 || (p.revents & (POLLHUP | POLLERR))) {
+                        throw std::runtime_error("plan link: rank " + std::to_string(src) + " closed the connection");
+                    }
+                }
+            }
+            const timespec nap = {0, long(nap_ns)};
+            nanosleep(&nap, nullptr);
+        }
+    }
+
+    uint8_t *region_;
+    uint64_t ctrl_off_;
+    MsgLayout L_;
+    int world_, rank_;
+    uint32_t sent_ = 0;
+    uint32_t got_any_ = 0;
+    uint32_t got_[MSG_MAX_PEERS];
+};
+
+}  // namespace tfroce
diff --git a/src/tensorfold/families/glm5_next/spark/roce_split.py b/src/tensorfold/families/glm5_next/spark/roce_split.py
new file mode 100644
index 0000000..47835b3
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce_split.py
@@ -0,0 +1,219 @@
+"""G14: where one RoCE exchange's time goes, from both ranks' per-op trace rows (``roce.Runtime.trace_rows``, a
+``rocedump`` line's ``rows_of``, or ``roce_bench --trace``). Pure Python: no torch, no numpy, no CUDA, so the window
+scripts can run it on the host.
+
+The model (one op, two ranks; kernel clocks are compared only within a rank)
+------------------------------------------------------------------------------
+Per rank r the kernel stamps start / doorbell / flags seen / end, so ``stage_r`` = doorbell - start (prologue,
+staging copy, ordering), ``wait_r`` = flags seen - doorbell, ``copy_r`` = end - flags seen (copy-out, tail). Let ``s``
+be how much later rank 1 rang than rank 0 (true time, unknown) and ``T`` the one-way transport: a doorbell to the
+peer's GPU seeing the flag (proxy notice + posts + NIC read + wire + NIC write + the GPU's poll). Then
+
+    wait_0 = max(e, s + T),    wait_1 = max(e, T - s)          (e: a wait whose flag is already there, one poll)
+
+so while |s| <= T both ranks wait and ``(wait_0 + wait_1) / 2 = T`` exactly, whatever s is; once |s| > T the late
+rank waits ~e and the mean is ``(|s| + T + e) / 2``. Two consequences:
+
+- The exchange's critical path is ``stage + T + copy`` per op, NOT the late rank's kernel time (``stage + e +
+  copy``, the "p10 7.5 us" floor of REWRITE-PLAN 1.1): even with perfectly equal compute the ranks alternate (the rank
+  that waited leaves T later, so it rings T later next time), one waiting ~2 T and the other ~e. The transport T is
+  therefore part of the measured "wait", and it is a comm cost, not skew.
+- ``excess = mean_wait - T`` (>= 0) is the part of the wait that rank skew beyond the transport adds. That is the
+  load-balance share: no transport change removes it.
+
+``split`` estimates T (``t_source``) from the ops where both ranks waited (the smaller wait clearly above the poll
+floor: there the mean is exactly T); else, if the ranks wait alike, the median mean wait ("symmetric"); else
+``t_us`` if given (the micro-benchmark's T at the same size, ``roce_bench``); else, while the later rank changes
+sides, a low percentile of the mean ("alternating": with |s| ~ T flipping sides the mean is still T). When ONE rank is
+late almost every time (``one_sided``) the waits alone cannot separate T from the skew: without ``t_us`` the low
+percentile is only an upper bound on T (the skew is understated) and the verdict says so. It splits an average rank's exchange time into ``staging`` (stage + copy), ``wire`` (T) and ``skew`` (the
+excess), per op and for ``ops`` ops a window, plus each rank's own mean wait. ``verdict`` names the larger share.
+"""
+
+from __future__ import annotations
+
+import json
+
+
+def _pct(v: list, q: float) -> float:
+    if not v:
+        return 0.0
+    v = sorted(v)
+    return float(v[min(len(v) - 1, max(0, int(q * (len(v) - 1) + 0.5)))])
+
+
+def _mean(v: list) -> float:
+    return sum(v) / len(v) if v else 0.0
+
+
+def components(row: dict) -> dict | None:
+    """A trace row (ns stamps) -> {seq, stage, wait, copy, total} in us; None for an incomplete or torn row."""
+
+    t0, bell, flag, end = (int(row.get(k) or 0) for k in ("start", "bell", "flag", "end"))
+    if not (t0 and bell and flag and end) or not (t0 <= bell <= flag <= end) or end - t0 > 50_000_000:
+        return None
+    return {"seq": int(row["seq"]), "stage": (bell - t0) / 1e3, "wait": (flag - bell) / 1e3,
+            "copy": (end - flag) / 1e3, "total": (end - t0) / 1e3}
+
+
+def pair(rows0: list, rows1: list) -> list[dict]:
+    """Both ranks' rows -> per seq both ranks' components (seqs present and sane on both)."""
+
+    a = {c["seq"]: c for c in (components(r) for r in rows0) if c}
+    b = {c["seq"]: c for c in (components(r) for r in rows1) if c}
+    return [{"seq": q, "r0": a[q], "r1": b[q]} for q in sorted(set(a) & set(b))]
+
+
+def split(pairs: list[dict], ops: int = 81, floor_us: float | None = None, t_us: float | None = None) -> dict:
+    """Staging / wire / skew per op (us) and per window of ``ops`` exchanges (ms), from ``pair``'s output.
+
+    ``floor_us``: a wait that found its flag already there (default: the 10th percentile of the smaller wait, at least
+    0.3 us). T comes from the ops whose smaller wait exceeds max(1 us, 2 x floor) when they are >= 10% of the ops,
+    else ``t_us`` when given (``t_source`` "given"), else the 20th percentile of the mean wait (``t_source``
+    "upper bound")."""
+
+    n = len(pairs)
+    if n == 0:
+        return {"n": 0}
+    w0 = [p["r0"]["wait"] for p in pairs]
+    w1 = [p["r1"]["wait"] for p in pairs]
+    lo = [min(a, b) for a, b in zip(w0, w1)]
+    mean = [(a + b) / 2 for a, b in zip(w0, w1)]
+    floor = min(max(0.3, _pct(lo, 0.05)), 1.5) if floor_us is None else float(floor_us)
+    both = [m for m, x in zip(mean, lo) if x > floor + 0.5]           # the late rank waited too: mean == T
+    uneven = [(a, b) for a, b in zip(w0, w1) if abs(a - b) > 0.2]
+    frac1 = sum(1 for a, b in uneven if a > b) / len(uneven) if uneven else 0.5   # rank 1 rang later
+    one_sided = len(uneven) >= n // 2 and (frac1 >= 0.8 or frac1 <= 0.2) and \
+        sum(1 for x in lo if x <= floor + 0.5) >= 0.8 * n
+    if len(both) >= max(3, n // 10):
+        T, source = _pct(both, 0.5), "both waited"
+    elif len(uneven) < max(3, n // 10):
+        T, source = _pct(mean, 0.5), "symmetric"                       # the ranks wait alike: mean == T
+    elif t_us is not None:
+        T, source = float(t_us), "given"
+    elif not one_sided:
+        T, source = _pct(mean, 0.2), "alternating"                     # |s| ~ T flipping sides: mean == T
+    else:
+        T, source = _pct(mean, 0.2), "upper bound"
+    exact = source in ("both waited", "symmetric", "alternating")
+    stage = [(p["r0"]["stage"] + p["r1"]["stage"]) / 2 for p in pairs]
+    copy = [(p["r0"]["copy"] + p["r1"]["copy"]) / 2 for p in pairs]
+    excess = [max(0.0, m - T) for m in mean]
+    total = [(p["r0"]["total"] + p["r1"]["total"]) / 2 for p in pairs]
+    big = [(a, b) for a, b in zip(w0, w1) if abs(a - b) / 2 > T]
+    big_late1 = sum(1 for a, b in big if a > b)
+    staging = _mean(stage) + _mean(copy)
+    skew = _mean(excess)
+    out = {
+        "n": n, "floor_us": round(floor, 2), "t_exact": exact, "t_source": source, "t_ops": len(both),
+        "one_sided": one_sided,
+        "rank_mean_wait_us": [round(_mean(w0), 2), round(_mean(w1), 2)],
+        "per_op_us": {"stage": round(_mean(stage), 2), "copy": round(_mean(copy), 2), "staging": round(staging, 2),
+                      "wire": round(T, 2), "skew": round(skew, 2), "total": round(_mean(total), 2),
+                      "late_rank_kernel_p50": round(_pct([p["r0"]["stage"] + l + p["r0"]["copy"] if w0[i] <= w1[i]
+                                                          else p["r1"]["stage"] + l + p["r1"]["copy"]
+                                                          for i, (p, l) in enumerate(zip(pairs, lo))], 0.5), 2)},
+        "p50_us": {"stage": round(_pct(stage, 0.5), 2), "copy": round(_pct(copy, 0.5), 2),
+                   "wait_r0": round(_pct(w0, 0.5), 2), "wait_r1": round(_pct(w1, 0.5), 2),
+                   "mean_wait": round(_pct(mean, 0.5), 2), "excess": round(_pct(excess, 0.5), 2)},
+        "p90_us": {"mean_wait": round(_pct(mean, 0.9), 2), "excess": round(_pct(excess, 0.9), 2)},
+        "rank1_later_frac": round(frac1, 3),
+        "big_skew_ops": len(big), "big_skew_rank1_later_frac": round(big_late1 / len(big), 3) if big else None,
+    }
+    out["window_ms"] = {k: round(v * ops / 1e3, 3) for k, v in (("staging", staging), ("wire", T), ("skew", skew),
+                                                                ("total", _mean(total)))}
+    out["verdict"] = verdict(out)
+    return out
+
+
+def verdict(s: dict) -> str:
+    """The larger of wire and skew above the late rank's own kernel time (the REWRITE-PLAN floor), in words."""
+
+    if not s.get("n"):
+        return "no paired ops"
+    po = s["per_op_us"]
+    wire, skew, staging = po["wire"], po["skew"], po["staging"]
+    above = wire + skew
+    who = ""
+    f = s.get("big_skew_rank1_later_frac")
+    if f is not None and s.get("big_skew_ops", 0) >= max(10, s["n"] // 20) and (f >= 0.7 or f <= 0.3):
+        who = f"; in {s['big_skew_ops']} ops with skew > T, rank {1 if f >= 0.7 else 0} rang later {max(f, 1 - f):.0%}"
+    src = s.get("t_source", "both waited" if s.get("t_exact") else "upper bound")
+    bound = {"both waited": "", "symmetric": "", "alternating": " (T from alternating ops)",
+             "given": " (T from the micro-benchmark: few ops where both ranks waited)",
+             "upper bound": " (T is an UPPER bound, so skew is understated: few ops where both ranks waited; pass "
+                            "the micro-benchmark's T)"}[src]
+    if above <= 0:
+        return "no wait above the late rank's kernel time"
+    if s.get("one_sided") and src == "upper bound":
+        late = 1 if s.get("rank1_later_frac", 0.5) >= 0.5 else 0
+        frac = max(s.get("rank1_later_frac", 0.5), 1 - s.get("rank1_later_frac", 0.5))
+        waits = s.get("rank_mean_wait_us", [0, 0])
+        return (f"ONE-SIDED SKEW: rank {late} rang later in {frac:.0%} of the ops and rank {1 - late} waits "
+                f"{waits[1 - late]:.1f} us an op; T cannot be separated from the skew here: give the micro-benchmark's "
+                f"T (t_us). If T is a few us, the rest is rank {late}'s work running long: load balance, not comm")
+    if skew >= 0.5 * above:
+        return (f"SKEW: {skew:.1f} of the {above:.1f} us an op above the late rank's kernel is rank skew beyond the "
+                f"transport (wire {wire:.1f}){bound}{who}. That share is load balance (which rank's work runs long, "
+                f"and where), not comm")
+    if staging > wire:
+        return (f"STAGING: the kernels' own stage + copy ({staging:.1f} us an op) exceed the wire ({wire:.1f}) and the "
+                f"skew ({skew:.1f}){bound}: the kernel-side fixed cost (GLM53_TF_ROCE_FAST) is the lever")
+    return (f"WIRE: the one-way transport ({wire:.1f} us an op: proxy notice, posts, NIC, poll) is the larger part "
+            f"above the floor (skew {skew:.1f}, staging {staging:.1f}){bound}: comm levers (proxy pinning, pollers, "
+            f"a GPU-initiated post)")
+
+
+def load_rows(path: str) -> list[dict]:
+    """Rows from a JSON list of rows, a ``{"rows": [...]}`` object, or JSONL (rocedump lines: ``rows`` or G14's
+    base64 ``stamps``); later lines win per seq."""
+
+    text = open(path).read().strip()
+    if not text:
+        return []
+    try:
+        items = [json.loads(text)]
+    except ValueError:                                  # JSONL
+        items = [json.loads(x) for x in text.splitlines() if x.strip()]
+    by = {}
+    for it in items:
+        if isinstance(it, list):
+            rows = it
+        elif "stamps" in it:
+            rows = _rows_of_stamps(it)
+        else:
+            rows = it.get("rows", [])
+        for r in rows:
+            by[int(r["seq"])] = r
+    return [by[q] for q in sorted(by)]
+
+
+def _rows_of_stamps(line: dict) -> list[dict]:
+    import base64
+    import struct
+
+    raw = base64.b64decode(line["stamps"])
+    vals = struct.unpack(f"<{len(raw) // 8}q", raw)
+    return [{"seq": int(line["first"]) + i, "start": vals[4 * i], "bell": vals[4 * i + 1], "flag": vals[4 * i + 2],
+             "end": vals[4 * i + 3]} for i in range(len(vals) // 4)]
+
+
+def main(argv: list | None = None) -> int:
+    import argparse
+
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("rank0")
+    ap.add_argument("rank1")
+    ap.add_argument("--ops", type=int, default=81, help="exchanges a window (DeepSeek-V4.1 1-row: 81)")
+    ap.add_argument("--t-us", type=float, default=None, help="the transport T (us) from roce_bench at this size")
+    ap.add_argument("--json")
+    a = ap.parse_args(argv)
+    s = split(pair(load_rows(a.rank0), load_rows(a.rank1)), ops=a.ops, t_us=a.t_us)
+    print(json.dumps(s, indent=1))
+    if a.json:
+        json.dump(s, open(a.json, "w"), indent=1)
+    return 0 if s.get("n") else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/src/tensorfold/families/glm5_next/spark/roce_watch.h b/src/tensorfold/families/glm5_next/spark/roce_watch.h
new file mode 100644
index 0000000..d02f497
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/roce_watch.h
@@ -0,0 +1,91 @@
+// The host's view of a failed RoCE wait, taken within microseconds of the failure (patches/0350).
+//
+// patches/0230's diagnosis read the peer's flag word from host memory when ``Runtime.check`` ran, long after the
+// kernel gave up, and called "flag in host memory" the GPU-visibility failure of sparkring #278. A flag that arrives
+// AFTER the timeout (a peer that was late, or never launched until this rank gave up) reads the same then. The W2
+// single-node loopback failure was that case (see tests/test_roce_protocol_model.py).
+//
+// ``FailWatch::poll`` runs on the busy-spinning proxy thread (and on the tests' loop-back thread), once a loop
+// iteration: one acquire load of the failure word, which shares the doorbell's cache line. When the word turns 1 it
+// records, at once, the flag word the kernel waited for as host memory holds it and the kernel's last read of it
+// (``CTRL_ERR_SEEN``); then it keeps watching that word and records how long after the failure it arrived, if it does.
+// Then:
+//   host_at_fail == seq, gpu_seen != seq  -> the flag WAS in host memory while the GPU read a stale value:
+//                                            a real visibility problem (sparkring #278's signature)
+//   host_at_fail != seq, arrives later    -> the peer was late (no visibility problem)
+//   host_at_fail != seq, never arrives    -> never sent
+// No CUDA, torch or verbs here: tests/test_roce_watch.py compiles it with a plain C++ compiler.
+#pragma once
+
+#include <stdint.h>
+#include <time.h>
+
+#include <atomic>
+
+namespace tfroce {
+
+// 32-bit words of the control record that the watch reads (the full list: roce_common.h)
+enum : int {
+    WATCH_CTRL_ERR_SEQ = 2,
+    WATCH_CTRL_ERR_PEER = 3,
+    WATCH_CTRL_ERR_HCA = 6,
+    WATCH_CTRL_FAILED = 7,
+    WATCH_CTRL_ERR_SEEN = 9,
+};
+
+inline uint64_t watch_now_ns() {
+    timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return uint64_t(t.tv_sec) * 1000000000ull + uint64_t(t.tv_nsec);
+}
+
+struct FailWatch {
+    enum : uint32_t { IDLE = 0, NOTICED = 1, ARRIVED = 2 };
+
+    // written by the polling thread only, published by ``state`` (release); read by Python after state != IDLE
+    std::atomic<uint32_t> state{IDLE};
+    uint32_t seq = 0, peer = 0, hca = 0;
+    uint32_t host_at_fail = 0;       // the flag word in host memory when the failure word was first seen
+    uint32_t gpu_seen = 0;           // the kernel's last read of it
+    uint64_t noticed_ns = 0;         // CLOCK_MONOTONIC then
+    std::atomic<uint64_t> late_ns{0};  // ARRIVED: from noticing to the flag reading ``seq``
+    const volatile uint32_t *flag = nullptr;
+
+    // ``ctrl``: the control record; ``flag_at(peer, slot, hca)``: the flag word's host address
+    template <class FlagAt>
+    void poll(const volatile uint32_t *ctrl, FlagAt flag_at) {
+        const uint32_t s = state.load(std::memory_order_relaxed);
+        if (s == IDLE) {
+            if (__atomic_load_n(const_cast<const uint32_t *>(&ctrl[WATCH_CTRL_FAILED]), __ATOMIC_ACQUIRE) == 0u) {
+                return;
+            }
+            // the kernel wrote the error words, then a system fence, then the failure word: all visible now
+            seq = ctrl[WATCH_CTRL_ERR_SEQ];
+            peer = ctrl[WATCH_CTRL_ERR_PEER];
+            hca = ctrl[WATCH_CTRL_ERR_HCA];
+            gpu_seen = ctrl[WATCH_CTRL_ERR_SEEN];
+            flag = flag_at(peer, seq & 1u, hca);
+            host_at_fail = flag != nullptr ? *flag : 0u;
+            noticed_ns = watch_now_ns();
+            state.store(NOTICED, std::memory_order_release);
+            return;
+        }
+        if (s == NOTICED && flag != nullptr && host_at_fail != seq && *flag == seq) {
+            late_ns.store(watch_now_ns() - noticed_ns, std::memory_order_relaxed);
+            state.store(ARRIVED, std::memory_order_release);
+        }
+    }
+
+    // [state, seq, peer, hca, host_at_fail, gpu_seen, late_ns] (state 0: nothing noticed yet)
+    void read(uint64_t out[7]) const {
+        out[0] = state.load(std::memory_order_acquire);
+        out[1] = seq;
+        out[2] = peer;
+        out[3] = hca;
+        out[4] = host_at_fail;
+        out[5] = gpu_seen;
+        out[6] = late_ns.load(std::memory_order_relaxed);
+    }
+};
+
+}  // namespace tfroce
diff --git a/src/tensorfold/families/glm5_next/spark/rocedump.py b/src/tensorfold/families/glm5_next/spark/rocedump.py
new file mode 100644
index 0000000..0670122
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/rocedump.py
@@ -0,0 +1,164 @@
+"""patches/0530: the RoCE exchange trace (0460's ``GLM53_TF_ROCE_TRACE`` ring) dumped from a running server, so the
+per-exchange transport / skew split (``roce.trace_summary``) can be measured in production conditions without nsys
+(THEORY-2 idea 6). Off by default.
+
+- ``GLM53_TF_ROCE_TRACE_DUMP=<path prefix>`` (needs ``GLM53_TF_ROCE_TRACE=N``): each rank appends one JSON line to
+  ``<prefix>-r<rank>.jsonl`` whenever at least ``GLM53_TF_ROCE_TRACE_EVERY`` exchanges completed since its last dump
+  (default 16 x the ring): ``{"t", "rank", "completed", "rows": roce.Runtime.trace_rows()}``. Both ranks number the
+  exchanges alike, so a reader pairs the two ranks' rows by ``seq`` (results/THEORY2-SESSION/rocetrace.py).
+- Checked once a round (``cpupin.tick``, both ranks, between rounds); a dump reads the ring after the round's work
+  (one small device-to-host copy). Reads only: no exchange, no kernel changes.
+
+G14: ``GLM53_TF_ROCE_TRACE_DUMP_S=<seconds>`` (> 0) instead: engines whose round loop never calls ``tick``
+(DeepSeek-V4.1) get a daemon thread, started by ``roce.connect``, that dumps every that many seconds. The ring then
+lives in pinned host memory (``roce.Settings.trace_host``), so the thread makes NO CUDA call: a copy or a stream
+synchronize from a second thread would be a prohibited call while the engine captures a graph in global mode (and
+would invalidate the capture). Its lines carry the stamps as base64 int64 [n, 4] for seqs ``first .. completed - 1``
+(``completed`` itself may still be writing its end stamp), at most half a ring a dump (a lagging dump skips ops
+rather than read slots being overwritten): ``{"t", "rank", "completed", "first", "n", "ring", "stamps"}``.
+``rows_of`` decodes a line into ``Runtime.trace_rows``' dicts.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import os
+import sys
+import threading
+import time
+
+_S = {"on": None, "path": None, "every": 0, "last": 0, "errors": 0}
+
+
+def _setup() -> bool:
+    raw = os.environ.get("GLM53_TF_ROCE_TRACE_DUMP", "").strip()
+    _S["on"] = False
+    if not raw:
+        return False
+    from . import roce
+
+    rt = _runtime()
+    if rt is None or getattr(rt, "trace_buf", None) is None:
+        return False                            # NCCL, no trace ring, or G14's host ring (its thread dumps it)
+    ring = int(rt.s.trace)
+    every = int(os.environ.get("GLM53_TF_ROCE_TRACE_EVERY", "") or 16 * ring)
+    _S.update(on=True, path=f"{raw}-r{rt.rank}.jsonl", every=max(1, every), last=0)
+    print(f"[tensorfold] RoCE trace dump (patches/0530): every {_S['every']} exchanges -> {_S['path']} "
+          f"(ring {ring}, {roce.__name__})", file=sys.stderr, flush=True)
+    return True
+
+
+def _runtime():
+    from . import roce
+
+    comms = getattr(roce, "COMMS", None)
+    return comms[-1].rt if comms else None
+
+
+def tick() -> None:
+    """Once a round: a dump when due (cheap otherwise: one host read of the completed counter)."""
+
+    if _S["on"] is False:
+        return
+    if _S["on"] is None and not _setup():
+        if _runtime() is None:
+            _S["on"] = None                     # the communicator is made after the first ticks: look again
+        return
+    rt = _runtime()
+    try:
+        from .roce import CTRL_COMPLETED
+
+        done = int(rt.ctrl[CTRL_COMPLETED])
+        if done - _S["last"] < _S["every"]:
+            return
+        rows = rt.trace_rows()
+        with open(_S["path"], "a") as f:
+            f.write(json.dumps({"t": time.time(), "rank": rt.rank, "completed": done, "rows": rows}) + "\n")
+        _S["last"] = done
+    except Exception as exc:                    # noqa: BLE001 - a measurement must never stop serving
+        _S["errors"] += 1
+        if _S["errors"] <= 3:
+            print(f"[tensorfold] RoCE trace dump failed ({type(exc).__name__}: {exc})", file=sys.stderr, flush=True)
+        if _S["errors"] >= 3:
+            _S["on"] = False
+
+
+# -- G14: the dump thread ----------------------------------------------------------------------------------------------
+_THREADS: list = []
+
+
+def start_thread(rt) -> threading.Thread | None:
+    """``GLM53_TF_ROCE_TRACE_DUMP_S`` > 0 with ``_TRACE_DUMP`` and a host trace ring: a daemon thread appending one line
+    to ``<prefix>-r<rank>.jsonl`` every period while ops completed. None (nothing started) otherwise."""
+
+    from . import roce
+
+    period = roce._dump_period()
+    raw = os.environ.get("GLM53_TF_ROCE_TRACE_DUMP", "").strip()
+    if period <= 0 or not raw or getattr(rt, "trace_host", None) is None:
+        return None
+    _S["on"] = False                            # one writer: GLM's tick stays off
+    rt._trace_dumped = True                     # Runtime._free keeps the ring the thread reads
+    path = f"{raw}-r{rt.rank}.jsonl"
+    th = threading.Thread(target=_loop, args=(rt, path, period), name="tf-rocedump", daemon=True)
+    th.start()
+    _THREADS.append(th)
+    print(f"[tensorfold] RoCE trace dump thread (G14): every {period:g} s -> {path} (ring {rt.s.trace}, host)",
+          file=sys.stderr, flush=True)
+    return th
+
+
+def snapshot(rt, last: int) -> dict | None:
+    """One dump line's dict from ``rt``'s host ring: seqs after ``last`` up to ``completed - 1`` (at most half a ring);
+    None when no op completed since ``last``. Host memory reads only."""
+
+    import numpy as np
+
+    from .roce import CTRL_COMPLETED
+
+    host = getattr(rt, "trace_host", None)
+    if host is None:
+        return None
+    ring = int(rt.s.trace)
+    done = int(rt.ctrl[CTRL_COMPLETED])
+    hi = done - 1                                # ``done``'s end stamp may land after its completion word
+    lo = max(int(last) + 1, hi - ring // 2 + 1, 1)
+    if hi < lo:
+        return None
+    seqs = np.arange(lo, hi + 1, dtype=np.int64)
+    k = host.reshape(ring, 4)[seqs & (ring - 1)].astype("<i8")
+    return {"t": time.time(), "rank": int(rt.rank), "completed": done, "first": int(lo), "n": int(len(seqs)),
+            "ring": ring, "stamps": base64.b64encode(k.tobytes()).decode()}
+
+
+def rows_of(line: dict) -> list[dict]:
+    """A G14 dump line -> ``[{"seq", "start", "bell", "flag", "end"}]`` (``Runtime.trace_rows``' keys)."""
+
+    import numpy as np
+
+    k = np.frombuffer(base64.b64decode(line["stamps"]), dtype="<i8").reshape(-1, 4)
+    return [{"seq": int(line["first"]) + i, "start": int(a), "bell": int(b), "flag": int(c), "end": int(d)}
+            for i, (a, b, c, d) in enumerate(k.tolist())]
+
+
+def _loop(rt, path: str, period: float) -> None:
+    last, errors = 0, 0
+    while True:
+        time.sleep(period)
+        if getattr(rt, "trace_host", None) is None:  # closed (``Runtime._free`` drops the view)
+            return
+        try:
+            line = snapshot(rt, last)
+            if line is None:
+                continue
+            with open(path, "a") as f:
+                f.write(json.dumps(line) + "\n")
+            last = line["first"] + line["n"] - 1
+        except Exception as exc:                # noqa: BLE001 - a measurement must never stop serving
+            errors += 1
+            if errors <= 3:
+                print(f"[tensorfold] RoCE trace dump thread failed ({type(exc).__name__}: {exc})", file=sys.stderr,
+                      flush=True)
+            if errors >= 3:
+                return
diff --git a/src/tensorfold/families/glm5_next/spark/server.py b/src/tensorfold/families/glm5_next/spark/server.py
new file mode 100644
index 0000000..5928880
--- /dev/null
+++ b/src/tensorfold/families/glm5_next/spark/server.py
@@ -0,0 +1,1099 @@
+"""The Spark engine's OpenAI server: 0.3.4's CUDA server with its request rules (stop strings, reasoning fields,
+context errors, /metrics, /tokenize, images, structured output, tool fixes), served through ``CUDA_SERVE``.
+
+One request decodes at a time, as one exact stream: drafted output is byte-identical to serial decoding on the
+same engine. The chat template is the model's own ``chat_template.jinja``; Qwen tool calls are parsed from the
+reply; with thinking on, text before ``</think>`` streams as ``reasoning_content``.
+
+A family's CUDA engine (``cuda_engine`` in its package) provides:
+
+    eos                                              # token ids that end a reply
+    generate(prompt, max_tokens, sampling, on_tokens) -> dict
+                                                     # decode; on_tokens(new_ids) returns True to stop early
+    follow()                                         # two GPUs: rank 1 mirrors every request rank 0 serves
+
+``tensorfold serve MODEL`` builds the engine and serves it here (see ``tensorfold.cli``).
+"""
+from __future__ import annotations
+
+import json
+import math
+import os
+import re
+import threading
+import time
+import traceback
+import uuid
+from datetime import datetime
+from tensorfold.server.stacks import Rearming
+from pathlib import Path
+from typing import Any, Callable
+
+from tensorfold.server.cancellation import RequestCancelled, socket_cancellation     # patches/0600 (upstream 24afe5e)
+
+_THINK_END = "</think>"
+_CALL_OPEN, _CALL_CLOSE = "<tool_call>", "</tool_call>"
+_TOOL_CALL_BLOCK_RE = re.compile(r"<tool_call>\s*(.*?)\s*</tool_call>", re.IGNORECASE | re.DOTALL)
+_TOOL_FUNCTION_BLOCK_RE = re.compile(r"^\s*<function=([^>\s]+)>\s*(.*?)\s*</function>\s*$", re.IGNORECASE | re.DOTALL)
+_TOOL_PARAMETER_BLOCK_RE = re.compile(r"<parameter=([^>\s]+)>\n?(.*?)\n?</parameter>", re.IGNORECASE | re.DOTALL)
+# GLM-4.5 to 5.3: <tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value>...</tool_call>
+_GLM_ARG_RE = re.compile(r"<arg_key>\s*(.*?)\s*</arg_key>\s*<arg_value>(.*?)</arg_value>", re.DOTALL)
+
+
+# -- text helpers (same rules as the Mac lane server) ---------------------------------------
+
+def _partial_tag(text: str, tag: str) -> int:
+    for k in range(min(len(tag) - 1, len(text)), 0, -1):
+        if text.endswith(tag[:k]):
+            return k
+    return 0
+
+
+class StreamDecoder:
+    """The text of a growing token list, decoding only a short window each time tokens arrive.
+
+    Decoding the whole reply every round grows with its length. Each step decodes the tokens from
+    ``prefix`` on twice, with and without the newest ones, and appends the difference, the way vLLM
+    detokenizes: the shared window keeps a decoder's leading-space and byte-level rules the same on
+    both sides. A trailing partial multi-byte character waits for the next tokens.
+    """
+
+    def __init__(self, tok, skip: tuple[int, ...] = ()):
+        self.tok, self.skip = tok, frozenset(skip)
+        self.ids: list[int] = []
+        self.text = ""
+        self.prefix = 0             # window start
+        self.read = 0               # tokens already reflected in ``text``
+
+    def _decode(self, ids: list[int]) -> str:
+        return self.tok.decode(ids, skip_special_tokens=False)
+
+    def add(self, new: list[int]) -> str:
+        self.ids.extend(t for t in new if t not in self.skip)
+        before = self._decode(self.ids[self.prefix:self.read])
+        after = self._decode(self.ids[self.prefix:])
+        if len(after) > len(before) and not after.endswith("\ufffd"):
+            self.text += after[len(before):]
+            self.prefix, self.read = self.read, len(self.ids)
+        return self.text
+
+    def final(self) -> str:
+        """Everything, including a trailing partial character (as decoding it all at once gives)."""
+
+        before = self._decode(self.ids[self.prefix:self.read])
+        return self.text + self._decode(self.ids[self.prefix:])[len(before):]
+
+
+def split_thinking(text: str, *, finished: bool) -> tuple[str, str]:
+    end = text.find(_THINK_END)
+    if end < 0:
+        return text[: len(text) - (0 if finished else _partial_tag(text, _THINK_END))], ""
+    return text[:end], text[end + len(_THINK_END):].lstrip("\n")
+
+
+def hide_tool_calls(text: str, *, finished: bool) -> str:
+    out: list[str] = []
+    pos = 0
+    while True:
+        start = text.find(_CALL_OPEN, pos)
+        if start < 0:
+            tail = text[pos:]
+            out.append(tail[: len(tail) - (0 if finished else _partial_tag(tail, _CALL_OPEN))])
+            return "".join(out)
+        out.append(text[pos:start])
+        end = text.find(_CALL_CLOSE, start)
+        if end < 0:
+            return "".join(out)
+        pos = end + len(_CALL_CLOSE)
+
+
+def _visible_spans(text: str, *, finished: bool) -> tuple[str, list[tuple[int, int]]]:
+    """patches/0160: ``hide_tool_calls``'s text plus, for each kept piece, (its start in the result, its start in
+    ``text``), so a position in the visible text maps back to the raw text."""
+
+    out: list[str] = []
+    spans: list[tuple[int, int]] = []
+    pos = n = 0
+    while True:
+        start = text.find(_CALL_OPEN, pos)
+        if start < 0:
+            tail = text[pos:]
+            tail = tail[: len(tail) - (0 if finished else _partial_tag(tail, _CALL_OPEN))]
+            spans.append((n, pos))
+            out.append(tail)
+            return "".join(out), spans
+        spans.append((n, pos))
+        out.append(text[pos:start])
+        n += start - pos
+        end = text.find(_CALL_CLOSE, start)
+        if end < 0:
+            return "".join(out), spans
+        pos = end + len(_CALL_CLOSE)
+
+
+def _raw_index(spans: list[tuple[int, int]], index: int) -> int:
+    """patches/0160: the raw position of visible position ``index`` (``_visible_spans``)."""
+
+    vis, raw = 0, 0
+    for v, r in spans:
+        if v > index:
+            break
+        vis, raw = v, r
+    return raw + index - vis
+
+
+def parse_stop(value: Any) -> list[str] | None:
+    """patches/0160: OpenAI's ``stop`` (a string or a list of strings) as a list without empty strings; raises
+    ValueError for anything else."""
+
+    if value is None:
+        return []
+    if isinstance(value, str):
+        value = [value]
+    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
+        raise ValueError("stop must be a string or a list of strings")
+    return [v for v in value if v]
+
+
+def find_stop(text: str, stops: list[str], start: int = 0) -> int:
+    """patches/0160: the earliest position (from ``start``) where any stop string begins, or -1."""
+
+    best = -1
+    for s in stops:
+        i = text.find(s, start)
+        if i >= 0 and (best < 0 or i < best):
+            best = i
+    return best
+
+
+def stop_holdback(text: str, stops: list[str]) -> int:
+    """patches/0160: how many trailing characters could still begin a stop string (held back while streaming)."""
+
+    return max((_partial_tag(text, s) for s in stops), default=0)
+
+
+def reasoning_fields(text: str) -> dict[str, str]:
+    """patches/0160: the reply's reasoning under the field names GLM53_TF_REASONING_FIELDS asks for:
+    ``both`` (default: ``reasoning_content`` and ``reasoning``), ``reasoning_content`` or ``reasoning``."""
+
+    mode = (os.environ.get("GLM53_TF_REASONING_FIELDS") or "both").strip().lower()
+    if mode == "reasoning_content":
+        return {"reasoning_content": text}
+    if mode == "reasoning":
+        return {"reasoning": text}
+    return {"reasoning_content": text, "reasoning": text}
+
+
+def _tool_name(tool: dict[str, Any]) -> str:
+    fn = tool.get("function") if isinstance(tool, dict) else None
+    return str((fn or tool).get("name") or "").strip() if isinstance(tool, dict) else ""
+
+
+TOOL_FIXES_ENV = "GLM53_TF_TOOL_FIXES"
+TOOL_FIXES = ("history", "reasoning", "choice", "args", "thinkcalls", "grammar")
+TOOL_FIXES_ALL = ("history", "reasoning", "choice", "args", "thinkcalls")
+
+
+def tool_fixes(raw: str | None = None) -> frozenset[str]:
+    """patches/0620: GLM53_TF_TOOL_FIXES, a comma list of the tool-calling fixes to apply (docs/TOOL-CALLING.md):
+    ``history``, ``reasoning``, ``choice``, ``args``, ``thinkcalls``, ``grammar``; ``all`` = every one but ``grammar``;
+    empty / ``0`` / ``off`` (default): none, every request as before. Raises ValueError for an unknown name."""
+
+    raw = os.environ.get(TOOL_FIXES_ENV, "") if raw is None else raw
+    names: set[str] = set()
+    for part in raw.replace(" ", "").lower().split(","):
+        if part in ("", "0", "off", "none"):
+            continue
+        if part == "all":
+            names.update(TOOL_FIXES_ALL)
+        elif part in TOOL_FIXES:
+            names.add(part)
+        else:
+            raise ValueError(f"{TOOL_FIXES_ENV}={raw!r}: unknown fix {part!r} (expected all or a comma list of "
+                             f"{', '.join(TOOL_FIXES)})")
+    return frozenset(names)
+
+
+_JSON_TYPES = {bool: "boolean", int: "integer", float: "number", str: "string", list: "array", dict: "object",
+               type(None): "null"}
+
+
+def schema_types(prop: Any) -> frozenset[str] | None:
+    """patches/0620: the JSON types a parameter schema allows (``type`` as a string or a list, ``anyOf`` / ``oneOf``
+    of typed members, ``enum`` / ``const`` values), or None when the schema does not say (untyped, ``$ref``, ...)."""
+
+    if not isinstance(prop, dict):
+        return None
+    kind = prop.get("type")
+    if isinstance(kind, str):
+        return frozenset({kind})
+    if isinstance(kind, list) and kind and all(isinstance(k, str) for k in kind):
+        return frozenset(kind)
+    for key in ("anyOf", "oneOf"):
+        members = prop.get(key)
+        if isinstance(members, list) and members:
+            found: set[str] = set()
+            for member in members:
+                sub = schema_types(member)
+                if sub is None:
+                    return None
+                found |= sub
+            return frozenset(found)
+    values = prop["enum"] if isinstance(prop.get("enum"), list) and prop["enum"] else (
+        [prop["const"]] if "const" in prop else None)
+    if values is not None:
+        return frozenset(_JSON_TYPES.get(type(v), "string") for v in values)
+    return None
+
+
+def _fits(value: Any, types: frozenset[str]) -> bool:
+    kind = _JSON_TYPES.get(type(value))
+    return kind in types or (kind == "integer" and "number" in types)
+
+
+def typed_value(raw: str, prop: Any) -> Any:
+    """patches/0620 (``GLM53_TF_TOOL_FIXES=args``): a GLM ``<arg_value>`` read by its parameter schema. A schema that
+    allows a string keeps the text as written (``null`` becomes None only when null is allowed too); one that does
+    not reads JSON of an allowed type, then the value closed (#87), a quoted number / boolean unquoted, Python's
+    ``True`` / ``False`` / ``None``, an integral float as an integer; anything else stays the text (as before). An
+    untyped schema reads as before 0620 (JSON, else the text)."""
+
+    types = schema_types(prop)
+    if types is None:
+        try:
+            return json.loads(raw)
+        except (json.JSONDecodeError, ValueError):
+            return _closed_value(raw, None)
+    if "string" in types:
+        return None if "null" in types and raw.strip() == "null" else raw
+    text = raw.strip()
+    candidates: list[Any] = []
+    for attempt in (text, closed_json(text) if types & {"array", "object"} else None):
+        if attempt is None:
+            continue
+        try:
+            candidates.append(json.loads(attempt))
+        except (json.JSONDecodeError, ValueError):
+            pass
+    if candidates and isinstance(candidates[0], str):           # "5" / "true" quoted
+        try:
+            candidates.append(json.loads(candidates[0].strip()))
+        except (json.JSONDecodeError, ValueError):
+            pass
+    python = {"True": True, "False": False, "None": None}
+    if text in python:
+        candidates.append(python[text])
+    for value in candidates:
+        if isinstance(value, float) and "integer" in types and "number" not in types and value.is_integer():
+            value = int(value)
+        if _fits(value, types):
+            return value
+    return raw
+
+
+def _glm_call(block: str, tools: list[dict[str, Any]]) -> tuple[str | None, dict[str, Any]]:
+    """GLM's ``name<arg_key>k</arg_key><arg_value>v</arg_value>...`` body, the way vLLM's glm47 parser reads it:
+    the name is the text before the first ``<arg_key>``; a value is kept as text when the tool's schema types the
+    parameter as a string, and read as JSON otherwise (falling back to the text). patches/0620: with
+    ``GLM53_TF_TOOL_FIXES=args`` each value is read by its whole schema (``typed_value``)."""
+
+    cut = block.find("<arg_key>")
+    name = (block if cut < 0 else block[:cut]).strip()
+    if not name or "<" in name or "\n" in name:
+        return None, {}
+    schema: dict[str, Any] = {}
+    for t in tools:
+        if _tool_name(t).lower() == name.lower():
+            fn = t.get("function") if isinstance(t.get("function"), dict) else t
+            schema = ((fn.get("parameters") or {}).get("properties") or {}) if isinstance(fn, dict) else {}
+    args: dict[str, Any] = {}
+    by_schema = "args" in tool_fixes()                      # patches/0620
+    for m in _GLM_ARG_RE.finditer(block):
+        key, raw = m.group(1).strip(), m.group(2)
+        if by_schema:
+            args[key] = typed_value(raw, schema.get(key))
+            continue
+        kind = (schema.get(key) or {}).get("type") if isinstance(schema.get(key), dict) else None
+        if kind == "string":
+            args[key] = raw
+            continue
+        try:
+            args[key] = json.loads(raw)
+        except (json.JSONDecodeError, ValueError):
+            args[key] = _closed_value(raw, kind)
+    return name, args
+
+
+from tensorfold.tool_parameters import closed_json  # noqa: E402  (issue #87's repair, shared with the CUDA server)
+
+
+def _closed_value(raw: str, kind: Any) -> Any:
+    """patches/0600: a value that is not JSON as written. When the tool's schema types it as an array / object and it
+    only stops short of its closing brackets (#87: GLM ends a nested argument one ``]`` / ``}`` short), the closed
+    value if it then parses to that type; otherwise the text, as before."""
+
+    if kind in ("array", "object"):
+        fixed = closed_json(raw)
+        if fixed is not None:
+            try:
+                value = json.loads(fixed)
+            except (json.JSONDecodeError, ValueError):
+                return raw
+            if isinstance(value, list if kind == "array" else dict):
+                return value
+    return raw
+
+
+def parse_tool_calls(text: str, tools: list[dict[str, Any]]) -> tuple[str, list[dict[str, Any]] | None]:
+    """Qwen ``<tool_call><function=name><parameter=k>v</parameter></function></tool_call>``, GLM
+    ``<tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value></tool_call>``, or JSON bodies."""
+
+    if not tools:
+        return text, None
+    known = {_tool_name(t).lower(): _tool_name(t) for t in tools}
+    calls: list[dict[str, Any]] = []
+    residue: list[str] = []
+    cursor = 0
+    for match in _TOOL_CALL_BLOCK_RE.finditer(text):
+        residue.append(text[cursor:match.start()])
+        cursor = match.end()
+        block = match.group(1).strip()
+        name, args = None, {}
+        try:
+            payload = json.loads(block)
+            if isinstance(payload, dict):
+                fn = payload.get("function") if isinstance(payload.get("function"), dict) else payload
+                name = fn.get("name")
+                args = fn.get("arguments", fn.get("parameters", {}))
+                if isinstance(args, str):
+                    args = json.loads(args) if args.strip() else {}
+        except (json.JSONDecodeError, AttributeError):
+            m = _TOOL_FUNCTION_BLOCK_RE.match(block)
+            if m:
+                name = m.group(1).strip()
+                args = {p.group(1).strip(): p.group(2) for p in _TOOL_PARAMETER_BLOCK_RE.finditer(m.group(2))}
+            else:
+                name, args = _glm_call(block, tools)
+        if not name or str(name).lower() not in known:
+            residue.append(match.group(0))
+            continue
+        calls.append({"id": f"call_{uuid.uuid4().hex[:24]}", "type": "function",
+                      "function": {"name": known[str(name).lower()],
+                                   "arguments": json.dumps(args, ensure_ascii=False, separators=(",", ":"))}})
+    residue.append(text[cursor:])
+    return "".join(residue).strip(), calls or None
+
+
+# -- patches/0490: OpenAI-shaped request errors, the context limit, token-ID prompts ----------------------------------
+
+class Problem(str):
+    """patches/0490: a request error message that carries an OpenAI error ``code`` and ``param`` (``check`` may
+    return one instead of a plain string; the handler puts both in the error body)."""
+
+    code: str | None = None
+    param: str | None = None
+    status: int = 400                       # patches/0600: 503 for a transient capacity refusal (retry shortly)
+
+    def __new__(cls, message: str, code: str | None = None, param: str | None = None,
+                status: int = 400) -> "Problem":
+        self = super().__new__(cls, message)
+        self.code, self.param, self.status = code, param, int(status)
+        return self
+
+
+def error_body(message: str, kind: str = "invalid_request_error") -> dict[str, Any]:
+    """patches/0490: ``{"error": {...}}`` as OpenAI sends it: message, type, and a ``Problem``'s code / param."""
+
+    err: dict[str, Any] = {"message": str(message), "type": kind}
+    code, param = getattr(message, "code", None), getattr(message, "param", None)
+    if code is not None:
+        err["code"] = code
+    if param is not None:
+        err["param"] = param
+    return {"error": err}
+
+
+def context_problem(prompt: int, asked: int | None, limit: int, *, chat: bool = True) -> Problem | None:
+    """patches/0490: None when ``prompt`` tokens plus ``asked`` reply tokens (1 without max_tokens) fit ``limit``;
+    otherwise a ``context_length_exceeded`` error in the wording OpenAI and vLLM use (clients such as opencode and
+    Hermes Agent read the limit and the split from it and compact the conversation), plus how to raise the limit."""
+
+    need = prompt + (int(asked) if asked else 1)
+    if need <= limit:
+        return None
+    where = "messages" if chat else "prompt"
+    if asked:
+        what = (f"However, you requested {need} tokens ({prompt} in the {where}, {int(asked)} in the completion). "
+                f"Please reduce the length of the {where} or completion.")
+    else:
+        what = f"However, your {where} resulted in {prompt} tokens. Please reduce the length of the {where}."
+    return Problem(f"This model's maximum context length is {limit} tokens. {what} (This TensorFold server was "
+                   f"started with --context {limit} (CONTEXT); restart both ranks with CONTEXT={need} or more to "
+                   "serve it.)", code="context_length_exceeded", param=where)
+
+
+def token_ids_problem(prompt: Any, vocab: int | None) -> str | None:
+    """patches/0490: why a ``/v1/completions`` token-ID ``prompt`` (one flat list of ints, as vLLM takes it) is not
+    usable, or None."""
+
+    if not prompt:
+        return "prompt must not be empty"
+    if all(isinstance(p, list) for p in prompt) or all(isinstance(p, str) for p in prompt):
+        return "one prompt a request: send a string or one list of token ids"
+    if not all(isinstance(t, int) and not isinstance(t, bool) for t in prompt):
+        return "a token-ID prompt must be a list of integers"
+    bad = next((t for t in prompt if t < 0 or (vocab is not None and t >= vocab)), None)
+    if bad is not None:
+        return f"token id {bad} is outside the vocabulary (0 to {vocab - 1 if vocab else '?'})"
+    return None
+
+
+# -- patches/0600: request hardening (from upstream TensorFold 2bc35c4, MIT) -------------------------------------
+
+_NUMBER_FIELDS = ("temperature", "top_p", "top_k", "seed", "max_tokens", "max_completion_tokens")
+_INTEGER_FIELDS = frozenset({"top_k", "seed", "max_tokens", "max_completion_tokens"})
+
+
+def parse_numbers(body: dict[str, Any]) -> dict[str, Any]:
+    """patches/0600: a request's sampling and length fields, read strictly (upstream's ``parse_numbers`` rules): no
+    booleans, a finite number (temperature, top_p) or an integral one (top_k, seed, max_tokens; ``20.0`` and ``"20"``
+    are fine, ``20.5`` is not). Null or absent: not in the result. Raises ValueError (HTTP 400, before a stream's
+    headers). Values are not clamped: the engine sees what it saw before for every valid request."""
+
+    parsed: dict[str, Any] = {}
+    for name in _NUMBER_FIELDS:
+        value = body.get(name)
+        if value is None:
+            continue
+        integer = name in _INTEGER_FIELDS
+        try:
+            if isinstance(value, bool) or not isinstance(value, (str, int, float)):
+                raise ValueError
+            number = int(value) if integer else float(value)
+            if integer and isinstance(value, float) and value != number:
+                raise ValueError
+            if not integer and not math.isfinite(number):
+                raise ValueError
+        except (ValueError, TypeError, OverflowError):
+            kind = "an integer" if integer else "a finite number"
+            raise ValueError(f"{name} must be {kind} or null") from None
+        parsed[name] = number
+    return parsed
+
+
+def template_kwargs(body: dict[str, Any]) -> dict[str, Any]:
+    """patches/0600: ``chat_template_kwargs`` as a new dict: absent or null is ``{}``; anything but a JSON object
+    ([], "", false and 0 included, as upstream) raises ValueError."""
+
+    kwargs = body.get("chat_template_kwargs")
+    if kwargs is None:
+        return {}
+    if not isinstance(kwargs, dict):
+        raise ValueError("chat_template_kwargs must be a JSON object or null")
+    return dict(kwargs)
+
+
+def template_refusal(exc: BaseException) -> str | None:
+    """patches/0600: the 400 message for a chat template's own refusal (jinja2 ``TemplateError``, e.g. the template's
+    ``raise_exception``), or None for any other exception."""
+
+    try:
+        from jinja2.exceptions import TemplateError
+    except ImportError:                     # pragma: no cover - the server needs jinja2
+        return None
+    return f"the chat template rejected the request: {exc}" if isinstance(exc, TemplateError) else None
+
+
+_URL_USERINFO = re.compile(r"(?i)\b([a-z][a-z0-9+.\-]*://)[^\s/@\"'<>]*@")
+_URL_QUERY = re.compile(r"(?i)\b([a-z][a-z0-9+.\-]*://[^\s?#\"'<>]*)[?#][^\s\"'<>]*")
+_DATA_URL = re.compile(r"(?i)\bdata:[^,\s\"'<>]*,[^\s\"'<>]*")
+
+
+def redact(text: str) -> str:
+    """patches/0600: ``text`` for a server log: URL credentials, query strings / fragments (tokens, signatures) and
+    ``data:`` payloads replaced by ``<redacted>``."""
+
+    text = _DATA_URL.sub("data:<redacted>", str(text))
+    text = _URL_QUERY.sub(r"\1?<redacted>", text)
+    return _URL_USERINFO.sub(r"\1<redacted>@", text)
+
+
+def log_error(exc: BaseException, what: str) -> None:
+    """patches/0600: one line and the traceback for a refused (400) or failed (500) request, redacted."""
+
+    lines = "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))
+    print(redact(f"[tensorfold] {what}: {type(exc).__name__}: {exc}\n{lines}"), end="", flush=True)
+
+
+def _takes_cancelled(run: Callable) -> bool:
+    """patches/0600: whether an app's ``run`` takes ``cancelled=``."""
+
+    import inspect
+
+    try:
+        params = inspect.signature(run).parameters
+    except (TypeError, ValueError):
+        return False
+    return "cancelled" in params or any(p.kind is inspect.Parameter.VAR_KEYWORD for p in params.values())
+
+
+def disconnect_on() -> bool:
+    """patches/0600: GLM53_TF_DISCONNECT (default 1): stop a request whose client has gone (a socket check while it
+    waits, prefills and decodes, streamed or not). 0: only a failed streamed write stops one (before 0600)."""
+
+    raw = os.environ.get("GLM53_TF_DISCONNECT", "1").strip() or "1"
+    if raw not in ("0", "1"):
+        raise ValueError(f"GLM53_TF_DISCONNECT={raw!r}: expected 0 or 1")
+    return raw == "1"
+
+
+# -- chat template -------------------------------------------------------------------------
+
+class ChatTemplate:
+    """The model's own Jinja chat template, rendered the way Hugging Face's apply_chat_template does."""
+
+    def __init__(self, model_dir: Path):
+        import jinja2
+        import jinja2.ext
+        from jinja2.sandbox import ImmutableSandboxedEnvironment
+
+        cfg = json.loads((model_dir / "tokenizer_config.json").read_text())
+        source_path = model_dir / "chat_template.jinja"
+        source = source_path.read_text() if source_path.exists() else cfg["chat_template"]
+
+        def tojson(x, ensure_ascii=False, indent=None, separators=None, sort_keys=False):
+            return json.dumps(x, ensure_ascii=ensure_ascii, indent=indent, separators=separators, sort_keys=sort_keys)
+
+        def raise_exception(message):
+            raise jinja2.exceptions.TemplateError(message)
+
+        env = ImmutableSandboxedEnvironment(trim_blocks=True, lstrip_blocks=True,
+                                            extensions=[jinja2.ext.loopcontrols])
+        env.filters["tojson"] = tojson
+        env.globals["raise_exception"] = raise_exception
+        env.globals["strftime_now"] = lambda fmt: datetime.now().strftime(fmt)
+        self.template = env.from_string(source)
+        self.specials = {k: (v.get("content") if isinstance(v, dict) else v)
+                         for k, v in cfg.items() if k in ("bos_token", "eos_token", "pad_token", "unk_token")}
+
+    def render(self, messages: list[dict[str, Any]], *, tools: list[dict[str, Any]] | None,
+               enable_thinking: bool, extra: dict[str, Any] | None = None) -> str:
+        for m in messages:                       # tool_call arguments arrive as JSON strings
+            for call in m.get("tool_calls") or []:
+                fn = call.get("function") or {}
+                if isinstance(fn.get("arguments"), str):
+                    try:
+                        fn["arguments"] = json.loads(fn["arguments"])
+                    except json.JSONDecodeError:
+                        pass
+        kwargs = dict(self.specials, messages=messages, tools=tools or None, add_generation_prompt=True,
+                      enable_thinking=enable_thinking)
+        kwargs.update(extra or {})
+        return self.template.render(**kwargs)
+
+
+# -- HTTP ------------------------------------------------------------------------------------
+
+class App:
+    """One engine behind the OpenAI routes. ``sampling``: temperature, top_k and top_p for requests that do not
+    set them (the model's generation config and the CLI's flags); ``max_tokens``: the reply length likewise."""
+
+    def __init__(self, engine, model_dir: Path, served: str, *, default_thinking: bool = False,
+                 sampling: dict[str, Any] | None = None, max_tokens: int = 4096,
+                 context_window: int | None = None, reasoning_effort: str | None = None, thinking_budget: int = 0,
+                 aliases: tuple[str, ...] | list[str] = ()):
+        from tokenizers import Tokenizer
+
+        if any(str(alias).strip() for alias in aliases):     # 0.6.0's CLI passes --alias to every CUDA app
+            raise ValueError("--alias: the Spark engine's server lists and names --name only; leave the flag unset")
+        # the CLI's --context is the engine's ``limit``; the default effort is GLM53_TF_DEFAULT_EFFORT (0150)
+        if reasoning_effort is not None:
+            raise ValueError("--reasoning-effort: the Spark engine's server takes its default effort from "
+                             "GLM53_TF_DEFAULT_EFFORT; leave the flag unset")
+        if int(thinking_budget or 0) > 0:
+            raise ValueError("--thinking-budget: the Spark engine's server has no thinking budget; leave it at 0")
+        self.context_window = context_window
+
+        from .health import Health       # patches/0150: /health that can say no, /metrics
+
+        self.health = Health()
+        self.engine = self.health.track(engine)     # patches/0150: generate() through the request bookkeeping
+        self.served = served
+        self.tok = Tokenizer.from_file(str(model_dir / "tokenizer.json"))
+        self.template = ChatTemplate(model_dir)
+        self.default_thinking = default_thinking
+        self.sampling = {"temperature": 1.0, "top_k": 20, "top_p": 0.95, **(sampling or {})}
+        self.max_tokens = int(max_tokens)
+        self.lock = threading.Lock()
+        self.created = int(time.time())             # patches/0490: /v1/models' ``created``
+        self.disconnect = disconnect_on()           # patches/0600: GLM53_TF_DISCONNECT, checked at load
+
+    def check(self, body: dict[str, Any]) -> str | None:
+        """Why the request cannot run, or None. Checked before a stream's headers are sent."""
+
+        import inspect
+
+        if body.get("draft", True) is False and "draft" not in inspect.signature(self.engine.generate).parameters:
+            return "this model's CUDA engine has no serial switch (\"draft\": false)"
+        if not isinstance(body.get("messages", []), list):
+            return "messages must be a list"
+        try:                                        # patches/0160
+            parse_stop(body.get("stop"))
+        except ValueError as exc:
+            return str(exc)
+        try:                                        # patches/0600: refused before a stream's headers
+            template_kwargs(body)
+            parse_numbers(body)
+        except ValueError as exc:
+            return str(exc)
+        if isinstance(body.get("prompt"), list):    # patches/0490: a token-ID prompt (/v1/completions)
+            problem = token_ids_problem(body["prompt"], self.vocab_size())
+            if problem:
+                return Problem(problem, param="prompt")
+        n = body.get("n")
+        if n is not None and n != 1:
+            return f"n must be 1 on this server (got {n!r}): it returns one choice a request"
+        if body.get("tf_knobs") is not None:        # patches/0090: per-request engine knobs, validated up front
+            parse = getattr(self.engine, "parse_knobs", None)
+            if parse is None:
+                return "this model's CUDA engine has no per-request knobs (tf_knobs)"
+            try:
+                parse(body["tf_knobs"])
+            except ValueError as exc:
+                return str(exc)
+        return None
+
+    def prompt_ids(self, text: str) -> list[int]:
+        """The rendered prompt's token ids (patches/0210: a family's app may reuse ones it already has)."""
+
+        return self.tok.encode(text, add_special_tokens=False).ids
+
+    def given_ids(self, ids: list[int]) -> list[int]:
+        """patches/0490: a request's own token ids (``/v1/completions`` with a token-ID ``prompt``)."""
+
+        return [int(t) for t in ids]
+
+    def vocab_size(self) -> int | None:
+        """patches/0490: the tokenizer's vocabulary with added tokens (None when the tokenizer cannot say)."""
+
+        size = getattr(self.tok, "get_vocab_size", None)
+        return int(size(with_added_tokens=True)) if size is not None else None
+
+    def context_limit(self) -> int | None:
+        """patches/0490: the most prompt + reply tokens a request may use (the engine's ``limit``: ``--context``),
+        or None when the engine does not say."""
+
+        limit = getattr(self.engine, "limit", None)
+        return int(limit) if isinstance(limit, int) and limit > 0 else None
+
+    @property
+    def effective_context_window(self) -> int | None:
+        """The prompt-plus-reply limit the CLI reports at start: the engine's ``limit``."""
+
+        return self.context_limit()
+
+    def tokenize(self, body: dict[str, Any]) -> list[int]:
+        """patches/0490: ``POST /tokenize`` (vLLM's shape): a string ``prompt`` encoded as the tokenizer does it
+        (``add_special_tokens``, default true as in vLLM), or ``messages`` rendered with the chat template as a chat
+        request renders them. Raises ValueError for anything else."""
+
+        if isinstance(body.get("messages"), list):
+            kwargs = dict(body.get("chat_template_kwargs") or {})
+            thinking = bool(kwargs.pop("enable_thinking", self.default_thinking))
+            text = self.template.render(body["messages"], tools=body.get("tools") or [], enable_thinking=thinking,
+                                        extra=kwargs)
+            return list(self.tok.encode(text, add_special_tokens=False).ids)
+        prompt = body.get("prompt")
+        if not isinstance(prompt, str):
+            raise ValueError("tokenize needs a string prompt or a list of messages")
+        return list(self.tok.encode(prompt, add_special_tokens=bool(body.get("add_special_tokens", True))).ids)
+
+    def sampling_for(self, body: dict[str, Any], prompt: list[int]):
+        """Keyed sampling (the seed, else one drawn from the prompt), or None for greedy decoding."""
+
+        from tensorfold.engine.exact_sampling import Sampling, seed_for
+
+        fields = parse_numbers(body)                # patches/0600: the values ``check`` accepted (same numbers)
+        temp = float(fields.get("temperature", self.sampling["temperature"]))
+        if temp <= 0:
+            return None
+        seed = fields.get("seed")
+        top_k = fields.get("top_k", self.sampling["top_k"])
+        top_p = fields.get("top_p", self.sampling["top_p"])
+        return Sampling(int(seed) if seed is not None else seed_for(prompt), temp, int(top_k), float(top_p))
+
+    def reply_hook(self, body: dict[str, Any], *, content: str, calls: list[dict[str, Any]] | None, reasoning: str,
+                   last: int | None, thinking: bool, stopped: bool):
+        """patches/0620: (content, calls, reasoning) of a finished chat reply with tools; a family's app may fix them
+        (``glm5_next/cuda/toolfix.py``). Here: unchanged."""
+
+        return content, calls, reasoning
+
+    def run(self, body: dict[str, Any], chat: bool, emit: Callable[[dict[str, Any]], bool], *,
+            cancelled: Callable[[], bool] | None = None) -> dict[str, Any]:
+        """One reply. patches/0600 (upstream 24afe5e): ``cancelled()`` is true once the client has gone. A request that
+        has not started raises ``RequestCancelled`` without an engine call; a running one stops at its next round (the
+        batch engine also polls it while the request waits and prefills) and raises ``RequestCancelled`` once
+        ``generate`` returns, so no truncated reply is written. The per-token callback never raises into the engine:
+        a failure stops the request and is raised after ``generate`` returns."""
+
+        tools = body.get("tools") or []
+        kwargs = dict(body.get("chat_template_kwargs") or {})
+        thinking = bool(kwargs.pop("enable_thinking", self.default_thinking))
+        if chat:
+            try:
+                text = self.template.render(body["messages"], tools=tools, enable_thinking=thinking, extra=kwargs)
+            except Exception as exc:            # patches/0600: a template refusal is the client's error (a 400)
+                message = template_refusal(exc)
+                if message is None:
+                    raise
+                raise ValueError(message) from exc
+        else:
+            text = body["prompt"]
+        if not chat and isinstance(text, list):    # patches/0490: token ids, used as they are
+            prompt = self.given_ids(text)
+        else:
+            prompt = self.prompt_ids(text)         # patches/0210
+        max_tokens = int(body.get("max_tokens") or body.get("max_completion_tokens") or self.max_tokens)
+        sampling = self.sampling_for(body, prompt)
+        out: list[int] = []
+        sent = {"reasoning": 0, "content": 0}
+        stopped = {"client": False}
+        failed: list[BaseException] = []            # patches/0600: the callback's failure, raised after generate
+        # patches/0160: OpenAI ``stop`` strings end the visible answer (not the reasoning, not a tool call's text):
+        # the reply is cut before the first one and nothing after it is sent. ``at``: the tokens received when it
+        # was seen (the reply's reported length)
+        stops = parse_stop(body.get("stop"))
+        hit = {"stop": False, "at": 0}
+        stream = StreamDecoder(self.tok, tuple(self.engine.eos))
+
+        def visible(finished: bool, raw: str | None = None) -> tuple[str, str]:
+            if raw is None:
+                raw = stream.final() if finished else stream.text
+            if chat and thinking:
+                reasoning, answer = split_thinking(raw, finished=finished)
+            else:
+                reasoning, answer = "", raw
+            if tools:
+                answer = hide_tool_calls(answer, finished=finished)
+            return reasoning, answer
+
+        eos = frozenset(self.engine.eos)
+
+        def stop_at(k: int) -> int:
+            """patches/0600 (upstream 88407d1's per-token rule, on our 0160 scope: the visible answer): the reply's
+            length at the token that completes the first stop string, among the ``k`` tokens this call brought (a
+            drafted round brings several), so ``completion_tokens`` is the same however the tokens arrived."""
+
+            base = len(out) - k
+            for j in range(1, k):
+                ids = [t for t in out[:base + j] if t not in eos]
+                _, answer = visible(False, self.tok.decode(ids, skip_special_tokens=False))
+                if find_stop(answer, stops) >= 0:
+                    return base + j
+            return len(out)
+
+        def on_tokens(new: list[int]) -> bool:
+            # patches/0600: True stops the request after this round; once stopped (client gone, a stop string, a
+            # failure) every later call returns True at once and nothing more is decoded into text or sent
+            if stopped["client"] or failed:
+                out.extend(new)
+                return True
+            try:
+                out.extend(new)
+                if hit["stop"]:                     # patches/0160: past a stop string: nothing more is sent
+                    return True
+                stream.add(new)
+                reasoning, answer = visible(False)
+                if stops:                           # patches/0160
+                    cut = find_stop(answer, stops, max(0, sent["content"] - max(map(len, stops)) + 1))
+                    if cut >= 0:
+                        answer = answer[:cut]
+                        hit.update(stop=True, at=stop_at(len(new)))
+                    else:
+                        answer = answer[: len(answer) - stop_holdback(answer, stops)]
+                delta: dict[str, Any] = {}
+                if len(reasoning) > sent["reasoning"]:
+                    delta.update(reasoning_fields(reasoning[sent["reasoning"]:]))
+                    sent["reasoning"] = len(reasoning)
+                if len(answer) > sent["content"]:
+                    delta["content"] = answer[sent["content"]:]
+                    sent["content"] = len(answer)
+                if delta and not emit(delta):
+                    stopped["client"] = True
+                elif cancelled is not None and cancelled():     # patches/0600: every round, text or not
+                    stopped["client"] = True
+            except Exception as exc:        # noqa: BLE001  patches/0600: raised after generate, never into the engine
+                failed.append(exc)
+                return True
+            # patches/0160: True after a stop string too; the batch engine (GLM53_TF_BATCH) then ends the request
+            # in its next round (a cancel both ranks share), a single-request engine decodes on unheard
+            return stopped["client"] or hit["stop"]
+
+        if cancelled is not None:
+            on_tokens.cancelled = cancelled         # patches/0600: the batch engine polls it while nothing arrives
+
+        draft = body.get("draft", True) is not False
+        with self.lock:
+            if cancelled is not None and cancelled():       # patches/0600: the client left while this one waited
+                raise RequestCancelled("the client left before the request started")
+            stats = self.engine.generate(prompt, max_tokens, sampling, on_tokens,
+                                         **({} if draft else {"draft": False}))
+        if failed:                                  # patches/0600: the callback's failure (a 500 / stream error)
+            raise failed[0]
+        if stopped["client"]:                       # patches/0600: as upstream, nothing more is written
+            raise RequestCancelled("the client left during the reply", result={
+                "prompt_tokens": len(prompt), "completion_tokens": len(out), "finish": "cancelled",
+                "stats": dict(stats or {}, cancelled=True)})
+        reasoning, answer = visible(True)
+        final: dict[str, Any] = {}
+        if len(reasoning) > sent["reasoning"]:
+            final.update(reasoning_fields(reasoning[sent["reasoning"]:]))
+        raw_answer = split_thinking(self.tok.decode([t for t in out if t not in self.engine.eos],
+                                                    skip_special_tokens=False), finished=True)[1] \
+            if chat and thinking else self.tok.decode([t for t in out if t not in self.engine.eos],
+                                                      skip_special_tokens=False)
+        stopped_at = -1
+        if stops:                                   # patches/0160: cut the answer (and the raw text) at a stop
+            shown, spans = _visible_spans(raw_answer, finished=True) if tools else (raw_answer, [(0, 0)])
+            stopped_at = find_stop(shown, stops)
+            if stopped_at >= 0:
+                raw_answer = raw_answer[:_raw_index(spans, stopped_at)]
+                cut = find_stop(answer, stops)
+                answer = answer[:cut] if cut >= 0 else answer
+        content, calls = parse_tool_calls(raw_answer, tools) if tools else (answer, None)
+        if chat and tools:                          # patches/0620: a family's fixes to the finished reply
+            content, calls, reasoning = self.reply_hook(body, content=content, calls=calls, reasoning=reasoning,
+                                                        last=out[-1] if out else None, thinking=thinking,
+                                                        stopped=stopped_at >= 0)
+        tail = content[sent["content"]:] if content.startswith(answer[:sent["content"]]) else ""
+        if tail:
+            final["content"] = tail
+        if calls:
+            finish = "tool_calls"
+        elif stopped_at >= 0 or (out and out[-1] in self.engine.eos):
+            finish = "stop"
+        else:
+            finish = "length"
+        used = hit["at"] if stopped_at >= 0 and hit["stop"] else len(out)
+        if body.get("return_token_ids"):            # patches/0600 (upstream e6be5ff): the reply's ids (the counted ones)
+            stats = dict(stats or {}, token_ids=[int(t) for t in out[:used]])
+        return {"final": final, "calls": calls, "finish": finish, "content": content, "reasoning": reasoning,
+                "prompt_tokens": len(prompt), "completion_tokens": used, "stats": stats}
+
+
+def make_handler(app: App):
+    class Handler(Rearming):              # USR1's stack dump armed again after each request
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, fmt, *args):  # quiet
+            pass
+
+        def _json(self, code: int, payload: dict[str, Any]) -> None:
+            data = json.dumps(payload).encode()
+            try:
+                self.send_response(code)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+            except (BrokenPipeError, ConnectionResetError):          # patches/0600: the client has gone
+                self.close_connection = True
+
+        def _refuse(self, exc: BaseException) -> None:
+            """patches/0600 (upstream 2bc35c4): a request ``check`` / ``tokenize`` could not read is a 400, never a
+            dropped connection: a template refusal says so, a ValueError is the client's, anything else is logged
+            with its traceback (redacted) and answered with its message."""
+
+            message = template_refusal(exc)
+            if message is None:
+                if not isinstance(exc, ValueError):
+                    log_error(exc, "request refused (400)")
+                message = str(exc) or type(exc).__name__
+            self._json(400, error_body(message[:2000]))
+
+        def do_GET(self):
+            if self.path.rstrip("/") in ("/v1/models", "/models"):
+                entry: dict[str, Any] = {"id": app.served, "object": "model", "owned_by": "tensorfold"}
+                limit = app.context_limit()                 # patches/0490: as vLLM (max_model_len) and others say it
+                if limit is not None:
+                    entry.update(created=getattr(app, "created", 0), root=app.served, max_model_len=limit, context_length=limit)
+                # more ids answered by the same model (an app's ``listed_aliases``; the DeepSeek-V4.1 app: --alias)
+                extra = [dict(entry, id=a) for a in getattr(app, "listed_aliases", ()) if a != app.served]
+                self._json(200, {"object": "list", "data": [entry] + extra})
+            elif self.path.rstrip("/") in ("/health", "/v1/health"):
+                self._json(*app.health.status(app))         # patches/0150; 0600: upstream's live totals too
+            elif self.path.rstrip("/") in ("/v1/model_info", "/v1/internal/model_info"):
+                self._json(200, app.health.model_info(app))     # slots / context as vLLM names them
+            elif self.path.rstrip("/") == "/metrics":       # patches/0150: Prometheus text
+                data = app.health.metrics(app.served, app).encode()     # + vLLM-named series (dashboards)
+                self.send_response(200)
+                self.send_header("Content-Type", "text/plain; version=0.0.4")
+                self.send_header("Content-Length", str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+            else:
+                self._json(404, {"error": "not found"})
+
+        def do_POST(self):
+            path = self.path.rstrip("/")
+            chat = path.endswith("/chat/completions")
+            tokenize = path in ("/tokenize", "/v1/tokenize")        # patches/0490
+            if not chat and not tokenize and not path.endswith("/completions"):
+                return self._json(404, {"error": "not found"})
+            try:
+                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
+            except (json.JSONDecodeError, UnicodeDecodeError, ValueError):   # patches/0600: non-UTF-8, bad length
+                return self._json(400, error_body("the request body is not JSON"))
+            if not isinstance(body, dict):
+                return self._json(400, error_body("the request body must be a JSON object"))
+            if tokenize:                        # patches/0490: host only (no engine, no lock, nothing to rank 1)
+                try:
+                    ids = app.tokenize(body)
+                except Exception as exc:                # patches/0600: template refusals and the rest too
+                    return self._refuse(exc)
+                return self._json(200, {"count": len(ids), "max_model_len": app.context_limit(), "tokens": ids,
+                                        "token_strs": None})
+            try:
+                problem = app.check(body)
+            except Exception as exc:                    # patches/0600: a 400, not a dropped connection
+                return self._refuse(exc)
+            if problem:                                 # patches/0490: with a Problem's code / param
+                status = getattr(problem, "status", 400)        # patches/0600: 503 = retry shortly
+                return self._json(status, error_body(problem, "invalid_request_error" if status == 400
+                                                      else "server_error"))
+            refused = app.health.reject()           # patches/0150: GLM53_TF_HEALTH=strict after a fatal error
+            if refused:
+                return self._json(503, {"error": {"message": refused, "type": "server_error"}})
+            rid = f"chatcmpl-{uuid.uuid4().hex[:24]}" if chat else f"cmpl-{uuid.uuid4().hex[:24]}"
+            created = int(time.time())
+            stream = bool(body.get("stream"))
+            kind = "chat.completion.chunk" if chat else "text_completion"
+            # patches/0600 (upstream 24afe5e): the client's socket, checked while the request waits, prefills and
+            # decodes (GLM53_TF_DISCONNECT=0: off)
+            gone = socket_cancellation(self.connection) if getattr(app, "disconnect", True) else None
+            cancelled = (lambda: gone.cancelled) if gone is not None else None     # noqa: E731
+            if not _takes_cancelled(app.run):                   # an app whose ``run`` predates 0600
+                cancelled = None
+            extra = {} if cancelled is None else {"cancelled": cancelled}
+
+            def chunk(delta: dict[str, Any], finish: str | None = None) -> dict[str, Any]:
+                if chat:
+                    return {"id": rid, "object": kind, "created": created, "model": app.served,
+                            "choices": [{"index": 0, "delta": delta, "finish_reason": finish}]}
+                return {"id": rid, "object": kind, "created": created, "model": app.served,
+                        "choices": [{"index": 0, "text": delta.get("content", ""), "finish_reason": finish}]}
+
+            if stream:
+                self.send_response(200)
+                self.send_header("Content-Type", "text/event-stream")
+                self.send_header("Cache-Control", "no-cache")
+                self.send_header("Connection", "close")
+                self.end_headers()
+
+                def emit(delta: dict[str, Any]) -> bool:
+                    try:
+                        self.wfile.write(f"data: {json.dumps(chunk(delta))}\n\n".encode())
+                        self.wfile.flush()
+                        return True
+                    except OSError:             # patches/0600: reset, pipe, timed out, unreachable: the client has gone
+                        return False
+
+                if chat:
+                    emit({"role": "assistant"})
+                try:
+                    result = app.run(body, chat, emit, **extra)
+                except RequestCancelled:        # patches/0600: the client has gone; nothing more is written
+                    self.close_connection = True
+                    return
+                except Exception as exc:        # patches/0150: an error event, not a dropped connection
+                    if not isinstance(exc, ValueError):
+                        log_error(exc, "request failed (stream error event)")      # patches/0600
+                    try:
+                        # patches/0490: a request the engine refused (ValueError) is the client's error, as in the
+                        # non-streamed response
+                        err = error_body(str(exc)[:500]) if isinstance(exc, ValueError) else \
+                            {"error": {"message": f"{type(exc).__name__}: {exc}"[:500], "type": "server_error"}}
+                        self.wfile.write(f"data: {json.dumps(err)}\n\ndata: [DONE]\n\n".encode())
+                        self.wfile.flush()
+                    except OSError:
+                        pass
+                    self.close_connection = True
+                    return
+                if result["final"]:
+                    emit(result["final"])
+                if result["calls"]:
+                    for i, call in enumerate(result["calls"]):
+                        emit({"tool_calls": [{"index": i, "id": call["id"], "type": "function",
+                                              "function": {"name": call["function"]["name"],
+                                                           "arguments": call["function"]["arguments"]}}]})
+                end = chunk({}, result["finish"])
+                usage = {"prompt_tokens": result["prompt_tokens"], "completion_tokens": result["completion_tokens"],
+                         "total_tokens": result["prompt_tokens"] + result["completion_tokens"],
+                         "prompt_tokens_details": _cached(result)}          # patches/0110
+                if (body.get("stream_options") or {}).get("include_usage"):
+                    end["usage"] = usage
+                end["tensorfold"] = result["stats"]      # patches/0090: the engine's stats (effective tf_knobs)
+                try:
+                    self.wfile.write(f"data: {json.dumps(end)}\n\ndata: [DONE]\n\n".encode())
+                    self.wfile.flush()
+                except OSError:
+                    pass
+                self.close_connection = True
+                return
+            try:
+                result = app.run(body, chat, lambda delta: True, **extra)
+            except RequestCancelled:            # patches/0600: the client has gone; no reply
+                self.close_connection = True
+                return
+            except ValueError as exc:           # patches/0150: a request the engine refused
+                return self._json(400, {"error": {"message": str(exc), "type": "invalid_request_error"}})
+            except Exception as exc:            # patches/0150: a JSON 500, not a dropped connection
+                log_error(exc, "request failed (500)")                  # patches/0600
+                return self._json(500, {"error": {"message": f"{type(exc).__name__}: {exc}"[:500],
+                                                  "type": "server_error"}})
+            usage = {"prompt_tokens": result["prompt_tokens"], "completion_tokens": result["completion_tokens"],
+                     "total_tokens": result["prompt_tokens"] + result["completion_tokens"],
+                     "prompt_tokens_details": _cached(result)}              # patches/0110
+            if chat:
+                message: dict[str, Any] = {"role": "assistant", "content": result["content"] or None}
+                if result["reasoning"]:
+                    message.update(reasoning_fields(result["reasoning"]))      # patches/0160
+                if result["calls"]:
+                    message["tool_calls"] = result["calls"]
+                payload = {"id": rid, "object": "chat.completion", "created": created, "model": app.served,
+                           "choices": [{"index": 0, "message": message, "finish_reason": result["finish"]}],
+                           "usage": usage, "tensorfold": result["stats"]}
+            else:
+                payload = {"id": rid, "object": "text_completion", "created": created, "model": app.served,
+                           "choices": [{"index": 0, "text": result["content"], "finish_reason": result["finish"]}],
+                           "usage": usage, "tensorfold": result["stats"]}
+            self._json(200, payload)
+
+    return Handler
+
+
+def _cached(result: dict[str, Any]) -> dict[str, int]:
+    """patches/0110: OpenAI's ``usage.prompt_tokens_details``: the prompt tokens the engine resumed from a kept
+    state instead of prefilling (its stats' ``cached``)."""
+
+    return {"cached_tokens": int((result.get("stats") or {}).get("cached", 0) or 0)}
+
+
+def serve(app: App, host: str, port: int) -> None:
+    """Serve until interrupted (SIGTERM included)."""
+
+    import signal
+    from http.server import ThreadingHTTPServer
+
+    def _terminate(signum: int, frame: Any) -> None:
+        raise KeyboardInterrupt
+
+    signal.signal(signal.SIGTERM, _terminate)
+    server = ThreadingHTTPServer((host, port), make_handler(app))
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
