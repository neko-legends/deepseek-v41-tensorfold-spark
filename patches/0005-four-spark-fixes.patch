-"""The round plan from rank 0 to rank 1 over a TCP socket instead of the communicator (``TF_DSV41_PLAN_LINK=tcp``).
+"""The round plan from rank 0 to the followers over a TCP socket instead of the communicator (``TF_DSV41_PLAN_LINK=tcp``).
 
 Why: ``engine._Link`` shares each plan with two all-gathers on the GPU stream (its length, then its ints), each
 followed by a ``.tolist()``: ~0.74 ms of rank 0's host a round (G7 C1), and because the gathers queue behind
@@ -14,6 +14,11 @@ while both GPUs still run. The plan is the same list of ints as before (``plan.P
 order and rank 1's decisions are unchanged; a closed connection raises on both sides (rank 1 stops instead of
 hanging in a collective).
 
+Who is who: a follower opens with a hello (``HELLO``: magic, its rank, the world size) and waits for rank 0's
+one-byte answer; rank 0 accepts until it holds ranks 1 .. world - 1 exactly once each, in rank order, and closes
+anything else (a stray client, a duplicate rank, another world size) without counting it. A refused follower
+raises at boot instead of following the wrong leader; rank 0 never pairs a plan stream with an unknown peer.
+
 Knobs: TF_DSV41_PLAN_LINK (nccl: the communicator, default; tcp), TF_DSV41_PLAN_PORT, TF_DSV41_PLAN_TIMEOUT
 (connect / accept seconds, 300).
 """
@@ -28,6 +33,9 @@ from array import array
 
 ENV = "TF_DSV41_PLAN_LINK"
 _LEN = struct.Struct("<I")
+HELLO = struct.Struct("<4sHH")     # b"TFPL", rank, world
+MAGIC = b"TFPL"
+OK, REFUSED = b"\x01", b"\x00"
 
 
 def mode() -> str:
@@ -70,23 +78,12 @@ class TcpLink:
             srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
