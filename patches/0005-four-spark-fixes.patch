+def test_candidates_full_vocabulary_on_four_ranks(ck4):
+    """A verify window's candidates at counts past the narrow slices (nucleus rows ask for the whole vocabulary)."""
+
+    from tensorfold.families.deepseek_v41.cuda.forward import Seg
+
+    ids = PROMPTS[0][:20]
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+
+    def go(r):
+        f = DF.forward(ck4, rank=r, world=4, comm=comms[r], dspark=False)
+        lg = f.run([Seg(0, 0, tuple(ids))])
+        return [f.candidates(lg, [len(ids)], c) for c in (3, 200, 640)]
+
+    with N.exact():
+        got = pair.run([lambda r=r: go(r) for r in range(4)])
+        one = DF.forward(ck4, dspark=False)
+        lg1 = one.run([Seg(0, 0, tuple(ids))])
+        want = [one.candidates(lg1, [len(ids)], c) for c in (3, 200, 640)]
+    for rank in got:
+        for c, w in zip(rank, want):
+            assert np.array_equal(np.asarray(c.ids), np.asarray(w.ids))
+            assert np.allclose(np.asarray(c.values, dtype=np.float64), np.asarray(w.values, dtype=np.float64),
+                               rtol=0, atol=1e-9)
+    assert np.asarray(got[0][2].ids).shape[1] == 640
+
