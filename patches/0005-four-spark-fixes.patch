+def test_wide_candidate_rows_skip_the_speculative_pass(ck4, monkeypatch):
+    """``TF_DSV41_SPEC_DRAFT=1``: windows of more than ``SPEC_MAX_COUNT`` candidates a row launch no speculative
+    DSpark pass (top_k ~32,000 hung every rank with it on); narrower ones still do; replies are the same either way."""
+
+    from tensorfold.families.deepseek_v41.cuda import decode as DEC
+
+    monkeypatch.setenv("TF_DSV41_SPEC_DRAFT", "1")
+    monkeypatch.delenv("TF_DSV41_DRAFT_HEAD", raising=False)
+    wide = Sampling(seed=5, temperature=0.9, top_k=300)            # count 308 > the limit below
+    narrow = Sampling(seed=5, temperature=0.9, top_k=20)
+
+    def go(sampling, limit):
+        monkeypatch.setattr(DEC, "SPEC_MAX_COUNT", limit)
+        fw = DF.forward(ck4, slots=1)
+        assert fw.spec is not None
+        launched = []
+        real = fw.spec.launch
+        fw.spec.launch = lambda *a, **k: launched.append(1) or real(*a, **k)
+        got = DF.run(DF.batcher(ck4, fw, n=1), [Job(list(PROMPTS[0]), 12, sampling)])
+        return got, len(launched)
+
+    with N.exact():
+        skipped, n0 = go(wide, 64)
+        allowed, n1 = go(wide, 4096)
+        _, n2 = go(narrow, 64)
+    assert n0 == 0 and n1 > 0 and n2 > 0
+    assert skipped == allowed
