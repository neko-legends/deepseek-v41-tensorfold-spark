@@ -0,0 +1,361 @@
+# SPDX-License-Identifier: MIT
+"""Four ranks with uneven slices: the bugs jayleaton's review of the TP=4 port found (PR #6), each pinned here.
+
+- candidates over the vocabulary at any count (verify windows, nucleus rows' full vocabulary, DSpark): every rank
+  sends the same k (``pick.rank_top``: the widest slice's, narrower ones padded), so the all-gather agrees and the
+  merged rows equal one rank's (before: ``k = min(count, own width)``, a mismatched gather at count > 32,256);
+- the trimmed draft head's per-rank lists follow the 128-block vocabulary split (before: ``r * n``, rank 2 refused
+  to boot) and four ranks draft alike, greedy, sampled and nucleus (full-vocabulary candidates) requests;
+- the TCP plan link: followers say who they are; rank 0 refuses strays, duplicates and another world size, and
+  orders the connections by rank;
+- ``--tp 4`` only for a family that declares it (``CUDA_TP``);
+- ``TF_DSV41_PREFILL_ATTN_BMQ=32`` on a rank with 16 heads runs the fused kernel with 16 heads a program;
+- the NVMe session tier's directory differs between world sizes;
+- a DSpark delta's shards follow the weights' 128-block split.
+
+The thread communicator now refuses unequal all-gather sizes (NCCL's contract), so a mismatch fails here instead of
+hanging a Spark.
+"""
+
+from __future__ import annotations
+
+import queue
+import socket
+import threading
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_dspark_fakes as DF  # noqa: E402
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pick as P  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import planlink as PL  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import vsample as VS  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.batch import Job  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.weights import block_bounds  # noqa: E402
+
+V4 = {"vocab_size": 640, "o_groups": 4, "moe_intermediate_size": 640}      # slices 256 / 128 / 128 / 128
+PROMPTS = [[int(t) for t in np.random.default_rng(70 + i).integers(3, 600, size=30 + 11 * i)] for i in range(3)]
+GREEDY, TOPK = None, Sampling(seed=7, temperature=0.8, top_k=20, top_p=0.95)
+NUCLEUS = Sampling(seed=11, temperature=1.1, top_k=0, top_p=0.9, min_p=0.02)    # full-vocabulary rows
+
+
+# -- candidates over uneven slices -----------------------------------------------------------------------------------
+def slices(V: int, W: int):
+    return [block_bounds(V, W, r) for r in range(W)]
+
+
+@pytest.mark.parametrize("count", [1, 5, 128, 129, 200, 256, 640])
+def test_rank_top_merges_to_the_whole_vocabulary(count):
+    V, W = 640, 4
+    g = torch.Generator().manual_seed(3)
+    lg = torch.randn((6, V), generator=g).to(torch.bfloat16).float()
+    lg[:, ::7] = lg[:, :1]                                  # ties across slices: the lower id first
+    lg[2, 100:300] = float("-inf")                          # masked tokens stay real candidates
+    wide = P.widest(V, W)
+    assert wide == 256
+    parts = [P.rank_top(lg[:, lo:hi], count, lo, wide) for lo, hi in slices(V, W)]
+    assert len({k for _, _, k in parts}) == 1               # one k: the gather's sizes agree
+    k = parts[0][2]
+    packed = [torch.cat([v, i.view(torch.float32)], 1) for v, i, _ in parts]
+    vals, ids = VS.merge(torch.stack(packed), k, count)
+    want_v, want_i = P.top(lg, count)
+    assert torch.equal(ids, want_i.to(torch.int64))
+    assert torch.equal(vals, want_v)
+    assert int(ids.max()) < V                               # never a pad
+
+
+def test_engine_choose_drops_the_padding():
+    """``engine.choose``'s host merge (greedy and sampled) sees real ids only."""
+
+    V, W = 640, 4
+    lg = torch.randn((3, V), generator=torch.Generator().manual_seed(9)).to(torch.bfloat16).float()
+    parts = [P.rank_top(lg[:, lo:hi], 300, lo, P.widest(V, W)) for lo, hi in slices(V, W)]
+    tokens = torch.cat([i for _, i, _ in parts], 1).numpy().astype(np.int64)
+    assert (tokens == P.PAD).any()
+    real = tokens[0] != P.PAD
+    assert all(((t == P.PAD) == ~real).all() for t in tokens)      # the same columns in every row
+    assert real.sum() == V
+
+
+@pytest.fixture(scope="module")
+def ck4(tmp_path_factory):
+    return DF.ckpt(tmp_path_factory.mktemp("dsv41tp4ds"), **V4)
+
+
+@pytest.fixture(scope="module")
+def ranking(tmp_path_factory):
+    f = tmp_path_factory.mktemp("dsv41rk") / "rank.txt"
+    f.write_text("# test ranking\n" + " ".join(map(str, list(range(1, 640, 2)) + list(range(0, 640, 2)))) + "\n")
+    return str(f)
