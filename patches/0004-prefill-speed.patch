+        """``_layers``' blocks as a generator: it yields each sublayer's partial and resumes with its gathered
+        partials (``_layers`` exchanges at once; ``_run_overlap`` runs two half windows' exchanges behind each
+        other's compute)."""
+
         from . import l2pf as L2
 
         cfg, ops = self.cfg, self.hc
@@ -449,7 +626,7 @@ class Forward:
