--- /dev/null
+++ b/src/tensorfold/families/deepseek_v41/cuda/pipe.py
@@ -0,0 +1,516 @@
+# SPDX-License-Identifier: MIT
+"""Pipelined prompt reading (``TF_DSV41_PREFILL_PIPE=<rows>``, 0 = off): CED's encoder pass as an assembly line.
+
+Tensor parallelism splits every layer W ways, yet the indexer (32 heads), the compressor and the single KV head's
+projections, the mHC streams and the selections run in full on every rank, and every sublayer ends in an all-gather.
+Here rank s also holds encoder layers [B[s], B[s + 1]) at full width (a second copy, ~27 GB a rank at W = 4: the
+encoder half of the model) and one prompt's segments flow rank 0 -> W - 1: in pipeline round t, rank s runs segment
+t - s through its layers. The last stage ends at the decoder's first layer's site and compressor (``replay.encode``'s
+``upto``). Decode is unchanged: tensor parallel over the same stores.
+
+Every round ends in one all-gather (``_exchange``) carrying
+- each stage's output for the next: the streams before its last FFN post, that pending post (the gathered partial
+  and its coefficients: the next stage's first mHC boundary applies it, as the next block would in one process), the
+  latest index source's selection;
+- the rows the round wrote into the kv sources' compressed rows and index keys (every rank's stores get them: later
+  stages read them, decode reads them everywhere);
+- the last stage's CED stash rows (``replay.Stash``: the rows entering the decoder).
+Before the prompt's state is read (``finish_prompt``, a snapshot) the line drains (W - 1 rounds without a new
+segment) and each stage's layers' SWA rows and ratio-2 carries go to every rank (``drain``).
+
+Each stage writes its layers' rings, compressed rows, index keys and carries straight into the slot's own stores
+(``Stage.bind``). Exactness: a stage's layers run at world 1, so a pipelined prompt's bits are those of one rank
+computing the encoder (they equal the tensor-parallel bits in exact numerics: ``tests/test_dsv41_pipe.py``); its
+own session tag (``prefill_mm.tag_grid`` + 2).
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+from tensorfold.cuda.comm import fast_gather
+
+from . import blocks as B
+from . import numerics as N
+from . import replay as RP
+
+
+def rows_min() -> int:
+    """``TF_DSV41_PREFILL_PIPE``: the segment rows that start a pipeline (0: off)."""
+
+    v = int(os.environ.get("TF_DSV41_PREFILL_PIPE", "0").strip() or 0)
+    if v < 0:
+        raise ValueError(f"TF_DSV41_PREFILL_PIPE={v}: expected 0 (off) or the rows a segment that starts a pipeline")
+    return v
+
+
+def bounds_for(cfg, world: int) -> list[int]:
+    """Stage boundaries: the encoder layers [0, D) in W near-equal parts; the last stage also runs layer D's site
+    and compressor (``TF_DSV41_PREFILL_PIPE_BOUNDS``: explicit "0,5,10,15,21")."""
+
+    raw = os.environ.get("TF_DSV41_PREFILL_PIPE_BOUNDS", "").strip()
+    d = RP.decoder_start(cfg)
+    if raw:
+        b = [int(v) for v in raw.split(",")]
+    else:
+        b = [round(d * s / world) for s in range(world)] + [d + 1]
+    if len(b) != world + 1 or b[0] != 0 or b[-1] != d + 1 or any(b[i] >= b[i + 1] for i in range(world)):
+        raise ValueError(f"pipeline bounds {b}: {world} increasing stages from 0 to {d + 1}")
+    return b
+
+
+class Stage:
+    """This rank's encoder layers [lo, hi) at full width (one rank's ``Forward`` over them, no stores of its own:
+    ``bind`` points its slot at the prompt's slot's stores)."""
+
+    def __init__(self, fw, model_dir, lo: int, hi: int) -> None:
+        from . import weights as W
+        from .forward import Forward
+
+        cfg, dev = fw.cfg, fw.device
+        self.cfg, self.lo, self.hi = cfg, lo, hi
+        self.last = hi > RP.decoder_start(cfg)
+        ld = W.Loader(cfg, W.Shards(model_dir), 0, 1, dev)
+        layers = [ld.layer(L) for L in range(lo, min(hi, cfg.num_hidden_layers))]
+        if lo == 0:
+            embed = ld._dev(ld.src.rows("embed.weight", 0, cfg.vocab_size).to(torch.bfloat16))
+        else:
+            embed = torch.zeros((128, cfg.hidden_size), dtype=torch.bfloat16, device=dev)
+        tree = W.RankW(0, 1, 0, embed, layers, ld.native("norm.weight"), ld.x3("head", "col"), None, {})
+        if dev.type == "cuda":
+            from .csa2.backend import Triton
+
+            rows = max(fw.chunk, int(os.environ.get("TF_DSV41_PREFILL_ATTN_ROWS", "") or fw.chunk))
+            cs = Triton(rows, cfg.num_attention_heads, dev)
+        else:
+            from .csa2.twin import Twin
+
+            cs = Twin(cfg.qk_rope_head_dim, cfg.sliding_window)
+        self.fw = Forward(cfg, tree, csa2=cs, device=dev, limit=fw.limit, chunk=fw.chunk, pchunk=fw.pchunk,
+                          engram_rows={L: None for L in cfg.engram_layer_ids}, hasher=fw.hasher, slots=1,
+                          contiguous=False)
+        if self.fw.ring != fw.ring:
+            raise ValueError(f"pipeline stage ring {self.fw.ring} != the forward's {fw.ring}")
+        self.layers = [b.index for b in self.fw.blocks]
+        self.sources = [b.index for b in self.fw.blocks if b.mode == "full"]       # the kv sources it writes
+
+    def bind(self, slot, start: int) -> None:
+        """The stage's slot: the prompt's slot's stores for its layers (and the kv sources they read)."""
+
+        ss = self.fw.slots[0]
+        ss.swa = {L: slot.swa[L] for L in self.layers}
+        ss.comp, ss.ikeys, ss.carry = {}, {}, {}
+        for blk in self.fw.blocks:
+            if blk.ratio > 0:
+                src = blk.kv_source
+                ss.comp[src], ss.ikeys[src] = slot.comp[src], slot.ikeys[src]
+            if blk.index in slot.carry:
+                ss.carry[blk.index] = slot.carry[blk.index]
+        ss.pos, ss.tail, ss.taps, ss.pending = start, [], {}, None
+
+    def run(self, start: int, ids, x_in, sel_in, rows: dict, pend_in):
+        """One segment through this stage's layers; returns (streams, ctx). A stage before the last leaves its last
+        FFN post pending (``st.gathered``, ``st.coefs[st.cur]``); the last stops at the decoder's first site."""
+
+        from . import prefill_mm as PM
+        from . import prune as PR
+        from .forward import Pending, Streams
+
+        fw, cfg = self.fw, self.cfg
+        dev, D, ops, n = fw.device, cfg.hidden_size, fw.hc, len(ids)
+        ss = fw.slots[0]
+        if ss.pos != start:
+            raise RuntimeError(f"pipeline stage [{self.lo}, {self.hi}): a segment at {start}, the stage is at {ss.pos}")
+        if x_in is None:
+            x = fw.embed_rows(torch.tensor(list(ids), dtype=torch.long, device=dev)).repeat(1, cfg.hc_mult)
+            x = x.contiguous()
+        else:
+            x = x_in
+        first = ops.Coefs(n, dev) if pend_in is None else ops.Coefs(n, dev, pre=pend_in[1], post=pend_in[2],
+                                                                     comb=pend_in[3])
+        st = Streams(x, torch.empty((n, D), dtype=N.ACT, device=dev), ops.Scratch(n, dev, D),
+                     [first, ops.Coefs(n, dev)], 0, None if pend_in is None else pend_in[0])
+        wants = getattr(ops, "out_of_place", None)
+        if wants is not None and wants(n):
+            st.alt = torch.empty_like(x)
+        ctx = B.Context(fw.win_of(0, start, n), fw.tables, fw.csa2, fw.ring, ss, 0, fw.staging(n))
+        if sel_in is not None:
+            ctx.sel = sel_in
+        with PM.fast(fw.fast_prefill), PR.phase(True):
+            fw._layers(st, [ctx], rows, upto=RP.decoder_start(cfg) if self.last else None)
+        ss.pending = Pending(start, list(ids), ctx.proj, {})
+        fw.keep(0, n - 1)
+        return st, ctx
+
+
+class Pipeline:
+    """One prompt at a time through the stages (``SlotsForward.prefill`` routes a replay-mode segment here when
+    ``takes`` it). Every rank calls ``step`` / ``drain`` / ``abandon`` with the same arguments in the same order."""
+
+    def __init__(self, fw, model_dir, min_rows: int) -> None:
+        cfg = fw.cfg
+        self.fw, self.cfg, self.min_rows = fw, cfg, int(min_rows)
+        self.W, self.r = fw.world, fw.rank
+        self.bounds = bounds_for(cfg, self.W)
+        self.d = RP.decoder_start(cfg)
+        self.owner = {L: next(s for s in range(self.W) if self.bounds[s] <= L < self.bounds[s + 1])
+                      for L in range(self.bounds[-1])}
+        self.stage = Stage(fw, model_dir, self.bounds[self.r], self.bounds[self.r + 1])
+        self.srcs = sorted(L for L in cfg.kv_source_layer_ids if L < self.bounds[-1])
+        self.lookback = max(1, cfg.engram_max_ngram_size - 1)
+        self.slot = None
+        self.rounds = self.segments = 0
+        base = getattr(fw.comm, "base", fw.comm)     # the RoCE transport wraps NCCL (``base``)
+        on = (os.environ.get("TF_DSV41_PIPE_P2P", "1").strip() or "1") != "0"
+        self.p2p = getattr(base, "p2p", None) if on else None     # a stage's output straight to the next rank
+        self.trace = (os.environ.get("TF_DSV41_PIPE_TRACE", "0").strip() or "0") != "0"
+        self.prof = {"engram": 0.0, "stage": 0.0, "exchange": 0.0, "rounds": 0}
+        self.laid = None                # (ACT, ACC) the exchange is laid out for (``_layout`` on first use)
+        self._clear()
+
+    # -- the exchange's layout (every rank the same) -----------------------------------------------------------------
+    def _layout(self) -> None:
+        cfg, C, fw = self.cfg, self.fw.pchunk, self.fw
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        a_, c_ = (torch.empty((), dtype=t).element_size() for t in (N.ACT, N.ACC))       # activations, fp32 values
+        probe = _row_bytes(fw.csa2.rows(1, cfg.head_dim, fw.device)) + \
+            _row_bytes(fw.csa2.keys(1, cfg.index_head_dim, fw.device))           # a compressed row + its index key
+        self.rowb = {L: probe for L in self.srcs}
+        self.cap = {L: C // max(1, cfg.compress_ratio(L)) + 2 for L in self.srcs}
+        K = RP.KEEP
+        fwd = [("flags", 4), ("x", C * D4 * a_), ("sel", C * cfg.index_topk * 4), ("cnt", C * 4),
+               ("g", C * D * c_), ("pre", C * 4 * c_), ("post", C * 4 * c_), ("comb", C * 16 * c_)]
+        bc = [("sx", K * D4 * a_), ("so", K * D * a_), ("spre", K * 4 * c_), ("spost", K * 4 * c_),
+              ("scomb", K * 16 * c_)] + [(f"src{L}", self.cap[L] * self.rowb[L]) for L in self.srcs]
+        self.off = {}
+        size = {}
+        for region, parts in (("f", fwd), ("b", bc)):
+            a = 0
+            for name, n in parts:       # 16-byte aligned parts (fp64 views in exact numerics)
+                self.off[name] = (region, a, n)
+                a += -(-n // 16) * 16
+            size[region] = a
+        self.nf, self.nb = size["f"], size["b"]
+        dev = self.fw.device
+        self.buf = {"f": torch.zeros((self.nf,), dtype=torch.uint8, device=dev),
+                    "b": torch.zeros((self.nb,), dtype=torch.uint8, device=dev)}
+        self.recv_f = torch.empty(((1 if self.p2p is not None else self.W) * self.nf,), dtype=torch.uint8, device=dev)
+        self.recv_b = torch.empty((self.W * self.nb,), dtype=torch.uint8, device=dev)
+        self.laid = (N.ACT, N.ACC)
+
+    def _put(self, name: str, t: torch.Tensor) -> None:
+        region, a, n = self.off[name]
+        b = t.contiguous().view(-1).view(torch.uint8)
+        if b.numel() > n:
+            raise RuntimeError(f"pipeline exchange: {name} holds {n} bytes, not {b.numel()}")
+        self.buf[region][a:a + b.numel()].copy_(b)
+
+    def _get(self, got: torch.Tensor, name: str, dtype, shape) -> torch.Tensor:
+        _, a, _ = self.off[name]
+        n = int(torch.Size(shape).numel()) * torch.empty((), dtype=dtype).element_size()
+        return got[a:a + n].view(dtype).view(shape).clone()
+
+    def _clear(self) -> None:
+        self.slot = None
+        self.entered: list = []         # every round's new segment (start, ids) or None (drain), since the start
+        self.inp = None                 # (x, sel, pend) of this stage's next segment (stages after the first)
+        self.hist: list = []            # the prompt's ids from ``base`` on (Engram's lookback)
+        self.base = 0
+
+    # -- the protocol ------------------------------------------------------------------------------------------------
+    def takes(self, slot: int, n: int) -> bool:
+        return self.slot == slot or (self.min_rows > 0 and n >= self.min_rows)
+
+    def step(self, slot: int, start: int, ids) -> None:
+        """A new segment of ``slot``'s prompt enters the line (a pipeline for another slot drains first)."""
+
+        fw = self.fw
+        s = fw.slots[slot]
+        if self.slot is not None and self.slot != slot:
+            self.drain()
+        if self.slot is None:
+            if s.pos != start:
+                raise RuntimeError(f"slot {slot}: a pipelined segment at {start}, the slot is at {s.pos}")
+            self.slot = slot
+            self.stage.bind(s, start)
+            tail = list(s.tail)[-self.lookback:]
+            self.hist, self.base = tail + [], start - len(tail)
+        elif start != self.base + len(self.hist):
+            raise RuntimeError(f"slot {slot}: a pipelined segment at {start}, the line is at "
+                               f"{self.base + len(self.hist)}")
+        ids = tuple(int(t) for t in ids)
+        self.hist.extend(ids)
+        s.pos, s.pending, s.taps = start + len(ids), None, {}       # what ``keep`` leaves (the carry: ``drain``)
+        s.tail = (list(s.tail) + list(ids))[-self.lookback:]
+        self.segments += 1
+        self._round((start, ids))
+
+    def drain(self) -> None:
+        """Run the line empty, then every stage's SWA rows and carries to every rank: the slot's state is whole."""
+
+        if self.slot is None:
+            return
+        while any(e is not None for e in self.entered[-(self.W - 1):]):
+            self._round(None)
+        self._finals()
+        self._clear()
+        if self.trace:
+            print(f"[dsv41] {self.report()}", flush=True)
+            self.prof = {k: 0 * v for k, v in self.prof.items()}
+
+    def abandon(self, slot: int | None = None) -> None:
+        """The slot was reset or restored: the line's segments are dropped (every rank)."""
+
+        if self.slot is not None and (slot is None or slot == self.slot):
+            self._clear()
+
+    # -- a round -----------------------------------------------------------------------------------------------------
+    def _seg(self, t: int, s: int):
+        """The segment stage s runs in round t (or None)."""
+
+        i = t - s
+        return self.entered[i] if 0 <= i < len(self.entered) else None
+
+    def _engram(self, seg, L: int) -> torch.Tensor:
+        """Layer L's Engram rows of ``seg`` at full width: each rank's hash heads, gathered (a collective)."""
+
+        fw = self.fw
+        start, ids = seg
+        i = start - self.base
+        look = self.hist[max(0, i - self.lookback):i]
+        hashes = fw.hasher(torch.tensor(ids), lookback=torch.tensor(look, dtype=torch.long))
+        blk = next(b for b in fw.blocks if b.index == L)
+        mine = B.engram_rows(blk, hashes, fw.engram_rows[L], fw.rank, fw.world, fw.hasher.layout)
+        return fw.gather_cols(mine.to(fw.device))
+
+    def _rows_of(self, L: int, start: int, n: int) -> torch.Tensor:
+        """The compressed rows of kv source L a segment [start, start + n) can write (and the one before)."""
+
+        r = max(1, self.cfg.compress_ratio(L))
+        return torch.arange(max(0, start // r - 1), (start + n) // r, device=self.fw.device)
+
+    def _round(self, new) -> None:
+        fw, cfg, W, r = self.fw, self.cfg, self.W, self.r
+        if self.laid != (N.ACT, N.ACC):
+            self._layout()
+        self.entered.append(new)
+        t = len(self.entered) - 1
+        tick = self._tick()
+        rows = {}
+        for L in cfg.engram_layer_ids:
+            if L < self.bounds[-1]:
+                seg = self._seg(t, self.owner[L])
+                if seg is not None:
+                    full = self._engram(seg, L)
+                    if self.owner[L] == r:
+                        rows[L] = full
+        self._tock(tick, "engram")
+        tick = self._tick()
+        mine = self._seg(t, r)
+        if mine is not None:
+            start, ids = mine
+            n = len(ids)
+            x_in, sel_in, pend_in = self.inp if (r > 0 and self.inp is not None) else (None, None, None)
+            st, ctx = self.stage.run(start, ids, x_in, sel_in, rows, pend_in)
+            self._put("x", st.x.to(N.ACT))
+            self._put("flags", torch.tensor([int(ctx.sel is not None)], dtype=torch.int32, device=fw.device))
+            if ctx.sel is not None:
+                self._put("sel", ctx.sel[0].to(torch.int32))
+                self._put("cnt", ctx.sel[1].to(torch.int32))
+            acc = N.ACC
+            if not self.stage.last:
+                cf = st.coefs[st.cur]
+                self._put("g", st.gathered.to(acc))
+                self._put("pre", cf.pre.to(acc))
+                self._put("post", cf.post.to(acc))
+                self._put("comb", cf.comb.to(acc))
+            else:                       # the CED stash rows: the segment's last KEEP rows (all of a shorter one)
+                m = min(n, RP.KEEP)
+                cf = st.coefs[st.cur]
+                self._put("sx", st.x[n - m:].to(N.ACT))
+                self._put("so", st.out[n - m:].to(N.ACT))
+                self._put("spre", cf.pre[n - m:].to(acc))
+                self._put("spost", cf.post[n - m:].to(acc))
+                self._put("scomb", cf.comb[n - m:].to(acc))
+            slot = fw.slots[self.slot]
+            for L in self.stage.sources:
+                if L in self.srcs:
+                    self._put(f"src{L}", self._pack(slot, L, start, n))
+        self._tock(tick, "stage")
+        tick = self._tick()
+        prev = self._seg(t, r - 1) if r > 0 else None
+        if self.p2p is not None:        # the output to rank r + 1, rank r - 1's to this rank (one NCCL group)
+            sends = [(self.buf["f"], r + 1)] if (mine is not None and r < W - 1) else []
+            recvs = [(self.recv_f, r - 1)] if prev is not None else []
+            if sends or recvs:
+                self.p2p(sends, recvs)
+            fwd = self.recv_f
+        else:
+            fast_gather(fw.comm, self.buf["f"], self.recv_f)
+            fwd = self.recv_f.view(W, self.nf)[r - 1] if r > 0 else None
+        fast_gather(fw.comm, self.buf["b"], self.recv_b)
+        got = self.recv_b.view(W, self.nb)
+        self.rounds += 1
+        slot = fw.slots[self.slot]
+        for L in self.srcs:             # the kv sources' rows every other rank wrote this round
+            q = self.owner[L]
+            seg = self._seg(t, q)
+            if q != r and seg is not None:
+                self._unpack(slot, L, seg[0], len(seg[1]), got[q])
+        last = self._seg(t, W - 1)
+        if last is not None:
+            self._stash(last, got[W - 1])
+        if r > 0:                       # this stage's next segment: what rank r - 1 ran this round
+            self.inp = self._input(fwd, len(prev[1])) if prev is not None else None
+        self._tock(tick, "exchange")
+        self.prof["rounds"] += 1
+
+    def _tick(self):
+        if not self.trace:
+            return None
+        if self.fw.device.type == "cuda":
+            torch.cuda.synchronize()
+        import time
+
+        return time.perf_counter()
+
+    def _tock(self, tick, name: str) -> None:
+        if tick is None:
+            return
+        import time
+
+        if self.fw.device.type == "cuda":
+            torch.cuda.synchronize()
+        self.prof[name] += time.perf_counter() - tick
+
+    def report(self) -> str:
+        p = self.prof
+        n = max(1, p["rounds"])
+        return (f"pipeline rank {self.r}: {p['rounds']} rounds, a round: engram {1e3 * p['engram'] / n:.1f} ms, "
+                f"stage {1e3 * p['stage'] / n:.1f} ms, exchange {1e3 * p['exchange'] / n:.1f} ms")
+
+    def _input(self, g: torch.Tensor, n: int):
+        cfg = self.cfg
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        x = self._get(g, "x", N.ACT, (n, D4))
+        sel = None
+        if int(self._get(g, "flags", torch.int32, (1,)).item()):
+            sel = (self._get(g, "sel", torch.int32, (n, cfg.index_topk)), self._get(g, "cnt", torch.int32, (n,)))
+        acc = N.ACC
+        pend = (self._get(g, "g", acc, (1, n, D)), self._get(g, "pre", acc, (n, 4)), self._get(g, "post", acc, (n, 4)),
+                self._get(g, "comb", acc, (n, 16)))
+        return x, sel, pend
+
+    def _stash(self, seg, g: torch.Tensor) -> None:
+        """Every rank's CED stash after the last stage's segment (``replay.encode``'s extend and cut)."""
+
+        cfg, fw = self.cfg, self.fw
+        start, ids = seg
+        n = len(ids)
+        m = min(n, RP.KEEP)
+        D, D4 = cfg.hidden_size, cfg.hidden_size * cfg.hc_mult
+        acc = N.ACC
+        got = RP.Stash(start + n - m, self._get(g, "sx", N.ACT, (m, D4)), self._get(g, "so", N.ACT, (m, D)),
+                       self._get(g, "spre", acc, (m, 4)), self._get(g, "spost", acc, (m, 4)),
+                       self._get(g, "scomb", acc, (m, 16)), list(ids[n - m:]))
+        if m == n:
+            have = fw.stash.get(self.slot)
+            if have is None or have.hi != start:
+                have = RP.empty(fw, start)
+            fw.stash[self.slot] = have.extend(got)
+        else:
+            fw.stash[self.slot] = got
+
+    def _tensors(self, slot, L: int, rows: torch.Tensor):
+        """(row tensor, physical rows) of kv source L's compressed rows and index keys."""
+
+        out = []
+        for store in (slot.comp[L], slot.ikeys[L]):
+            for t in _ring_tensors(store):
+                out.append((t, store.phys(rows).to(t.device)))
+        return out
+
+    def _pack(self, slot, L: int, start: int, n: int) -> torch.Tensor:
+        rows = self._rows_of(L, start, n)
+        return torch.cat([t[p].contiguous().reshape(-1).view(torch.uint8) for t, p in self._tensors(slot, L, rows)])
+
+    def _unpack(self, slot, L: int, start: int, n: int, g: torch.Tensor) -> None:
+        rows = self._rows_of(L, start, n)
+        _, a, _ = self.off[f"src{L}"]
+        k = len(rows)
+        for t, p in self._tensors(slot, L, rows):
+            nb = k * t[0].numel() * t.element_size()
+            t[p] = g[a:a + nb].view(t.dtype).view((k,) + tuple(t.shape[1:]))
+            a += nb
+
+    # -- the drained line's state --------------------------------------------------------------------------------
+    def _finals(self) -> None:
+        """Each stage's layers' SWA rows of the prompt's last window and its kv sources' carries, to every rank."""
+
+        fw, W, r = self.fw, self.W, self.r
+        s = fw.slots[self.slot]
+        win = torch.arange(max(0, s.pos - self.cfg.sliding_window), s.pos, dtype=torch.long) % fw.ring
+        enc = [L for L in range(self.bounds[-1]) if L < self.d]
+        ring = {L: s.swa[L] for L in enc}
+        per = {}
+        for L in enc:
+            st = ring[L]
+            per[L] = sum(t[0].numel() * t.element_size() for t in _ring_tensors(st))
+        carries = sorted(L for L in s.carry if L < self.bounds[-1])
+        cb = {L: s.carry[L].numel() * s.carry[L].element_size() for L in carries}
+        mine = [L for L in enc if self.owner[L] == r]
+        size = max(sum(len(win) * per[L] for L in enc if self.owner[L] == q) +
+                   sum(cb[L] for L in carries if self.owner[L] == q) for q in range(W))
+        send = torch.zeros((max(16, -(-size // 16) * 16),), dtype=torch.uint8, device=fw.device)
+        a = 0
+        for L in mine:
+            for t in _ring_tensors(ring[L]):
+                b = t[win.to(t.device)].reshape(-1).view(torch.uint8)
+                send[a:a + b.numel()].copy_(b)
+                a += b.numel()
+        for L in carries:
+            if self.owner[L] == r:
+                b = s.carry[L].contiguous().reshape(-1).view(torch.uint8)
+                send[a:a + b.numel()].copy_(b)
+                a += b.numel()
+        recv = torch.empty((W * send.numel(),), dtype=torch.uint8, device=fw.device)
+        fast_gather(fw.comm, send, recv)
+        got = recv.view(W, -1)
+        for q in range(W):
+            if q == r:
+                continue
+            a = 0
+            for L in enc:
+                if self.owner[L] != q:
+                    continue
+                for t in _ring_tensors(ring[L]):
+                    w = t[0].numel() * t.element_size()
+                    nb = len(win) * w
+                    t[win.to(t.device)] = got[q, a:a + nb].view(t.dtype).view((len(win),) + tuple(t.shape[1:]))
+                    a += nb
+            for L in carries:
+                if self.owner[L] == q:
+                    c = s.carry[L]
+                    c.copy_(got[q, a:a + cb[L]].view(c.dtype).view(c.shape))
+                    a += cb[L]
+
+    def describe(self) -> str:
+        return (f"pipelined prompts from {self.min_rows} rows: stages {self.bounds} (this rank "
+                f"[{self.stage.lo}, {self.stage.hi}))")
+
+
+def _ring_tensors(store) -> list[torch.Tensor]:
+    """A ring store's row tensors (``Records``: values and scales; ``Floats``: data)."""
+
+    if hasattr(store, "values"):
+        return [store.values, store.scales]
+    return [store.data]
+
+
+def _row_bytes(store) -> int:
+    return sum(t[0].numel() * t.element_size() for t in _ring_tensors(store))
+
+
+__all__ = ["Pipeline", "Stage", "bounds_for", "rows_min"]
