+    def _run_overlap(self, sg: Seg, *, logits: bool, upto: int | None):
+        """A prefill segment as two halves A | B whose blocks interleave (A's sublayer, B's sublayer, ...): each
+        half's exchange runs on the exchange stream while the other half computes. B reads A's rows of a layer
+        (ring, compressed rows, index keys) after A wrote them, and its ratio-2 carry is A's last projection row
+        (``Context.prior``), so every row sees what it sees in one segment: the same bits (row invariance), the same
+        state after ``keep``."""
+
+        cfg, dev = self.cfg, self.device
+        s, n = self.slots[sg.slot], len(sg.ids)
+        if not 2 <= n <= self.pchunk:
+            raise ValueError(f"a segment holds 1 to {self.pchunk} rows, not {n}")
+        if sg.start != s.pos:
+            raise ValueError(f"slot {sg.slot}: a segment at {sg.start}, its position is {s.pos}")
+        if sg.start + n > self.limit:
+            raise ValueError(f"positions up to {sg.start + n} exceed this slot's {self.limit}")
+        h = n // 2
+        self.overlap_runs += 1
+        ids_t = self.ids_of([sg])
+        rows = self._engram_inputs([sg])
+        D, hcm, ops = cfg.hidden_size, cfg.hc_mult, self.hc
+        x = self.embed_rows(ids_t).repeat(1, hcm).contiguous()
+        wants = getattr(ops, "out_of_place", None)
+        sts, ctxs, gens, prior = [], [], [], None
+        for a, b in ((0, h), (h, n)):
+            m = b - a
+            st = Streams(x[a:b].contiguous(), torch.empty((m, D), dtype=N.ACT, device=dev), ops.Scratch(m, dev, D),
+                         [ops.Coefs(m, dev), ops.Coefs(m, dev)])
+            if wants is not None and wants(m):
+                st.alt = torch.empty_like(st.x)
+            c = B.Context(self.win_of(len(ctxs), sg.start + a, m), self.tables, self.csa2, self.ring, s, 0,
+                          self.staging(m))
+            c.prior, prior = prior, c
+            c.split = self.rowsplit
+            sts.append(st)
+            ctxs.append(c)
+            gens.append(self._blocks(st, [c], {L: v[a:b] for L, v in rows.items()}, upto=upto))
+        del x
+        from . import budget as BU
+
+        with BU.window([(0, n)], None, n=n, device=dev, prefill=True):
+            waits, live = [None, None], [True, True]
+            for i, g in enumerate(gens):             # A to its first exchange, then B (A's exchange runs meanwhile)
+                try:
+                    waits[i] = self.gather_start(next(g))
+                except StopIteration:
+                    live[i] = False
+            while any(live):
+                for i, g in enumerate(gens):
+                    if live[i]:
+                        try:
+                            waits[i] = self.gather_start(g.send(waits[i]()))
+                        except StopIteration:
+                            live[i] = False
+        if sts[0].cur != sts[1].cur:
+            raise RuntimeError("overlapped prefill: the halves ended at different sublayers")
+        cat = (lambda ts: torch.cat(ts) if ts[0] is not None else None)                         # noqa: E731
+        taps = {L: cat([t.taps[L] for t in sts]) for L in sts[0].taps}
+        s.pending = Pending(sg.start, list(sg.ids), {L: cat([c.proj[L] for c in ctxs]) for L in ctxs[0].proj}, taps)
+        coefs = [ops.Coefs(n, dev, pre=cat([t.coefs[k].pre for t in sts]), post=cat([t.coefs[k].post for t in sts]),
+                           comb=cat([t.coefs[k].comb for t in sts])) for k in (0, 1)]
+        g0, g1 = sts[0].gathered, sts[1].gathered
+        st = Streams(cat([t.x for t in sts]), cat([t.out for t in sts]), ops.Scratch(n, dev, D), coefs, sts[0].cur,
+                     None if g0 is None else torch.cat([g0, g1], 1), taps)
+        if upto is not None:
+            return st
+        return self._finish(st, logits)
+
     def _layers(self, st: "Streams", ctxs, rows, *, first: int = 0, upto: int | None = None,
                 entered: bool = False) -> None:
         """Blocks ``first``.. over the window's rows. ``upto``: stop at that block once its attention site is computed
         and its compressor has stored the rows (CED's encoder pass, ``replay``); ``entered``: the first block's site
         is already in ``st`` (the decoder replay starts at its attention)."""
 
+        g = self._blocks(st, ctxs, rows, first=first, upto=upto, entered=entered)
+        try:
+            part = next(g)
+            while True:
+                part = g.send(self.gather_partials(part))
+        except StopIteration:
+            pass
