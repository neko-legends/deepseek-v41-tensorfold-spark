+# SPDX-License-Identifier: MIT
+"""Pipeline ("assembly line") prefill prototype for DeepSeek-V4.1-Flash on four ranks: does prompt reading get faster
+when each rank runs a quarter of the encoder layers at full width instead of a quarter of every layer?
+
+Tensor parallelism splits every layer four ways: the indexer (32 heads), the compressor and the single KV head's
+projections, the mHC streams and the selection run in full on every rank, and every sublayer ends in an all-gather.
+Here rank s holds encoder layers [B[s], B[s + 1]) at full width (``Loader(.., 0, 1)``) and a prompt's chunks flow
+rank 0 -> 1 -> 2 -> 3: in round t, rank s runs chunk t - s. One all-gather a round carries each rank's output to the
+next (the chunk's streams after its last layer, the latest index source's selection) and the rows the round wrote
+into the kv sources' compressed stores (every later stage reads them; serving would also need them on every rank).
+
+Run as ``serve4.sh run tensorfold.families.deepseek_v41.cuda.ppbench --chunks 78`` (OUT/prompt.txt: the prompt's
+text, else random ids). Rank 0 writes /out/ppbench.json: seconds a round (steady state), the whole pipeline, each
+stage's compute, and the first ``--compare`` chunks' streams against the tensor-parallel forward (``upto`` 20).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+DEFAULT_BOUNDS = "0,5,10,15,21"
+
+
+def _gather_floats(comm, values: list[float]) -> list[list[float]]:
+    from tensorfold.cuda.comm import fast_gather
+
+    mine = torch.tensor(values, dtype=torch.float64, device="cuda")
+    got = torch.empty((comm.world * len(values),), dtype=torch.float64, device="cuda")
+    fast_gather(comm, mine, got)
+    return got.view(comm.world, -1).tolist()
+
+
+def prompt_ids(comm, model: Path, n: int, rank: int) -> list[int]:
+    """n token ids, the same on every rank: rank 0 tokenizes /out/prompt.txt (repeated to length), else random."""
+
+    from tensorfold.cuda.comm import fast_gather
+
+    buf = torch.zeros((n,), dtype=torch.int64, device="cuda")
+    if rank == 0:
+        p = Path("/out/prompt.txt")
+        if p.exists():
+            from tokenizers import Tokenizer
+
+            tok = Tokenizer.from_file(str(model / "tokenizer.json"))
+            ids = tok.encode(p.read_text()).ids
+            while len(ids) < n:
+                ids = ids + ids
+            buf.copy_(torch.tensor(ids[:n], dtype=torch.int64))
+        else:
+            g = torch.Generator().manual_seed(7)
+            buf.copy_(torch.randint(1000, 60000, (n,), generator=g))
+    got = torch.empty((comm.world * n,), dtype=torch.int64, device="cuda")
+    fast_gather(comm, buf, got)
+    return got[:n].tolist()
+
+
+class Stage:
+    """Rank s's layers [lo, hi) at full width (``hi`` 21: layer 20's attention site and compressor, as CED's encoder
+    pass ends), with one slot of contiguous stores (and the kv sources its layers read from earlier stages)."""
+
+    def __init__(self, eng, lo: int, hi: int) -> None:
+        from . import blocks as B
+        from . import weights as W
+        from .csa2.backend import Triton
+        from .forward import CHUNK, Forward, prefill_chunk
+
+        cfg, dev = eng.cfg, eng.device
+        self.cfg, self.lo, self.hi, self.last = cfg, lo, hi, hi > 20
+        ld = W.Loader(cfg, W.Shards(eng.model_dir), 0, 1, dev)
+        layers = [ld.layer(L) for L in range(lo, min(hi, cfg.num_hidden_layers))]
+        if lo == 0:
+            embed = ld._dev(ld.src.rows("embed.weight", 0, cfg.vocab_size).to(torch.bfloat16))
+        else:
+            embed = torch.zeros((128, cfg.hidden_size), dtype=torch.bfloat16, device=dev)
+        tree = W.RankW(0, 1, 0, embed, layers, ld.native("norm.weight"), ld.x3("head", "col"), None, {})
+        rows = int(os.environ.get("TF_DSV41_PREFILL_ATTN_ROWS", "") or CHUNK)
+        fw = eng.fw
+        self.fw = Forward(cfg, tree, csa2=Triton(max(CHUNK, rows), cfg.num_attention_heads, dev), device=dev,
+                          limit=eng.limit, chunk=CHUNK, pchunk=prefill_chunk(CHUNK),
+                          engram_rows={L: None for L in cfg.engram_layer_ids}, hasher=fw.hasher, slots=1)
+        s, cs = self.fw.slots[0], self.fw.csa2
+        for blk in self.fw.blocks:          # the kv sources an earlier stage computes: their rows arrive each round
+            src = blk.kv_source if blk.ratio > 0 else None
+            if src is not None and src not in s.comp:
+                n = eng.limit // blk.ratio + 1
+                s.comp[src] = cs.rows(n, cfg.head_dim, dev)
+                s.ikeys[src] = cs.keys(n, cfg.index_head_dim, dev)
+        self.sources = [b.index for b in self.fw.blocks if b.mode == "full"]       # the ones this stage writes
+        self.B = B
+
+    def run(self, k: int, C: int, ids: list[int], x_in, sel_in, eng_rows: dict, pend_in=None):
+        """Chunk k through this stage's layers. ``pend_in``: the previous stage's pending FFN post (gathered
+        partial [1, C, D] fp32, its coefficients pre / post / comb): the first block's mHC boundary applies it, as
+        the next block does in one process. Returns (streams, ctx): a stage before the last leaves its own last
+        FFN post pending (st.gathered, st.coefs[st.cur]); the last stops at layer 20's site."""
+
+        from . import numerics as N
+        from . import prefill_mm as PM
+        from . import prune as PR
+        from .forward import Pending, Streams
+
+        fw, cfg, B = self.fw, self.cfg, self.B
+        dev, D, ops = fw.device, cfg.hidden_size, fw.hc
+        start = k * C
+        if x_in is None:
+            ids_t = torch.tensor(ids[start:start + C], dtype=torch.long, device=dev)
+            x = fw.embed_rows(ids_t).repeat(1, cfg.hc_mult).contiguous()
+        else:
+            x = x_in
+        first = ops.Coefs(C, dev) if pend_in is None else ops.Coefs(C, dev, pre=pend_in[1], post=pend_in[2],
+                                                                     comb=pend_in[3])
+        st = Streams(x, torch.empty((C, D), dtype=N.ACT, device=dev), ops.Scratch(C, dev, D),
+                     [first, ops.Coefs(C, dev)], 0, None if pend_in is None else pend_in[0])
+        wants = getattr(ops, "out_of_place", None)
+        if wants is not None and wants(C):
+            st.alt = torch.empty_like(x)
+        ctx = B.Context(fw.win_of(0, start, C), fw.tables, fw.csa2, fw.ring, fw.slots[0], 0, fw.staging(C))
+        if sel_in is not None:
+            ctx.sel = sel_in
+        with PM.fast(fw.fast_prefill), PR.phase(True):
+            fw._layers(st, [ctx], eng_rows, upto=20 if self.last else None)
+        fw.slots[0].pending = Pending(start, list(ids[start:start + C]), ctx.proj, {})
+        fw.keep(0, C - 1)
+        return st, ctx
+
+    # -- the kv sources' rows a round wrote ---------------------------------------------------------------------------
+    def rows_of(self, L: int, start: int, C: int) -> torch.Tensor:
+        r = self.cfg.compress_ratio(L)
+        lo, hi = max(0, start // r - 1), (start + C) // r + 1
+        return torch.arange(lo, hi, device=self.fw.device)
+
+    def pack(self, L: int, start: int, C: int) -> torch.Tensor:
+        s = self.fw.slots[0]
+        rows = self.rows_of(L, start, C)
+        rec, keys = s.comp[L], s.ikeys[L]
+        p = rec.phys(rows).to(rec.values.device)
+        parts = [rec.values[p].reshape(-1).view(torch.uint8), rec.scales[p].reshape(-1).view(torch.uint8),
+                 keys.data[p].reshape(-1).view(torch.uint8)]
+        return torch.cat(parts)
+
+    def unpack(self, L: int, start: int, C: int, flat: torch.Tensor) -> None:
+        s = self.fw.slots[0]
+        if L not in s.comp:
+            return
+        rows = self.rows_of(L, start, C)
+        rec, keys = s.comp[L], s.ikeys[L]
+        p = rec.phys(rows).to(rec.values.device)
+        a = 0
+        for t in (rec.values, rec.scales, keys.data):
+            shape = (len(rows),) + tuple(t.shape[1:])
+            nb = len(rows) * t[0].numel() * t.element_size()
+            t[p] = flat[a:a + nb].view(t.dtype).view(shape)
+            a += nb
+
+    def payload_bytes(self, L: int, C: int) -> int:
+        s = self.fw.slots[0]
+        n = len(self.rows_of(L, 2 * C, C))
+        return n * sum(t[0].numel() * t.element_size() for t in (s.comp[L].values, s.comp[L].scales, s.ikeys[L].data))
+
+
+def engram_full(fw, ids: list[int], k: int, C: int, L: int) -> torch.Tensor:
+    """Layer L's Engram rows of chunk k at full width: every rank reads its hash heads, gathered in rank order (the
+    tensor-parallel forward's ``_engram_inputs`` for one chunk; a collective: every rank calls it)."""
+
+    from . import blocks as B
+
+    start = k * C
+    look = ids[max(0, start - (fw.cfg.engram_max_ngram_size - 1)):start]
+    hashes = fw.hasher(torch.tensor(ids[start:start + C]), lookback=torch.tensor(look, dtype=torch.long))
+    blk = next(b for b in fw.blocks if b.index == L)
+    mine = B.engram_rows(blk, hashes, fw.engram_rows[L], fw.rank, fw.world, fw.hasher.layout)
+    return fw.gather_cols(mine.to(fw.device))
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--rank", type=int, required=True)
+    ap.add_argument("--world", type=int, default=4)
+    ap.add_argument("--master", required=True)
+    ap.add_argument("--port", type=int, default=29561)
+    ap.add_argument("--chunks", type=int, default=78)
+    ap.add_argument("--rows", type=int, default=2048)
+    ap.add_argument("--compare", type=int, default=2)
+    ap.add_argument("--bounds", default=DEFAULT_BOUNDS)
+    ap.add_argument("--context", type=int, default=0)
+    ap.add_argument("--debug", action="store_true", help="chunk 0: every layer's streams against the TP forward's")
+    a = ap.parse_args(argv)
+    from tensorfold.cuda.comm import fast_gather
+
+    from .engine import Dsv41Engine
+    from .forward import Seg
+
+    P, C, r = a.chunks, a.rows, a.rank
+    ctx_len = a.context or (P * C + 4096)
+    t0 = time.time()
+    eng = Dsv41Engine(Path(a.model), rank=r, master=a.master, port=a.port, context=ctx_len, parallel=1,
+                      serving=False, world=a.world)
+    boot = time.time() - t0
+    cfg, comm, fw, W = eng.cfg, eng.comm, eng.fw, a.world
+    bounds = [int(v) for v in a.bounds.split(",")]
+    if len(bounds) != W + 1:
+        raise SystemExit(f"--bounds: {W + 1} layer boundaries")
+    owner = {L: next(s for s in range(W) if bounds[s] <= L < bounds[s + 1]) for L in range(bounds[-1])}
+    ids = prompt_ids(comm, Path(a.model), P * C, r)
+    log = (lambda *m: print(f"[ppbench r{r}]", *m, flush=True))                          # noqa: E731
+
+    # -- the tensor-parallel forward's first chunks (the reference streams, and its time a chunk) -----------------
+    ref, tp_s = [], []
+    tp_trace = {}
+    caught = {}                         # (tag, layer) -> chunk 0's selection (debug)
+    if a.debug:
+        from . import blocks as BK
+
+        _orig_select = BK._select
+
+        def _spy(blk, ctx, qi, w):
+            _orig_select(blk, ctx, qi, w)
+            if ctx.win.p0 == 0 and ctx.sel is not None:
+                caught[(_spy.tag, blk.index)] = ctx.sel[0].clone()
+
+        _spy.tag = "tp"
+        BK._select = _spy
+        fw.overlap = 0                  # one segment a chunk: whole selections
+    for k in range(a.compare):
+        torch.cuda.synchronize()
+        t1 = time.perf_counter()
+        if a.debug and k == 0:
+            fw.trace = {}
+        st = fw.run([Seg(0, k * C, tuple(ids[k * C:(k + 1) * C]))], logits=False, prefill=True, upto=20)
+        fw.keep(0, C - 1)
+        torch.cuda.synchronize()
+        tp_s.append(time.perf_counter() - t1)
+        ref.append((st.x.float().clone(), st.out.float().clone()))
+        if fw.trace is not None:
+            tp_trace = {L: v.float().clone() for L, v in fw.trace.items()}
+            fw.trace = None
+    log(f"TP chunks: {[round(v, 3) for v in tp_s]} s")
+
+    t1 = time.time()
+    stage = Stage(eng, bounds[r], bounds[r + 1])
+    load_s = time.time() - t1
+    torch.cuda.empty_cache()
+    log(f"stage layers [{bounds[r]}, {bounds[r + 1]}) loaded in {load_s:.1f} s; "
+        f"{torch.cuda.memory_allocated() / 2 ** 30:.1f} GiB allocated")
+
+    # the round's exchange: [streams | selection | counts | the kv sources' rows], the same size on every rank
+    D4 = cfg.hidden_size * cfg.hc_mult
+    srcs = sorted(L for L in cfg.kv_source_layer_ids if L < bounds[-1])
+    probe = {L: Stage.payload_bytes(stage, L, C) if L in stage.fw.slots[0].comp else 0 for L in srcs}
+    sizes = _gather_floats(comm, [float(probe[L]) for L in srcs])
+    pay = {L: int(max(row[i] for row in sizes)) for i, L in enumerate(srcs)}
+    D = cfg.hidden_size
+    nx, ns, nc = C * D4 * 2, C * cfg.index_topk * 4, C * 4
+    ng, npre, npost, ncomb = C * D * 4, C * 4 * 4, C * 4 * 4, C * 16 * 4          # the pending FFN post
+    npend = ng + npre + npost + ncomb
+    nb = nx + ns + nc + npend + sum(pay.values())
+    send = torch.zeros((nb,), dtype=torch.uint8, device="cuda")
+    recv = torch.empty((W * nb,), dtype=torch.uint8, device="cuda")
+    x_in = sel_in = pend_in = None
+    rounds, comp_s, outs = [], [], {}
+    dbg, dbg_sel, dbg_layers = [], [], []
+    torch.cuda.synchronize()
+    tp0 = time.perf_counter()
+    for t in range(P + W - 1):
+        ta = time.perf_counter()
+        k = t - r
+        er = {}
+        for L in cfg.engram_layer_ids:
+            if L < bounds[-1]:
+                kL = t - owner[L]
+                if 0 <= kL < P:
+                    full = engram_full(fw, ids, kL, C, L)
+                    if owner[L] == r:
+                        er[L] = full
+        send.zero_()
+        if 0 <= k < P:
+            tb = time.perf_counter()
+            if a.debug and k == 0:
+                stage.fw.trace = {}
+                if r > 0 and x_in is not None and bounds[r] - 1 in tp_trace:
+                    want = tp_trace[bounds[r] - 1].reshape(C, -1)
+                    y = x_in.clone()
+                    stage.fw.hc.post_only(x_in, y, pend_in[0], stage.fw.hc.Coefs(C, "cuda", pre=pend_in[1],
+                                                                                  post=pend_in[2], comb=pend_in[3]))
+                    dbg.append(float((y.float() - want).norm() / want.norm()))
+            if a.debug:
+                _spy.tag = "pp"
+                if k == 0 and r > 0:            # what arrived against the TP forward's (this rank's own TP run)
+                    src = max(L for L in cfg.index_source_layer_ids if L < bounds[r])
+                    tp_sel = caught.get(("tp", src))
+                    if tp_sel is not None and sel_in is not None:
+                        dbg_sel.append(float((sel_in[0] == tp_sel).float().mean()))
+                    srcs_kv = max(L for L in cfg.kv_source_layer_ids if L < bounds[r])
+                if k == 0 and r > 0 and srcs_kv in stage.fw.slots[0].comp:
+                    a_rec = fw.slots[0].comp[srcs_kv]
+                    b_rec = stage.fw.slots[0].comp[srcs_kv]
+                    rr = torch.arange(0, C // cfg.compress_ratio(srcs_kv), device="cuda")
+                    va = a_rec.values[a_rec.phys(rr).to("cuda")]
+                    vb = b_rec.values[b_rec.phys(rr).to("cuda")]
+                    dbg_sel.append(float((va == vb).float().mean()))
+                    dbg_sel.append(float((va != 0).float().mean()))
+                    dbg_sel.append(float((vb != 0).float().mean()))
+            st, ctx = stage.run(k, C, ids, x_in if r > 0 else None, sel_in if r > 0 else None, er,
+                                pend_in if r > 0 else None)
+            if a.debug and k == 0:
+                for (tag, L), v in list(caught.items()):
+                    if tag == "pp" and ("tp", L) in caught:
+                        dbg_sel.append(float(L))
+                        dbg_sel.append(float((v == caught[("tp", L)]).float().mean()))
+            if stage.fw.trace is not None:
+                for L in sorted(stage.fw.trace):
+                    if L in tp_trace:
+                        g, w = stage.fw.trace[L].float(), tp_trace[L]
+                        dbg_layers.append((L, float((g - w).norm() / w.norm())))
+                stage.fw.trace = None
+            send[:nx].copy_(st.x.contiguous().view(-1).view(torch.uint8))
+            if ctx.sel is not None:
+                sel, cnt = ctx.sel
+                send[nx:nx + ns].copy_(sel.to(torch.int32).contiguous().view(-1).view(torch.uint8))
+                send[nx + ns:nx + ns + nc].copy_(cnt.to(torch.int32).contiguous().view(-1).view(torch.uint8))
+            if not stage.last:
+                cf = st.coefs[st.cur]
+                o = nx + ns + nc
+                for t_, n_ in ((st.gathered, ng), (cf.pre, npre), (cf.post, npost), (cf.comb, ncomb)):
+                    send[o:o + n_].copy_(t_.float().contiguous().view(-1).view(torch.uint8))
+                    o += n_
+            off = nx + ns + nc + npend
+            for L in srcs:
+                if L in stage.sources:
+                    p = stage.pack(L, k * C, C)
+                    send[off:off + p.numel()].copy_(p)
+                off += pay[L]
+            if stage.last and k < a.compare:
+                outs[k] = (st.x.float().clone(), st.out.float().clone())
+            torch.cuda.synchronize()
+            comp_s.append(time.perf_counter() - tb)
+        fast_gather(comm, send, recv)
+        got = recv.view(W, nb)
+        # the kv sources' rows from every rank's round (chunk t - q on rank q)
+        off = nx + ns + nc + npend
+        for L in srcs:
+            q = owner[L]
+            kq = t - q
+            if q != r and 0 <= kq < P:
+                stage.unpack(L, kq * C, C, got[q, off:off + pay[L]])
+            off += pay[L]
+        if r > 0 and 0 <= t - r + 1 < P:          # next round's input: the previous rank's output of this round
+            prev = got[r - 1]
+            x_in = prev[:nx].view(torch.bfloat16).view(C, D4).clone()
+            sel = prev[nx:nx + ns].view(torch.int32).view(C, cfg.index_topk).clone()
+            cnt = prev[nx + ns:nx + ns + nc].view(torch.int32).clone()
+            sel_in = (sel, cnt)
+            o = nx + ns + nc
+            pend = []
+            for shape, n_ in (((1, C, D), ng), ((C, 4), npre), ((C, 4), npost), ((C, 16), ncomb)):
+                pend.append(prev[o:o + n_].view(torch.float32).view(shape).clone())
+                o += n_
+            pend_in = tuple(pend)
+        torch.cuda.synchronize()
+        rounds.append(time.perf_counter() - ta)
+    total = time.perf_counter() - tp0
+
+    # -- report ---------------------------------------------------------------------------------------------------
+    cmp = []
+    if stage.last:
+        for k, (x, o) in sorted(outs.items()):
+            rx, ro = ref[k]
+            cmp.append({"chunk": k, "x_rel": float((x - rx).norm() / rx.norm()),
+                        "out_rel": float((o - ro).norm() / ro.norm()), "x_max": float((x - rx).abs().max())})
+    comp_med = sorted(comp_s)[len(comp_s) // 2] if comp_s else 0.0
+    stats = _gather_floats(comm, [comp_med, max(comp_s or [0.0]), load_s, boot])
+    flat = [v for c in cmp for v in (c["x_rel"], c["out_rel"])] + [0.0] * (2 * a.compare - 2 * len(cmp))
+    cmps = _gather_floats(comm, flat[:2 * a.compare] or [0.0])
+    if a.debug and tp_trace:            # a noise yardstick: the TP forward against itself with its exact kernels
+        fw.reset(0)
+        fw.fast_prefill, fast = False, fw.fast_prefill
+        fw.trace = {}
+        fw.run([Seg(0, 0, tuple(ids[:C]))], logits=False, prefill=True, upto=20)
+        fw.keep(0, C - 1)
+        alt = {L: v.float() for L, v in fw.trace.items()}
+        fw.trace, fw.fast_prefill = None, fast
+        noise = [(L, round(float((alt[L] - tp_trace[L]).norm() / tp_trace[L].norm()), 5)) for L in sorted(alt)
+                 if L in tp_trace]
+        print(f"[ppbench r{r}] debug noise: TP fast vs TP exact kernels, chunk 0, (L, rel): {noise}", flush=True)
+    if a.debug:
+        print(f"[ppbench r{r}] debug chunk 0: input vs TP layer {bounds[r] - 1}: {dbg}; layers (L, rel err): "
+              f"{[(L, round(e, 5)) for L, e in dbg_layers]}; selection/rows checks {[round(v, 4) for v in dbg_sel]}",
+              flush=True)
+    if r == 0:
+        steady = sorted(rounds[W:P - 1])
+        rep = {"chunks": P, "rows": C, "bounds": bounds, "total_s": total, "round_s": rounds,
+               "round_median_s": steady[len(steady) // 2] if steady else None,
+               "stage_compute_median_s": [s[0] for s in stats], "stage_compute_max_s": [s[1] for s in stats],
+               "stage_load_s": [s[2] for s in stats], "boot_s": boot, "tp_chunk_s": tp_s,
+               "compare_last_stage": cmps[W - 1], "exchange_bytes_per_rank": nb}
+        Path("/out/ppbench.json").write_text(json.dumps(rep, indent=1))
+        log(f"pipeline {P} chunks x {C} rows: {total:.1f} s; round median {rep['round_median_s']:.3f} s; "
+            f"stage compute medians {[round(s[0], 3) for s in stats]}; TP chunks {[round(v, 3) for v in tp_s]}; "
+            f"compare (x_rel, out_rel per chunk) {[round(v, 5) for v in cmps[W - 1]]}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
