+    def gather_start(self, partial: torch.Tensor):
+        """``gather_partials`` started on the exchange stream (``TF_DSV41_PREFILL_OVERLAP``): returns ``wait()``, which
+        makes the current stream wait for it and returns what ``gather_partials`` would have (the same bits: the same
+        bf16 send buffer, the same all-gather). Only a prefill segment's bf16 exchange runs behind; anything else
+        exchanges at once (``wait`` then just returns it)."""
+
+        world = self.world
+        if not (self.xstream is not None and world > 1 and self.exchange_bf16 and N.KIT_ROUNDING and
+                partial.dtype == torch.float32 and partial.shape[0] > self.chunk):
+            got = self.gather_partials(partial)
+            return lambda: got
+        if self.gather_bf16:
+            half = partial.contiguous().to(torch.bfloat16)
+        else:
+            half = P.kit_partial(partial).contiguous().to(torch.bfloat16)
+        recv = torch.empty((world * half.numel(),), dtype=half.dtype, device=half.device)
+        cur = torch.cuda.current_stream(half.device)
+        ready = torch.cuda.Event()
+        ready.record(cur)
+        xs = self.xstream
+        with torch.cuda.stream(xs):
+            xs.wait_event(ready)
+            fast_gather(self.comm, half.view(-1), recv)
+            done = torch.cuda.Event()
+            done.record(xs)
+        half.record_stream(xs)          # the allocator keeps them until the exchange stream is past them
+        recv.record_stream(xs)
+        shape, widen = partial.shape, not self.gather_bf16
+
+        def wait() -> torch.Tensor:
+            cur.wait_event(done)
+            got = recv.view(world, *shape)
+            return got.to(torch.float32) if widen else got
+
+        return wait
+
