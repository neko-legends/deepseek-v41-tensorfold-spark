diff --git a/tests/test_dsv41_tp4.py b/tests/test_dsv41_tp4.py
new file mode 100644
index 0000000..adcd61a
--- /dev/null
+++ b/tests/test_dsv41_tp4.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: MIT
+"""DeepSeek-V4.1-Flash on four ranks (threads, CPU): the uneven 128-block partitions and the forward.
+
+A fake checkpoint shaped so every TP4 rule is exercised: 4 heads / 4 o_groups (one a rank), routed and shared
+experts 640 wide (5 Hadamard blocks: 256 / 128 / 128 / 128 a rank, the real model's 640 / 640 / 512 / 512 pattern)
+and a 640-token vocabulary (5 blocks: uneven head / embedding slices). Checks:
+
+- ``block_bounds``: equal parts wherever an even split exists (every TP2 shape stays bit-identical to before),
+  uneven whole blocks otherwise, the real model's TP4 widths;
+- a rank's sliced EXL3 matrices are exactly the full matrix's blocks;
+- world 4 == one rank in exact numerics; the four ranks hold identical streams bit for bit (kit numerics);
+- TP4 row invariance (a prompt as 1-row windows == one prefill window), and greedy over uneven vocabulary slices;
+- Engram rows from ``of4`` packed shards == rows held in memory.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+TP4 = dict(num_attention_heads=4, o_groups=4, moe_intermediate_size=640, vocab_size=640)
+IDS = torch.randint(0, 640, (29,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+def test_block_bounds():
+    bb = W.block_bounds
+    assert [bb(2304, 2, r) for r in range(2)] == [(0, 1152), (1152, 2304)]          # TP2: unchanged
+    assert [bb(129280, 2, r) for r in range(2)] == [(0, 64640), (64640, 129280)]
+    assert [bb(2304, 4, r)[1] - bb(2304, 4, r)[0] for r in range(4)] == [640, 640, 512, 512]
+    v = [bb(129280, 4, r) for r in range(4)]
+    assert [hi - lo for lo, hi in v] == [32384, 32384, 32256, 32256]
+    assert v[0][0] == 0 and v[-1][1] == 129280 and all(v[i][1] == v[i + 1][0] for i in range(3))
+    assert [bb(32768, 4, r) for r in range(4)] == [(r * 8192, (r + 1) * 8192) for r in range(4)]
+    with pytest.raises(ValueError):
+        bb(576, 4, 0)                                   # not whole blocks
+    with pytest.raises(ValueError):
+        bb(256, 4, 0)                                   # fewer blocks than ranks
+    assert X.Geometry(world=4, local=640).width == 640
+    with pytest.raises(ValueError):
+        X.Geometry(world=4)                             # 2304 has no even split into 4 x whole blocks
+    with pytest.raises(ValueError):
+        X.Geometry(world=4, local=576)
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41tp4"), **TP4)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build(ckpt, rank=0, world=1, comm=None, chunk=8, rows=None) -> FW.Forward:
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world).load(token_map=tmap)
+    rows = rows or {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def run(fw, ids, windows):
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(ids[a:a + n]))
+        a += n
+    return torch.cat(out)
+
+
+def tp4(ckpt, fn, rows=None, **kw):
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = [build(ckpt, r, 4, comms[r], rows=rows(r) if rows else None, **kw) for r in range(4)]
+    return fws, pair.run([lambda f=f: fn(f) for f in fws])
+
+
+def test_slices_are_the_full_matrix_blocks(ckpt):
+    root, cfg, _ = ckpt
+    full = W.Loader(cfg, W.Shards(root), 0, 1).load(2)
+    parts = [W.Loader(cfg, W.Shards(root), r, 4).load(2) for r in range(4)]
+    widths = [p.layers[1].moe.w1.trellis.shape[2] * 16 for p in parts]
+    assert widths == [256, 128, 128, 128]
+    for name, dim in (("w1", 2), ("w3", 2), ("w2", 1)):
+        joined = torch.cat([getattr(p.layers[1].moe, name).trellis for p in parts], dim)
+        assert torch.equal(joined, getattr(full.layers[1].moe, name).trellis), name
+    head = torch.cat([p.head.trellis for p in parts], 1)
+    assert torch.equal(head, full.head.trellis)
+    assert torch.equal(torch.cat([p.embed for p in parts]), full.embed)
+    assert [p.vocab_lo for p in parts] == [0, 256, 384, 512]
+
