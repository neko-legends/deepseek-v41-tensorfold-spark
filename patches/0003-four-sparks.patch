+def test_tp4_ranks_agree_bit_for_bit(ckpt):
+    def go(f):
+        f.trace = {}
+        run(f, IDS, [8, 8, 8, 5])
+        return {k: v.clone() for k, v in f.trace.items()}
+
+    _, traces = tp4(ckpt, go)
+    assert set(traces[0]) == set(range(8))
+    for t in traces[1:]:
+        for L in traces[0]:
+            assert torch.equal(traces[0][L], t[L]), L
