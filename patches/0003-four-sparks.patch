+def carry_of(ctx: Context, L: int) -> torch.Tensor:
+    """Layer L's ratio-2 carry for a segment: the slot's (``keep`` stored it), or the last projection row of the
+    segment just before (``Context.prior``), in the carry's dtype (what ``keep`` would store)."""
+
+    c = ctx.slot.carry[L]
+    if ctx.prior is None:
+        return c
+    return ctx.prior.proj[L][-1].to(c.dtype)
+
