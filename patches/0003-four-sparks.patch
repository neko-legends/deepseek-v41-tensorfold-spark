index 0000000000000000000000000000000000000000..4f65d73d99b64569e165412ae60724e5eacf59ce
--- /dev/null
+++ b/tests/test_dsv41_pipe.py
@@ -0,0 +1,164 @@
+# SPDX-License-Identifier: MIT
+"""Pipelined prompt reading (``pipe.py``, ``TF_DSV41_PREFILL_PIPE``) on threads, the CPU twin, exact numerics:
+the stages run world-1 layers, which equal the tensor-parallel ones in exact numerics, so a pipelined prompt must
+leave the very state the tensor-parallel encoder pass leaves:
+
+(to the last bits of float64 sums: stage layers add a whole layer's terms where ranks add partials in rank order)
+
+- the replayed prompt's verify rows' logits (``finish_prompt`` drains the line, the decoder replays the stash);
+- the encoder state: every encoder layer's SWA ring, every kv source's compressed rows and index keys, the carries;
+- a snapshot in the middle of a prompt (the line drains first) and the rest of the prompt after it;
+- W = 2 and W = 4 (two stages with layers before the decoder, the last stage ending at its first site).
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+import test_dsv41_replay as RT  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import pipe as PP  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import topology  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.protocol import Piece  # noqa: E402
+
+SHAPES4 = {**RT.SHAPES, "o_groups": 4, "moe_intermediate_size": 640, "vocab_size": 640}     # four 128-blocks
+LONG = [int(t) for t in np.random.default_rng(43).integers(3, 256, size=200)]
+
+
+def checkpoint(tmp_path_factory, shapes):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41pp"), **shapes)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg), topology.load(root)
+
+
+def encoder_state(fw, slot: int = 0) -> dict:
+    """What a later read sees: every encoder layer's SWA rows of the last window, every kv source's compressed rows
+    and index keys up to the position (``RT.encoder_state`` without the ring rows no read reaches)."""
+
+    s, d = fw.slots[slot], RT.RP.decoder_start(fw.cfg)
+    win = torch.arange(max(0, s.pos - fw.cfg.sliding_window), s.pos) % fw.ring
+    out = {"pos": torch.tensor(s.pos), "tail": torch.tensor(list(s.tail))}
+    for L, ring in s.swa.items():
+        if L < d:
+            out[f"ring.{L}"] = ring.read(win)
+    for L, st in s.comp.items():
+        n = (s.pos + 1) // next(b.ratio for b in fw.blocks if b.index == L)
+        out[f"comp.{L}"] = st.read(torch.arange(n))
+        out[f"keys.{L}"] = s.ikeys[L].read(torch.arange(n))
+    sh = fw.stash.get(slot)
+    if sh is not None:
+        out.update({f"stash.{k}": torch.as_tensor(v) for k, v in sh.arrays().items()})
+    return out
+
+
+def carries(fw, slot: int = 0) -> dict:
+    return {f"carry.{L}": c.clone() for L, c in fw.slots[slot].carry.items()}
+
+
+class Mailbox:
+    """Point to point for the thread ranks (``NCCL.p2p``'s contract): a send is queued for its peer, a receive waits
+    for the sender's next tensor (a missing or extra call on either side hangs or fails, as with NCCL)."""
+
+    def __init__(self, world: int) -> None:
+        import queue
+
+        self.q = {(a, b): queue.Queue() for a in range(world) for b in range(world)}
+
+    def bind(self, comm) -> None:
+        def p2p(sends, recvs, rank=comm.rank):
+            for t, peer in sends:
+                self.q[(rank, int(peer))].put(t.detach().clone())
+            for t, peer in recvs:
+                got = self.q[(int(peer), rank)].get(timeout=60)
+                t.view(-1).copy_(got.view(-1))
+
+        comm.p2p = p2p
+
+
+def run(ck, world: int, pipe_rows: int, flow, p2p: bool = False):
+    pair = FK.ThreadPair(world)
+    comms = pair.comms()
+    if p2p:
+        box = Mailbox(world)
+        for c in comms:
+            box.bind(c)
+    fws = [RT.build(ck, pchunk=64, rank=r, world=world, comm=comms[r]) for r in range(world)]
+    if pipe_rows:
+        for f in fws:
+            f.pipe = PP.Pipeline(f, ck[0], pipe_rows)
+            assert (f.pipe.p2p is not None) == p2p
+
+    with N.exact():                     # one switch around every thread (it is the process's numerics)
+        return fws, pair.run([lambda f=f: flow(f) for f in fws])
+
+
+def whole(f):
+    logits = RT.prompt(f, LONG, "replay")
+    return logits, {**encoder_state(f), **carries(f)}
+
+
+def with_snapshot(f):
+    """A snapshot after the first 130 tokens (the line drains), then the rest: the snapshot and the end state."""
+
+    n = len(LONG)
+    f.prefill([Piece(0, 0, tuple(LONG[:130]))], mode="replay")
+    snap = f.snapshot(0)
+    f.prefill([Piece(0, 130, tuple(LONG[130:n - 1]))], mode="replay")
+    f.finish_prompt(0, n - 1, tuple(LONG[max(0, n - RT.RP.REPLAY):n - 1]), mode="replay")
+    logits = torch.cat([f.step([LONG[-1]]), f.step([7])])
+    return logits, {**encoder_state(f), **carries(f), **{f"snap.{k}": torch.as_tensor(v)
+                                                              for k, v in snap.arrays.items()}}
+
+
+def close(x, y) -> bool:
+    """Equal, or (float64 values) equal to the last bits a different sum order leaves (tests/test_dsv41_tp4.py:
+    one rank == four in exact numerics to 1e-10)."""
+
+    if torch.equal(x, y):
+        return True
+    if x.shape != y.shape or not x.is_floating_point():
+        return False
+    return float((x.double() - y.double()).abs().max()) <= 1e-10 * max(1.0, float(x.double().abs().max()))
+
+
+def same(a, b):
+    (la, sa), (lb, sb) = a, b
+    assert close(la, lb)
+    assert set(sa) == set(sb)
+    for k in sa:
+        assert close(sa[k], sb[k]), k
+
+
+@pytest.mark.parametrize("world,shapes,p2p", [(2, RT.SHAPES, False), (4, SHAPES4, False), (4, SHAPES4, True)])
+def test_pipelined_prompt_equals_tensor_parallel(tmp_path_factory, world, shapes, p2p):
+    ck = checkpoint(tmp_path_factory, shapes)
+    _, want = run(ck, world, 0, whole)
+    fws, got = run(ck, world, 16, whole, p2p=p2p)
+    assert all(f.pipe.segments == 4 and f.pipe.slot is None for f in fws)     # 64 + 64 + 64 + 7 rows, drained
+    assert fws[0].pipe.bounds[-1] == RT.RP.decoder_start(fws[0].cfg) + 1
+    for w, g in zip(want, got):
+        same(w, g)
+
+
+def test_pipelined_prompt_snapshot_mid_prompt(tmp_path_factory):
+    ck = checkpoint(tmp_path_factory, RT.SHAPES)
+    _, want = run(ck, 2, 0, with_snapshot)
+    fws, got = run(ck, 2, 16, with_snapshot)
+    assert all(f.pipe.segments > 0 for f in fws)
+    for w, g in zip(want, got):
+        same(w, g)
+
+
+def test_bounds():
+    cfg = Config.from_dict(json.loads(json.dumps(FK.TEXT)))         # compress ratios [0, 0, 2, 2, 1, ...]: D = 4
+    assert PP.bounds_for(cfg, 2) == [0, 2, 5]
+    assert PP.bounds_for(cfg, 4) == [0, 1, 2, 3, 5]
