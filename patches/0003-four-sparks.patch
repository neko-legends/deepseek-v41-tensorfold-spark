+class Fanout:
+    """Rank 0's plan to every follower (the batcher's ``Link``)."""
+
+    def __init__(self, world: int) -> None:
+        self.q = [queue.Queue() for _ in range(world)]
+
+    def sender(self):
+        outer = self
+
+        class S:
+            def send(self, plan):
+                for q in outer.q[1:]:
+                    q.put(list(plan))
+
+        return S()
+
+    def receiver(self, r: int):
+        q = self.q[r]
+
+        class R:
+            def recv(self):
+                return q.get(timeout=300)
+
+        return R()
+
+
+def test_four_ranks_trimmed_head_draft_alike(ck4, ranking, monkeypatch):
+    for k, v in {"TF_DSV41_DRAFT_HEAD": "trim:64", "TF_DSV41_DRAFT_VOCAB_FALLBACK": "off",
+                 "TF_DSV41_DRAFT_VOCAB": ranking}.items():
+        monkeypatch.setenv(k, v)
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = pair.run([lambda r=r: DF.forward(ck4, slots=3, rank=r, world=4, comm=comms[r]) for r in range(4)])
+    heads = [f.drafter.head for f in fws]
+    assert [len(h.ids) for h in heads] == [64] * 4
+    for (lo, hi), h in zip(slices(640, 4), heads):
+        assert lo <= int(h.ids.min()) and int(h.ids.max()) < hi      # each rank lists its own slice
+    link = Fanout(4)
+    bs = [DF.batcher(ck4, fws[0], n=3, link=link.sender(), rank=0)]
+    bs += [DF.batcher(ck4, fws[r], n=3, link=link.receiver(r), rank=r) for r in range(1, 4)]
+    ts = [threading.Thread(target=b.follow, daemon=True) for b in bs[1:]]
+    for t in ts:
+        t.start()
+    got = DF.run(bs[0], [Job(list(PROMPTS[0]), 10, GREEDY), Job(list(PROMPTS[1]), 10, TOPK),
+                         Job(list(PROMPTS[2]), 10, NUCLEUS)])
+    bs[0].send_stop()
+    for t in ts:
+        t.join(timeout=300)
+        assert not t.is_alive()
+    assert all(len(g) == 10 for g in got)
+    assert all(0 <= t < 640 for g in got for t in g)
+
