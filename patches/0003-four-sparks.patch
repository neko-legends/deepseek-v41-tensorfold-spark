+# SPDX-License-Identifier: MIT
+"""Overlapped prefill (``TF_DSV41_PREFILL_OVERLAP``, ``Forward._run_overlap``) on threads, the CPU twin: a prefill
+segment run as two interleaved halves is the one-segment run bit for bit.
+
+- TP4 (uneven expert and vocabulary splits): a prefill's logits, the state ``keep`` leaves (the next verify rows'
+  logits) and the ratio-2 carries, even and odd segments;
+- TP2, CED replay with a long prompt (160 tokens, segments of 64 and a 31-row tail): the replayed prompt's logits
+  and the encoder state (rings, compressed rows, index keys) after it.
+
+On the CPU the exchanges run at once (no exchange stream): these tests pin the split itself (contexts, the carry
+from the first half, the stitched streams, ``Pending``); the GPU path differs only in where the same all-gather runs.
+"""
+
+from __future__ import annotations
+
+import json
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+import test_dsv41_replay as RT  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+TP4 = dict(num_attention_heads=4, o_groups=4, moe_intermediate_size=640, vocab_size=640)
+IDS = [int(t) for t in np.random.default_rng(7).integers(0, 640, size=41)]
+
+
+@pytest.fixture(scope="module")
+def ck4(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41ov"), **TP4)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def build4(ck, rank, comm, pchunk):
+    root, cfg, table = ck
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, 4).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=256,
+                      chunk=4, pchunk=pchunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def tp4_prompt(ck, cuts, overlap, monkeypatch, split=0):
+    monkeypatch.setenv("TF_DSV41_PREFILL_OVERLAP", str(overlap))
+    monkeypatch.setenv("TF_DSV41_INDEX_SPLIT", str(split))
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = [build4(ck, r, comms[r], pchunk=32) for r in range(4)]
+    monkeypatch.delenv("TF_DSV41_PREFILL_OVERLAP")
+    monkeypatch.delenv("TF_DSV41_INDEX_SPLIT")
+
+    def go(f):
+        outs, a = [], 0
+        for b in cuts:
+            outs.append(f.run([FW.Seg(0, a, tuple(IDS[a:b]))], prefill=True))
+            f.keep(0, b - a - 1)
+            a = b
+        outs += [f.step([5]), f.step([9, 11, 3])]
+        carry = {L: c.clone() for L, c in f.slot.carry.items()}
+        return outs, carry
+
+    return fws, pair.run([lambda f=f: go(f) for f in fws])
+
+
+@pytest.mark.parametrize("cuts", [[32, 41], [7, 30, 41]])
+@pytest.mark.parametrize("overlap,split", [(2, 0), (0, 4), (2, 4)])
+def test_tp4_overlap_equals_one_segment(ck4, cuts, overlap, split, monkeypatch):
+    _, want = tp4_prompt(ck4, cuts, 0, monkeypatch)
+    fws, got = tp4_prompt(ck4, cuts, overlap, monkeypatch, split)
+    assert all(f.overlap == overlap and f.overlap_runs == (len(cuts) if overlap else 0) for f in fws)
+    if split:
+        assert all(f.rowsplit is not None and f.rowsplit.calls > 0 for f in fws)
+    for (wo, wc), (go, gc) in zip(want, got):
+        assert len(wo) == len(go)
+        for x, y in zip(wo, go):
+            assert torch.equal(x, y)
+        assert set(wc) == set(gc) and wc
+        for L in wc:
+            assert torch.equal(wc[L], gc[L]), L
+
+
+def replay_prompt(ck, overlap, monkeypatch, split=0):
+    monkeypatch.setenv("TF_DSV41_PREFILL_OVERLAP", str(overlap))
+    monkeypatch.setenv("TF_DSV41_INDEX_SPLIT", str(split))
+    pair = FK.ThreadPair(2)
+    comms = pair.comms()
+    fws = [RT.build(ck, pchunk=64, rank=r, world=2, comm=comms[r]) for r in range(2)]
+    monkeypatch.delenv("TF_DSV41_PREFILL_OVERLAP")
+    monkeypatch.delenv("TF_DSV41_INDEX_SPLIT")
+    got = pair.run([lambda f=f: (RT.prompt(f, RT.LONG, "replay"), RT.encoder_state(f)) for f in fws])
+    assert all(f.overlap_runs == (3 if overlap else 0) for f in fws)     # 64 + 64 + 31 rows
+    assert all((f.rowsplit is not None and f.rowsplit.calls > 0) == bool(split) for f in fws)
+    return got
+
+
+def test_tp2_replay_overlap_equals_one_segment(tmp_path_factory, monkeypatch):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41ovr"), **RT.SHAPES)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    from tensorfold.families.deepseek_v41.cuda import topology
+
+    ck = (root, cfg, FK.engram_table(cfg), topology.load(root))
+    want = replay_prompt(ck, 0, monkeypatch)
+    got = replay_prompt(ck, 16, monkeypatch, split=8)
+    for (wl, ws), (gl, gs) in zip(want, got):
+        assert torch.equal(wl, gl)
+        assert set(ws) == set(gs)
+        for k in ws:
+            assert torch.equal(ws[k], gs[k]), k
