+class RowSplit:
+    """``TF_DSV41_INDEX_SPLIT=<rows>`` (0: off): an index layer's selection of a prefill segment of at least that many
+    rows runs on a quarter of the rows a rank (rank r: rows [r n // W, (r + 1) n // W)) and the ranks' rows are
+    gathered in rank order. Every rank otherwise computes every row's selection (the indexer's 32 heads are not
+    split); a row's selection depends on that row alone, so the gathered selections are the same."""
+
+    def __init__(self, fw: "Forward", min_rows: int) -> None:
+        self.fw, self.min_rows = fw, max(int(min_rows), fw.world)
+        self.calls = 0              # selections split (tests, logs)
+
+    def takes(self, win) -> bool:
+        return not getattr(win, "rows", False) and win.n >= self.min_rows
+
+    def select(self, fn, n: int) -> torch.Tensor:
+        fw = self.fw
+        W, r = fw.world, fw.rank
+        self.calls += 1
+        cuts = [q * n // W for q in range(W + 1)]               # balanced: every rank holds 1 row or more (n >= W)
+        m = cuts[1] - cuts[0] + (1 if n % W else 0)
+        mine = fn(cuts[r], cuts[r + 1])
+        send = torch.full((m, mine.shape[1]), -1, dtype=mine.dtype, device=mine.device)
+        send[:mine.shape[0]] = mine
+        got = fw.gather_rows(send)
+        return torch.cat([got[q, :cuts[q + 1] - cuts[q]] for q in range(W)])
+
