+def test_tp4_equals_one_rank_exact(ckpt):
+    with N.exact():
+        one = run(build(ckpt, chunk=16), IDS, [16, 13])
+        _, parts = tp4(ckpt, lambda f: run(f, IDS, [16, 13]), chunk=16)
+    every = torch.cat(parts, 1)
+    assert every.shape == one.shape
+    assert (every - one).abs().max().item() < 1e-10 * max(1.0, one.abs().max().item())
