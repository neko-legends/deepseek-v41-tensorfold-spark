+PAD = (1 << 31) - 1     # a padded candidate's id: after every real id (``vsample.ID_MAX``), never a token
+
+
+def widest(vocab: int, world: int) -> int:
+    """The widest rank's vocabulary columns (``weights.block_bounds``: rank 0 holds the extra 128-blocks)."""
+
+    if world <= 1:
+        return int(vocab)
+    from .weights import block_bounds
+
+    lo, hi = block_bounds(int(vocab), int(world), 0)
+    return hi - lo
+
+
+def rank_top(lg: torch.Tensor, count: int, lo: int, wide: int) -> tuple[torch.Tensor, torch.Tensor, int]:
+    """This rank's share of a top-``count`` exchange over the ranks' vocabulary slices: (values, int32 ids, k) with
+    the same ``k = min(count, wide)`` on every rank (``wide``: ``widest``), so the all-gather's sizes agree when the
+    slices are uneven (TP=4: 32,384 / 32,384 / 32,256 / 32,256). A narrower slice pads its rows with (-inf, ``PAD``),
+    which sort after every real candidate, -inf ones included; callers take at most the vocabulary's count."""
+
+    k = min(int(count), int(wide))
+    vals, ids = top(lg, k)
+    ids = (ids + lo).to(torch.int32)
+    short = k - vals.shape[-1]
+    if short > 0:
+        R = vals.shape[0]
+        vals = torch.cat([vals, torch.full((R, short), float("-inf"), dtype=vals.dtype, device=vals.device)], 1)
+        ids = torch.cat([ids, torch.full((R, short), PAD, dtype=torch.int32, device=ids.device)], 1)
+    return vals, ids, k
+
+
+__all__ = ["PAD", "argmax", "keys", "kit_logits", "kit_partial", "kit_weights", "rank_top", "top", "widest"]
