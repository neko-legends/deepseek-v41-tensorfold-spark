+def test_four_ranks_full_head_equal_one_rank(ck4, monkeypatch):
+    """Greedy, top-k and nucleus decoding on four ranks == one rank, token for token (exact numerics)."""
+
+    monkeypatch.delenv("TF_DSV41_DRAFT_HEAD", raising=False)
+    jobs = [(PROMPTS[0], 8, GREEDY), (PROMPTS[1], 8, TOPK), (PROMPTS[2], 8, NUCLEUS)]
+    with N.exact():
+        one = DF.run(DF.batcher(ck4, DF.forward(ck4, slots=3), n=3), [Job(list(p), n, s) for p, n, s in jobs])
+        pair = FK.ThreadPair(4)
+        comms = pair.comms()
+        fws = pair.run([lambda r=r: DF.forward(ck4, slots=3, rank=r, world=4, comm=comms[r]) for r in range(4)])
+        link = Fanout(4)
+        bs = [DF.batcher(ck4, fws[0], n=3, link=link.sender(), rank=0)]
+        bs += [DF.batcher(ck4, fws[r], n=3, link=link.receiver(r), rank=r) for r in range(1, 4)]
+        ts = [threading.Thread(target=b.follow, daemon=True) for b in bs[1:]]
+        for t in ts:
+            t.start()
+        four = DF.run(bs[0], [Job(list(p), n, s) for p, n, s in jobs])
+        bs[0].send_stop()
+        for t in ts:
+            t.join(timeout=300)
+    assert four == one
