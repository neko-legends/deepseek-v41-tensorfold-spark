+
+@pytest.fixture(scope="module")
+def ranking(tmp_path_factory):
+    f = tmp_path_factory.mktemp("dsv41rk") / "rank.txt"
+    f.write_text("# test ranking\n" + " ".join(map(str, list(range(1, 640, 2)) + list(range(0, 640, 2)))) + "\n")
+    return str(f)
