+def prepare_ragged(gate: Sequence[tuple], up: Sequence[tuple], down: Sequence[tuple], codebook, device="cuda"):
+    """``tensorfold.cuda.exl3.experts.prepare`` for a block whose experts differ in width on this rank
+    (``TF_DSV41_EXPERT_ROTATE``): trellises referenced in place through the pointer tables (the kernels already
+    address an expert by pointer), the svh / suh stacks zero-padded to the widest expert, ``width`` that widest, and
+    ``widths`` int32 [E] (each expert's own) for ``x3ld``: gate / up stop at their expert's columns, down at its rows.
+    Only the x3ld load path runs such a block (``routed`` refuses upstream's grouped kernel)."""
+
+    import torch
+
+    from tensorfold.cuda.exl3 import experts as x3
+
+    cb = x3.codebook_id(codebook) if isinstance(codebook, str) else int(codebook)
+    E = len(gate)
+    if not (len(up) == len(down) == E) or E == 0:
+        raise ValueError("gate, up and down need the same, non-zero number of experts")
+    D = int(gate[0][0].shape[0]) * 16
+    widths = [int(t.shape[1]) * 16 for t, _, _ in gate]
+    I = max(widths)
+    keep = []
+
+    def table(mats, kind):
+        ptrs, k2s = [], []
+        for e, (t, _, _) in enumerate(mats):
+            if t.dtype != torch.int16 or not t.is_contiguous() or t.device.type != "cuda":
+                raise ValueError("trellis must be a contiguous CUDA int16 tensor")
+            want = (D, widths[e]) if kind == "gu" else (widths[e], D)
+            if (int(t.shape[0]) * 16, int(t.shape[1]) * 16) != want:
+                raise ValueError(f"expert {e}: shape {tuple(t.shape)} does not match {want} / 16")
+            if widths[e] % HAD:
+                raise ValueError(f"expert {e}: width {widths[e]} is not whole Hadamard blocks")
+            if t.data_ptr() % 16:
+                raise ValueError("trellis must be 16-byte aligned (the load path reads 16-byte words)")
+            k2s.append(k2_of(t.shape))
+            ptrs.append(t.data_ptr())
+            keep.append(t)
+        return (torch.tensor(ptrs, dtype=torch.int64, device=device),
+                torch.tensor(k2s, dtype=torch.int32, device=device), k2s)
+
+    gp, gk, gks = table(gate, "gu")
+    upp, uk, uks = table(up, "gu")
+    dp, dk, dks = table(down, "dn")
+
+    def stack(mats, j, n):
+        out = torch.zeros((E, n), dtype=torch.float16, device=device)
+        for e, m in enumerate(mats):
+            v = m[j].reshape(-1)
+            out[e, :v.numel()].copy_(v)
+        return out
+
+    tb = torch.tensor([(D * widths[e] // 256) * (gks[e] + uks[e] + dks[e]) * 16 for e in range(E)],
+                      dtype=torch.int64)
+    ex = x3.Exl3RoutedExperts(gp, upp, dp, gk, uk, dk, stack(gate, 1, D), stack(up, 1, D), stack(gate, 2, I),
+                              stack(up, 2, I), stack(down, 1, I), stack(down, 2, D), E, D, I, cb,
+                              (min(gks + uks), max(gks + uks)), (min(dks), max(dks)), tb, keep)
+    ex.widths = torch.tensor(widths, dtype=torch.int32, device=device)
+    ex.min_width = min(widths)
+    return ex
