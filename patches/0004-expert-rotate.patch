+"""TF_DSV41_EXPERT_ROTATE on the GPU: a block whose experts differ in width on this rank (``experts.prepare_ragged``,
+``x3ld`` with an expert's own columns / rows) gives every pick's output bit for bit what the same expert gives in a
+block of one width (upstream ``prepare`` + ``x3ld``): the ragged path only changes where an expert's tiles stop.
+
+Run on a Spark: python -m pytest -q tests/cuda/test_dsv41_rotate_gpu.py
+"""
+
+from __future__ import annotations
+
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs an NVIDIA GPU", allow_module_level=True)
+
+from tensorfold.families.deepseek_v41.cuda import experts as X  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import expert_loads as loads  # noqa: E402
+
+DEV = "cuda"
+D = 5120
+
+
+def _mat(g, k, n, k2):
+    t = torch.randint(-2 ** 15, 2 ** 15, (k // 16, n // 16, 8 * k2), generator=g, device=DEV,
+                      dtype=torch.int32).to(torch.int16)
+    su = ((torch.rand(k, generator=g, device=DEV) + 0.5) * 0.02).to(torch.float16)
+    sv = (torch.rand(n, generator=g, device=DEV) + 0.5).to(torch.float16)
+    return t, su, sv
+
+
+@pytest.mark.parametrize("k2", [(6, 10), (4, 8), (8, 8)], ids=["3-bit + 5-bit shared", "2-bit + 4", "dspark 4-bit"])
+def test_ragged_picks_equal_one_width_blocks(k2):
+    from tensorfold.cuda.exl3 import experts as x3
+
+    g = torch.Generator(device=DEV).manual_seed(7)
+    E = 16
+    widths = [640 if (e % 4) < 2 else 512 for e in range(E)] + [640]          # routed rotated, shared 640
+    mats = []
+    for e in range(E + 1):
+        kk = k2[0] if e < E else k2[1]
+        mats.append((_mat(g, D, widths[e], kk), _mat(g, D, widths[e], kk), _mat(g, widths[e], D, kk)))
+    rag = X.Experts(X.prepare_ragged([m[0] for m in mats], [m[1] for m in mats], [m[2] for m in mats], "mul1",
+                                     device=DEV), X.Geometry(experts=E, world=4, local=640), keep=[mats])
+    classes = {}
+    for w in (640, 512):
+        ids = [e for e in range(E + 1) if widths[e] == w]
+        lay = X.Experts(x3.prepare([mats[e][0] for e in ids], [mats[e][1] for e in ids], [mats[e][2] for e in ids],
+                                   "mul1", device=DEV), X.Geometry(experts=len(ids) - 1, world=4, local=w),
+                        keep=[mats])
+        classes[w] = (ids, lay)
+    saved = dict(loads.CFG)
+    try:
+        for cfg in loads.CFGS:
+            loads.CFG.update(on=True, gu=cfg, dn=cfg)
+            s = X.scratch(rag, 16)
+            for R in (1, 3, 6, 16):
+                x = torch.randn((R, D), generator=g, device=DEV).to(torch.bfloat16)
+                pick = torch.stack([torch.randperm(E, generator=g, device=DEV)[:6] for _ in range(R)]).to(torch.int32)
+                pick = torch.cat([pick, torch.full((R, 1), E, dtype=torch.int32, device=DEV)], 1).contiguous()
+                got = X.routed(x, pick, None, rag, s, None, R).clone().view(R, 7, D)
+                for w, (ids, lay) in classes.items():
+                    remap = torch.full((E + 1,), -1, dtype=torch.int32)
+                    for j, e in enumerate(ids):
+                        remap[e] = j
+                    pk = remap[pick.cpu().long()].to(DEV)
+                    sc = X.scratch(lay, 16)
+                    want = X.routed(x, pk.contiguous(), None, lay, sc, None, R).view(R, 7, D)
+                    m = (pk >= 0)
+                    assert torch.equal(got[m], want[m]), (cfg, R, w)
+    finally:
+        loads.CFG.clear()
+        loads.CFG.update(saved)
+
+
+def test_ragged_refuses_upstream_kernel():
+    from tensorfold.cuda.exl3 import experts as x3  # noqa: F401
+
+    g = torch.Generator(device=DEV).manual_seed(3)
+    widths = [640, 512, 640]
+    mats = [(_mat(g, D, w, 6), _mat(g, D, w, 6), _mat(g, w, D, 6)) for w in widths]
+    rag = X.Experts(X.prepare_ragged([m[0] for m in mats], [m[1] for m in mats], [m[2] for m in mats], "mul1",
+                                     device=DEV), X.Geometry(experts=2, topk=2, world=4, local=640), keep=[mats])
+    saved = dict(loads.CFG)
+    try:
+        loads.CFG.update(on=False)
+        s = X.scratch(rag, 4)
+        x = torch.randn((1, D), device=DEV).to(torch.bfloat16)
+        pick = torch.tensor([[0, 1, 2]], dtype=torch.int32, device=DEV)
+        with pytest.raises(RuntimeError, match="x3ld"):
+            X.routed(x, pick, None, rag, s, None, 1)
+    finally:
