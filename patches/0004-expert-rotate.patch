+# SPDX-License-Identifier: MIT
+"""TF_DSV41_EXPERT_ROTATE (CPU): the uneven TP4 expert split rotated by expert id.
+
+- ``expert_bounds``: for every expert the four ranks' slices partition the width; across any 4 consecutive experts
+  each rank holds the wide (5-block) slice exactly twice; even splits (TP2) are untouched;
+- the loader: a rank's ragged stacks are exactly the rotated slices of the full matrices, the shared expert's wide
+  slices sit on ranks 2 and 3;
+- the forward: four rotated ranks == one rank in exact numerics, and the ranks agree bit for bit.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytestmark = pytest.mark.torch
+
+import dsv41_fakes as FK  # noqa: E402
+
+from tensorfold.families.deepseek_v41.cuda import engram_host as EH  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import forward as FW  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import numerics as N  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda import weights as W  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.config import Config  # noqa: E402
+from tensorfold.families.deepseek_v41.cuda.csa2.twin import Twin  # noqa: E402
+
+TP4 = dict(num_attention_heads=4, o_groups=4, moe_intermediate_size=640, vocab_size=640)
+IDS = torch.randint(0, 640, (29,), generator=torch.Generator().manual_seed(5)).tolist()
+
+
+def test_rotate_knob(monkeypatch):
+    monkeypatch.delenv(W.ENV_ROTATE, raising=False)
+    assert W.rotate_on() is False
+    monkeypatch.setenv(W.ENV_ROTATE, "1")
+    assert W.rotate_on() is True
+    monkeypatch.setenv(W.ENV_ROTATE, "maybe")
+    with pytest.raises(ValueError):
+        W.rotate_on()
+
+
+def test_expert_bounds_partition_and_rotate():
+    for e in range(12):
+        b = [W.expert_bounds(2304, 4, r, e, True) for r in range(4)]
+        assert sorted(b)[0][0] == 0 and sorted(b)[-1][1] == 2304
+        assert sum(hi - lo for lo, hi in b) == 2304
+        s = sorted(b)
+        assert all(s[i][1] == s[i + 1][0] for i in range(3))
+        wide = {r for r in range(4) if b[r][1] - b[r][0] == 640}
+        assert wide == {e % 4, (e + 1) % 4}
+    for r in range(4):
+        assert sum(W.expert_bounds(2304, 4, r, e, True)[1] - W.expert_bounds(2304, 4, r, e, True)[0] == 640
+                   for e in range(4)) == 2
+    # even splits and rotation off: exactly block_bounds
+    assert [W.expert_bounds(2304, 2, r, 3, True) for r in range(2)] == [W.block_bounds(2304, 2, r) for r in range(2)]
+    assert [W.expert_bounds(2304, 4, r, 3, False) for r in range(4)] == [W.block_bounds(2304, 4, r) for r in range(4)]
+
+
+@pytest.fixture(scope="module")
+def ckpt(tmp_path_factory):
+    root = FK.write_checkpoint(tmp_path_factory.mktemp("dsv41rot"), **TP4)
+    cfg = Config.from_dict(json.loads((root / "config.json").read_text()))
+    return root, cfg, FK.engram_table(cfg)
+
+
+def test_ragged_slices_are_the_rotated_blocks(ckpt):
+    root, cfg, _ = ckpt
+    full = W.Loader(cfg, W.Shards(root), 0, 1).load(2)
+    parts = [W.Loader(cfg, W.Shards(root), r, 4, rotate=True).load(2) for r in range(4)]
+    m0, mp = full.layers[1].moe, [p.layers[1].moe for p in parts]
+    assert all(isinstance(m.w1, W.X3Ragged) for m in mp)
+    for e in range(m0.w1.count):
+        order = sorted(range(4), key=lambda r: W.expert_bounds(640, 4, r, e, True)[0])
+        for name, dim in (("w1", 1), ("w3", 1), ("w2", 0)):
+            joined = torch.cat([getattr(mp[r], name).trellis[e] for r in order], dim)
+            assert torch.equal(joined, getattr(m0, name).trellis[e]), (e, name)
+        assert [mp[r].w1.trellis[e].shape[1] * 16 for r in range(4)] == \
+            [256 if (r - e) % 4 == 0 else 128 for r in range(4)]
+    sh = [p.layers[1].moe.shared[0][0].trellis.shape[1] * 16 for p in parts]
+    assert sh == [128, 128, 256, 128]                     # SHARED_ROT = 2: the 256-wide slice on rank 2
+
+
+def build(ckpt, rank=0, world=1, comm=None, chunk=8):
+    root, cfg, table = ckpt
+    tmap = FK.token_map(cfg)
+    tree = W.Loader(cfg, W.Shards(root), rank, world, rotate=world > 1).load(token_map=tmap)
+    rows = {L: EH.MemoryRows(r, s) for L, (r, s) in table.items()}
+    return FW.Forward(cfg, tree, csa2=Twin(cfg.qk_rope_head_dim, cfg.sliding_window), comm=comm, limit=96,
+                      chunk=chunk, engram_rows=rows, hasher=EH.NgramHasher(cfg, tmap))
+
+
+def run(fw, ids, windows):
+    out, a = [], 0
+    for n in windows:
+        out.append(fw.step(ids[a:a + n]))
+        a += n
+    return torch.cat(out)
+
+
+def tp4(ckpt, fn, **kw):
+    pair = FK.ThreadPair(4)
+    comms = pair.comms()
+    fws = [build(ckpt, r, 4, comms[r], **kw) for r in range(4)]
+    return pair.run([lambda f=f: fn(f) for f in fws])
+
+
+def test_rotated_tp4_equals_one_rank_exact(ckpt):
+    with N.exact():
+        one = run(build(ckpt, chunk=16), IDS, [16, 13])
+        parts = tp4(ckpt, lambda f: run(f, IDS, [16, 13]), chunk=16)
+    every = torch.cat(parts, 1)
+    assert (every - one).abs().max().item() < 1e-10 * max(1.0, one.abs().max().item())
+
+
+def test_rotated_ranks_agree_bit_for_bit(ckpt):
+    def go(f):
+        f.trace = {}
+        run(f, IDS, [8, 8, 8, 5])
+        return {k: v.clone() for k, v in f.trace.items()}
+
+    traces = tp4(ckpt, go)
+    for t in traces[1:]:
+        for L in traces[0]:
+            assert torch.equal(traces[0][L], t[L]), L
