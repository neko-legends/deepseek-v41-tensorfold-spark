From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: neko-legends <neko-legends@users.noreply.github.com>
Date: Mon, 5 Oct 2026 12:54:48 -0700
Subject: [PATCH] server: vLLM-named series on /metrics and GET /v1/model_info
 (dashboards, routers)

Fleet dashboards and routers written for vLLM (DGX-dash's LlmProbe and the
routers sized from it) found none of their series on a TensorFold engine
and fell back to one sequence: Eva's router then sent one request at a
time to a four-slot engine. /metrics now also carries
vllm:num_requests_running / _waiting, vllm:prompt_tokens_total,
vllm:generation_tokens_total (running replies included),
vllm:prompt_tokens_cached_total and vllm:request_success_total by
finished_reason, from the server's own numbers; GET /v1/model_info
(and /v1/internal/model_info) answers max_num_seqs and max_model_len. The
tensorfold_* series and /health are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../families/glm5_next/spark/health.py        | 55 ++++++++++++++++++-
 .../families/glm5_next/spark/server.py        |  4 +-
 tests/test_tensorfold_vllm_metrics.py         | 51 +++++++++++++++++
 3 files changed, 107 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_tensorfold_vllm_metrics.py

diff --git a/src/tensorfold/families/glm5_next/spark/health.py b/src/tensorfold/families/glm5_next/spark/health.py
index 642edf8da43e0634228a7637e44a73bb201f643c..cc12414caa1484b8ddb8ee5986c3de6c0e429036 100644
--- a/src/tensorfold/families/glm5_next/spark/health.py
+++ b/src/tensorfold/families/glm5_next/spark/health.py
@@ -204,8 +204,9 @@ class Health:
         code = 503 if self.mode == "strict" and not body["ok"] else 200
         return code, body
 
-    def metrics(self, served: str = "") -> str:
-        """Prometheus text exposition (counters and gauges, one ``model`` label)."""
+    def metrics(self, served: str = "", app=None) -> str:
+        """Prometheus text exposition (counters and gauges, one ``model`` label). With ``app``: also the
+        vLLM-named series that fleet dashboards and routers read (``vllm_view``)."""
 
         with self.lock:
             now = self.clock()
@@ -238,8 +239,22 @@ class Health:
             value = float(value)
             shown = str(int(value)) if value.is_integer() else f"{value:.6f}"
             out += [f"# HELP {name} {doc}", f"# TYPE {name} {kind}", f"{name}{label} {shown}"]
+        if app is not None:
+            out += vllm_view(self, app, served)
         return "\n".join(out) + "\n"
 
+    def model_info(self, app) -> dict[str, Any]:
+        """``GET /v1/model_info``: the request slots and context as vLLM's debug model info names them
+        (``max_num_seqs``, ``max_model_len``), for tools that size their concurrency from it."""
+
+        view = engine_view(app)
+        out: dict[str, Any] = {"backend": "tensorfold"}
+        if "streams" in view:
+            out["max_num_seqs"] = view["streams"]["max"]
+        if "context_length" in view:
+            out["max_model_len"] = view["context_length"]
+        return out
+
 
 # patches/0600: an engine's stats key -> upstream's /health total
 STATS = {"prefill_s": "prefill_seconds_total", "decode_s": "decode_seconds_total", "cached": "cached_tokens_total",
@@ -266,6 +281,42 @@ def engine_view(app) -> dict[str, Any]:
     return out
 
 
+def vllm_view(health: Health, app, served: str = "") -> list[str]:
+    """The vLLM-named series dashboards and routers built for vLLM read (requests running / waiting, token and
+    finish counters), from this server's own numbers: a fleet dashboard (DGX-dash's ``LlmProbe``) then shows a
+    TensorFold engine's real slots and token rates instead of assuming one sequence."""
+
+    view = engine_view(app)
+    totals = health.totals_now()
+    with health.lock:
+        inflight = len(health.inflight)
+        requests, errors = int(health.counters["requests"]), int(health.counters["errors"])
+    streams = view.get("streams")
+    running = streams["decoding"] + streams["prefilling"] if streams else inflight
+    name = served.replace("\\", "\\\\").replace('"', '\\"')
+    label = f'model_name="{name}"'
+    rows = [
+        ("vllm:num_requests_running", "gauge", "requests in a slot (prefilling or decoding)", None, running),
+        ("vllm:num_requests_waiting", "gauge", "requests waiting for a slot", None, max(0, inflight - running)),
+        ("vllm:prompt_tokens_total", "counter", "prompt tokens", None, totals.get("prompt_tokens_total", 0)),
+        ("vllm:generation_tokens_total", "counter", "generated tokens (running replies included)", None,
+         totals.get("completion_tokens_total", 0)),
+        ("vllm:prompt_tokens_cached_total", "counter", "prompt tokens resumed from the session cache", None,
+         totals.get("cached_tokens_total", 0)),
+        ("vllm:request_success_total", "counter", "finished requests by reason", 'finished_reason="stop"',
+         max(0, requests - errors)),
+        ("vllm:request_success_total", "counter", "finished requests by reason", 'finished_reason="error"', errors),
+    ]
+    out, seen = [], set()
+    for metric, kind, doc, extra, value in rows:
+        if metric not in seen:
+            out += [f"# HELP {metric} {doc}", f"# TYPE {metric} {kind}"]
+            seen.add(metric)
+        labels = label + ("," + extra if extra else "")
+        out.append(f"{metric}{{{labels}}} {int(value)}")
+    return out
+
+
 class TrackedEngine:
     """``engine`` with ``generate`` going through ``Health`` (begin, a progress mark per token callback, end with
     the stats or the exception). Every other attribute is the engine's own (read and written through)."""
diff --git a/src/tensorfold/families/glm5_next/spark/server.py b/src/tensorfold/families/glm5_next/spark/server.py
index eceacf17738cfc597e38e08dcb8e17027ef03e2e..5928880a0ba7c251b5c66f0532365445af6ab976 100644
--- a/src/tensorfold/families/glm5_next/spark/server.py
+++ b/src/tensorfold/families/glm5_next/spark/server.py
@@ -923,8 +923,10 @@ def make_handler(app: App):
                 self._json(200, {"object": "list", "data": [entry] + extra})
             elif self.path.rstrip("/") in ("/health", "/v1/health"):
                 self._json(*app.health.status(app))         # patches/0150; 0600: upstream's live totals too
+            elif self.path.rstrip("/") in ("/v1/model_info", "/v1/internal/model_info"):
+                self._json(200, app.health.model_info(app))     # slots / context as vLLM names them
             elif self.path.rstrip("/") == "/metrics":       # patches/0150: Prometheus text
-                data = app.health.metrics(app.served).encode()
+                data = app.health.metrics(app.served, app).encode()     # + vLLM-named series (dashboards)
                 self.send_response(200)
                 self.send_header("Content-Type", "text/plain; version=0.0.4")
                 self.send_header("Content-Length", str(len(data)))
diff --git a/tests/test_tensorfold_vllm_metrics.py b/tests/test_tensorfold_vllm_metrics.py
new file mode 100644
index 0000000000000000000000000000000000000000..5834fb02fc0d2abcbd9b84d1a52e6ed7af866173
--- /dev/null
+++ b/tests/test_tensorfold_vllm_metrics.py
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: MIT
+"""The vLLM-named series on ``/metrics`` and ``GET /v1/model_info`` (``glm5_next/spark/health.py``): dashboards and
+routers written for vLLM (DGX-dash's ``LlmProbe``, and the routers sized from it) read a TensorFold engine's real
+request slots, queue and token counters instead of assuming one sequence."""
+
+from __future__ import annotations
+
+import re
+import types
+
+from tensorfold.families.glm5_next.spark import health as H
+
+
+def app_with(slots: list, n: int = 4, limit: int = 300000):
+    batch = types.SimpleNamespace(seqs=slots, n=n)
+    engine = types.SimpleNamespace(batch=batch, limit=limit)
+    return types.SimpleNamespace(engine=engine, served="DeepSeek-V4.1-Flash-TF")
+
+
+def metric(text: str, name: str, extra: str = "") -> float:
+    m = re.search(r"^" + re.escape(name) + r"\{[^}]*" + re.escape(extra) + r"[^}]*\}\s+(\S+)$", text, re.M)
+    assert m, (name, extra)
+    return float(m.group(1))
+
+
+def test_vllm_series_and_model_info():
+    clock = [0.0]
+    h = H.Health(mode="basic", clock=lambda: clock[0])
+    done = h.begin(100)
+    h.progress(done, 7)
+    h.end(done, stats={"cached": 40}, completion_tokens=7)
+    bad = h.begin(5)
+    h.end(bad, error=ValueError("bad request"))
+    a, b, c = h.begin(1000), h.begin(2000), h.begin(30)              # three running, one waits for a slot
+    h.progress(a, 3)
+    decoding, prefilling = types.SimpleNamespace(stepper=object()), types.SimpleNamespace(stepper=None)
+    app = app_with([decoding, prefilling, None, None])
+    text = h.metrics(app.served, app)
+    assert metric(text, "vllm:num_requests_running") == 2
+    assert metric(text, "vllm:num_requests_waiting") == 1
+    assert metric(text, "vllm:prompt_tokens_total") == 105             # ended requests' prompts
+    assert metric(text, "vllm:generation_tokens_total") == 10          # 7 + the running reply's 3
+    assert metric(text, "vllm:prompt_tokens_cached_total") == 40
+    assert metric(text, "vllm:request_success_total", 'finished_reason="stop"') == 1
+    assert metric(text, "vllm:request_success_total", 'finished_reason="error"') == 1
+    assert 'model_name="DeepSeek-V4.1-Flash-TF"' in text
+    assert "tensorfold_requests_inflight" in text                      # the existing series are unchanged
+    assert h.model_info(app) == {"backend": "tensorfold", "max_num_seqs": 4, "max_model_len": 300000}
+    assert "vllm:" not in h.metrics(app.served)                         # without the app: as before
+    for rid in (a, b, c):
+        h.end(rid, completion_tokens=0)
